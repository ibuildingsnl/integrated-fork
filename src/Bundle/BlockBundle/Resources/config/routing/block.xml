<?xml version="1.0" encoding="UTF-8" ?>

<routes xmlns="http://symfony.com/schema/routing"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://symfony.com/schema/routing http://symfony.com/schema/routing/routing-1.0.xsd">

    <route id="integrated_block_block_index" path="/{_format}">
        <default key="_controller">Integrated\Bundle\BlockBundle\Controller\BlockController::index</default>
        <default key="_format">html</default>
        <requirement key="_format">html|json</requirement>
    </route>

    <route id="integrated_block_block_new" path="/new/{_format}">
        <default key="_controller">Integrated\Bundle\BlockBundle\Controller\BlockController::new</default>
        <default key="_format">html</default>
        <requirement key="_format">html|iframe.html</requirement>
    </route>

    <route id="integrated_block_block_id_availability" path="/id-availability/{_format}" methods="GET">
        <default key="_controller">Integrated\Bundle\BlockBundle\Controller\BlockController::idAvailability</default>
        <default key="_format">json</default>
        <requirement key="_format">json</requirement>
    </route>

    <route id="integrated_block_block_show" path="/{id}" methods="GET">
        <default key="_controller">Integrated\Bundle\BlockBundle\Controller\BlockController::show</default>
        <default key="_format">json</default>
    </route>

    <route id="integrated_block_block_edit" path="/{id}/edit/{_format}">
        <default key="_controller">Integrated\Bundle\BlockBundle\Controller\BlockController::edit</default>
        <default key="_format">html</default>
        <requirement key="_format">html|iframe.html</requirement>
    </route>

    <route id="integrated_block_block_duplicate" path="/{id}/duplicate/{_format}">
        <default key="_controller">Integrated\Bundle\BlockBundle\Controller\BlockController::duplicate</default>
        <default key="_format">html</default>
        <requirement key="_format">html</requirement>
    </route>

    <route id="integrated_block_block_delete" path="/{id}/delete">
        <default key="_controller">Integrated\Bundle\BlockBundle\Controller\BlockController::delete</default>
    </route>

    <route id="integrated_block_block_used_by" path="/{id}/used-by/{_format}"  methods="GET">
        <default key="_controller">Integrated\Bundle\BlockBundle\Controller\BlockController::usedBy</default>
        <default key="_format">html</default>
        <requirement key="_format">html|json</requirement>
    </route>

    <route id="integrated_block_inline_text_block_create" path="/inline-text/new/{id}" methods="GET|PUT|POST">
        <default key="_controller">Integrated\Bundle\BlockBundle\Controller\InlineTextBlockController::new</default>
    </route>
</routes>
