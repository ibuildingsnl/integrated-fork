<?xml version="1.0" encoding="UTF-8" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>

        <defaults autowire="true" autoconfigure="true"/>

        <service id="integrated_block.twig.block_extension" class="Integrated\Bundle\BlockBundle\Twig\Extension\BlockExtension">
            <argument type="service" id="integrated_block.templating.block_manager"/>
            <argument type="service" id="integrated_theme.templating.theme_manager"/>
            <argument type="service" id="integrated_block.provider.block_usage" />
            <argument type="service" id="integrated_block.metadata.factory" />
            <argument type="service" id="integrated_content.channel.context"/>
            <argument type="service" id="logger"/>
            <argument>%kernel.environment%</argument>
            <tag name="twig.extension" />
        </service>

        <service id="integrated_block.layout_locator" class="Integrated\Bundle\BlockBundle\Locator\LayoutLocator">
            <argument type="service" id="integrated_theme.templating.theme_manager" />
        </service>

        <service id="integrated_block.configure_menu" class="Integrated\Bundle\BlockBundle\EventListener\ConfigureMenuListener">
            <argument type="service" id="security.authorization_checker" />
            <argument type="service" id="security.token_storage" />
            <argument type="service" id="request_stack" />
            <argument type="service" id="integrated_block.provider.filter_query" />

            <tag name="kernel.event_subscriber" />
        </service>

        <service id="integrated_block.provider.block_usage" class="Integrated\Bundle\BlockBundle\Provider\BlockUsageProvider">
            <argument type="service" id="doctrine_mongodb.odm.document_manager" />
            <argument type="service" id="cache.app" />
            <argument type="tagged_iterator" tag="integrated_block.usage_source" />
        </service>

        <service id="integrated_block.provider.template_block_usage" class="Integrated\Bundle\BlockBundle\Provider\TemplateBlockUsageProvider">
            <argument type="service" id="doctrine_mongodb.odm.document_manager" />
            <argument type="service" id="integrated_theme.templating.theme_manager" />
            <argument type="service" id="integrated_page.theme_resolver" />
            <argument>%kernel.project_dir%</argument>
            <tag name="integrated_block.usage_source" />
        </service>

        <service id="integrated_block.provider.filter_query" class="Integrated\Bundle\BlockBundle\Provider\FilterQueryProvider" public="true">
            <argument type="service" id="doctrine_mongodb.odm.document_manager" />
            <argument type="service" id="integrated_block.provider.block_usage" />
        </service>

        <service id="Integrated\Bundle\BlockBundle\Security\AllowedBlockClassProvider">
            <argument type="service" id="integrated_block.metadata.factory" />
        </service>

        <service id="Integrated\Bundle\BlockBundle\Security\AllowedBlockClassInstantiator" />

        <service id="Integrated\Bundle\BlockBundle\Document\Block\BlockRepository"></service>

    </services>

</container>
