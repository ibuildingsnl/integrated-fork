{% set edit = app.request.attributes.get('integrated_block_edit') %}

{% if edit|default %}
<div class="integrated-website-channel-block-grid" data-block-type="channel" data-id="{{ id }}">
    <div>
        <a href="javascript:;" class="integrated-block-button" data-action="integrated-website-block-edit" title="{% trans %}Edit block{% endtrans %}">
            <i class="iconoir-edit-pencil"></i>
        </a>
    </div>
{% endif %}

{{ content|raw }}

{% if edit|default %}
</div>
{% endif %}
