{% if block.items|length %}
    <div class="block">
        <h2>{{ block.publishedTitle }}</h2>

        <ul class="list-unstyled flex flex-wrap  m-b-0">
            {% for item in block.items %}
                {% if not item.disabled %}
                    <li class="lg:w-1/3 pr-4 pl-4 sm:w-1/2">
                        <div class="relative flex flex-col min-w-0 rounded break-words border bg-white border-1 border-gray-300 ">
                            {% if item.image|default %}
                                {% if item.link %}
                                    <a href="{{ item.link }}" {% if item.target %}target="{{ item.target }}"{% endif %}>
                                {% endif %}

                                <img class="w-full rounded rounded-t img-responsive full-xs" src="{{ image(item.image).cropResize(290,115) }}" alt="{{ item.title }}">

                                {% if item.link %}
                                    </a>
                                {% endif %}
                            {% endif %}
                            <div class="card-block">
                                <h4 class="mb-3">
                                    {% if item.link %}
                                    <a href="{{ item.link }}">
                                        {% endif %}
                                        {{ item.title }}
                                        {% if item.link %}
                                    </a>
                                    {% endif %}
                                </h4>

                                <div class="mb-0">
                                    {{ item.text|default|raw }}
                                </div>

                                {% if item.link %}
                                    <a href="{{ item.link }}" {% if item.target %}target="{{ item.target }}"{% endif %}>{{ item.linkText|default }}</a>
                                {% endif %}
                            </div>
                        </div>
                    </li>
                {% endif %}
            {% endfor %}
        </ul>
    </div>
{% endif %}
