{% extends '@IntegratedContent/base.html.twig' %}
{% block title %}{% trans %}Blocks{% endtrans %}{% endblock title %}

{% form_theme facetFilter with '@IntegratedFormType/form/form_div_layout.html.twig' %}

{% block content %}
    <div class="row flex flex-wrap">
        <div class="index-wrapper">

            <div class="page-title justify-between flex flex-wrap">
                <div class="flex items-center">
                    <h1 class="heading">{% trans %}Blocks{% endtrans %}</h1>

                    {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_WEBSITE_MANAGER') %}
                        <ul class="options-no-bg">
                            <li class="dropdown close-outside" data-underlay="no">
                                <a href="#" data-toggle="dropdown" role="button" id="drop_1" class="btn btn-select">
                                    <span>{% trans %}New block{% endtrans %}</span>
                                    <i class="iconoir-plus"></i>
                                </a>
                                <ul aria-labelledby="drop_1" role="menu" class="dropdown-menu" id="menu_1">
                                    {% set sortedBlocks = factory.allMetadata|integrated_sort_blocks %}

                                    {% for blocks in sortedBlocks %}
                                        {% if 'InlineTextBlock' not in blocks.class %}
                                            <li role="presentation">
                                                <a href="{{ path('integrated_block_block_new') }}?class={{ blocks.class }}">{{ blocks.type|default(blocks.class) }}</a>
                                            </li>
                                        {% endif %}
                                    {% endfor %}
                                </ul>
                            </li>
                        </ul>
                    {% endif %}
                </div>
                <button class="toggle-filters toggle-data-target btn btn-orange icon-left"  data-target="aside-filters">
                    <i class="iconoir-filter-alt"></i>
                    <span>{% trans %}Filter{% endtrans %}</span>
                </button>
            </div>

            {% include '@IntegratedBlock/block/partials/block_list.html.twig' %}

        </div>

        <div class="aside-filters close-outside">
            <aside>
                <div class="aside-holder section-gray section-radius">
                    <div class="aside-header">
                        <button class="toggle-filters toggle-data-target"  data-target="aside-filters"><i class="iconoir-xmark"></i></button>
                        <span>{% trans %}Filters{% endtrans %}</span>
                        <a href="{{ path('integrated_block_block_index') }}" class="clear-filters"><span>{% trans %}Remove active filters{% endtrans %}</span>
                            <i class="iconoir-xmark"></i>
                        </a>
                    </div>
                    {{ form_start(facetFilter) }}

                    <div class="aside-item-holder">
                        <div class="input-group input-group-search">
                            {{ form_widget(facetFilter.q) }}
                            <span class="input-group-btn">
                                <button type="submit" class="">
                                    <i class="iconoir-search"></i>
                                </button>
                            </span>
                        </div>
                    </div>

                    <div class="aside-item-holder{% if facetFilter.type.vars.choices|length == 0 %} hidden{% endif %}">
                        {{ form_row(facetFilter.type, {
                            'style': 'sidebar',
                            'state': 'show',
                            'attr': {
                                'data-block-filter-search': '1',
                                'data-block-filter-search-placeholder': ('Search in'|trans ~ ' ' ~ facetFilter.type.vars.label|trans)|trim
                            }
                        }) }}
                    </div>

                    <div
                        class="aside-item-holder{% if facetFilter.channels.vars.choices|length == 0 %} hidden{% endif %}">
                        {{ form_row(facetFilter.channels, {
                            'style': 'sidebar',
                            'state': 'show',
                            'attr': {
                                'data-block-filter-search': '1',
                                'data-block-filter-search-placeholder': ('Search in'|trans ~ ' ' ~ facetFilter.channels.vars.label|trans)|trim
                            }
                        }) }}
                    </div>

                    <div class="aside-item-holder">
                        {{ form_row(facetFilter.unused, {
                            'style': 'sidebar',
                            'state': 'show'
                        }) }}
                    </div>

                    <div class="aside-item-holder">
                        {{ form_rest(facetFilter, {'style':'sidebar', 'state': 'show'}) }}
                    </div>

                    {{ form_end(facetFilter) }}
                </div>
            </aside>
        </div>

    </div>

{% endblock %}

{% block javascript %}
{{ parent() }}
<script type="text/javascript" src="{{ asset('bundles/integratedblock/js/block_index.js') }}"></script>
{% endblock %}
