{% extends '@IntegratedContent/base.html.twig' %}
{% block title %}{% trans %}Delete block{% endtrans %}{% endblock title %}

{% block content %}
    {% block form_start %}
        {{ form_start(form) }}
    {% endblock %}
    {% set blockDeleteToolbarHtml %}
        {% block toolbar %}
            {% include '@IntegratedContent/partials/block.toolbar.html.twig' %}
        {% endblock toolbar %}
    {% endset %}
    {% set blockDeleteTitleHtml %}
        {{ component('integrated_admin:page_title', {
            title: ('Delete'|trans) ~ ' ' ~ ('block'|trans),
        }) }}
    {% endset %}
    {% set blockDeleteContentHtml %}
        <p>
            {% trans with {'%name%':  block.title} %}You are about to delete "%name%", click the delete button to confirm the action.{% endtrans %}
        </p>
        {{ form_rest(form, {'style':'horizontal'})}}
    {% endset %}
    {{ component('integrated_admin:edit_form_shell', {
        toolbarHtml: blockDeleteToolbarHtml,
        pageTitleHtml: blockDeleteTitleHtml,
        editorContentHtml: blockDeleteContentHtml,
    }) }}
    {% block form_end %}
        {{ form_end(form) }}
    {% endblock %}
{% endblock %}
