{% extends '@IntegratedBlock/block/new.html.twig' %}

{% block style %}
    {{ parent() }}

    <style>
        #wrapper-holder {
            padding-bottom: 85px;
            top: 0px;
        }

        #wrapper-holder > .container {
            width: auto;
            background: #fff;
        }

        #wrapper-holder > .container .section-radius {
            box-shadow: none;
        }

        .add-relation {
            display: none;
        }

        .prefooter-holder {
            border-top: 1px solid #e5e5e5;
            background: #fcfcfc;
        }

        .aside-options {
            height: calc(100vh - 50px);
        }

        .aside-options .aside-holder {
            padding-top: 0;
        }

        .sidebar {
            display: none;
        }

        .content-wrapper {
            width: 100%;
        }

        #wrapper-holder {
            height: 100%;
        }
    </style>
{% endblock %}


{% block header %}{% endblock %}
{% block crumbs %}{% endblock %}
{% block sidebar_menu %}{% endblock %}
{% block filters %}{% endblock %}
{% block main_title %}{% endblock %}
