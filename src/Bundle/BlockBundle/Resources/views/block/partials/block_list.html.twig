<section class="section-white section-radius">

    <div class="row flex flex-wrap">
        <div class="w-full">

            <table class="table table-fixed">
                <thead>
                    <tr>
                        <th>{{ knp_pagination_sortable(blocks, 'Block name'|trans, 'title') }}</th>
                        <th>{{ knp_pagination_sortable(blocks, 'Short code'|trans, 'id') }}</th>
                        <th>{{ knp_pagination_sortable(blocks, 'Type'|trans, 'type') }}</th>
                        <th>{% trans %}Used on{% endtrans %}</th>
                    </tr>
                </thead>
                <tbody>

                {% for block in blocks %}
                    {% set usedPages = integrated_find_pages(block) %}
                    {% set usedContainerBlocks = integrated_find_container_blocks(block) %}
                    {% set usedTemplateUsages = integrated_find_template_usages(block) %}
                    {% set usedChannels = integrated_find_channels(block) %}
                    {% set usedOnCount = usedPages|length + usedContainerBlocks|length + usedTemplateUsages|length %}
                    <tr class="has-options">
                        <td>
                            <strong>
                                <a href="{{ path('integrated_block_block_edit', {id: block.id}) }}">
                                    {{ block.title }}
                                </a>
                            </strong>
                            <div class="row-options">
                                <a href="{{ path('integrated_block_block_edit', { 'id': block.id}) }}"
                                   title="{% trans %}Edit{% endtrans %}">
                                    {% trans %}Edit{% endtrans %}
                                </a>
                                {% if not block.locked and (is_granted('ROLE_ADMIN') or is_granted('ROLE_WEBSITE_MANAGER')) %}
                                    {% if not usedPages and not usedContainerBlocks and not usedTemplateUsages %}
                                        | <a href="{{ path('integrated_block_block_delete', { 'id': block.id }) }}"
                                             class="color-red" title="{% trans %}Delete{% endtrans %}">
                                        {% trans %}Delete{% endtrans %}
                                    </a>
                                    {% endif %}
                                {% endif %}
                            </div>
                        </td>
                        <td class="break-word">
                            {{ block.id }}
                        </td>
                        <td>
                            {{ block|integrated_block_type }}
                        </td>
                        <td>
                            {% if usedPages|length > 0 or usedContainerBlocks|length > 0 or usedTemplateUsages|length > 0 %}
                                {% set pageList %}
                                    {% if usedTemplateUsages|length > 0 %}
                                        <h3>{% trans %}Code usage{% endtrans %}</h3>
                                        <ul>
                                            {% for templateUsage in usedTemplateUsages %}
                                                <li>
                                                    {{ templateUsage.template|default('unknown template') }}
                                                    {% if templateUsage.channel_id is defined %}
                                                        <small>({{ templateUsage.channel_id }})</small>
                                                    {% endif %}
                                                </li>
                                            {% endfor %}
                                        </ul>
                                    {% endif %}
                                    {% if usedContainerBlocks|length > 0 %}
                                        <h3>{% trans %}Container blocks{% endtrans %}</h3>
                                        <ul>
                                            {% for containerBlock in usedContainerBlocks %}
                                                <li>
                                                    <a href="{{ path('integrated_block_block_edit', {'id': containerBlock['_id']}) }}" target="_blank" rel="noopener noreferrer">
                                                        {{ containerBlock.title|default(containerBlock['_id']) }}
                                                    </a>
                                                </li>
                                            {% endfor %}
                                        </ul>
                                    {% endif %}
                                    {% if usedChannels|length > 0 %}
                                        <h3>{% trans %}Channels{% endtrans %}</h3>
                                        <ul>
                                            {% for channel in usedChannels %}
                                                {% if channel.name is defined %}
                                                    <li>{{ channel.name }}</li>
                                                {% endif %}
                                            {% endfor %}
                                        </ul>
                                    {% endif %}
                                    <h3>{% trans %}Pages{% endtrans %}</h3>
                                    <ul>
                                        {% for page in usedPages %}
                                            {% set channelId = page.channel['$id']|default(null) %}
                                            {% set channelName = null %}
                                            {% if channelId and usedChannels[channelId] is defined and usedChannels[channelId].name is defined %}
                                                {% set channelName = usedChannels[channelId].name %}
                                            {% endif %}
                                            <li>
                                                <a href="{{ path('integrated_page_page_edit', {'id': page['_id']}) }}" target="_blank" rel="noopener noreferrer">
                                                    {{ page.title|default(page['_id']) }}
                                                </a>
                                                {% if page._used_via_container_title is defined %}
                                                    <small>({% trans %}via{% endtrans %} {{ page._used_via_container_title }})</small>
                                                {% endif %}
                                                {% if channelName %}
                                                    <small>({{ channelName }})</small>
                                                {% endif %}
                                            </li>
                                        {% endfor %}
                                    </ul>
                                {% endset %}

                                <button type="button"
                                        class="btn btn-white"
                                        data-toggle="popover"
                                        data-trigger="click"
                                        data-content="{{ pageList|e('html_attr') }}"
                                        data-html="true"
                                        data-placement="left"
                                        data-container="body">
                                    {{ usedOnCount }}
                                    <i class="iconoir-list"></i>
                                </button>
                            {% else %}
                                <small>-</small>
                            {% endif %}
                        </td>
                    </tr>

                {% else %}

                    <tr>
                        <td colspan="4">
                            {% if facetFilter.vars.value.q|default or facetFilter.vars.value.type|default or facetFilter.vars.value.channels|default %}
                                {% trans %}No blocks found{% endtrans %}
                            {% else %}
                                {% trans %}No blocks added{% endtrans %}
                            {% endif %}
                        </td>
                    </tr>

                {% endfor %}

                </tbody>
            </table>

            {{ knp_pagination_render(blocks, '@KnpPaginator/Pagination/sliding.html.twig') }}
        </div>
    </div>
</section>
