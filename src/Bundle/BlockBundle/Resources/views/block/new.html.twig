{% extends '@IntegratedContent/base.html.twig' %}
{% block title %}{% trans %}New block{% endtrans %}{% endblock title %}
{% block content %}
    {% block form_section %}
    <div class="flex flex-wrap edit-form">
        {% block form_start %}
            {{ form_start(form, { 'style': 'horizontal' }) }}
        {% endblock %}
        <div id="toolbar" class="w-full flex justify-between">
            <div class="back">
                {% block form_return %}
                    {% if form.actions.back is defined %}
                        {{ form_row(form.actions.back) }}
                    {% endif %}
                    {% if form.actions.cancel is defined %}
                        {{ form_row(form.actions.cancel) }}
                    {% endif %}
                {% endblock %}
            </div>
            <div class="options">
                <div class="form-actions">
                    {% block form_actions %}
                        {% if form.actions.save is defined %}
                            {{ form_row(form.actions.save) }}
                        {% endif %}
                        {% if form.actions.reload is defined %}
                            {{ form_row(form.actions.reload) }}
                        {% endif %}
                        {% if form.actions.create is defined %}
                            {{ form_row(form.actions.create) }}
                        {% endif %}
                    {% endblock %}
                </div>
            </div>
        </div>
        <div class="aside-options">
            <aside>
                <div class="aside-item-wrapper show">
                    <div class="aside-item-header">
                        <h3 class="aside-item-title">
                            <i class="fa-regular fa-circle-info"></i>
                            <span class="aside-item-icon">{% trans %}Status{% endtrans %}</span>
                        </h3>
                        <i class="fa-regular fa-chevron-up"></i>
                    </div>
                    <div class="aside-item-list">
                        <div class="aside-item-list-container">
                            <div class="status-info">
                                {% if form.publishedAt is defined %}
                                    {{ form_row(form.publishedAt) }}
                                {% endif %}
                                {% if form.publishedUntil is defined %}
                                    {{ form_row(form.publishedUntil) }}
                                {% endif %}
                            </div>
                            <div class="status-options">
                                    <div class="status draft">
                                        <i class="fa-regular fa-pen-ruler"></i> {% trans %}Draft{% endtrans %}
                                    </div>
                            </div>
                        </div>
                    </div>
                </div>
                {% if form.itemsPerPage is defined %}
                    {{ form_row(form.itemsPerPage, {'style': 'sidebar', 'icon':'fa-share-nodes', 'state': 'show'}) }}
                {% endif %}
                {% if form.maxItems is defined %}
                    {{ form_row(form.maxItems, {'style': 'sidebar', 'icon':'fa-share-nodes', 'state': 'show'}) }}
                {% endif %}
                {% if form.groups is defined %}
                    {{ form_row(form.groups, {'style': 'sidebar', 'icon':'fa-share-nodes', 'state': 'show'}) }}
                {% endif %}
            </aside>
        </div>
        <div class="editor-wrapper">
            <div class="page-title">
                <h1 class="heading">{% trans %}New{% endtrans %} {% trans %}block{% endtrans %}</h1>
            </div>
            <section class="editor editor-wrapped">
                <div id="integrated_block_block">
                    {{ form_errors(form) }}

                    {{ form_rest(form, {'style':'horizontal', 'state': 'show'})}}
                </div>
            </section>
        </div>
        {% block form_end %}
            {{ form_end(form) }}
        {% endblock %}
    </div>
        {% endblock form_section %}
{% endblock %}

{% block webpack_js %}
    <script src="{{ asset('bundles/integratedintegrated/edit.js') }}"></script>
{% endblock %}

{% block javascript %}
    {{ parent() }}
    <script type="text/javascript" src="{{ asset('bundles/integratedblock/js/published_title.js') }}"></script>
{% endblock %}

{% block style %}
    {{ parent() }}

    <link rel="stylesheet" href="{{ asset('bundles/integratedintegrated/edit.css') }}">
{% endblock %}
