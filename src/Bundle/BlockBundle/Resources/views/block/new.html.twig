{% extends '@IntegratedContent/base.html.twig' %}
{% block title %}{% trans %}New block{% endtrans %}{% endblock title %}
{% block content %}
    {% block form_section %}
        <div class="flex flex-wrap edit-form">
            {% block form_start %}
                {{ form_start(form) }}
            {% endblock %}
            {% block toolbar %}
                {% include '@IntegratedContent/partials/block.toolbar.html.twig' %}
            {% endblock toolbar %}
            <div class="aside-options">
                <aside>
                    <div class="aside-holder">
                        {% block sidebar %}
                            <div class="aside-item-wrapper show">
                                <div class="aside-item-header">
                                    <h3 class="aside-item-title">
                                        <i class="iconoir-info-empty"></i>
                                        <span class="aside-item-icon">{% trans %}Status{% endtrans %}</span>
                                    </h3>
                                    <i class="iconoir-nav-arrow-up"></i>
                                </div>
                                <div class="aside-item-list">
                                    <div class="aside-item-list-container">
                                        <div class="status-info">
                                            {% if form.publishedAt is defined %}
                                                {{ form_row(form.publishedAt) }}
                                            {% endif %}
                                            {% if form.publishedUntil is defined %}
                                                {{ form_row(form.publishedUntil) }}
                                            {% endif %}
                                        </div>
                                        <div class="status-options">
                                            <div class="status draft">
                                                <i class="iconoir-design-pencil"></i> {% trans %}Draft{% endtrans %}
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            {% block content_meta %}
                                {% for child in form|filter(row => row.vars.attr.location|default == constant('Integrated\\Common\\Form\\Mapping\\Attributes\\Field::LOCATION_SIDEBAR'))  %}
                                    {{ form_row(child) }}
                                {% endfor %}
                            {% endblock %}
                        {% endblock %}
                    </div>
                </aside>
            </div>
            <div class="editor-wrapper">
                <div class="page-title">
                    <h1 class="heading">{% trans %}New{% endtrans %} {% trans %}block{% endtrans %}</h1>
                </div>
                <section class="editor editor-wrapped">
                    <div id="integrated_block_block">
                        {{ form_errors(form) }}

                        {% block content_form %}
                            {% for child in form|filter(row => row.vars.attr.location|default == constant('Integrated\\Common\\Form\\Mapping\\Attributes\\Field::LOCATION_EDITOR'))  %}
                                {{ form_row(child) }}
                            {% endfor %}

                            {{ form_rest(form, {'style':'horizontal'}) }}
                        {% endblock %}
                    </div>
                </section>
            </div>
            {% block form_end %}
                {{ form_end(form) }}
            {% endblock %}
        </div>
    {% endblock form_section %}
{% endblock %}

{% block webpack_js %}
    <script src="{{ asset('bundles/integratedintegrated/edit.js') }}"></script>
{% endblock %}

{% block javascript %}
{{ parent() }}
<script type="text/javascript" src="{{ asset('bundles/integratedblock/js/published_title.js') }}"></script>
{% endblock %}

{% block style %}
    {{ parent() }}

    <link rel="stylesheet" href="{{ asset('bundles/integratedintegrated/edit.css') }}">
{% endblock %}
