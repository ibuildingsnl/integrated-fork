<?xml version="1.0" encoding="UTF-8" ?>

<routes xmlns="http://symfony.com/schema/routing"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://symfony.com/schema/routing http://symfony.com/schema/routing/routing-1.0.xsd">

    <route id="integrated_page_page_index" path="/" methods="GET">
        <default key="_controller">Integrated\Bundle\PageBundle\Controller\PageController::index</default>
    </route>

    <route id="integrated_page_page_new" path="/new">
        <default key="_controller">Integrated\Bundle\PageBundle\Controller\PageController::new</default>
    </route>

    <route id="integrated_page_page_edit" path="/{id}/edit">
        <default key="_controller">Integrated\Bundle\PageBundle\Controller\PageController::edit</default>
    </route>

    <route id="integrated_page_page_delete" path="/{id}/delete">
        <default key="_controller">Integrated\Bundle\PageBundle\Controller\PageController::delete</default>
    </route>

    <route id="integrated_page_page_delete_without_channel" path="/{id}/delete-without-channel" methods="POST">
        <default key="_controller">Integrated\Bundle\PageBundle\Controller\PageController::deleteWithoutChannel</default>
    </route>

    <route id="integrated_page_page_delete_without_channel_bulk" path="/delete-without-channel/bulk" methods="POST">
        <default key="_controller">Integrated\Bundle\PageBundle\Controller\PageController::deleteWithoutChannelBulk</default>
    </route>

    <route id="integrated_page_page_copy" path="/copy">
        <default key="_controller">Integrated\Bundle\PageBundle\Controller\PageController::copy</default>
    </route>
</routes>
