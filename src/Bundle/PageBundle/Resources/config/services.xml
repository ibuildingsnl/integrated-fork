<?xml version="1.0" encoding="UTF-8" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>

        <defaults autowire="true" autoconfigure="true"/>

        <service id="integrated_page.layout_locator" class="Integrated\Bundle\PageBundle\Locator\LayoutLocator">
            <argument type="service" id="integrated_theme.templating.theme_manager" />
        </service>

        <service id="integrated_page.theme_resolver" class="Integrated\Bundle\PageBundle\Resolver\ThemeResolver" public="true">
            <argument type="service" id="integrated_channel.config.resolver" />
            <argument type="service" id="integrated_theme.templating.theme_manager" />
        </service>

        <service id="integrated_page.grid.factory" class="Integrated\Bundle\PageBundle\Grid\GridFactory" public="true">
        </service>

        <service id="integrated_page.services.content_type_controller_manager" class="Integrated\Bundle\PageBundle\Services\ContentTypeControllerManager" />

        <service id="integrated_page.services.content_type_page" class="Integrated\Bundle\PageBundle\Services\ContentTypePageService">
            <argument type="service" id="integrated_page.services.content_type_controller_manager" />
            <argument type="service" id="doctrine_mongodb.odm.document_manager" />
        </service>

        <service id="integrated_page.services.route_cache" class="Integrated\Bundle\PageBundle\Services\RouteCache" public="true">
            <argument type="string">%kernel.cache_dir%</argument>
        </service>

        <service id="integrated_page.services.url_resolver" class="Integrated\Bundle\PageBundle\Services\UrlResolver">
            <argument type="service" id="integrated_page.services.content_type_controller_manager" />
            <argument type="service" id="integrated_content.channel.context" />
            <argument type="service" id="router.default" />
            <argument type="service" id="doctrine_mongodb.odm.document_manager" />
        </service>

        <service id="integrated_page.services.solr_url_extractor" class="Integrated\Bundle\PageBundle\Services\SolrUrlExtractor">
            <argument type="service" id="integrated_content.channel.context" />
            <argument type="service" id="router.default" />
        </service>

        <service id="Integrated\Bundle\PageBundle\PageBuilder\V2\Validation\LayoutPayloadValidator">
            <argument type="string">%kernel.project_dir%/vendor/integrated/integrated/src/Bundle/PageBundle/Resources/schema/pagebuilder/v2</argument>
        </service>

        <service id="Integrated\Bundle\PageBundle\Services\PageCopyService">
            <argument type="service" id="doctrine_mongodb.odm.document_manager" />
            <argument type="service" id="integrated_page.services.route_cache"/>
        </service>

        <service id="Integrated\Bundle\PageBundle\PageBuilder\V2\Migration\LayoutV1ToV2Mapper" />

        <service id="Integrated\Bundle\PageBundle\PageBuilder\V2\Migration\MigrationJournal" />

        <service id="Integrated\Bundle\PageBundle\PageBuilder\V2\Migration\SnapshotStore" />

        <service id="integrated_page.command.pagebuilder_v2_migrate" class="Integrated\Bundle\PageBundle\Command\PageBuilderV2MigrateCommand">
            <argument type="service" id="doctrine_mongodb.odm.document_manager" />
            <argument type="service" id="Integrated\Bundle\PageBundle\PageBuilder\V2\Migration\LayoutV1ToV2Mapper" />
            <argument type="service" id="Integrated\Bundle\PageBundle\PageBuilder\V2\Validation\LayoutPayloadValidator" />
            <argument type="service" id="Integrated\Bundle\PageBundle\PageBuilder\V2\Migration\MigrationJournal" />
            <tag name="console.command" command="pagebuilder:v2:migrate" />
        </service>

        <service id="integrated_page.command.pagebuilder_v2_verify" class="Integrated\Bundle\PageBundle\Command\PageBuilderV2VerifyCommand">
            <argument type="service" id="doctrine_mongodb.odm.document_manager" />
            <argument type="service" id="Integrated\Bundle\PageBundle\PageBuilder\V2\Validation\LayoutPayloadValidator" />
            <tag name="console.command" command="pagebuilder:v2:verify" />
        </service>

        <service id="integrated_page.command.pagebuilder_v2_rollback" class="Integrated\Bundle\PageBundle\Command\PageBuilderV2RollbackCommand">
            <argument type="service" id="doctrine_mongodb.odm.document_manager" />
            <tag name="console.command" command="pagebuilder:v2:rollback" />
        </service>

    </services>

</container>
