<?xml version="1.0" encoding="UTF-8" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>

        <defaults autowire="true" autoconfigure="true"/>

        <prototype namespace="Integrated\Bundle\PageBundle\Controller\" resource="../../Controller" />

        <service id="Integrated\Bundle\PageBundle\Controller\ContentTypePageController">
            <argument type="service" id="doctrine_mongodb.odm.document_manager" />
            <argument type="service" id="integrated_page.services.route_cache" />
        </service>

        <service id="Integrated\Bundle\PageBundle\Controller\PageController">
            <argument type="service" id="doctrine_mongodb.odm.document_manager" />
            <argument type="service" id="knp_paginator" />
            <argument type="service" id="Integrated\Bundle\PageBundle\Services\PageCopyService" />
            <argument type="service" id="Integrated\Bundle\PageBundle\Services\PageCopy\PageCopyRequestFactory" />
            <argument type="service" id="integrated_page.services.route_cache" />
            <argument type="service" id="uri_signer" />
            <argument type="service" id="Integrated\Bundle\ContentBundle\Services\WebsiteChannelResolver" />
            <argument type="service" id="integrated_theme.templating.theme_manager" />
        </service>

    </services>

</container>
