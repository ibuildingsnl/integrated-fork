<doctrine-mongo-mapping xmlns="http://doctrine-project.org/schemas/odm/doctrine-mongo-mapping"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://doctrine-project.org/schemas/odm/doctrine-mongo-mapping http://doctrine-project.org/schemas/odm/doctrine-mongo-mapping.xsd">

    <document name="Integrated\Bundle\PageBundle\Document\Page\Page">

        <field field-name="title" type="string" />
        <field field-name="description" type="string" />
        <field field-name="disabled" type="bool" />
        <field field-name="locked" type="bool" />
        <field field-name="seoTitle" type="string" nullable="true" />
        <field field-name="seoDescription" type="string" nullable="true" />
        <field field-name="canonicalUrl" type="string" nullable="true" />
        <field field-name="publishAt" type="date" nullable="true" />
        <field field-name="expireAt" type="date" nullable="true" />
        <field field-name="expireRedirectUrl" type="string" nullable="true" />
        <field field-name="hideFromSitemap" type="bool" nullable="true" />
        <field field-name="paginationNoindexEnabled" type="bool" nullable="true" />
        <embed-one field="seoMetadata" target-document="Integrated\Bundle\ContentBundle\Document\Content\Embedded\SeoMeta" />
        <reference-one field="featuredImage" target-document="Integrated\Bundle\ContentBundle\Document\Content\Image" />
        <field field-name="robotsDirective" type="string" nullable="true" />
        <field field-name="twitterCard" type="string" nullable="true" />

    </document>

</doctrine-mongo-mapping>
