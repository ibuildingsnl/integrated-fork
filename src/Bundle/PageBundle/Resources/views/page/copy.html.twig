{% extends '@IntegratedContent/base.html.twig' %}
{% block title %}{% trans %}Copy page{% endtrans %}{% endblock title %}
{% block style %}
    {{ parent() }}

    <style>
        #copy-table .radio {
            padding-right: 15px;
        }
        #copy-table .radio:last-child {
            padding-right: 0px;
        }
    </style>
{% endblock %}
{% block content %}
    <div class="flex flex-wrap edit-form">
        {% form_theme form with ['@IntegratedPage/form/form_div_layout.html.twig', '@IntegratedContent/form/form_div_layout.html.twig'] %}

        {% block form_start %}
            {{ form_start(form) }}
        {% endblock %}
        {% block toolbar %}
            {% include '@IntegratedContent/partials/block.toolbar.html.twig' %}
        {% endblock toolbar %}
        <div class="editor-wrapper editor-wrapper-full">
            <div class="page-title">
                <h1 class="heading">
                    {% block contentTitle %}
                        {% trans %}Copy{% endtrans %} {% trans %}pages{% endtrans %}
                    {% endblock %}
                </h1>
            </div>
            <section class="editor editor-wrapped">
                {{ form_rest(form, {'style':'horizontal', 'state': 'show'})}}
            </section>
        </div>
        {% block form_end %}
            {{ form_end(form) }}
        {% endblock %}
    </div>
{% endblock %}

{% block javascript %}
    {{ parent() }}

    <script>
    window.addEventListener('DOMContentLoaded', function() {
      var fields = document.querySelectorAll('[name*=newBlockId]');

      for (var i = 0; i < fields.length; i++) {
        fields[i].disabled = true;
      }
    });
    $('.copy-pages-blocks select').change(function() {
        var newBlockIdField = $(this).closest('div.row').find('input:text');
        if ($(this).val() == '') {
            newBlockIdField.prop('disabled', true);
            newBlockIdField.prop('required', false);
            newBlockIdField.val('');
        } else {
            newBlockIdField.prop('disabled', false);
            newBlockIdField.prop('required', true);
            newBlockIdField.val(newBlockIdField.data('proposed-block-id'));
        }
    });
    </script>
{% endblock %}
