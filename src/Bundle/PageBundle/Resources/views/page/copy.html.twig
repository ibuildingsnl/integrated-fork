{% extends '@IntegratedContent/base.html.twig' %}
{% block title %}{% trans %}Copy page{% endtrans %}{% endblock title %}
{% block style %}
    {{ parent() }}

    <style>
        #copy-table .radio {
            padding-right: 15px;
        }
        #copy-table .radio:last-child {
            padding-right: 0px;
        }
    </style>
{% endblock %}
{% block content %}
    <div class="flex flex-wrap edit-form">
        {% form_theme form with ['@IntegratedPage/form/form_div_layout.html.twig'] %}

        {% block form_start %}
            {{ form_start(form, { 'style': 'horizontal' }) }}
        {% endblock %}
        <div id="toolbar" class="w-full flex justify-between">
            <div class="back">
                {% block form_return %}
                    {% if form.actions.back is defined %}
                        {{ form_row(form.actions.back) }}
                    {% endif %}
                    {% if form.actions.cancel is defined %}
                        {{ form_row(form.actions.cancel) }}
                    {% endif %}
                {% endblock %}
            </div>
            <div class="options">
                <div class="form-actions">
                    {% block form_actions %}
                        {% if form.actions.save is defined %}
                            {{ form_row(form.actions.save) }}
                        {% endif %}
                        {% if form.actions.reload is defined %}
                            {{ form_row(form.actions.reload) }}
                        {% endif %}
                        {% if form.actions.create is defined %}
                            {{ form_row(form.actions.create) }}
                        {% endif %}
                    {% endblock %}
                </div>
            </div>
        </div>
        <div class="aside-options"></div>
        <div class="editor-wrapper">
            <div class="page-title">
                <h1 class="heading">
                    {% block contentTitle %}
                        {% trans %}Copy{% endtrans %} {% trans %}pages{% endtrans %}
                    {% endblock %}
                </h1>
            </div>
            <section class="editor editor-wrapped">
                {{ form_rest(form, {'style':'horizontal', 'state': 'show'})}}
            </section>
        </div>
        {% block form_end %}
            {{ form_end(form) }}
        {% endblock %}
    </div>
{% endblock %}

{% block javascript %}
    {{ parent() }}

    <script>
    $('.copy-pages-blocks input:radio').click(function() {
        var newBlockIdField = $(this).closest('div.row').find('input:text');
        if ($(this).val() == '') {
            newBlockIdField.prop('disabled', true);
            newBlockIdField.val('');
        } else {
            newBlockIdField.prop('disabled', false);
            newBlockIdField.val(newBlockIdField.data('proposed-block-id'));
        }
    });
    </script>
{% endblock %}
