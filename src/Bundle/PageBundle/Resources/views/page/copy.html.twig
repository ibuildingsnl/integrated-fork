{% extends '@IntegratedContent/base.html.twig' %}
{% block title %}{% trans %}Copy page{% endtrans %}{% endblock title %}
{% block style %}
    {{ parent() }}

    <style>
        #copy-table .radio {
            padding-right: 15px;
        }
        #copy-table .radio:last-child {
            padding-right: 0px;
        }
    </style>
{% endblock %}
{% block content %}
    {% form_theme form with ['@IntegratedPage/form/form_div_layout.html.twig', '@IntegratedContent/form/form_div_layout.html.twig'] %}

    {% block form_start %}
        {{ form_start(form) }}
    {% endblock %}
    {% set pageCopyToolbarHtml %}
        {% block toolbar %}
            {% include '@IntegratedContent/partials/block.toolbar.html.twig' %}
        {% endblock toolbar %}
    {% endset %}
    {% set pageCopyTitleHtml %}
        {{ component('integrated_admin:page_title', {
            title: ('Copy'|trans) ~ ' ' ~ ('pages'|trans),
        }) }}
    {% endset %}
    {% set pageCopyEditorContentHtml %}
        {{ form_rest(form, {'style':'horizontal', 'state': 'show'})}}
    {% endset %}
    {{ component('integrated_admin:edit_form_shell', {
        toolbarHtml: pageCopyToolbarHtml,
        editorWrapperClass: 'editor-wrapper-full',
        pageTitleHtml: pageCopyTitleHtml,
        editorContentHtml: pageCopyEditorContentHtml,
    }) }}
    {% block form_end %}
        {{ form_end(form) }}
    {% endblock %}
{% endblock %}

{% block javascript %}
    {{ parent() }}

    <script>
    window.addEventListener('DOMContentLoaded', function() {
      var fields = document.querySelectorAll('[name*=newBlockId]');

      for (var i = 0; i < fields.length; i++) {
        fields[i].disabled = true;
      }
    });
    $('.copy-pages-blocks select').change(function() {
        var newBlockIdField = $(this).closest('div.row').find('input:text');
        if ($(this).val() == '') {
            newBlockIdField.prop('disabled', true);
            newBlockIdField.prop('required', false);
            newBlockIdField.val('');
        } else {
            newBlockIdField.prop('disabled', false);
            newBlockIdField.prop('required', true);
            newBlockIdField.val(newBlockIdField.data('proposed-block-id'));
        }
    });
    </script>
{% endblock %}
