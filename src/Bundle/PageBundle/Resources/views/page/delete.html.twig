{% extends '@IntegratedContent/base.html.twig' %}
{% block title %}{% trans %}Delete page{% endtrans %}{% endblock title %}

{% block content %}
    {% block form_start %}
        {{ form_start(form) }}
    {% endblock %}
    {% set pageDeleteToolbarHtml %}
        {% block toolbar %}
            {% include '@IntegratedContent/partials/block.toolbar.html.twig' %}
        {% endblock toolbar %}
    {% endset %}
    {% set pageDeleteTitleHtml %}
        {{ component('integrated_admin:page_title', {
            title: ('Delete'|trans) ~ ' ' ~ ('page'|trans),
        }) }}
    {% endset %}
    {% set pageDeleteContentHtml %}
        <p>
            {% trans with {'%name%':  page.title, '%channel%':  page.channel.name} %}You are about to delete "%name%" on %channel%, click the delete button to confirm the action.{% endtrans %}
        </p>
        {{ form_rest(form, {'style':'horizontal'})}}
    {% endset %}
    {{ component('integrated_admin:edit_form_shell', {
        toolbarHtml: pageDeleteToolbarHtml,
        pageTitleHtml: pageDeleteTitleHtml,
        editorContentHtml: pageDeleteContentHtml,
    }) }}
    {% block form_end %}
        {{ form_end(form) }}
    {% endblock %}
{% endblock %}
