{% extends '@IntegratedContent/base.html.twig' %}
{% block title %}{% trans %}Delete page{% endtrans %}{% endblock title %}
{% block crumbs %}
    <div class="breadcrumb-holder">
        <div class="container">
            <ol class="breadcrumb">
                <li>
                    <a href="{{ path('integrated_page_page_index') }}">{% trans %}Pages{% endtrans %}</a>
                </li>
                <li class="active">{% trans %}Delete{% endtrans %}</li>
            </ol>
        </div>
    </div>
{% endblock %}
{% block content %}
    <div class="row">
        <div class="w-full mb-4 md:mb-0">
            <div class="page-title">
                <h1 class="heading">{% trans %}Delete{% endtrans %} {% trans %}page{% endtrans %}</h1>
            </div>
            <section class="section-white section-padding section-radius">
                <p>
                    {% trans with {'%name%':  page.title, '%channel%':  page.channel.name} %}You are about to delete "%name%" on %channel%, click the delete button below to confirm the action.{% endtrans %}
                </p>
                {{ form(form, { 'style': 'horizontal' }) }}
            </section>
        </div>
    </div>
{% endblock %}
