{% extends '@IntegratedContent/base.html.twig' %}
{% block title %}{% trans %}New page{% endtrans %}{% endblock title %}
{% block content %}
<div class="flex flex-wrap edit-form">
    {% form_theme form with '@IntegratedPage/form/form_div_layout.html.twig' %}

    {% block form_start %}
        {{ form_start(form, { 'style': 'horizontal' }) }}
    {% endblock %}
    <div id="toolbar" class="w-full flex justify-between">
        <div class="options">
            <div class="form-actions">
                {% block form_actions %}
                    {% if form.actions.save is defined %}
                        {{ form_row(form.actions.save) }}
                    {% endif %}
                    {% if form.actions.reload is defined %}
                        {{ form_row(form.actions.reload) }}
                    {% endif %}
                    {% if form.actions.create is defined %}
                        {{ form_row(form.actions.create) }}
                    {% endif %}
                {% endblock %}
            </div>
        </div>
        <div class="back">
            {% block form_return %}
                {% if form.actions.back is defined %}
                    {{ form_row(form.actions.back) }}
                {% endif %}
                {% if form.actions.cancel is defined %}
                    {{ form_row(form.actions.cancel) }}
                {% endif %}
            {% endblock %}
        </div>
    </div>
    <div class="aside-options"></div>
    <div class="editor-wrapper">
        <div class="page-title">
            <h1 class="heading">
                {% block contentTitle %}
                    {% trans %}Edit{% endtrans %} {% trans %}page{% endtrans %}
                {% endblock %}
            </h1>
        </div>
        <section class="editor editor-wrapped">
            {{ form_rest(form, {'style':'horizontal', 'state': 'show'})}}
        </section>
    </div>
    {% block form_end %}
        {{ form_end(form) }}
    {% endblock %}
</div>
{% endblock %}

{% block javascript %}
    {{ parent() }}

    <script>
        var $channel = $('#integrated_page_page_channel');
        var $token = $('#integrated_page_page__token');
        $channel.change(function() {
            var $form = $(this).closest('form');
            var data = {};
            data[$channel.attr('name')] = $channel.val();
            data[$token.attr('name')] = $token.val();
            $.ajax({
                url : $form.attr('action'),
                type: $form.attr('method'),
                data : data,
                success: function(html) {
                    $('#integrated_page_page_layout').replaceWith(
                        $(html).find('#integrated_page_page_layout')
                    );
                }
            });
        });
    </script>
{% endblock %}
