{% extends '@IntegratedContent/base.html.twig' %}
{% block title %}{% trans %}New page{% endtrans %}{% endblock title %}
{% block content %}
    {% block form_start %}
        {{ form_start(form) }}
    {% endblock %}
    {% set pageNewToolbarHtml %}
        {% block toolbar %}
            {% include '@IntegratedContent/partials/block.toolbar.html.twig' %}
        {% endblock toolbar %}
    {% endset %}
    {% set pageNewTitleHtml %}
        {{ component('integrated_admin:page_title', {
            title: ('Edit'|trans) ~ ' ' ~ ('page'|trans),
        }) }}
    {% endset %}
    {% set pageNewContentHtml %}
        {{ form_rest(form, {'style':'horizontal', 'state': 'show'})}}
    {% endset %}
    {{ component('integrated_admin:edit_form_shell', {
        toolbarHtml: pageNewToolbarHtml,
        pageTitleHtml: pageNewTitleHtml,
        editorContentHtml: pageNewContentHtml,
    }) }}
    {% block form_end %}
        {{ form_end(form) }}
    {% endblock %}
{% endblock %}

{% block javascript %}
    {{ parent() }}

    <script>
        var $channel = $('#integrated_page_page_channel');
        var $token = $('#integrated_page_page__token');
        $channel.change(function() {
            var $form = $(this).closest('form');
            var data = {};
            data[$channel.attr('name')] = $channel.val();
            data[$token.attr('name')] = $token.val();
            $.ajax({
                url : $form.attr('action'),
                type: $form.attr('method'),
                data : data,
                success: function(html) {
                    $('#integrated_page_page_layout').replaceWith(
                        $(html).find('#integrated_page_page_layout')
                    );
                }
            });
        });
    </script>
{% endblock %}
