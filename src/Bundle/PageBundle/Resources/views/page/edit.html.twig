{% extends '@IntegratedContent/base.html.twig' %}
{% form_theme form with ['@IntegratedPage/form/form_div_layout.html.twig', '@IntegratedContent/form/form_div_layout.html.twig'] %}
{% block title %}{% trans %}Edit page{% endtrans %}{% endblock title %}
{% block webpack_js %}
    <script src="{{ asset('bundles/integratedintegrated/edit.js') }}" defer data-turbo-track="reload"></script>
{% endblock %}

{% block style %}
    {{ parent() }}

    <link rel="stylesheet" href="{{ asset('bundles/integratedintegrated/edit.css') }}">
    {{ include('admin/_integrated_editor_stylesheets.html.twig', ignore_missing = true) }}
{% endblock %}

{% block content %}
    <div class="flex flex-wrap edit-form">
        {% set pageDocument = page|default(form.vars.value|default(null)) %}
        {% set pageChannel = pageDocument and attribute(pageDocument, 'channel') is defined ? attribute(pageDocument, 'channel') : form.channel.vars.data|default(null) %}
        {% set pagePath = pageDocument and attribute(pageDocument, 'path') is defined ? attribute(pageDocument, 'path') : form.path.vars.value|default('') %}
        {% set pagePublishAt = pageDocument and attribute(pageDocument, 'publishAt') is defined ? attribute(pageDocument, 'publishAt') : (form.publishAt is defined ? form.publishAt.vars.data|default(null) : null) %}
        {% set pageExpireAt = pageDocument and attribute(pageDocument, 'expireAt') is defined ? attribute(pageDocument, 'expireAt') : (form.expireAt is defined ? form.expireAt.vars.data|default(null) : null) %}
        {% set pageOpenUrl = null %}
        {% set previewLink = previewLink|default(null) %}
        {% if pageChannel and pageChannel.primaryDomain is defined and pagePath and pageDocument and attribute(pageDocument, 'id') is defined and attribute(pageDocument, 'id') %}
            {% if pageChannel.primaryDomain == app.request.httphost %}
                {% set pageOpenUrl = pagePath %}
            {% else %}
                {% set pageOpenUrl = integrated_session_bridge_url(pageChannel.primaryDomain, app.session.id, pagePath) %}
            {% endif %}
        {% endif %}
        {% set now = date() %}
        {% block form_start %}
            {{ form_start(form) }}
        {% endblock %}
        {% block toolbar %}
            {% include '@IntegratedContent/partials/block.toolbar.html.twig' %}
        {% endblock toolbar %}
        <div class="aside-options">
            <aside>
                <div class="aside-holder">
                    {% set isConcept = form.disabled is defined and form.disabled.vars.data|default(false) %}
                    {% if isConcept %}
                        {% set statusClass = 'draft' %}
                        {% set statusIcon = 'design-pencil' %}
                        {% set statusLabel = 'Concept'|trans %}
                    {% elseif pagePublishAt and pagePublishAt > now %}
                        {% set statusClass = 'draft' %}
                        {% set statusIcon = 'calendar' %}
                        {% set statusLabel = 'Scheduled'|trans %}
                    {% elseif pageExpireAt and pageExpireAt <= now %}
                        {% set statusClass = 'draft' %}
                        {% set statusIcon = 'archive' %}
                        {% set statusLabel = 'Expired'|trans %}
                    {% else %}
                        {% set statusClass = 'published' %}
                        {% set statusIcon = 'check-circle' %}
                        {% set statusLabel = 'Published'|trans %}
                    {% endif %}
                    <div class="aside-header">
                        <button class="toggle-filters toggle-options-sidebar" data-target="aside-options" type="button">
                            <i class="iconoir-xmark"></i>
                        </button>
                        <span>{% trans %}Options{% endtrans %}</span>
                    </div>

                    {% block editor_sidebar_extensions %}
                        {% if pageDocument %}
                            {{ integrated_page_editor_sidebar_extensions(pageDocument, form, {
                                route: app.request.attributes.get('_route'),
                            }) }}
                        {% endif %}
                    {% endblock %}

                    <div class="aside-item-wrapper show">
                        <div class="aside-item-header">
                            <h3 class="aside-item-title">
                                <i class="iconoir-info-circle"></i>
                                <span class="aside-item-icon">{% trans %}Status{% endtrans %}</span>
                            </h3>
                            <i class="iconoir-nav-arrow-up"></i>
                        </div>
                        <div class="aside-item-list">
                            <div class="aside-item-list-container">
                                <div class="status-info">
                                    {% for fieldName in ['publishAt', 'expireAt'] %}
                                        {% if attribute(form, fieldName) is defined %}
                                            {{ form_row(attribute(form, fieldName), { 'style': 'inline', 'label_col': 'w-full', 'widget_col': 'w-full', 'label_attr': { 'class': 'inline-label-visible' } }) }}
                                        {% endif %}
                                    {% endfor %}
                                    <div class="form-group">
                                        <label class="control-label w-full sm:w-1/3">{% trans %}Page type{% endtrans %}</label>
                                        <div class="w-full sm:w-2/3">
                                            {% trans %}Page{% endtrans %}
                                        </div>
                                    </div>
                                    {% if pageChannel %}
                                        <div class="form-group">
                                            <label class="control-label w-full sm:w-1/3">{% trans %}Channel{% endtrans %}</label>
                                            <div class="w-full sm:w-2/3">
                                                {{ pageChannel.name }}
                                            </div>
                                        </div>
                                    {% endif %}
                                    {% if pagePath %}
                                        <div class="form-group">
                                            <label class="control-label w-full sm:w-1/3">{% trans %}URL{% endtrans %}</label>
                                            <div class="w-full sm:w-2/3">
                                                {% if pageOpenUrl %}
                                                    <a href="{{ pageOpenUrl }}" target="_blank" rel="noopener noreferrer" data-turbo="false">
                                                        /{{ pagePath|trim('/') }}
                                                    </a>
                                                {% else %}
                                                    /{{ pagePath|trim('/') }}
                                                {% endif %}
                                            </div>
                                        </div>
                                    {% endif %}
                                </div>
                                <div class="status-options">
                                    <div class="status {{ statusClass }}">
                                        <i class="iconoir-{{ statusIcon }}"></i>
                                        {{ statusLabel }}
                                    </div>
                                </div>
                                <div class="mt-2">
                                    {% if form.disabled is defined %}
                                        {{ form_row(form.disabled) }}
                                    {% endif %}
                                    {% if previewLink %}
                                        <div class="form-group">
                                            <label class="control-label w-full">{% trans %}Preview link (24h){% endtrans %}</label>
                                            <div class="w-full">
                                                <a href="{{ previewLink }}" target="_blank" rel="noopener noreferrer" data-turbo="false">
                                                    {{ previewLink }}
                                                </a>
                                            </div>
                                        </div>
                                    {% endif %}
                                    {% for fieldName in ['expireRedirectUrl'] %}
                                        {% if attribute(form, fieldName) is defined %}
                                            {{ form_row(attribute(form, fieldName), { 'style': 'inline', 'label_col': 'w-full', 'widget_col': 'w-full' }) }}
                                        {% endif %}
                                    {% endfor %}
                                </div>
                            </div>
                        </div>
                    </div>

                    {% if form.featuredImage is defined %}
                        <div class="aside-item-wrapper show">
                            <div class="aside-item-header">
                                <h3 class="aside-item-title">
                                    <i class="iconoir-media-image"></i>
                                    <span class="aside-item-icon">{% trans %}Featured image{% endtrans %}</span>
                                </h3>
                                <i class="iconoir-nav-arrow-up"></i>
                            </div>
                            <div class="aside-item-list">
                                <div class="aside-item-list-container">
                                    {{ form_row(form.featuredImage, { 'label': false, 'style': 'inline', 'label_col': 'w-full', 'widget_col': 'w-full' }) }}
                                </div>
                            </div>
                        </div>
                    {% endif %}

                    <div class="aside-item-wrapper show">
                        <div class="aside-item-header">
                            <h3 class="aside-item-title">
                                <i class="iconoir-settings"></i>
                                <span class="aside-item-icon">{% trans %}Page settings{% endtrans %}</span>
                            </h3>
                            <i class="iconoir-nav-arrow-up"></i>
                        </div>
                        <div class="aside-item-list">
                            <div class="aside-item-list-container">
                                {% for fieldName in ['canonicalUrl', 'robotsDirective', 'twitterCard', 'paginationNoindexEnabled', 'hideFromSitemap'] %}
                                    {% if attribute(form, fieldName) is defined %}
                                        {{ form_row(attribute(form, fieldName), { 'style': 'inline', 'label_col': 'w-full', 'widget_col': 'w-full' }) }}
                                    {% endif %}
                                {% endfor %}
                            </div>
                        </div>
                    </div>
                </div>
            </aside>
        </div>
        <div class="editor-wrapper">
            <div class="editor-overlay"></div>
            <div class="page-title">
                <h1 class="heading">
                    {% block contentTitle %}
                        {% trans %}Edit{% endtrans %} {{ page.title }}
                    {% endblock %}
                </h1>
            </div>
            <section class="editor editor-wrapped">
                {% for fieldName in ['channel', 'title', 'path', 'description', 'layout'] %}
                    {% if attribute(form, fieldName) is defined %}
                        {{ form_row(attribute(form, fieldName), {'style': 'horizontal', 'state': 'show'}) }}
                    {% endif %}
                {% endfor %}

                {% for child in form %}
                    {% if not child.rendered and child.vars.name not in ['featuredImage', 'canonicalUrl', 'robotsDirective', 'twitterCard', 'paginationNoindexEnabled', 'publishAt', 'expireAt', 'expireRedirectUrl', 'hideFromSitemap', 'disabled', 'actions'] %}
                        {{ form_row(child, {'style': 'horizontal', 'state': 'show'}) }}
                    {% endif %}
                {% endfor %}
            </section>
        </div>
        {% block form_end %}
            {{ form_end(form) }}
        {% endblock %}
    </div>
{% endblock %}
