{% extends '@IntegratedContent/base.html.twig' %}
{% block title %}{% trans %}Edit page{% endtrans %}{% endblock title %}
{% block content %}
    {% block form_start %}
        {{ form_start(form) }}
    {% endblock %}
    {% set pageEditToolbarHtml %}
        {% block toolbar %}
            {% include '@IntegratedContent/partials/block.toolbar.html.twig' %}
        {% endblock toolbar %}
    {% endset %}
    {% set pageEditTitleHtml %}
        {{ component('integrated_admin:page_title', {
            title: ('Edit'|trans) ~ ' ' ~ ('page'|trans),
        }) }}
    {% endset %}
    {% set pageEditContentHtml %}
        {{ form_rest(form, {'style': 'horizontal', 'state': 'show'})}}
    {% endset %}
    {{ component('integrated_admin:edit_form_shell', {
        toolbarHtml: pageEditToolbarHtml,
        pageTitleHtml: pageEditTitleHtml,
        editorContentHtml: pageEditContentHtml,
    }) }}
    {% block form_end %}
        {{ form_end(form) }}
    {% endblock %}
{% endblock %}
