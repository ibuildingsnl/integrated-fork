{% extends '@IntegratedContent/base.html.twig' %}
{% block title %}{% trans %}Edit page{% endtrans %}{% endblock title %}
{% block crumbs %}
    <div class="breadcrumb-holder">
        <div class="container">
            <ol class="breadcrumb">
                <li>
                    <a href="{{ path('integrated_page_page_index') }}">{% trans %}Pages{% endtrans %}</a>
                </li>
                <li class="active">{% trans %}Edit{% endtrans %}</li>
            </ol>
        </div>
    </div>
{% endblock %}
{% block content %}
    <div class="flex flex-wrap">
        <div class="w-full mb-4 md:mb-0">
            <div class="page-title">
                <h1 class="heading">{% trans %}Edit {% endtrans %} {% trans %} page{% endtrans %}</h1>
            </div>
            <section class="section-white section-padding section-radius">
                {% form_theme form with ['@IntegratedPage/form/form_div_layout.html.twig'] %}

                {{ form(form, { 'style': 'horizontal' }) }}
            </section>
        </div>
    </div>
{% endblock %}
