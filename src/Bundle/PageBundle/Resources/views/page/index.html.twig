{% extends '@IntegratedContent/base.html.twig' %}
{% block title %}{% trans %}Pages{% endtrans %}{% endblock title %}
{% form_theme filterForm with '@IntegratedFormType/form/form_div_layout.html.twig' %}
{% block content %}
    <div class="row flex flex-wrap">
        <div class="index-wrapper">
            {% if lastPage %}
                {% if (lastPage.domain == app.request.httphost) %}
                    {% set lastUrl = lastPage.path %}
                    {% set editUrl = lastPage.path ~ '?integrated_website_edit=1' %}
                {% else %}
                    {% set lastUrl = '//'~lastPage.domain~path('integrated_website_enter_session', {'sessionId': app.session.id, 'path': lastPage.path}) %}
                    {% set editUrl = '//'~lastPage.domain~path('integrated_website_enter_session', {'sessionId': app.session.id, 'path': lastPage.path ~ '?integrated_website_edit=1'}) %}
                {% endif %}
                {#        //TODO: FIX THIS #}
                <div class="alert alert-info alert-inline">
                    <div class="flex justify-between">
                        <span class="flex items-center"><b class="mr-2">{% trans %}Last changed{% endtrans %}:</b> "{{ lastPage.title }}" {% trans %}on{% endtrans %} "{{ lastPage.channel.name }}"</span>
                        <ul class="options-no-bg flex">
                            <li>
                                <button type="button" class="btn btn-select btn-green mr-2"
                                        onclick="window.location.href='{{ lastUrl }}';">{% trans %}Open page{% endtrans %}</button>
                            </li>
                            <li class="dropdown close-outside" data-underlay="no">
                                <a href="#" data-toggle="dropdown" role="button" id="drop_1" class="btn btn-select">
                                    <span class="flex items-center">{% trans %}Options{% endtrans %}</span>
                                    <i class="iconoir-nav-arrow-down"></i>
                                </a>
                                <ul aria-labelledby="drop_1" role="menu" class="dropdown-menu" id="menu_1">
                                    <li><a href="{{ editUrl }}">{% trans %}Edit page{% endtrans %}</a></li>
                                    <li>
                                        <a href="{{ path('integrated_page_page_edit', {'id': lastPage.id}) }}">{% trans %}Edit page properties{% endtrans %}</a>
                                    </li>
                                </ul>
                            </li>
                        </ul>
                    </div>
                </div>
            {% endif %}
            <div class="page-title flex justify-between flex-wrap">
                <div class="flex items-center">
                    <h1 class="heading">{% trans %}Pages{% endtrans %}</h1>
                    <ul class="create">
                        <li>
                            <a class="btn btn-create-new" href="{{ path('integrated_page_page_new') }}">
                                <span>{% trans %}New{% endtrans %} {% trans %}page{% endtrans %}</span>
                                <i class="iconoir-plus"></i>
                            </a>
                            <a class="btn btn-create-new" href="{{ path('integrated_page_page_copy') }}">
                                <span>{% trans %}Copy{% endtrans %} {% trans %}page{% endtrans %}</span>
                                <i class="iconoir-copy"></i>
                            </a>
                        </li>
                    </ul>
                </div>
                <button class="toggle-filters toggle-data-target btn btn-orange icon-left"  data-target="aside-filters">
                    <i class="iconoir-filter-alt"></i>
                    <span>{% trans %}Filter{% endtrans %}</span>
                </button>
            </div>
            <section class="section-white section-radius">

                <table class="table table-hover">
                    <colgroup>
                        <col/>
                        <col/>
                        <col/>
                        <col/>
                    </colgroup>

                    <thead>
                    <tr>
                        <th>{% trans %}Path{% endtrans %}</th>
                        <th>{% trans %}Title{% endtrans %}</th>
                        <th>{% trans %}Channel{% endtrans %}</th>
                        <th>{% trans %}Layout{% endtrans %}</th>
                    </tr>
                    </thead>
                    <tbody>

                    {% for page in pages %}
                        <tr class="has-options">
                            <td>
                                <strong>
                                    {% if page.type == 'page' and page.domain != "" %}
                                    {% if (page.domain == app.request.httphost) %}
                                    <a href="{{ page.path }}" title="{% trans %}Open page{% endtrans %}">
                                        {% else %}
                                        <a href="//{{ page.domain }}{{ path('integrated_website_enter_session', {'sessionId': app.session.id, 'path': page.path}) }}"
                                           title="{% trans %}Open page{% endtrans %}">
                                            {% endif %}
                                            {% endif %}
                                            {{ page.path }}
                                            {% if page.type == 'page' and page.domain != "" %}
                                        </a>
                                        {% endif %}
                                    </a>
                                </strong>
                                <div class="row-options">
                                    <a href="{{ path('integrated_page_'~page.type~'_edit', { 'id': page.id}) }}"
                                       title="{% trans %}Edit page properties{% endtrans %}">
                                        {% trans %}Edit page properties{% endtrans %}
                                    </a>
                                    {% if not page.locked %}
                                        | <a href="{{ path('integrated_page_page_delete', { 'id': page.id }) }}"
                                             class="color-red" title="{% trans %}Delete{% endtrans %}">
                                        {% trans %}Delete{% endtrans %}
                                    </a>
                                    {% endif %}
                                </div>
                            </td>
                            <td>
                                {{ page.title }}
                            </td>
                            <td>
                                {{ page.channel.name }}
                            </td>
                            <td>
                                {{ page.layout|split('/')|last|replace({'.html.twig': ''}) }}
                            </td>
                        </tr>

                    {% else %}

                        <tr>
                            <td colspan="4">
                                {% trans %}No pages added{% endtrans %}
                            </td>
                        </tr>

                    {% endfor %}

                    </tbody>
                </table>

                {{ knp_pagination_render(pages) }}
            </section>
        </div>
        <div class="aside-filters close-outside">
            <aside>
                <div class="aside-holder section-gray section-radius">
                    <div class="aside-header">
                        <button class="toggle-filters toggle-data-target"  data-target="aside-filters"><i class="iconoir-xmark"></i></button>
                        <span>{% trans %}Filters{% endtrans %}</span>
                        <a href="{{ path('integrated_page_page_index') }}" class="clear-filters"><span>{% trans %}Remove active filters{% endtrans %}</span>
                            <i class="iconoir-xmark"></i>
                        </a>
                    </div>
                    {{ form_start(filterForm) }}

                    {% if filterForm.q is defined %}
                        <div class="aside-item-holder">
                            <div class="input-group input-group-search">
                                {{ form_widget(filterForm.q) }}
                                <span class="input-group-btn">
                                <button type="submit" class="">
                                    <i class="iconoir-search"></i>
                                </button>
                            </span>
                            </div>
                        </div>
                    {% endif %}
                    {% if filterForm.pagetype is defined %}
                        <div
                            class="aside-item-holder{% if filterForm.pagetype.vars.choices|length == 0 %} hidden{% endif %}">
                            {{ form_row(filterForm.pagetype, {'style':'sidebar','state':'show search'}) }}
                        </div>
                    {% endif %}
                    {% if filterForm.channel is defined %}
                        <div
                            class="aside-item-holder{% if filterForm.channel.vars.choices|length == 0 %} hidden{% endif %}">
                            {{ form_row(filterForm.channel, {'style':'sidebar', 'icon':'network-alt', 'state':'show search'}) }}
                        </div>
                    {% endif %}
                    <div class="aside-item-holder">
                        {{ form_rest(filterForm, {'style':'sidebar', 'state': 'show'}) }}
                    </div>
                    {{ form_end(filterForm) }}
                </div>
            </aside>
        </div>
    </div>

{% endblock %}

{% block javascript %}
{{ parent() }}

<script type="text/javascript">
    $(function () {
        $('[data-toggle="popover"]').popover();

        $('form[name="page_filter"]').on('change', function () {
            $(this).trigger('submit');
        });
    });
</script>
{% endblock %}
