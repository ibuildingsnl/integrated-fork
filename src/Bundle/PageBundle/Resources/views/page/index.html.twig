{% extends '@IntegratedContent/base.html.twig' %}
{% block title %}{% trans %}Pages{% endtrans %}{% endblock title %}
{% form_theme filterForm with '@IntegratedFormType/form/form_div_layout.html.twig' %}
{% block content %}
    <div class="row flex flex-wrap">
        <div class="index-wrapper">
            {% if lastPage %}
                {% if (lastPage.domain == app.request.httphost) %}
                    {% set lastUrl = lastPage.path %}
                    {% set editUrl = lastPage.path ~ '?integrated_website_edit=1' %}
                {% else %}
                    {% set lastUrl = integrated_session_bridge_url(lastPage.domain, app.session.id, lastPage.path) %}
                    {% set editUrl = integrated_session_bridge_url(lastPage.domain, app.session.id, lastPage.path ~ '?integrated_website_edit=1') %}
                {% endif %}
                {#        //TODO: FIX THIS #}
                <div class="alert alert-info alert-inline">
                    <div class="flex justify-between">
                        <span class="flex items-center"><b class="mr-2">{% trans %}Last changed{% endtrans %}:</b> "{{ lastPage.title }}" {% trans %}on{% endtrans %} "{{ lastPage.channel.name }}"</span>
                        <ul class="options-no-bg flex">
                            <li>
                                <a href="{{ lastUrl }}" class="btn btn-select btn-green mr-2" target="_blank" rel="noopener noreferrer" data-turbo="false">
                                    {% trans %}Open page{% endtrans %}
                                </a>
                            </li>
                            <li class="dropdown close-outside" data-underlay="no">
                                <a href="#" data-toggle="dropdown" role="button" id="drop_1" class="btn btn-select">
                                    <span class="flex items-center">{% trans %}Options{% endtrans %}</span>
                                    <i class="iconoir-nav-arrow-down"></i>
                                </a>
                                <ul aria-labelledby="drop_1" role="menu" class="dropdown-menu" id="menu_1">
                                    <li><a href="{{ editUrl }}" target="_blank" rel="noopener noreferrer" data-turbo="false">{% trans %}Edit page{% endtrans %}</a></li>
                                    <li>
                                        <a href="{{ path('integrated_page_page_edit', {'id': lastPage.id}) }}">{% trans %}Edit page properties{% endtrans %}</a>
                                    </li>
                                </ul>
                            </li>
                        </ul>
                    </div>
                </div>
            {% endif %}
            <div class="page-title flex justify-between flex-wrap">
                <div class="flex items-center">
                    <h1 class="heading">{% trans %}Pages{% endtrans %}</h1>
                    <ul class="create">
                        <li>
                            <a class="btn btn-create-new" href="{{ path('integrated_page_page_new') }}">
                                <span>{% trans %}New{% endtrans %} {% trans %}page{% endtrans %}</span>
                                <i class="iconoir-plus"></i>
                            </a>
                            <a class="btn btn-create-new" href="{{ path('integrated_page_page_copy') }}">
                                <span>{% trans %}Copy{% endtrans %} {% trans %}page{% endtrans %}</span>
                                <i class="iconoir-copy"></i>
                            </a>
                            {% if is_granted('ROLE_ADMIN') and noneFilterActive|default(false) %}
                                <form method="post"
                                      action="{{ path('integrated_page_page_delete_without_channel_bulk') }}"
                                      style="display:inline-block"
                                      onsubmit="return confirm('{% trans %}Are you sure you want to delete all pages without channel in the current filter?{% endtrans %}');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete_without_channel_pages_bulk') }}">
                                    <input type="hidden" name="page_filter[q]" value="{{ activeFilterData.q|default('') }}">
                                    {% for value in activeFilterData.pagetype|default([]) %}
                                        <input type="hidden" name="page_filter[pagetype][]" value="{{ value }}">
                                    {% endfor %}
                                    {% for value in activeFilterData.channel|default([]) %}
                                        <input type="hidden" name="page_filter[channel][]" value="{{ value }}">
                                    {% endfor %}
                                    {% for value in activeFilterData.status|default([]) %}
                                        <input type="hidden" name="page_filter[status][]" value="{{ value }}">
                                    {% endfor %}
                                    <input type="hidden" name="page_filter[_applied]" value="1">
                                    <button type="submit" class="btn btn-create-new">
                                        <span>{% trans %}Delete pages without channel{% endtrans %}</span>
                                        <i class="iconoir-trash"></i>
                                    </button>
                                </form>
                            {% endif %}
                        </li>
                    </ul>
                </div>
                <button class="toggle-filters toggle-data-target btn btn-orange icon-left"  data-target="aside-filters">
                    <i class="iconoir-filter-alt"></i>
                    <span>{% trans %}Filter{% endtrans %}</span>
                </button>
            </div>
            <section class="section-white section-radius">

                <table class="table table-hover page-index-table">
                    <colgroup>
                        <col/>
                        <col/>
                        <col/>
                        <col/>
                    </colgroup>

                    <thead>
                    <tr>
                        <th>{% trans %}Path{% endtrans %}</th>
                        <th>{% trans %}Title{% endtrans %}</th>
                        <th>{% trans %}Channel{% endtrans %}</th>
                        <th>{% trans %}Layout{% endtrans %}</th>
                        <th class="seo">{% trans %}SEO{% endtrans %}</th>
                        <th class="state">{% trans %}Status{% endtrans %}</th>
                    </tr>
                    </thead>
                    <tbody>

                    {% for page in pages %}
                        <tr class="has-options">
                            <td>
                                <strong>
                                    {% if page.type == 'page' and page.domain != "" %}
                                    {% if (page.domain == app.request.httphost) %}
                                    <a href="{{ page.path }}" title="{% trans %}Open page{% endtrans %}" target="_blank" rel="noopener noreferrer" data-turbo="false">
                                        {% else %}
                                        <a href="{{ integrated_session_bridge_url(page.domain, app.session.id, page.path) }}"
                                           title="{% trans %}Open page{% endtrans %}" target="_blank" rel="noopener noreferrer" data-turbo="false">
                                            {% endif %}
                                            {% endif %}
                                            {{ page.path }}
                                            {% if page.type == 'page' and page.domain != "" %}
                                        </a>
                                        {% endif %}
                                    </a>
                                </strong>
                                <div class="row-options">
                                    <a href="{{ path('integrated_page_'~page.type~'_edit', { 'id': page.id}) }}"
                                       title="{% trans %}Edit page properties{% endtrans %}">
                                        {% trans %}Edit page properties{% endtrans %}
                                    </a>
                                    {% if page.type == 'page' and page.disabled and previewLinks[page.id]|default('') %}
                                        | <a href="{{ previewLinks[page.id] }}" target="_blank" rel="noopener noreferrer" data-turbo="false"
                                             title="{% trans %}Preview link (24h){% endtrans %}">
                                        {% trans %}Preview link (24h){% endtrans %}
                                    </a>
                                    {% endif %}
                                    {% set canDeletePage = (not page.locked) or (page.type == 'content_type_page' and deletableContentTypePageIds[page.id]|default(false)) %}
                                    {% if canDeletePage %}
                                        | <a href="{{ path('integrated_page_page_delete', { 'id': page.id }) }}"
                                             class="color-red" title="{% trans %}Delete{% endtrans %}">
                                        {% trans %}Delete{% endtrans %}
                                    </a>
                                    {% endif %}
                                    {% if orphanChannelPageIds[page.id]|default(false) and is_granted('ROLE_ADMIN') %}
                                        | <form method="post" action="{{ path('integrated_page_page_delete_without_channel', { 'id': page.id }) }}"
                                                style="display:inline"
                                                onsubmit="return confirm('{% trans %}Are you sure you want to delete this page without channel?{% endtrans %}');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete_without_channel_page_' ~ page.id) }}">
                                        <button type="submit" class="color-red border-0 bg-transparent p-0"
                                                title="{% trans %}Delete without channel{% endtrans %}">
                                            {% trans %}Delete without channel{% endtrans %}
                                        </button>
                                    </form>
                                    {% endif %}
                                </div>
                            </td>
                            <td>
                                {{ page.title }}
                            </td>
                            <td>
                                {{ page.channel.name }}
                            </td>
                            <td>
                                {{ page.layout|split('/')|last|replace({'.html.twig': ''}) }}
                            </td>
                            <td class="seo">
                                {% if page.type == 'page' and page.seoMetadata is defined and page.seoMetadata %}
                                    {% set seoScore = page.seoMetadata.seoScore|default('feedback') %}
                                    {% set readabilityScore = page.seoMetadata.readabilityScore|default('feedback') %}
                                    <span class="btn btn-white no-icon seo-button readability-{{ readabilityScore }} seo-{{ seoScore }}">
                                        SEO
                                    </span>
                                {% else %}
                                    -
                                {% endif %}
                            </td>
                            <td class="state">
                                {% set now = date() %}
                                {% if page.type == 'page' %}
                                    {% set pagePublishAt = page.publishAt|default(null) %}
                                    {% set pageExpireAt = page.expireAt|default(null) %}
                                    {% if page.disabled %}
                                        <div class="workflow-status" title="{% trans %}Draft{% endtrans %}" style="background-color:{{ '#ababab'|alpha(12) }};border-color:{{ '#ababab'|alpha(45) }};color:#ababab;">
                                            <i class="iconoir-edit-pencil"></i>
                                        </div>
                                    {% elseif pagePublishAt and pagePublishAt > now %}
                                        <div class="workflow-status" title="{% trans %}Scheduled{% endtrans %}" style="background-color:{{ '#5f84db'|alpha(12) }};border-color:{{ '#5f84db'|alpha(45) }};color:#5f84db;">
                                            <i class="iconoir-calendar"></i>
                                        </div>
                                    {% elseif pageExpireAt and pageExpireAt <= now %}
                                        <div class="workflow-status" title="{% trans %}Expired{% endtrans %}" style="background-color:{{ '#b7791f'|alpha(12) }};border-color:{{ '#b7791f'|alpha(45) }};color:#b7791f;">
                                            <i class="iconoir-archive"></i>
                                        </div>
                                    {% else %}
                                        <div class="workflow-status" title="{% trans %}Published{% endtrans %}" style="background-color:{{ '#00ae93'|alpha(12) }};border-color:{{ '#00ae93'|alpha(45) }};color:#00ae93;">
                                            <i class="iconoir-check"></i>
                                        </div>
                                    {% endif %}
                                {% elseif page.type == 'content_type_page' %}
                                    <div class="workflow-status" title="{% trans %}System page{% endtrans %}" style="background-color:{{ '#6c7b89'|alpha(12) }};border-color:{{ '#6c7b89'|alpha(45) }};color:#6c7b89;">
                                        <i class="iconoir-empty-page"></i>
                                    </div>
                                {% else %}
                                    <span class="text-muted">—</span>
                                {% endif %}
                            </td>
                        </tr>

                    {% else %}

                        <tr>
                            <td colspan="6">
                                {% trans %}No pages added{% endtrans %}
                            </td>
                        </tr>

                    {% endfor %}

                    </tbody>
                </table>

                {{ knp_pagination_render(pages, '@KnpPaginator/Pagination/sliding.html.twig') }}
            </section>
        </div>
        <div class="aside-filters close-outside">
            <aside>
                <div class="aside-holder section-gray section-radius">
                    <div class="aside-header">
                        <button class="toggle-filters toggle-data-target"  data-target="aside-filters"><i class="iconoir-xmark"></i></button>
                        <span>{% trans %}Filters{% endtrans %}</span>
                        <a href="{{ path('integrated_page_page_index') }}" class="clear-filters"><span>{% trans %}Remove active filters{% endtrans %}</span>
                            <i class="iconoir-xmark"></i>
                        </a>
                    </div>
                    {{ form_start(filterForm) }}

                    {% if filterForm.q is defined %}
                        <div class="aside-item-holder">
                            <div class="input-group input-group-search">
                                {{ form_widget(filterForm.q) }}
                            </div>
                        </div>
                    {% endif %}
                    {% if filterForm.pagetype is defined %}
                        <div
                            class="aside-item-holder{% if filterForm.pagetype.vars.choices|length == 0 %} hidden{% endif %}">
                            {{ form_row(filterForm.pagetype, {'style':'sidebar', 'state':'show'}) }}
                        </div>
                    {% endif %}
                    {% if filterForm.channel is defined %}
                        <div
                            class="aside-item-holder{% if filterForm.channel.vars.choices|length == 0 %} hidden{% endif %}">
                            {{ form_row(filterForm.channel, {'style':'sidebar', 'icon':'network-reverse', 'state':'show'}) }}
                        </div>
                    {% endif %}
                    {% if filterForm.status is defined %}
                        <div class="aside-item-holder">
                            {{ form_row(filterForm.status, {'style':'sidebar', 'state':'show'}) }}
                        </div>
                    {% endif %}
                    <div class="aside-item-holder">
                        {{ form_rest(filterForm, {'style':'sidebar', 'state': 'show'}) }}
                    </div>
                    {{ form_end(filterForm) }}
                </div>
            </aside>
        </div>
    </div>

{% endblock %}

{% block javascript %}
{{ parent() }}

<script type="text/javascript">
    (function () {
        function bindPageFilterAutoSubmit() {
            document.querySelectorAll('form[name="page_filter"]').forEach(function (form) {
                if (form.dataset.autoSubmitBound === '1') {
                    return;
                }

                form.dataset.autoSubmitBound = '1';

                var submitForm = function () {
                    form.requestSubmit ? form.requestSubmit() : form.submit();
                };

                form.addEventListener('change', function () {
                    submitForm();
                });

                var searchInput = form.querySelector('input[name="page_filter[q]"]');
                if (!searchInput) {
                    return;
                }

                var debounceTimer = null;

                searchInput.addEventListener('input', function () {
                    window.clearTimeout(debounceTimer);
                    debounceTimer = window.setTimeout(function () {
                        submitForm();
                    }, 350);
                });

                searchInput.addEventListener('keydown', function (event) {
                    if (event.key !== 'Enter') {
                        return;
                    }

                    event.preventDefault();
                    window.clearTimeout(debounceTimer);
                    submitForm();
                });
            });
        }

        function initializePageIndexInteractions() {
            bindPageFilterAutoSubmit();

        if (window.jQuery && typeof window.jQuery.fn.popover === 'function') {
            window.jQuery('[data-toggle="popover"]').popover();
        } else if (window.bootstrap && typeof window.bootstrap.Popover === 'function') {
            document.querySelectorAll('[data-toggle="popover"]').forEach(function (element) {
                new window.bootstrap.Popover(element);
            });
        }
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initializePageIndexInteractions);
        } else {
            initializePageIndexInteractions();
        }

        document.addEventListener('turbo:load', bindPageFilterAutoSubmit);
    })();
</script>
{% endblock %}
