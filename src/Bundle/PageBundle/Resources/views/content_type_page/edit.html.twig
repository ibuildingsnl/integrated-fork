{% extends '@IntegratedContent/base.html.twig' %}
{% block title %}{% trans %}Edit content type page{% endtrans %}{% endblock title %}
{% block crumbs %}
    <div class="breadcrumb-holder">
        <div class="container">
            <ol class="breadcrumb">
                <li>
                    <a href="{{ path('integrated_page_page_index') }}">{% trans %}Pages{% endtrans %}</a>
                </li>
                <li class="active">{% trans %}Edit{% endtrans %}</li>
            </ol>
        </div>
    </div>
{% endblock %}
{% block content %}
    <div class="row">
        <div class="w-full mb-4 p-8 md:mb-0">
            <div class="page-title">
                <h1 class="heading">{% trans %}Edit{% endtrans %} {% trans %}content type page{% endtrans %}</h1>
            </div>
            <section class="section-white section-padding section-radius">
                <h2>{{ page.contentType.name }}</h2>
                {{ form(form, { 'style': 'horizontal' }) }}
            </section>
        </div>
    </div>
{% endblock %}
