{% extends '@IntegratedContent/base.html.twig' %}
{% block title %}{% trans %}Edit content type page{% endtrans %}{% endblock title %}

{% block content %}
    {% block form_start %}
        {{ form_start(form) }}
    {% endblock %}
    {% set contentTypePageEditToolbarHtml %}
        {% block toolbar %}
            {% include '@IntegratedContent/partials/block.toolbar.html.twig' %}
        {% endblock toolbar %}
    {% endset %}
    {% set contentTypePageEditTitleHtml %}
        {{ component('integrated_admin:page_title', {
            title: ('Edit'|trans) ~ ' ' ~ page.contentType.name ~ ' ' ~ ('content type page'|trans)
        }) }}
    {% endset %}
    {% set contentTypePageEditEditorContentHtml %}
        {{ form_rest(form) }}
    {% endset %}
    {{ component('integrated_admin:edit_form_shell', {
        toolbarHtml: contentTypePageEditToolbarHtml,
        pageTitleHtml: contentTypePageEditTitleHtml,
        editorContentHtml: contentTypePageEditEditorContentHtml,
    }) }}
    {% block form_end %}
        {{ form_end(form) }}
    {% endblock %}
{% endblock %}
