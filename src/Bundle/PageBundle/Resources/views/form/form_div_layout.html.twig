{% block _integrated_page_page_path_widget %}
    <div class="input-group">
        <div class="input-group-addon">/</div>
        <input type="text" {{ block('widget_attributes') }} class="form-control" {% if value is not empty %}value="{{ value }}" {% endif %}>
    </div>
{% endblock %}

{% block page_copy_pages_row %}
    {% apply spaceless %}
        <div class="page-copy-panel-list" data-page-copy-panel-list>
            {% for field in form %}
                {{ form_row(field) }}
            {% endfor %}
        </div>
    {% endapply %}
{% endblock %}

{% block page_copy_page_row %}
    {% apply spaceless %}
        {% set isExpanded = false %}
        {% if form.vars.errors|length > 0 %}
            {% set isExpanded = true %}
        {% endif %}
        {% for blockField in form.blocks %}
            {% if blockField.vars.errors|length > 0
                or blockField.operation.vars.errors|length > 0
                or blockField.newBlockId.vars.errors|length > 0
                or blockField.operation.vars.data|default('') == 'clone' %}
                {% set isExpanded = true %}
            {% endif %}
        {% endfor %}
        <div class="section-white section-radius mb-4 overflow-hidden page-copy-panel" data-page-copy-panel data-page-copy-expanded="{{ isExpanded ? 'true' : 'false' }}" data-page-copy-selected="{{ form.selected.vars.data ? 'true' : 'false' }}">
            <div class="page-copy-panel-header px-4 py-3 border-b border-solid border-gray-200" data-page-copy-panel-header>
                <div class="flex flex-wrap items-center justify-between gap-3">
                    <div class="flex items-center gap-3 page-copy-panel-header__selection">
                        <label class="checkbox-switcher" for="{{ form.selected.vars.id }}">
                            <input
                                type="checkbox"
                                id="{{ form.selected.vars.id }}"
                                name="{{ form.selected.vars.full_name }}"
                                class="switch-input"
                                data-page-copy-select="true"
                                value="{{ form.selected.vars.value }}"
                                {% if form.selected.vars.checked %}checked="checked"{% endif %}
                            />
                            <span class="switch-label" data-on="{% trans %}Yes{% endtrans %}" data-off="{% trans %}No{% endtrans %}"></span>
                            <span class="switch-handle"></span>
                        </label>
                        <div>
                            <div class="font-semibold">{{ page.title }}</div>
                            <div class="text-sm text-gray-500">{{ page.path }}</div>
                        </div>
                    </div>
                    <div class="flex items-center gap-3">
                        <span class="label {% if copyAction == 'overwrite' %}label-warning{% else %}label-success{% endif %}" data-page-copy-action>
                            {% if copyAction == 'overwrite' %}
                                {% trans %}Overwrite{% endtrans %}
                            {% else %}
                                {% trans %}Create{% endtrans %}
                            {% endif %}
                        </span>
                        {% if blockCount > 0 %}
                            <button type="button" class="btn btn-white no-icon" data-page-copy-clone-all{% if not form.selected.vars.data %} disabled{% endif %}>
                                {% trans %}Clone all blocks{% endtrans %}
                            </button>
                            <button type="button" class="btn btn-select" data-page-copy-toggle aria-expanded="{{ isExpanded ? 'true' : 'false' }}">
                                {% trans %}Blocks{% endtrans %}
                            </button>
                        {% else %}
                            <span class="text-sm text-gray-500" data-page-copy-no-blocks>{% trans %}No blocks{% endtrans %}</span>
                        {% endif %}
                    </div>
                </div>
            </div>
            <div class="page-copy-panel-body px-4 py-4" data-page-copy-panel-body{% if not isExpanded %} style="display:none;"{% endif %}>
                {{ form_widget(form.blocks) }}
            </div>
        </div>
    {% endapply %}
{% endblock %}

{% block page_copy_block_row %}
    {% apply spaceless %}
        {% set isCloneOperation = form.operation.vars.data|default('') == 'clone' %}
        <div class="flex flex-wrap h-full row py-2 border-b border-solid border-gray-100" data-page-copy-block-row>
            <div class="w-full md:w-1/3 flex items-center mb-2 md:mb-0">
                {{ block.id|u.truncate(20) }}
            </div>
            <div class="w-full md:w-1/3 pr-2 mb-2 md:mb-0" data-page-copy-block-operation>
                {{ form_widget(form.operation) }}
            </div>
            <div class="w-full md:w-1/3" data-page-copy-new-block-id-container{% if not isCloneOperation %} style="display:none;"{% endif %}>
                {{ form_widget(form.newBlockId, { attr: form.newBlockId.vars.attr|merge({ 'data-page-copy-new-block-id': 'true' }) }) }}
            </div>
        </div>
    {% endapply %}
{% endblock %}
