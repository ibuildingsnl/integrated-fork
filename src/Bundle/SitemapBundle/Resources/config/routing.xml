<?xml version="1.0" encoding="UTF-8" ?>

<routes xmlns="http://symfony.com/schema/routing"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://symfony.com/schema/routing http://symfony.com/schema/routing/routing-1.0.xsd">

    <route id="integrated_sitemap_index" path="/sitemap.xml" methods="GET">
        <default key="_controller">Integrated\Bundle\SitemapBundle\Controller\DefaultController::index</default>
        <default key="_format">xml</default>
    </route>

    <route id="integrated_sitemap_list" path="/sitemap{page}.xml" methods="GET">
        <default key="_controller">Integrated\Bundle\SitemapBundle\Controller\DefaultController::list</default>
        <default key="_format">xml</default>

        <requirement key="page">[1-9]\d*</requirement>
    </route>

    <route id="integrated_sitemap_list_pages" path="/sitemap-pages-{page}.xml" methods="GET">
        <default key="_controller">Integrated\Bundle\SitemapBundle\Controller\DefaultController::listPages</default>
        <default key="_format">xml</default>

        <requirement key="page">[1-9]\d*</requirement>
    </route>

    <route id="integrated_sitemap_list_by_type" path="/sitemap-{type}-{page}.xml" methods="GET">
        <default key="_controller">Integrated\Bundle\SitemapBundle\Controller\DefaultController::listByType</default>
        <default key="_format">xml</default>

        <requirement key="type">[A-Za-z0-9_]+</requirement>
        <requirement key="page">[1-9]\d*</requirement>
    </route>

    <route id="integrated_sitemap_news_index" path="/news-sitemap.xml" methods="GET">
        <default key="_controller">Integrated\Bundle\SitemapBundle\Controller\NewsController::index</default>
        <default key="_format">xml</default>
    </route>

    <route id="integrated_sitemap_news_list" path="/news-sitemap{page}.xml" methods="GET">
        <default key="_controller">Integrated\Bundle\SitemapBundle\Controller\NewsController::list</default>
        <default key="_format">xml</default>

        <requirement key="page">[1-9]\d*</requirement>
    </route>

    <route id="integrated_sitemap_robots" path="/robots.txt" methods="GET">
        <default key="_controller">Integrated\Bundle\SitemapBundle\Controller\RobotsController::index</default>
        <default key="_format">txt</default>
    </route>

</routes>
