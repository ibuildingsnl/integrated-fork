{% apply spaceless %}
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
    {% for document in documents %}
        {% set location = document.path is defined
            ? (document.path starts with('/') ? document.path : '/' ~ document.path)
            : integrated_url(document)
        %}
        {% if location %}
            {% set lastModified = document.updatedAt ?? document.createdAt ?? null %}
            <url>
                <loc>{{ absolute_url(location) }}</loc>
                {% if lastModified %}
                    <lastmod>{{ lastModified|date('c') }}</lastmod>
                {% endif %}
            </url>
        {% endif %}
    {% endfor %}
</urlset>
{% endapply %}
