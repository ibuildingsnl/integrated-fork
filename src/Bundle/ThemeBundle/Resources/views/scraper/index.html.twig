{% extends '@IntegratedContent/base.html.twig' %}
{% block title %}{% trans %}Scrapers{% endtrans %} {% endblock title %}

{% block content %}
    <div class="row">
        <div class="index-wrapper-full">
            {% set createActionsHtml %}
                <ul class="create">
                    <li>
                        <a class="btn btn-create-new" href="{{ path('integrated_theme_scraper_new') }}">
                            <span>{% trans %}New{% endtrans %} {% trans %}scraper{% endtrans %}</span>
                            <i class="iconoir-plus"></i>
                        </a>
                    </li>
                </ul>
            {% endset %}
            {{ component('integrated_admin:page_title', {
                title: 'Scrapers'|trans,
                actionsHtml: createActionsHtml,
            }) }}

            {% component 'integrated_admin:section_card' %}
                {% block content %}
                {% set scraperTableHeadHtml %}
                    <tr>
                        <th>{% trans %}Name{% endtrans %}</th>
                        <th>{% trans %}Channel{% endtrans %}</th>
                        <th>{% trans %}Template{% endtrans %}</th>
                        <th>{% trans %}URL{% endtrans %}</th>
                        <th>{% trans %}Updated{% endtrans %}</th>
                    </tr>
                {% endset %}
                {% set scraperTableBodyHtml %}
                    {% for scraper in result %}
                        <tr class="has-options">
                            <td>
                                <strong>
                                    <a href="{{ path('integrated_theme_scraper_edit', {'id': scraper.id}) }}">
                                        {{ scraper.name }}
                                    </a>
                                </strong>
                                <div class="row-options">
                                    <a href="{{ path('integrated_theme_scraper_edit', {'id': scraper.id}) }}"
                                       title="{% trans %}Edit{% endtrans %}">
                                        {% trans %}Edit{% endtrans %}
                                    </a> |
                                    <a class="color-red"
                                       href="{{ path('integrated_theme_scraper_delete', {'id': scraper.id}) }}"
                                       title="{% trans %}Delete{% endtrans %}">
                                        {% trans %}Delete{% endtrans %}
                                    </a>
                                </div>
                            </td>
                            <td>
                            </td>
                            <td>
                                {{ scraper.channelId }}
                            </td>
                            <td>
                                {{ scraper.templateName|replace({'Resources/views': '[..]'})|u.truncate(50) }}
                            </td>
                            <td>
                                {{ scraper.url|u.truncate(50) }}
                            </td>
                            <td>
                                {{ scraper.lastModified|format_date("medium", "none") }}
                            </td>
                        </tr>
                        {% if scraper.lastError %}
                            <tr>
                                <td colspan="5">
                                    <pre>{{ scraper.lastError }}</pre>
                                </td>
                            </tr>
                        {% endif %}
                    {% endfor %}
                {% endset %}
                {{ component('integrated_admin:data_table', {
                    headHtml: scraperTableHeadHtml,
                    bodyHtml: scraperTableBodyHtml,
                    emptyMessage: 'No scrapers added'|trans,
                    colSpan: 5,
                }) }}
                {% endblock %}
            {% endcomponent %}
        </div>
    </div>
{% endblock %}
