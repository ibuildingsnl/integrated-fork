{% extends '@IntegratedContent/base.html.twig' %}
{% block title %}{% trans %}Edit scraper{% endtrans %} {% endblock title %}
{% block content %}
    <div class="flex flex-wrap edit-form">
        {% block form_start %}
            {{ form_start(form, { 'style': 'horizontal' }) }}
        {% endblock %}
        {% block toolbar %}
            {% include '@IntegratedContent/partials/block.toolbar.html.twig' %}
        {% endblock toolbar %}
        <div class="aside-options"></div>
        <div class="editor-wrapper">
            <div class="page-title">
                <h1 class="heading">{% trans %}Edit Scraper{% endtrans %}</h1>
            </div>
            <section class="editor editor-wrapped">
                {{ form_rest(form, {'style':'horizontal', 'state': 'show'})}}
            </section>
        </div>
        {% block form_end %}
            {{ form_end(form) }}
        {% endblock %}
    </div>
{% endblock %}
