{% extends '@IntegratedContent/base.html.twig' %}
{% block title %}{% trans %}Edit scraper{% endtrans %} {% endblock title %}
{% block content %}
    {% block form_start %}
        {{ form_start(form) }}
    {% endblock %}
    {% set scraperEditToolbarHtml %}
        {% block toolbar %}
            {% include '@IntegratedContent/partials/block.toolbar.html.twig' %}
        {% endblock toolbar %}
    {% endset %}
    {% set scraperEditTitleHtml %}
        {{ component('integrated_admin:page_title', {
            title: 'Edit Scraper'|trans,
        }) }}
    {% endset %}
    {% set scraperEditContentHtml %}
        {{ form_rest(form, {'style':'horizontal', 'state': 'show'})}}
    {% endset %}
    {{ component('integrated_admin:edit_form_shell', {
        toolbarHtml: scraperEditToolbarHtml,
        pageTitleHtml: scraperEditTitleHtml,
        editorContentHtml: scraperEditContentHtml,
    }) }}
    {% block form_end %}
        {{ form_end(form) }}
    {% endblock %}
{% endblock %}
