{% extends '@IntegratedContent/base.html.twig' %}
{% block title %}{% trans %}Delete{% endtrans %} {{ scraper.name }}{% endblock title %}
{% block crumbs %}
    <div class="breadcrumb-holder">
        <div class="container">
            <ol class="breadcrumb">
                <li>
                    <a href="{{ path('integrated_theme_scraper_index') }}">{% trans %}Scrapers{% endtrans %}</a>
                </li>
                <li class="active">{% trans %}Delete{% endtrans %}</li>
            </ol>
        </div>
    </div>
{% endblock %}

{% block content %}
    <div class="page-title">
        <h1 class="heading">{% trans %}Delete{% endtrans %} {{ scraper.name }}</h1>
    </div>

    <div class="row">
        <div class="w-full">
            <section class="section-white section-padding section-radius">
                <p>
                    {% trans with {'%name%': scraper.name} %}
                        You are about to delete "%name%", click the delete button below to confirm the action.
                    {% endtrans %}
                </p>
                <p>
                    <a class="btn btn-primary" href="{{ path('integrated_theme_scraper_index') }}">
                        {% trans %}Cancel{% endtrans %}
                    </a>
                </p>
                {{ form(form) }}
            </section>
        </div>
    </div>
{% endblock %}
