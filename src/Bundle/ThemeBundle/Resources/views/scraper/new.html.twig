{% extends '@IntegratedContent/base.html.twig' %}
{% block title %}{% trans %}New scraper{% endtrans %} {% endblock title %}
{% block content %}
    {% block form_start %}
        {{ form_start(form) }}
    {% endblock %}
    {% set scraperNewToolbarHtml %}
        {% block toolbar %}
            {% include '@IntegratedContent/partials/block.toolbar.html.twig' %}
        {% endblock toolbar %}
    {% endset %}
    {% set scraperNewTitleHtml %}
        {{ component('integrated_admin:page_title', {
            title: 'New Scraper'|trans,
        }) }}
    {% endset %}
    {% set scraperNewContentHtml %}
        {{ form_rest(form, {'style':'horizontal', 'state': 'show'})}}
    {% endset %}
    {{ component('integrated_admin:edit_form_shell', {
        toolbarHtml: scraperNewToolbarHtml,
        pageTitleHtml: scraperNewTitleHtml,
        editorContentHtml: scraperNewContentHtml,
    }) }}
    {% block form_end %}
        {{ form_end(form) }}
    {% endblock %}
{% endblock %}
