{% block integrated_file_dropzone_row %}
    {% apply spaceless %}
        {% set widget_col = widget_col|default(tailwind_get_widget_col()) %}
        {% set style = style|default(tailwind_get_style()) %}
        {% set state = state|default(tailwind_get_state()) %}
        {% if style == 'sidebar' %}
            <div
                class="aside-item-wrapper{% if form.vars.errors|length > 0 %} has-error show{% endif %} {% if state is not empty %}{{ state }}{% endif %}">
                <div class="aside-item-header">
                    <h3 class="aside-item-title">
                        <i class="iconoir-{% if icon is not empty %}{{ icon }}{% else %}folder{% endif %}"></i>
                        <span class="aside-item-icon">
                            {{ form_label(form) }}
                        </span>
                    </h3>
                    <i class="iconoir-nav-arrow-up"></i>
                </div>
                <div class="aside-item-list">
                    <div class="aside-item-list-container">
                        <div class="w-full">
                            {% set changeInput %}
                                <div class="jFiler-input-inner dropzone-empty">
                                    <div class="jFiler-input-icon">
                                        <i class="icon-jfi-cloud-up-o"></i>
                                    </div>
                                    <div class="jFiler-input-text">
                                        <h3>{{ "Drag&Drop " ~ (type|first in ['a', 'e', 'i', 'u', 'o'] ? 'an ' : 'a ')  ~ type ~ " here"|trans }}</h3>
                                        <span>{% trans %}or click to browse{% endtrans %}</span>
                                    </div>
                                </div>
                            {% endset %}

                            {% set options = options|merge({'changeInput': changeInput}) %}

                            <div class="jFiler-input-dragDrop integrated-dropzone {% if required %}required{% endif %}"
                                 data-options="{{ options|json_encode }}">
                                {{ form_widget(form.file) }}
                                {{ form_widget(form.remove) }}
                            </div>

                            {{ form_errors(form.file) }}
                        </div>
                    </div>
                </div>
            </div>
        {% elseif style == 'editor' %}
            <div
                class="editor-item-wrapper{% if form.vars.errors|length > 0 %} has-error show{% endif %} {% if state is not empty %}{{ state }}{% endif %}">
                <div class="editor-item-header">
                    <h3 class="editor-item-title">
                        <span class="editor-item-icon">
                            {{ form_label(form) }}
                        </span>
                    </h3>
                    <i class="iconoir-nav-arrow-up"></i>
                </div>
                <div class="editor-item-list">
                    <div class="editor-item-list-container">
                        <div class="w-full">
                            {% set changeInput %}
                                <div class="jFiler-input-inner dropzone-empty">
                                    <div class="jFiler-input-icon">
                                        <i class="icon-jfi-cloud-up-o"></i>
                                    </div>
                                    <div class="jFiler-input-text">
                                        <h3>{{ "Drag&Drop " ~ (type|first in ['a', 'e', 'i', 'u', 'o'] ? 'an ' : 'a ')  ~ type ~ " here"|trans }}</h3>
                                        <span>{% trans %}or click to browse{% endtrans %}</span>
                                    </div>
                                </div>
                            {% endset %}

                            {% set options = options|merge({'changeInput': changeInput}) %}

                            <div class="jFiler-input-dragDrop integrated-dropzone {% if required %}required{% endif %}"
                                 data-options="{{ options|json_encode }}">
                                {{ form_widget(form.file) }}
                                {{ form_widget(form.remove) }}
                            </div>

                            {{ form_errors(form.file) }}
                        </div>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="form-group w-full flex flex-wrap{% if not form.vars.valid %} has-error{% endif %}">
                {{ form_label(form) }}
                <div class="w-full {{ widget_col }}">
                    {% set changeInput %}
                        <div class="jFiler-input-inner dropzone-empty">
                            <div class="jFiler-input-icon">
                                <i class="icon-jfi-cloud-up-o"></i>
                            </div>
                            <div class="jFiler-input-text">
                                <h3>{{ "Drag&Drop " ~ (type|first in ['a', 'e', 'i', 'u', 'o'] ? 'an ' : 'a ')  ~ type ~ " here"|trans }}</h3>
                                <span>{% trans %}or click to browse{% endtrans %}</span>
                            </div>
                        </div>
                    {% endset %}

                    {% set options = options|merge({'changeInput': changeInput}) %}

                    <div class="jFiler-input-dragDrop integrated-dropzone {% if required %}required{% endif %}"
                         data-options="{{ options|json_encode }}">
                        {{ form_widget(form.file) }}
                        {{ form_widget(form.remove) }}
                    </div>

                    {{ form_errors(form.file) }}
                </div>
            </div>
        {% endif %}
    {% endapply %}
{% endblock %}

{% block integrated_image_dropzone_row %}
    {{ block('integrated_file_dropzone_row') }}
{% endblock %}

{% block integrated_media_gallery_image_row %}
    <div class="m-12">
        <div id="select_multimedia_button" class="p-2 bg-blue-200 border border-black w-32 mb-4" onclick="showMediaGallery()">Selecteer een afbeelding</div>

        <div id="wrap" class="mb-4" style="display: none;">
            <iframe id="frame" src="/admin/media/select_one" width="1500" height="500"></iframe>
        </div>

        <div class="mb-2">Geselecteerde afbeelding:</div>
        <div id="selected_images" class="mb-4"></div>

    {#    <input type="file" id="integrated_content_media_gallery_image_file" name="integrated_content[media_gallery_image][file]">#}
    {#    <input type="file" id="integrated_content_media_gallery_image_file" name="integrated_content[media_gallery_image][file]" style="position: absolute; left: -9999px; top: -9999px; z-index: -9999;">#}

        <li id="selected_image" class="hidden media-item ui-widget-content ui-corner-tr grid">
            <div class="media-preview">
                <div class="thumbnail">
                    <div class="centered">
                        <img src="">
                    </div>
                </div>
            </div>
        </li>

        <script>
            let possible_modi = [
                "select_one", "select_multiple"
            ]
            let response_from_iframe = []
            let modus = 'select_one'

            function cloneImage(selectedImage) {
                let clone = $("#selected_image").clone(true,true);
                let clone_img = clone.find('img')
                clone.attr('id', selectedImage.id)
                clone_img.attr("src", selectedImage.thumbnail)
                clone.removeClass('hidden')
                handleClone(clone)
            }

            function handleClone(clone) {
                if (modus == 'select_one') {
                    $('#selected_images').empty()
                    $('#selected_images').append(clone)
                } else if (modus == 'select_multiple') {
                    $('#selected_images').append(clone)
                }
            }

            function filterImages(selection) {
                return selection.filter(item => item.content_type == 'image')
            }

            window.addEventListener('message', function (e) {
                response_from_iframe = filterImages(JSON.parse(e.data))
                if (response_from_iframe.length > 0) {
                    response_from_iframe.map(item => cloneImage(item))
                    closeMediaGallery()
                 } else {
                    console.log("no image selected")
                }
            });



            // todo when we implement select multiple images
            function removeImageFromList() {}

            function closeMediaGallery() {
                reloadMediaLibrary()
                $('#wrap').hide()
                $('#select_multimedia_button').show()
            }

            function reloadMediaLibrary() {
                $( '#frame' ).attr( 'src', function ( i, val ) { return val; });
            }

            function showMediaGallery() {

                $('#wrap').show()
                $('#select_multimedia_button').hide()
            }
        </script>

        <style>
            #wrap { width: 2000px; height: 900px; padding: 0; overflow: hidden; }
            #frame { width: 2000px; height: 900px; border: 1px solid black; }
            #frame {
                -ms-zoom: 0.75;
                -moz-transform: scale(0.75);
                -moz-transform-origin: 0 0;
                -o-transform: scale(0.75);
                -o-transform-origin: 0 0;
                -webkit-transform: scale(0.75);
                -webkit-transform-origin: 0 0;
            }
        </style>
    </div>
{% endblock %}
