<?xml version="1.0" encoding="UTF-8" ?>

<routes xmlns="http://symfony.com/schema/routing"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://symfony.com/schema/routing https://symfony.com/schema/routing/routing-1.0.xsd">

    <route id="woodwing_index" path="api/woodwing/issues" methods="GET">
        <default key="_controller">Integrated\Bundle\WoodwingBundle\Controller\WoodwingController:index</default>
    </route>

    <route id="woodwing_show" path="api/woodwing/issue/{issue}" methods="GET">
        <default key="_controller">Integrated\Bundle\WoodwingBundle\Controller\WoodwingController:show</default>
    </route>

    <route id="woodwing_process" path="api/woodwing/article/{article}/issued" methods="POST,GET">
        <default key="_controller">Integrated\Bundle\WoodwingBundle\Controller\WoodwingController:markProcessed</default>
    </route>

</routes>
