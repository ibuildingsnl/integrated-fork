<?xml version="1.0" encoding="UTF-8" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>

        <defaults autowire="true" autoconfigure="true"/>

        <service id="integrated_woodwing.woodwing_post.repository" class="Doctrine\ODM\MongoDB\Repository\DocumentRepository">
            <factory service="doctrine_mongodb.odm.document_manager" method="getRepository" />
            <argument type="string">\Integrated\Bundle\WoodwingBundle\Document\WoodwingPost</argument>
        </service>

        <service id="integrated_woodwing.taxonomy.repository" class="Doctrine\ODM\MongoDB\Repository\DocumentRepository">
            <factory service="doctrine_mongodb.odm.document_manager" method="getRepository" />
            <argument type="string">\Integrated\Bundle\ContentBundle\Document\Content\Taxonomy</argument>
        </service>

        <service id="Integrated\Bundle\WoodwingBundle\Controller\WoodwingController" autowire="true" autoconfigure="true">
            <argument type="service" id="integrated_woodwing.woodwing_post.repository" />
            <argument type="service" id="integrated_woodwing.taxonomy.repository" />
            <argument type="service" id="integrated_content.services.flusher" />
            <argument>%env(resolve:WOODWING_API_SECRET)%</argument>

            <tag name="controller.service_arguments" />
            <tag name="container.service_subscriber" />

            <call method="setContainer">
                <argument type="service" id="service_container" />
            </call>
        </service>

        <service id="integrated_brand.type.woodwing" class="Integrated\Bundle\ContentBundle\Infrastructure\ChannelTypeFactory">
            <argument>woodwing</argument>
            <argument>woodwing</argument>
            <argument type="expression">false</argument>
            <argument>woodwing</argument>
            <argument>Integrated\Bundle\WoodwingBundle\Form\WoodwingPublicationType</argument>

            <tag name="integrated_channel.type" />
        </service>

        <service id="Integrated\Bundle\WoodwingBundle\Form\WoodwingPublicationType">
            <argument type="service" id="integrated_content.content_repository" />

            <tag name="form.type" />
        </service>

        <service id="Integrated\Bundle\WoodwingBundle\Connector\WoodwingConfigType" />

        <service id="Integrated\Bundle\WoodwingBundle\Connector\WoodwingConnector" />

        <service id="Integrated\Bundle\WoodwingBundle\Connector\WoodwingConfiguration" />

        <service id="integrated_connector.woodwing" class="Integrated\Bundle\ChannelBundle\Adaptor\ConnectorAdapter">
            <argument type="service" id="Integrated\Bundle\WoodwingBundle\Connector\WoodwingConnector" />
            <argument type="service" id="Integrated\Bundle\WoodwingBundle\Connector\WoodwingConfiguration" />
            <argument type="service" id="logger" />

            <tag name="integrated_channel.connector" />
        </service>

        <service id="Integrated\Bundle\WoodwingBundle\EventListener\WoodwingIntegrationListener">
            <argument type="service" id="integrated_content.content_type.manager" />
            <argument type="service" id="integrated_content.content_repository" />
            <argument type="service" id="integrated_content.publication_repository" />
            <argument>woodwing_post</argument>

            <tag name="integrated_content.form.event_subscriber"/>
        </service>

    </services>

</container>
