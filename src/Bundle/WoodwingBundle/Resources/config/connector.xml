<?xml version="1.0" encoding="UTF-8" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>

        <defaults autowire="true" autoconfigure="true"/>

        <service id="integrated_brand.type.woodwing" class="Integrated\Bundle\ContentBundle\Infrastructure\ChannelTypeFactory">
            <argument>woodwing</argument>
            <argument>woodwing</argument>
            <argument type="expression">false</argument>
            <argument>woodwing</argument>
            <argument>\Integrated\Bundle\WoodwingBundle\Form\LinkedInPublicationType</argument>

            <tag name="integrated_channel.type" />
        </service>

        <service id="Integrated\Bundle\WoodwingBundle\Connector\WoodwingConfigType">
            <argument type="service" id="Integrated\Bundle\WoodwingBundle\Connector\WoodwingFactory"></argument>
<!--            <argument>%env(resolve:LINKEDIN_CONSUMER_SECRET)%</argument>-->
<!--            <argument type="service" id="integrated_content.routing.generator" ></argument>-->
        </service>


        <service id="Integrated\Bundle\WoodwingBundle\Connector\WoodwingFactory">
            <argument>%env(resolve:LINKEDIN_CONSUMER_KEY)%</argument>
            <argument>%env(resolve:LINKEDIN_CONSUMER_SECRET)%</argument>
            <argument type="service" id="integrated_content.routing.generator" ></argument>
        </service>

        <service id="Integrated\Bundle\WoodwingBundle\Connector\WoodwingConnector" />

        <service id="Integrated\Bundle\WoodwingBundle\Connector\WoodwingConfiguration" />

<!--        <service id="Integrated\Bundle\WoodwingBundle\Form\AddLinkedInPageFieldListener" >-->
<!--            <argument type="service" id="Integrated\Bundle\WoodwingBundle\Connector\LinkedInFactory" />-->
<!--&lt;!&ndash;            <argument type="service" id="Integrated\Bundle\WoodwingBundle\Connector\LinkedInConfiguration" />&ndash;&gt;-->
<!--&lt;!&ndash;            <tag name="integrated_channel.connector" />&ndash;&gt;-->
<!--        </service>-->

        <service id="td_connector.woodwing" class="Integrated\Bundle\ChannelBundle\Adaptor\ConnectorAdapter">
            <argument type="service" id="Integrated\Bundle\WoodwingBundle\Connector\WoodwingConnector" />
            <argument type="service" id="Integrated\Bundle\WoodwingBundle\Connector\WoodwingConfiguration" />
            <argument type="service" id="logger" />
            <tag name="integrated_channel.connector" />
        </service>

        <service id="td_connector.listener.woodwing" class="Integrated\Bundle\ChannelBundle\Adaptor\ConnectorConfigSubscriber">
            <argument type="service" id="Integrated\Bundle\WoodwingBundle\Connector\WoodwingConfiguration" />
            <argument key="$em" type="service" id="doctrine.orm.entity_manager" />

            <tag name="kernel.event_subscriber" />
        </service>

    </services>

</container>
