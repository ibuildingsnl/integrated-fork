<?xml version="1.0" encoding="UTF-8" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <parameters>

        <parameter key="integrated_image.converter.web_format">png</parameter>

    </parameters>

    <services>

        <defaults autowire="true" autoconfigure="true"/>

        <service id="integrated_image.container_converter" class="Integrated\Bundle\ImageBundle\Converter\Container" />

        <service id="integrated_image.converter_imagemagick" class="Integrated\Bundle\ImageBundle\Converter\Adapter\ImageMagickAdapter">
            <argument type="service" id="integrated_storage.cache_app" />

            <tag name="integrated_image.converter" />
        </service>

        <service id="integrated_image.converter_web_format" class="Integrated\Bundle\ImageBundle\Converter\WebFormatConverter">
            <argument type="service" id="integrated_image.container_converter" />
            <argument type="service" id="integrated_image.format_web" />
            <argument type="service" id="integrated_storage.cache_app" />
            <argument>%integrated_image.converter.web_format%</argument>
        </service>

    </services>

</container>
