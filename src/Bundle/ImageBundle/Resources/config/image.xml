<?xml version="1.0" encoding="UTF-8" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <parameters>
        <parameter key="image.handling.class">Integrated\ImageBundle\Services\ImageHandling</parameter>
        <parameter key="image.handler.class">Integrated\ImageBundle\Image\ImageHandler</parameter>
    </parameters>

    <services>
        <!-- Image handling factory -->
        <service id="image.handling" class="%image.handling.class%" public="true">
            <argument>%gregwar_image.cache_dir%</argument>
            <argument>%gregwar_image.cache_dir_mode%</argument>
            <argument>%image.handler.class%</argument>
            <argument>@service_container</argument>
            <argument>@assets.packages</argument>
            <argument>@file_locator</argument>
            <argument>%gregwar_image.throw_exception%</argument>
            <argument>%gregwar_image.fallback_image%</argument>
        </service>

        <!-- Helper Twig -->
        <service id="twig.extension.image" class="Gregwar\ImageBundle\Extensions\ImageTwig">
            <argument>@image.handling</argument>
            <argument>%gregwar_image.web_dir%</argument>
            <tag name="twig.extension" />
        </service>
    </services>
</container>
