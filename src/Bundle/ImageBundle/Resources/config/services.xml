<?xml version="1.0" encoding="UTF-8" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <parameters>

        <parameter key="integrated_image.format" type="collection">
            <parameter>webp</parameter>
            <parameter>gif</parameter>
            <parameter>svg</parameter>
        </parameter>

    </parameters>

    <services>

        <defaults autowire="true" autoconfigure="true"/>

        <service id="integrated_image.format_web" class="Integrated\Bundle\ImageBundle\Converter\Format\WebFormat">
            <argument>%integrated_image.format%</argument>
        </service>

        <service id="integrated_image.image_mimic_handling" parent="image.handling">
            <argument index="2">Integrated\Bundle\ImageBundle\Image\ImageMimicHandler</argument>
        </service>

    </services>

</container>
