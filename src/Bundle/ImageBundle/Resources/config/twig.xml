<?xml version="1.0" encoding="UTF-8" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <parameters>

        <parameter key="integrated_image.twig_mimic_formats" type="collection">
            <parameter>svg</parameter>
        </parameter>

    </parameters>

    <services>

        <defaults autowire="true" autoconfigure="true"/>

        <service id="integrated_image.twig_extension" class="Integrated\Bundle\ImageBundle\Twig\Extension\ImageExtension" public="true">
            <argument type="service" id="integrated_image.liip_image_handling" />
            <argument type="service" id="integrated_image.converter_web_format" />

            <tag name="twig.extension" />
        </service>

    </services>

</container>
