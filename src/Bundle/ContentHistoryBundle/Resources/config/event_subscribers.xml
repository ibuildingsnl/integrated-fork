<?xml version="1.0" encoding="UTF-8" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>

        <defaults autowire="true" autoconfigure="true"/>

        <service id="integrated_content_history.event_listener.content_history_subscriber" class="Integrated\Bundle\ContentHistoryBundle\EventListener\ContentHistorySubscriber">
            <argument type="service" id="event_dispatcher"/>
            <argument>Integrated\Bundle\ContentHistoryBundle\Document\ContentHistory</argument>
            <tag name="doctrine_mongodb.odm.event_listener" event="onFlush" />
        </service>

        <service id="integrated_content_history.event_listener.content_subscriber" class="Integrated\Bundle\ContentHistoryBundle\EventListener\ContentSubscriber">
            <argument type="service" id="doctrine_mongodb.odm.document_manager"/>
        </service>

        <service id="integrated_content_history.event_listener.request_subscriber" class="Integrated\Bundle\ContentHistoryBundle\EventListener\RequestSubscriber">
            <argument type="service" id="request_stack"/>
        </service>

        <service id="integrated_content_history.event_listener.user_subscriber" class="Integrated\Bundle\ContentHistoryBundle\EventListener\UserSubscriber">
            <argument type="service" id="security.token_storage"/>
        </service>

    </services>

</container>
