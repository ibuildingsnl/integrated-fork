{% extends '@IntegratedContent/base.html.twig' %}

{% block content %}
    <div class="row flex flex-wrap">
        {% block toolbar %}
            <div id="toolbar" class="w-full flex justify-between">
                <div class="options">
                    <div class="form-actions">
                        <a class="no-icon btn btn-white" href="{{ path('integrated_content_history_index', {'id': content.id}) }}">{% trans %}Reset{% endtrans %}</a>
                    </div>
                </div>
                <div class="back">
                    <a class="no-icon btn btn-white icon-left" href="{{ path("integrated_content_content_edit", {'id': content.id }) }}">
                        <i class="iconoir iconoir-arrow-left"></i><span>{% trans %}Back{% endtrans %}</span>
                    </a>
                </div>
            </div>
        {% endblock toolbar %}
        <div class="index-wrapper-full">
            <div class="page-title">
                <h1 class="heading">{% trans %}History for{% endtrans %} {{ content.title }}</h1>
            </div>

            <div class="section-white section-radius p-2 mb-4">
                <form id="content-history-filter-form" method="get" class="history-index-filters">
                    <div class="flex flex-wrap gap-2">
                        <input class="form-control" type="text" name="q" value="{{ filters.q|default('') }}" placeholder="{% trans %}Search user/action{% endtrans %}">
                        <select class="form-control" name="action">
                            <option value="">{% trans %}All actions{% endtrans %}</option>
                            <option value="insert" {% if filters.action == 'insert' %}selected{% endif %}>{% trans %}insert{% endtrans %}</option>
                            <option value="update" {% if filters.action == 'update' %}selected{% endif %}>{% trans %}update{% endtrans %}</option>
                            <option value="delete" {% if filters.action == 'delete' %}selected{% endif %}>{% trans %}delete{% endtrans %}</option>
                        </select>
                        <input class="form-control" type="text" name="user" value="{{ filters.user|default('') }}" placeholder="{% trans %}User{% endtrans %}">
                        <input class="form-control" type="date" name="from" value="{{ filters.from|default('') }}">
                        <input class="form-control" type="date" name="to" value="{{ filters.to|default('') }}">
                        <button class="no-icon btn btn-green" type="submit" form="content-history-filter-form">{% trans %}Filter{% endtrans %}</button>
                    </div>
                </form>
            </div>

            <section class="section-white section-radius">
                <table class="table table-hover">
                    <thead>
                    <tr>
                        <th>{% trans %}Date{% endtrans %}</th>
                        <th>{% trans %}Action{% endtrans %}</th>
                        <th>{% trans %}User{% endtrans %}</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for document in paginator %}
                        <tr>
                            <td>
                                <a href="{{ path('integrated_content_history_show', { 'id': document.id }) }}">{{ document.date|format_datetime('medium', 'short') }}</a>
                            </td>
                            <td>{{ document.action|trans }}</td>
                            <td>{{ document.user.name|default('Unknown'|trans) }} {% if document.user.id is defined %}(#{{ document.user.id }}){% endif %}</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>

                {{ knp_pagination_render(paginator, '@KnpPaginator/Pagination/sliding.html.twig') }}
            </section>
        </div>
    </div>
{% endblock %}
