{% extends '@IntegratedContent/base.html.twig' %}

{% block crumbs %}
    <div class="breadcrumb-holder">
        <div class="container">
            <ol class="breadcrumb">
                <li>
                    <a href="{{ path('integrated_content_content_index') }}">{% trans %}Content navigator{% endtrans %}</a>
                </li>
                <li>
                    <a href="{{ path('integrated_content_content_index', { 'contenttypes': [ type.id ] }) }}">{{ type.name|trans }}</a>
                </li>
                <li>
                    <a href="{{ path('integrated_content_content_edit', { 'id': content.id }) }}">{{ content|default(type.name|trans) }}</a>
                </li>
                <li>
                    <a href="{{ path('integrated_content_history_index', { 'id': content.id }) }}">{% trans %}History{% endtrans %}</a>
                </li>
                {% block crumbs_items %}
                    <li class="active">{% trans %}Show{% endtrans %}</li>
                {% endblock %}
            </ol>
        </div>
    </div>
{% endblock %}

{% block title %}{% trans %}Show history{% endtrans %}{% endblock title %}
{% block crumbs %}{% endblock %}

{% block content %}
    <div class="row flex flex-wrap">
        {% block toolbar %}
            <div id="toolbar" class="w-full flex justify-between">
                <div class="options">
                </div>
                <div class="back">
                    <a class="no-icon btn btn-white icon-left"
                       href="{{ path("integrated_content_history_index", {'id': contentHistory.contentId }) }}"><i
                            class="iconoir iconoir-arrow-left"></i><span>{% trans %}Back{% endtrans %}</span></a>
                </div>
            </div>
        {% endblock toolbar %}
        <div class="index-wrapper-full">
            <div class="page-title">
                <h1 class="heading">{% trans %}History{% endtrans %}</h1>
            </div>
            <section class="section-white section-padding section-radius">
                <p>
                    <b>{% trans %}Date{% endtrans %}:</b> {{ contentHistory.date|format_date }}<br/>
                    <b>{% trans %}Action{% endtrans %}:</b> {{ contentHistory.action|trans }}<br/>
                    <b>{% trans %}User{% endtrans %}
                        :</b> {{ contentHistory.user.name|default('Unknown'|trans) }} {% if contentHistory.user.id is defined %}(#{{ contentHistory.user.id }}){% endif %}
                    <br/>
                    <b>{% trans %}Endpoint{% endtrans %}:</b> {{ contentHistory.request.endpoint }}<br/>
                    <b>{% trans %}IP address{% endtrans %}:</b> {{ contentHistory.request.ipAddress }}
                </p>

                {% set showOld = contentHistory.action in ['delete', 'update'] %}
                {% set showNew = contentHistory.action in ['insert', 'update'] %}

                <br/>
                <table class="table table-bordered">
                    <thead>
                    <tr>
                        <th>{% trans %}Field{% endtrans %}</th>
                        {% if showOld %}
                            <th>{% trans %}Old value{% endtrans %}</th>
                        {% endif %}
                        {% if showNew %}
                            <th>{% trans %}New value{% endtrans %}</th>
                        {% endif %}
                    </tr>
                    </thead>
                    <tbody>
                    {% for line in changeSet %}
                        {% if changeSet is not null %}
                            {% set isUpdate = contentHistory.action == 'update' %}

                            <tr>
                                <td>{{ line.name }}</td>
                                {% if showOld %}
                                    <td>
                                        {{ line.old }}
                                    </td>
                                {% endif %}
                                {% if showNew %}
                                    <td>
                                        {{ line.new }}
                                    </td>
                                {% endif %}
                            </tr>
                        {% endif %}
                    {% endfor %}
                    </tbody>
                </table>
            </section>
        </div>
    </div>
{% endblock %}
