{% extends '@IntegratedContent/base.html.twig' %}

{% block title %}{% trans %}Icon library{% endtrans %}{% endblock title %}

{% block content %}
    <div class="index-wrapper-full icon-library-page">
        {% set pageTitleContentHtml %}
            <span class="icon-library-subtitle">
                {% trans %}Search and copy the icon name to use in icon fields.{% endtrans %}
            </span>
        {% endset %}
        {{ component('integrated_admin:page_title', {
            title: 'Icon library'|trans,
            contentHtml: pageTitleContentHtml,
        }) }}

        <div class="icon-library-toolbar section-radius bg-white">
            <label class="icon-library-search-label" for="icon-library-search">
                {% trans %}Search icons{% endtrans %}
            </label>
            <input id="icon-library-search"
                   type="search"
                   class="form-control"
                   placeholder="{% trans %}Type an icon name (e.g. settings, nav-arrow, mail){% endtrans %}">
            <div class="icon-library-help">
                <span>{% trans %}Selected results:{% endtrans %}</span>
                <b id="icon-library-result-count">{{ iconFamilies|first.count|default(0) }}</b>
            </div>
            <div class="icon-library-filters">
                {% for family in iconFamilies %}
                    <button type="button"
                            class="btn btn-select{% if loop.first %} active{% endif %}"
                            aria-pressed="{% if loop.first %}true{% else %}false{% endif %}"
                            data-icon-style-filter="{{ family.key }}">
                        {{ family.label }} ({{ family.count }})
                    </button>
                {% endfor %}
            </div>
        </div>

        <div class="icon-library-message" id="icon-library-copy-message" aria-live="polite"></div>

        {% for family in iconFamilies %}
            <section class="icon-family-panel section-radius bg-white{% if not loop.first %} hidden{% endif %}"
                     data-icon-style="{{ family.key }}">
                <h2 class="icon-family-title">{{ family.label }} ({{ family.count }})</h2>

                {% for segmentLabel, segmentIcons in family.segments %}
                    <div class="icon-segment" data-icon-segment="{{ segmentLabel }}">
                        <div class="icon-segment-header">
                            <h3>{{ segmentLabel }}</h3>
                            <span class="icon-segment-count" data-segment-count>{{ segmentIcons|length }}</span>
                        </div>
                        <div class="icon-grid">
                            {% for icon in segmentIcons %}
                                <button type="button"
                                        class="icon-card"
                                        data-icon-copy="{{ icon }}"
                                        data-icon-name="{{ icon|lower }}">
                                    <span class="icon-preview">
                                        <i data-icon-class="iconoir-{{ icon }}" aria-hidden="true"></i>
                                    </span>
                                    <span class="icon-name">{{ icon }}</span>
                                    <span class="icon-class">iconoir-{{ icon }}</span>
                                </button>
                            {% endfor %}
                        </div>
                    </div>
                {% endfor %}
            </section>
        {% endfor %}
    </div>
{% endblock %}

{% block javascript %}
    {{ parent() }}
    <script>
        (function initIconLibrary() {
            const searchInput = document.getElementById('icon-library-search');
            const styleButtons = document.querySelectorAll('[data-icon-style-filter]');
            const message = document.getElementById('icon-library-copy-message');
            const resultCount = document.getElementById('icon-library-result-count');
            let selectedStyle = 'all';
            let lazyIconObserver = null;

            function showCopyMessage(text) {
                if (!message) {
                    return;
                }
                message.textContent = text;
                message.classList.add('show');
                window.setTimeout(function () {
                    message.classList.remove('show');
                }, 1200);
            }

            function copyToClipboard(text) {
                if (navigator.clipboard && typeof navigator.clipboard.writeText === 'function') {
                    navigator.clipboard.writeText(text).then(function () {
                        showCopyMessage('Copied: ' + text);
                    });
                    return;
                }

                const fallback = document.createElement('textarea');
                fallback.value = text;
                document.body.appendChild(fallback);
                fallback.select();
                document.execCommand('copy');
                fallback.remove();
                showCopyMessage('Copied: ' + text);
            }

            function hydrateIconPreview(iconElement) {
                if (!iconElement) {
                    return;
                }

                const iconClass = iconElement.getAttribute('data-icon-class');
                if (!iconClass) {
                    return;
                }

                iconElement.classList.add(iconClass);
                iconElement.removeAttribute('data-icon-class');
            }

            function initLazyIconObserver() {
                if (!('IntersectionObserver' in window)) {
                    return null;
                }

                return new IntersectionObserver(function (entries, observer) {
                    entries.forEach(function (entry) {
                        if (!entry.isIntersecting) {
                            return;
                        }

                        hydrateIconPreview(entry.target);
                        observer.unobserve(entry.target);
                    });
                }, {
                    root: null,
                    rootMargin: '240px 0px',
                    threshold: 0.01
                });
            }

            function observeLazyIcons(root) {
                const scope = root || document;
                const iconElements = scope.querySelectorAll('i[data-icon-class]');

                if (iconElements.length === 0) {
                    return;
                }

                if (!lazyIconObserver) {
                    lazyIconObserver = initLazyIconObserver();
                }

                iconElements.forEach(function (iconElement) {
                    if (!iconElement.hasAttribute('data-icon-class')) {
                        return;
                    }

                    if (!lazyIconObserver) {
                        hydrateIconPreview(iconElement);
                        return;
                    }

                    if (iconElement.dataset.lazyObserved === '1') {
                        return;
                    }

                    lazyIconObserver.observe(iconElement);
                    iconElement.dataset.lazyObserved = '1';
                });
            }

            function applyFilters() {
                const query = (searchInput && searchInput.value ? searchInput.value : '').trim().toLowerCase();
                let visibleCards = 0;

                document.querySelectorAll('.icon-family-panel').forEach(function (panel) {
                    const style = panel.getAttribute('data-icon-style');
                    const styleVisible = selectedStyle === 'all' || selectedStyle === style;
                    panel.classList.toggle('hidden', !styleVisible);

                    if (!styleVisible) {
                        return;
                    }

                    panel.querySelectorAll('.icon-segment').forEach(function (segment) {
                        let segmentVisibleCount = 0;

                        segment.querySelectorAll('.icon-card').forEach(function (card) {
                            const iconName = card.getAttribute('data-icon-name') || '';
                            const isVisible = query === '' || iconName.indexOf(query) !== -1;

                            card.classList.toggle('hidden', !isVisible);
                            if (isVisible) {
                                segmentVisibleCount += 1;
                                visibleCards += 1;
                            }
                        });

                        segment.classList.toggle('hidden', segmentVisibleCount === 0);
                        const segmentCount = segment.querySelector('[data-segment-count]');
                        if (segmentCount) {
                            segmentCount.textContent = String(segmentVisibleCount);
                        }
                    });
                });

                if (resultCount) {
                    resultCount.textContent = String(visibleCards);
                }

                observeLazyIcons(document);
            }

            styleButtons.forEach(function (button) {
                button.addEventListener('click', function () {
                    selectedStyle = button.getAttribute('data-icon-style-filter') || 'all';

                    styleButtons.forEach(function (other) {
                        other.classList.toggle('active', other === button);
                        other.setAttribute('aria-pressed', other === button ? 'true' : 'false');
                    });

                    applyFilters();
                });
            });

            document.addEventListener('click', function (event) {
                const copyButton = event.target.closest('[data-icon-copy]');
                if (!copyButton) {
                    return;
                }

                copyToClipboard(copyButton.getAttribute('data-icon-copy') || '');
            });

            if (searchInput) {
                searchInput.addEventListener('input', applyFilters);
            }

            observeLazyIcons(document);
            applyFilters();
        })();
    </script>
{% endblock %}

{% block style %}
    {{ parent() }}
    <style>
        .icon-library-page {
            padding: 1rem;
        }

        .icon-library-subtitle {
            color: #5f7285;
            display: block;
            font-size: 0.95rem;
            margin-top: 0.5rem;
        }

        .icon-library-toolbar,
        .icon-family-panel {
            border: 1px solid #dbe4ec;
            margin-bottom: 1rem;
            padding: 1rem;
        }

        .icon-library-toolbar {
            background: #fff;
            box-shadow: 0 2px 10px rgba(31, 52, 73, 0.06);
            position: sticky;
            top: 0.75rem;
            z-index: 40;
        }

        .icon-library-search-label {
            display: block;
            font-weight: 600;
            margin-bottom: 0.5rem;
        }

        .icon-library-help {
            color: #4d5f70;
            margin-top: 0.75rem;
        }

        .icon-library-filters {
            display: flex;
            flex-wrap: wrap;
            gap: 0.5rem;
            margin-top: 0.75rem;
        }

        .icon-library-filters .btn.btn-select {
            background: #fff;
            border: 1px solid #dbe4ec;
            color: #1f3449;
        }

        .icon-library-filters .btn.btn-select.active,
        .icon-library-filters .btn.btn-select[aria-pressed="true"] {
            background: #00ae93;
            border-color: #00ae93;
            color: #fff;
        }

        .icon-library-message {
            color: #0d7f64;
            font-weight: 600;
            min-height: 1.5rem;
            opacity: 0;
            transition: opacity 0.2s ease-in-out;
        }

        .icon-library-message.show {
            opacity: 1;
        }

        .icon-family-title {
            font-size: 1.15rem;
            margin-bottom: 1rem;
        }

        .icon-segment {
            margin-bottom: 1.5rem;
        }

        .icon-segment-header {
            align-items: center;
            display: flex;
            justify-content: space-between;
            margin-bottom: 0.75rem;
        }

        .icon-segment-header h3 {
            font-size: 1rem;
            margin: 0;
        }

        .icon-segment-count {
            color: #5f7285;
            font-size: 0.9rem;
        }

        .icon-grid {
            display: grid;
            gap: 0.75rem;
            grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
        }

        .icon-card {
            align-items: flex-start;
            background: #fff;
            border: 1px solid #dbe4ec;
            border-radius: 8px;
            cursor: pointer;
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
            padding: 0.75rem;
            text-align: left;
            transition: border-color 0.15s ease, box-shadow 0.15s ease;
            width: 100%;
        }

        .icon-card:hover,
        .icon-card:focus {
            border-color: #00ae93;
            box-shadow: 0 3px 12px rgba(0, 174, 147, 0.15);
            outline: none;
        }

        .icon-preview {
            color: #1f3449;
            font-size: 1.45rem;
        }

        .icon-name {
            color: #1f3449;
            font-size: 0.95rem;
            font-weight: 600;
            line-height: 1.3;
            word-break: break-word;
        }

        .icon-class {
            color: #5f7285;
            font-size: 0.82rem;
            line-height: 1.3;
            word-break: break-word;
        }

        .hidden {
            display: none !important;
        }

        @media (max-width: 768px) {
            .icon-library-toolbar {
                top: 0;
            }

            .icon-grid {
                grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
            }
        }
    </style>
{% endblock %}
