<script>
    //BULKSELECTION FUNCTIONALITY
    let bulkSelectionEnabled = false //this controls if we show an icon with each image
    let bulkSelection = [] //this keeps track which items are selected
    let latestBulkSelectionItemClicked = null //so we can handle a shift click with a from - to

    $( "#bulkselection" ).on( "click", function() {
        if (bulkSelectionEnabled) {
            disableBulkSelection()
        } else {
            enableBulkSelection()
        }
        bulkSelectionEnabled =! bulkSelectionEnabled
    });

    $( ".bulkselectionbutton" ).on( "click", function(event) {
        handleBulkItemClick(event)
    });

    function enableBulkSelection() {
        $('.bulkselectionbutton').removeClass('bulkselected')
        // $('.check .fa-check').addClass('fa-folders')
        // $('.check .fa-check').removeClass('fa-check')
        $('.check').addClass('checkunchecked')
        $('.check').removeClass('check')
    }

    function handleBulkItemClick(event) {
        let media_id = null

        if (event.shiftKey === true) {
            //SHIFT CLICK
            if (latestBulkSelectionItemClicked === null) {
                latestBulkSelectionItemClicked = 1
            }

            let step_from = latestBulkSelectionItemClicked * 1
                step_to = event.currentTarget.getAttribute('data-media_id') * 1

            for (let step = step_from; step <= step_to; step++) {
                console.log(step)
                let element = document.querySelector('.bulkselectionbutton[data-media_id="'+step+'"]')

                media_id = element.getAttribute('data-id')

                bulkSelection.push(media_id)
                $('#'+element.id).addClass('bulkselected')
            }
        } else {
            //SINGLE CLICK
            media_id = event.currentTarget.getAttribute('data-id')
            if (bulkSelection.includes(media_id)) {
                bulkSelection = bulkSelection.filter(item => item !== media_id)
                $('#' + event.currentTarget.id).removeClass('bulkselected')
            } else {
                bulkSelection.push(media_id)
                $('#' + event.currentTarget.id).addClass('bulkselected')
            }
        }

        latestBulkSelectionItemClicked = event.currentTarget.getAttribute('data-media_id')
    }

    function disableBulkSelection() {
        bulkSelection = []
        $('.checkunchecked').addClass('check')
        $('.checkunchecked').removeClass('checkunchecked')
        // $('.check .fa-folders').addClass('fa-check')
        // $('.check .fa-folders').removeClass('fa-folders')
    }

    //DRAG AND DROP FUNCTIONALITY
    (function($){
        $(function () {

            let $gallery = $("#gallery")
            let $trash = $(".media_category");

            $("li", $gallery).draggable({
                // cancel: "a.ui-icon", // clicking an icon won't initiate dragging
                containment: "document",
                helper: "clone",
                cursor: "move",
            });

            // Let the trash be droppable, accepting the gallery items
            $trash.droppable({
                accept: "#gallery > li",
                classes: {
                    "ui-droppable-active": "ui-state-highlight"
                },
                drop: function (event, ui) {
                    current_id = this.id
                    moveImage(ui.draggable, event, current_id);
                },
                over: function(event, ui) {
                    // $('.display').html( this.id );
                }
            });

            function onlyUnique(value, index, self) {
                return self.indexOf(value) === index;
            }

            function moveImage($item, event, category_id = null) {
                let media_id = $item[0].id || null

                //So here we want to send something to the server
                if (bulkSelection.length > 0) {
                    console.log("Were bulk moving!")
                    let duplicatesRemoved = bulkSelection.filter(onlyUnique);
                    console.log(duplicatesRemoved)
                } else {
                    console.log("We`re single moving:")
                    console.log(media_id)
                }

                $('.media_category').removeClass('flash')
                $('#'+category_id).addClass("flash");
            }
        });
    })(jQuery);
</script>


<script>
    //DROPDOWN MENU
    function initMenu() {

        var menus = [
            document.querySelector('div.new-contenttype'),
            document.querySelector('li.dropdown-queue'),
            document.querySelector('li.dropdown-profile'),
            document.querySelector('li.dropdown-assigned-to-me')];
        menus.forEach((menu) => {
            if (menu != null) {
                for (var i = 0; i < menu.children.length; i++) {
                    var menuClasses = menu.children[i];
                    var cList = menuClasses.classList;
                    if (cList.contains('dropdown-menu') || cList.contains('dropdown-menu-left') ||
                        cList.contains('dropdown-menu-right')) {
                        menu.addEventListener('mouseenter', showDropDownBackGround, false);
                        menu.addEventListener('mouseleave', hideDropDownBackGround, false);
                    }
                }
            }
        });
    }

    jQuery('.search-form .form-control').focus(function() {
        showDropDownBackGround();
    });

    jQuery('.search-form .form-control').blur(function() {
        hideDropDownBackGround();
    });

    function showDropDownBackGround(event) {
        var menuItemDropDownUnderlay = document.querySelector('#dropdown_overlay');
        var menuItemZindexFix = document.querySelector('#wrapper-holder');
        menuItemDropDownUnderlay.classList.remove('hide');
        menuItemZindexFix.classList.add('hide');
    }

    function hideDropDownBackGround(event) {
        var menuItemDropDownUnderlay = document.querySelector('#dropdown_overlay');
        var menuItemZindexFix = document.querySelector('#wrapper-holder');
        menuItemDropDownUnderlay.classList.add('hide');
        menuItemZindexFix.classList.remove('hide');
    }

    document.addEventListener('DOMContentLoaded', initMenu);

    function asideItemsSearch(el) {
        // Declare variables

        var input, filter, ul, li, a, i, txtValue;
        input = el;
        filter = input.value.toUpperCase();
        ul = el.parentNode.parentNode.querySelector('.aside-item-list .aside-item-list-container > ul');
        li = ul.getElementsByTagName('li');

        // Loop through all list items, and hide those who don't match the search query
        for (i = 0; i < li.length; i++) {
            a = li[i].getElementsByTagName('label')[0];
            txtValue = a.textContent || a.innerText;
            if (txtValue.toUpperCase().indexOf(filter) > -1) {
                li[i].style.display = '';
            } else {
                li[i].style.display = 'none';
            }
        }
    };

    // JS
    var sidebarfilter = document.getElementsByClassName('aside-item-header');
    var editorsettings = document.getElementsByClassName('editor-item-header');

    for (var i = 0; i < sidebarfilter.length; i++) {
        sidebarfilter[i].addEventListener('click', options, false);
    };

    for (var ii = 0; ii < editorsettings.length; ii++) {
        editorsettings[ii].addEventListener('click', options, false);
    };

    function options(event) {
        var options = this.parentNode.querySelector('.aside-item-list');
        if (!options) {
            var options = this.parentNode.querySelector('.editor-item-list');
        }
        var chevUp = this.querySelector('.fa-chevron-down');
        var chevDown = this.querySelector('.fa-chevron-up');
        // Prevent default link behavior
        event.preventDefault();

        if (!options) return;

        // Toggle the content
        toggle(options, chevUp, chevDown);
    };

    // Show an element
    var show = function(elem, chevUp, chevDown) {

        // Get the natural height of the element
        var getHeight = function() {
            elem.style.display = 'block'; // Make it visible
            var height = elem.scrollHeight + 'px'; // Get it's height
            elem.style.display = ''; //  Hide it again
            return height;
        };

        var height = getHeight(); // Get the natural height
        // elem.classList.add('show'); // Make the element visible
        elem.parentNode.classList.add('show'); // Make the element visible
        chevUp.classList.add('fa-chevron-up'); // turn the chev
        chevUp.classList.remove('fa-chevron-down'); // turn the chev
        elem.style.height = height; // Update the max-height

        // Once the transition is complete, remove the inline max-height so the content can scale responsively
        window.setTimeout(function() {elem.style.height = '';}, 350);
    };

    // Hide an element
    var hide = function(elem, chevUp, chevDown) {

        // Give the element a height to change from
        elem.style.height = elem.scrollHeight + 'px';

        // Set the height back to 0
        window.setTimeout(function() {
            elem.style.height = '0';
        }, 1);

        chevDown.classList.remove('fa-chevron-up'); // turn the chev
        chevDown.classList.add('fa-chevron-down'); // turn the chev

        // When the transition is complete, hide it
        window.setTimeout(function() {
            elem.classList.remove('show');
            elem.parentNode.classList.remove('show');
        }, 350);

    };

    // Toggle element visibility
    var toggle = function(elem, chevUp, chevDown, timing) {

        // If the element is visible, hide it
        if (elem.parentNode.classList.contains('show')) {
            hide(elem, chevUp, chevDown);
            return;
        }

        // Otherwise, show it
        show(elem, chevUp, chevDown);

    };
</script></body>
</html>
