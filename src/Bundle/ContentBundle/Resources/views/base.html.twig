<!DOCTYPE html>
<html class="no-js">
<head>
    <title>{% block title %}{% trans %}Index{% endtrans %}{% endblock title %} | Integrated</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0"/>
    <meta name="theme-color" content="#335767">
    <link rel="apple-touch-icon" sizes="180x180"
          href="{{ asset('bundles/integratedintegrated/images/favicon/apple-touch-icon.png') }}">
    <link rel="icon" type="image/png" sizes="32x32"
          href="{{ asset('bundles/integratedintegrated/images/favicon/favicon-32x32.png') }}">
    <link rel="icon" type="image/png" sizes="16x16"
          href="{{ asset('bundles/integratedintegrated/images/favicon/favicon-16x16.png') }}">
    <link rel="manifest" href="{{ asset('bundles/integratedintegrated/images/favicon/site.webmanifest') }}">
    <link rel="mask-icon" href="{{ asset('bundles/integratedintegrated/images/favicon/safari-pinned-tab.svg') }}"
          color="#335767">
    <meta name="msapplication-TileColor" content="#da532c">
    <meta name="theme-color" content="#ffffff">

{% block style %}
            <link rel="stylesheet" href="{{ asset('bundles/integratedintegrated/iconoir.css') }}">
            <link rel="stylesheet" href="{{ asset('bundles/integratedintegrated/app.css') }}">

            {{ integrated_stylesheets() }}

{% block head_javascript %}
            <script src="{{ asset('bundles/integratedintegrated/app.js') }}" defer data-turbo-track="reload"></script>

            {% block webpack_js %}{% endblock %}
        {% endblock %}

        <script>
            var loadedScripts = [],
                callbacks = [];

            function require(url, callback) {

                callbacks.push(callback);

                if (loadedScripts[url]) {
                    script = loadedScripts[url];
                } else {
                    var script = document.createElement('script');
                    script.type = 'text/javascript';

                    script.src = url;
                    document.getElementsByTagName('head')[0].appendChild(script);

                    loadedScripts[url] = script;
                }

                if (script.readyState) {  //IE
                    script.onreadystatechange = function () {
                        if (script.readyState == 'loaded' ||
                            script.readyState == 'complete') {
                            script.onreadystatechange = null;
                            callback();
                        }
                    };
                } else {  //Others
                    script.onload = function () {
                        for (var key in callbacks) {
                            callbacks[key]();
                        }
                    };
                }
            }
        </script>
    {% endblock style %}
</head>
<body style="overflow: hidden;"
      class="{{ app.request.attributes.get('_route') }} auto-hide">
<div id="app">
    {% block form_theme %}
        {% if form is defined %}
            {% form_theme form with '@IntegratedContent/form/form_div_layout.html.twig' %}
        {% endif %}
    {% endblock %}

    {% block header %}
        <nav class="navbar">
            <div class="flex items-center justify-between w-full xl:px-4 h-full">
                <button class="mobile-menu-toggle toggle-button toggle-data-target" type="button"
                        data-target="sidebar-menu">
                    <i class="iconoir-menu"></i>
                </button>
                {% include '@IntegratedContent/partials/block.logo.html.twig' %}

                <div class="flex wrap w-full">
                    {% block website_navigation_buttons %}
                        <div id="topbar-channels-fragment">
                            {{ render(controller('Integrated\\Bundle\\ContentBundle\\Controller\\ChannelController::getChannels')) }}
                        </div>
                    {% endblock website_navigation_buttons %}
                    {% block navbar_content_type %}

                        <div class="new-contenttype dropdown close-outside top-bar">
                            <a class="btn btn-green"
                               data-toggle="dropdown"><span>{% trans %}Create new {% endtrans %}</span><i
                                    class="iconoir-plus"></i></a>
                            {{ knp_menu_render('content_type', {'template': '@IntegratedContent/menu/content_type.html.twig'}) }}
                        </div>
                    {% endblock navbar_content_type %}
                    {% include '@IntegratedContent/partials/block.search.html.twig' %}
                    <div id="topbar-navdropdowns-fragment"
                         data-turbo-permanent>
                        {{ render(controller('Integrated\\Bundle\\ContentBundle\\Controller\\ContentController::navdropdowns')) }}
                    </div>
                </div>
            </div>
        </nav>
    {% endblock %}

    {% block body %}
        <div id="wrapper-holder">
            {% block dropdown_overlay %}
                <div id="dropdown_overlay" class="modal_overlay hide" style=""></div>
            {% endblock dropdown_overlay %}
            {% block sidebar_menu %}
                <div class="sidebar-menu close-outside">
                    {% include '@IntegratedContent/partials/block.navigation.html.twig' %}
                </div>
            {% endblock sidebar_menu %}
            <div class="content-wrapper">
                {% block content %}{% endblock content %}
            </div>
        </div>
    {% endblock body %}

    <div id="flash-messages" data-turbo-temporary>
        {% for label, messages in app.flashes(['alert', 'danger', 'info', 'success', 'warning', 'error']) %}
            {% for message in messages %}
                {% if label == 'alert' %}
                    {% set label = 'warning' %}
                {% elseif label == 'error' %}
                    {% set label = 'danger' %}
                {% endif %}
                <div class="alert alert-{{ label }} alert-dismissible">
                    <button type="button" class="close" data-dismiss="alert" aria-label="Close notification"><i class="iconoir-xmark"></i>
                    </button>
                    {{ message|trans }}
                </div>
            {% endfor %}
        {% endfor %}
    </div>
</div>
{% block edit_modal %}
{% endblock edit_modal %}

{% block javascript %}
{% if app.request.locale %}
<script>
    (function setMomentLocale(locale) {
        var attempts = 0;
        var maxAttempts = 20;

        function applyLocale() {
            if (window.moment && typeof window.moment.locale === 'function') {
                window.moment.locale(locale);
                return;
            }

            attempts += 1;
            if (attempts < maxAttempts) {
                window.setTimeout(applyLocale, 100);
            }
        }

        applyLocale();
    })('{{ app.request.locale }}');
</script>
{% endif %}

<script>
    (function defineIntegratedJQReady() {
        if (window.IntegratedJQReady) {
            return;
        }

        window.IntegratedJQReady = function (callback) {
            function runWhenReady() {
                if (!window.jQuery || typeof callback !== 'function') {
                    return false;
                }

                window.jQuery(function () {
                    callback(window.jQuery);
                });

                return true;
            }

            if (runWhenReady()) {
                return;
            }

            var attempts = 0;
            var maxAttempts = 100;
            var interval = window.setInterval(function () {
                attempts += 1;
                if (runWhenReady() || attempts >= maxAttempts) {
                    window.clearInterval(interval);
                }
            }, 50);
        };
    })();
</script>

<script>
    (function defineIntegratedFlashBridge() {
        if (window.IntegratedFlashBridge) {
            return;
        }

        function resolveFlashContainer() {
            return document.getElementById('flash-messages');
        }

        function isTemplateNode(node) {
            return !!node && node.nodeType === 1 && node.tagName === 'TEMPLATE';
        }

        function hasRenderableContent(fragment) {
            if (!fragment) {
                return false;
            }

            var children = fragment.childNodes || [];
            for (var i = 0; i < children.length; i += 1) {
                var child = children[i];
                if (child && (child.nodeType === 1 || (child.nodeType === 3 && String(child.textContent || '').trim() !== ''))) {
                    return true;
                }
            }

            return false;
        }

        function extractTemplate(scope) {
            if (!scope || typeof scope.querySelector !== 'function') {
                return null;
            }

            return scope.querySelector('template[data-integrated-flash-messages]');
        }

        function renderFromScope(scope) {
            var template = extractTemplate(scope);
            if (!isTemplateNode(template) || !template.content) {
                return;
            }

            var flashContainer = resolveFlashContainer();
            if (!flashContainer) {
                return;
            }

            var fragment = template.content.cloneNode(true);
            if (!hasRenderableContent(fragment)) {
                return;
            }

            flashContainer.innerHTML = '';
            flashContainer.appendChild(fragment);
            template.remove();
        }

        window.IntegratedFlashBridge = {
            renderFromScope: renderFromScope
        };

        document.addEventListener('turbo:frame-load', function (event) {
            var frame = event && event.target ? event.target : null;
            renderFromScope(frame);
        });
    })();
</script>

{{ integrated_javascripts() }}

{% block locking %}
    {% if locking is defined and locking.lock is defined and locking.locked == false %}
        {% include '@IntegratedLocking/locking.refresh.html.twig' with { 'lock': locking.lock } %}
    {% endif %}
{% endblock locking %}
{% endblock javascript %}
</body>
</html>
