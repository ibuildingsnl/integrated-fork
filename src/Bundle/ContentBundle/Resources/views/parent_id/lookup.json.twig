{% apply spaceless %}
{% set items = [] %}
{% for key, value in result %}
    {% set item = {'id': key,'title': value, 'content': null, 'image': null} %}
    {% if integrated_document(key).getParentID is defined %}
        {% set item = item|merge({'path': integrated_content_path(integrated_document(key))|join(' > ')}) %}
    {% endif %}
    {% set items = items|merge([item]) %}
{% endfor %}
{% set data = {'items': items} %}
{% endapply %}
{{ data|json_encode(constant('JSON_PRETTY_PRINT'))|raw }}
