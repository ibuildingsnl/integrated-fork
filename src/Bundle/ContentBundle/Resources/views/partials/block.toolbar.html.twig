{% if type is defined and
    ('Article' in type.class or 'News' in type.class or 'Product' in type.class or 'Company' in type.class or 'JobPosting' in type.class or 'Form' in type.class or 'Event' in type.class or 'Taxonomy' in type.class)
    and form.actions.delete is not defined %}
    {% set convert = true %}
    {% set preview = true %}
{% else %}
    {% set convert = false %}
    {% set preview = false %}
{% endif %}

<div id="toolbar" class="w-full flex justify-between">
    <div class="options">
        <div class="form-actions-extra">
            {% block content_website_links %}
                {% if content is defined and preview is same as (true) %}
                    {% set previewLinks = [] %}
                    {% for channel in content.channels %}
                        {% set domain = channel.primaryDomain|default(channel.domains|first)|default("") %}
                        {% set url = integrated_url(content, channel.id, false) %}
                        {% if domain != "" and url %}
                            {% if domain != app.request.httphost %}
                                {% set url = integrated_session_bridge_url(domain, app.session.id, url) %}
                            {% endif %}
                            {% set previewLinks = previewLinks|merge([{
                                url: url,
                                label: ('View on'|trans) ~ ' ' ~ channel.name
                            }]) %}
                        {% endif %}
                    {% endfor %}

                    {% if previewLinks|length > 0 %}
                        <div class="preview">
                            <ul class="options-no-bg">
                                <li class="dropdown close-outside" data-underlay="no">
                                    <a data-toggle="dropdown" role="button" id="drop_1"
                                       class="btn btn-dropdown">
                                        <span>{% trans %}Preview{% endtrans %}</span>
                                        <i class="iconoir-nav-arrow-down"></i>
                                    </a>
                                    <ul aria-labelledby="drop_1" role="menu" class="dropdown-menu alt" id="menu_1">
                                        {% for link in previewLinks %}
                                            <li>
                                                <a target="_blank" rel="noopener noreferrer" data-turbo="false"
                                                   href="{{ link.url }}">{{ link.label }}</a>
                                            </li>
                                        {% endfor %}
                                    </ul>
                                </li>
                            </ul>
                        </div>
                    {% endif %}
                {% endif %}
            {% endblock %}
            {% block seo_meta_button %}
                {% set hasSeoMetadata = false %}
                {% set seoMetadata = content.seoMetadata|default(form.vars.value.seoMetadata|default(null)) %}
                {% set pageDocument = page|default(form.vars.value|default(null)) %}
                {% set pageChannel = form.channel.vars.data|default(null) %}
                {% if not pageChannel and page is defined and page %}
                    {% set pageChannel = attribute(page, 'channel')|default(null) %}
                {% elseif not pageChannel and pageDocument %}
                    {% set pageChannel = attribute(pageDocument, 'primaryChannel')|default(null) %}
                {% endif %}
                {% set pagePath = pageDocument and attribute(pageDocument, 'path') is defined ? attribute(pageDocument, 'path') : form.path.vars.value|default('') %}
                {% set isPageDocument = pageDocument and attribute(pageDocument, 'slug') is not defined %}
                {% set pageOpenUrl = null %}
                {% set pageEditUrl = null %}
                {% if isPageDocument and pageChannel and pageChannel.primaryDomain is defined and pagePath and pageDocument and attribute(pageDocument, 'id') is defined and attribute(pageDocument, 'id') %}
                    {% if pageChannel.primaryDomain == app.request.httphost %}
                        {% set pageOpenUrl = pagePath %}
                        {% set pageEditUrl = pagePath ~ '?integrated_website_edit=1' %}
                    {% else %}
                        {% set pageOpenUrl = '//' ~ pageChannel.primaryDomain ~ path('integrated_website_enter_session', {'sessionId': app.session.id, 'path': pagePath}) %}
                        {% set pageEditUrl = '//' ~ pageChannel.primaryDomain ~ path('integrated_website_enter_session', {'sessionId': app.session.id, 'path': pagePath ~ '?integrated_website_edit=1'}) %}
                    {% endif %}
                {% endif %}

                {% if type is defined %}
                    {% for field in type.fields %}
                        {% if field.name == 'seoMetadata' %}
                            {% set hasSeoMetadata = true %}
                        {% endif %}
                    {% endfor %}
                {% endif %}

                {% if form.seoMetadata is defined %}
                    {% set hasSeoMetadata = true %}
                {% endif %}

                {% if hasSeoMetadata %}
                    <a href="#" class="btn btn-white seo-button readability-{{ seoMetadata.readabilityScore|default('feedback') }} seo-{{ seoMetadata.seoScore|default('feedback') }}">SEO</a>
                {% endif %}
                {% if pageOpenUrl %}
                    <a href="{{ pageOpenUrl }}"
                       class="btn btn-white"
                       target="_blank"
                       rel="noopener noreferrer"
                       data-turbo="false">{% trans %}Open page{% endtrans %}</a>
                {% endif %}
                {% if pageEditUrl %}
                    <a href="{{ pageEditUrl }}"
                       class="btn btn-white"
                       target="_blank"
                       rel="noopener noreferrer"
                       data-turbo="false">{% trans %}Edit page{% endtrans %}</a>
                {% endif %}
            {% endblock %}
        </div>
        <button class="form-actions-extra-toggle toggle-data-target" data-target="form-actions-extra"
                data-underlay="no" type="button">
            <i class="iconoir-more-horiz"></i>
        </button>
        <div class="form-actions">
            {% block form_actions %}
                {% if form.actions.reload is defined %}
                    {{ form_row(form.actions.reload) }}
                {% endif %}
                {% if form.actions.delete is defined %}
                    {{ form_row(form.actions.delete) }}
                {% endif %}
                {% if form.actions.save is defined %}
                    {{ form_row(form.actions.save) }}
                {% endif %}
                {% if form.actions.create is defined %}
                    {{ form_row(form.actions.create) }}
                {% endif %}
                {% if form.actions.copy is defined %}
                    {{ form_row(form.actions.copy) }}
                {% endif %}
                <button type="button"
                        class="toggle-settings toggle-options-sidebar btn btn-white" data-target="aside-options"><i
                        class="iconoir-settings"></i></button>
            {% endblock %}
        </div>
    </div>
    <div class="back">
        {% block form_return %}
            {% if form.actions.back is defined %}
                {{ form_row(form.actions.back) }}
            {% endif %}
            {% if form.actions.cancel is defined %}
                {{ form_row(form.actions.cancel) }}
            {% endif %}
        {% endblock %}
        {% if type is defined and form.actions.create is not defined %}
            <span class="editing-title">
                {% trans with {'%contentType%': type.name} %}Editing %contentType%{% endtrans %}
            </span>
        {% elseif type is defined and form.actions.create is defined %}
            <span class="editing-title">
                {% trans with {'%contentType%': type.name} %}Creating %contentType%{% endtrans %}
            </span>
        {% endif %}
    </div>
</div>
