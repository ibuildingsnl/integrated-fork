{% extends '@IntegratedContent/base.html.twig' %}
{% block title %}{% trans %}Delete{% endtrans %} {{ type.name|trans }}{% endblock title %}

{% block content %}
    {% block form_start %}
        {{ form_start(form) }}
    {% endblock %}
    {% set contentDeleteToolbarHtml %}
        {% block toolbar %}
            {% include '@IntegratedContent/partials/block.toolbar.html.twig' %}
        {% endblock toolbar %}
    {% endset %}
    {% set contentDeleteTitleHtml %}
        {{ component('integrated_admin:page_title', {
            title: 'Delete'|trans ~ ' ' ~ type.name,
        }) }}
    {% endset %}
    {% set contentDeleteContentHtml %}
        <p>
            {% trans with {'%name%': content.title|default(content.name|default(content.id)) } %}
                You are about to delete "%name%", click the delete button to confirm the action.
            {% endtrans %}
        </p>
        {{ form_rest(form, {'style':'horizontal'})}}
        {% if referenced %}
            {% include '@IntegratedContent/referencedAlert.html.twig' with { 'referenced': referenced } only %}
        {% endif %}
    {% endset %}
    {{ component('integrated_admin:edit_form_shell', {
        toolbarHtml: contentDeleteToolbarHtml,
        pageTitleHtml: contentDeleteTitleHtml,
        editorContentHtml: contentDeleteContentHtml,
    }) }}
    {% block form_end %}
        {{ form_end(form) }}
    {% endblock %}
{% endblock %}
