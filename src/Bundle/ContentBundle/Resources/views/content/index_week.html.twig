{% extends '@IntegratedContent/content/base.html.twig' %}
{% form_theme searchSelectionForm with '@IntegratedFormType/form/form_div_layout.html.twig' %}
{% block title %}{% trans %}Content navigator - week{% endtrans %} {{ queryParams.start|date('W') }}{% endblock title %}

{% block options_start %}
    <li>
        <a href="{{ path(route, queryParams|merge({'week': queryParams.start|date_modify('-1 week')|date('c') })) }}"
           tabindex="-1" class="btn btn-select">
            &leftarrow;
        </a>
    </li>
    <li class="dropdown close-outside" data-underlay="no">
        <a data-toggle="dropdown" role="button" class="btn btn-select space-between">
            <span>
                {{ queryParams.start|date('M d') }} t/m {{ queryParams.start|date_modify('+6 days')|date('M d') }}
                (Week {{ queryParams.start|date('W') }})
            </span>
            <i class="iconoir-nav-arrow-down"></i>
        </a>

        <ul role="menu" class="dropdown-menu">
            {% if queryParams.start > date('+4 weeks') %}
                <li role="presentation">
                    <a href="{{ path(route, queryParams|merge({'week': null})) }}"
                       tabindex="-1" role="menuitem">
                        Current week (Week {{ "now"|date('W') }})
                    </a>
                </li>
            {% endif %}
            {% for i in range(-3, -1) %}
                <li role="presentation">
                    <a href="{{ path(route, queryParams|merge({'week': queryParams.start|date_modify('+%d weeks'|format(i))|date('c') })) }}"
                       tabindex="-1" role="menuitem">
                        {{ queryParams.start|date_modify('+%d weeks'|format(i))|date('M d') }} t/m
                        {{ queryParams.start|date_modify('+%d weeks +6 days'|format(i))|date('M d') }}
                        (Week {{ queryParams.start|date_modify('+%d weeks +6 days'|format(i))|date('W') }})
                    </a>
                </li>
            {% endfor %}
            <li role="presentation" class="active">
                <a role="menuitem">
                    <b>{{ queryParams.start|date('M d') }}
                        t/m {{ queryParams.start|date_modify('+6 days')|date('M d') }}
                        (Week {{ queryParams.start|date_modify('+6 days')|date('W') }})</b>
                </a>
            </li>
            {% for i in range(1, 3) %}
                <li role="presentation">
                    <a href="{{ path(route, queryParams|merge({'week': queryParams.start|date_modify('+%d weeks'|format(i))|date('c') })) }}"
                       tabindex="-1" role="menuitem">
                        {{ queryParams.start|date_modify('+%d weeks'|format(i))|date('M d') }} t/m
                        {{ queryParams.start|date_modify('+%d weeks +6 days'|format(i))|date('M d') }}
                        (Week {{ queryParams.start|date_modify('+%d weeks +6 days'|format(i))|date('W') }})
                    </a>
                </li>
            {% endfor %}
            {% if queryParams.start < date('4 weeks ago') %}
                <li role="presentation">
                    <a href="{{ path(route, queryParams|merge({'week': null})) }}"
                       tabindex="-1" role="menuitem">
                        Current week (Week {{ "now"|date('W') }})
                    </a>
                </li>
            {% endif %}
        </ul>
    </li>
    <li>
        <a href="{{ path(route, queryParams|merge({'week': queryParams.start|date_modify('+1 week')|date('c') })) }}"
           tabindex="-1" class="btn btn-select">
            &rightarrow;
        </a>
    </li>
{% endblock options_start %}
{% block options_end %}
    <li class="dropdown close-outside calendar-filter brands" data-underlay="no">
        <a data-toggle="dropdown" role="button" class="btn btn-select space-between">
            <span>{% trans %}Brands{% endtrans %}</span>
            <i class="iconoir-nav-arrow-down"></i>
        </a>
        <ul aria-labelledby="sorting-list" role="menu" class="dropdown-menu" id="brands-menu">
        </ul>
    </li>
    <li class="dropdown close-outside calendar-filter contenttypes" data-underlay="no">
        <a data-toggle="dropdown" role="button"
           class="btn btn-select space-between"><span>{% trans %}Content Types{% endtrans %}
        </span>
            <i class="iconoir-nav-arrow-down"></i>
        </a>
        <ul aria-labelledby="sorting-list" role="menu" class="dropdown-menu" id="content-types-menu">
        </ul>
    </li>
    <li class="checkbox premium-checkbox">
        <label class="checkbox-container">
            <input type="checkbox" id="premium-checkbox" name="Premium" value="Premium">
            <span class="checkmark"></span>
            <div class="facet-wrapper">
                <span class="facet-title">{% trans %}Only show Premium content{% endtrans %}</span><span class="facet-count"></span>
            </div>
        </label>
    </li>
{% endblock options_end %}

{% block content_items %}
    {% set scroll_message = 'Scroll to see more'|trans %}
    {% set showSeoColumn = false %}
    {% for seoColumnCandidate in pager.getItems() %}
        {% set seoCandidateType = contentTypes|filter(t => t.id == seoColumnCandidate.type_name)|first %}
        {% if seoCandidateType and seoCandidateType.hasField('seoMetadata') %}
            {% set seoCandidateHasMetadata = attribute(seoColumnCandidate, 'has_seo_metadata')|default(false) %}
            {% if seoCandidateHasMetadata is iterable %}
                {% set seoCandidateHasMetadata = seoCandidateHasMetadata|first %}
            {% endif %}
            {% if seoCandidateHasMetadata in [true, 1, '1', 'true'] %}
                {% set showSeoColumn = true %}
            {% endif %}
        {% endif %}
    {% endfor %}
    <div class="calendar-view calendar-week">
        <div class="week title">
            {% for i in range(0, 6) %}
                {% set d = queryParams.start|date_modify('+%d days'|format(i)) %}
                <div class="day title {% if d|date('d/m/Y') == date('now')|date('d/m/Y') %}today{% endif %}"
                     data-date="{{ d|date('Y/m/d') }}">
                    <span>{{ d|date('D d') }}</span>
                </div>
            {% endfor %}
        </div>
        <div class="week columns">
            {% set dayN = 0 %}
            <div class="day column" draggable="true" data-date="{{ queryParams.start|date('Y/m/d') }}">
                {% set prev_day = 0 %}
                {% for content in pager %}
                {% set day = queryParams.start.diff(date(content.pub_time)).days %}

                {% if day != prev_day %}
                {% for i in range(prev_day, day - 1) %}
                {% set dayN = dayN + 1 %}
                <div class="message">{{ scroll_message }}</div>
            </div>
            <div class="day column" draggable="true"
                 data-date="{{ queryParams.start|date_modify('+%d days'|format(dayN))|date('Y/m/d') }}">
                {% endfor %}
                {% set prev_day = day %}
                {% endif %}

                {% if content.type_class|split('\\')|last in ["Image", "Video", "File"] %}
                    {% set editLink = path('integrated_content_media_index', {ids: content.type_id}) %}
                {% else %}
                    {% set editLink = path('integrated_content_content_edit', {id: content.type_id}) %}
                {% endif %}
                {% set type = contentTypes|filter(t => t.id == content.type_name)|first %}
                {% set brandNames = content.facet_brands|default([])|filter(name => name is not empty and name != 'None') %}
                {% set fallbackWebsiteChannelIds = content.website_channel_ids_string|default([])|filter(id => id is not empty and id != 'None') %}
                {% set fallbackWebsiteChannelNames = content.website_channel_names_string|default([]) %}
                {% set fallbackWebsiteChannelFavicons = content.website_channel_favicon_paths_string|default([]) %}
                {% set visibleBrandNames = brandNames|slice(0, 3) %}
                {% set visibleFallbackWebsiteChannelIds = fallbackWebsiteChannelIds|slice(0, 3) %}
                {% set channelCount = brandNames is not empty ? brandNames|length : fallbackWebsiteChannelIds|length %}
                {% set displayChannelNames = brandNames is not empty ? brandNames : fallbackWebsiteChannelNames %}

                {% if content.pub_active and ('now'|date('U') > content.pub_time |date('U')) %}
                    {% set calendarState = 'published' %}
                {% elseif content.pub_active %}
                    {% set calendarState = 'planned' %}
                {% else %}
                    {% set calendarState = 'concept' %}
                {% endif %}

                <a class="calendar-item {{ calendarState }}" href="{{ editLink }}" target="_blank" data-turbo-frame="_top" data-turbo-prefetch="false"
                   data-id="{{ content.type_id }}" data-type="{{ type }}" data-brands="{{ displayChannelNames|join(', ')|default('') }}"
                   data-premium="{% if content.premium|default(false) %}true{% else %}false{% endif %}"
                   data-title="Edit {{ type }}" data-time="{{ date(content.pub_time)|date('Hi') }}">
                    <div class="calendar-wrap" style="--color: {{ type.options.color|default('gray') }}">
                        <div class="calendar-item-heading">
                            <div class="heading-left">
                                <i class="icon iconoir-{{ type.options.icon|default('empty-page') }}" title="{{ type }}"></i>
                                <span class="publish-time">{{ date(content.pub_time)|date('H:i') }}</span>

                                <div class="favicon-wrapper {% if channelCount > 3 %}hover-popout{% endif %}">
                                    {% if channelCount > 3 %}
                                        <span class="channel-popout" style="--color:#01ae93">3+</span>
                                    {% endif %}
                                    <div class="channel-favicons {% if channelCount > 3 %}popout{% endif %}">
                                        {% if brandNames is not empty %}
                                            {% for brandName in visibleBrandNames %}
                                                <div class="channel-favicon font-bold"
                                                     title="{{ brandName }}"
                                                     style="background-color: {{ type.options.color|default('gray') }}">
                                                    {{ brandName|first|upper }}
                                                </div>
                                            {% endfor %}
                                        {% elseif fallbackWebsiteChannelIds is not empty %}
                                            {% for channelId in visibleFallbackWebsiteChannelIds %}
                                                {% set channelName = fallbackWebsiteChannelNames[loop.index0]|default(channelId) %}
                                                {% set faviconPath = fallbackWebsiteChannelFavicons[loop.index0]|default('') %}
                                                {% if faviconPath is not empty %}
                                                    <div class="channel-favicon"
                                                         style="background-image:url('{{ image(faviconPath).cropResize(36, 36) }}')"
                                                         title="{{ channelName }}">
                                                    </div>
                                                {% else %}
                                                    <div class="channel-favicon font-bold"
                                                         title="{{ channelName }}"
                                                         style="background-color: {{ type.options.color|default('gray') }}">
                                                        {{ channelName|first|upper }}
                                                    </div>
                                                {% endif %}
                                            {% endfor %}
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                            {% if showSeoColumn %}
                                <div class="heading-right">
                                    {% set hasSeoMetadata = attribute(content, 'has_seo_metadata')|default(false) %}
                                    {% if hasSeoMetadata is iterable %}
                                        {% set hasSeoMetadata = hasSeoMetadata|first %}
                                    {% endif %}
                                    {% if type and type.hasField('seoMetadata') and hasSeoMetadata in [true, 1, '1', 'true'] %}
                                        {% set seoScore = attribute(content, 'seo_score')|default('feedback') %}
                                        {% set readabilityScore = attribute(content, 'readability_score')|default('feedback') %}
                                        {% if seoScore is iterable %}
                                            {% set seoScore = seoScore|first %}
                                        {% endif %}
                                        {% if readabilityScore is iterable %}
                                            {% set readabilityScore = readabilityScore|first %}
                                        {% endif %}
                                        <span class="btn btn-white no-icon seo-button readability-{{ readabilityScore }} seo-{{ seoScore }}">SEO</span>
                                    {% endif %}
                                </div>
                            {% endif %}
                        </div>
                        <div class="calendar-item-content">
                            {{ content.title|default('untitled') }}
                        </div>
                    </div>
                </a>
                {% endfor %}
                {% if prev_day < 6 %}
                {% for i in range(prev_day + 1, 6) %}
                {% set dayN = dayN + 1 %}
                <div class="message">{{ scroll_message }}</div>
            </div>
            <div class="day column" draggable="true"
                 data-date="{{ queryParams.start|date_modify('+%d days'|format(dayN))|date('Y/m/d') }}">
                {% endfor %}
                {% endif %}
                <div class="message">{{ scroll_message }}</div>
            </div>
        </div>
    </div>
{% endblock content_items %}
