<turbo-stream action="append" target="flash-messages">
    <template>
        {% for label, messages in app.flashes(['alert', 'danger', 'info', 'success', 'warning', 'error']) %}
            {% for message in messages %}
                {% if label == 'alert' %}
                    {% set label = 'warning' %}
                {% elseif label == 'error' %}
                    {% set label = 'danger' %}
                {% endif %}
                {{ component('integrated_admin:alert_box', {
                    variant: label,
                    dismissible: true,
                    bodyHtml: message|trans,
                }) }}
            {% endfor %}
        {% endfor %}
    </template>
</turbo-stream>
