<turbo-stream action="replace" target="flash-messages">
    <template>
        {% for label, messages in app.flashes(['alert', 'danger', 'info', 'success', 'warning', 'error']) %}
            {% for message in messages %}
                {% if label == 'alert' %}
                    {% set label = 'warning' %}
                {% elseif label == 'error' %}
                    {% set label = 'danger' %}
                {% endif %}
                <div class="alert alert-{{ label }} alert-dismissible">
                    <button type="button" class="close" data-dismiss="alert"><i class="iconoir-xmark"></i>
                    </button>
                    {{ message|trans }}
                </div>
            {% endfor %}
        {% endfor %}
    </template>
</turbo-stream>
