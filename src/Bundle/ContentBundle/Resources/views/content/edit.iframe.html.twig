{% extends '@IntegratedContent/base.html.twig' %}

{% block header %}
{% endblock header %}
{% block sidebar_menu %}
{% endblock sidebar_menu %}
{% block body %}
    {{ include('@IntegratedContent/content/partial/edit_frame.html.twig') }}
{% endblock %}

{% block edit_modal %}
{% endblock %}

{% block javascript %}
{{ parent() }}
{% if content is defined %}
    <script>
        usedByUrl = '{{ path('integrated_content_content_used_by', {'id': content.id, '_format': 'json'}) }}';
        usedByBlockUrl = '{{ path('integrated_block_block_used_by', {'id': content.id, '_format': 'json'}) }}';
    </script>
{% endif %}
{% if editable %}
    <script>
        var formInvalid = {{ form.vars.valid ? '0' : '1' }};
    </script>
{% endif %}

{{ include('@IntegratedContent/content/handlebars/templates.html.twig') }}
{% endblock javascript %}

{% block webpack_js %}
    <script src="{{ asset('bundles/integratedintegrated/edit.js') }}"></script>

    <script>
        function initMediaEditPanel() {
            const goToEditor = document.querySelector('#go_to_editor');
            if (goToEditor) {
                goToEditor.addEventListener('click', (event) => {
                    dispatchEvent(event);
                });
            }

            const form = document.querySelector('.content-form');
            const submitButton = document.getElementById('integrated_content_actions_save');
            if (form && submitButton) {
                function showSubmitButton() {
                    submitButton.style.display = 'block';
                    form.removeEventListener('change', showSubmitButton);
                    form.removeEventListener('input', showSubmitButton);
                }

                form.addEventListener('change', showSubmitButton);
                form.addEventListener('input', showSubmitButton);
            }

            $(document).ready(function() {
                $('.relation-items')
                    .off('select2:open.media-edit')
                    .on('select2:open.media-edit', function() {
                        $('.relation-items')
                            .off('change.media-edit')
                            .on('change.media-edit', function() {
                                $('#integrated_content_actions_save').show();
                            });
                    });
            });
        }

        // This loads the edit image screen. This can be a full redirect, or a modal.
        function dispatchEvent() {
            let event = new CustomEvent('editImageClick');
            const parentDocument = window.parent && window.parent !== window ? window.parent.document : document;
            parentDocument.dispatchEvent(event);
        }

        document.addEventListener('DOMContentLoaded', initMediaEditPanel);
        document.addEventListener('turbo:load', initMediaEditPanel);
        document.addEventListener('turbo:frame-load', function(event) {
            if (event.target && event.target.id === 'media-edit-panel') {
                initMediaEditPanel();
            }
        });

    </script>
{% endblock %}
