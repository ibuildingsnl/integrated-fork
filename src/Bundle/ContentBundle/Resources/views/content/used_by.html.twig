{% extends '@IntegratedContent/base.html.twig' %}
{% block content %}
    <div class="content_columns_holder">
        <div class="w-full sm:w-2/3 content_column">
            <div class="content_column_inner">
                {% for content in pagination %}
                    <div class="item_row">
                        <h3 class="title">
                            <a target="_blank" href="{{ path('integrated_content_content_edit', {id: content.id}) }}">
                                {{ content }}
                            </a>
                        </h3>
                    </div>
                {% else %}
                    <div class="item_row">
                        {{ component('integrated_admin:empty_state_message', {
                            message: 'No items found'|trans,
                            variant: 'danger',
                        }) }}
                    </div>
                {% endfor %}
                <div class="item_row">
                    <div class="pull-right">
                        {{ component('integrated_admin:pagination_footer', {
                            pagination: pagination,
                        }) }}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
