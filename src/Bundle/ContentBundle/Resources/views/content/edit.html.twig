{% extends '@IntegratedContent/base.html.twig' %}
{% block title %}
    {% if content.title is defined and content.title is not null %}
        {% trans %}Edit{% endtrans %} {{ content.title }}
    {% else %}
        {% trans %}Edit{% endtrans %} {{ type.name|trans }}
    {% endif %}
{% endblock title %}

{% block content %}
    <div id="content-edit-page">
        {% block filters %}
            <div class="filters_row"></div>
        {% endblock %}

        <div class="flex flex-wrap content-edit-form">
            {% set isContentLocked = locking is defined and locking.locked and not (locking.pending|default(false)) %}
            {% block form_start %}
                {{ form_start(form, { attr: { 'data-turbo-stream': 'true' } }) }}
            {% endblock %}
            {% block toolbar %}
                {% include '@IntegratedContent/partials/block.toolbar.html.twig' %}
            {% endblock toolbar %}
            {% if isContentLocked %}
                <div class="content-lock-overlay" data-content-lock-overlay>
                    <div class="content-lock-overlay__message">
                        {% trans %}This item is currently locked and cannot be edited until the lock is released.{% endtrans %}
                    </div>
                </div>
            {% endif %}
            <div class="aside-options">
                <aside>
                    <div class="aside-holder">
                        {% block sidebar %}
                            <div class="aside-header">
                                <button class="toggle-filters toggle-options-sidebar" data-target="aside-options"
                                        type="button">
                                    <i class="iconoir-xmark"></i></button>
                                <span>{% trans %}Options{% endtrans %}</span>
                            </div>
                            <div class="aside-item-wrapper show">
                                <div class="aside-item-header">
                                    <h3 class="aside-item-title">
                                        <i class="iconoir-info-circle"></i>
                                        <span class="aside-item-icon">{% trans %}Status{% endtrans %}</span>
                                    </h3>
                                    <i class="iconoir-nav-arrow-up"></i>
                                </div>
                                <div class="aside-item-list">
                                    <div class="aside-item-list-container">
                                        <div class="status-info">
                                            {% if form.publishTime is defined %}
                                                {{ form_row(form.publishTime, {style: 'inline'}) }}
                                            {% endif %}
                                        </div>
                                        {{ include('@IntegratedContent/content/partial/workflow_info.html.twig') }}
                                        {{ include('@IntegratedContent/content/partial/status_options.html.twig') }}
                                        <div class="mt-2">
                                            {% if form.disabled is defined %}
                                                {{ form_row(form.disabled) }}
                                            {% endif %}
                                            {% if form.orderable is defined %}
                                                {{ form_row(form.orderable) }}
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>
                            </div>

                            {{ include('@IntegratedContent/content/partial/publications.html.twig') }}


                            {% block content_options %}
                                {% set optionFields = form|filter(row => row.vars.attr.location|default == constant('Integrated\\Common\\Form\\Mapping\\Attributes\\Field::LOCATION_OPTIONS')) %}
                                {% set remainingOptions = optionFields|filter(row => row.vars.name not in ['premium', 'featured', 'featured_expiration']) %}
                                {% set options = remainingOptions|length > 0 %}
                                {% if form.children.customFields is defined %}
                                    {% for field in form.children.customFields|filter(f => f.vars.attr.location|default == constant('Integrated\\Common\\Form\\Mapping\\Attributes\\Field::LOCATION_OPTIONS')) %}
                                        {% set options = true %}
                                    {% endfor %}
                                {% endif %}

                                {% if form.premium is defined %}
                                    <div class="aside-item-wrapper">
                                        <div class="aside-item-header">
                                            <h3 class="aside-item-title">
                                                <i class="iconoir-half-cookie"></i>
                                                <span class="aside-item-icon">{% trans %}Premium{% endtrans %}</span>
                                            </h3>
                                            <i class="iconoir-nav-arrow-up"></i>
                                        </div>
                                        <div class="aside-item-list">
                                            <div class="aside-item-list-container">
                                                {{ form_row(form.premium) }}
                                            </div>
                                        </div>
                                    </div>
                                {% endif %}

                                {% if form.featured is defined %}
                                    <div class="aside-item-wrapper">
                                        <div class="aside-item-header">
                                            <h3 class="aside-item-title">
                                                <i class="iconoir-star"></i>
                                                <span class="aside-item-icon">{% trans %}Featured{% endtrans %}</span>
                                            </h3>
                                            <i class="iconoir-nav-arrow-up"></i>
                                        </div>
                                        <div class="aside-item-list">
                                            <div class="aside-item-list-container">
                                                {{ form_row(form.featured) }}
                                                {% if form.featured_expiration is defined %}
                                                    <div data-featured-expiration-container style="{% if not form.featured.vars.data|default(false) %}display: none;{% endif %}">
                                                        <div class="form-group w-full flex flex-wrap{% if form.featured_expiration.vars.errors|length > 0 %} has-error{% endif %}">
                                                            <label class="control-label w-full" for="{{ form.featured_expiration.vars.id }}">
                                                                {% trans %}Featured expires in x days{% endtrans %}
                                                            </label>
                                                            <div class="w-full widget">
                                                                {{ form_widget(form.featured_expiration, {
                                                                    attr: form.featured_expiration.vars.attr|merge({
                                                                        placeholder: 'Featured expires in x days'|trans
                                                                    })
                                                                }) }}
                                                                {{ form_errors(form.featured_expiration) }}
                                                            </div>
                                                        </div>
                                                    </div>
                                                {% endif %}
                                            </div>
                                        </div>
                                    </div>
                                {% endif %}

                                {% if options == true %}
                                    <div class="aside-item-wrapper">
                                        <div class="aside-item-header">
                                            <h3 class="aside-item-title">
                                                <i class="iconoir-settings"></i>
                                                <span
                                                    class="aside-item-icon">{% trans %}Content Options{% endtrans %}</span>
                                            </h3>
                                            <i class="iconoir-nav-arrow-up"></i>
                                        </div>
                                        <div class="aside-item-list">
                                            <div class="aside-item-list-container">
                                                {% for child in remainingOptions %}
                                                    {{ form_row(child) }}
                                                {% endfor %}
                                                {% block custom_sidebar_fields %}
                                                    {% if form.children.customFields is defined %}
                                                        {% for field in form.children.customFields|filter(f => f.vars.attr.location|default == constant('Integrated\\Common\\Form\\Mapping\\Attributes\\Field::LOCATION_OPTIONS')) %}
                                                            {{ form_row(field) }}
                                                        {% endfor %}
                                                    {% endif %}
                                                {% endblock %}
                                            </div>
                                        </div>
                                    </div>
                                {% endif %}
                            {% endblock %}


                            <div class="aside-item-wrapper" id="used-by"></div>

                            {% block content_history %}
                                <div id="content-history-section">
                                    {% if showContentHistory %}
                                        {{ render(controller('Integrated\\Bundle\\ContentHistoryBundle\\Controller\\ContentHistoryController::history', { 'content': content })) }}
                                    {% endif %}
                                </div>
                            {% endblock %}

                            {% block content_meta %}
                                {% for child in form|filter(row => row.vars.attr.location|default == constant('Integrated\\Common\\Form\\Mapping\\Attributes\\Field::LOCATION_SIDEBAR')) %}
                                    {{ form_row(child) }}
                                {% endfor %}
                            {% endblock %}

                            {% block content_relations %}
                                {% if form.offsetGet('relations').count() %}
                                    <input type="hidden" id="default_references" value="{{ references }}">
                                    {% for relation in form.relations %}
                                        {% if relation.vars.attr['data-location'] == 'sidebar' %}

                                            <div class="aside-item-wrapper relations">
                                                <div class="aside-item-header">
                                                    <h3 class="aside-item-title">
                                                        <i class="iconoir-{{ relation.vars.attr['data-icon'] }}"></i>
                                                        <label
                                                            class="aside-item-icon"
                                                            for="{{ relation.vars.name }}">{{ relation.vars.attr['data-title'] }}</label>
                                                    </h3>
                                                    <i class="iconoir-nav-arrow-up"></i>
                                                </div>
                                                <div class="aside-item-list">

                                                    <div class="aside-item-list-container relation">
                                                        {% if relation.vars.attr['data-relationtype'] == 'embedded' %}
                                                            {% include '@IntegratedContent/media/partial/select_component.html.twig' with {
                                                                relation: relation,
                                                                form_relations: formRelations|default(null),
                                                            } %}

                                                        {% elseif relation.vars.attr['data-relationtype'] == 'taxonomy_category' %}
                                                            {% include '@IntegratedContent/content/partial/category_selection_component.html.twig' %}

                                                        {% else %}
                                                            <select
                                                                multiple
                                                                id="{{ relation.vars.name }}"
                                                                data-multiple="{{ relation.vars.attr['data-multiple'] }}"
                                                                data-types="{{ relation.vars.attr['data-types'] }}"
                                                                data-url="{{ path('integrated_content_content_index', {'_format': 'json'}) }}"
                                                                data-url-new="{{ path('integrated_content_content_new', {'type': '__type__', 'relation': '__relation__', '_format': 'iframe.html'}) }}"
                                                                class="relation-items form-control"
                                                                style="display: none; width: 89%">
                                                            </select>
                                                            <span class="input-group-addon" data-add="1"></span>
                                                        {% endif %}
                                                    </div>
                                                </div>
                                            </div>
                                        {% endif %}
                                    {% endfor %}
                                {% endif %}
                            {% endblock %}
                        {% endblock %}
                    </div>
                </aside>
            </div>
            <div class="editor-wrapper">
                <div class="editor-overlay"></div>
                <section class="editor">
                    {% block content_form %}
                        {% for child in form|filter(row => row.vars.attr.location|default == constant('Integrated\\Common\\Form\\Mapping\\Attributes\\Field::LOCATION_EDITOR')) %}
                            {{ form_row(child) }}
                        {% endfor %}

                        {% if form.children.customFields is defined %}
                            {% for field in form.children.customFields %}
                                {% if not field.rendered %}
                                    {{ form_row(field, {'style':'editor', 'state':'show'}) }}
                                {% endif %}
                            {% endfor %}
                        {% endif %}

                        {{ form_rest(form, {'style':'editor', 'state':'show'}) }}
                    {% endblock %}

                    {% block content_relations_editor %}
                        {% if form.offsetGet('relations').count() %}
                            <input type="hidden" id="default_references" value="{{ references }}">
                            {% for relation in form.relations %}
                                {% if relation.vars.attr['data-location'] != 'sidebar' %}
                                    <div class="editor-item-wrapper relations">
                                        <div class="editor-item-header">
                                            <h3 class="editor-item-title">
                                                <label
                                                    class="editor-item-icon"
                                                    for="{{ relation.vars.name }}">{{ relation.vars.attr['data-title'] }}</label>
                                            </h3>
                                            <i class="iconoir-nav-arrow-up"></i>
                                        </div>
                                        <div class="editor-item-list">
                                            <div class="editor-item-list-container relation">


                                                {% if relation.vars.attr['data-relationtype'] == 'embedded' %}
                                                    {% include '@IntegratedContent/media/partial/select_component.html.twig' with {
                                                        relation: relation,
                                                        form_relations: formRelations|default(null),
                                                    } %}
                                                {% elseif relation.vars.attr['data-relationtype'] == 'taxonomy_category' %}
                                                    {% include '@IntegratedContent/content/partial/category_selection_component.html.twig' %}
                                                {% else %}
                                                    <select
                                                        multiple
                                                        id="{{ relation.vars.name }}"
                                                        data-multiple="{{ relation.vars.attr['data-multiple'] }}"
                                                        data-types="{{ relation.vars.attr['data-types'] }}"
                                                        data-url="{{ path('integrated_content_content_index', {'_format': 'json'}) }}"
                                                        data-url-new="{{ path('integrated_content_content_new', {'type': '__type__', 'relation': '__relation__', '_format': 'iframe.html'}) }}"
                                                        class="relation-items form-control"
                                                        style="display: none; width: 89%">
                                                    </select>
                                                    <span class="input-group-addon" data-add="1"></span>
                                                {% endif %}
                                            </div>
                                        </div>
                                    </div>
                                {% endif %}
                            {% endfor %}

                        {% endif %}
                    {% endblock content_relations_editor %}
                </section>
            </div>


            {% block form_end %}
                {{ form_end(form) }}
            {% endblock %}
        </div>

        {% autoescape 'js' %}
            {% verbatim %}
                <script id="add-template" type="text/xhandlebars-template">
                    {{#if relations}}
                    {{#equals relations.length 1}}
                        <button data-title="Add {{relations.0.name}}" class="add-relation" data-href="{{relations.0.href}}" data-modal="add-modal">
                            Add {{relations.0.name}}
                            <span class="sr-only">{% endverbatim %}{% trans %}Add New{% endtrans %}{% verbatim %}:</span>
                        </button>
                    {{else}}
                    <div class="add-relation">
                        <button type="button" class=" inline-block w-0 h-0 ml-1 align border-b-0 border-t-1 border-r-1 border-l-1 font-size-13" data-toggle="dropdown" aria-expanded="false">
                            <i class="iconoir-plus"></i>
                            <span class="sr-only">{% endverbatim %}{% trans %}Add New{% endtrans %}{% verbatim %}:</span>
                        </button>
                        <ul class=" dropdown-menu" role="menu">
                            {{#each relations}}
                            <li>
                                <a class="cursor-pointer" data-title="Add {{this.name}}" data-href="{{this.href}}" target="_blank" data-modal="add-modal">
                                    {{this.name}}
                                </a>
                            </li>
                            {{/each}}
                        </ul>
                     </div>
                    {{/equals}}
                    {{/if}}
                    <div class="modal add-modal" id="relation-add-modal" tabindex="-1" role="dialog" aria-labelledby="myLargeModalLabel" aria-hidden="true">
                        <div class="modal-dialog modal-lg">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <button type="button" class="close" data-dismiss="modal"><span aria-hidden="true"><i class="iconoir-xmark"></i></span><span class="sr-only">{% endverbatim %}{% trans %}Close{% endtrans %}{% verbatim %}</span></button>
                                    <h4 class="modal-title">{% endverbatim %}{% trans %}Add{% endtrans %}{% verbatim %}</h4>
                                </div>
                                <iframe width="100%" height="400">{% endverbatim %}{% trans %}Loading{% endtrans %}{% verbatim %}</iframe>
                            </div>
                        </div>
                    </div>
                </script>
            {% endverbatim %}
        {% endautoescape %}
    </div>

{% endblock %}

{% block edit_modal %}
    <div class="modal fade" id="content-edit-modal">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h4 class="modal-title">{% trans %}Unsaved changes{% endtrans %}</h4>
                </div>
                <div class="modal-body">
                    <p>{% trans %}You have unsaved changes. When you leave this page your changes will be lost.{% endtrans %}</p>
                    <p>{% trans %}Are you sure you want to leave this page?{% endtrans %}</p>
                </div>
                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-dark-green live-page">{% trans %}Leave this page{% endtrans %}</button>
                    <button type="button" class="btn btn-white"
                            data-dismiss="modal">{% trans %}Stay on page{% endtrans %}</button>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
{% block webpack_js %}
    <script src="{{ asset('bundles/integratedintegrated/edit.js') }}" defer data-turbo-track="reload"></script>
{% endblock %}

{% block javascript %}
{{ parent() }}

{% if content is defined %}
<script>
    (function initEditLockOnLoad() {
        var LOCK_REFRESH_URL = "{{ path('integrated_locking_api_refresh')|e('js') }}";
        var LOCK_POLLING_KEY = '__integratedEditLockPolling';
        var LOCK_CSRF_TOKEN = "{{ (content is defined ? csrf_token('integrated_content_lock_' ~ content.id) : '')|e('js') }}";
        var LOCKED_ITEM_MESSAGE = "{{ 'This item is currently locked and cannot be edited until the lock is released.'|trans|e('js') }}";
        var LOCK_ACQUIRE_FAILED_MESSAGE = "{{ 'The lock could not be acquired, please reload and try again.'|trans|e('js') }}";
        var lockPollingStore = window[LOCK_POLLING_KEY] || (window[LOCK_POLLING_KEY] = {});

        function renderLockMessage(message) {
            if (!message) {
                return;
            }

            var flashContainer = document.getElementById('flash-messages');
            if (!flashContainer) {
                return;
            }

            var normalizedMessage = String(message).trim();
            var alerts = flashContainer.querySelectorAll('.alert');
            for (var i = 0; i < alerts.length; i++) {
                if (alerts[i].textContent && alerts[i].textContent.trim() === normalizedMessage) {
                    return;
                }
            }

            if (document.querySelector('[data-edit-lock-init-message]')) {
                return;
            }

            var alertNode = document.createElement('div');
            alertNode.className = 'alert alert-danger';
            alertNode.setAttribute('data-edit-lock-init-message', '1');
            alertNode.textContent = message;

            flashContainer.appendChild(alertNode);
        }

        function postLockRequest(url, body, keepalive) {
            return fetch(url, {
                method: 'POST',
                credentials: 'same-origin',
                keepalive: !!keepalive,
                headers: {
                    'X-Requested-With': 'XMLHttpRequest',
                    'Accept': 'application/json',
                    'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
                },
                body: body,
            });
        }

        function setSaveButtonDisabled(disabled) {
            var saveButton = document.getElementById('integrated_content_actions_save');
            if (!saveButton) {
                return;
            }

            saveButton.disabled = !!disabled;
            saveButton.classList.toggle('disabled', !!disabled);
        }

        function setLockOverlay(form, message) {
            var wrapper = form.closest('.content-edit-form');
            if (!wrapper) {
                wrapper = form;
            }

            var overlay = wrapper.querySelector('[data-content-lock-overlay]');
            if (!overlay) {
                overlay = document.createElement('div');
                overlay.className = 'content-lock-overlay';
                overlay.setAttribute('data-content-lock-overlay', '1');

                var overlayMessage = document.createElement('div');
                overlayMessage.className = 'content-lock-overlay__message';
                overlay.appendChild(overlayMessage);

                wrapper.appendChild(overlay);
            }

            var messageNode = overlay.querySelector('.content-lock-overlay__message');
            if (messageNode) {
                messageNode.textContent = message || LOCKED_ITEM_MESSAGE;
            }
        }

        function clearLockOverlay(form) {
            var wrapper = form.closest('.content-edit-form');
            if (!wrapper) {
                wrapper = form;
            }

            var overlay = wrapper.querySelector('[data-content-lock-overlay]');
            if (overlay) {
                overlay.remove();
            }
        }

        function setFormActionLock(form, lockId) {
            var action = form.getAttribute('action');
            if (!action) {
                return;
            }

            var actionUrl = new URL(action, window.location.origin);
            actionUrl.searchParams.set('lock', String(lockId));
            form.setAttribute('action', actionUrl.pathname + actionUrl.search + actionUrl.hash);
        }

        function setDeleteActionLock(lockId) {
            var deleteLinks = document.querySelectorAll('a.delete[href]');
            for (var i = 0; i < deleteLinks.length; i++) {
                var href = deleteLinks[i].getAttribute('href');
                if (!href) {
                    continue;
                }

                var hrefUrl = new URL(href, window.location.origin);
                hrefUrl.searchParams.set('lock', String(lockId));
                deleteLinks[i].setAttribute('href', hrefUrl.pathname + hrefUrl.search + hrefUrl.hash);
            }
        }

        function replaceUrlLock(lockId) {
            var locationUrl = new URL(window.location.href);
            if (locationUrl.searchParams.get('lock') === String(lockId)) {
                return;
            }

            locationUrl.searchParams.set('lock', String(lockId));
            window.history.replaceState({}, '', locationUrl.toString());
        }

        function startLockPolling(lockId) {
            if (!lockId || lockPollingStore[lockId]) {
                return;
            }

            if (window.__integratedLockPolling && window.__integratedLockPolling[lockId]) {
                return;
            }

            var state = {
                stopped: false,
                timer: null,
            };
            lockPollingStore[lockId] = state;

            function toBody() {
                var params = new URLSearchParams();
                params.set('lock', String(lockId));

                return params.toString();
            }

            function stop() {
                if (state.stopped) {
                    return;
                }

                state.stopped = true;

                if (state.timer) {
                    window.clearTimeout(state.timer);
                    state.timer = null;
                }

                delete lockPollingStore[lockId];

                document.removeEventListener('turbo:before-cache', onBeforeCache);
                window.removeEventListener('pagehide', onPageHide);
                window.removeEventListener('beforeunload', onBeforeUnload);
            }

            function schedule() {
                if (state.stopped) {
                    return;
                }

                state.timer = window.setTimeout(refresh, 5000);
            }

            function refresh() {
                if (state.stopped) {
                    return;
                }

                postLockRequest(LOCK_REFRESH_URL, toBody(), false)
                    .then(function (response) {
                        if (response.status === 200) {
                            schedule();
                            return;
                        }

                        stop();
                    })
                    .catch(function () {
                        stop();
                    });
            }

            function onBeforeCache() {
                stop();
            }

            function onPageHide() {
                stop();
            }

            function onBeforeUnload() {
                stop();
            }

            document.addEventListener('turbo:before-cache', onBeforeCache);
            window.addEventListener('pagehide', onPageHide);
            window.addEventListener('beforeunload', onBeforeUnload);

            refresh();
        }

        function applyAcquiredLock(form, lockId, lockStoreKey) {
            if (lockStoreKey) {
                try {
                    window.sessionStorage.setItem(lockStoreKey, String(lockId));
                } catch (e) {
                }
            }

            form.setAttribute('data-lock-pending', '0');
            form.setAttribute('data-lock-id', String(lockId));
            form.setAttribute('data-content-locked', '0');
            clearLockOverlay(form);
            setFormActionLock(form, lockId);
            setDeleteActionLock(lockId);
            replaceUrlLock(lockId);
            setSaveButtonDisabled(false);
            startLockPolling(lockId);
        }

        function initLockOnLoad() {
            if (document.documentElement.hasAttribute('data-turbo-preview')) {
                return;
            }

            var form = document.querySelector('form.content-form[data-lock-init-url]');
            if (!form) {
                return;
            }

            if (form.getAttribute('data-lock-pending') !== '1') {
                var existingLockId = form.getAttribute('data-lock-id') || '';
                if (!existingLockId) {
                    return;
                }

                var urlLockId = '';
                try {
                    var currentUrl = new URL(window.location.href);
                    urlLockId = currentUrl.searchParams.get('lock') || '';
                } catch (e) {
                    urlLockId = '';
                }

                if (
                    form.getAttribute('data-content-locked') !== '1'
                    && urlLockId === String(existingLockId)
                ) {
                    startLockPolling(existingLockId);
                    setFormActionLock(form, existingLockId);
                    setDeleteActionLock(existingLockId);
                    return;
                }

                if (form.getAttribute('data-content-locked') !== '1') {
                    return;
                }
            }

            if (form.getAttribute('data-lock-init-attempted') === '1') {
                return;
            }

            form.setAttribute('data-lock-init-attempted', '1');
            setSaveButtonDisabled(true);

            var lockUrl = form.getAttribute('data-lock-init-url');
            if (!lockUrl) {
                setSaveButtonDisabled(false);
                return;
            }

            var contentId = form.getAttribute('data-content-id') || '';
            var lockStoreKey = contentId ? ('integrated-content-lock:' + contentId) : '';
            var knownLock = '';

            if (lockStoreKey) {
                try {
                    knownLock = window.sessionStorage.getItem(lockStoreKey) || '';
                } catch (e) {
                    knownLock = '';
                }
            }

            if (!knownLock) {
                try {
                    var knownLockUrl = new URL(window.location.href);
                    knownLock = knownLockUrl.searchParams.get('lock') || '';
                } catch (e) {
                    knownLock = '';
                }
            }

            var requestBody = new URLSearchParams();
            if (LOCK_CSRF_TOKEN) {
                requestBody.set('_token', LOCK_CSRF_TOKEN);
            }
            if (knownLock) {
                requestBody.set('known_lock', knownLock);
            }

            postLockRequest(lockUrl, requestBody.toString(), false)
                .then(function (response) {
                    return response.json().catch(function () {
                        return {};
                    }).then(function (payload) {
                        return {
                            status: response.status,
                            payload: payload,
                        };
                    });
                })
                .then(function (result) {
                    var lockId = result && result.payload ? result.payload.lock : null;
                    if (result.status === 200 && lockId) {
                        applyAcquiredLock(form, lockId, lockStoreKey);
                        return;
                    }

                    form.setAttribute('data-content-locked', '1');
                    setLockOverlay(form, (result && result.payload && result.payload.message) || '');
                    if (result.status !== 423) {
                        renderLockMessage((result && result.payload && result.payload.message) || '');
                    }
                    setSaveButtonDisabled(true);
                })
                .catch(function () {
                    form.setAttribute('data-content-locked', '1');
                    setLockOverlay(form, LOCK_ACQUIRE_FAILED_MESSAGE);
                    renderLockMessage(LOCK_ACQUIRE_FAILED_MESSAGE);
                    setSaveButtonDisabled(true);
                });
        }

        document.addEventListener('DOMContentLoaded', initLockOnLoad);
        document.addEventListener('turbo:load', initLockOnLoad);
        document.addEventListener('turbo:render', initLockOnLoad);
        document.addEventListener('turbo:frame-load', initLockOnLoad);
        document.addEventListener('turbo:frame-render', initLockOnLoad);
    })();
</script>
{% endif %}

<script>
    (function initWorkflowStateAfterTurboStream() {
        function createOrFindWorkflowButton(parent, className, text) {
            var button = parent.querySelector('.' + className);
            if (!button) {
                button = document.createElement('span');
                button.className = className;
                button.textContent = text;
                parent.appendChild(button);
            }

            return button;
        }

        function setWorkflowDateTimeToNow(dateSelection) {
            var now = new Date();
            var dateInput = dateSelection.querySelector('input[type="date"]');
            var timeInput = dateSelection.querySelector('input[type="time"]');

            if (dateInput && timeInput) {
                dateInput.value = now.toISOString().split('T')[0];
                timeInput.value = now.toTimeString().split(' ')[0].substring(0, 5);
            }
        }

        function clearWorkflowDateTimeFields(dateSelection) {
            var dateInput = dateSelection.querySelector('input[type="date"]');
            var timeInput = dateSelection.querySelector('input[type="time"]');

            if (dateInput) {
                dateInput.value = '';
            }
            if (timeInput) {
                timeInput.value = '';
            }
        }

        function updateWorkflowDateText(dateSelection, dateText) {
            var dateInput = dateSelection.querySelector('input[type="date"]');
            var timeInput = dateSelection.querySelector('input[type="time"]');

            var dateValue = dateInput ? dateInput.value : '';
            var timeValue = timeInput ? timeInput.value : '';
            var displayText = '';

            if (dateValue && timeValue) {
                var dateParts = dateValue.split('-');
                displayText = dateParts[2] + '-' + dateParts[1] + '-' + dateParts[0] + ' ' + timeValue;
            } else if (dateValue) {
                var dateOnlyParts = dateValue.split('-');
                displayText = dateOnlyParts[2] + '-' + dateOnlyParts[1] + '-' + dateOnlyParts[0];
            } else if (timeValue) {
                displayText = timeValue;
            } else {
                displayText = dateSelection.getAttribute('data-set-date-text') || 'Set Date/Time';
            }

            dateText.textContent = displayText;
        }

        function toggleWorkflowDateSelection(showSelection, dateSelection, dateText) {
            if (showSelection) {
                dateSelection.style.display = 'flex';
                dateText.style.display = 'none';
                return;
            }

            dateSelection.style.display = 'none';
            dateText.style.display = 'flex';
            updateWorkflowDateText(dateSelection, dateText);
        }

        function initializeWorkflowDateTime($workflowRoot) {
            var dateSelections = $workflowRoot.find('.tailwind-datetime');

            dateSelections.each(function(index, dateSelection) {
                var parent = dateSelection.parentNode;
                if (!parent) {
                    return;
                }

                var dateText = parent.querySelector('.date-text');
                if (!dateText) {
                    dateText = document.createElement('div');
                    dateText.className = 'date-text';
                    dateText.style.display = 'block';
                    dateText.textContent = dateSelection.getAttribute('data-set-date-text') || 'Set Date/Time';
                    parent.insertBefore(dateText, dateSelection);
                }

                dateSelection.style.paddingTop = '.5rem';

                var okButton = createOrFindWorkflowButton(dateSelection, 'ok-date', 'OK');
                var setToNowButton = createOrFindWorkflowButton(dateSelection, 'set-now-date', 'Set to Now');
                var clearButton = createOrFindWorkflowButton(dateSelection, 'clear-date', 'Clear');

                dateText.onclick = function() {
                    toggleWorkflowDateSelection(true, dateSelection, dateText);
                };
                okButton.onclick = function() {
                    toggleWorkflowDateSelection(false, dateSelection, dateText);
                };
                setToNowButton.onclick = function() {
                    setWorkflowDateTimeToNow(dateSelection);
                    updateWorkflowDateText(dateSelection, dateText);
                };
                clearButton.onclick = function() {
                    clearWorkflowDateTimeFields(dateSelection);
                    updateWorkflowDateText(dateSelection, dateText);
                };

                toggleWorkflowDateSelection(false, dateSelection, dateText);
            });
        }

        function initializeWorkflowSection() {
            if (!window.jQuery || typeof window.jQuery !== 'function') {
                return;
            }

            var $ = window.jQuery;
            var $workflowRoot = $('#content-workflow-section .workflow');
            if (!$workflowRoot.length) {
                return;
            }

            var $nextStatus = $workflowRoot.find('.next-status-choice');
            var $nextStatusSelect = $nextStatus.is('select') ? $nextStatus : $nextStatus.find('select');
            var $assigned = $workflowRoot.find('.assigned-choice');
            if (!$nextStatusSelect.length || !$assigned.length) {
                return;
            }

            if (!$assigned.hasClass('select2-hidden-accessible')) {
                $assigned.select2();
            }

            var workflowId = $workflowRoot.find('.workflow-hidden').val();
            var contentType = $workflowRoot.find('.content-type-hidden').val();
            var currentStateId = $workflowRoot.closest('#content-workflow-section').attr('data-current-workflow-state-id')
                || $workflowRoot.find('.current-state').attr('data-value')
                || '';
            var currentStateName = $workflowRoot.closest('#content-workflow-section').attr('data-current-workflow-state-name') || '';
            var stateChangeUrl = $workflowRoot.data('workflow-state-change');

            if (!stateChangeUrl) {
                return;
            }

            if (currentStateId) {
                $workflowRoot.find('.current-state').attr('data-value', currentStateId);
            }
            if (currentStateName) {
                $workflowRoot.find('.form-item.current .form-control-static').text(currentStateName);
            }

            var changeState = function() {
                var status = $nextStatusSelect.val();
                if (!status) {
                    status = currentStateId;
                }

                var selectedNextState = $nextStatusSelect.val() || '';
                $assigned.attr('disabled', 'disabled');

                $.ajax({
                    url: stateChangeUrl,
                    data: {
                        workflow: workflowId,
                        state: status,
                        contentType: contentType,
                        _format: 'json',
                    },
                    dataType: 'json',
                    success: function(response) {
                        if (Array.isArray(response.next_states) && selectedNextState === '') {
                            var placeholderOption = $nextStatusSelect.find('option[value=""]').first();
                            var placeholderText = placeholderOption.length ? placeholderOption.text() : 'Status niet veranderen';

                            $nextStatusSelect.empty();
                            $nextStatusSelect.append(new Option(placeholderText, '', selectedNextState === '', selectedNextState === ''));

                            $.each(response.next_states, function(index, stateOption) {
                                if (!stateOption || stateOption.id === undefined || stateOption.name === undefined) {
                                    return;
                                }

                                var optionValue = String(stateOption.id);
                                var isSelected = selectedNextState !== '' && optionValue === String(selectedNextState);
                                $nextStatusSelect.append(new Option(stateOption.name, optionValue, isSelected, isSelected));
                            });

                            if (selectedNextState !== '' && !$nextStatusSelect.find('option[value="' + selectedNextState + '"]').length) {
                                $nextStatusSelect.val('');
                            }
                        }

                        var selected = $('option:selected', $assigned).val();
                        var $firstOption = $('option:first', $assigned);

                        $firstOption.siblings().remove();

                        $.each(response.users || [], function(index, user) {
                            var isSelected = String(user.id) === String(selected);
                            var option = new Option(user.name, user.id, isSelected, isSelected);
                            $assigned.append(option);
                        });

                        $assigned.removeAttr('disabled');

                        $.each(response.fields || {}, function(field, values) {
                            var $field = $workflowRoot.find('.form-item.' + field);
                            if (!$field.length) {
                                return;
                            }

                            var $inputs = $field.find('select, input, textarea');
                            $inputs.removeAttr('required').removeAttr('disabled');
                            $field.show();

                            if (values.disabled) {
                                $inputs.attr('disabled', 'disabled');
                                $field.hide();
                            } else if (values.required) {
                                $inputs.attr('required', 'required');
                            }

                            if ($inputs.hasClass('select2-hidden-accessible')) {
                                $inputs.trigger('change.select2');
                            }
                        });
                    },
                });
            };

            initializeWorkflowDateTime($workflowRoot);

            // After saving a workflow transition, always recalculate from the current state.
            $nextStatusSelect.val('');
            if ($nextStatusSelect.hasClass('select2-hidden-accessible')) {
                $nextStatusSelect.trigger('change.select2');
            }

            $nextStatusSelect.off('change.integratedWorkflowState').on('change.integratedWorkflowState', changeState);
            changeState();
        }

        function scheduleWorkflowInit() {
            window.requestAnimationFrame(initializeWorkflowSection);
            window.setTimeout(initializeWorkflowSection, 50);
        }

        document.addEventListener('DOMContentLoaded', scheduleWorkflowInit);
        document.addEventListener('turbo:load', scheduleWorkflowInit);
        document.addEventListener('turbo:before-stream-render', function(event) {
            var streamElement = event.target;
            if (!(streamElement instanceof HTMLElement)) {
                return;
            }

            var streamTarget = streamElement.getAttribute('target');
            if (streamTarget !== 'content-workflow-section' && streamTarget !== 'content-publications-section') {
                return;
            }

            var defaultRender = event.detail.render;
            event.detail.render = function(stream) {
                defaultRender(stream);
                if (streamTarget === 'content-workflow-section') {
                    scheduleWorkflowInit();
                }

                if (streamTarget === 'content-publications-section') {
                    if (typeof window.schedulePublicationSettingsInit === 'function') {
                        window.schedulePublicationSettingsInit();
                    } else {
                        window.dispatchEvent(new CustomEvent('updatePublicationItems'));
                    }
                }
            };
        });
    })();

    (function() {
        function initializeFeaturedExpirationVisibility() {
            var featuredToggle = document.getElementById('{{ form.featured is defined ? form.featured.vars.id|e('js') : '' }}');
            var featuredExpirationContainer = document.querySelector('[data-featured-expiration-container]');
            if (!featuredToggle || !featuredExpirationContainer) {
                return;
            }

            function syncFeaturedExpirationVisibility() {
                featuredExpirationContainer.style.display = featuredToggle.checked ? '' : 'none';
            }

            featuredToggle.addEventListener('change', syncFeaturedExpirationVisibility);
            syncFeaturedExpirationVisibility();
        }

        document.addEventListener('DOMContentLoaded', initializeFeaturedExpirationVisibility);
        document.addEventListener('turbo:load', initializeFeaturedExpirationVisibility);
        document.addEventListener('turbo:render', initializeFeaturedExpirationVisibility);
    })();

    (function() {
        function hideImplicitEventMidnightTime() {
            var eventTimeFieldIds = [
                '{{ form.startDate is defined and form.startDate.time is defined ? form.startDate.time.vars.id|e('js') : '' }}',
                '{{ form.endDate is defined and form.endDate.time is defined ? form.endDate.time.vars.id|e('js') : '' }}',
            ].filter(Boolean);

            eventTimeFieldIds.forEach(function(fieldId) {
                var timeField = document.getElementById(fieldId);

                if (!timeField || timeField.dataset.implicitMidnightHandled === 'true') {
                    return;
                }

                if (timeField.value === '00:00') {
                    timeField.value = '';
                }

                timeField.dataset.implicitMidnightHandled = 'true';
            });
        }

        document.addEventListener('DOMContentLoaded', hideImplicitEventMidnightTime);
        document.addEventListener('turbo:load', hideImplicitEventMidnightTime);
        document.addEventListener('turbo:render', hideImplicitEventMidnightTime);
    })();

    textarea = document.querySelector('.title_tinymce_input');
    if (textarea !== null) {
        textarea.addEventListener('input', autoResize, false);
        textarea.addEventListener('keypress', function(event) {
            if (event.key === 'Enter') {
                event.preventDefault();
            }
        });

        autoResize();

        function autoResize() {
            textarea.style.height = 'auto';

            if (textarea.scrollHeight > 0) {
                textarea.style.height = textarea.scrollHeight + 'px';
            }
        }

        window.addEventListener('tinyMCEInitialized', observeResize);

        function observeResize() {
            const observedTitle = document.querySelector('.title_tinymce_input');
            if (!observedTitle) {
                return;
            }

            const resize_ob = new ResizeObserver(function(entries) {
                if (!entries.length || !entries[0].contentRect) {
                    return;
                }

                const rect = entries[0].contentRect;
                const height = rect.height;
                const editor = document.querySelector('div.tox-edit-area');
                const wrapper = document.querySelector('div.tox-sidebar-wrap');

                if (!editor || !wrapper) {
                    return;
                }

                editor.style.top = (height) + 'px';
                wrapper.style.paddingBottom = (height) + 'px';
            });

            // start observing for resize
            resize_ob.observe(observedTitle);
        }
    }
</script>

