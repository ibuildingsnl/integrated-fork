{% extends '@IntegratedContent/base.html.twig' %}
{% block title %}{% trans %}Edit{% endtrans %} {{ type.name|trans }}{% endblock title %}

{% block content %}
    {% if 'Article' in type.class or 'News' in type.class or 'Comment' in type.class or 'Product' in type.class or 'Company' in type.class %}
        {# https://eactive.atlassian.net/browse/INTEGRATED-1783 #}
        {% set title_state = 'title_tinymce' %}
        {% set title_style = '' %}
        {% set tinymce_state = 'fancy_tinymce' %}
        {% set form_class = 'content-edit-form' %}
    {% else %}
        {% set title_state = '' %}
        {% set title_style = 'inline' %}
        {% set tinymce_state = 'show' %}
        {% set form_class = 'edit-form' %}
    {% endif %}

    {% block filters %}
        <div class="filters_row"></div>
    {% endblock %}

    <div class="flex flex-wrap {{ form_class }}">
        {% block form_start %}
            {{ form_start(form, { 'style': 'horizontal' }) }}
        {% endblock %}
        {% block toolbar %}
            {% include '@IntegratedContent/partials/block.toolbar.html.twig' %}
        {% endblock toolbar %}
        <div class="aside-options">
            <aside>
                <div class="aside-holder section-gray section-radius">
                    {% block sidebar %}
                        <div class="aside-item-wrapper show">
                            <div class="aside-item-header">
                                <h3 class="aside-item-title">
                                    <i class="iconoir-info-empty"></i>
                                    <span class="aside-item-icon">{% trans %}Status{% endtrans %}</span>
                                </h3>
                                <i class="iconoir-nav-arrow-up"></i>
                            </div>
                            <div class="aside-item-list">
                                <div class="aside-item-list-container">
                                    <div class="status-info">
                                        {% if form.publishTime is defined %}
                                            {{ form_row(form.publishTime, {style: 'inline'}) }}
                                        {% endif %}
                                    </div>
                                    <div class="status-options">
                                        {% if (content is defined and ((content.isPublished and content.getChannels|length > 0) or content.published == 'true')) %}
                                            <div class="status published">
                                                <i class="iconoir-check-circled-outline"></i> {% trans %}Published{% endtrans %}
                                            </div>
                                            <a class="delete"
                                               href="{{ path('integrated_content_content_delete', {'id': content.id}) }}">
                                                <i class="iconoir-trash"></i>
                                            </a>
                                        {% elseif (content is defined and ('now'|date('U') < content.publishTime.startDate |date('U'))) %}
                                            <div class="status planned">
                                                <i class="iconoir-calendar"></i> {% trans %}Planned{% endtrans %}
                                            </div>
                                        {% else %}
                                            <div class="status draft">
                                                <i class="iconoir-design-pencil"></i> {% trans %}Draft{% endtrans %}
                                            </div>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="aside-item-wrapper" id="used-by">

                        </div>

                        {% block content_history %}
                            {% if showContentHistory %}
                                {{ render(controller('Integrated\\Bundle\\ContentHistoryBundle\\Controller\\ContentHistoryController::history', { 'content': content })) }}
                            {% endif %}
                        {% endblock %}

                        {% block content_meta %}
                            {% for child in form|filter(row => row.vars.attr.location|default == constant('Integrated\\Common\\Form\\Mapping\\Attributes\\Field::LOCATION_SIDEBAR'))  %}
                                {{ form_row(child) }}
                            {% endfor %}
                        {% endblock %}

                        {% block content_relations %}
                            {% if form.offsetGet('relations').count() %}
                                <input type="hidden" id="default_references" value="{{ references }}">
                                {% for relation in form.relations %}
                                    {% if relation.vars.attr['data-location'] == 'sidebar' %}

                                        <div class="aside-item-wrapper relations">
                                            <div class="aside-item-header">
                                                <h3 class="aside-item-title">
                                                    <i class="iconoir-{{ relation.vars.attr['data-icon'] }}"></i>
                                                    <label
                                                            class="aside-item-icon"
                                                            for="{{ relation.vars.name }}">{{ relation.vars.attr['data-title'] }}</label>
                                                </h3>
                                                <i class="iconoir-nav-arrow-up"></i>
                                            </div>
                                            <div class="aside-item-list">
                                                <div class="aside-item-list-container relation">
                                                    {% if relation.vars.attr['data-relationtype'] == 'multimedia_choice' %}
                                                        {% include '@IntegratedContent/media/partial/select_component.html.twig' with {
                                                            relation: relation,
                                                            form_relations: formRelations|default(null),
                                                        } %}
                                                    {% else %}
                                                        <div class="input-group relative flex items-stretch w-full">
                                                            <select
                                                                    multiple
                                                                    id="{{ relation.vars.name }}"
                                                                    data-multiple="{{ relation.vars.attr['data-multiple'] }}"
                                                                    data-types="{{ relation.vars.attr['data-types'] }}"
                                                                    data-url="{{ path('integrated_content_content_index', {'_format': 'json'}) }}"
                                                                    data-url-new="{{ path('integrated_content_content_new', {'type': '__type__', 'relation': '__relation__', '_format': 'iframe.html'}) }}"
                                                                    class="relation-items form-control"
                                                                    style="display: none; width: 89%">
                                                            </select>
                                                            <span class="input-group-addon" data-add="1"></span>
                                                        </div>
                                                    {% endif %}
                                                </div>
                                            </div>
                                        </div>
                                    {% endif %}
                                {% endfor %}
                            {% endif %}
                        {% endblock %}
                    {% endblock %}
                </div>
            </aside>
        </div>
        <div class="editor-wrapper">
            <section class="editor">
                {% block content_form %}
                    {% for child in form|filter(row => row.vars.attr.location|default == constant('Integrated\\Common\\Form\\Mapping\\Attributes\\Field::LOCATION_EDITOR'))  %}
{#                        {{ dump(child) }}#}
                        {{ form_row(child) }}
                    {% endfor %}

                    {{ form_rest(form, {'style':'editor', 'state':'show'}) }}
                {% endblock %}

                {% block content_relations_editor %}
                    {% if form.offsetGet('relations').count() %}
                        <input type="hidden" id="default_references" value="{{ references }}">
                        {% for relation in form.relations %}
                            {% if relation.vars.attr['data-location'] != 'sidebar' %}
                                <div class="editor-item-wrapper relations">
                                    <div class="editor-item-header">
                                        <h3 class="editor-item-title">
                                            <i class="iconoir-{{ relation.vars.attr['data-icon'] }}"></i>
                                            <label
                                                    class="editor-item-icon"
                                                    for="{{ relation.vars.name }}">{{ relation.vars.attr['data-title'] }}</label>
                                        </h3>
                                        <i class="iconoir-nav-arrow-up"></i>
                                    </div>
                                    <div class="editor-item-list">
                                        <div class="editor-item-list-container relation">
                                            <div class="input-group relative flex items-stretch w-full">

                                                {% if relation.vars.attr['data-relationtype'] == 'multimedia_choice' %}
                                                    {% include '@IntegratedContent/media/partial/select_component.html.twig' with {
                                                        relation: relation,
                                                        form_relations: formRelations|default(null),
                                                    } %}

                                                {% else %}
                                                    <select
                                                            multiple
                                                            id="{{ relation.vars.name }}"
                                                            data-multiple="{{ relation.vars.attr['data-multiple'] }}"
                                                            data-types="{{ relation.vars.attr['data-types'] }}"
                                                            data-url="{{ path('integrated_content_content_index', {'_format': 'json'}) }}"
                                                            data-url-new="{{ path('integrated_content_content_new', {'type': '__type__', 'relation': '__relation__', '_format': 'iframe.html'}) }}"
                                                            class="relation-items form-control"
                                                            style="display: none; width: 89%">
                                                    </select>
                                                    <span class="input-group-addon" data-add="1"></span>
                                                {% endif %}
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            {% endif %}
                        {% endfor %}

                        {# This element will be copied for every image for a multimedia_choice relation #}
                        <li id="selected_image" class="hidden media-item ui-widget-content ui-corner-tr grid ml-1 mb-1">
                            <div class="media-preview">
                                <div class="thumbnail">
                                    <div class="centered">
                                        <img src="">
                                    </div>
                                    <div class="remove_link bg-red-200 p-2 border border-black">{% trans %}Delete{% endtrans %}</div>
                                </div>
                            </div>
                        </li>

                    {% endif %}
                {% endblock content_relations_editor %}
            </section>
        </div>


        {% block form_end %}
            {{ form_end(form) }}
        {% endblock %}
    </div>

    {% autoescape 'js' %}
        {% verbatim %}
            <script id="add-template" type="text/xhandlebars-template">
                {{#if relations}}
                {{#equals relations.length 1}}
                    <button data-title="Add {{relations.0.name}}" class="add-relation" data-href="{{relations.0.href}}" data-modal="add-modal">
                        Add {{relations.0.name}}
                        <span class="sr-only">{% endverbatim %}{% trans %}Add New{% endtrans %}{% verbatim %}:</span>
                    </button>
                {{else}}
                <div class="add-relation">
                    <button type="button" class=" inline-block w-0 h-0 ml-1 align border-b-0 border-t-1 border-r-1 border-l-1 font-size-13" data-toggle="dropdown" aria-expanded="false">
                        <i class="iconoir-plus"></i>
                        <span class="sr-only">{% endverbatim %}{% trans %}Add New{% endtrans %}{% verbatim %}:</span>
                    </button>
                    <ul class=" dropdown-menu" role="menu">
                        {{#each relations}}
                        <li>
                            <a class="cursor-pointer" data-title="Add {{this.name}}" data-href="{{this.href}}" target="_blank" data-modal="add-modal">
                                {{this.name}}
                            </a>
                        </li>
                        {{/each}}
                    </ul>
                 </div>
                {{/equals}}
                {{/if}}
                <div class="modal" id="relation-add-modal" tabindex="-1" role="dialog" aria-labelledby="myLargeModalLabel" aria-hidden="true">
                    <div class="modal-dialog modal-lg">
                        <div class="modal-content">
                            <div class="modal-header">
                                <button type="button" class="close" data-dismiss="modal"><span aria-hidden="true">×</span><span class="sr-only">{% endverbatim %}{% trans %}Close{% endtrans %}{% verbatim %}</span></button>
                                <h4 class="modal-title">{% endverbatim %}{% trans %}Add{% endtrans %}{% verbatim %}</h4>
                            </div>
                            <iframe width="100%" height="400">{% endverbatim %}{% trans %}Loading{% endtrans %}{% verbatim %}</iframe>
                        </div>
                    </div>
                </div>
            </script>
        {% endverbatim %}
    {% endautoescape %}

{% endblock %}

{% block edit_modal %}
    <div class="modal fade" id="content-edit-modal">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h4 class="modal-title">{% trans %}Unsaved changes{% endtrans %}</h4>
                </div>
                <div class="modal-body">
                    <p>{% trans %}You have unsaved changes. When you leave this page your changes will be lost.{% endtrans %}</p>
                    <p>{% trans %}Are you sure you want to leave this page?{% endtrans %}</p>
                </div>
                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-primary live-page">{% trans %}Leave this page{% endtrans %}</button>
                    <button type="button" class="btn btn-gray-thin"
                            data-dismiss="modal">{% trans %}Stay on page{% endtrans %}</button>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
{% block webpack_js %}
    <script src="{{ asset('bundles/integratedintegrated/edit.js') }}"></script>
{% endblock %}

{% block javascript %}
{{ parent() }}
<script>
    textarea = document.querySelector('.title_tinymce_input');
    if (textarea !== null) {
        textarea.addEventListener('input', autoResize, false);
        textarea.addEventListener('DOMContentLoaded', autoResize, false);

        textarea.addEventListener('keypress', function(event) {
            if (event.key === 'Enter') {
                event.preventDefault();
            }
        });
        function autoResize() {
            this.style.height = 'auto';
            this.style.height = this.scrollHeight + 'px';
        }

        setTimeout(function() {
            const resize_ob = new ResizeObserver(function(entries) {
                // since we are observing only a single element, so we access the first element in entries array
                const rect = entries[0].contentRect;

                // current width & height
                const width = rect.width;
                const height = rect.height;

                editor = document.querySelector('div.tox-edit-area');
                wrapper = document.querySelector('div.tox-sidebar-wrap');
                editor.style.top = (46 + height) + 'px';
                wrapper.style.paddingBottom = (46 + height) + 'px';
            });

            //TODO: Need to fix comments alignment.
            // start observing for resize
            resize_ob.observe(document.querySelector('.title_tinymce_input'));
        }, 1000);
    }
</script>

{% if content is defined %}
    <script>
        $(function() {
            var cnt = $('#used-by');

            var handleUsedBy = function(data) {
                var optionsTemplateSource = $('#used-by-template').html(),
                    optionsTemplate = Handlebars.compile(optionsTemplateSource);
                var paginationTemplateSource = $('#pagination-template').html(),
                    paginationTemplate = Handlebars.compile(paginationTemplateSource);

                data.title = "{% trans %}Used by{% endtrans %}";

                if (data.pagination.numFound == 0) {
                    cnt.hide();
                }
                cnt.html(optionsTemplate(data)).find('.content_column_inner').append(paginationTemplate(data));
                cnt.find('.pagination a').click(function(ev) {
                    ev.preventDefault();
                    loadUsedBy($(this).attr('href'));
                });
            };

            var loadUsedBy = function(url) {
                cnt.find('.pagination a').unbind('click').click(function(ev) {
                    ev.preventDefault();
                });

                $.ajax({
                    url: url,
                    data: {
                        'limit': 5,
                    },
                    success: handleUsedBy,
                });
            };

            loadUsedBy('{{ path('integrated_content_content_used_by', {'id': content.id, '_format': 'json'}) }}');

            window.addEventListener('message', function(event) {
                // also resize modal if relations are changed
                var iframe = $('[data-id="' + event.data.resizeModal + '"]');
                var height = iframe.contents().height();
                var margin = 120;

                if (height > ($(window).height() - margin)) {
                    height = $(window).height() - margin;
                }

                iframe.attr('height', height);
            }, false);

        });
    </script>
{% endif %}
{% if editable %}
    <script>
        var formInvalid = {{ form.vars.valid ? '0' : '1' }};
    </script>
{% endif %}

{{ include('@IntegratedContent/content/handlebars/templates.html.twig') }}
{% endblock javascript %}

{% block style %}
    {{ parent() }}

    <link rel="stylesheet" href="{{ asset('bundles/integratedintegrated/edit.css') }}">

    <style>
        .form-horizontal.margin-top {
            margin-top: 15px;
        }

        .form-horizontal .add-wrapper {
            margin-top: 5px;
        }

        .font-size-13 {
            font-size: 13px;
        }

        .cursor-pointer {
            cursor: pointer;
        }

        .modal iframe {
            width: 100%;
            min-height: 10px;
            border: none;
            min-height: 50vh;
        }
    </style>
{% endblock %}
