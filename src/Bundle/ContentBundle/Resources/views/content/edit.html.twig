{% extends '@IntegratedContent/base.html.twig' %}
{% block title %}{% trans %}Edit{% endtrans %} {{ type.name|trans }}{% endblock title %}
{% block content %}
    {% block filters %}
        <div class="filters_row"></div>
    {% endblock %}

    <div class="flex flex-wrap">
        {% block form_start %}
            {{ form_start(form, { 'style': 'horizontal', 'label_col': '', 'widget_col': '', 'placeholder': true, 'label': true }) }}
        {% endblock %}
        <div id="toolbar" class="w-full flex justify-between">
            <div class="back">

            </div>
            <div class="options">
                <div class="convert">
                    <a href="#">Naar concept omzetten</a>
                </div>
                <div class="preview">
                    {% block content_website_links %}
                        {% if content is defined %}
                            {% if content.getChannels|length > 0 %}
                                <ul class="options-no-bg">
                                    <li class="dropdown">
                                        <a href="#" data-toggle="dropdown" role="button" id="drop_1"
                                           class="btn btn-dropdown">
                                            <span>{% trans %}Preview this{% endtrans %} {{ type.name|trans }}</span>
                                            <i class="fa-regular fa-chevron-down"></i>
                                        </a>
                                        <ul aria-labelledby="drop_1" role="menu" class="dropdown-menu alt" id="menu_1">
                                            {% for channel in content.getChannels %}
                                                {% set domain = channel.primaryDomain|default(channel.domains|first)|default("") %}
                                                {% set url = integrated_url(content, channel.id, false) %}
                                                {% if (domain != "" and url) %}
                                                    {% if (domain != app.request.httphost) %}
                                                        {% set url = "//" ~ domain ~ path('integrated_website_enter_session', {'sessionId': app.session.id, 'path': url}) %}
                                                    {% endif %}
                                                    <li>
                                                        <a target="_blank"
                                                           href="{{ url }}">{% trans %}View on{% endtrans %} {{ channel.name }}</a>
                                                    </li>
                                                {% endif %}
                                            {% endfor %}
                                        </ul>
                                    </li>
                                </ul>
                            {% endif %}
                        {% endif %}
                    {% endblock %}
                </div>
                <div class="form-actions">
                    {% block form_actions %}
                        {{ form_row(form.actions) }}
                    {% endblock %}
                </div>
            </div>
        </div>
        <div class="editor-wrapper">
            <section class="editor">
                {% block content_form %}
                    {% if form.content is defined %}
                        {{ form_row(form.content) }}
                    {% endif %}
                    {% if form.title is defined %}
                        {{ form_row(form.title) }}
                    {% endif %}
                    {% if form.subtitle is defined %}
                        {{ form_row(form.subtitle) }}
                    {% endif %}
                    {% if form.intro is defined %}
                        {{ form_row(form.intro) }}
                    {% endif %}
                {% endblock %}
            </section>
        </div>

        <div class="aside-options">
            <aside>
                <div class="aside-holder section-gray section-radius">
                    {% block sidebar %}
                        {% if content is defined %}
                            <div class="aside-item-wrapper show">
                                <div class="aside-item-header">
                                    <h3 class="aside-item-title">
                                        <i class="fa-regular fa-clock"></i>
                                        <span class="aside-item-icon">{% trans %}Status{% endtrans %}</span>
                                    </h3>
                                    <i class="fa-regular fa-chevron-up"></i>
                                </div>
                                <div class="aside-item-list">
                                    <div class="aside-item-list-container">
                                        <div class="status-info">
                                            {% if form.publishTime is defined %}
                                                {{ form_row(form.publishTime, {'style': 'inline', 'show_placeholder': true}) }}
                                            {% endif %}
                                        </div>
                                        <div class="status-options">
{#                                            {% dump(content) %}#}
                                            {% if content.isPublished and content.getChannels|length > 0 %}
                                                <div class="status published">
                                                    <i class="fa-regular fa-circle-check"></i> {% trans %}Published{% endtrans %}
                                                </div>
                                                <a class="delete" href="{{ path('integrated_content_content_delete', {'id': content.id}) }}">
                                                    <i class="fa-regular fa-trash-can"></i>
                                                </a>
                                            {% else %}
                                                <div class="status draft">
                                                    <i class="fa-regular fa-pen-ruler"></i> {% trans %}Draft{% endtrans %}
                                                </div>
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        {% endif %}

                        <div id="used-by">

                        </div>

                        {% block content_history %}
                            {% if showContentHistory %}
                                {{ render(controller('Integrated\\Bundle\\ContentHistoryBundle\\Controller\\ContentHistoryController::history', { 'content': content })) }}
                            {% endif %}
                        {% endblock %}

{#                        {% dump(form) %}#}

                        {% block content_meta %}
                            {% if form.channels is defined %}
                                {{ form_row(form.channels, {'style': 'sidebar'}) }}
                            {% endif %}
                            {% if form.slug is defined %}
                                {{ form_row(form.slug, {'style': 'sidebar'}) }}
                            {% endif %}

                            {% if form.description is defined %}
                                {{ form_row(form.description, {'style': 'sidebar'}) }}
                            {% endif %}

                            {% if form.address is defined %}
                                {{ form_row(form.address, {'style': 'sidebar'}) }}
                            {% endif %}
                            {% if form.copyrightRestrictions is defined %}
                                {{ form_row(form.copyrightRestrictions, {'style': 'sidebar'}) }}
                            {% endif %}

                            {% if form.authors is defined %}
                                {{ form_row(form.authors, {'style': 'sidebar'}) }}
                            {% endif %}
                            {% if form.source is defined %}
                                {{ form_row(form.source, {'style': 'sidebar'}) }}
                            {% endif %}
                            {% if form.sourceUrl is defined %}
                                {{ form_row(form.sourceUrl, {'style': 'sidebar'}) }}
                            {% endif %}
                            {% if form.relations is defined %}
                                {{ form_row(form.relations, {'style': 'sidebar'}) }}
                            {% endif %}

                            {% if form.rank is defined %}
                                {{ form_row(form.rank, {'style': 'sidebar'}) }}
                            {% endif %}
                        {% endblock %}


                        {% block content_relations %}
                            {% if form.offsetGet('relations').count() %}
                                <input type="hidden" id="default_references" value="{{ references }}">
                                {% for relation in form.relations %}
                                    <div class="aside-item-wrapper">
                                        <div class="aside-item-header">
                                            <h3 class="aside-item-title">
                                                <i class="fa-regular fa-clock"></i>
                                                <span
                                                    class="aside-item-icon">{{ relation.vars.attr['data-title'] }}</span>
                                            </h3>
                                            <i class="fa-regular fa-chevron-up"></i>
                                        </div>
                                        <div class="aside-item-list">
                                            <div class="aside-item-list-container">
                                                <div class="input-group relative flex items-stretch w-full">
                                                    <select
                                                        multiple
                                                        id="{{ relation.vars.name }}"
                                                        data-multiple="{{ relation.vars.attr['data-multiple'] }}"
                                                        data-types="{{ relation.vars.attr['data-types'] }}"
                                                        data-url="{{ path('integrated_content_content_index', {'_format': 'json'}) }}"
                                                        data-url-new="{{ path('integrated_content_content_new', {'type': '__type__', 'relation': '__relation__', '_format': 'iframe.html'}) }}"
                                                        class="relation-items form-control"
                                                        style="display: none; width: 89%">
                                                    </select>
                                                    <span class="input-group-addon" data-add="1"></span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                {% endfor %}
                            {% endif %}
                        {% endblock %}
                    {% endblock %}
                </div>
            </aside>
        </div>
        {% block form_end %}
            {{ form_end(form) }}
        {% endblock %}
    </div>

    {% autoescape 'js' %}
        {% verbatim %}
            <script id="add-template" type="text/xhandlebars-template">
                {{#if relations}}
                {{#equals relations.length 1}}
                    <button data-title="Add {{relations.0.name}}" class="add-relation font-size-13" data-href="{{relations.0.href}}" data-modal="add-modal">
                        <i class="fa-regular fa-plus"></i>
                        <span class="sr-only">{% endverbatim %}{% trans %}Add New{% endtrans %}{% verbatim %}:</span>
                    </button>
                {{else}}
                <div class="add-relation">
                    <button type="button" class=" inline-block w-0 h-0 ml-1 align border-b-0 border-t-1 border-r-1 border-l-1 font-size-13" data-toggle="dropdown" aria-expanded="false">
                        <i class="fa-regular fa-plus"></i>
                        <span class="sr-only">{% endverbatim %}{% trans %}Add New{% endtrans %}{% verbatim %}:</span>
                    </button>
                    <ul class=" dropdown-menu" role="menu">
                        {{#each relations}}
                        <li>
                            <a class="cursor-pointer" data-title="Add {{this.name}}" data-href="{{this.href}}" target="_blank" data-modal="add-modal">
                                {{this.name}}
                            </a>
                        </li>
                        {{/each}}
                    </ul>
                 </div>
                {{/equals}}
                {{/if}}
                <div class="modal" id="relation-add-modal" tabindex="-1" role="dialog" aria-labelledby="myLargeModalLabel" aria-hidden="true">
                    <div class="modal-dialog modal-lg">
                        <div class="modal-content">
                            <div class="modal-header">
                                <button type="button" class="absolute top-0 bottom-0 right-0 px-4 py-3" data-dismiss="modal"><span aria-hidden="true">×</span><span class="sr-only">{% endverbatim %}{% trans %}Close{% endtrans %}{% verbatim %}</span></button>
                                <h4 class="modal-title">{% endverbatim %}{% trans %}Add{% endtrans %}{% verbatim %}</h4>
                            </div>
                            <iframe width="100%" height="400">{% endverbatim %}{% trans %}Loading{% endtrans %}{% verbatim %}</iframe>
                        </div>
                    </div>
                </div>
            </script>
        {% endverbatim %}
    {% endautoescape %}

{% endblock %}

    {% block edit_modal %}
        <div class="modal fade" id="content-edit-modal">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h4 class="modal-title">{% trans %}Unsaved changes{% endtrans %}</h4>
                    </div>
                    <div class="modal-body">
                        <p>{% trans %}You have unsaved changes. When you leave this page your changes will be lost.{% endtrans %}</p>
                        <p>{% trans %}Are you sure you want to leave this page?{% endtrans %}</p>
                    </div>
                    <div class="modal-footer">
                        <button type="button"
                                class="btn btn-primary live-page">{% trans %}Leave this page{% endtrans %}</button>
                        <button type="button" class="btn btn-gray-thin"
                                data-dismiss="modal">{% trans %}Stay on page{% endtrans %}</button>
                    </div>
                </div>
            </div>
        </div>
    {% endblock %}
{% block webpack_js %}
    <script src="{{ asset('bundles/integratedintegrated/edit.js') }}"></script>
{% endblock %}

{% block javascript %}
{{ parent() }}

{% if content is defined %}
<script>
    $(function() {
        var cnt = $('#used-by');

        var handleUsedBy = function(data) {
            var optionsTemplateSource = $('#used-by-template').html(), optionsTemplate = Handlebars.compile(optionsTemplateSource);
            var paginationTemplateSource = $('#pagination-template').html(), paginationTemplate = Handlebars.compile(paginationTemplateSource);

            data.title = "{% trans %}Used by{% endtrans %}";

            if (data.pagination.numFound == 0) {
                cnt.hide();
            }
            cnt.html(optionsTemplate(data)).find('.content_column_inner').append(paginationTemplate(data));
            cnt.find('.pagination a').click(function(ev){
                ev.preventDefault();
                loadUsedBy($(this).attr('href'));
            });
        };

        var loadUsedBy = function(url) {
            cnt.find('.pagination a').unbind('click').click(function(ev){
                ev.preventDefault();
            });

            $.ajax({
                url: url,
                data: {
                    'limit': 5,
                },
                success: handleUsedBy,
            });
        };

        loadUsedBy('{{ path('integrated_content_content_used_by', {'id': content.id, '_format': 'json'}) }}');

        window.addEventListener('message', function(event) {
            // also resize modal if relations are changed
            var iframe = $('[data-id="' + event.data.resizeModal + '"]');
            var height = iframe.contents().height();
            var margin = 120;

            if (height > ($(window).height() - margin)) {
                height = $(window).height() - margin;
            }

            iframe.attr('height', height);
        }, false);
    });
    function asideItemsSearch(el) {
            // Declare variables

            var input, filter, ul, li, a, i, txtValue;
            input = el;
            filter = input.value.toUpperCase();
            ul = el.parentNode.parentNode.querySelector('.aside-item-list > ul.filters_list');
            li = ul.getElementsByTagName('li');

            // Loop through all list items, and hide those who don't match the search query
            for (i = 0; i < li.length; i++) {
                a = li[i].getElementsByTagName('label')[0];
                txtValue = a.textContent || a.innerText;
                if (txtValue.toUpperCase().indexOf(filter) > -1) {
                    li[i].style.display = '';
                } else {
                    li[i].style.display = 'none';
                }
            }
        }

        // document.addEventListener('DOMContentLoaded', function() {
        //     var filterElements = document.getElementsByClassName('aside-item-list');
        //
        //     for (var ii = 0; ii < filterElements.length; ii++) {
        //         openSelectedOptions(filterElements[ii]);
        //     }
        //
        //     function openSelectedOptions(elem) {
        //         var textinputs = elem.querySelectorAll('input[type=checkbox]');
        //         console.log(elem);
        //         var chev = elem.parentNode.querySelector('.fa-chevron-up');
        //         console.log(chev);
        //         var empty = [].filter.call(textinputs, function(elem) {
        //             return !elem.checked;
        //         });
        //         if (textinputs.length != empty.length) {
        //             show(elem, chev);
        //         }
        //     }
        // });

        // JS
        var filter = document.getElementsByClassName('aside-item-header');

        for (var i = 0; i < filter.length; i++) {
            filter[i].addEventListener('click', options, false);
        }

        function options(event) {
            var options = this.parentNode.querySelector('.aside-item-list');
            var chev = this.querySelector('.fa-chevron-up');
            // Prevent default link behavior
            event.preventDefault();

            if (!options) return;

            // Toggle the content
            toggle(options, chev);
        }

        // Show an element
        var show = function(elem, chev) {

            // Get the natural height of the element
            var getHeight = function() {
                elem.style.display = 'block'; // Make it visible
                var height = elem.scrollHeight + 'px'; // Get it's height
                elem.style.display = ''; //  Hide it again
                return height;
            };

            var height = getHeight(); // Get the natural height
            // elem.classList.add('show'); // Make the element visible
            elem.parentNode.classList.add('show'); // Make the element visible
            elem.style.height = height; // Update the max-height

            // Once the transition is complete, remove the inline max-height so the content can scale responsively
            window.setTimeout(function() {
                elem.style.height = '';
            }, 350);

        };

        // Hide an element
        var hide = function(elem, chev) {

            // Give the element a height to change from
            elem.style.height = elem.scrollHeight + 'px';

            // Set the height back to 0
            window.setTimeout(function() {
                elem.style.height = '0';
            }, 1);

            // When the transition is complete, hide it
            window.setTimeout(function() {
                elem.classList.remove('show');
                elem.parentNode.classList.remove('show');
            }, 350);

        };

        // Toggle element visibility
        var toggle = function(elem, chev, timing) {

            // If the element is visible, hide it
            if (elem.parentNode.classList.contains('show')) {
                hide(elem, chev);
                return;
            }

            // Otherwise, show it
            show(elem, chev);

        };
</script>

{% if editable %}
    <script>
        var formInvalid = {{ form.vars.valid ? '0' : '1' }};
    </script>

    <script src="{{ asset('bundles/integratedcontent/js/unlock_article.js') }}"></script>
{% endif %}
{% endif %}

{{ include('@IntegratedContent/content/handlebars/templates.html.twig')}}
{% endblock javascript %}

{% block style %}
    {{ parent() }}

    <link rel="stylesheet" href="{{ asset('bundles/integratedintegrated/edit.css') }}">

    <style>
