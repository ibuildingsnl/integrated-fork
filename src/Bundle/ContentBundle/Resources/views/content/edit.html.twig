{#        <input type="text" id="integrated_content_relations_categories" name="integrated_content[relations][categories]" data-title="CATEGORIES" data-relation="categories" data-multiple="1" data-relationtype="taxonomy" data-icon="fafa" data-location="sidebar" data-types="[{&quot;type&quot;:&quot;newcategories&quot;,&quot;name&quot;:&quot;newcategories&quot;}]" placeholder="Categories" class="form-control" value="3ca4108e4ee339c4a3e127d2b728b8ee,ecac5f54b42f3451b5599e9f502c0db8,5164f9651d1e37799993f827c908911b">`#}
