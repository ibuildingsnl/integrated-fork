{#        <input type="text" id="integrated_content_relations_article_category" name="integrated_content[relations][categories]" data-title="CATEGORIES" data-relation="categories" data-multiple="1" data-relationtype="taxonomy" data-icon="fafa" data-location="sidebar" data-types="[{&quot;type&quot;:&quot;newcategories&quot;,&quot;name&quot;:&quot;newcategories&quot;}]" placeholder="Categories" class="form-control" value="3ca4108e4ee339c4a3e127d2b728b8ee,ecac5f54b42f3451b5599e9f502c0db8,5164f9651d1e37799993f827c908911b">`#}
    <div>FULLSCREEN BUTTON:</div>
    <button onclick="toggleFullscreen()" class="p-2 border border-black bg-white">Toggle fullscreen</button>

    <div id="categories_checkboxes_foldout" class="categories_checkboxes hidden">
        {% for category in categories %}
            {% if category.depth == 0 %}
                {% set real_title = category.title %}
                {% set level0 = category.title %}

                {% set level0channels = category.channels %}
                {% set parent_channels = category.channels %}
            {% endif %}

            {% if category.depth == 1 %}
                {% set real_title = level0 ~ ' > ' ~ category.title %}
                {% set level1 = category.title %}

                {% set level1channels = category.channels %}
                {% set parent_channels = category.channels|merge(level0channels) %}
            {% endif %}

            {% if category.depth == 2 %}
                {% set real_title = level0 ~ ' > ' ~ level1 ~ ' > ' ~ category.title %}
                {% set level2 = category.title %}

                {% set level2channels = category.channels %}
                {% set parent_channels = category.channels|merge(level0channels)|merge(level1channels) %}
            {% endif %}

            <div
                 data-fulltitle="{{ real_title }}"
                 data-title="{{ category.title }}"
                 data-parentchannels="{% for channel in parent_channels %}{{ channel.getId }},{% endfor %}"
                 data-taxonomyId="{{ category.taxonomyId }}"
                 data-channels="{% for channel in category.channels %}{{ channel.getId }},{% endfor %}">
                {% for i in range(0, category.depth) %} - {% endfor %}
                <input type="checkbox" data-id="{{ category.taxonomyId }}">
                <label>{{ category.title }}</label>
{#                {% if parent_channels|length > 0 %}#}
{#                    ALL: {#}
{#                    {% for channel in parent_channels %}<span>{{ channel.getId }}, </span> {% endfor %}#}
{#                    }#}
{#                {% endif %}#}
            </div>
        {% endfor %}


    </div>

    <script>
        let enabled_categories = []
        let enabled_channels = []
        const current_relation_id = '#integrated_content_relations_article_category'
        const pills_id = 'enabled_categories_pills'

        function toggleFullscreen() {
            $('#categories_checkboxes_foldout').toggleClass("hidden")
        }

        function addEventListeners(channel_checkboxes, category_checkboxes) {
            channel_checkboxes.forEach(item => {
                item.addEventListener('change', handleChannelClick)
            })
            category_checkboxes.forEach(item => {
                item.addEventListener('change', handleCategoryClick)
            })
        }

        function getEnabledChannels(checkboxes) {
            return Array.from(checkboxes).reduce((prev, current, arr) => {
                return current.checked == true ? [...prev, current.value] : prev
            }, [])
        }

        document.addEventListener("DOMContentLoaded", function(event) {
            const channel_checkboxes = document.querySelectorAll('#integrated_content_channels input[type=checkbox]')
            const category_checkboxes = document.querySelectorAll('.categories_checkboxes input[type=checkbox]')

            enabled_categories = document.querySelector('#enabled_categories').dataset.ids.split(",").filter(n => n)
            enabled_channels = getEnabledChannels(channel_checkboxes)

            addEventListeners(channel_checkboxes, category_checkboxes)
            showEnabledCategories()
            setCheckboxState()
            filterCheckboxesBasedOnChannels()
        });

        function handleCategoryClick(event) {
            const current_value = document.querySelector(current_relation_id).value.split(',').filter(n => n)

            updateFormInputField(current_value, event)
            showEnabledCategories()
            setCheckboxState()
        }

        function updateFormInputField(current_value, event) {
            if (current_value.includes(event.target.dataset.id)) {
                //here we remove
                document.querySelector('#new').value = current_value.filter(n => n != event.target.dataset.id).toString()
                document.querySelector(current_relation_id).value = current_value.filter(n => n != event.target.dataset.id).toString()
            } else {
                //here we add
                document.querySelector('#new').value = document.querySelector(current_relation_id).value + "," + event.target.dataset.id
                document.querySelector(current_relation_id).value = document.querySelector(current_relation_id).value + "," + event.target.dataset.id
            }
        }

        function showEnabledCategories() {
            const current_value = document.querySelector(current_relation_id).value.split(',').filter(n => n)
            const categories_checkboxes = document.querySelectorAll('#categories_checkboxes div')
            document.getElementById(pills_id).innerHTML = "";
            for (checkbox of categories_checkboxes) {
                if (current_value.includes( checkbox.querySelector('input').dataset.id)) {
                    appendPill(checkbox.dataset.fulltitle)
                }
            }
        }

        function appendPill(pillText) {
            const node = document.createElement("span");
            const textnode = document.createTextNode(pillText);
            node.classList.add('bg-white', 'rounded-full', 'border', 'border-black', 'p-2', 'm-2');
            node.appendChild(textnode);
            document.getElementById(pills_id).appendChild(node);
        }

        function setCheckboxState(enabled_categories) {
            const current_value = document.querySelector(current_relation_id).value.split(',').filter(n => n)
            const categories_checkboxes = document.querySelectorAll('.categories_checkboxes div input')

            for (checkbox of categories_checkboxes) {
                let state = checkbox.value
                if (current_value.includes( checkbox.dataset.id)) {
                    checkbox.checked = true
                } else {
                    checkbox.checked = false
                }
            }
        }

        function handleChannelClick(event) {
            if (enabled_channels.includes(event.target.value)) {
                enabled_channels = enabled_channels.filter(item => item != event.target.value)
            } else {
                enabled_channels.push(event.target.value)
            }

            filterCheckboxesBasedOnChannels()
        }

        function filterCheckboxesBasedOnChannels() {
            const categories_checkboxes = document.querySelectorAll('.categories_checkboxes div')

            for (checkbox of categories_checkboxes) {
                let show_category = enabled_channels.length == 0 || false

                if (enabled_channels.length != 0) {
                    show_category = checkbox.dataset.parentchannels?.split(",").filter(n => n).some(channel => enabled_channels.includes(channel))
                }

                if (show_category == true) {
                    checkbox.classList.remove('hidden')
                } else {
                    checkbox.classList.add('hidden')
                }
            }
        }
    </script>

