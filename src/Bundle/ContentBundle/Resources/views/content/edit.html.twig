    <script>
        let states = []
        let enabled_channels = []
        function setup(checkboxes) {
            result = {}
            for (checkbox of checkboxes) {
                if (checkbox.hasAttribute('checked')) {
                    result[checkbox.value] = true
                } else {
                    result[checkbox.value] = false
                }
            }
            return result
        }

        function toggle_fullscreen() {
            console.log("toggle")
            $('#category_selection_foldout').toggleClass("hidden")
        }

        function get_enabled_states(checkboxes) {
            result = []
            for (checkbox of checkboxes) {
                if (checkbox.hasAttribute('checked')) {
                    result.push(checkbox.value)
                }
            }
            return result
        }

        document.addEventListener("DOMContentLoaded", function(event) {
            const checkboxes = document.querySelectorAll('#integrated_content_channels input[type=checkbox]')

            states = setup(checkboxes)

            enabled_channels = document.querySelector('#enabled_channels').dataset.ids.split(",").filter(n => n)

            enabled_states = get_enabled_states(checkboxes)
            console.log(enabled_states)

            checkboxes.forEach(item => {
                item.addEventListener('change', alterState)
            })

            const categoryCheckboxes = document.querySelectorAll('#categories_checkboxes input[type=checkbox]')
            categoryCheckboxes.forEach(item => {
                item.addEventListener('change', handleCategoryClick)
            })

            showEnabledCategories()

            enableCheckboxes()
        });

        function handleCategoryClick(event) {
            const current_value = document.querySelector('#integrated_content_relations_categories').value.split(',').filter(n => n)
            if (current_value.includes(event.target.dataset.id)) {
                //here we remove
                document.querySelector('#new').value = current_value.filter(n => n != event.target.dataset.id).toString()
                document.querySelector('#integrated_content_relations_categories').value = current_value.filter(n => n != event.target.dataset.id).toString()
            } else {
                //here we add
                document.querySelector('#new').value = document.querySelector('#integrated_content_relations_categories').value + "," + event.target.dataset.id
                document.querySelector('#integrated_content_relations_categories').value = document.querySelector('#integrated_content_relations_categories').value + "," + event.target.dataset.id
            }
            showEnabledCategories()
        }

        function showEnabledCategories() {
            const current_value = document.querySelector('#integrated_content_relations_categories').value.split(',').filter(n => n)
            const categories_checkboxes = document.querySelectorAll('#categories_checkboxes div')
            document.getElementById('enabled_categories').innerHTML = "";
            for (checkbox of categories_checkboxes) {
                if (current_value.includes( checkbox.querySelector('input').dataset.id)) {
                    appendThisToThat(checkbox.dataset.fulltitle, "enabled_categories")
                }
            }
        }

        function appendThisToThat(thiss, that) {
            const node = document.createElement("span");
            node.classList.add('bg-blue-200', 'rounded-full', 'border', 'border-grey', 'p-2', 'm-2', 'text-xl');
            const textnode = document.createTextNode(thiss);
            node.appendChild(textnode);
            document.getElementById(that).appendChild(node);
        }

        function enableCheckboxes(enabled_channels) {
            const current_value = document.querySelector('#integrated_content_relations_categories').value.split(',').filter(n => n)
            const categories_checkboxes = document.querySelectorAll('#categories_checkboxes div input')
            for (checkbox of categories_checkboxes) {
                let state = checkbox.value
                if (current_value.includes( checkbox.dataset.id)) {
                    checkbox.checked = true
                }
            }
        }

        function alterState(event) {
            states[event.target.value] = !states[event.target.value]

            if (enabled_states.includes(event.target.value)) {
                enabled_states = enabled_states.filter(item => item != event.target.value)
            } else {
                enabled_states.push(event.target.value)
            }

            filterCheckboxes()
        }

        function filterCheckboxes() {
            const PARENT_OR_CHILD = 'parent'
            const categories_checkboxes = document.querySelectorAll('#categories_checkboxes div')
            for (checkbox of categories_checkboxes) {
                let show_category = enabled_states.length == 0 || false

                if (enabled_states.length != 0) {
                    if (PARENT_OR_CHILD == 'child') {
                        for (channel of checkbox.dataset.channels.split(",").filter(n => n)) {
                            if (enabled_states.includes(channel)) {
                                show_category = true
                                break;
                            }
                        }
                    } else if (PARENT_OR_CHILD == 'parent') {
                        for (channel of checkbox.dataset.parentchannels.split(",").filter(n => n)) {
                            if (enabled_states.includes(channel)) {
                                show_category = true
                                break;
                            }
                        }
                    }
                }

                if (show_category == true) {
                    checkbox.classList.remove('hidden')
                } else {
                    checkbox.classList.add('hidden')
                }
            }

        }
    </script>

