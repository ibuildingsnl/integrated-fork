{% extends '@IntegratedContent/base.html.twig' %}
{% block title %}{% trans %}Edit{% endtrans %} {{ type.name|trans }}{% endblock title %}

{% block content %}
    {% if 'Article' in type.class or 'News' in type.class or 'Comment' in type.class or 'Product' in type.class or 'Company' in type.class %}
        {# https://eactive.atlassian.net/browse/INTEGRATED-1783 #}
        {% set title_state = 'title_tinymce' %}
        {% set title_style = '' %}
        {% set tinymce_state = 'fancy_tinymce' %}
        {% set form_class = 'content-edit-form' %}
    {% else %}
        {% set title_state = '' %}
        {% set title_style = 'inline' %}
        {% set tinymce_state = 'show' %}
        {% set form_class = 'edit-form' %}
    {% endif %}

    {% block filters %}
        <div class="filters_row"></div>
    {% endblock %}

    <div class="flex flex-wrap {{ form_class }}">
        {% block form_start %}
            {{ form_start(form, { 'style': 'horizontal' }) }}
        {% endblock %}
        {% block toolbar %}
            {% include '@IntegratedContent/partials/block.toolbar.html.twig' %}
        {% endblock toolbar %}
        <div class="aside-options">
            <aside>
                <div class="aside-holder section-gray section-radius">
                    {% block sidebar %}
                        <div class="aside-item-wrapper show">
                            <div class="aside-item-header">
                                <h3 class="aside-item-title">
                                    <i class="iconoir-info-empty"></i>
                                    <span class="aside-item-icon">{% trans %}Status{% endtrans %}</span>
                                </h3>
                                <i class="iconoir-nav-arrow-up"></i>
                            </div>
                            <div class="aside-item-list">
                                <div class="aside-item-list-container">
                                    <div class="status-info">
                                        {% if form.publishTime is defined %}
                                            {{ form_row(form.publishTime, {style: 'inline'}) }}
                                        {% endif %}
                                    </div>
                                    <div class="status-options">
                                        {% if (content is defined and ((content.isPublished and content.getChannels|length > 0) or content.published == 'true')) %}
                                            <div class="status published">
                                                <i class="iconoir-check-circled-outline"></i> {% trans %}Published{% endtrans %}
                                            </div>
                                            <a class="delete"
                                               href="{{ path('integrated_content_content_delete', {'id': content.id}) }}">
                                                <i class="iconoir-trash"></i>
                                            </a>
                                        {% elseif (content is defined and ('now'|date('U') < content.publishTime.startDate |date('U'))) %}
                                            <div class="status planned">
                                                <i class="iconoir-calendar"></i> {% trans %}Planned{% endtrans %}
                                            </div>
                                        {% else %}
                                            <div class="status draft">
                                                <i class="iconoir-design-pencil"></i> {% trans %}Draft{% endtrans %}
                                            </div>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="aside-item-wrapper" id="used-by">

                        </div>

                        {% block content_history %}
                            {% if showContentHistory %}
                                {{ render(controller('Integrated\\Bundle\\ContentHistoryBundle\\Controller\\ContentHistoryController::history', { 'content': content })) }}
                            {% endif %}
                        {% endblock %}

                        {% block content_meta %}
                            {# //TODO: https://eactive.atlassian.net/browse/INTEGRATED-1781 #}
                            {% if form.channels is defined %}
                                {{ form_row(form.channels, {'style': 'sidebar', 'icon':'network-alt', 'state': 'show search'}) }}
                            {% endif %}

                            {% if form.slug is defined %}
                                {{ form_row(form.slug, {'style': 'sidebar', 'icon':'link'}) }}
                            {% endif %}

                            <!-- If description is available and Content is also, show it in the sidebar -->
                            {% if form.content is defined %}
                                {% if form.description is defined %}
                                    {{ form_row(form.description, {'style': 'sidebar', 'icon':'message-text'}) }}
                                {% endif %}
                            {% endif %}

                            {% if form.address is defined %}
                                {{ form_row(form.address, {'style': 'sidebar', 'icon':'pin-alt'}) }}
                            {% endif %}

                            {% if form.copyrightRestrictions is defined %}
                                {{ form_row(form.copyrightRestrictions, {'style': 'sidebar', 'icon':'copyright'}) }}
                            {% endif %}

                            {% if form.authors is defined %}
                                {{ form_row(form.authors, {'style': 'sidebar', 'icon':'user', 'widget_col': '', 'label_col':''}) }}
                            {% endif %}

                            {% if form.source is defined %}
                                {{ form_row(form.source, {'style': 'sidebar', 'icon':'megaphone'}) }}
                            {% endif %}

                            {% if form.sourceUrl is defined %}
                                {{ form_row(form.sourceUrl, {'style': 'sidebar', 'icon':'open-new-window'}) }}
                            {% endif %}

                            {% if form.relations is defined %}
                                {{ form_row(form.relations, {'style': 'sidebar', 'icon':'network-right'}) }}
                            {% endif %}

                            {% if form.logo is defined %}
                                {{ form_row(form.logo, {'style': 'sidebar', 'icon':'media-image'}) }}
                            {% endif %}

                            {% if form.rank is defined %}
                                {{ form_row(form.rank, {'style': 'sidebar', 'icon':'numbered-list-left'}) }}
                            {% endif %}

                            {% if form.disabled is defined %}
                                {{ form_row(form.disabled, {'style': 'sidebar', 'icon':'do-not-enter'}) }}
                            {% endif %}
                        {% endblock %}

                        {% block content_relations %}
                            {% if form.offsetGet('relations').count() %}
                                <input type="hidden" id="default_references" value="{{ references }}">
                                {% for relation in form.relations %}
                                    {% if relation.vars.attr['data-location'] == 'sidebar' %}
                                        <div class="aside-item-wrapper relations">
                                            <div>header 2</div>
                                            <div class="aside-item-header">
                                                <h3 class="aside-item-title">
                                                    <i class="iconoir-{{ relation.vars.attr['data-icon'] }}"></i>
                                                    <label
                                                            class="aside-item-icon"
                                                            for="{{ relation.vars.name }}">{{ relation.vars.attr['data-title'] }}</label>
                                                </h3>
                                                <i class="iconoir-nav-arrow-up"></i>
                                            </div>
                                            <div class="aside-item-list">
                                                <div class="aside-item-list-container relation">
                                                    <div class="input-group relative flex items-stretch w-full">
                                                        {#                                                        {% if data-relation =   %} #}
                                                        {{ dump(relation) }}
                                                        <select
                                                                multiple
                                                                id="{{ relation.vars.name }}"
                                                                data-multiple="{{ relation.vars.attr['data-multiple'] }}"
                                                                data-types="{{ relation.vars.attr['data-types'] }}"
                                                                data-url="{{ path('integrated_content_content_index', {'_format': 'json'}) }}"
                                                                data-url-new="{{ path('integrated_content_content_new', {'type': '__type__', 'relation': '__relation__', '_format': 'iframe.html'}) }}"
                                                                class="relation-items form-control"
                                                                style="display: none; width: 89%">
                                                        </select>
                                                        <span class="input-group-addon" data-add="1"></span>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    {% endif %}
                                {% endfor %}
                            {% endif %}
                        {% endblock %}
                    {% endblock %}
                </div>
            </aside>
        </div>
        <div class="editor-wrapper">
            <section class="editor">
                {% block content_form %}
                    {# //TODO: https://eactive.atlassian.net/browse/INTEGRATED-1781 #}
                    {% if form.title is defined %}
                        {{ form_row(form.title, {'state': title_state, 'style': title_style}) }}
                    {% elseif form.name is defined %}
                        {{ form_row(form.name, {'state': title_state, 'style': title_style}) }}
                    {% endif %}

                    {% if form.content is defined %}
                        {{ form_row(form.content, {'style':'editor','state':tinymce_state}) }}
                    {% elseif form.description is defined %}
                        {{ form_row(form.description, {'style':'editor','state':tinymce_state}) }}
                    {% elseif form.comment is defined %}
                        {{ form_row(form.comment, {'style':'editor','state':tinymce_state}) }}
                    {% endif %}

                    {% if form.file is defined %}
                        {{ form_row(form.file, {'style':'editor', 'state': 'show'}) }}
                    {% endif %}

                    {% if form.subtitle is defined %}
                        {{ form_row(form.subtitle, {'style':'editor', 'state': 'show'}) }}
                    {% endif %}

                    {% if form.intro is defined %}
                        {{ form_row(form.intro, {'style':'editor', 'state': 'show'}) }}
                    {% endif %}

                    {{ form_rest(form, {'style':'editor', 'state':'show'}) }}
                {% endblock %}

                {% block content_relations_editor %}
                    {% if form.offsetGet('relations').count() %}
                        <input type="hidden" id="default_references" value="{{ references }}">
                        {% for relation in form.relations %}
                            {% if relation.vars.attr['data-location'] != 'sidebar' %}
                                {% if relation.vars.attr['data-relationtype'] != 'mmsingle' %}
                                    <div class="editor-item-wrapper relations">
                                        <div class="editor-item-header">
                                            <h3 class="editor-item-title">
                                                <i class="iconoir-{{ relation.vars.attr['data-icon'] }}"></i>
                                                <label
                                                        class="editor-item-icon"
                                                        for="{{ relation.vars.name }}">{{ relation.vars.attr['data-title'] }}</label>
                                            </h3>
                                            <i class="iconoir-nav-arrow-up"></i>
                                        </div>
                                        <div class="editor-item-list">
                                            <div class="editor-item-list-container relation">
                                                <div class="input-group relative flex items-stretch w-full">
                                                    <select
                                                            multiple
                                                            id="{{ relation.vars.name }}"
                                                            data-multiple="{{ relation.vars.attr['data-multiple'] }}"
                                                            data-types="{{ relation.vars.attr['data-types'] }}"
                                                            data-url="{{ path('integrated_content_content_index', {'_format': 'json'}) }}"
                                                            data-url-new="{{ path('integrated_content_content_new', {'type': '__type__', 'relation': '__relation__', '_format': 'iframe.html'}) }}"
                                                            class="relation-items form-control"
                                                            style="display: none; width: 89%">
                                                    </select>
                                                    <span class="input-group-addon" data-add="1"></span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                {% else %}
                                    <div class="mediagallery_selector m-12" id="{{ relation.vars.attr['data-relation'] }}">
                                        <div
                                            data-multiple="{{ relation.vars.attr['data-multiple'] }}"
                                            data-types="{{ relation.vars.attr['data-types'] }}"
                                            data-relationtype="{{ relation.vars.attr['data-relationtype'] }}"
                                            data-relationid="{{ relation.vars.attr['data-relation'] }}"
                                            class="select_multimedia_button p-2 bg-blue-200 border border-black w-32 mb-4">Selecteer
                                        een afbeelding. Multiple = {{ relation.vars.attr['data-multiple'] ? 'select_multiple' : 'select_one' }}
                                        </div>

                                        <div class="wrap mb-4" style="display: none;">
                                            <iframe class="iframe" src="" width="1500" height="500">
                                            </iframe>
                                        </div>

                                        <div class="mb-2">Geselecteerde afbeelding{{ relation.vars.attr['data-multiple'] ? 'en' : '' }}:</div>

                                        <div class="selected_images flex flex-wrap mb-4"></div>

                                        <input type="text" class="w-full integrated_content_media_gallery_image_file"
                                               name="integrated_content[media_gallery_image][file]"
                                               placeholder="123425edfewadfqew1243142r">

                                    </div>
                                {% endif %}`
                            {% endif %}
                        {% endfor %}

{#                        This element will be copied for every image#}
                        <li id="selected_image" class="hidden media-item ui-widget-content ui-corner-tr grid w-1/4">
                            <div class="media-preview">
                                <div class="thumbnail">
                                    <div class="centered">
                                        <img src="">
                                    </div>
                                    <div class="remove_link bg-red-200 p-2 border border-black">Remove me</div>
                                </div>
                            </div>
                        </li>

                        <script>
                            let form_relations = {} //this holds all the form relation objects with an id
                            let form_relation = {} //these will be placed in form_relations
                            const mediagallery_link = "/admin/media/"
                            let selected_relation = '' //after a user clicks on a form button, the clicked form element is selected

                            addEventListeners()
                            populateFormRelations()
                            generateSrcAttributeForIframes()

                            function populateFormRelations() {
                                document.querySelectorAll('.mediagallery_selector').forEach((item) => {
                                    const id = item.getAttribute('id')
                                    form_relations[id] = {
                                        modus: item.querySelector('.select_multimedia_button').dataset.multiple ? 'select_multiple' : 'select_one',
                                        selected_images: [],
                                        relationid: id,
                                        types: JSON.parse(item.querySelector('.select_multimedia_button').dataset.types),
                                        input_selector: '#' + id + ' input',
                                        selected_images_selector: '#' + id + ' .selected_images',
                                        wrap_selector: '#' + id + ' .wrap',
                                        iframe_selector: '#' + id + ' iframe'
                                    }
                                })
                            }

                            function generateSrcAttributeForIframes() {
                                Object.values(form_relations).forEach(form_relation => {
                                    document.querySelector(form_relation.iframe_selector).setAttribute('src', mediagallery_link + form_relation.modus)
                                });
                            }

                            function addEventListeners() {
                                document.querySelectorAll('.select_multimedia_button').forEach((item) => {
                                    item.addEventListener('click', function (even) {
                                        showMediaGallery(event, item)
                                    }, false);
                                })
                            }

                            function removeImage(event) {
                                const closest_image_id = event.target.closest('li').id
                                const closest_media_gallery_selector = event.target.closest('.mediagallery_selector').id
                                selected_relation = form_relations[closest_media_gallery_selector]
                                selected_relation.selected_images = selected_relation.selected_images.filter(item => item.id !== closest_image_id)
                                rebuildDOM()
                            }

                            function createClone(selectedImage) {
                                let clone = $("#selected_image").clone(true, true);
                                let clone_img = clone.find('img')
                                let remove_link = clone.find('.remove_link')
                                clone.attr('id', selectedImage.id)
                                clone.removeClass('hidden')
                                clone_img.attr("src", selectedImage.thumbnail)
                                remove_link.attr("onclick", "removeImage(event)")
                                remove_link.innerHTML = "New Heading";
                                return clone
                            }

                            function placeClone(clone) {
                                if (selected_relation.modus == 'select_one') {
                                    $(selected_relation.selected_images_selector).empty()
                                    $(selected_relation.selected_images_selector).append(clone)
                                } else if (selected_relation.modus == 'select_multiple') {
                                    $(selected_relation.selected_images_selector).append(clone)
                                }
                            }

                            function filterImages(selection) {
                                return selection.filter(item => item.content_type == 'image')
                            }

                            function addImageIDsToInputField() {
                                const image_ids_as_json = JSON.stringify(selected_relation.selected_images.map(item => item.id))
                                $(selected_relation.input_selector).attr('value', image_ids_as_json)
                            }

                            function emptyShownImagesInDOM() {
                                $(selected_relation.selected_images_selector).empty()
                            }

                            function selectImagesToShow(response_from_iframe) {
                                if (selected_relation.modus == 'select_one') {
                                    selected_relation.selected_images = response_from_iframe
                                } else {
                                    //concat AND filter for unique values:
                                    selected_relation.selected_images = [...selected_relation.selected_images, ...response_from_iframe].filter((v, i, a) => a.findIndex(v2 => (v2.id === v.id)) === i)
                                }
                            }

                            function populateDOMWithImages() {
                                selected_relation.selected_images.forEach((item) => {
                                    const clone = createClone(item)
                                    placeClone(clone)
                                })
                            }

                            window.addEventListener('message', function (e) {
                                const response_from_iframe = filterImages(JSON.parse(e.data))
                                if (response_from_iframe.length > 0) {
                                    selectImagesToShow(response_from_iframe)
                                    rebuildDOM()
                                    closeMediaGallery()
                                } else {
                                    console.log("no image selected")
                                }
                            });

                            function rebuildDOM() {
                                emptyShownImagesInDOM()
                                populateDOMWithImages()
                                addImageIDsToInputField()
                            }

                            function closeMediaGallery() {
                                reloadMediaLibrary()
                                $(selected_relation.wrap_selector).hide()
                                $('.select_multimedia_button').show()
                            }

                            function reloadMediaLibrary() {
                                $(selected_relation.iframe_selector).attr('src', function (i, val) {return val;});
                            }

                            function showMediaGallery(event, item) {
                                selected_relation = form_relations[item.dataset.relationid]
                                $(selected_relation.wrap_selector).show()
                                $('.select_multimedia_button').hide()
                            }
                        </script>

                        <style>
                            .mediagallery_selector .wrap {
                                width: 2000px;
                                height: 900px;
                                padding: 0;
                                overflow: hidden;
                            }

                            .mediagallery_selector .iframe {
                                width: 2000px;
                                height: 900px;
                                border: 1px solid black;
                            }

                            .mediagallery_selector .iframe {
                                -ms-zoom: 0.75;
                                -moz-transform: scale(0.75);
                                -moz-transform-origin: 0 0;
                                -o-transform: scale(0.75);
                                -o-transform-origin: 0 0;
                                -webkit-transform: scale(0.75);
                                -webkit-transform-origin: 0 0;
                            }
                        </style>

                    {% endif %}
                {% endblock content_relations_editor %}
            </section>
        </div>


        {% block form_end %}
            {{ form_end(form) }}
        {% endblock %}
    </div>

    {% autoescape 'js' %}
        {% verbatim %}
            <script id="add-template" type="text/xhandlebars-template">
                {{#if relations}}
                {{#equals relations.length 1}}
                    <button data-title="Add {{relations.0.name}}" class="add-relation" data-href="{{relations.0.href}}" data-modal="add-modal">
                        Add {{relations.0.name}}
                        <span class="sr-only">{% endverbatim %}{% trans %}Add New{% endtrans %}{% verbatim %}:</span>
                    </button>
                {{else}}
                <div class="add-relation">
                    <button type="button" class=" inline-block w-0 h-0 ml-1 align border-b-0 border-t-1 border-r-1 border-l-1 font-size-13" data-toggle="dropdown" aria-expanded="false">
                        <i class="iconoir-plus"></i>
                        <span class="sr-only">{% endverbatim %}{% trans %}Add New{% endtrans %}{% verbatim %}:</span>
                    </button>
                    <ul class=" dropdown-menu" role="menu">
                        {{#each relations}}
