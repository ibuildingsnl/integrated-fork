{% extends '@IntegratedContent/base.html.twig' %}
{% block title %}
    {% if content.title is defined and content.title is not null %}
        {% trans %}Edit{% endtrans %} {{ content.title }}
    {% else %}
        {% trans %}Edit{% endtrans %} {{ type.name|trans }}
    {% endif %}
{% endblock title %}

{% block content %}
    <div id="content-edit-page">
        {% block filters %}
            <div class="filters_row"></div>
        {% endblock %}

        <div class="flex flex-wrap content-edit-form">
            {% set isContentLocked = locking is defined and locking.locked and not (locking.pending|default(false)) %}
            {% block form_start %}
                {{ form_start(form, { attr: { 'data-turbo-stream': 'true' } }) }}
            {% endblock %}
            {% block toolbar %}
                {% include '@IntegratedContent/partials/block.toolbar.html.twig' %}
            {% endblock toolbar %}
            {% if isContentLocked %}
                <div class="content-lock-overlay" data-content-lock-overlay>
                    <div class="content-lock-overlay__message">
                        {% trans %}This item is currently locked and cannot be edited until the lock is released.{% endtrans %}
                    </div>
                </div>
            {% endif %}
            <div class="aside-options">
                <aside>
                    <div class="aside-holder">
                        {% block sidebar %}
                            <div class="aside-header">
                                <button class="toggle-filters toggle-options-sidebar" data-target="aside-options"
                                        type="button">
                                    <i class="iconoir-xmark"></i></button>
                                <span>{% trans %}Options{% endtrans %}</span>
                            </div>
                            <div class="aside-item-wrapper show">
                                <div class="aside-item-header">
                                    <h3 class="aside-item-title">
                                        <i class="iconoir-info-circle"></i>
                                        <span class="aside-item-icon">{% trans %}Status{% endtrans %}</span>
                                    </h3>
                                    <i class="iconoir-nav-arrow-up"></i>
                                </div>
                                <div class="aside-item-list">
                                    <div class="aside-item-list-container">
                                        <div class="status-info">
                                            {% if form.publishTime is defined %}
                                                {{ form_row(form.publishTime, {style: 'inline'}) }}
                                            {% endif %}
                                        </div>
                                        <div class="workflow-info">
                                            {% if form.extension_workflow is defined %}
                                                {{ form_row(form.extension_workflow, {style: 'inline', 'show_label': 'true'}) }}
                                            {% endif %}
                                        </div>
                                        {% if content is defined and content.extensions['integrated.extension.workflow']['state'] is defined %}
                                            {% set workflow = content.extensions['integrated.extension.workflow']['state'] %}
                                        {% endif %}
                                        <div class="status-options">
                                            {% if workflow is defined and ('now'|date('U') > content.publishTime.startDate|date('U')) %}
                                                <div class="status {{ workflow.name|lower }}"
                                                     style="background-color:{{ workflow.color|alpha(15) }};color:{{ workflow.color }};">
                                                    <i class="iconoir-{{ workflow.icon }}"></i> {{ workflow.name }}
                                                </div>
                                            {% elseif (content is defined and ('now'|date('U') < content.publishTime.startDate|date('U'))) %}
                                                <div class="status planned">
                                                    <i class="iconoir-calendar"></i> {% trans %}Planned{% endtrans %}
                                                </div>
                                            {% else %}
                                                {% if (content is defined and ((content.isPublished and content.getChannels|length > 0) or content.published == 'true')) %}
                                                    <div class="status published">
                                                        <i class="iconoir-check-circle"></i> {% trans %}Published{% endtrans %}
                                                    </div>
                                                {% elseif (content is defined and ('now'|date('U') < content.publishTime.startDate|date('U'))) %}
                                                    <div class="status planned">
                                                        <i class="iconoir-calendar"></i> {% trans %}Planned{% endtrans %}
                                                    </div>
                                                {% else %}
                                                    <div class="status draft">
                                                        <i class="iconoir-design-pencil"></i> {% trans %}Draft{% endtrans %}
                                                    </div>
                                                {% endif %}
                                            {% endif %}
                                            {% if content is defined %}
                                                {% if locking is defined and locking.lock is defined and locking.lock is not null and locking.locked == false %}
                                                    <a class="delete"
                                                       href="{{ path('integrated_content_content_delete', {'id': content.id, 'lock': locking.lock.id}) }}">
                                                        <i class="iconoir-trash"></i>
                                                    </a>
                                                {% else %}
                                                    <a class="delete"
                                                       href="{{ path('integrated_content_content_delete', {'id': content.id}) }}">
                                                        <i class="iconoir-trash"></i>
                                                    </a>
                                                {% endif %}
                                            {% endif %}
                                        </div>
                                        <div class="mt-2">
                                            {% if form.disabled is defined %}
                                                {{ form_row(form.disabled) }}
                                            {% endif %}
                                            {% if form.orderable is defined %}
                                                {{ form_row(form.orderable) }}
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>
                            </div>


                            <div class="aside-item-wrapper publications">
                                <div class="aside-item-header">
                                    <h3 class="aside-item-title">
                                        <i class="iconoir-share-android"></i>
                                        <span class="aside-item-icon">{% trans %}Publications{% endtrans %}
                                                <span class="pub-count">({{ publications|default('')|length }})</span>
                                            </span>
                                    </h3>
                                    <i class="iconoir-nav-arrow-up"></i>
                                </div>
                                <div class="aside-item-list">
                                    <div class="aside-item-list-container">
                                        <div class="publication-list">
                                            {% if publications is defined and publications is not empty and (content.published == 'true' or ('now'|date('U') < content.publishTime.startDate|date('U'))) %}
                                                {% for publication in publications %}
                                                    {% set pubChannel = publication.getChannel %}
                                                    {% if pubChannel.getType is defined and pubChannel.getType is not null %}
                                                        {% set brandName = pubChannel|integrated_brand_profile.name|default('Unknown') %}
                                                        {% set pubIcon = pubChannel.getType.getIcon %}
                                                        {% set pubState = 'published' %}
                                                        {% if ('now'|date('U') < publication.getTime.getStartDate|date('U')) %}
                                                            {% set pubState = 'planned' %}
                                                        {% endif %}
                                                        {% if publication.getStatus() == 'failed' %}
                                                            {% set pubState = 'failed' %}
                                                        {% elseif publication.getStatus == 'succes' %}
                                                            {% set pubState = 'published no-edit' %}
                                                        {% endif %}
                                                        <a class="publication-item {{ pubState }}"
                                                           data-id="{{ publication.getId }}"
                                                           {% if publication.getStatus != 'success' %}data-channel="{{ publication.getChannel.getId }}"{% endif %}
                                                            {% if publication.getStatus == 'success' %}data-publication-status="success"{% endif %}>
                                                            <div class="publication-wrap">
                                                                <div class="publication-item-heading">
                                                                    <div class="heading-left">
                                                                        <i class="icon iconoir-{{ pubIcon }}"
                                                                           title="{{ pubChannel.getType.getName }}"></i>
                                                                        <span
                                                                            class="publish-time">{{ publication.getTime.getStartDate|default(content.publishTime.startDate)|date('d-m-Y H:i') }}</span>
                                                                    </div>
                                                                    <div class="heading-right">
                                                                        {% if publication.getStatus() == 'success' %}
                                                                            <i class="icon iconoir-check"
                                                                               title="Published to Channel"></i>
                                                                        {% else %}
                                                                            <i class="icon iconoir-xmark" title="remove"
                                                                               data-channel="{{ publication.getChannel.getId }}"></i>
                                                                        {% endif %}
                                                                    </div>
                                                                </div>
                                                                <div class="publication-item-content">
                                                                    <b>{{ brandName }} {{ pubChannel.getType.getName }}</b><br>
                                                                </div>
                                                                {% if publication.getStatus() == 'failed' %}
                                                                    <div class="publication-error">
                                                                        {{ publication.getResponse()|default('') }}
                                                                    </div>
                                                                {% endif %}
                                                            </div>
                                                        </a>
                                                    {% endif %}
                                                {% endfor %}
                                            {% endif %}
                                        </div>
                                        <p class="publication-info">{% trans %}Removing a published Social Media publication will not remove it from the respected platform. Removing a planned (purple) publication will stop it from publishing to that Social Media Channel{% endtrans %}</p>
                                    </div>
                                </div>
                            </div>


                            {% block content_options %}
                                {% set options = false %}
                                {% for child in form|filter(row => row.vars.attr.location|default == constant('Integrated\\Common\\Form\\Mapping\\Attributes\\Field::LOCATION_OPTIONS')) %}
                                    {% set options = true %}
                                {% endfor %}
                                {% if form.children.customFields is defined %}
                                    {% for field in form.children.customFields|filter(f => f.vars.attr.location|default == constant('Integrated\\Common\\Form\\Mapping\\Attributes\\Field::LOCATION_OPTIONS')) %}
                                        {% set options = true %}
                                    {% endfor %}
                                {% endif %}
                                {% if options == true %}
                                    <div class="aside-item-wrapper">
                                        <div class="aside-item-header">
                                            <h3 class="aside-item-title">
                                                <i class="iconoir-settings"></i>
                                                <span
                                                    class="aside-item-icon">{% trans %}Content Options{% endtrans %}</span>
                                            </h3>
                                            <i class="iconoir-nav-arrow-up"></i>
                                        </div>
                                        <div class="aside-item-list">
                                            <div class="aside-item-list-container">
                                                {% for child in form|filter(row => row.vars.attr.location|default == constant('Integrated\\Common\\Form\\Mapping\\Attributes\\Field::LOCATION_OPTIONS')) %}
                                                    {{ form_row(child) }}
                                                {% endfor %}
                                                {% block custom_sidebar_fields %}
                                                    {% if form.children.customFields is defined %}
                                                        {% for field in form.children.customFields|filter(f => f.vars.attr.location|default == constant('Integrated\\Common\\Form\\Mapping\\Attributes\\Field::LOCATION_OPTIONS')) %}
                                                            {{ form_row(field) }}
                                                        {% endfor %}
                                                    {% endif %}
                                                {% endblock %}
                                            </div>
                                        </div>
                                    </div>
                                {% endif %}
                            {% endblock %}


                            <div class="aside-item-wrapper" id="used-by"></div>

                            {% block content_history %}
                                {% if showContentHistory %}
                                    {{ render(controller('Integrated\\Bundle\\ContentHistoryBundle\\Controller\\ContentHistoryController::history', { 'content': content })) }}
                                {% endif %}
                            {% endblock %}

                            {% block content_meta %}
                                {% for child in form|filter(row => row.vars.attr.location|default == constant('Integrated\\Common\\Form\\Mapping\\Attributes\\Field::LOCATION_SIDEBAR')) %}
                                    {{ form_row(child) }}
                                {% endfor %}
                            {% endblock %}

                            {% block content_relations %}
                                {% if form.offsetGet('relations').count() %}
                                    <input type="hidden" id="default_references" value="{{ references }}">
                                    {% for relation in form.relations %}
                                        {% if relation.vars.attr['data-location'] == 'sidebar' %}

                                            <div class="aside-item-wrapper relations">
                                                <div class="aside-item-header">
                                                    <h3 class="aside-item-title">
                                                        <i class="iconoir-{{ relation.vars.attr['data-icon'] }}"></i>
                                                        <label
                                                            class="aside-item-icon"
                                                            for="{{ relation.vars.name }}">{{ relation.vars.attr['data-title'] }}</label>
                                                    </h3>
                                                    <i class="iconoir-nav-arrow-up"></i>
                                                </div>
                                                <div class="aside-item-list">

                                                    <div class="aside-item-list-container relation">
                                                        {% if relation.vars.attr['data-relationtype'] == 'embedded' %}
                                                            {% include '@IntegratedContent/media/partial/select_component.html.twig' with {
                                                                relation: relation,
                                                                form_relations: formRelations|default(null),
                                                            } %}

                                                        {% elseif relation.vars.attr['data-relationtype'] == 'taxonomy_category' %}
                                                            {% include '@IntegratedContent/content/partial/category_selection_component.html.twig' %}

                                                        {% else %}
                                                            <select
                                                                multiple
                                                                id="{{ relation.vars.name }}"
                                                                data-multiple="{{ relation.vars.attr['data-multiple'] }}"
                                                                data-types="{{ relation.vars.attr['data-types'] }}"
                                                                data-url="{{ path('integrated_content_content_index', {'_format': 'json'}) }}"
                                                                data-url-new="{{ path('integrated_content_content_new', {'type': '__type__', 'relation': '__relation__', '_format': 'iframe.html'}) }}"
                                                                class="relation-items form-control"
                                                                style="display: none; width: 89%">
                                                            </select>
                                                            <span class="input-group-addon" data-add="1"></span>
                                                        {% endif %}
                                                    </div>
                                                </div>
                                            </div>
                                        {% endif %}
                                    {% endfor %}
                                {% endif %}
                            {% endblock %}
                        {% endblock %}
                    </div>
                </aside>
            </div>
            <div class="editor-wrapper">
                <div class="editor-overlay"></div>
                <section class="editor">
                    {% block content_form %}
                        {% for child in form|filter(row => row.vars.attr.location|default == constant('Integrated\\Common\\Form\\Mapping\\Attributes\\Field::LOCATION_EDITOR')) %}
                            {{ form_row(child) }}
                        {% endfor %}

                        {% if form.children.customFields is defined %}
                            {% for field in form.children.customFields %}
                                {% if not field.rendered %}
                                    {{ form_row(field, {'style':'editor', 'state':'show'}) }}
                                {% endif %}
                            {% endfor %}
                        {% endif %}

                        {{ form_rest(form, {'style':'editor', 'state':'show'}) }}
                    {% endblock %}

                    {% block content_relations_editor %}
                        {% if form.offsetGet('relations').count() %}
                            <input type="hidden" id="default_references" value="{{ references }}">
                            {% for relation in form.relations %}
                                {% if relation.vars.attr['data-location'] != 'sidebar' %}
                                    <div class="editor-item-wrapper relations">
                                        <div class="editor-item-header">
                                            <h3 class="editor-item-title">
                                                <label
                                                    class="editor-item-icon"
                                                    for="{{ relation.vars.name }}">{{ relation.vars.attr['data-title'] }}</label>
                                            </h3>
                                            <i class="iconoir-nav-arrow-up"></i>
                                        </div>
                                        <div class="editor-item-list">
                                            <div class="editor-item-list-container relation">


                                                {% if relation.vars.attr['data-relationtype'] == 'embedded' %}
                                                    {% include '@IntegratedContent/media/partial/select_component.html.twig' with {
                                                        relation: relation,
                                                        form_relations: formRelations|default(null),
                                                    } %}
                                                {% elseif relation.vars.attr['data-relationtype'] == 'taxonomy_category' %}
                                                    {% include '@IntegratedContent/content/partial/category_selection_component.html.twig' %}
                                                {% else %}
                                                    <select
                                                        multiple
                                                        id="{{ relation.vars.name }}"
                                                        data-multiple="{{ relation.vars.attr['data-multiple'] }}"
                                                        data-types="{{ relation.vars.attr['data-types'] }}"
                                                        data-url="{{ path('integrated_content_content_index', {'_format': 'json'}) }}"
                                                        data-url-new="{{ path('integrated_content_content_new', {'type': '__type__', 'relation': '__relation__', '_format': 'iframe.html'}) }}"
                                                        class="relation-items form-control"
                                                        style="display: none; width: 89%">
                                                    </select>
                                                    <span class="input-group-addon" data-add="1"></span>
                                                {% endif %}
                                            </div>
                                        </div>
                                    </div>
                                {% endif %}
                            {% endfor %}

                        {% endif %}
                    {% endblock content_relations_editor %}
                </section>
            </div>


            {% block form_end %}
                {{ form_end(form) }}
            {% endblock %}
        </div>

        {% autoescape 'js' %}
            {% verbatim %}
                <script id="add-template" type="text/xhandlebars-template">
                    {{#if relations}}
                    {{#equals relations.length 1}}
                        <button data-title="Add {{relations.0.name}}" class="add-relation" data-href="{{relations.0.href}}" data-modal="add-modal">
                            Add {{relations.0.name}}
                            <span class="sr-only">{% endverbatim %}{% trans %}Add New{% endtrans %}{% verbatim %}:</span>
                        </button>
                    {{else}}
                    <div class="add-relation">
                        <button type="button" class=" inline-block w-0 h-0 ml-1 align border-b-0 border-t-1 border-r-1 border-l-1 font-size-13" data-toggle="dropdown" aria-expanded="false">
                            <i class="iconoir-plus"></i>
                            <span class="sr-only">{% endverbatim %}{% trans %}Add New{% endtrans %}{% verbatim %}:</span>
                        </button>
                        <ul class=" dropdown-menu" role="menu">
                            {{#each relations}}
                            <li>
                                <a class="cursor-pointer" data-title="Add {{this.name}}" data-href="{{this.href}}" target="_blank" data-modal="add-modal">
                                    {{this.name}}
                                </a>
                            </li>
                            {{/each}}
                        </ul>
                     </div>
                    {{/equals}}
                    {{/if}}
                    <div class="modal add-modal" id="relation-add-modal" tabindex="-1" role="dialog" aria-labelledby="myLargeModalLabel" aria-hidden="true">
                        <div class="modal-dialog modal-lg">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <button type="button" class="close" data-dismiss="modal"><span aria-hidden="true"><i class="iconoir-xmark"></i></span><span class="sr-only">{% endverbatim %}{% trans %}Close{% endtrans %}{% verbatim %}</span></button>
                                    <h4 class="modal-title">{% endverbatim %}{% trans %}Add{% endtrans %}{% verbatim %}</h4>
                                </div>
                                <iframe width="100%" height="400">{% endverbatim %}{% trans %}Loading{% endtrans %}{% verbatim %}</iframe>
                            </div>
                        </div>
                    </div>
                </script>
            {% endverbatim %}
        {% endautoescape %}
    </div>

{% endblock %}

{% block edit_modal %}
    <div class="modal fade" id="content-edit-modal">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h4 class="modal-title">{% trans %}Unsaved changes{% endtrans %}</h4>
                </div>
                <div class="modal-body">
                    <p>{% trans %}You have unsaved changes. When you leave this page your changes will be lost.{% endtrans %}</p>
                    <p>{% trans %}Are you sure you want to leave this page?{% endtrans %}</p>
                </div>
                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-dark-green live-page">{% trans %}Leave this page{% endtrans %}</button>
                    <button type="button" class="btn btn-white"
                            data-dismiss="modal">{% trans %}Stay on page{% endtrans %}</button>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
{% block webpack_js %}
    <script src="{{ asset('bundles/integratedintegrated/edit.js') }}" defer data-turbo-track="reload"></script>
{% endblock %}

{% block javascript %}
{{ parent() }}

<script>
    (function initEditLockOnLoad() {
        var LOCK_REFRESH_URL = "{{ path('integrated_locking_api_refresh')|e('js') }}";
        var LOCK_RELEASE_URL = "{{ path('integrated_locking_api_release')|e('js') }}";
        var LOCK_POLLING_KEY = '__integratedEditLockPolling';
        var LOCK_CSRF_TOKEN = "{{ (content is defined ? csrf_token('integrated_content_lock_' ~ content.id) : '')|e('js') }}";
        var LOCKED_ITEM_MESSAGE = "{{ 'This item is currently locked and cannot be edited until the lock is released.'|trans|e('js') }}";
        var LOCK_ACQUIRE_FAILED_MESSAGE = "{{ 'The lock could not be acquired, please reload and try again.'|trans|e('js') }}";
        var lockPollingStore = window[LOCK_POLLING_KEY] || (window[LOCK_POLLING_KEY] = {});

        function renderLockMessage(message) {
            if (!message) {
                return;
            }

            if (document.querySelector('[data-edit-lock-init-message]')) {
                return;
            }

            var page = document.getElementById('content-edit-page');
            if (!page) {
                return;
            }

            var alertNode = document.createElement('div');
            alertNode.className = 'alert alert-danger';
            alertNode.setAttribute('data-edit-lock-init-message', '1');
            alertNode.textContent = message;

            page.insertBefore(alertNode, page.firstChild);
        }

        function postLockRequest(url, body, keepalive) {
            return fetch(url, {
                method: 'POST',
                credentials: 'same-origin',
                keepalive: !!keepalive,
                headers: {
                    'X-Requested-With': 'XMLHttpRequest',
                    'Accept': 'application/json',
                    'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
                },
                body: body,
            });
        }

        function setSaveButtonDisabled(disabled) {
            var saveButton = document.getElementById('integrated_content_actions_save');
            if (!saveButton) {
                return;
            }

            saveButton.disabled = !!disabled;
            saveButton.classList.toggle('disabled', !!disabled);
        }

        function setLockOverlay(form, message) {
            var wrapper = form.closest('.content-edit-form');
            if (!wrapper) {
                wrapper = form;
            }

            var overlay = wrapper.querySelector('[data-content-lock-overlay]');
            if (!overlay) {
                overlay = document.createElement('div');
                overlay.className = 'content-lock-overlay';
                overlay.setAttribute('data-content-lock-overlay', '1');

                var overlayMessage = document.createElement('div');
                overlayMessage.className = 'content-lock-overlay__message';
                overlay.appendChild(overlayMessage);

                wrapper.appendChild(overlay);
            }

            var messageNode = overlay.querySelector('.content-lock-overlay__message');
            if (messageNode) {
                messageNode.textContent = message || LOCKED_ITEM_MESSAGE;
            }
        }

        function clearLockOverlay(form) {
            var wrapper = form.closest('.content-edit-form');
            if (!wrapper) {
                wrapper = form;
            }

            var overlay = wrapper.querySelector('[data-content-lock-overlay]');
            if (overlay) {
                overlay.remove();
            }
        }

        function setFormActionLock(form, lockId) {
            var action = form.getAttribute('action');
            if (!action) {
                return;
            }

            var actionUrl = new URL(action, window.location.origin);
            actionUrl.searchParams.set('lock', String(lockId));
            form.setAttribute('action', actionUrl.pathname + actionUrl.search + actionUrl.hash);
        }

        function setDeleteActionLock(lockId) {
            var deleteLinks = document.querySelectorAll('a.delete[href]');
            for (var i = 0; i < deleteLinks.length; i++) {
                var href = deleteLinks[i].getAttribute('href');
                if (!href) {
                    continue;
                }

                var hrefUrl = new URL(href, window.location.origin);
                hrefUrl.searchParams.set('lock', String(lockId));
                deleteLinks[i].setAttribute('href', hrefUrl.pathname + hrefUrl.search + hrefUrl.hash);
            }
        }

        function replaceUrlLock(lockId) {
            var locationUrl = new URL(window.location.href);
            if (locationUrl.searchParams.get('lock') === String(lockId)) {
                return;
            }

            locationUrl.searchParams.set('lock', String(lockId));
            window.history.replaceState({}, '', locationUrl.toString());
        }

        function startLockPolling(lockId) {
            if (!lockId || lockPollingStore[lockId]) {
                return;
            }

            if (window.__integratedLockPolling && window.__integratedLockPolling[lockId]) {
                return;
            }

            var state = {
                stopped: false,
                timer: null,
            };
            lockPollingStore[lockId] = state;

            function toBody() {
                var params = new URLSearchParams();
                params.set('lock', String(lockId));

                return params.toString();
            }

            function stop() {
                if (state.stopped) {
                    return;
                }

                state.stopped = true;

                if (state.timer) {
                    window.clearTimeout(state.timer);
                    state.timer = null;
                }

                delete lockPollingStore[lockId];

                document.removeEventListener('turbo:before-cache', onBeforeCache);
                window.removeEventListener('pagehide', onPageHide);
                window.removeEventListener('beforeunload', onBeforeUnload);
            }

            function schedule() {
                if (state.stopped) {
                    return;
                }

                state.timer = window.setTimeout(refresh, 5000);
            }

            function release() {
                if (navigator.sendBeacon) {
                    try {
                        var params = new URLSearchParams();
                        params.set('lock', String(lockId));
                        navigator.sendBeacon(LOCK_RELEASE_URL, params);

                        return;
                    } catch (e) {
                    }
                }

                postLockRequest(LOCK_RELEASE_URL, toBody(), true).catch(function () {
                });
            }

            function refresh() {
                if (state.stopped) {
                    return;
                }

                postLockRequest(LOCK_REFRESH_URL, toBody(), false)
                    .then(function (response) {
                        if (response.status === 200) {
                            schedule();
                            return;
                        }

                        stop();
                    })
                    .catch(function () {
                        stop();
                    });
            }

            function onBeforeCache() {
                release();
                stop();
            }

            function onPageHide() {
                release();
                stop();
            }

            function onBeforeUnload() {
                release();
                stop();
            }

            document.addEventListener('turbo:before-cache', onBeforeCache);
            window.addEventListener('pagehide', onPageHide);
            window.addEventListener('beforeunload', onBeforeUnload);

            refresh();
        }

        function applyAcquiredLock(form, lockId, lockStoreKey) {
            if (lockStoreKey) {
                try {
                    window.sessionStorage.setItem(lockStoreKey, String(lockId));
                } catch (e) {
                }
            }

            form.setAttribute('data-lock-pending', '0');
            form.setAttribute('data-lock-id', String(lockId));
            form.setAttribute('data-content-locked', '0');
            clearLockOverlay(form);
            setFormActionLock(form, lockId);
            setDeleteActionLock(lockId);
            replaceUrlLock(lockId);
            setSaveButtonDisabled(false);
            startLockPolling(lockId);
        }

        function initLockOnLoad() {
            if (document.documentElement.hasAttribute('data-turbo-preview')) {
                return;
            }

            var form = document.querySelector('form.content-form[data-lock-init-url]');
            if (!form) {
                return;
            }

            if (form.getAttribute('data-lock-pending') !== '1') {
                var existingLockId = form.getAttribute('data-lock-id') || '';
                if (!existingLockId) {
                    return;
                }

                var urlLockId = '';
                try {
                    urlLockId = new URL(window.location.href).searchParams.get('lock') || '';
                } catch (e) {
                    urlLockId = '';
                }

                if (urlLockId === String(existingLockId)) {
                    startLockPolling(existingLockId);
                }

                return;
            }

            if (form.getAttribute('data-lock-init-attempted') === '1') {
                return;
            }

            form.setAttribute('data-lock-init-attempted', '1');
            setSaveButtonDisabled(true);

            var lockUrl = form.getAttribute('data-lock-init-url');
            if (!lockUrl) {
                setSaveButtonDisabled(false);
                return;
            }

            var contentId = form.getAttribute('data-content-id') || '';
            var lockStoreKey = contentId ? ('integrated-content-lock:' + contentId) : '';
            var knownLock = '';

            if (lockStoreKey) {
                try {
                    knownLock = window.sessionStorage.getItem(lockStoreKey) || '';
                } catch (e) {
                    knownLock = '';
                }
            }

            var requestBody = new URLSearchParams();
            if (LOCK_CSRF_TOKEN) {
                requestBody.set('_token', LOCK_CSRF_TOKEN);
            }
            if (knownLock) {
                requestBody.set('known_lock', knownLock);
            }

            postLockRequest(lockUrl, requestBody.toString(), false)
                .then(function (response) {
                    return response.json().catch(function () {
                        return {};
                    }).then(function (payload) {
                        return {
                            status: response.status,
                            payload: payload,
                        };
                    });
                })
                .then(function (result) {
                    var lockId = result && result.payload ? result.payload.lock : null;
                    if (result.status === 200 && lockId) {
                        applyAcquiredLock(form, lockId, lockStoreKey);
                        return;
                    }

                    form.setAttribute('data-content-locked', '1');
                    setLockOverlay(form, (result && result.payload && result.payload.message) || '');
                    renderLockMessage((result && result.payload && result.payload.message) || '');
                    setSaveButtonDisabled(true);
                })
                .catch(function () {
                    form.setAttribute('data-content-locked', '1');
                    setLockOverlay(form, LOCK_ACQUIRE_FAILED_MESSAGE);
                    renderLockMessage(LOCK_ACQUIRE_FAILED_MESSAGE);
                    setSaveButtonDisabled(true);
                });
        }

        document.addEventListener('DOMContentLoaded', initLockOnLoad);
        document.addEventListener('turbo:load', initLockOnLoad);
        document.addEventListener('turbo:render', initLockOnLoad);
        document.addEventListener('turbo:frame-load', initLockOnLoad);
        document.addEventListener('turbo:frame-render', initLockOnLoad);
    })();

    textarea = document.querySelector('.title_tinymce_input');
    if (textarea !== null) {
        textarea.addEventListener('input', autoResize, false);
        textarea.addEventListener('keypress', function(event) {
            if (event.key === 'Enter') {
                event.preventDefault();
            }
        });

        autoResize();

        function autoResize() {
            textarea.style.height = 'auto';

            if (textarea.scrollHeight > 0) {
                textarea.style.height = textarea.scrollHeight + 'px';
            }
        }

        window.addEventListener('tinyMCEInitialized', observeResize);

        function observeResize() {
            const observedTitle = document.querySelector('.title_tinymce_input');
            if (!observedTitle) {
                return;
            }

            const resize_ob = new ResizeObserver(function(entries) {
                if (!entries.length || !entries[0].contentRect) {
                    return;
                }

                const rect = entries[0].contentRect;
                const height = rect.height;
                const editor = document.querySelector('div.tox-edit-area');
                const wrapper = document.querySelector('div.tox-sidebar-wrap');

                if (!editor || !wrapper) {
                    return;
                }

                editor.style.top = (height) + 'px';
                wrapper.style.paddingBottom = (height) + 'px';
            });

            // start observing for resize
            resize_ob.observe(observedTitle);
        }
    }
</script>

