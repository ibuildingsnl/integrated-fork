<ul class="header-nav">
    {% set divided = false %}

    {% block navbar_assignee %}
        {% if assignedContent|length == 0 %}
            <li class="divider-nav hidden-xs"></li>
            {% set divided = true %}

            <li class="dropdown-assigned-to-me hover hidden-xs">
                <a href="#" class="btn btn-orange icon-left" data-toggle="dropdown">
                    <i class="fa-regular fa-bell"></i>
                    <span>{{ assignedContent|length }}</span>
                </a>
                <ul class="dropdown-menu-left dropdown-icons">
                    <li>
                        <div class="megamenu-content">
                            <ul class="list list-large list-border">
                                <li class="block py-2 px-6 mb-0 text-sm text-gray-800 whitespace-no-wrap">{% trans %}Assigned to me{% endtrans %}
                                    :
                                </li>
                                {% for doc in assignedContent %}
                                    <li>
                                        <a href="{{ path('integrated_content_content_edit', {id: doc.type_id}) }}">
                                            <i class="integrate-icon-plus-circled"></i>
                                            {{ doc.title|default }}
                                        </a>
                                    </li>
                                {% endfor %}
                            </ul>
                        </div>
                    </li>
                </ul>
            </li>
        {% endif %}
    {% endblock navbar_assignee %}

    {% block navbar_queue %}
        {% if queuecount > 0 and is_granted('ROLE_ADMIN') %}
            {% if divided == false %}
                <li class="divider-nav hidden-xs"></li>
            {% endif %}

            <li class="dropdown-queue hover hidden-xs">
                <a href="#" class="btn btn-green icon-left" data-toggle="dropdown">
                    <i class="fa-regular fa-database"></i>
                    <span class="">{{ queuecount }}</span>
                </a>
                <ul class="dropdown-menu-left dropdown-icons">
                    <li>
                        <div class="megamenu-content">
                            <ul class="w-full">
                                <li class="text-sm text-black">{% trans %}Background indexing{% endtrans %}...
                                <li>
                                    <div class="progress progress-striped">
                                        <div style="width: {{ queuepercentage }}%" aria-valuemax="100"
                                             aria-valuemin="0" aria-valuenow="{{ queuepercentage }}" role="progressbar"
                                             class="progress-bar progress-bar-success">
                                            <span class="font-bold">{{ queuepercentage }}%</span>
                                        </div>
                                    </div>
                                </li>
                            </ul>
                        </div>
                    </li>
                </ul>
            </li>
        {% endif %}
    {% endblock navbar_queue %}

    {% block navbar_user %}
        <li class="divider-nav hidden-xs"></li>

        {% if app.user %}
            <li class="hover dropdown-profile hidden-xs">
                <a href="#" class="flex" data-toggle="dropdown">
                    <img src="{{ avatarurl }}" class="profile-image"/>

                    <span class="welcome-msg">
                        Hallo,&nbsp;
                    </span>
                    <span class="user-name">
                        {% if app.user.getRelation.getLastname is defined %}
                            {{ app.user.getRelation.getFirstname|default('') }} {{ app.user.getRelation.getLastname|default('') }}
                        {% else %}
                            {{ app.user.username|default('') }}
                        {% endif %}
                    </span>
                    <i class="integrate-icon-down-open"></i>
                </a>

                <ul class="dropdown-menu-right">
                    <li>
                        <div class="megamenu-content">
                            <ul class="list list-large list-user">
                                <li class="user-info">
                                    <p>
                                        {% if app.user.getRelation.getEmail is defined %}
                                            <br>
                                            <small>{{ app.user.getRelation.getEmail|default('') }}</small>
                                        {% endif %}
                                    </p>
                                </li>
                                <li>
                                    <a href="{{ path('integrated_user_profile_index') }}">
                                        <i class="integrate-icon-edit"></i>{% trans %}Edit profile{% endtrans %}
                                    </a>
                                </li>
                                <li class="divider"></li>
                                <li>
                                    <a href="{{ path('integrated_user_logout') }}">
                                        <i class="integrate-icon-lock"></i>{% trans %}Log out{% endtrans %}
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </li>
                </ul>
            </li>
        {% endif %}
    {% endblock navbar_user %}
</ul>
