<ul class="header-nav">
    {% block navbar_assignee %}
        {% if app.user %}
            <li class="dropdown-assigned-to-me dropdown close-outside top-bar hidden-xs {% if assignedContent|length == 0 %}hidden{% endif %}">
                <a class="btn btn-orange icon-left" data-toggle="dropdown">
                    <i class="iconoir-bell-notification"></i>
                    <span class="js-assigned-count">{{ assignedContent|length }}</span>
                </a>
                <ul class="dropdown-menu-right dropdown-icons">
                    <li>
                        <div class="megamenu-content">
                            <ul class="list list-large list-border js-assigned-list">
                                <li class="header">
                                    {% trans %}Assigned to me{% endtrans %}:
                                </li>
                                {% for doc in assignedContent %}
                                    <li class="assigned-item">
                                        <a href="{{ doc.edit_url|default('#') }}" data-turbo-frame="_top">
                                            {% set status_color = doc.status_color|default('#6c7b89') %}
                                            {% set status_icon = doc.status_icon|default('') %}
                                            <div class="workflow-status" style="background-color:{{ status_color|alpha(12) }};border-color:{{ status_color|alpha(45) }};color:{{ status_color }};">
                                                <i class="iconoir-{{ status_icon }}"></i>
                                            </div>
                                            <span class="item-title">{{ doc.title|default }}</span>
                                        </a>
                                    </li>
                                {% endfor %}
                            </ul>
                        </div>
                    </li>
                </ul>
            </li>
        {% endif %}
    {% endblock navbar_assignee %}

    {% block navbar_queue %}
        {% if is_granted('ROLE_ADMIN') and queuecount > 0 %}
            <li class="dropdown-queue dropdown close-outside top-bar hidden-xs">
                <a class="btn btn-green icon-left" data-toggle="dropdown">
                    <i class="iconoir-database-backup"></i>
                    <span class="js-queue-count">{{ queuecount }}</span>
                </a>
                <ul class="dropdown-menu-left dropdown-icons">
                    <li>
                        <div class="megamenu-content">
                            <ul class="w-full">
                                <li class="text-sm text-black">{% trans %}Background indexing{% endtrans %}...
                                <li>
                                    <div class="progress progress-striped">
                                        <div class="progress-bar progress-bar-success js-queue-progress"
                                             style="width: {{ queuepercentage }}%"
                                             aria-valuemax="100"
                                             aria-valuemin="0"
                                             aria-valuenow="{{ queuepercentage }}"
                                             role="progressbar">
                                            <span class="font-bold js-queue-percentage">{{ queuepercentage }}%</span>
                                        </div>
                                    </div>
                                </li>
                            </ul>
                        </div>
                    </li>
                </ul>
            </li>
        {% endif %}
    {% endblock navbar_queue %}

    {% block navbar_user %}
        {% if app.user %}
            <li class="dropdown-profile dropdown close-outside top-bar hidden-xs">
                <a class="flex" data-toggle="dropdown">
                    <img src="{{ avatarurl }}" class="profile-image"/>
                    <i class="iconoir-nav-arrow-down"></i>
                </a>

                <ul class="dropdown-menu-right">
                    <li>
                        <div class="megamenu-content">
                            <ul class="user-menu w-full">
                                <li class="user-info">
                                    {% set relation = app.user.getRelation|default(null) %}
                                    {% set fullName = relation ? ((relation.getFirstname|default('') ~ ' ' ~ relation.getLastname|default(''))|trim) : '' %}
                                    <p>
                                        <b>
                                            {{ fullName ?: app.user.username|default('') }}
                                        </b>
                                        {% if relation and relation.getEmail|default('') %}
                                            <br>
                                            <small>{{ relation.getEmail|default('') }}</small>
                                        {% endif %}
                                    </p>
                                </li>
                                <li>
                                    <a href="{{ path('integrated_user_profile_index') }}">
                                        {% trans %}Edit profile{% endtrans %}
                                    </a>
                                </li>
                                <li class="divider"></li>
                                <li>
                                    <a href="{{ path('integrated_user_logout') }}" class="btn btn-dark-green w-full justify-between mt-2">
                                        <span>{% trans %}Log out{% endtrans %}</span><i class="iconoir-log-out rotate-180"></i>
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </li>
                </ul>
            </li>
        {% endif %}
    {% endblock navbar_user %}
</ul>
