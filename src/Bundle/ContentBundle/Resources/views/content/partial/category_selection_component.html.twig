<div class="taxonomy_category" id="taxonomy_category_{{ relation.vars.attr['data-relation'] }}">
    <div class="taxonomy_backdrop hide"></div>
    <div class="category_wrapper close-outside">
        <div class="hidden"></div>

        {% set categories = taxonomyCategories[relation.vars.attr['data-relation']]|default([]) %}
        <div class="categories_tabs flex flex-wrap">
            {% set showAllTab = false %}
            {% for category in categories %}
                {% if category.depth == 0 and category.linkToChannel|length == 0 %}
                        {% set showAllTab = true %}
                {% endif %}
            {% endfor %}

            {% if showAllTab %}
                <div class="category_tab"
                     data-fulltitle="{{ relation.vars.attr['data-title'] }}"
                     data-title="{{ relation.vars.attr['data-title'] }}"
                     data-linkedchannel="">
                    {{ relation.vars.attr['data-title'] }}
                </div>
            {% endif %}

            {% for category in categories %}
                {% if category.depth == 0 and category.linkToChannel|length > 0  %}
                    {% set linkedChannel = category.linkToChannel %}
                    <div class="category_tab"
                         data-fulltitle="{{ category.title }}"
                         data-title="{{ category.title }}"
                         data-taxonomyId="{{ category.taxonomyId }}"
                         data-linkedchannel="{{ linkedChannel }}">
                        {{ category.title }}
                    </div>
                {% endif %}
            {% endfor %}
        </div>

        <div class="aside-item-search">
            <i class="iconoir-search"></i>
            <input type="text" class="list-search" placeholder="{% trans %}Search in{% endtrans %}">
        </div>

        <ul id="" class="categories_checkboxes categories_checkboxes_basic">
            {% for category in categories %}
                {% set className = '' %}
                {% if category.depth == 0 and category.linkToChannel|length > 0 %}
                    {% set pill_title = category.title %}
                    {% set level0 = category.title %}
                    {% set className = 'parent' %}

                    {% set linkedChannel = category.linkToChannel %}
                {% elseif category.depth == 0 and category.linkToChannel|length == 0 %}
                    {% set pill_title = category.title %}
                    {% set level0 = category.title %}

                    {% set linkedChannel = '' %}
                {% endif %}

                {% if category.depth == 1 %}
                    {% set pill_title = level0 ~ ' > ' ~ category.title %}
                    {% set level1 = category.title %}
                    {% set className = 'first-child' %}
                {% endif %}

                {% if category.depth == 2 %}
                    {% set pill_title = level0 ~ ' > ' ~ level1 ~ ' > ' ~ category.title %}
                    {% set level2 = category.title %}
                    {% set className = 'secondary-child' %}
                {% endif %}

                {% if category.depth == 3 %}
                    {% set pill_title = level0 ~ ' > ' ~ level1 ~ ' > ' ~ level2 ~ ' > ' ~ category.title %}
                    {% set level3 = category.title %}
                    {% set className = 'tertiary-child' %}
                {% endif %}

                <li class="inline-block mr-2 {{ className }}"
                    data-fulltitle="{{ pill_title }}"
                    data-title="{{ category.title }}"
                    data-taxonomyId="{{ category.taxonomyId }}"
                    data-linkedchannel="{{ linkedChannel }}">
                    <div class="checkbox">
                        <label class="checkbox-container" for="{{ category.taxonomyId }}">
                            <input type="checkbox" data-id="{{ category.taxonomyId }}" id="{{ category.taxonomyId }}">
                            <span class="checkmark"></span>
                            <div class="background"></div>
                            {{ category.title|raw }}
                        </label>
                    </div>
                </li>
            {% endfor %}
        </ul>

        <div class="current_selection">
            <span class="heading">{% trans %}Current Selection:{% endtrans %}</span>
            <div class="enabled_categories_pills">
            </div>
        </div>

        <div class="togglefullscreen"><i class="iconoir-open-new-window"></i><i class="iconoir-xmark"></i></div>

        <div id="enabled_categories" class="enabled_categories" data-ids="{{ relation.vars['data'] }}"></div>
    </div>
</div>
