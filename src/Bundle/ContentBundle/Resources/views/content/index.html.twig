{% block content %}
    <div class="flex flex-wrap ">

        <div class="md:w-4/5 pr-4 mb-4 md:mb-0">
            <div class="page-title">
                <h1 class="heading">{% trans %}Content navigator{% endtrans %}</h1>
                <div class="options">
                    <ul class="">
                        <li class="dropdown">
                            <a href data-toggle="dropdown" role="button" id="sorting-list"
                               class="btn btn-select space-between"><span>{% trans %}Sort by{% endtrans %}
                                : {{ params.sort.options[params.sort.current].label|trans }}</span> <i
                                    class="fa-regular fa-angle-down"></i></a>
                            <ul aria-labelledby="sorting-list" role="menu" class="dropdown-menu" id="sorting-menu">
                                {% for sort in params.sort.options %}
                                    <li {% if sort.name == params.sort.current %}class="active"
                                        {% endif %}role="presentation">
                                        <a href="{{ path(app.request.attributes.get('_route'), app.request.query.all|merge({'sort': sort.name == params.sort.default ? null : sort.name })) }}"
                                           tabindex="-1" role="menuitem">{{ sort.label|trans|capitalize }}</a>
                                    </li>
                                {% endfor %}
                            </ul>
                        </li>
                        {{ render(controller('Integrated\\Bundle\\ContentBundle\\Controller\\SearchSelectionController::menu')) }}
                        <li class="dropdown">
                            <a href data-toggle="dropdown" role="button"
                               class="btn btn-select space-between"><span>{% trans %}Tools{% endtrans %}</span> <i
                                    class="fa-regular fa-angle-down"></i></a>

                            <ul role="menu" class=" dropdown-menu">
                                <li role="presentation">
                                    <a href="{{ path('integrated_content_bulk_select', app.request.query.all) }}"
                                       tabindex="-1"
                                       role="menuitem">{% trans %}Bulk change this selection{% endtrans %}</a>
                                </li>
                            </ul>
                        </li>
                    </ul>
                </div>
            </div>
