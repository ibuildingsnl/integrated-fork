{% extends '@IntegratedContent/base.html.twig' %}
{% block title %}{% trans %}Content navigator{% endtrans %}{% endblock title %}
{% block content %}
    <div class="flex flex-wrap ">

        <div class="index-wrapper">
            <div class="page-title">
                <div class="heading flex justify-between w-full">
                    <h1 class="heading">{% trans %}Content navigator{% endtrans %}</h1>
                    <button class="toggle-filters toggle-data-target btn btn-orange icon-left"
                            data-target="aside-filters">
                        <i class="iconoir-filter-alt"></i>
                        <span>{% trans %}Filter{% endtrans %}</span>
                    </button>
                </div>
                <div class="options">
                    <ul class="">
                        <li class="dropdown close-outside" data-underlay="no">
                            <a data-toggle="dropdown" role="button" id="sorting-list"
                               class="btn btn-select space-between"><span>{% trans %}Sort by{% endtrans %}
                                : {{ integrated_search_sorting_option(params.sort).label|trans }}</span>
                                <i class="iconoir-nav-arrow-down"></i></a>
                            <ul aria-labelledby="sorting-list" role="menu" class="dropdown-menu" id="sorting-menu">
                                {% set sort_default = params.q ? 'rel' : 'changed' %}
                                {% for sort in integrated_search_sorting_options()|filter(v => v.name != 'rel' or params.q) %}
                                    <li {% if sort.name == params.sort %}class="active"
                                        {% endif %}role="presentation">
                                        <a href="{{ path(app.request.attributes.get('_route'), app.request.query.all|merge({'sort': sort.name == sort_default ? null : sort.name })) }}"
                                           tabindex="-1" role="menuitem">{{ sort.label|trans|capitalize }}</a>
                                    </li>
                                {% endfor %}
                            </ul>
                        </li>
                        {{ render(controller('Integrated\\Bundle\\ContentBundle\\Controller\\SearchSelectionController::menu')) }}
                        <li class="dropdown close-outside" data-underlay="no">
                            <a data-toggle="dropdown" role="button"
                               class="btn btn-select space-between"><span>{% trans %}Tools{% endtrans %}</span>
                                <i class="iconoir-nav-arrow-down"></i></a>

                            <ul role="menu" class=" dropdown-menu">
                                <li role="presentation">
                                    <a href="{{ path('integrated_content_bulk_select', app.request.query.all) }}"
                                       tabindex="-1"
                                       role="menuitem">{% trans %}Bulk change this selection{% endtrans %}</a>
                                </li>
                            </ul>
                        </li>
                    </ul>
                </div>
            </div>
            <section class="section-white section-radius">
                <table class="table">
                    <thead>
                    <tr>
                        <th class="title">
                            <span>Titel</span>
                        </th>
                        <th class="content-type">
                            <span>ContentType</span>
                        </th>
                        <th class="pub-date">
                            <span>Publication Date</span>
                        </th>
                        <th class="state">
                            <span>Status</span>
                        </th>
                    </tr>
                    </thead>
                    <tbody id="post-list">
                    {% for content in pager %}
                        <tr class="has-options">
                            <td class="title">
                                {% if locks[content.type_id] is defined %}
                                    {% if locks[content.type_id].user is defined %}
                                        <div class="locked-info">
                                            <span class="locked-text">
                                                <i class="iconoir-lock"></i>&nbsp;
                                                {% trans %}This item is locked by{% endtrans %} {{ locks[content.type_id].user }}
                                            </span>
                                        </div>
                                    {% else %}
                                        <div class="locked-info">
                                            <span class="locked-text">
                                                <i class="iconoir-lock"></i>&nbsp;
                                                {% trans %}This item is locked{% endtrans %}
                                            </span>
                                        </div>
                                    {% endif %}
                                {% endif %}
                                <strong>
                                    <a href="{{ path('integrated_content_content_edit', {id: content.type_id}) }}">
                                        {{ content.title|default }}

                                    </a>
                                </strong>
                                <div class="row-options">
                                    <a href="{{ path('integrated_content_content_edit', {id: content.type_id}) }}"
                                       role="option">
                                        {% trans %}Edit{% endtrans %}
                                    </a> |
                                    <a class="color-red"
                                       href="{{ path('integrated_content_content_delete', {'id': content.type_id}) }}"
                                       tabindex="-1" role="option">
                                        {% trans %}Delete{% endtrans %}
                                    </a>
                                </div>
                            </td>
                            <td class="content-type">
                                {{ content.type_name|integrated_content_type.name|default(content.type_name) }}
                            </td>
                            <td class="pub-date">
                                {% if content.pub_time is defined %}
                                    {{ content.pub_time|format_date('long') }}
                                {% endif %}
                            </td>
                            <td class="state">
                                {% if content.workflow_state is defined and ('now'|date('U') > content.pub_time |date('U')) %}
                                    {% if content.workflow_color_string is defined %}
                                        {% set status_color = content.workflow_color_string|first %}
                                        <div class="workflow-status" style="background-color:{{ status_color }};">
                                            {{ content.workflow_state|default }}
                                        </div>
                                    {% else %}
                                        <div class="workflow-status" style="background-color:#d8d8d8;">
                                            {{ content.workflow_state|default }}
                                        </div>
                                    {% endif %}
                                    {% set status_color = '' %}
                                {% elseif content.workflow_state is defined %}
                                    <div class="workflow-status" style="background-color:#5f84db;">
                                        {% trans %}Planned{% endtrans %}
                                    </div>
                                {% endif %}

                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td class="title">{% trans %}No items found{% endtrans %}</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>

                <div class="flex flex-wrap ">
                    {{ knp_pagination_render(pager) }}
                </div>
            </section>
        </div>

        <div class="aside-filters close-outside">
            <aside>
                <div class="aside-holder bg-white section-radius">
                    <div class="aside-header">
                        <button class="toggle-filters toggle-data-target" data-target="aside-filters"><i
                                class="iconoir-cancel"></i></button>
                        <span>{% trans %}Filters{% endtrans %}</span>
                        <a href="{{ path('integrated_content_content_index') }}"
                           class="clear-filters"><span>{% trans %}Remove active filters{% endtrans %}</span>
                            <i class="iconoir-cancel"></i>
                        </a>
                    </div>
                    <form>
                        <input type="hidden" value="{{ params['q'] }}" name="q"/>
                        <input type="hidden" value="{{ params['sort'] }}" name="sort"/>
                        {% for key, facet in facets %}
                            {% if key starts with 'relation_' %}
                                {{ block('relation_facet') }}
                            {% else %}
                                {{ block('facet') }}
                            {% endif %}
                        {% endfor %}
                    </form>
                </div>
            </aside>
        </div>
    </div>
{% endblock %}


{% block facet %}
    {% if key == 'contenttypes' %}
        {% set facetTitle = 'Content types'|trans %}
    {% elseif key == 'workflow_state' %}
        {% set facetTitle = 'Workflow status'|trans %}
    {% elseif key == 'workflow_assigned' %}
        {% set facetTitle = 'Assigned user'|trans %}
    {% elseif key == 'authors' %}
        {% set facetTitle = 'Author'|trans %}
    {% else %}
        {% set facetTitle = key|capitalize %}
    {% endif %}
    <div class="aside-item-holder">
        <div class="aside-item-wrapper {% if (key == 'contenttypes') or (key =='channels') %}show{% endif %}">
            <div class="aside-item-header">
                <h3 class="aside-item-title">
                    <span class="aside-item-icon">
                        {{ facetTitle }}
                    </span>
                </h3>
                <i class="iconoir-nav-arrow-down"></i>
            </div>
            <div class="aside-item-list">
                <div class="aside-item-list-container">
                    {% if (facet|length >= 6) %}
                        <div class="aside-item-search">
                            <i class="iconoir-search"></i>
                            <input type="text" class="list-search"
                                   placeholder="{% trans %}Search in{% endtrans %} {{ facetTitle }}">
                        </div>
                    {% endif %}
                    <ul class="filters_list">
                        {% for title, count in facet %}
                            <li class="checkbox">
                                <label class="checkbox-container">
                                    <input {% if title in params[key]|default %}checked="checked"{% endif %} onclick="form.submit();" type="checkbox" name="{{ key }}[]" value="{{ title }}" />
                                    <span class="checkmark"></span>
                                    <div class="facet-wrappper">
                                        <span class="facet-title">
                                            {% if key == 'contenttypes' %}
                                                {{ title|integrated_content_type.name|default(title) }}
                                            {% elseif key == 'channels' %}
                                                {{ title|integrated_channel.name|default(title) }}
                                            {% else %}
                                                {{ title }}
                                            {% endif %}
                                        </span>
                                        <span class="facet-count">({{ count }})</span>
                                    </div>
                                </label>
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block relation_facet %}
    {% set key = key[9:] %}

    {% set facetTitle = key|integrated_relation.name|default(key|capitalize) %}
    <div class="aside-item-holder">
        <div class="aside-item-wrapper">
            <div class="aside-item-header">
                <h3 class="aside-item-title">
                    <span class="aside-item-icon">
                        {{ facetTitle }}
                    </span>
                </h3>
                <i class="iconoir-nav-arrow-down"></i>
            </div>
            <div class="aside-item-list">
                <div class="aside-item-list-container">
                    {% if (facet|length >= 6) %}
                        <div class="aside-item-search">
                            <i class="iconoir-search"></i>
                            <input type="text" class="list-search"
                                   placeholder="{% trans %}Search in{% endtrans %} {{ facetTitle }}">
                        </div>
                    {% endif %}
                    <ul class="filters_list">
                        {% for title, count in facet %}
                            <li class="checkbox">
                                <label class="checkbox-container">
                                    <input {% if title in params['relation'][key]|default %}checked="checked"{% endif %} onclick="form.submit();" type="checkbox" name="relation[{{ key }}][]" value="{{ title }}" />
                                    <span class="checkmark"></span>
                                    <div class="facet-wrappper">
                                        <span class="facet-title">
                                            {{ title }}
                                        </span>
                                        <span class="facet-count">({{ count }})</span>
                                    </div>
                                </label>
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascript %}
{{ parent() }}
{% endblock %}
