{% extends '@IntegratedContent/base.html.twig' %}
{% block crumbs %}
    <div class="breadcrumb-holder">
        <div class="container">
            <ol class="breadcrumb">
                <li class="active">{% trans %}Content navigator{% endtrans %}</li>
            </ol>
        </div>
    </div>
{% endblock %}

{% block content %}
    <div class="row">

        <div class="col-md-8 push-sm-down">
            <ul class="list-inline">

                <li class="dropdown">
                    <a href data-toggle="dropdown" role="button" id="sorting-list">{% trans %}Sort by{% endtrans %}: {{ integrated_search_sorting_option(params.sort).label|trans }} <b class="caret"></b></a>

                    <ul aria-labelledby="sorting-list" role="menu" class="dropdown-menu" id="sorting-menu">

                        {% set sort_default = params.q ? 'rel' : 'changed' %}

                        {% for sort in integrated_search_sorting_options()|filter(v => v.name != 'rel' or params.q) %}

                            <li {% if sort.name == params.sort %}class="active" {% endif %}role="presentation">
                                <a href="{{ path(app.request.attributes.get('_route'), app.request.query.all|merge({'sort': sort.name == sort_default ? null : sort.name })) }}" tabindex="-1" role="menuitem">{{ sort.label|trans|capitalize }}</a>
                            </li>

                        {% endfor %}

                    </ul>
                </li>

                {{ render(controller('Integrated\\Bundle\\ContentBundle\\Controller\\SearchSelectionController::menu')) }}

                <li class="dropdown">
                    <a href data-toggle="dropdown" role="button">{% trans %}Tools{% endtrans %} <b class="caret"></b></a>

                    <ul role="menu" class="dropdown-menu">
                        <li role="presentation">
                            <a href="{{ path('integrated_content_bulk_select', app.request.query.all) }}" tabindex="-1" role="menuitem">{% trans %}Bulk change this selection{% endtrans %}</a>
                        </li>
                    </ul>
                </li>

            </ul>
            <section class="section-white section-padding section-shadow section-radius">
                <ul class="list-unstyled list-content">
                    {% for content in pager %}
                        <li>
                            <h3>
                                <a href="{{ path('integrated_content_content_edit', {id: content.type_id}) }}">
                                    {{ content.title|default }}
                                </a>
                            </h3>

                            {% if locks[content.type_id] is defined %}
                                {% if locks[content.type_id].user is defined %}
                                    <div class="alert alert-danger">
                                        {% trans %}This item is locked by{% endtrans %} {{ locks[content.type_id].user }}
                                    </div>
                                {% else %}
                                    <div class="alert alert-danger">
                                        {% trans %}This item is locked{% endtrans %}
                                    </div>
                                {% endif %}
                            {% endif %}

                            {% if content.intro is defined and content.intro|join('...')|trim is not empty %}
                                 <p>{{ content.intro|join('...')|slice(0, 200)|striptags|raw }}</p>
                            {% elseif content.content is defined and content.content|join('...')|trim is not empty %}
                                 <p>{{ content.content|join('...')|slice(0, 200)|striptags|raw }}</p>
                            {% endif %}

                            <ul class="list-inline">
                                <li>
                                    {% if content.workflow_state is defined %}
                                        {{ content.workflow_state|default }} |
                                    {% endif %}
                                    {% if content.workflow_assigned is defined %}
                                        {{ content.workflow_assigned|first|default }} |
                                    {% endif %}
                                    {{ content.type_name|integrated_content_type.name|default(content.type_name) }}
                                    {% if content.pub_time is defined %}
                                        |
                                        {{ content.pub_time|format_date('medium') }}
                                    {% endif %}
                                    {% if content.pub_edited is defined %}
                                        {% if content.pub_time is not defined or content.pub_edited != content.pub_time %}
                                        |
                                        {% if content.pub_time is defined %}
                                            {% trans %}Updated{% endtrans %}
                                        {% endif %}
                                        {{ content.pub_edited|format_date('medium') }}
                                        {% endif %}
                                    {% endif %}
                                </li>

                                <li class="dropdown">
                                    <a href="#" data-toggle="dropdown" role="button"><b class="caret"></b></a>
                                    <ul role="menu" class="dropdown-menu">
                                        <li role="presentation"><a href="{{ path('integrated_content_content_delete', {'id': content.type_id}) }}" tabindex="-1" role="menuitem">{% trans %}Delete item{% endtrans %}</a></li>
                                    </ul>
                                </li>
                            </ul>
                        </li>
                    {% else %}
                        <li class="text-danger">
                           {% trans %}No items found{% endtrans %}
                        </li>
                    {% endfor %}
                </ul>

                <div class="row">
                    <div class="pull-right">
                        {{ knp_pagination_render(pager) }}
                    </div>
                </div>
            </section>
        </div>

        <div class="col-sm-4">
            <aside>
                <div class="aside-holder section-gray section-shadow section-radius">
                    <form>
                        <input type="hidden" value="{{ params['q'] }}" name="q" />
                        <input type="hidden" value="{{ params['sort'] }}" name="sort" />
                        {% for key, facet in facets %}
                            {% if facet|length > 0 %}
                                {% if key starts with 'relation_' %}
                                    {{ block('relation_facet') }}
                                {% else %}
                                    {{ block('facet') }}
                                {% endif %}
                            {% endif %}
                        {% endfor %}
                    </form>
                </div>
            </aside>
        </div>
    </div>
{% endblock %}

{% block facet %}
    <div class="aside-item-holder">
        <h3 class="font-medium">
            {% if key == 'contenttypes' %}
                {% trans %}Content types{% endtrans %}
            {% elseif key == 'workflow_state' %}
                {% trans %}Workflow status{% endtrans %}
            {% elseif key == 'workflow_assigned' %}
                {% trans %}Assigned user{% endtrans %}
            {% elseif key == 'authors' %}
                {% trans %}Author{% endtrans %}
            {% else %}
                {{ key|capitalize }}
            {% endif %}
        </h3>
        <ul class="filters_list">
            {% for title, count in facet %}
                <li class="checkbox{% if (loop.index >= 8) and (not (title in params[key]|default)) %} to_show{% endif %}">
                    <label>
                        <input {% if title in params[key]|default %}checked="checked"{% endif %} onclick="form.submit();" type="checkbox" name="{{ key }}[]" value="{{ title }}" />
                        {% if key == 'contenttypes' %}
                            {{ title|integrated_content_type.name|default(title) }}
                        {% elseif key == 'channels' %}
                            {{ title|integrated_channel.name|default(title) }}
                        {% else %}
                            {{ title }}
                        {% endif %}
                        <span class="value">{{ count }}</span>
                    </label>
                </li>
            {% endfor %}
            {% if (facet|length >= 8) %}
                <li><a href="#" class="btn_show_more">{% trans %}More{% endtrans %} <i class="glyphicon"></i></a></li>
            {% endif %}
        </ul>
    </div>
{% endblock %}

{% block relation_facet %}
    <div class="aside-item-holder">
        <h3 class="font-medium">
            {{ key|integrated_relation.name|default(key|capitalize) }}
        </h3>
        <ul class="filters_list">
            {% for title, count in facet %}
                <li class="checkbox{% if (loop.index >= 8) and (not (title in params['relation'][key]|default)) %} to_show{% endif %}">
                    <label>
                        <input {% if title in params['relation'][key]|default %}checked="checked"{% endif %} onclick="form.submit();" type="checkbox" name="relation[{{ key }}][]" value="{{ title }}" />
                        {{ title }}
                        <span class="value">{{ count }}</span>
                    </label>
                </li>
            {% endfor %}
            {% if (facet|length >= 8) %}
                <li><a href="#" class="btn_show_more">{% trans %}More{% endtrans %} <i class="glyphicon"></i></a></li>
            {% endif %}
        </ul>
    </div>
{% endblock %}
