{% extends '@IntegratedContent/content/base.html.twig' %}
{% block title %}{% trans %}Content navigator{% endtrans %}{% endblock title %}
{% form_theme searchSelectionForm with '@IntegratedFormType/form/form_div_layout.html.twig' %}
{% block options_start %}
    {% set currentSortOption = integrated_search_sorting_option(params.sort) %}
    {% set currentSortLabel = currentSortOption ? currentSortOption.label|trans : 'Custom sorting'|trans %}
    <li class="dropdown close-outside" data-underlay="no">
        <a data-toggle="dropdown" role="button" id="sorting-list"
           class="btn btn-select space-between"><span>{% trans %}Sort by{% endtrans %}
                                : {{ currentSortLabel }}</span>
            <i class="iconoir-nav-arrow-down"></i>
        </a>
        <ul aria-labelledby="sorting-list" role="menu" class="dropdown-menu" id="sorting-menu">
            {% set sort_default = params.q ? 'rel' : 'time' %}
            {% for sort in integrated_search_sorting_options()|filter(v => v.field != 'score' or params.q) %}
                <li {% if sort.field == params.sort %}class="active"
                    {% endif %}role="presentation">
                    <a href="{{ path(route, queryParams|merge({'sort': sort.field == sort_default ? null : sort.field })) }}"
                       tabindex="-1" role="menuitem">{{ sort.label|trans|capitalize }}</a>
                </li>
            {% endfor %}
        </ul>
    </li>
{% endblock options_start %}
{% block content_items %}
    <section class="section-white section-radius">
        {% set media_gallery_classes = ["Image", "Video", "File"] %}
        {% set showSeoColumn = false %}
        {% for seoColumnCandidate in pager.getItems() %}
            {% set seoCandidateType = contentTypes|filter(t => t.id == seoColumnCandidate.type_name)|first %}
            {% if seoCandidateType and seoCandidateType.hasField('seoMetadata') %}
                {% set seoCandidateHasMetadata = attribute(seoColumnCandidate, 'has_seo_metadata')|default(false) %}
                {% if seoCandidateHasMetadata is iterable %}
                    {% set seoCandidateHasMetadata = seoCandidateHasMetadata|first %}
                {% endif %}
                {% if seoCandidateHasMetadata in [true, 1, '1', 'true'] %}
                    {% set showSeoColumn = true %}
                {% endif %}
            {% endif %}
        {% endfor %}
        <table class="table">
            <thead>
            <tr>
                <th class="title">
                    <span>{% trans %}Title{% endtrans %}</span>
                </th>
                <th class="channels">
                    <span>{% trans %}Channels{% endtrans %}</span>
                </th>
                <th class="content-type">
                    <span>ContentType</span>
                </th>
                <th class="pub-date">
                    <span>{% trans %}Publication date{% endtrans %}</span>
                </th>
                {% if showSeoColumn %}
                    <th class="seo">
                        <span>SEO</span>
                    </th>
                {% endif %}
                <th class="state">
                    <span>{% trans %}Status{% endtrans %}</span>
                </th>
            </tr>
            </thead>
            <tbody
                id="post-list"
                data-lock-endpoint="{{ path('integrated_content_content_locks_status')|e('html_attr') }}"
                data-locked-text="{{ 'This item is locked'|trans|e('html_attr') }}"
                data-locked-by-text="{{ 'This item is locked by'|trans|e('html_attr') }}"
            >
            {% for content in pager %}
                {% set brandNames = content.facet_brands|default([])|filter(name => name is not empty and name != 'None') %}
                {% set fallbackWebsiteChannelIds = content.website_channel_ids_string|default([])|filter(id => id is not empty and id != 'None') %}
                {% set fallbackWebsiteChannelNames = content.website_channel_names_string|default([]) %}
                {% set fallbackWebsiteChannelFavicons = content.website_channel_favicon_paths_string|default([]) %}
                {% set visibleBrandNames = brandNames|slice(0, 3) %}
                {% set visibleFallbackWebsiteChannelIds = fallbackWebsiteChannelIds|slice(0, 3) %}
                {% set channelCount = brandNames is not empty ? brandNames|length : fallbackWebsiteChannelIds|length %}

                {% set class_name = content.type_class|split('\\')|last %}
                <tr
                    class="has-options"
                    data-lock-resource-type="{{ content.type_class|e('html_attr') }}"
                    data-lock-resource-id="{{ content.type_id|e('html_attr') }}"
                >
                    <td class="title">
                        <div class="js-lock-slot" data-lock-slot>
                            {% if locks[content.type_id] is defined %}
                                {% if locks[content.type_id].user is defined and locks[content.type_id].user is not empty %}
                                    <div class="locked-info">
                                        <span class="locked-text">
                                            <i class="iconoir-lock"></i><span>{% trans %}This item is locked by{% endtrans %} {{ locks[content.type_id].user }}</span>
                                        </span>
                                    </div>
                                {% else %}
                                    <div class="locked-info">
                                        <span class="locked-text">
                                            <i class="iconoir-lock"></i><span>{% trans %}This item is locked{% endtrans %}</span>
                                        </span>
                                    </div>
                                {% endif %}
                            {% endif %}
                        </div>

                        {% if class_name in media_gallery_classes %}
                            {% set editLink = path('integrated_content_media_index', {ids: content.type_id}) %}
                        {% else %}
                            {% set editLink = path('integrated_content_content_edit', {id: content.type_id}) %}
                        {% endif %}

                        {% set type = contentTypes|filter(t => t.id == content.type_name)|first %}
                        <div>
                            <strong>
                                <a href="{{ editLink }}" data-turbo-frame="_top" data-turbo-prefetch="false">
                                    {{ content.title|default }}
                                </a>
                            </strong>
                        </div>
                        <div class="row-options">
                            <a href="{{ editLink }}" data-turbo-frame="_top" data-turbo-prefetch="false">
                                {% trans %}Edit{% endtrans %}
                            </a> |
                            <a class="color-red"
                               href="{{ path('integrated_content_content_delete', {'id': content.type_id}) }}"
                               data-turbo-frame="_top"
                               data-turbo-prefetch="false"
                               tabindex="-1" role="option">
                                {% trans %}Delete{% endtrans %}
                            </a>
                        </div>
                    </td>

                    <td class="channels">
                        <div class="favicon-wrapper {% if channelCount > 3 %}hover-popout{% endif %}">
                            {% if channelCount > 3 %}
                                <span class="channel-popout" style="--color:#01ae93">3+</span>
                            {% endif %}
                            <div class="channel-favicons {% if channelCount > 3 %}popout{% endif %}">
                                {% if brandNames is not empty %}
                                    {% for brandName in visibleBrandNames %}
                                        <div class="channel-favicon font-bold"
                                             title="{{ brandName }}"
                                             style="background-color: {{ type.options.color|default('gray') }}">
                                            {{ brandName|first|upper }}
                                        </div>
                                    {% endfor %}
                                {% elseif fallbackWebsiteChannelIds is not empty %}
                                    {% for channelId in visibleFallbackWebsiteChannelIds %}
                                        {% set channelName = fallbackWebsiteChannelNames[loop.index0]|default(channelId) %}
                                        {% set faviconPath = fallbackWebsiteChannelFavicons[loop.index0]|default('') %}
                                        {% if faviconPath is not empty %}
                                            <div class="channel-favicon"
                                                 style="background-image:url('{{ image(faviconPath).cropResize(36, 36) }}')"
                                                 title="{{ channelName }}">
                                            </div>
                                        {% else %}
                                            <div class="channel-favicon font-bold"
                                                 title="{{ channelName }}"
                                                 style="background-color: {{ type.options.color|default('gray') }}">
                                                {{ channelName|first|upper }}
                                            </div>
                                        {% endif %}
                                    {% endfor %}
                                {% endif %}
                            </div>
                        </div>
                    </td>
                    <td class="content-type">
                        <div class="flex font-bold" style="color: {{ type.options.color|default('gray') }}">
                            <i class="icon mr-2 iconoir-{{ type.options.icon|default('empty-page') }}" title="{{ type }}"></i>
                            <span>{{ content.type_name|integrated_content_type.name|default(content.type_name) }}</span>
                        </div>
                    </td>
                    <td class="pub-date">
                        {% if content.pub_time is defined %}
                            {{ content.pub_time|format_date('long') }}
                        {% endif %}
                    </td>
                    {% if showSeoColumn %}
                        <td class="seo">
                            {% set hasSeoMetadata = attribute(content, 'has_seo_metadata')|default(false) %}
                            {% if hasSeoMetadata is iterable %}
                                {% set hasSeoMetadata = hasSeoMetadata|first %}
                            {% endif %}
                            {% if type and type.hasField('seoMetadata') and hasSeoMetadata in [true, 1, '1', 'true'] %}
                                {% set seoScore = attribute(content, 'seo_score')|default('feedback') %}
                                {% set readabilityScore = attribute(content, 'readability_score')|default('feedback') %}
                                {% if seoScore is iterable %}
                                    {% set seoScore = seoScore|first %}
                                {% endif %}
                                {% if readabilityScore is iterable %}
                                    {% set readabilityScore = readabilityScore|first %}
                                {% endif %}
                                <span class="btn btn-white no-icon seo-button readability-{{ readabilityScore }} seo-{{ seoScore }}">
                                    SEO
                                </span>
                            {% else %}
                                -
                            {% endif %}
                        </td>
                    {% endif %}
                    <td class="state">
                        {% set published = content.published|default(false) %}
                        {% if published is iterable %}
                            {% set published = published|first %}
                        {% endif %}
                        {% set isPublishable = published in [true, 1, '1', 'true'] and channelCount > 0 %}
                        {% set hasPublicationDate = content.pub_time is defined %}
                        {% set hasStarted = hasPublicationDate and ('now'|date('U') > content.pub_time|date('U')) %}
                        {% set isPlanned = isPublishable and hasPublicationDate and not hasStarted %}

                        {% if content.workflow_state is defined and hasStarted %}
                            {% if content.workflow_color_string is defined %}
                                {% set status_color = content.workflow_color_string|first %}
                                <div class="workflow-status" style="background-color:{{ status_color|alpha(12) }};border-color:{{ status_color|alpha(45) }};color:{{ status_color }};">
                                    <i class="iconoir-{{ content.workflow_icon_string|first|default }}"></i>
                                </div>
                            {% else %}
                                <div class="workflow-status" style="background-color:{{ '#6c7b89'|alpha(12) }};border-color:{{ '#6c7b89'|alpha(45) }};color:#6c7b89;">
                                    <i class="iconoir-{{ content.workflow_icon_string|first|default }}"></i>
                                </div>
                            {% endif %}
                            {% set status_color = '' %}
                        {% elseif isPlanned %}
                            <div class="workflow-status" style="background-color:{{ '#5f84db'|alpha(12) }};border-color:{{ '#5f84db'|alpha(45) }};color:#5f84db;">
                                <i class="iconoir-calendar"></i>
                            </div>
                        {% elseif isPublishable and hasStarted %}
                            <div class="workflow-status" style="background-color:{{ '#00ae93'|alpha(12) }};border-color:{{ '#00ae93'|alpha(45) }};color:#00ae93;">
                                <i class="iconoir-check"></i>
                            </div>
                        {% else %}
                            <div class="workflow-status" style="background-color:{{ '#ababab'|alpha(12) }};border-color:{{ '#ababab'|alpha(45) }};color:#ababab;">
                                <i class="iconoir-edit-pencil"></i>
                            </div>
                        {% endif %}
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td class="title">{% trans %}No items found{% endtrans %}</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>

        <div class="flex flex-wrap ">
            {{ knp_pagination_render(pager, '@KnpPaginator/Pagination/sliding.html.twig') }}
        </div>
    </section>
{% endblock content_items %}

{% block javascript %}
    {{ parent() }}
    <script src="{{ asset('bundles/integratedcontent/js/content_index_lock_polling.js') }}" defer data-turbo-track="reload"></script>
{% endblock %}
