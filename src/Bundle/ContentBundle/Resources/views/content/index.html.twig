                    </thead>
                    <tbody id="post-list">
                    {% for content in pager %}
                        {#                        {{ dump(content) }} #}
                        <tr class="has-options">
                            {#                            <th class="checkbox"></th> #}
                            <td class="title">
                                {% if locks[content.type_id] is defined %}
                                    {% if locks[content.type_id].user is defined %}
                                        <div class="locked-info">
                                            <span
                                                class="locked-text"><i
                                                    class="fa-regular fa-lock"></i>&nbsp;{% trans %}This item is locked by{% endtrans %} {{ locks[content.type_id].user }}</span>
                                        </div>
                                    {% else %}

                                        <div class="locked-info">
                                            <span
                                                class="locked-text"><i
                                                    class="fa-regular fa-lock"></i>&nbsp;{% trans %}This item is locked{% endtrans %}</span>
                                        </div>
                                    {% endif %}
                                {% endif %}
                                <strong>
                                    <a href="{{ path('integrated_content_content_edit', {id: content.type_id}) }}">
                                        {{ content.title|default }}
                                    </a>
                                </strong>
                                <div class="row-options">
                                    <a href="{{ path('integrated_content_content_edit', {id: content.type_id}) }}"
                                       role="option">
                                        {% trans %}Edit{% endtrans %}
                                    </a> |
                                    <a class="color-red"
                                       href="{{ path('integrated_content_content_delete', {'id': content.type_id}) }}"
                                       tabindex="-1" role="option">
                                        {% trans %}Delete{% endtrans %}
                                    </a>
                                </div>
                            </td>
                            <td class="content-type">
                                {% if contentTypes[content.type_name] is defined %}
                                    {{ contentTypes[content.type_name] }}
                                {% else %}
                                    {{ content.type_name }}
                                {% endif %}
                            </td>
                            <td class="publication-date">
                                {% if content.pub_time is defined %}
                                    {{ content.pub_time|format_date('long') }}
                                {% endif %}
                            </td>
                            <td class="content-status">
                                {% if content.workflow_state is defined %} #}
                                    {{ content.workflow_state|default }}
                                {% endif %}
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td class="title">{% trans %}No items found{% endtrans %}</td>
                        </tr>
                    {% endfor %}
