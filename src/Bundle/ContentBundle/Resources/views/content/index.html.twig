{% extends '@IntegratedContent/content/base.html.twig' %}
{% block title %}{% trans %}Content navigator{% endtrans %}{% endblock title %}
{% form_theme searchSelectionForm with '@IntegratedFormType/form/form_div_layout.html.twig' %}
{% block options_start %}
    <li class="dropdown close-outside" data-underlay="no">
        <a data-toggle="dropdown" role="button" id="sorting-list"
           class="btn btn-select space-between"><span>{% trans %}Sort by{% endtrans %}
                                : {{ integrated_search_sorting_option(params.sort).label|trans }}</span>
            <i class="iconoir-nav-arrow-down"></i>
        </a>
        <ul aria-labelledby="sorting-list" role="menu" class="dropdown-menu" id="sorting-menu">
            {% set sort_default = params.q ? 'rel' : 'time' %}
            {% for sort in integrated_search_sorting_options()|filter(v => v.field != 'score' or params.q) %}
                <li {% if sort.field == params.sort %}class="active"
                    {% endif %}role="presentation">
                    <a href="{{ path(route, queryParams|merge({'sort': sort.field == sort_default ? null : sort.field })) }}"
                       tabindex="-1" role="menuitem">{{ sort.label|trans|capitalize }}</a>
                </li>
            {% endfor %}
        </ul>
    </li>
{% endblock options_start %}
{% block content_items %}
    <section class="section-white section-radius">
        {% set media_gallery_classes = ["Image", "Video", "File"] %}
        <table class="table">
            <thead>
            <tr>
                <th class="title">
                    <span>{% trans %}Title{% endtrans %}</span>
                </th>
                <th class="channels">
                    <span>{% trans %}Channels{% endtrans %}</span>
                </th>
                <th class="content-type">
                    <span>ContentType</span>
                </th>
                <th class="pub-date">
                    <span>{% trans %}Publication date{% endtrans %}</span>
                </th>
                <th class="seo">
                    <span>SEO</span>
                </th>
                <th class="state">
                    <span>{% trans %}Status{% endtrans %}</span>
                </th>
            </tr>
            </thead>
            <tbody id="post-list">
            {% for content in pager %}
                {% set brandNames = content.facet_brands|default([]) %}
                {% set document = null %}
                {% if brandNames is empty %}
                    {% set document = integrated_document(content) %}
                {% endif %}
                {% set websiteChannels = [] %}
                {% set websiteChannelIds = [] %}
                {% if document is not null and document.channels is defined and document.channels is not null %}
                    {% for channel in document.channels %}
                        {% set websiteChannel = channel|integrated_brand_website_channel %}
                        {% if websiteChannel is null and channel.type is defined and channel.type is not null and channel.type.id|default('') == 'website' %}
                            {% set websiteChannel = channel %}
                        {% endif %}
                        {% if websiteChannel is not null %}
                            {% set websiteChannelId = websiteChannel.id|default('') %}
                            {% if websiteChannelId is not empty and websiteChannelId not in websiteChannelIds %}
                                {% set websiteChannels = websiteChannels|merge([websiteChannel]) %}
                                {% set websiteChannelIds = websiteChannelIds|merge([websiteChannelId]) %}
                            {% endif %}
                        {% endif %}
                    {% endfor %}
                {% endif %}
                {% set visibleBrandNames = brandNames|slice(0, 3) %}
                {% set channelCount = brandNames|length %}
                {% if channelCount == 0 and document is not null and document.channels is defined and document.channels is not null %}
                    {% set channelCount = websiteChannels|length %}
                {% endif %}

                {% set class_name = content.type_class|split('\\')|last %}
                <tr
                    class="has-options"
                    data-lock-resource-type="{{ content.type_class|e('html_attr') }}"
                    data-lock-resource-id="{{ content.type_id|e('html_attr') }}"
                >
                    <td class="title">
                        <div class="js-lock-slot" data-lock-slot>
                            {% if locks[content.type_id] is defined %}
                                {% if locks[content.type_id].user is defined and locks[content.type_id].user is not empty %}
                                    <div class="locked-info">
                                        <span class="locked-text">
                                            <i class="iconoir-lock"></i>&nbsp;
                                            {% trans %}This item is locked by{% endtrans %} {{ locks[content.type_id].user }}
                                        </span>
                                    </div>
                                {% else %}
                                    <div class="locked-info">
                                        <span class="locked-text">
                                            <i class="iconoir-lock"></i>&nbsp;
                                            {% trans %}This item is locked{% endtrans %}
                                        </span>
                                    </div>
                                {% endif %}
                            {% endif %}
                        </div>

                        {% if class_name in media_gallery_classes %}
                            {% set editLink = path('integrated_content_media_index', {ids: content.type_id}) %}
                        {% else %}
                            {% set editLink = path('integrated_content_content_edit', {id: content.type_id}) %}
                        {% endif %}

                        {% set type = contentTypes|filter(t => t.id == content.type_name)|first %}
                        <div>
                            <strong>
                                <a href="{{ editLink }}" data-turbo-frame="_top">
                                    {{ content.title|default }}
                                </a>
                            </strong>
                        </div>
                        {% set contentRowActionsHtml %}
                            <a href="{{ editLink }}" data-turbo-frame="_top">
                                {% trans %}Edit{% endtrans %}
                            </a> |
                            <a class="color-red"
                               href="{{ path('integrated_content_content_delete', {'id': content.type_id}) }}"
                               data-turbo-frame="_top"
                               data-turbo-prefetch="false"
                               tabindex="-1" role="option">
                                {% trans %}Delete{% endtrans %}
                            </a>
                        {% endset %}
                        {{ component('integrated_admin:row_actions', {
                            contentHtml: contentRowActionsHtml,
                        }) }}
                    </td>

                    <td class="channels">
                        <div class="favicon-wrapper {% if channelCount > 3 %}hover-popout{% endif %}">
                            {% if channelCount > 3 %}
                                <span class="channel-popout" style="--color:#01ae93">3+</span>
                            {% endif %}
                            <div class="channel-favicons {% if channelCount > 3 %}popout{% endif %}">
                                {% if brandNames is not empty %}
                                    {% for brandName in visibleBrandNames %}
                                        <div class="channel-favicon font-bold"
                                             title="{{ brandName }}"
                                             style="background-color: {{ type.options.color|default('gray') }}">
                                            {{ brandName|first|upper }}
                                        </div>
                                    {% endfor %}
                                {% elseif document.channels is defined and document.channels is not null %}
                                    {% for channel in websiteChannels %}
                                        {% if channel|integrated_brand_profile.favicon.file is defined %}
                                            <div class="channel-favicon"
                                                 style="background-image:url('{{ image(channel|integrated_brand_profile.favicon.file).cropResize(36, 36) }}')"
                                                 title="{{ channel.name }}">
                                            </div>
                                        {% else %}
                                            <div class="channel-favicon font-bold"
                                                 title="{{ channel.name }}"
                                                 style="background-color: {{ channel|integrated_brand.color|default('gray') }}">
                                                {{ channel.name|first|upper }}
                                            </div>
                                        {% endif %}
                                    {% endfor %}
                                {% else %}
                                    <div class="channel-favicon font-bold"
                                         style="background-color: {{ type.options.color|default('gray') }}">
                                        ?
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                    </td>
                    <td class="content-type">
                        <div class="flex font-bold" style="color: {{ type.options.color|default('gray') }}">
                            <i class="icon mr-2 iconoir-{{ type.options.icon|default('empty-page') }}" title="{{ type }}"></i>
                            <span>{{ content.type_name|integrated_content_type.name|default(content.type_name) }}</span>
                        </div>
                    </td>
                    <td class="pub-date">
                        {% if content.pub_time is defined %}
                            {{ content.pub_time|format_date('long') }}
                        {% endif %}
                    </td>
                    <td class="seo">
                        {% set hasSeoMetadata = content.has_seo_metadata|default(false) %}
                        {% if hasSeoMetadata is iterable %}
                            {% set hasSeoMetadata = hasSeoMetadata|first %}
                        {% endif %}
                        {% if hasSeoMetadata in [true, 1, '1', 'true'] %}
                            {% set seoScore = content.seo_score|default('feedback') %}
                            {% set readabilityScore = content.readability_score|default('feedback') %}
                            {% if seoScore is iterable %}
                                {% set seoScore = seoScore|first %}
                            {% endif %}
                            {% if readabilityScore is iterable %}
                                {% set readabilityScore = readabilityScore|first %}
                            {% endif %}
                            <span class="btn btn-white no-icon seo-button readability-{{ readabilityScore }} seo-{{ seoScore }}">
                                SEO
                            </span>
                        {% else %}
                            -
                        {% endif %}
                    </td>
                    <td class="state">
                        {% if content.workflow_state is defined and ('now'|date('U') > content.pub_time |date('U')) %}
                            {% if content.workflow_color_string is defined %}
                                {% set status_color = content.workflow_color_string|first %}
                                <div class="workflow-status" style="background-color:{{ status_color|alpha(12) }};border-color:{{ status_color|alpha(45) }};color:{{ status_color }};">
                                    <i class="iconoir-{{ content.workflow_icon_string|first|default }}"></i>
                                </div>
                            {% else %}
                                <div class="workflow-status" style="background-color:{{ '#6c7b89'|alpha(12) }};border-color:{{ '#6c7b89'|alpha(45) }};color:#6c7b89;">
                                    <i class="iconoir-{{ content.workflow_icon_string|first|default }}"></i>
                                </div>
                            {% endif %}
                            {% set status_color = '' %}
                        {% elseif ('now'|date('U') < content.pub_time |date('U')) %}
                            <div class="workflow-status" style="background-color:{{ '#5f84db'|alpha(12) }};border-color:{{ '#5f84db'|alpha(45) }};color:#5f84db;">
                                <i class="iconoir-calendar"></i>
                            </div>
                        {% endif %}
                        {% if content.workflow_state is not defined and content.published is defined and content.published == "true" and 'now'|date('U') > content.pub_time |date('U') %}
                            <div class="workflow-status" style="background-color:{{ '#00ae93'|alpha(12) }};border-color:{{ '#00ae93'|alpha(45) }};color:#00ae93;">
                                <i class="iconoir-check"></i>
                            </div>
                        {% elseif content.workflow_state is not defined and content.published is defined and content.published == "false" and 'now'|date('U') > content.pub_time |date('U')%}
                            <div class="workflow-status" style="background-color:{{ '#ababab'|alpha(12) }};border-color:{{ '#ababab'|alpha(45) }};color:#5b6b79;">
                                <i class="iconoir-edit-pencil"></i>
                            </div>
                        {% endif %}
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td class="title">{% trans %}No items found{% endtrans %}</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>

        <div class="flex flex-wrap ">
            {{ knp_pagination_render(pager, '@KnpPaginator/Pagination/sliding.html.twig') }}
        </div>
    </section>
{% endblock content_items %}

{% block javascript %}
    {{ parent() }}
    <script>
        (function() {
            var POLL_DELAY = 15000;
            var STORE_KEY = '__integratedContentNavigatorLockPolling';
            var BOOTSTRAP_KEY = '__integratedContentNavigatorLockBootstrap';
            var endpoint = '{{ path('integrated_content_content_locks_status')|e('js') }}';
            var lockedText = '{{ 'This item is locked'|trans|e('js') }}';
            var lockedByText = '{{ 'This item is locked by'|trans|e('js') }}';

            var initLockPolling = function() {
                var tableBody = document.getElementById('post-list');
                if (!tableBody) {
                    return;
                }

                var rows = Array.prototype.slice.call(tableBody.querySelectorAll('tr[data-lock-resource-type][data-lock-resource-id]'));
                if (!rows.length) {
                    return;
                }

                var existing = window[STORE_KEY];
                if (existing && typeof existing.stop === 'function') {
                    existing.stop();
                }

                var state = {
                    timer: null,
                    stopped: false
                };
                window[STORE_KEY] = state;

                var resources = rows.map(function(row) {
                    return {
                        type: row.getAttribute('data-lock-resource-type'),
                        id: row.getAttribute('data-lock-resource-id')
                    };
                });

                var toKey = function(type, id) {
                    return String(type) + '|' + String(id);
                };

                var renderLock = function(row, lockData) {
                    var slot = row.querySelector('[data-lock-slot]');
                    if (!slot) {
                        return;
                    }

                    slot.innerHTML = '';
                    if (!lockData) {
                        return;
                    }

                    var info = document.createElement('div');
                    info.className = 'locked-info';

                    var text = document.createElement('span');
                    text.className = 'locked-text';

                    var icon = document.createElement('i');
                    icon.className = 'iconoir-lock';
                    text.appendChild(icon);
                    text.appendChild(document.createTextNode('\u00A0'));

                    if (lockData.user) {
                        text.appendChild(document.createTextNode(lockedByText + ' ' + lockData.user));
                    } else {
                        text.appendChild(document.createTextNode(lockedText));
                    }

                    info.appendChild(text);
                    slot.appendChild(info);
                };

                var updateLocks = function(locks) {
                    rows.forEach(function(row) {
                        var key = toKey(row.getAttribute('data-lock-resource-type'), row.getAttribute('data-lock-resource-id'));
                        renderLock(row, locks[key] || null);
                    });
                };

                var scheduleNext = function() {
                    if (state.stopped) {
                        return;
                    }
                    state.timer = window.setTimeout(fetchLocks, POLL_DELAY);
                };

                var stop = function() {
                    if (state.stopped) {
                        return;
                    }
                    state.stopped = true;
                    if (state.timer) {
                        window.clearTimeout(state.timer);
                        state.timer = null;
                    }
                    document.removeEventListener('turbo:before-cache', onBeforeCache);
                    window.removeEventListener('pagehide', onPageHide);
                    if (window[STORE_KEY] === state) {
                        delete window[STORE_KEY];
                    }
                };

                var fetchLocks = function() {
                    if (state.stopped) {
                        return;
                    }

                    fetch(endpoint, {
                        method: 'POST',
                        credentials: 'same-origin',
                        headers: {
                            'Content-Type': 'application/json',
                            'X-Requested-With': 'XMLHttpRequest'
                        },
                        body: JSON.stringify({ resources: resources })
                    }).then(function(response) {
                        if (!response.ok) {
                            throw new Error('Lock status polling failed');
                        }

                        return response.json();
                    }).then(function(payload) {
                        if (!payload || typeof payload !== 'object' || !payload.locks || typeof payload.locks !== 'object') {
                            return;
                        }

                        updateLocks(payload.locks);
                    }).catch(function() {
                        // Keep current UI state on network errors.
                    }).finally(function() {
                        scheduleNext();
                    });
                };

                var onBeforeCache = function() {
                    stop();
                };
                var onPageHide = function() {
                    stop();
                };

                state.stop = stop;

                document.addEventListener('turbo:before-cache', onBeforeCache);
                window.addEventListener('pagehide', onPageHide);
                fetchLocks();
            };

            if (!window[BOOTSTRAP_KEY]) {
                document.addEventListener('turbo:load', initLockPolling);
                document.addEventListener('turbo:frame-load', function(event) {
                    if (event && event.target && event.target.id === 'content-navigator') {
                        initLockPolling();
                    }
                });
                window[BOOTSTRAP_KEY] = true;
            }

            initLockPolling();
        })();
    </script>
{% endblock %}
