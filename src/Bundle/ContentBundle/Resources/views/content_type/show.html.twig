{% extends '@IntegratedContent/base.html.twig' %}
{% block title %}{% trans %}Show {% endtrans %} {{ contentType.name }}{% endblock title %}
{% block content %}
    <div class="row">
        <div class="index-wrapper-full">
            {{ component('integrated_admin:page_title', {
                title: 'Show'|trans ~ ' ' ~ contentType.name,
            }) }}
            {% component 'integrated_admin:section_card' with {
                extraClass: 'section-padding',
            } %}
                {% block content %}
                <a class="btn btn-primary" href="{{ path('integrated_content_content_type_index') }}">{% trans %}Back to Overview{% endtrans %}</a>
                {% set fieldsTableHeadHtml %}
                    <tr>
                        <th width="40%">{% trans %}Field{% endtrans %}</th>
                        <th>{% trans %}Required{% endtrans %}</th>
                    </tr>
                {% endset %}
                {% set fieldsTableBodyHtml %}
                    {% for field in contentType.fields %}
                        <tr>
                            <td>
                                {{ field.label|trans }}
                            </td>
                            <td>
                                {% if field.options.required is empty %}
                                    {% trans %}No{% endtrans %}
                                {% else %}
                                    {% trans %}Yes{% endtrans %}
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                {% endset %}
                {% set fieldsTableHtml %}
                    {{ component('integrated_admin:data_table', {
                        headHtml: fieldsTableHeadHtml,
                        bodyHtml: fieldsTableBodyHtml,
                        emptyMessage: 'No fields added'|trans,
                        colSpan: 2,
                    }) }}
                {% endset %}
                {% set relationsListHtml %}
                    {{ render(controller("Integrated\\Bundle\\ContentBundle\\Controller\\RelationController::index", {'contentType': contentType.id, '_format': 'inline.html'})) }}
                {% endset %}
                {{ component('integrated_admin:detail_list', {
                    rows: [
                        {term: 'Name'|trans, value: contentType.name},
                        {term: 'Type'|trans, value: contentType.id},
                        {term: 'Fields'|trans, valueHtml: fieldsTableHtml},
                        {term: 'Relations'|trans, valueHtml: relationsListHtml},
                    ],
                }) }}

                <a class="btn btn-primary" style="margin-right:10px;" href="{{ path('integrated_content_content_type_edit', {'id': contentType.id}) }}">
                    {% trans %}Edit{% endtrans %}
                </a>

                {% if not contentType.locked %}
                    {{ form(form, { 'style': 'inline' }) }}
                {% endif %}
                {% endblock %}
            {% endcomponent %}
        </div>
    </div>
{% endblock %}
