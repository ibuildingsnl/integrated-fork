{% extends '@IntegratedContent/base.html.twig' %}
{% block title %}{% trans %}Delete{% endtrans %} {{ contentType.name }}{% endblock title %}

{% block content %}
    {% block form_start %}
        {{ form_start(form) }}
    {% endblock %}
    {% set contentTypeDeleteToolbarHtml %}
        {% block toolbar %}
            {% include '@IntegratedContent/partials/block.toolbar.html.twig' %}
        {% endblock toolbar %}
    {% endset %}
    {% set contentTypeDeleteTitleHtml %}
        {{ component('integrated_admin:page_title', {
            title: 'Delete'|trans ~ ' ' ~ contentType.name,
        }) }}
    {% endset %}
    {% set contentTypeDeleteContentHtml %}
        <p>
            {% trans with {'%name%': contentType.title|default(contentType.name|default(contentType.id)) } %}
                You are about to delete "%name%", click the delete button below to confirm the action.
            {% endtrans %}
        </p>
        {{ form_rest(form, {'style':'horizontal'})}}
        {% if hasRelatedContent %}
            {{ component('integrated_admin:alert_box', {
                variant: 'warning',
                bodyHtml: 'This content type has related content. Select "Delete related content" to remove that content before deleting this content type.'|trans,
            }) }}
        {% endif %}
    {% endset %}
    {{ component('integrated_admin:edit_form_shell', {
        toolbarHtml: contentTypeDeleteToolbarHtml,
        pageTitleHtml: contentTypeDeleteTitleHtml,
        editorContentHtml: contentTypeDeleteContentHtml,
    }) }}
    {% block form_end %}
        {{ form_end(form) }}
    {% endblock %}
{% endblock %}
