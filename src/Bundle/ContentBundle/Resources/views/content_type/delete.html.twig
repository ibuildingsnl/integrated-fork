{% extends '@IntegratedContent/base.html.twig' %}
{% block title %}{% trans %}Delete{% endtrans %} {{ contentType.name }}{% endblock title %}

{% block content %}
    <div class="flex flex-wrap edit-form">
        {% block form_start %}
            {{ form_start(form) }}
        {% endblock %}
        {% block toolbar %}
            {% include '@IntegratedContent/partials/block.toolbar.html.twig' %}
        {% endblock toolbar %}
        <div class="aside-options"></div>
        <div class="editor-wrapper">
            {{ component('integrated_admin:page_title', {
                title: 'Delete'|trans ~ ' ' ~ contentType.name,
            }) }}
            <section class="editor editor-wrapped">
                <p>
                    {% trans with {'%name%': contentType.title|default(contentType.name|default(contentType.id)) } %}
                        You are about to delete "%name%", click the delete button below to confirm the action.
                    {% endtrans %}
                </p>
                {{ form_rest(form, {'style':'horizontal'})}}
                {% if hasRelatedContent %}
                    <div class="alert alert-warning">
                        {% trans %}This content type has related content. Select "Delete related content" to remove that content before deleting this content type.{% endtrans %}
                    </div>
                {% endif %}
            </section>
        </div>
        {% block form_end %}
            {{ form_end(form) }}
        {% endblock %}
    </div>
{% endblock %}
