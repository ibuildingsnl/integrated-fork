{% extends '@IntegratedContent/base.html.twig' %}
{% block title %}{% trans %}Select content type{% endtrans %}{% endblock title %}

{% block content %}
    <div class="row">
        <div class="index-wrapper-full">
            {{ component('integrated_admin:page_title', {
                title: 'Select document type'|trans,
            }) }}
            {% component 'integrated_admin:section_card' with {
                extraClass: 'section-padding',
            } %}
                {% block content %}
                <form method="get" action="{{ path('integrated_content_content_type_new') }}">
                    <div class="form-group">
                        <label>Document type</label>
                        <select name="class" class="form-control">
                            {% for type in documentTypes %}
                                {% if type.type %}
                                    <option value="{{ type.class }}">{{ type.type }}</option>
                                {% endif %}
                            {% endfor %}
                        </select>
                    </div>
                    <button type="submit" class="btn btn-primary">
                        {% trans %}Submit{% endtrans %}
                    </button>
                </form>
                {% endblock %}
            {% endcomponent %}
        </div>
    </div>
{% endblock %}
