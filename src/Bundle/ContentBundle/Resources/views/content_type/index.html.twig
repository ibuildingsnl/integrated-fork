{% extends '@IntegratedContent/base.html.twig' %}
{% block title %}{% trans %}Content types{% endtrans %}{% endblock title %}

{% block content %}
    <div class="row flex flex-wrap h-full">
        <div class="index-wrapper-full">
            <div class="page-title">
                <h1 class="heading">{% trans %}Content types{% endtrans %}</h1>
                <ul class="options-no-bg">
                    <li class="dropdown close-outside" data-underlay="no">
                        <a data-toggle="dropdown" role="button" id="drop_1" class="btn btn-select">
                            <span>{% trans %}New{% endtrans %} {% trans %}content type{% endtrans %}</span>
                            <i class="iconoir-plus"></i>
                        </a>
                        <ul aria-labelledby="drop_1" role="menu" class="dropdown-menu" id="menu_1">
                            {% for type in documentTypes %}
                                {% if type.type %}
                                    <li role="presentation">
                                        <a href="{{ path('integrated_content_content_type_new') }}?class={{ type.class }}">
                                            {{ type.type }}
                                        </a>
                                    </li>
                                {% endif %}
                            {% endfor %}
                        </ul>
                    </li>
                </ul>
            </div>

            <h3 class="mt-8">{% trans %}Content Types{% endtrans %}</h3>
            {% include '@IntegratedContent/content_type/partial/list.html.twig' with {
                documents: documents,
                documentTypes: documentTypes,
                showDocumentTypes: ["Article", "News", "Product", "Person", "Comment", "JobPosting", "Company", "Form", "Event"]
            } %}

            <h3 class="mt-8">{% trans %}Taxonomy Types{% endtrans %}</h3>
            {% include '@IntegratedContent/content_type/partial/list.html.twig' with {
                documents: documents,
                documentTypes: documentTypes,
                showDocumentTypes: ["Taxonomy"]
            } %}

            <h3 class="mt-8">{% trans %}File Types{% endtrans %}</h3>
            {% include '@IntegratedContent/content_type/partial/list.html.twig' with {
                documents: documents,
                documentTypes: documentTypes,
                showDocumentTypes: ["Image", "File", "Video"]
            } %}

            <h3 class="mt-8">{% trans %}Custom Types{% endtrans %}</h3>
            {% include '@IntegratedContent/content_type/partial/list.html.twig' with {
                documents: documents,
                documentTypes: documentTypes,
                hideDocumentTypes: ["Article", "News", "Product", "Company", "Person", "Comment", "JobPosting", "Form", "Event", "Image", "File", "Video", "Taxonomy"],
            } %}
        </div>
    </div>
{% endblock %}
