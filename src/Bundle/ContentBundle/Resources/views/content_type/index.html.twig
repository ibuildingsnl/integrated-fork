{% extends '@IntegratedContent/base.html.twig' %}
{% block title %}{% trans %}Content types{% endtrans %}{% endblock title %}
{% block crumbs %}
    <div class="breadcrumb-holder">
        <div class="container">
            <ol class="breadcrumb">
                <li class="active">
                    {% trans %}Content types{% endtrans %}
                </li>
            </ol>
        </div>
    </div>
{% endblock %}
{% block content %}
    <div class="row flex flex-wrap">
        <div class="page-title">
            <h1 class="heading">{% trans %}Content types{% endtrans %}</h1>
            <ul class="options-no-bg">
                <li class="dropdown">
                    <a href="#" data-toggle="dropdown" role="button" id="drop_1" class="btn btn-select">
                        <span>{% trans %}New{% endtrans %} {% trans %}content type{% endtrans %}</span>
                        <i class="fa-solid fa-plus"></i>
                    </a>
                    <ul aria-labelledby="drop_1" role="menu" class="dropdown-menu" id="menu_1">
                        {% for type in documentTypes %}
                            {% if type.type %}
                                <li role="presentation">
                                    <a href="{{ path('integrated_content_content_type_new') }}?class={{ type.class }}">
                                        {{ type.type }}
                                    </a>
                                </li>
                            {% endif %}
                        {% endfor %}
                    </ul>
                </li>
            </ul>
        </div>
        <div class="w-full mb-4 md:mb-0">
            <section class="section-white section-radius">
                <table class="table table-hover">
                    <thead>
                    <tr>
                        <th>{% trans %}Name{% endtrans %}</th>
                        <th>{% trans %}ID{% endtrans %}</th>
                        <th>{% trans %}Document type{% endtrans %}</th>
                        <th>{% trans %}Created{% endtrans %}</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for document in documents %}
                        <tr class="has-options">
                            <td>
                                <strong>
                                    <a href="{{ path('integrated_content_content_type_edit', {id: document.id}) }}">
                                        {{ document.name }}
                                    </a>
                                </strong>
                                <div class="row-options">
                                    <a href="{{ path('integrated_content_content_type_edit', {'id': document.id}) }}"
                                       title="{% trans %}Edit{% endtrans %}">
                                        {% trans %}Edit{% endtrans %}
                                    </a> |
                                    <a class="color-red"
                                       href="{{ path('integrated_content_content_type_delete_rest', {'id': document.id}) }}"
                                       title="{% trans %}Delete{% endtrans %}">
                                        {% trans %}Delete{% endtrans %}
                                    </a>
                                </div>
                            </td>
                            <td>
                                {{ document.id }}
                            </td>
                            <td>
                                {% for type in documentTypes %}
                                    {% if type.class == document.class %}
                                        {{ type.type }}
                                    {% endif %}
                                {% endfor %}
                            </td>
                            <td>
                                {{ document.createdAt|format_date("medium", "none") }}
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="4">
                                {% trans %}No content types added{% endtrans %}
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </section>
        </div>
    </div>
{% endblock %}
