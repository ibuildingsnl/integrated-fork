{% extends '@IntegratedContent/base.html.twig' %}
{% block title %}{% trans %}Edit{% endtrans %} {{ contentType.name }}{% endblock title %}

{% block content %}
    <div class="flex flex-wrap edit-form">
        {% block form_start %}
            {{ form_start(form) }}
        {% endblock %}
        {% block toolbar %}
            {% include '@IntegratedContent/partials/block.toolbar.html.twig' %}
        {% endblock toolbar %}
        <div class="aside-options">
            <aside>
                <div class="aside-holder">
                    {% block sidebar %}
                        <div class="aside-header">
                            <button class="toggle-filters toggle-options-sidebar"  data-target="aside-options" type="button">
                                <i class="iconoir-xmark"></i></button>
                            <span>{% trans %}Options{% endtrans %}</span>
                        </div>
                        {% block content_meta %}
                            {% for child in form|filter(row => row.vars.attr.location|default == constant('Integrated\\Common\\Form\\Mapping\\Attributes\\Field::LOCATION_SIDEBAR'))  %}
                                {{ form_row(child) }}
                            {% endfor %}
                        {% endblock %}
                    {% endblock %}
                    <div class="aside-item-wrapper show">
                        <div class="aside-item-header">
                            <h3 class="aside-item-title">
                                <i class="iconoir-info-circle"></i>
                                <span class="aside-item-icon">{% trans %}Relations{% endtrans %}</span>
                            </h3>
                            <i class="iconoir-nav-arrow-up"></i>
                        </div>
                        <div class="aside-item-list">
                            <div class="aside-item-list-container">
                                {{ render(controller("Integrated\\Bundle\\ContentBundle\\Controller\\RelationController::index", {'contentType': contentType.id, '_format': 'inline.html'})) }}
                            </div>
                        </div>
                    </div>
                </div>
            </aside>
        </div>
        <div class="editor-wrapper">
            <div class="page-title">
                <h1 class="heading">{% trans %}Edit {% endtrans %} {{ contentType.name }}</h1>
            </div>
            <section class="editor">
                {% block content_form %}
                    {% for child in form|filter(row => row.vars.attr.location|default == constant('Integrated\\Common\\Form\\Mapping\\Attributes\\Field::LOCATION_EDITOR'))  %}
                        {{ form_row(child) }}
                    {% endfor %}

                    {{ form_errors(form) }}

                    {{ form_rest(form, {'style':'editor', 'state':'show'}) }}
                {% endblock %}
            </section>
        </div>


        {% block form_end %}
            {{ form_end(form) }}
        {% endblock %}
    </div>
{% endblock %}

{% block javascript %}
{{ parent() }}

<script type="text/javascript">
    $(function () {
        $('[data-toggle="popover"]').popover();
    });
</script>
{% endblock %}

{% block webpack_js %}
    <script src="{{ asset('bundles/integratedintegrated/edit.js') }}"></script>
{% endblock %}

