{% extends '@IntegratedContent/base.html.twig' %}
{% block title %}{% trans %}New content type{% endtrans %}{% endblock title %}

{% block content %}
    {% block form_start %}
        {{ form_start(form) }}
    {% endblock %}
    {% set contentTypeNewToolbarHtml %}
        {% block toolbar %}
            {% include '@IntegratedContent/partials/block.toolbar.html.twig' %}
        {% endblock toolbar %}
    {% endset %}
    {% set contentTypeNewSidebarHtml %}
        <aside>
            <div class="aside-holder">
                {% block sidebar %}
                    <div class="aside-header">
                        <button class="toggle-filters toggle-options-sidebar"  data-target="aside-options" type="button">
                            <i class="iconoir-xmark"></i></button>
                        <span>{% trans %}Options{% endtrans %}</span>
                    </div>
                    {% block content_meta %}
                        {% for child in form|filter(row => row.vars.attr.location|default == constant('Integrated\\Common\\Form\\Mapping\\Attributes\\Field::LOCATION_SIDEBAR'))  %}
                            {{ form_row(child) }}
                        {% endfor %}
                    {% endblock %}
                {% endblock %}
            </div>
        </aside>
    {% endset %}
    {% set contentTypeNewTitleHtml %}
        {{ component('integrated_admin:page_title', {
            title: 'New'|trans ~ ' ' ~ 'ContentType',
        }) }}
    {% endset %}
    {% set contentTypeNewEditorContentHtml %}
        {% block content_form %}
            {% for child in form|filter(row => row.vars.attr.location|default == constant('Integrated\\Common\\Form\\Mapping\\Attributes\\Field::LOCATION_EDITOR'))  %}
                {{ form_row(child) }}
            {% endfor %}

            {{ form_rest(form, {'style':'editor', 'state':'show'})}}
        {% endblock %}
    {% endset %}
    {{ component('integrated_admin:edit_form_shell', {
        toolbarHtml: contentTypeNewToolbarHtml,
        sidebarContentHtml: contentTypeNewSidebarHtml,
        pageTitleHtml: contentTypeNewTitleHtml,
        editorContentHtml: contentTypeNewEditorContentHtml,
        editorClass: '',
    }) }}
    {% block form_end %}
        {{ form_end(form) }}
    {% endblock %}
{% endblock %}

{% block webpack_js %}
    {{ parent() }}
    <script src="{{ asset('bundles/integratedintegrated/collection.js') }}" defer data-turbo-track="reload"></script>
{% endblock %}
