{% extends '@IntegratedContent/base.html.twig' %}
{% block title %}{% trans %}New content type{% endtrans %}{% endblock title %}
{% block crumbs %}
    <div class="breadcrumb-holder">
        <div class="container">
            <ol class="breadcrumb">
                <li>
                    <a href="{{ path('integrated_content_content_type_index') }}">{% trans %}Content types{% endtrans %}</a>
                </li>
                <li class="active">{% trans %}New{% endtrans %}</li>
            </ol>
        </div>
    </div>
{% endblock %}
{% block content %}
    <div class="row">
        <div class="w-full mb-4 md:mb-0">
            <div class="page-title">
                <h1 class="heading">{% trans %}New content type{% endtrans %}</h1>
            </div>
            <section class="section-white section-padding section-radius">
                <a class="btn btn-primary" href="{{ path('integrated_content_content_type_index') }}">{% trans %}Back to Overview{% endtrans %}</a>
                {{ form(form, { 'style': 'horizontal' }) }}
            </section>
        </div>
    </div>
{% endblock %}
