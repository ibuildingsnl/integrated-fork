{% extends '@IntegratedContent/base.html.twig' %}
{% block title %}{% trans %}Delete search selection{% endtrans %}{% endblock title %}

{% block content %}
    {% block form_start %}
        {{ form_start(form) }}
    {% endblock %}
    {% set searchSelectionDeleteToolbarHtml %}
        {% block toolbar %}
            {% include '@IntegratedContent/partials/block.toolbar.html.twig' %}
        {% endblock toolbar %}
    {% endset %}
    {% set searchSelectionDeleteTitleHtml %}
        {{ component('integrated_admin:page_title', {
            title: 'Delete'|trans ~ ' ' ~ ('relation'|trans),
        }) }}
    {% endset %}
    {% set searchSelectionDeleteContentHtml %}
        <p>
            {% trans with {'%name%':  searchSelection.title} %}You are about to delete "%name%", click the delete button below to confirm the action.{% endtrans %}
        </p>
        {{ form_rest(form, {'style':'horizontal'})}}
        {% if referenced %}
            {% include '@IntegratedContent/referencedAlert.html.twig' with {'referenced':referenced} only %}
        {% endif %}
    {% endset %}
    {{ component('integrated_admin:edit_form_shell', {
        toolbarHtml: searchSelectionDeleteToolbarHtml,
        pageTitleHtml: searchSelectionDeleteTitleHtml,
        editorContentHtml: searchSelectionDeleteContentHtml,
    }) }}
    {% block form_end %}
        {{ form_end(form) }}
    {% endblock %}
{% endblock %}
