{% extends '@IntegratedContent/base.html.twig' %}
{% block title %}{% trans %}Delete search selection{% endtrans %}{% endblock title %}
{% block crumbs %}
    <div class="breadcrumb-holder">
        <div class="container">
            <ol class="breadcrumb">
                <li>
                    <a href="{{ path('integrated_content_search_selection_index') }}">{% trans %}Home{% endtrans %}</a>
                </li>
                <li class="active">{% trans %}Delete{% endtrans %}</li>
            </ol>
        </div>
    </div>
{% endblock %}
{% block content %}
    <div class="row">
        <div class="w-full mb-4 md:mb-0">
            <div class="page-title">
                <h1 class="heading">{% trans %}Delete search selection{% endtrans %} <small></h1>
            </div>
            <section class="section-white section-padding section-radius">
                <p>
                    {% trans with {'%name%':  searchSelection.title} %}You are about to delete "%name%", click the delete button below to confirm the action.{% endtrans %}
                </p>
                {% if referenced %}
                    {% include '@IntegratedContent/referencedAlert.html.twig' with {'referenced':referenced} only %}
                {% endif %}
                {{ form(form) }}
            </section>
        </div>
    </div>
{% endblock %}
