{% extends '@IntegratedContent/base.html.twig' %}
{% block title %}{% trans %}Delete search selection{% endtrans %}{% endblock title %}

{% block content %}
    <div class="flex flex-wrap edit-form">
        {% block form_start %}
            {{ form_start(form) }}
        {% endblock %}
        {% block toolbar %}
            {% include '@IntegratedContent/partials/block.toolbar.html.twig' %}
        {% endblock toolbar %}
        <div class="aside-options"></div>
        <div class="editor-wrapper">
            {{ component('integrated_admin:page_title', {
                title: 'Delete'|trans ~ ' ' ~ ('relation'|trans),
            }) }}
            <section class="editor editor-wrapped">
                <p>
                    {% trans with {'%name%':  searchSelection.title} %}You are about to delete "%name%", click the delete button below to confirm the action.{% endtrans %}
                </p>
                {{ form_rest(form, {'style':'horizontal'})}}
                {% if referenced %}
                    {% include '@IntegratedContent/referencedAlert.html.twig' with {'referenced':referenced} only %}
                {% endif %}
            </section>
        </div>
        {% block form_end %}
            {{ form_end(form) }}
        {% endblock %}
    </div>
{% endblock %}
