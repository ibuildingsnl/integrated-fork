{% extends '@IntegratedContent/base.html.twig' %}
{% block title %}{% trans %}New search selection{% endtrans %}{% endblock title %}
{% block crumbs %}
    <div class="breadcrumb-holder">
        <div class="container">
            <ol class="breadcrumb">
                <li>
                    <a href="{{ path('integrated_content_search_selection_index') }}">{% trans %}Home{% endtrans %}</a>
                </li>
                <li class="active">{% trans %}New{% endtrans %}</li>
            </ol>
        </div>
    </div>
{% endblock %}
{% block content %}
    <div class="row">
        <div class="w-full mb-4 md:mb-0">
            <div class="page-title">
                <h1 class="heading">{% trans %}New{% endtrans %} search selection</h1>
            </div>
            <section class="section-white section-padding section-radius">
                {{ form(form, {'style': 'horizontal'}) }}
            </section>
        </div>
    </div>
{% endblock %}
