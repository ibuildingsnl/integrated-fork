{% extends '@IntegratedContent/base.html.twig' %}
{% block title %}{% trans %}Edit search selection{% endtrans %}{% endblock title %}
{% block content %}
    {% block form_start %}
        {{ form_start(form) }}
    {% endblock %}
    {% set searchSelectionEditToolbarHtml %}
        {% block toolbar %}
            {% include '@IntegratedContent/partials/block.toolbar.html.twig' %}
        {% endblock toolbar %}
    {% endset %}
    {% set searchSelectionEditTitleHtml %}
        {{ component('integrated_admin:page_title', {
            title: 'Edit'|trans ~ ' ' ~ ('search selection'|trans),
        }) }}
    {% endset %}
    {% set searchSelectionEditContentHtml %}
        {{ form_rest(form, {'style':'horizontal', 'state': 'show'})}}
    {% endset %}
    {{ component('integrated_admin:edit_form_shell', {
        toolbarHtml: searchSelectionEditToolbarHtml,
        pageTitleHtml: searchSelectionEditTitleHtml,
        editorContentHtml: searchSelectionEditContentHtml,
    }) }}
    {% block form_end %}
        {{ form_end(form) }}
    {% endblock %}
{% endblock %}

{% block javascript %}
    {{ parent() }}
    {% include '@IntegratedContent/search_selection/_sorting_script.html.twig' %}
{% endblock %}
