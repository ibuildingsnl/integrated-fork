<li class="dropdown close-outside" data-underlay="no">
    <a data-toggle="dropdown" role="button" class="btn btn-select space-between"><span>{% trans %}Search selections{% endtrans %}</span> <i class="iconoir-nav-arrow-down"></i></a>

    {% set selected = filters.searchSelection|default(null) %}
    <ul role="menu" class="dropdown-menu">

        {% for searchSelection in searchSelections %}

            {% if searchSelection.id == selected %}
                <li role="presentation" class="active">
                    <a role="menuitem"><b>{{ searchSelection.title }}</b></a>
                </li>
            {% else %}
                <li role="presentation">
                    <a href="{{ path('integrated_content_content_index', { 'searchSelection': searchSelection.id }) }}" tabindex="-1" role="menuitem">
                        {{ searchSelection.title }}
                    </a>
                </li>
            {% endif %}

        {% endfor %}

        <li role="presentation">
            {% if selected %}
{#                @todo#}
{#                <a href="{{ path('integrated_content_search_selection_update', filters) }}" tabindex="-1" role="menuitem">#}
{#                    <b>{% trans %}Update current search{% endtrans %}</b>#}
{#                </a>#}
            {% endif %}
            <a href="{{ path('integrated_content_search_selection_new', filters) }}" tabindex="-1" role="menuitem">
                <b>{% trans %}Save current search{% endtrans %}</b>
            </a>
        </li>

    </ul>
</li>
