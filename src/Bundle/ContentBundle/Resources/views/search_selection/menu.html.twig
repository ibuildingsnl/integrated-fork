{% set selected = filters.searchSelection|default(null) %}

<li class="dropdown close-outside" data-underlay="no">
    <a data-toggle="dropdown" role="button"
       class="btn btn-select space-between"><span>{% trans %}Search selections{% endtrans %}</span> <i
            class="iconoir-nav-arrow-down"></i></a>

    <ul role="menu" class="dropdown-menu">

        {% for searchSelection in searchSelections %}

            {% if searchSelection.id == selected %}
                <li role="presentation" class="active">
                    <a role="menuitem"><b>{{ searchSelection.title }}</b></a>
                </li>
            {% else %}
                <li role="presentation">
                    <a href="{{ path('integrated_content_content_index', { 'searchSelection': searchSelection.id }) }}"
                       tabindex="-1" role="menuitem">
                        {{ searchSelection.title }}
                    </a>
                </li>
            {% endif %}

        {% endfor %}

        <li role="presentation">
            <a href="{{ path('integrated_content_search_selection_new', filters) }}" tabindex="-1" role="menuitem">
                <b>{% trans %}Save current search{% endtrans %}</b>
            </a>
        </li>

    </ul>
</li>

{% if selected %}
    <a href="{{ path('integrated_content_search_selection_edit', {'id': selected} + filters) }}"
       class="btn btn-green update-search">
        {% trans %}Update current search{% endtrans %}
    </a>
{% endif %}
