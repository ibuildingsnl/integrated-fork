{% block integrated_global_publication_settings_row %}
    <div class="publishable">
        <h3>{% trans %}Publish to{% endtrans %} {{ form.vars.attr['data-channel-type'] }}</h3>
        <div class="form-item w-full flex flex-wrap channels integrated_channel_choice"><label
                class="control-label w-full md:w-3/12 xl:w-2/12 3xl:w-1/12">{% trans %}Channels{% endtrans %}</label>
            <div class="w-full md:w-9/12 xl:w-10/12 3xl:w-11/12 widget">
                <select class="select2 select2-hidden-accessible" multiple="" data-apply-channels="true">
                </select>
            </div>
        </div>
        {{ form_widget(form) }}
        <div class="flex justify-between mt-8">
            <a href="#" class="apply btn btn-green">{% trans %}Apply{% endtrans %}</a>
            <a href="#" class="cancel btn btn-white">{% trans %}Cancel{% endtrans %}</a>
        </div>
    </div>
{% endblock %}

{% block integrated_content_bulk_actions_row %}
    {{ form_widget(form) }}
{% endblock %}

{% block integrated_content_bulk_action_row %}
    {% apply spaceless %}
        <div class="form-group w-full flex flex-wrap{% if not form.active.vars['data'] %} hidden{% endif %}">

            <div class="w-full hidden" data-action-toggle="1">
                {{ form_row(form.active, {'no_form_group': true}) }}
            </div>

            <div class="w-full{% if not form.active.vars['data'] %} hidden{% endif %}">
                <div class="bulk-action-title">{{ form.active.vars.label|trans({}, translation_domain) }}</div>
                {{ form_widget(form.action) }}
            </div>

        </div>
    {% endapply %}
{% endblock %}

{% block integrated_content_bulk_action_readonly_row %}
    {% apply spaceless %}
        <div class="form-group w-full flex flex-wrap">
            {% if form.active is defined %}
                <div class="w-full">
                    <div class="bulk-action-title">{{ form.active.vars.label|trans({}, translation_domain) }}</div>
                </div>
            {% endif %}
            <div class="w-full sm:w-3/4">
                {{ form_widget(form.action) }}
            </div>
        </div>
    {% endapply %}
{% endblock %}

{% block integrated_content_bulk_action_relation_widget %}
    {% apply spaceless %}
        {% set dataValue = form.references.vars.value|json_encode %}
        {% if form.references.vars.relation_type|default('') == 'taxonomy_category' %}
            {% set taxonomyValue = [] %}
            {% set referencesData = form.vars.data.references|default(form.references.vars.data|default([])) %}
            {% for reference in referencesData %}
                {% set referenceId = reference.getId|default(reference.id|default(reference.taxonomyId|default(reference))) %}
                {% if referenceId is not empty %}
                    {% set taxonomyValue = taxonomyValue|merge([referenceId]) %}
                {% endif %}
            {% endfor %}
            {% set dataValue = taxonomyValue|json_encode %}
            <div class="aside-item-wrapper">
                <div class="aside-item-list">
                    <div class="aside-item-list-container relation">
                        {% include '@IntegratedContent/bulk/partial/category_selection_component.html.twig' with {
                            relation: form.references,
                            dataValue: dataValue,
                        } %}
                    </div>
                </div>
            </div>
        {% else %}
            <div class="relation">
                {{ form_widget(form.references, {'attr': {'data-value': dataValue}}) }}
            </div>
        {% endif %}

        {% if form.replaceExisting is defined %}
            <div class="bulk-relation-options">
                <span class="bulk-relation-options-label">{{ form.replaceExisting.vars.label|trans({}, translation_domain) }}</span>
                <label class="checkbox-switcher">
                    {{ form_widget(form.replaceExisting) }}
                </label>
                {{ form_errors(form.replaceExisting) }}
            </div>
        {% endif %}
    {% endapply %}
{% endblock %}

{% block integrated_content_bulk_action_relation_readonly_widget %}
    {{ block('integrated_content_bulk_action_relation_widget') }}
{% endblock %}

{% block integrated_permissions_row %}
    {% apply spaceless %}
        {{ block('form_rows') }}
    {% endapply %}
{% endblock %}
