{% use "@IntegratedFormType/form/form_div_layout.html.twig" %}

{% block integrated_content_type_default_fields_row %}
    {{ form_row(form, {widget_col: 'w-full'}) }}
{% endblock %}

{% block integrated_content_type_default_fields_widget %}
    {% apply spaceless %}
        <div class="flex flex-wrap">
            {% for field in form %}
                <div class="flex w-full mb-3 contenttypes">
                    <div class="w-full enabled">
                        {% set element = field.enabled %}
                        {{ block('content_type_checkbox_widget') }}
                    </div>
                    <div class="options">
                        {% if field.value is defined %}
                            <div class="default">
                                <div class="checkbox">
                                    <label class="checkbox-container">
                                        {{ form_widget(field.value) }}
                                        <span class="checkbox-label">Default</span>
                                        <span class="checkbox-label-mobile">Def.</span>
                                    </label>
                                </div>
                            </div>
                        {% endif %}
                        <div class="required">
                            <div class="checkbox">
                                <label class="checkbox-container">
                                    {{ form_widget(field.required) }}
                                    <span class="checkbox-label">Required</span>
                                    <span class="checkbox-label-mobile">Req.</span>
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endapply %}
{% endblock %}

{% block content_type_checkbox_widget %}
    {% apply spaceless %}
        <div class="checkbox">
            {% if element.vars.label is not same as(false) %}
                {% set option_channel = null %}
                {% if element.vars.value is defined and element.vars.value is not empty %}
                    {% set option_channel_value = element.vars.value %}
                    {% if option_channel_value.id is defined %}
                        {% set option_channel = option_channel_value %}
                    {% elseif option_channel_value is not iterable %}
                        {% set option_channel = option_channel_value|integrated_channel %}
                    {% endif %}
                {% endif %}
                {% set option_brand_profile = option_channel ? (option_channel|integrated_brand_profile) : null %}
                {% set option_brand_color = option_brand_profile.color|default('') %}
                {% set option_brand_secondary_color = option_brand_profile.secondaryColor|default(option_brand_profile.secondarycolor|default(option_brand_color)) %}
                {% set option_brand_color_dark = option_brand_color ? (option_brand_color|darken(20)) : '' %}
                {% set option_brand_secondary_color_dark = option_brand_secondary_color ? (option_brand_secondary_color|darken(20)) : '' %}
                <label class="checkbox-container" for="{{ element.vars.id }}">
                    <input id="{{ element.vars.id }}" name="{{ element.vars.full_name }}"
                           type="checkbox"
                           {% if element.vars.value is defined %} value="{{ element.vars.value }}"{% endif %}
                           {% if option_brand_color %} data-channel-brand-color="{{ option_brand_color }}"{% endif %}
                           {% if option_brand_secondary_color %} data-channel-brand-secondary-color="{{ option_brand_secondary_color }}"{% endif %}
                           {% if option_brand_color_dark %} data-channel-brand-color-dark="{{ option_brand_color_dark }}"{% endif %}
                           {% if option_brand_secondary_color_dark %} data-channel-brand-secondary-color-dark="{{ option_brand_secondary_color_dark }}"{% endif %}
                           {% if element.vars.checked %} checked="checked"{% endif %}/>
                    <span class="checkmark"></span>
                    <div class="background"></div>
                    {{ element.vars.label|trans({}, translation_domain) }}
                </label>
            {% else %}
                {{ form_widget(field) }}
            {% endif %}
        </div>
    {% endapply %}
{% endblock %}

{% block content_type_radio_widget %}
    {% apply spaceless %}
        <div class="radio">
            {% if element.vars.label is not same as(false) %}
                <label for="{{ element.vars.id }}">
                    <input id="{{ element.vars.id }}" name="{{ element.vars.full_name }}"
                           type="radio" {% if element.vars.value is defined %} value="{{ element.vars.value }}"{% endif %}{% if element.vars.checked %} checked="checked"{% endif %}/>
                    {{ element.vars.label|trans({}, translation_domain) }}
                </label>
            {% else %}
                {{ form_widget(field) }}
            {% endif %}
        </div>
    {% endapply %}
{% endblock %}

{% block translatable_text_widget %}
