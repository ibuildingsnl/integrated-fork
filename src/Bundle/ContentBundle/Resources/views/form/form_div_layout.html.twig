{% block integrated_publication_settings_row %}


    {% set status = form.vars.attr['data-publication-status']|default('') %}
    {% set icon = form.vars.attr['data-channel-type-icon']|default('telegram') %}
    <div class="aside-options publication-settings-aside {% if status is same as 'success' %}no-edit{% endif %}">
        <div class="publication-settings-popup aside-item-wrapper show">
            <div class="aside-item-header">
                <h3 class="aside-item-title">
                    <i class="iconoir-{{ icon }}"></i>
                    <span class="aside-item-icon">{{ form_label(form) }}</span>
                </h3>
            </div>
            <div class="aside-item-list-container">
                {% if status is same as 'success' %}
                    <p class="publication-info">{% trans %}You have already published to{% endtrans %} {{ form_label(form) }} {% trans %}, do you want to make a new publication?{% endtrans %}</p>
                    <div class="checkbox new-publication-check">
                        <label class="checkbox-container mb-4" for="new-publication-check-{{ form.vars.label|default(form.vars.name)|lower|replace({' ': '_'}) }}">
                            <input type="checkbox" id="new-publication-check-{{ form.vars.label|default(form.vars.name)|lower|replace({' ': '_'}) }}" name="new-publication-check-{{ form.vars.label|default(form.vars.name)|lower|replace({' ': '_'}) }}" class="new-publication-check" value="">
                            <span class="checkmark"></span>
                            <div class="background"></div>
                            {% trans %}Create a new publication{% endtrans %}
                        </label>
                    </div>
                {% endif %}
                <div class="aside-item-list">
                    {{ form_widget(form) }}
                    <a class="btn btn-green mt-4" href="#">{% trans %}Apply{% endtrans %}</a>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block integrated_global_publication_settings_container_row %}

