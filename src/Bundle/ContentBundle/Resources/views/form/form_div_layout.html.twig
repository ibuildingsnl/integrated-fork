{% use "@IntegratedFormType/form/form_div_layout.html.twig" %}

{% block integrated_content_type_default_fields_row %}
    {{ form_row(form, {widget_col: 'w-full'}) }}
{% endblock %}

{% block integrated_content_type_default_fields_widget %}
    {% apply spaceless %}
        <div class="flex flex-wrap">
            {% for field in form %}
                <div class="flex w-full mb-3 contenttypes">
                    <div class="w-full enabled">
                        {% set element = field.enabled %}
                        {{ block('content_type_checkbox_widget') }}
                    </div>
                    <div class="options">
                        {% if field.value is defined %}
                            <div class="default">
                                <div class="checkbox">
                                    <label class="checkbox-container">
                                        {{ form_widget(field.value) }}
                                        <span class="checkbox-label">Default</span>
                                        <span class="checkbox-label-mobile">Def.</span>
                                    </label>
                                </div>
                            </div>
                        {% endif %}
                        <div class="required">
                            <div class="checkbox">
                                <label class="checkbox-container">
                                    {{ form_widget(field.required) }}
                                    <span class="checkbox-label">Required</span>
                                    <span class="checkbox-label-mobile">Req.</span>
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endapply %}
{% endblock %}

{% block content_type_checkbox_widget %}
    {% apply spaceless %}
        <div class="checkbox">
            {% if element.vars.label is not same as(false) %}
                <label class="checkbox-container" for="{{ element.vars.id }}">
                    <input id="{{ element.vars.id }}" name="{{ element.vars.full_name }}"
                           type="checkbox" {% if element.vars.value is defined %} value="{{ element.vars.value }}"{% endif %}{% if element.vars.checked %} checked="checked"{% endif %}/>
                    <span class="checkmark"></span>
                    <div class="background"></div>
                    {{ element.vars.label|trans({}, translation_domain) }}
                </label>
            {% else %}
                {{ form_widget(field) }}
            {% endif %}
        </div>
    {% endapply %}
{% endblock %}

{% block content_type_radio_widget %}
    {% apply spaceless %}
        <div class="radio">
            {% if element.vars.label is not same as(false) %}
                <label for="{{ element.vars.id }}">
                    <input id="{{ element.vars.id }}" name="{{ element.vars.full_name }}"
                           type="radio" {% if element.vars.value is defined %} value="{{ element.vars.value }}"{% endif %}{% if element.vars.checked %} checked="checked"{% endif %}/>
                    {{ element.vars.label|trans({}, translation_domain) }}
                </label>
            {% else %}
                {{ form_widget(field) }}
            {% endif %}
        </div>
    {% endapply %}
{% endblock %}

{% block translatable_text_widget %}
    {% apply spaceless %}
        {% for field in form %}
            <div class="input-group" style="margin-bottom: 15px">
            <span class="input-group-addon">
                {{ field.vars.label }}
            </span>
                {{ form_widget(field) }}
            </div>
        {% endfor %}
    {% endapply %}
{% endblock %}

{% block translatable_textarea_widget %}
    {% apply spaceless %}
        {% for field in form %}
            <div class="input-group" style="margin-bottom: 15px">
            <span class="input-group-addon">
                {{ field.vars.label }}
            </span>
                {{ form_widget(field) }}
            </div>
        {% endfor %}
    {% endapply %}
{% endblock %}

{% block integrated_content_relations_row %}
    <div class="form-relations" style="display: none;">
        {{ block('form_row') }}
    </div>
{% endblock %}

{% block integrated_file_row %}
    {% apply spaceless %}
        {% set widget_col = widget_col|default(tailwind_get_widget_col()) %}
        <div class="form-group w-full flex flex-wrap{% if not form.vars.valid %} has-error{% endif %}">
            {{ form_label(form) }}
            <div class="w-full {{ widget_col }}">
                {% set preview = form.vars.preview|default %}
                {% if preview %}
                    <a href="{{ preview }}" target="_blank" style="display: block; margin-bottom: 6px;">
                        {% trans %}Download{% endtrans %}
                    </a>
                {% endif %}
                {{ form_widget(form.file) }}
                {% if preview %}
                    {{ form_widget(form.remove) }}
                {% endif %}
                {{ form_errors(form.file) }}
            </div>
        </div>
    {% endapply %}
{% endblock %}

{% block integrated_image_row %}
    {% apply spaceless %}
        {% set widget_col = widget_col|default(tailwind_get_widget_col()) %}
        <div class="form-group w-full flex flex-wrap{% if not form.vars.valid %} has-error{% endif %}">
            {{ form_label(form) }}
            <div class="w-full {{ widget_col }}">
                {% set preview = form.vars.preview|default %}
                {% if preview %}
                    <img style="max-width: 200px; margin-bottom: 10px;" src="{{ image(preview) }}"/>
                {% endif %}
                {{ form_widget(form.file) }}
                {% if preview %}
                    {{ form_widget(form.remove) }}
                {% endif %}
                {{ form_errors(form.file) }}
            </div>
        </div>
    {% endapply %}
{% endblock %}

