        <div class="flex flex-wrap">
            {% for channel in form %}
                <div class="flex w-full mb-3 select-channels">
                    <div class="w-full selected">
                        {% set element = channel.selected %}
                        {{ block('content_type_checkbox_widget') }}
                    </div>
                    <div class="options">
                        <div class="restrict">
                            <div class="checkbox">
                                <label class="checkbox-container">
                                    {{ form_widget(channel.restrict) }}
                                    <span class="checkbox-label">Restrict</span>
                                    <span class="checkbox-label-mobile">R</span>
                                </label>
                            </div>
                        </div>
                        <div class="enforce">
