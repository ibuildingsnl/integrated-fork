{% block integrated_author_widget %}

    <div class="input-group input-group-author">
        <select multiple id="{{ id }}" name="{{ full_name }}[persons][]" class="w-full integrated_select2"
                style="width: 100%; padding: 0;">
            {% if value is not empty %}
                {% if value.persons is defined %}
                    {% for personId in value.persons %}
                        <option selected value="{{ personId }}">{{ personId }}</option>
                    {% endfor %}
                {% else %}
                    {% for item in value %}
                        <option selected value="{{ item.id|default(item) }}">{{ item.text|default(item.id|default(item)) }}</option>
                    {% endfor %}
                {% endif %}
            {% endif %}
        </select>
        <span class="input-group-btn">
            <button id="types-btn" type="button">
                <i class="iconoir-nav-arrow-down"></i>
            </button>
        </span>
    </div>

    <div style="clear: both;"></div>

    <div id="authorTypes">
        {% if value is not empty %}
            {% if value.persons is defined %}
                {% set authorTypes = value.types|default({}) %}
                {% for personId in value.persons %}
                    <div id="type_{{ personId }}" style="margin-top: 10px;" class="input-group input-group">
                        <span class="input-group-addon">
                            {{ personId }}
                        </span>
                        <input type="text"
                               class="form-control type-text"
                               name="{{ full_name }}[types][{{ personId }}]"
                               value="{{ authorTypes[personId]|default('') }}"
                               placeholder="Type"/>
                    </div>
                {% endfor %}
            {% else %}
                {% for item in value %}
                    <div id="type_{{ item.id|default(item) }}" style="margin-top: 10px;" class="input-group input-group">
                        <span class="input-group-addon">
                            {{ item.text|default(item.id|default(item)) }}
                        </span>
                        <input type="text"
                               class="form-control type-text"
                               name="{{ full_name }}[types][{{ item.id|default(item) }}]"
                               value="{{ item.type|default('') }}"
                               placeholder="Type"/>
                    </div>
                {% endfor %}
            {% endif %}
        {% endif %}
    </div>

    <script type="text/javascript">
        (function initIntegratedAuthorWidget() {
            var fieldSelector = '#{{ id }}';

            function setupAuthorWidget() {
                if (!window.jQuery || !window.jQuery.fn || typeof window.jQuery.fn.select2 !== 'function') {
                    return;
                }

                var $ = window.jQuery;
                var $field = $(fieldSelector);
                if (!$field.length) {
                    return;
                }

                $('.change-name-author').each(function() {
                    var currentName = $(this).attr('name');
                    $(this).attr('name', '{{ full_name }}[types][' + currentName + ']');
                });

                if (!$field.hasClass('select2-hidden-accessible')) {
                    $field.select2({
                        multiple: true,
                        ajax: {
                            url: "{{ path('integrated_content_content_index', { 'contenttypes': contentTypes|keys, '_format': 'json' })|raw }}",
                            dataType: 'json',
                            data: function(term, page) {
                                query = term.term ? term.term + '*' : '';
                                return {
                                    q: query,
                                    page_limit: 10,
                                };
                            },
                            processResults: function(data) {
                                $.map(data.items, function(item) {
                                    var value = item.title;
                                    if (this.authorValues === undefined) {
                                        this.authorValues = {};
                                    }
                                    if (this.authorValues[value] === undefined) {
                                        this.authorValues[value] = 1;
                                    } else {
                                        this.authorValues[value] = this.authorValues[value] + 1;
                                    }
                                });
                                return {
                                    results: $.map(data.items, function(item) {
                                        title = item.title;
                                        return {
                                            text: title,
                                            id: item.id,
                                        };
                                    }),
                                };
                            },
                        },
                        dropdownCssClass: 'bigdrop',
                    });
                }

                $field
                    .off('change.integratedAuthorWidget select2:select.integratedAuthorWidget select2:unselect.integratedAuthorWidget')
                    .on('change.integratedAuthorWidget', function(e) {
                        if (e.hasOwnProperty('removed')) {
                            $('#type_' + e.removed.id).remove();
                        }
                    })
                    .on('select2:select.integratedAuthorWidget', function(e) {
                        var data = e.params.data;
                        if ($('#type_' + data.id).length > 0) {
                            return;
                        }

                        $('#authorTypes').
                            append('<div id="type_' + data.id +
                                '" style="margin-top: 10px;" class="input-group input-group"><span class="input-group-addon">' +
                                data.text +
                                '</span><input type="text" class="form-control type-text" name="{{ full_name }}[types][' +
                                data.id + ']" placeholder="Type" /></div>');

                    })
                    .on('select2:unselect.integratedAuthorWidget', function(e) {
                        var id = e.params.data.id;
                        $('#type_' + id).remove();
                    });

                $('#types-btn')
                    .off('click.integratedAuthorWidget')
                    .on('click.integratedAuthorWidget', function() {
                        $('#authorTypes').toggle();
                    });

                {% if value is not empty %}
                {% autoescape false %}
                $field.select2('data', {{ value|json_encode() }});
                {% endautoescape %}
                {% endif %}
            }

            function scheduleAuthorWidgetSetup() {
                if (typeof window.IntegratedJQReady === 'function') {
                    window.IntegratedJQReady(function() {
                        setupAuthorWidget();
                    });
                } else {
                    setupAuthorWidget();
                }

                window.requestAnimationFrame(setupAuthorWidget);
                window.setTimeout(setupAuthorWidget, 80);
            }

            document.addEventListener('DOMContentLoaded', scheduleAuthorWidgetSetup);
            document.addEventListener('turbo:load', scheduleAuthorWidgetSetup);
            document.addEventListener('turbo:render', scheduleAuthorWidgetSetup);
            document.addEventListener('turbo:frame-load', scheduleAuthorWidgetSetup);
            document.addEventListener('turbo:frame-render', scheduleAuthorWidgetSetup);

            scheduleAuthorWidgetSetup();
        })();
    </script>
{% endblock %}


{% block integrated_seo_meta_widget %}

    {% set documentNode = form.parent.vars.data %}
    {% set pageTitle = attribute(documentNode, 'title')|default('') %}
    {% set pageDescription = attribute(documentNode, 'description')|default('') %}
    {% set pagePath = attribute(documentNode, 'path')|default('') %}
    {% set pageSeoMetadata = attribute(documentNode, 'seoMetadata')|default(null) %}
    {% set pageChannel = null %}
    {% if form.parent.channel is defined %}
        {% set pageChannel = form.parent.channel.vars.data|default(null) %}
    {% endif %}
    {% if not pageChannel and documentNode and documentNode.slug is not defined %}
        {% set pageChannel = attribute(documentNode, 'channel')|default(null) %}
    {% elseif not pageChannel and documentNode %}
        {% set pageChannel = attribute(documentNode, 'primaryChannel')|default(null) %}
    {% endif %}

    {% if documentNode.featuredImage.file is defined and documentNode.featuredImage.file is not null %}
        {% set featuredImage = image(documentNode.featuredImage.file).cropResize(512, 512).__toString %}
    {% else %}
        {% set featuredImage = asset('bundles/integratedintegrated/images/favicon/apple-touch-icon.png') %}
    {% endif %}

    {% if pageChannel|integrated_brand.favicon.file is defined and pageChannel|integrated_brand.favicon.file is not null %}
        {% set faviconSrc = image(pageChannel|integrated_brand.favicon.file).cropResize(50, 50).__toString %}
    {% else %}
        {% set faviconSrc = asset('bundles/integratedintegrated/images/favicon/favicon-32x32.png') %}
    {% endif %}

    {% if pageChannel is defined and pageChannel is not null %}
        {% set primaryDomain = pageChannel.primaryDomain %}
        {% set brandName = pageChannel.name|default|replace({' Website': ''}) %}
    {% else %}
        {% set primaryDomain = '' %}
        {% set brandName = '' %}
    {% endif %}
    {% set seoPlaceholderDefinitions = [
        {'token': '%%title%%', 'label': 'Titel'},
        {'token': '%%site_title%%', 'label': 'Sitetitel'},
        {'token': '%%separator%%', 'label': 'Scheidingsteken'},
        {'token': '%%slug%%', 'label': 'Slug'},
        {'token': '%%channel%%', 'label': 'Kanaal'}
    ] %}


    {% if documentNode.id is defined and documentNode.id is not null %}
        {% if documentNode.slug is defined %}
            {% set documentUrl = integrated_url(documentNode)|default("") %}
            {% set articleTitle = pageTitle %}
            {% set titleOverride = pageSeoMetadata.metaTitle|default(pageTitle) %}
            {% set description = pageSeoMetadata.metaDescription|default(documentNode.intro|default(pageDescription)) %}
            {% set focusKeyword = pageSeoMetadata.focusKeyphrase|default("") %}
            {% set uriPathSegment = documentNode.slug|default("/") %}
        {% else %}
            {% set documentUrl = pagePath|default("/") %}
            {% set articleTitle = pageTitle %}
            {% set titleOverride = pageSeoMetadata.metaTitle|default(pageTitle) %}
            {% set description = pageSeoMetadata.metaDescription|default(pageDescription) %}
            {% set focusKeyword = pageSeoMetadata.focusKeyphrase|default("") %}
            {% set uriPathSegment = pagePath|default("/") %}
        {% endif %}
    {% else %}
        {% set documentUrl = 'https://temporary.domain/temporary-slug' %}
        {% set articleTitle = '' %}
        {% set titleOverride = '' %}
        {% set description = '' %}
        {% set focusKeyword = '' %}
        {% set uriPathSegment = '' %}
    {% endif %}

    <div class="aside-options publication-settings-aside seo-settings">
        <div class="publication-settings-popup aside-item-wrapper show">
            <div class="yoast-seo__application" id="yoast-app"
                 data-configuration="{{ {
                     'title': articleTitle,
                     'titleOverride': titleOverride,
                     'description': description,
                     'focusKeyword': focusKeyword,
                     'isCornerstone': false,
                     'isAmp': false,
                     'uiLocale': 'nl_NL',
                     'translationsUrl': '/admin/_yoastseo/fetch-translations',
                     'workerUrl': asset('bundles/integratedcontent/js/webWorker.js'),
                     'baseUrl': 'https://' ~ primaryDomain,
                     'siteUrl': 'https://' ~ primaryDomain,
                     'brandName': brandName,
                     'channelName': pageChannel.name|default(brandName),
                     'titleSeparator': '|',
                     'pageUrl': documentUrl,
                     'analysisContentUrl': documentNode.id is defined and documentNode.id is not null and documentNode.slug is not defined ? path('integrated_page_page_seo_content', {'id': documentNode.id}) : null,
                     'uriPathSegment': uriPathSegment,
                     'seoPlaceholders': seoPlaceholderDefinitions,
                     'fieldSelectors': {
                         'title': '#' ~ form.parent.title.vars.id,
                         'titleOverride': '#' ~ form.metaTitle.vars.id,
                         'description': '#' ~ form.metaDescription.vars.id,
                         'focusKeyword': '#' ~ form.focusKeyphrase.vars.id,
                         'slug': form.parent.slug is defined ? '#' ~ form.parent.slug.vars.id : (form.parent.path is defined ? '#' ~ form.parent.path.vars.id : null),
                         'content': form.parent.content is defined ? '#' ~ form.parent.content.vars.id : null,
                         'seoScore': '#' ~ form.seoScore.vars.id,
                         'readabilityScore': '#' ~ form.readabilityScore.vars.id
                     },
                     'faviconSrc': faviconSrc,
                     'featuredImageSrc': featuredImage,
                     'twitterFallbackImage': asset('bundles/integratedcontent/twitter.svg'),
                     'openGraphFallbackImage': asset('bundles/integratedcontent/facebook.svg')
                 }|json_encode }}">
            </div>

            <div class="seo-metadata-fields">
                {{ form_widget(form) }}
            </div>
        </div>
    </div>

    {% integrated_javascripts mode='append' 'bundles/integratedcontent/js/seo_settings.js' %}
    {% endintegrated_javascripts %}
    {% integrated_javascripts mode='append' 'bundles/integratedcontent/js/yoastSeoApp.js' %}
    {% endintegrated_javascripts %}
    {% integrated_javascripts mode='append' 'bundles/integratedcontent/js/YoastSeo.js' %}
    {% endintegrated_javascripts %}
    {% integrated_stylesheets mode='append' 'bundles/integratedcontent/js/main.css' %}
    {% endintegrated_stylesheets %}
{% endblock %}

