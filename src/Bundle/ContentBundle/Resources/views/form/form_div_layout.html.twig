{% block integrated_author_widget %}

    <div class="input-group input-group-author">
        <select multiple id="{{ id }}" name="{{ full_name }}[persons][]" class="w-full integrated_select2"
                style="width: 100%; padding: 0;">
            {% if value is not empty %}
                {% for item in value %}
                    <option selected value="{{ item.id }}">{{ item.text }}</option>
                {% endfor %}
            {% endif %}
        </select>
        <span class="input-group-btn">
            <button id="types-btn" type="button">
                <i class="iconoir-nav-arrow-down"></i>
            </button>
        </span>
    </div>

    <div style="clear: both;"></div>

    <div id="authorTypes">
        {% if value is not empty %}
            {% for item in value %}
                <div id="type_{{ item.id }}" style="margin-top: 10px;" class="input-group input-group">
                    <span class="input-group-addon">
                        {{ item.text }}
                    </span>
                    <input type="text"
                           class="form-control type-text"
                           name="{{ full_name }}[types][{{ item.id }}]"
                           value="{{ item.type }}"
                           placeholder="Type"/>
                </div>
            {% endfor %}
        {% endif %}
    </div>

    <script type="text/javascript">
        document.addEventListener('DOMContentLoaded', function(event) {

            $('.change-name-author').each(function() {
                var id = $(this).attr('name');

                $(this).attr('name', '{{ full_name }}[types][' + id + ']');
            });

            $("#{{ id }}").select2({
                multiple: true,
                ajax: {
                    url: "{{ path('integrated_content_content_index', { 'contenttypes': contentTypes|keys, '_format': 'json' })|raw }}",
                    dataType: 'json',
                    data: function(term, page) {
                        query = term.term ? term.term + '*' : '';
                        return {
                            q: query,
                            page_limit: 10,
                        };
                    },
                    processResults: function(data) {
                        $.map(data.items, function(item) {
                            var value = item.title;
                            if (this.authorValues === undefined) {
                                this.authorValues = {};
                            }
                            if (this.authorValues[value] === undefined) {
                                this.authorValues[value] = 1;
                            } else {
                                this.authorValues[value] = this.authorValues[value] + 1;
                            }
                        });
                        return {
                            results: $.map(data.items, function(item) {
                                title = item.title;
                                return {
                                    text: title,
                                    id: item.id,
                                };
                            }),
                        };
                    },
                },
                dropdownCssClass: 'bigdrop',
            }).on('change', function(e) {
                if (e.hasOwnProperty('added')) {
                }

                if (e.hasOwnProperty('removed')) {
                    $('#type_' + e.removed.id).remove();
                }
            }).on('select2:select', function(e) {
                var data = e.params.data;
                $('#authorTypes').
                    append('<div id="type_' + data.id +
                        '" style="margin-top: 10px;" class="input-group input-group"><span class="input-group-addon">' +
                        data.text +
                        '</span><input type="text" class="form-control type-text" name="{{ full_name }}[types][' +
                        data.id + ']" placeholder="Type" /></div>');

            }).on('select2:unselect', function(e) {
                var id = e.params.data.id;
                $('#type_' + id).remove();
            });

            $('#types-btn').on('click', function(e) {
                $('#authorTypes').toggle();
            });

            {% if value is not empty %}
            {% autoescape false %}
            $("#{{ id }}").select2('data', {{ value|json_encode() }});
            {% endautoescape %}
            {% endif %}
        });
    </script>
{% endblock %}


{% block integrated_seo_meta_widget %}

    {% set documentNode = form.parent.vars.data %}

    {% if documentNode.featuredImage.file is defined and documentNode.featuredImage.file is not null %}
        {% set featuredImage = image(documentNode.featuredImage.file).cropResize(512, 512).__toString %}
    {% else %}
        {% set featuredImage = asset('bundles/integratedintegrated/images/favicon/apple-touch-icon.png') %}
    {% endif %}

    {% if documentNode.primaryChannel.favicon.file is defined and documentNode.primaryChannel.favicon.file is not null %}
        {% set faviconSrc = image(documentNode.primaryChannel.favicon.file).cropResize(50, 50).__toString %}
    {% else %}
        {% set faviconSrc = asset('bundles/integratedintegrated/images/favicon/favicon-32x32.png') %}
    {% endif %}

    {% set documentUrl = integrated_url(documentNode) %}
    {% set documentSlug = documentNode.slug|default("") %}

    <div class="aside-options publication-settings-aside seo-settings">
        <div class="publication-settings-popup aside-item-wrapper show">
            <div class="yoast-seo__application" id="yoast-app" data-configuration="{{ {
                'title': documentNode.title|default,
                'titleOverride': documentNode.seoMetadata.metaTitle|default(documentNode.title),
                'description': documentNode.seoMetadata.metaDescription|default(documentNode.intro|default(documentNode.content|striptags|u.truncate(156, '...'))),
                'focusKeyword': documentNode.seoMetadata.focusKeyphrase|default,
                'isCornerstone': false,
                'isAmp': false,
                'uiLocale': 'nl_NL',
                'translationsUrl': '/admin/yoastseo/fetch-translations',
                'workerUrl': asset('bundles/integratedcontent/js/webWorker.js'),
                'baseUrl': 'https://' ~ documentNode.primaryChannel.primaryDomain|default,
                'siteUrl': 'https://' ~ documentNode.primaryChannel.primaryDomain|default,
                'brandName': documentNode.primaryChannel.name|default|replace({' Website': ''}),
                'pageUrl': documentUrl|default(""),
                'uriPathSegment': documentNode.slug|default("/"),
                'faviconSrc': faviconSrc,
                'featuredImageSrc': featuredImage,
                'twitterFallbackImage': asset('bundles/integratedcontent/twitter.svg'),
                'openGraphFallbackImage': asset('bundles/integratedcontent/facebook.svg')
            }|json_encode }}">
            </div>

            <div class="seo-snippet-editor">
                {{ form_widget(form) }}
            </div>
            <style>
                body {
                    --main-bg-color: #fff;
                    --mark-bg-color: rgba(0, 173, 238, .75);
                    --text-color: #222;
                    --text-color-light: #666;
                    --border-light: 1px solid #e2e4e7;
                }

                .ReactModal__Content ul li {
                    list-style: auto;
                    margin-left: 1.5rem;
                }

                .yoast-modal__content button {
                    align-items: center;
                    background-color: #c6422f;
                    border-radius: 4px;
                    color: #fff;
                    display: flex;
                    height: 20px;
                    justify-content: center;
                    width: 20px;
                    position: absolute;
                    top: 2rem;
                    right: 2rem;
                    cursor: pointer;
                }

                .yoast-modal__content button svg {
                    display: none;
                }

                .yoast-modal__content button::before {
                    mask-image: url("data:image/svg+xml;charset=utf-8,<svg width=\"24\" height=\"24\" stroke-width=\"1.5\" viewBox=\"0 0 24 24\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M6.75827 17.2426L12.0009 12M17.2435 6.75736L12.0009 12M12.0009 12L6.75827 6.75736M12.0009 12L17.2435 17.2426\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>");
                    -webkit-mask-image: url("data:image/svg+xml;charset=utf-8,<svg width=\"24\" height=\"24\" stroke-width=\"1.5\" viewBox=\"0 0 24 24\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M6.75827 17.2426L12.0009 12M17.2435 6.75736L12.0009 12M12.0009 12L6.75827 6.75736M12.0009 12L17.2435 17.2426\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>");
                    display: block;
                    height: 20px;
                    width: 20px;
                    content: "";
                    fill: white;
                    color: white;
                    background: currentColor;
                    mask-size: cover;
                    -webkit-mask-size: cover;
                }

                .yoast-modal__content button svg path {
                    fill: white;
                    background-color: white;
                    width: 20px;
                    height: 20px;
                }

                .yoast-seo__container {
                    max-width: 800px;
                }
                .yoast-seo__container h1 {
                    margin: 0 1rem 1rem;
                    font-size: 20px;
                }
                .yoast-seo__container .react-tabs__tab svg {
                    margin-right: 0.5rem;
                }
                .yoast-seo-keyphrase-editor-wrapper {
                    margin-bottom: 1rem;
                    font-size: 13px;
                }
                .yoast-seo-snippet-editor-wrapper {
                    margin: 1rem 0;
                    padding: 1rem 0;
                    border-top: 1px solid var(--border-light);
                    border-bottom: 1px solid var(--border-light);
                }
                .yoast-seo-snippet-editor-wrapper section button {
                    display: none;
                }
                .yoast-seo-social-preview > * {
                    margin-bottom: 1rem;
                }
                .yoast-seo-analysis {
                    font-size: 13px;
                }
                .yoast-seo-analysis h2 {
                    font-size: 16px;
                }
                .yoast-seo-analysis h2 button {
                    padding-left: 0 !important;
                    padding-right: 0 !important;
                    padding-top: 0 !important;
                }

                .seo-snippet-editor {
                    display: none;
                }
                .yoast-seo-analysis a:hover {
                    text-decoration: underline;
                }
                .yoast-seo-analysis li {
                    margin: 0.3rem 0;
                }
                .yoast-seo-analysis p {
                    line-height: 1.5;
                }
                .yoast-seo-analysis__header {
                    margin-bottom: 0.5rem;
                    display: block;
                }
                .yoast-loader {
                    position: fixed;
                    top: 1rem;
                    right: 1rem;
                    width: 2rem;
                }
                .yoast-loader--stop {
                    animation: none !important;
                }
                .yoast-svg-icon-loading-spinner {
                    animation: rotator 1.4s linear infinite;
                }
                .yoast-svg-icon-loading-spinner .path {
                    stroke: #64a60a;
                    stroke-dasharray: 187;
                    stroke-dashoffset: 0;
                    transform-origin: center;
                    animation: dash 1.4s ease-in-out infinite;
                }
                @keyframes dash {
                    0% {
                        stroke-dashoffset: 187;
                    }
                    50% {
                        stroke-dashoffset: 46.75;
                        transform: rotate(135deg);
                    }
                    to {
                        stroke-dashoffset: 187;
                        transform: rotate(450deg);
                    }
                }
                @keyframes rotator {
                    0% {
                        transform: rotate(0deg);
                    }
                    to {
                        transform: rotate(270deg);
                    }
                }
                .ReactModal__Content {
                    box-shadow: 0 2px 7px -1px rgba(0, 0, 0, .15);
                }
                .ReactModal__Content strong {
                    font-size: 14px;
                }
                .ReactModal__Content .yoast-seo__mark {
                    color: var(--text-color-light);
                    font-size: 13px;
                }
                .ReactModal__Content .yoast-text-mark {
                    color: var(--text-color);
                    font-size: 13px;
                    line-height: 1.5;
                }
                #integrated-backend-container, #integrated-new-backend-container {
                    display: none;
                }

                .yoast-seo-analysis a {
                    text-decoration: underline;
                    color: #0368ae;
                }

                .yoast-seo__application .react-tabs__tab-panel {
                    padding: 20px;
                }

                .yoast-seo__application .react-tabs__tab-list .react-tabs__tab {
                    display: flex;
                    font-weight: bold;
                    font-family: 'Poppins';
                    font-size: 1.1rem;
                }

                .yoast-seo__application .react-tabs__tab {
                    display: flex;
                }

                .yoast-seo__application .react-tabs__tab svg {
                    margin-right: .5rem;
                }

                .yoast-seo-analysis button svg {
                    margin: 0 auto;
                }
            </style>
        </div>
    </div>

    {% integrated_javascripts mode='append' 'bundles/integratedcontent/js/seo_settings.js' %}
    {% endintegrated_javascripts %}
    {% integrated_javascripts mode='append' 'bundles/integratedcontent/js/yoastSeoApp.js' %}
    {% endintegrated_javascripts %}
    {% integrated_javascripts mode='append' 'bundles/integratedcontent/js/YoastSeo.js' %}
    {% endintegrated_javascripts %}
{% endblock %}

