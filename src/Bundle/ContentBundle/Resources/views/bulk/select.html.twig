{% extends '@IntegratedContent/base.html.twig' %}
{% form_theme form _self %}
{% import _self as helper %}

{% macro hidden_query_input(name, value) %}
    {% if value is iterable %}
        {% for key, item in value %}
            {{ _self.hidden_query_input(name ~ '[' ~ key ~ ']', item) }}
        {% endfor %}
    {% elseif value is not same as(null) %}
        <input type="hidden" name="{{ name }}" value="{{ value }}">
    {% endif %}
{% endmacro %}

{% block form_errors %}
    {% apply spaceless %}
        {% if errors|length > 0 %}
            <ul class="alert alert-danger">
                {% for error in errors %}
                    <li>{{ error.message }}</li>
                {% endfor %}
            </ul>
        {% endif %}
    {% endapply %}
{% endblock form_errors %}

{% block content %}

<div class="row">
    {% set bulkId = app.request.attributes.get('id') %}
    {% set routeParams = bulkId ? {'id': bulkId} : {} %}
    {% set query = app.request.query.all %}
    {% set dateFrom = app.request.query.get('date_from')|default('') %}
    {% set dateTo = app.request.query.get('date_to')|default('') %}
    {% set dateLabel = 'All dates'|trans %}
    {% if dateFrom or dateTo %}
        {% set dateLabel = (dateFrom ?: '...') ~ ' - ' ~ (dateTo ?: '...') %}
    {% endif %}

    <form id="bulk-date-filter-form" method="get" action="{{ path('integrated_content_bulk_select', routeParams) }}">
        {% for key, value in query %}
            {% if key not in ['date_from', 'date_to', 'page'] %}
                {{ helper.hidden_query_input(key, value) }}
            {% endif %}
        {% endfor %}
        <input type="hidden" name="page" value="1">
    </form>

    {% block form_start %}
        {{ form_start(form, {'attr': {'data-turbo': 'false'}}) }}
    {% endblock %}
    {% block toolbar %}
        <div id="toolbar" class="w-full flex justify-between">
            <div class="options">
                <div class="form-actions">
                    <button class="no-icon btn btn-green" type="submit">{% trans %}Next{% endtrans %}</button>
                </div>
            </div>
            <div class="back">
                <a class="no-icon btn btn-white icon-left" href="{{ path("integrated_content_content_index", app.request.query.all) }}"><i class="iconoir iconoir-arrow-left"></i><span>{% trans %}Back{% endtrans %}</span></a>
            </div>
        </div>
    {% endblock toolbar %}

    <div class="index-wrapper-full">
        {% set bulkToolbarHtml %}
                <ul class="content-navigator-menu">
                    <li class="dropdown close-outside" data-underlay="no">
                        <a data-toggle="dropdown" role="button" id="bulk-date-range"
                           class="btn btn-select space-between">
                            <span>{% trans %}Date range{% endtrans %}: {{ dateLabel }}</span>
                            <i class="iconoir-nav-arrow-down"></i>
                        </a>
                        <ul aria-labelledby="bulk-date-range" role="menu" class="dropdown-menu">
                            <li role="presentation" style="padding: 10px 12px; min-width: 320px;">
                                <div class="form-group" style="margin-bottom: 8px;">
                                    <label for="bulk-date-from">{% trans %}From{% endtrans %}</label>
                                    <input id="bulk-date-from" type="date" name="date_from" class="form-control"
                                           value="{{ dateFrom }}" form="bulk-date-filter-form">
                                </div>
                                <div class="form-group" style="margin-bottom: 10px;">
                                    <label for="bulk-date-to">{% trans %}Until{% endtrans %}</label>
                                    <input id="bulk-date-to" type="date" name="date_to" class="form-control"
                                           value="{{ dateTo }}" form="bulk-date-filter-form">
                                </div>
                                <button class="btn btn-green no-icon" type="submit" form="bulk-date-filter-form">{% trans %}Apply{% endtrans %}</button>
                            </li>
                        </ul>
                    </li>
                    <li>
                        <a class="btn btn-white" href="{{ path('integrated_content_bulk_select', routeParams|merge(query|merge({'date_from': '', 'date_to': '', 'page': 1}))) }}">
                            {% trans %}Reset date{% endtrans %}
                        </a>
                    </li>
                </ul>
        {% endset %}
        {% set pageTitleContentHtml %}
            {{ component('integrated_admin:options_toolbar', {
                contentHtml: bulkToolbarHtml,
            }) }}
        {% endset %}
        {{ component('integrated_admin:page_title', {
            title: 'Step 1 of 3: Choose Issues'|trans,
            contentHtml: pageTitleContentHtml,
        }) }}

    {{ form_errors(form) }}

    {% if content|length > limit %}
        <ul class="alert alert-danger">
            <li>
                {% trans %}The bulk action is limited to change %limit% content items at once. Only the first %limit% content items have been included.{% endtrans %}
            </li>
        </ul>
    {% endif %}

    <div class="row">
        <section class="section-white section-padding section-radius section-margin">

            <div class="container">
                {% trans with {'%count%': min([content|length, limit])} %}Choose for which of the %count% content items you wish to perform a bulk action.{% endtrans %}
            </div>

            <hr/>

            {% set tableHeadHtml %}
                <tr>
                    <th><input type="checkbox" id="{{ form.vars['full_name'] }}_selection_all"/></th>
                    <th>{% trans %}Title{% endtrans %}</th>
                    <th>{% trans %}Type{% endtrans %}</th>
                    <th>{% trans %}Created{% endtrans %}</th>
                    <th>{% trans %}Edited{% endtrans %}</th>
                </tr>
            {% endset %}
            {% set tableBodyHtml %}
                {% for item in form.selection %}
                    <tr>
                        <td>{{ form_widget(item) }}</td>
                        <td><a href="{{ path('integrated_content_content_edit', {id: content[item.vars.label].id}) }}" data-turbo-frame="_top">{{ content[item.vars.label] }}</a></td>
                        <td>{{ content[item.vars.label].getContentType()|capitalize }}</td>
                        <td>{{ content[item.vars.label].getCreatedAt()|format_date('medium') }}</td>
                        <td>{{ content[item.vars.label].getUpdatedAt()|format_date('medium') }}</td>
                    </tr>
                {% endfor %}
            {% endset %}
            {{ component('integrated_admin:data_table', {
                headHtml: tableHeadHtml,
                bodyHtml: tableBodyHtml,
                emptyMessage: 'No items found for this date range'|trans,
                colSpan: 5,
            }) }}

        </section>
    </div>

{#    <div class="pull-right">#}
{#        <a class="btn btn-gray-thin" href="{{ path("integrated_content_content_index", app.request.query.all) }}">{% trans %}Cancel{% endtrans %}</a>&nbsp;#}
{#        <button class="btn btn-orange" type="submit">{% trans %}Next{% endtrans %}</button>#}
{#    </div>#}

    {{ form_end(form) }}
    </div>
</div>

{% endblock %}

{% block javascript %}
    {{ parent() }}

    <script>
        (function initBulkSelectionToggler() {
            function bind() {
                var form = document.querySelector('form[name="{{ form.vars['full_name'] }}"]');
                if (!form || form.dataset.boundBulkSelectionToggle === 'true') {
                    return;
                }

                form.dataset.boundBulkSelectionToggle = 'true';

                var toggle = form.querySelector('#{{ form.vars['full_name'] }}_selection_all');
                if (!toggle) {
                    return;
                }

                var checkboxes = Array.prototype.slice.call(
                    form.querySelectorAll('tbody input[type="checkbox"]')
                );

                function syncToggleState() {
                    var checked = checkboxes.filter(function (checkbox) {
                        return checkbox.checked;
                    }).length;

                    toggle.checked = checkboxes.length > 0 && checked === checkboxes.length;
                    toggle.indeterminate = checked > 0 && checked < checkboxes.length;
                }

                toggle.addEventListener('change', function () {
                    checkboxes.forEach(function (checkbox) {
                        checkbox.checked = toggle.checked;
                    });

                    syncToggleState();
                });

                checkboxes.forEach(function (checkbox) {
                    checkbox.addEventListener('change', syncToggleState);
                });

                syncToggleState();
            }

            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', bind, { once: true });
            } else {
                bind();
            }

            document.addEventListener('turbo:load', bind);
        })();
    </script>

{% endblock javascript %}
