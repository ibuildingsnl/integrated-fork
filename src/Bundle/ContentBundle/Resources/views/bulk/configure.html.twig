{% extends '@IntegratedContent/base.html.twig' %}
{% form_theme form _self %}

{% block form_errors %}
    {% apply spaceless %}
        {% if errors|length > 0 %}
            {% set bulkConfigureFormErrorHtml %}
                {% for error in errors %}
                    <li>{{ error.message }}</li>
                {% endfor %}
            {% endset %}
            {{ component('integrated_admin:alert_box', {
                tag: 'ul',
                variant: 'danger',
                bodyHtml: bulkConfigureFormErrorHtml,
            }) }}
        {% endif %}
    {% endapply %}
{% endblock form_errors %}

{% block content %}
    <div class="row">
        {% block form_start %}
            {{ form_start(form, { 'style': 'inline', 'attr': {'data-turbo': 'false'} }) }}
        {% endblock %}
        {% block toolbar %}
            <div id="toolbar" class="w-full flex justify-between">
                <div class="options">
                    <div class="form-actions">
                        <button class="no-icon btn btn-green" type="submit">{% trans %}Next{% endtrans %}</button>
                    </div>
                </div>
                <div class="back">
                    <a class="no-icon btn btn-white icon-left"
                       href="{{ path("integrated_content_bulk_select", {'id': id }) }}"><i
                            class="iconoir iconoir-arrow-left"></i><span>{% trans %}Back{% endtrans %}</span></a>
                </div>
            </div>
        {% endblock toolbar %}
        <div class="index-wrapper-full">

            <h1>{% trans %}Step 2 of 3: Choose Operation{% endtrans %}</h1>

            <div class="row">
                <section class="section-white section-padding section-radius section-margin">

                    <div class="container">
                        {% trans %}Choose the operation you wish to perform on the selected content items (%selection%){% endtrans %}
                    </div>

                    <hr/>

                    {{ form_errors(form) }}
                    <div id="bulk-action-toolbar"
                         class="bulk-action-toolbar"
                         data-placeholder="{{ 'Choose operation'|trans }}"
                         data-selected-label="{{ 'Selected operations'|trans }}"
                         data-empty-label="{{ 'No operations selected yet.'|trans }}"
                         data-group-add="{{ 'Add'|trans({}, 'messages') }}"
                         data-group-remove="{{ 'Remove'|trans({}, 'messages') }}"
                         data-group-fields="{{ 'Fields'|trans }}"
                         data-group-channels="{{ 'Channels'|trans }}">
                    </div>
                    {{ form_row(form.actions, {'style': 'horizontal'}) }}

                </section>
            </div>
        </div>
    </div>
    {{ form_end(form) }}

{% endblock content %}

{% block style %}
{{ parent() }}

<link rel="stylesheet" href="{{ asset('bundles/integratedintegrated/edit.css') }}">

