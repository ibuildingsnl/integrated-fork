{% block javascript %}
{{ parent() }}

<script>
    (function () {
        function getActionGroups(actionsContainer) {
            var groups = [];

            Array.prototype.forEach.call(actionsContainer.children, function (child) {
                if (child.classList && child.classList.contains('form-group')) {
                    groups.push(child);
                }
            });

            return groups;
        }

        function syncToggle(checkbox) {
            var toggleContainer = checkbox.closest('[data-action-toggle="1"]');
            if (!toggleContainer) {
                return;
            }

            var details = toggleContainer.nextElementSibling;
            if (!details) {
                return;
            }

            details.classList.toggle('hidden', !checkbox.checked);
        }

        function ensureToolbar(toolbarHost) {
            if (!toolbarHost.querySelector('[data-bulk-action-picker="1"]')) {
                var placeholder = toolbarHost.getAttribute('data-placeholder') || 'Choose operation';
                var selectedLabel = toolbarHost.getAttribute('data-selected-label') || 'Selected operations';
                var emptyLabel = toolbarHost.getAttribute('data-empty-label') || 'No operations selected yet.';

                toolbarHost.innerHTML = ''
                    + '<div class="bulk-action-picker" data-bulk-action-picker="1">'
                    + '<select class="form-control" data-bulk-action-select="1"></select>'
                    + '</div>'
                    + '<div class="bulk-action-selection">'
                    + '<span class="bulk-action-selected-title">' + selectedLabel + '</span>'
                    + '<div class="bulk-action-chips" data-bulk-action-chips="1"></div>'
                    + '<div class="bulk-action-empty" data-bulk-action-empty="1">' + emptyLabel + '</div>'
                    + '</div>';

                toolbarHost.setAttribute('data-bulk-action-placeholder', placeholder);
            }

            return {
                placeholder: toolbarHost.getAttribute('data-bulk-action-placeholder') || 'Choose operation',
                select: toolbarHost.querySelector('[data-bulk-action-select="1"]'),
                chips: toolbarHost.querySelector('[data-bulk-action-chips="1"]'),
                empty: toolbarHost.querySelector('[data-bulk-action-empty="1"]'),
                groupLabels: {
                    add: toolbarHost.getAttribute('data-group-add') || 'Toevoegen',
                    remove: toolbarHost.getAttribute('data-group-remove') || 'Verwijderen',
                    fields: toolbarHost.getAttribute('data-group-fields') || 'Fields',
                    channels: toolbarHost.getAttribute('data-group-channels') || 'Channels'
                },
            };
        }

        function initBulkConfigure() {
            if (window.jQuery && typeof window.implementSelect2 === 'function') {
                window.implementSelect2();
            }

            var actionsContainer = document.getElementById('integrated_content_bulk_configure_actions');
            if (!actionsContainer || actionsContainer.dataset.bulkUiBound === '1') {
                return;
            }

            var toolbarHost = document.getElementById('bulk-action-toolbar');
            var toolbar = toolbarHost ? ensureToolbar(toolbarHost) : null;

            var actionGroups = getActionGroups(actionsContainer).map(function (group) {
                var toggleContainer = group.querySelector('[data-action-toggle="1"]');
                if (!toggleContainer) {
                    return null;
                }

                var checkbox = toggleContainer.querySelector('input[type="checkbox"]');
                if (!checkbox) {
                    return null;
                }

                var labelNode = toggleContainer.querySelector('.checkbox-container');
                var label = labelNode ? labelNode.textContent.trim().replace(/\s+/g, ' ') : checkbox.id;

                return {
                    id: checkbox.id,
                    group: group,
                    checkbox: checkbox,
                    label: label,
                };
            }).filter(function (item) {
                return item !== null;
            });

            function getActionGroupKey(action) {
                var id = action.id.toLowerCase();

                if (id.indexOf('addchannel') !== -1 || id.indexOf('add_') !== -1) {
                    return 'add';
                }

                if (id.indexOf('removechannel') !== -1 || id.indexOf('remove_') !== -1 || id.indexOf('delete') !== -1) {
                    return 'remove';
                }

                return 'fields';
            }

            function activateActionById(id) {
                actionGroups.forEach(function (action) {
                    if (action.id !== id) {
                        return;
                    }

                    action.checkbox.checked = true;
                    action.checkbox.dispatchEvent(new Event('change', {bubbles: true}));
                });
            }

            function deactivateActionById(id) {
                actionGroups.forEach(function (action) {
                    if (action.id !== id) {
                        return;
                    }

                    action.checkbox.checked = false;
                    action.checkbox.dispatchEvent(new Event('change', {bubbles: true}));
                });
            }

            function renderToolbar() {
                if (!toolbar) {
                    return;
                }

                var currentValue = toolbar.select.value;

                toolbar.select.innerHTML = '';

                var placeholderOption = document.createElement('option');
                placeholderOption.value = '';
                placeholderOption.textContent = toolbar.placeholder;
                toolbar.select.appendChild(placeholderOption);

                var selectedCount = 0;
                toolbar.chips.innerHTML = '';
                var groupedOptions = {
                    add: [],
                    remove: [],
                    fields: [],
                    channels: []
                };

                actionGroups.forEach(function (action) {
                    action.group.classList.toggle('hidden', !action.checkbox.checked);
                    syncToggle(action.checkbox);

                    if (action.checkbox.checked) {
                        selectedCount += 1;

                        var chip = document.createElement('span');
                        chip.className = 'bulk-action-chip';
                        chip.textContent = action.label;

                        var removeButton = document.createElement('button');
                        removeButton.type = 'button';
                        removeButton.className = 'bulk-action-chip-remove';
                        removeButton.innerHTML = '<i class="iconoir-xmark"></i>';
                        removeButton.addEventListener('click', function () {
                            deactivateActionById(action.id);
                        });

                        chip.appendChild(removeButton);
                        toolbar.chips.appendChild(chip);

                        return;
                    }

                    var option = document.createElement('option');
                    option.value = action.id;
                    option.textContent = action.label;
                    groupedOptions[getActionGroupKey(action)].push(option);
                });

                ['add', 'remove', 'fields', 'channels'].forEach(function (groupKey) {
                    var options = groupedOptions[groupKey];

                    if (!options.length) {
                        return;
                    }

                    var optgroup = document.createElement('optgroup');
                    optgroup.label = toolbar.groupLabels[groupKey];

                    options.forEach(function (option) {
                        optgroup.appendChild(option);
                    });

                    toolbar.select.appendChild(optgroup);
                });

                var hasCurrentValue = false;
                Array.prototype.forEach.call(toolbar.select.options, function (option) {
                    if (option.value === currentValue) {
                        hasCurrentValue = true;
                    }
                });

                if (currentValue && hasCurrentValue) {
                    toolbar.select.value = currentValue;
                } else {
                    toolbar.select.value = '';
                }

                toolbar.empty.style.display = selectedCount > 0 ? 'none' : '';
            }

            actionGroups.forEach(function (action) {
                if (action.checkbox.dataset.bulkActionBound !== '1') {
                    action.checkbox.addEventListener('change', function () {
                        renderToolbar();
                    });
                    action.checkbox.dataset.bulkActionBound = '1';
                }
            });

            if (toolbar) {
                if (toolbar.select.dataset.bulkActionSelectBound !== '1') {
                    toolbar.select.addEventListener('change', function () {
                        if (!toolbar.select.value) {
                            return;
                        }

                        activateActionById(toolbar.select.value);
                    });
                    toolbar.select.dataset.bulkActionSelectBound = '1';
                }
            }

            renderToolbar();
            actionsContainer.dataset.bulkUiBound = '1';
        }

        document.addEventListener('DOMContentLoaded', initBulkConfigure);
        document.addEventListener('turbo:load', initBulkConfigure);
    })();

</script>

<script src="{{ asset('bundles/integratedcontent/js/bulk_relation.js') }}" defer data-turbo-track="reload">
</script>
<script src="{{ asset('bundles/integratedcontent/js/bulk_taxonomy_category.js') }}" defer data-turbo-track="reload">
</script>
<script src="{{ asset('bundles/integratedcontent/js/bulk_publish_window.js') }}" defer data-turbo-track="reload">
</script>

{% endblock javascript %}
