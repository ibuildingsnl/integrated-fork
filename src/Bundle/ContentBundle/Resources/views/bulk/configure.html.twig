{% extends '@IntegratedContent/base.html.twig' %}
{% form_theme form _self %}

{% block form_errors %}
    {% apply spaceless %}
        {% if errors|length > 0 %}
            <ul class="alert alert-danger">
                {% for error in errors %}
                    <li>{{ error.message }}</li>
                {% endfor %}
            </ul>
        {% endif %}
    {% endapply %}
{% endblock form_errors %}

{% block content %}
    <div class="row">
        {% block form_start %}
            {{ form_start(form, { 'style': 'inline' }) }}
        {% endblock %}
        {% block toolbar %}
            <div id="toolbar" class="w-full flex justify-between">
                <div class="options">
                    <div class="form-actions">
                        <button class="no-icon btn btn-green" type="submit">{% trans %}Next{% endtrans %}</button>
                    </div>
                </div>
                <div class="back">
                    <a class="no-icon btn btn-white icon-left"
                       href="{{ path("integrated_content_bulk_select", {'id': id }) }}"><i
                            class="iconoir iconoir-arrow-left"></i><span>{% trans %}Back{% endtrans %}</span></a>
                </div>
            </div>
        {% endblock toolbar %}
        <div class="index-wrapper-full">

            <h1>{% trans %}Step 2 of 3: Choose Operation{% endtrans %}</h1>

            <div class="row">
                <section class="section-white section-padding section-radius section-margin">

                    <div class="container">
                        {% trans %}Choose the operation you wish to perform on the selected content items (%selection%){% endtrans %}
                    </div>

                    <hr/>

                    {{ form_errors(form) }}
                    {{ form_row(form.actions, {'style': 'horizontal'}) }}

                </section>
            </div>
        </div>
    </div>
    {{ form_end(form) }}

{% endblock content %}

{% block javascript %}
{{ parent() }}

<script>
    $(document).ready(function () {
        console.log('test');
        implementSelect2();

        $('[data-action-toggle="1"] input:checkbox')
            .click(toggle)
            .each(toggle);

        function toggle() {
            var self = $(this);

            if (self.is(':checked')) {
                self.parents('[data-action-toggle="1"]').next().show();
            } else {
                self.parents('[data-action-toggle="1"]').next().hide();
            }
        }
    });

</script>

<script src="{{ asset('bundles/integratedcontent/js/bulk_relation.js') }}">
</script>

{% endblock javascript %}
