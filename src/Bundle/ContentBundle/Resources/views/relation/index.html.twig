{% extends '@IntegratedContent/base.html.twig' %}
{% block content %}
    <div class="row">
        <div class="index-wrapper-full">
            {% set createActionsHtml %}
                <ul class="create">
                    <li>
                        <a class="btn btn-create-new" href="{{ path('integrated_content_relation_new') }}">
                            <span>{% trans %}New relation{% endtrans %}</span>
                            <i class="iconoir-plus"></i>
                        </a>
                    </li>
                </ul>
            {% endset %}
            {{ component('integrated_admin:page_title', {
                title: 'Relations'|trans,
                actionsHtml: createActionsHtml,
            }) }}
            {% component 'integrated_admin:section_card' %}
                {% block content %}
                {% set tableHeadHtml %}
                    <tr>
                        <th>{% trans %}Name{% endtrans %}</th>
                        <th>{% trans %}Type{% endtrans %}</th>
                        <th>{% trans %}Location{% endtrans %}</th>
                        <th>{% trans %}Created{% endtrans %}</th>
                    </tr>
                {% endset %}
                {% set tableBodyHtml %}
                    {% for document in documents %}
                        <tr class="has-options">
                            <td>
                                <strong>
                                    <a href="{{ path('integrated_content_relation_edit', {'id': document.id}) }}">
                                        {{ document.name }}
                                    </a>
                                </strong>
                                {% set relationRowActionsHtml %}
                                    <a href="{{ path('integrated_content_relation_edit', {'id': document.id}) }}" title="{% trans %}Edit{% endtrans %}">
                                        {% trans %}Edit{% endtrans %}
                                    </a> |
                                    <a href="{{ path('integrated_content_relation_delete', {'id': document.id}) }}"
                                       class="color-red" title="{% trans %}Delete{% endtrans %}">{% trans %}Delete{% endtrans %}</a>
                                {% endset %}
                                {{ component('integrated_admin:row_actions', {
                                    contentHtml: relationRowActionsHtml,
                                }) }}
                            </td>
                            <td>
                                {{ document.type }}
                            </td>
                            <td>
                                {{ document.location }}
                            </td>
                            <td>
                                {{ document.createdAt|date }}
                            </td>
                        </tr>
                    {% endfor %}
                {% endset %}
                {{ component('integrated_admin:data_table', {
                    headHtml: tableHeadHtml,
                    bodyHtml: tableBodyHtml,
                    emptyMessage: 'No relations added'|trans,
                    colSpan: 4,
                }) }}
                {% endblock %}
            {% endcomponent %}
        </div>
    </div>
{% endblock %}
{% block javascript %}
{{ parent() }}

<script type="text/javascript">
    document.addEventListener('DOMContentLoaded', function () {
        if (window.jQuery && typeof window.jQuery.fn.popover === 'function') {
            window.jQuery('[data-toggle="popover"]').popover();
        } else if (window.bootstrap && typeof window.bootstrap.Popover === 'function') {
            document.querySelectorAll('[data-toggle="popover"]').forEach(function (element) {
                new window.bootstrap.Popover(element);
            });
        }
    });
</script>
{% endblock %}
