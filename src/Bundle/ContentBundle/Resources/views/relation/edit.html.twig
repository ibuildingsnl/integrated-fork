{% extends '@IntegratedContent/base.html.twig' %}
{% block title %}{% trans %}Edit {% endtrans %} {{ relation.name }}{% endblock title %}
{% block crumbs %}
    <div class="breadcrumb-holder">
        <div class="container">
            <ol class="breadcrumb">
                <li>
                    <a href="{{ path('integrated_content_relation_index') }}">{% trans %}Home{% endtrans %}</a>
                </li>
                <li class="active">{% trans %}Edit{% endtrans %}</li>
            </ol>
        </div>
    </div>
{% endblock %}
{% block content %}

    <div class="row">
        <div class="w-full mb-4 md:mb-0">
            <div class="page-title">
                <h1 class="heading">{% trans %}Edit{% endtrans %} {{ relation.name }}</h1>
            </div>
            <section class="section-white section-padding section-radius">
                {{ form(form, {'style': 'horizontal'}) }}
            </section>
        </div>
    </div>
{% endblock %}
{% block javascript %}
    {{ parent() }}

    <script>
    $(document).ready(function() {
        $('#integrated_relation_sources').select2();
        $('#integrated_relation_targets').select2();
    });
    </script>
{% endblock javascript %}
