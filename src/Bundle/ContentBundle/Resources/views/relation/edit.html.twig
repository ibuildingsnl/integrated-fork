{% extends '@IntegratedContent/base.html.twig' %}
{% block title %}{% trans %}Edit {% endtrans %} {{ relation.name }}{% endblock title %}
{% block content %}
<div class="flex flex-wrap edit-form">
    {% block form_start %}
        {{ form_start(form) }}
    {% endblock %}
    {% block toolbar %}
        {% include '@IntegratedContent/partials/block.toolbar.html.twig' %}
    {% endblock toolbar %}
    <div class="aside-options">
        <aside>
            <div class="aside-holder">
                {% block sidebar %}
                <div class="aside-header">
                    <button class="toggle-filters toggle-options-sidebar"  data-target="aside-options" type="button">
                        <i class="iconoir-xmark"></i>
                    </button>
                    <span>{% trans %}Options{% endtrans %}</span>
                </div>
                    {% block content_meta %}
                        {% for child in form|filter(row => row.vars.attr.location|default == constant('Integrated\\Common\\Form\\Mapping\\Attributes\\Field::LOCATION_SIDEBAR'))  %}
                            {{ form_row(child) }}
                        {% endfor %}
                    {% endblock %}
                {% endblock %}
            </div>
        </aside>
    </div>
    <div class="editor-wrapper">
        {{ component('integrated_admin:page_title', {
            title: 'Edit'|trans ~ ' ' ~ relation.name,
        }) }}
        <section class="editor editor-wrapped">
            {% block content_form %}
                {% for child in form|filter(row => row.vars.attr.location|default == constant('Integrated\\Common\\Form\\Mapping\\Attributes\\Field::LOCATION_EDITOR'))  %}
                    {{ form_row(child) }}
                {% endfor %}

                {{ form_rest(form, {'style':'horizontal'}) }}
            {% endblock %}
        </section>
    </div>
    {% block form_end %}
        {{ form_end(form) }}
    {% endblock %}
</div>
{% endblock %}

{% block javascript %}
{{ parent() }}

<script type="text/javascript">
(function initRelationEditPage() {
    function initializeRelationEditEnhancements() {
        if (window.jQuery && typeof window.jQuery.fn.select2 === 'function') {
            ['#integrated_relation_sources', '#integrated_relation_targets'].forEach(function (selector) {
                var $field = window.jQuery(selector);
                if ($field.length > 0 && !$field.hasClass('select2-hidden-accessible')) {
                    $field.select2();
                }
            });
        }

        if (window.jQuery && typeof window.jQuery.fn.popover === 'function') {
            window.jQuery('[data-toggle="popover"]').popover();
        } else if (window.bootstrap && typeof window.bootstrap.Popover === 'function') {
            document.querySelectorAll('[data-toggle="popover"]').forEach(function (element) {
                new window.bootstrap.Popover(element);
            });
        }
    }

    if (window.__integratedRelationEditInitBound !== true) {
        document.addEventListener('DOMContentLoaded', initializeRelationEditEnhancements);
        document.addEventListener('turbo:load', initializeRelationEditEnhancements);
        document.addEventListener('turbo:render', initializeRelationEditEnhancements);
        document.addEventListener('turbo:frame-load', initializeRelationEditEnhancements);
        document.addEventListener('turbo:frame-render', initializeRelationEditEnhancements);
        window.__integratedRelationEditInitBound = true;
    }

    if (document.readyState !== 'loading') {
        initializeRelationEditEnhancements();
    }
})();
</script>
{% endblock javascript %}
