{% extends '@IntegratedContent/base.html.twig' %}
{% block title %}{% trans %}Show {% endtrans %} {{ relation.name }}{% endblock title %}
{% block content %}
    {% block form_start %}
        {{ form_start(form) }}
    {% endblock %}
    {% set relationShowToolbarHtml %}
        {% block toolbar %}
            {% include '@IntegratedContent/partials/block.toolbar.html.twig' %}
        {% endblock toolbar %}
    {% endset %}
    {% set relationShowTitleHtml %}
        {{ component('integrated_admin:page_title', {
            title: 'Show'|trans ~ ' ' ~ relation.name,
        }) }}
    {% endset %}
    {% set relationSourcesHtml %}
        <ul>
            {% for contentType in relation.sources %}
                <li>
                    {{ contentType }}
                </li>
            {% else %}
                <li>
                    {% trans %}No sources added{% endtrans %}
                </li>
            {% endfor %}
        </ul>
    {% endset %}
    {% set relationTargetsHtml %}
        <ul>
            {% for contentType in relation.targets %}
                <li>
                    {{ contentType }}
                </li>
            {% else %}
                <li>
                    {% trans %}No targets added{% endtrans %}
                </li>
            {% endfor %}
        </ul>
    {% endset %}
    {% set relationShowEditorContentHtml %}
        <section class="section-white section-padding section-radius">
            {{ component('integrated_admin:detail_list', {
                rows: [
                    {term: 'Name'|trans, value: relation.name},
                    {term: 'Sources'|trans, valueHtml: relationSourcesHtml},
                    {term: 'Targets'|trans, valueHtml: relationTargetsHtml},
                    {term: 'Location'|trans, value: relation.location},
                    {term: 'Multiple'|trans, value: relation.multiple == 1 ? 'Multiple'|trans : 'One'|trans},
                    {term: 'Required'|trans, value: relation.required ? 'Yes'|trans : 'No'|trans},
                ],
            }) }}
            {{ form_rest(form, {'style':'horizontal'})}}
        </section>
    {% endset %}
    {{ component('integrated_admin:edit_form_shell', {
        toolbarHtml: relationShowToolbarHtml,
        pageTitleHtml: relationShowTitleHtml,
        editorContentHtml: relationShowEditorContentHtml,
        editorClass: '',
    }) }}
    {% block form_end %}
        {{ form_end(form) }}
    {% endblock %}
{% endblock %}
