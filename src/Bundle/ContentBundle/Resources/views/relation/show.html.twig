{% extends '@IntegratedContent/base.html.twig' %}
{% block title %}{% trans %}Show {% endtrans %} {{ relation.name }}{% endblock title %}
{% block content %}
    <div class="flex flex-wrap edit-form">
        {% block form_start %}
            {{ form_start(form, { 'style': 'horizontal' }) }}
        {% endblock %}
        <div id="toolbar" class="w-full flex justify-between">
            <div class="back">
                {% block form_return %}
                    {% if form.actions.back is defined %}
                        {{ form_row(form.actions.back) }}
                    {% endif %}
                    {% if form.actions.cancel is defined %}
                        {{ form_row(form.actions.cancel) }}
                    {% endif %}
                {% endblock %}
            </div>
            <div class="options">
                <div class="form-actions">
                    <a class="btn btn-green no-icon" href="{{ path('integrated_content_relation_edit', {'id': relation.id}) }}">
                        {% trans %}Edit{% endtrans %}
                    </a>
                    {% block form_actions %}
                        {% if form.actions.delete is defined %}
                            {{ form_row(form.actions.delete) }}
                        {% endif %}
                        {% if form.actions.reload is defined %}
                            {{ form_row(form.actions.reload) }}
                        {% endif %}
                    {% endblock %}
                </div>
            </div>
        </div>
        <div class="aside-options"></div>
        <div class="editor-wrapper">
            <div class="page-title">
                <h1 class="heading">{% trans %}Show{% endtrans %} {{ relation.name }}</h1>
            </div>
            <section class="editor">
                <section class="section-white section-padding section-radius">
                    <dl class="dl-horizontal">
                        <dt>
                            {% trans %}Name{% endtrans %}
                        </dt>
                        <dd>
                            {{ relation.name }}
                        </dd>
                        <dt>
                            {% trans %}Sources{% endtrans %}
                        </dt>
                        <dd>
                            <ul>
                                {% for contentType in relation.sources %}
                                    <li>
                                        {{ contentType }}
                                    </li>
                                {% else %}
                                    <li>
                                        {% trans %}No sources added{% endtrans %}
                                    </li>
                                {% endfor %}
                            </ul>
                        </dd>
                        <dt>
                            {% trans %}Targets{% endtrans %}
                        </dt>
                        <dd>
                            <ul>
                                {% for contentType in relation.targets %}
                                    <li>
                                        {{ contentType }}
                                    </li>
                                {% else %}
                                    <li>
                                        {% trans %}No targets added{% endtrans %}
                                    </li>
                                {% endfor %}
                            </ul>
                        </dd>
                        <dt>
                            {% trans %}Location{% endtrans %}
                        </dt>
                        <dd>
                            {{ relation.location }}
                        </dd>
                        <dt>
                            {% trans %}Multiple{% endtrans %}
                        </dt>
                        <dd>
                            {% if relation.multiple == 1 %}
                                {% trans %}Multiple{% endtrans %}
                            {% else %}
                                {% trans %}One{% endtrans %}
                            {% endif %}
                        </dd>
                        <dt>
                            {% trans %}Required{% endtrans %}
                        </dt>
                        <dd>
                            {% if relation.required %}
                                {% trans %}Yes{% endtrans %}
                            {% else %}
                                {% trans %}No{% endtrans %}
                            {% endif %}
                        </dd>
                    </dl>
{#                    {{ form_rest(form, {'style':'horizontal'})}}#}
                </section>
            </section>
        </div>
        {% block form_end %}
            {{ form_end(form) }}
        {% endblock %}
    </div>
{% endblock %}
