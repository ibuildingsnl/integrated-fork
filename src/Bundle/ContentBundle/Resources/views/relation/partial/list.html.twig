<table class="table table-hover">
    <thead>
    <tr>
        <th>{% trans %}Name{% endtrans %}</th>
        <th>{% trans %}Info{% endtrans %}</th>
    </tr>
    </thead>
    <tbody>
    {% for document in documents %}
        <tr class="has-options">
            <td>
                <strong>
                    <a href="{{ path('integrated_content_relation_edit', {'id': document.id}) }}">
                        {{ document.name }}
                    </a>
                </strong>
                <div class="row-options">
                    <a href="{{ path('integrated_content_relation_edit', {'id': document.id}) }}" title="{% trans %}Edit{% endtrans %}">
                        {% trans %}Edit{% endtrans %}
                    </a> |
                    <a href="{{ path('integrated_content_relation_delete', {'id': document.id}) }}"
                       class="color-red" title="{% trans %}Delete{% endtrans %}">{% trans %}Delete{% endtrans %}</a>
                </div>
            </td>
            <td>
                {% set pageList %}
                    <h3>
                        {% trans %}Type{% endtrans %}
                    </h3>
                    <ul>
                        <li>{{ document.type }}</li>
                    </ul>
                    <h3>
                        {% trans %}Location{% endtrans %}
                    </h3>
                    <ul>
                        <li>{{ document.location }}</li>
                    </ul>
                    <h3>
                        {% trans %}Created{% endtrans %}
                    </h3>
                    <ul>
                        <li>{{ document.createdAt|date }}</li>
                    </ul>
                {% endset %}

                {% if pageList|trim %}
                    <span class="iconoir-list" data-toggle="popover" data-trigger="hover" data-content="{{ pageList|e }}" data-html="true" data-placement="left"></span>
                {% endif %}
            </td>
        </tr>

    {% else %}
        <tr>
            <td colspan="2">
                {% trans %}No relations added{% endtrans %}
            </td>
        </tr>
    {% endfor %}
    </tbody>
</table>
