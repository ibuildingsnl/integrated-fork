{% extends '@IntegratedContent/base.html.twig' %}
{% block title %}{% trans %}New relation{% endtrans %}{% endblock title %}
{% block content %}
    <div class="flex flex-wrap edit-form">
        {% block form_start %}
            {{ form_start(form, { 'style': 'horizontal' }) }}
        {% endblock %}
        <div id="toolbar" class="w-full flex justify-between">
            <div class="back">
                {% block form_return %}
                    {% if form.actions.back is defined %}
                        {{ form_row(form.actions.back) }}
                    {% endif %}
                    {% if form.actions.cancel is defined %}
                        {{ form_row(form.actions.cancel) }}
                    {% endif %}
                {% endblock %}
            </div>
            <div class="options">
                <div class="form-actions">
                    {% block form_actions %}
                        {% if form.actions.save is defined %}
                            {{ form_row(form.actions.save) }}
                        {% endif %}
                        {% if form.actions.reload is defined %}
                            {{ form_row(form.actions.reload) }}
                        {% endif %}
                        {% if form.actions.create is defined %}
                            {{ form_row(form.actions.create) }}
                        {% endif %}
                    {% endblock %}
                </div>
            </div>
        </div>
        <div class="aside-options">
            <aside>
                <div class="aside-item-wrapper show">
                    <div class="aside-item-header">
                        <h3 class="aside-item-title">
                            <i class="fa-regular fa-circle-info"></i>
                            <span class="aside-item-icon">{% trans %}Status{% endtrans %}</span>
                        </h3>
                        <i class="fa-regular fa-chevron-up"></i>
                    </div>
                    <div class="aside-item-list">
                        <div class="aside-item-list-container">
                            <div class="status-options">
                                {% if relation is defined and relation.createdAt is defined %}
                                    <div class="status published">
                                        <i class="fa-regular fa-circle-check"></i> {% trans %}Published{% endtrans %}
                                    </div>
                                    <!-- TODO: Delete button not working -->
                                    <a class="delete"
                                       href="{{ path('integrated_content_relation_delete', {'id': relation.id}) }}">
                                        <i class="fa-regular fa-trash-can"></i>
                                    </a>
                                {% else %}
                                    <div class="status draft">
                                        <i class="fa-regular fa-pen-ruler"></i> {% trans %}Draft{% endtrans %}
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>
                {% if form.location is defined %}
                    {{ form_row(form.location, {'style': 'sidebar', 'icon':'fa-key', 'state': 'show'}) }}
                {% endif %}
                {% if form.icon is defined %}
                    {{ form_row(form.icon, {'style': 'sidebar', 'icon':'fa-link', 'state': 'show'}) }}
                {% endif %}
                <!-- TODO: group Multiple & Required together in "Options" -->
                {% if form.multiple is defined %}
                    {{ form_row(form.multiple, {'style': 'sidebar', 'icon':'fa-link', 'state': 'show'}) }}
                {% endif %}
                {% if form.required is defined %}
                    {{ form_row(form.required, {'style': 'sidebar', 'icon':'fa-link', 'state': 'show'}) }}
                {% endif %}
                {% if form.options is defined %}
                    {{ form_row(form.options, {'style': 'sidebar', 'icon':'fa-link', 'state': 'show'}) }}
                {% endif %}
            </aside>
        </div>
        <div class="editor-wrapper">
            <div class="page-title">
                <h1 class="heading">{% trans %}Edit{% endtrans %} {% trans %}relation{% endtrans %}</h1>
            </div>
            <section class="editor">
                <section class="section-white section-padding section-radius">
                    {{ form_rest(form, {'style':'horizontal'})}}
                </section>
            </section>
        </div>
        {% block form_end %}
            {{ form_end(form) }}
        {% endblock %}
    </div>
{% endblock %}
{% block javascript %}
    {{ parent() }}

    <script>
    $(document).ready(function() {
        $('#integrated_relation_sources').select2();
        $('#integrated_relation_targets').select2();
    });
    </script>
{% endblock javascript %}
