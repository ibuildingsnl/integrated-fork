{% extends '@IntegratedContent/base.html.twig' %}
{% block title %}{% trans %}New relation{% endtrans %}{% endblock title %}
{% block content %}
<div class="flex flex-wrap edit-form">
    {% block form_start %}
        {{ form_start(form) }}
    {% endblock %}
    {% block toolbar %}
        {% include '@IntegratedContent/partials/block.toolbar.html.twig' %}
    {% endblock toolbar %}
    <div class="aside-options">
        <aside>
            <div class="aside-holder">
                {% block sidebar %}
                    <div class="aside-header">
                        <button class="toggle-filters toggle-options-sidebar"  data-target="aside-options" type="button">
                            <i class="iconoir-xmark"></i>
                        </button>
                        <span>{% trans %}Options{% endtrans %}</span>
                    </div>
                    {% block content_meta %}
                        {% for child in form|filter(row => row.vars.attr.location|default == constant('Integrated\\Common\\Form\\Mapping\\Attributes\\Field::LOCATION_SIDEBAR'))  %}
                            {{ form_row(child) }}
                        {% endfor %}
                    {% endblock %}
                {% endblock %}
            </div>
        </aside>
    </div>
    <div class="editor-wrapper">
        <div class="page-title">
            <h1 class="heading">{% trans %}New relation{% endtrans %}</h1>
        </div>
        <section class="editor editor-wrapped">
            {{ form_errors(form) }}

            {% block content_form %}
                {% for child in form|filter(row => row.vars.attr.location|default == constant('Integrated\\Common\\Form\\Mapping\\Attributes\\Field::LOCATION_EDITOR'))  %}
                    {{ form_row(child) }}
                {% endfor %}

                {{ form_rest(form, {'style':'horizontal'}) }}
            {% endblock %}
        </section>
    </div>
    {% block form_end %}
        {{ form_end(form) }}
    {% endblock %}
</div>
{% endblock %}
{% block javascript %}
{{ parent() }}

<script>
(function initRelationNewPage() {
    function initializeRelationNewEnhancements() {
        if (!window.jQuery || typeof window.jQuery.fn.select2 !== 'function') {
            return;
        }

        ['#integrated_relation_sources', '#integrated_relation_targets'].forEach(function (selector) {
            var $field = window.jQuery(selector);
            if ($field.length > 0 && !$field.hasClass('select2-hidden-accessible')) {
                $field.select2();
            }
        });
    }

    if (window.__integratedRelationNewInitBound !== true) {
        document.addEventListener('DOMContentLoaded', initializeRelationNewEnhancements);
        document.addEventListener('turbo:load', initializeRelationNewEnhancements);
        document.addEventListener('turbo:render', initializeRelationNewEnhancements);
        document.addEventListener('turbo:frame-load', initializeRelationNewEnhancements);
        document.addEventListener('turbo:frame-render', initializeRelationNewEnhancements);
        window.__integratedRelationNewInitBound = true;
    }

    if (document.readyState !== 'loading') {
        initializeRelationNewEnhancements();
    }
})();
</script>
{% endblock javascript %}
