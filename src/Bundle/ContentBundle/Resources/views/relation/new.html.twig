{% extends '@IntegratedContent/base.html.twig' %}
{% block title %}{% trans %}New relation{% endtrans %}{% endblock title %}
{% block content %}
<div class="flex flex-wrap edit-form">
    {% block form_start %}
        {{ form_start(form, { 'style': 'horizontal' }) }}
    {% endblock %}
    {% block toolbar %}
        {% include '@IntegratedContent/partials/block.toolbar.html.twig' %}
    {% endblock toolbar %}
    <div class="aside-options">
        <aside>
            <div class="aside-holder">
                {% block sidebar %}
                <div class="aside-header">
                    <button class="toggle-filters" onclick="toggleOptionsSidebar()" type="button"><i class="iconoir-cancel"></i>
                    </button>
                    <span>{% trans %}Options{% endtrans %}</span>
                </div>
                <div class="aside-item-wrapper show">
                    <div class="aside-item-header">
                        <h3 class="aside-item-title">
                            <i class="iconoir-info-empty"></i>
                            <span class="aside-item-icon">{% trans %}Status{% endtrans %}</span>
                        </h3>
                        <i class="iconoir-nav-arrow-up"></i>
                    </div>
                    <div class="aside-item-list">
                        <div class="aside-item-list-container">
                            <div class="status-options">
                                <div class="status draft">
                                    <i class="iconoir-design-pencil"></i> {% trans %}Draft{% endtrans %}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                {% if form.location is defined %}
                    {{ form_row(form.location, {'style': 'sidebar', 'icon':'precision-tool', 'state': 'show'}) }}
                {% endif %}
                {% if form.icon is defined %}
                    {{ form_row(form.icon, {'style': 'sidebar', 'icon':'iconoir', 'state': 'show'}) }}
                {% endif %}
                {% if form.options is defined %}
                    {{ form_row(form.options, {'style': 'sidebar', 'icon':'tools', 'state': 'show'}) }}
                {% endif %}
                {% endblock %}
            </div>
        </aside>
    </div>
    <div class="editor-wrapper">
        <div class="page-title">
            <h1 class="heading">{% trans %}Edit{% endtrans %} {% trans %}relation{% endtrans %}</h1>
        </div>
        <section class="editor">
            <section class="section-white section-padding section-radius">
                {{ form_rest(form, {'style':'horizontal'}) }}
            </section>
        </section>
    </div>
    {% block form_end %}
        {{ form_end(form) }}
    {% endblock %}
</div>
{% endblock %}
{% block javascript %}
{{ parent() }}

<script>
$(document).ready(function() {
    $('#integrated_relation_sources').select2();
    $('#integrated_relation_targets').select2();
});
</script>
{% endblock javascript %}
