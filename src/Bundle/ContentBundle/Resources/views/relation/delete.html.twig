{% extends '@IntegratedContent/base.html.twig' %}
{% block title %}{% trans %}Delete search selection{% endtrans %}{% endblock title %}

{% block content %}
    {% block form_start %}
        {{ form_start(form) }}
    {% endblock %}
    {% set relationDeleteToolbarHtml %}
        {% block toolbar %}
            {% include '@IntegratedContent/partials/block.toolbar.html.twig' %}
        {% endblock toolbar %}
    {% endset %}
    {% set relationDeleteTitleHtml %}
        {{ component('integrated_admin:page_title', {
            title: 'Delete'|trans ~ ' ' ~ ('search selection'|trans),
        }) }}
    {% endset %}
    {% set relationDeleteContentHtml %}
        <p>
            {% trans with {'%name%':  relation.name} %}You are about to delete "%name%", click the delete button to confirm the action.{% endtrans %}
        </p>
        {{ form_rest(form, {'style':'horizontal'})}}
    {% endset %}
    {{ component('integrated_admin:edit_form_shell', {
        toolbarHtml: relationDeleteToolbarHtml,
        pageTitleHtml: relationDeleteTitleHtml,
        editorContentHtml: relationDeleteContentHtml,
    }) }}
    {% block form_end %}
        {{ form_end(form) }}
    {% endblock %}
{% endblock %}
