<div class="heading flex justify-between w-full flex-wrap">
    <div class="flex items-center">
        <h1 class="heading">{% trans %}Media Library{% endtrans %}</h1>
        <ul class="options-no-bg">
            {% if contentTypeSelectOptions %}
                <li class="dropdown close-outside" data-underlay="no">
                    <a data-toggle="dropdown" role="button" id="drop_1" class="btn btn-select">
                        <span>{% trans %}New{% endtrans %}</span>
                        <i class="iconoir-plus"></i>
                    </a>
                    <ul aria-labelledby="drop_1" role="menu" class="p-2 dropdown-menu" id="menu_1">
                        {% for type_key, type in contentTypeSelectOptions %}
                            {% if type %}
                                {% set rawTypeId = type.getId is defined ? type.getId : '' %}
                                {% set typeId = rawTypeId is iterable ? '' : rawTypeId %}
                                {% set rawTypeName = type.getName is defined ? type.getName : '' %}
                                {% set typeName = '' %}
                                {% if rawTypeName is iterable %}
                                    {% for value in rawTypeName %}
                                        {% if typeName == '' and value is not iterable and value is not same as(null) %}
                                            {% set typeName = value %}
                                        {% endif %}
                                    {% endfor %}
                                {% else %}
                                    {% set typeName = rawTypeName %}
                                {% endif %}
                                <li role="presentation">
                                    <a data-id="{{ typeId }}"
                                       class="cursor-pointer button_toggle_upload_view_with_contenttype">{{ (typeName != '' ? typeName : typeId)|trans|title }}</a>
                                </li>
                            {% endif %}
                        {% endfor %}
                    </ul>
                </li>
            {% else %}
                <a data-toggle="dropdown" role="button" id="drop_1" class="button_toggle_upload_view btn btn-select">
                    <span>{% trans %}New{% endtrans %}</span>
                    <i class="iconoir-plus"></i>
                </a>
            {% endif %}
        </ul>
    </div>
    <button class="toggle-filters toggle-data-target btn btn-orange icon-left" data-target="aside-filters">
        <i class="iconoir-filter-alt"></i>
        <span>{% trans %}Filter{% endtrans %}</span>
    </button>
</div>
<div class="options flex justify-between sm:mr-2">
    <div class="left flex flex-wrap">
        <button class="button_enable_grid_view toggle_view grid active switcher mr-2"><i
                class="iconoir-view-grid"></i></button>
        <button class="button_enable_list_view toggle_view list switcher mr-2"><i
                class="iconoir-list"></i></button>

        {% if app.request.query.all('available_contenttypes')|length != 1 %}
            <ul class="mr-2">
                <li class="dropdown close-outside" data-underlay="no">
                    {% set currentContentTypeName = contentTypeFilterOptions.options[contentTypeFilterOptions.current].name|default(contentTypeFilterOptions.default) %}
                    {% if currentContentTypeName is iterable %}
                        {% set currentContentTypeName = contentTypeFilterOptions.default %}
                    {% endif %}
                    <a data-toggle="dropdown" role="button" id="sorting-list"
                       class="btn btn-select space-between"><span>{{ currentContentTypeName|trans }}</span>
                        <i class="iconoir-nav-arrow-down"></i></a>
                    <ul aria-labelledby="sorting-list" role="menu" class="dropdown-menu" id="sorting-menu">

                        {% for content_type_key, content_type in contentTypeFilterOptions.options %}

                            {% set rawContentTypeId = content_type.id|default('') %}
                            {% set contentTypeId = rawContentTypeId is iterable ? '' : rawContentTypeId %}
                            {% set contentTypeName = content_type.name|default(contentTypeId) %}
                            {% if contentTypeName is iterable %}
                                {% set contentTypeName = contentTypeId %}
                            {% endif %}
                            <li {% if contentTypeId == contentTypeFilterOptions.current %} class="active" {% endif %}
                                role="presentation">
                                <a href="{{ path(app.request.attributes.get('_route'), app.request.query.all|
                                    merge({'contenttypes': [contentTypeId] })|
                                    merge({'page':1})
                                ) }}"
                                   tabindex="-1"
                                   role="menuitem">{{ contentTypeName|trans|capitalize }}
                                </a>
                            </li>

                        {% endfor %}

                    </ul>
                </li>
            </ul>
        {% endif %}

        <ul class="mr-2">
            <li class="dropdown close-outside" data-underlay="no">
                {% set currentDateLabel = dateFilterOptions.options[dateFilterOptions.current].label|default('All dates') %}
                {% if currentDateLabel is iterable %}
                    {% set currentDateLabel = 'All dates' %}
                {% endif %}
                <a data-toggle="dropdown" role="button" id="sorting-list"
                   class="btn btn-select space-between"><span>{{ currentDateLabel|trans }}</span>
                    <i class="iconoir-nav-arrow-down"></i></a>
                <ul aria-labelledby="sorting-list" role="menu" class="dropdown-menu" id="sorting-menu">

                    {% for year_month_key, year_month in dateFilterOptions.options %}
                        {% set yearMonthLabel = year_month.label|default('') %}
                        {% set yearMonthName = year_month.name|default('') %}
                        {% if yearMonthLabel is iterable %}{% set yearMonthLabel = '' %}{% endif %}
                        {% if yearMonthName is iterable %}{% set yearMonthName = '' %}{% endif %}
                        {% if yearMonthLabel != 'File' %}
                            <li {% if yearMonthName == dateFilterOptions.current %}class="active"
                                {% endif %}role="presentation">
                                <a href="{{ path(app.request.attributes.get('_route'), app.request.query.all|
                                    merge({'year_month': year_month_key == dateFilterOptions.default ? null : year_month_key })|
                                    merge({'page':1})
                                ) }}"
                                   tabindex="-1"
                                   role="menuitem">{{ yearMonthLabel|trans|capitalize }}
                                </a>
                            </li>
                        {% endif %}
                    {% endfor %}

                </ul>
            </li>
        </ul>

        <button class="btn btn-action mr-2" id="bulkselection">{% trans %} Bulkselection {% endtrans %}
        </button>

        <button class="btn btn-light-red mr-2" style="display: none; height: 34px;" id="bulkselection_delete">{% trans %} Delete {% endtrans %} <span class="ml-1" id="amount_of_files_to_delete"></span>
        </button>

        <button class="button_toggle_upload_view btn btn-action">
            <i class="iconoir-media-image-plus"></i>
        </button>

    </div>
</div>
<div class="options flex flex-1">
    <form action="" class="media-search-form" method="get">
        <div class="form-group relative" style="width: 100%">
            {% set queryValue = app.request.query.get('q') %}
            {% if queryValue is iterable %}
                {% set queryValue = '' %}
            {% endif %}
            <input type="text" name="q" class="form-control"
                   value="{{ queryValue|default('')|trim }}"
                   placeholder="{% trans %}Search{% endtrans %}...">
            <button type="submit"><i class="iconoir-search"></i></button>
        </div>
    </form>
</div>
