{% set thumbnail = integrated_image(media.file).cropResize(200, 200) %}
{% set description = media.description|default('') %}
{% set credits = media.credits|default('') %}

<li class="media-item ui-widget-content ui-corner-tr grid {{ media.contentType }}"
    id="{{ media.id }}"
    data-content_type="{{ media.contenttype }}"
    data-id="{{ media.id }}"
    data-media_id="{{ loop.index }}"
    data-thumbnail="{{ thumbnail }}"
    data-file="{{ media.file }}"
    data-title="{{ media.title }}"
    data-mime="{{ media.file.getMetadata().mimeType|default('') }}"
    >
    <div class="media-preview">
        <div class="thumbnail">
            <div class="centered">
                <img src="{{ thumbnail }}" alt="{{ media.title }}">
            </div>
        </div>
        {% if media.file is defined and media.file|split('.')|last|lower not in not_shown_filetypes %}
            <div class="filetype">
                {{ media.file|split('.')|last|lower }}
            </div>
        {% endif %}
    </div>
    <div class="details flex">
        <div class="w-full md:w-1/2">
            <div class="detail-wrap title">
                <span class="detail-label">{% trans %}Title{% endtrans %}:</span>
                <h3>{{ media.title }}</h3>
            </div>
            {% if description %}
                <div class="detail-wrap description">
                    <span class="detail-label">{% trans %}Description{% endtrans %}:</span>
                    <p>{{ description }}</p>
                </div>
            {% endif %}
            {% if credits %}
                <div class="detail-wrap credits">
                    <span class="detail-label">{% trans %}Credits{% endtrans %}:</span>
                    <p>{{ credits }}</p>
                </div>
            {% endif %}
        </div>
        <div class="w-full md:w-1/2">
            {% if media.createdAt is defined %}
                <div class="detail-wrap created-at flex justify-end">
                    <span class="detail-label">{% trans %}Publish date{% endtrans %}:</span>
                    <p>{{ media.createdAt|format_date('long') }}</p>
                </div>
            {% endif %}
        </div>
    </div>

    <button class="media-edit"><i class="iconoir-edit-pencil"></i>
        <span class="screen-reader-text">{% trans %} Edit {% endtrans %}</span>
    </button>

    <button id="bulkselection_{{ media.id }}" type="button" class="bulkselectionbutton check" tabindex="-1">
        <span class="media-modal-icon">
            <i class="iconoir-check"></i>
        </span>
        <span class="screen-reader-text">{% trans %} Deselect {% endtrans %}</span>
    </button>
</li>
