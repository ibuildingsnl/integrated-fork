{% set rawTitle = media.title|default('') %}
{% set title = '' %}
{% if rawTitle is iterable %}
    {% for value in rawTitle %}
        {% if title == '' and value is not iterable and value is not same as(null) %}
            {% set title = value %}
        {% endif %}
    {% endfor %}
{% else %}
    {% set title = rawTitle %}
{% endif %}
{% set rawDescription = media.description|default('') %}
{% set description = '' %}
{% if rawDescription is iterable %}
    {% for value in rawDescription %}
        {% if description == '' and value is not iterable and value is not same as(null) %}
            {% set description = value %}
        {% endif %}
    {% endfor %}
{% else %}
    {% set description = rawDescription %}
{% endif %}
{% set rawCredits = media.credits|default('') %}
{% set credits = '' %}
{% if rawCredits is iterable %}
    {% for value in rawCredits %}
        {% if credits == '' and value is not iterable and value is not same as(null) %}
            {% set credits = value %}
        {% endif %}
    {% endfor %}
{% else %}
    {% set credits = rawCredits %}
{% endif %}
{% set rawContentType = media.contentType is defined ? media.contentType : (media.contenttype is defined ? media.contenttype : '') %}
{% set contentType = rawContentType is iterable ? '' : rawContentType %}
{% set rawContentId = media.type_id is defined ? media.type_id : (media.typeId is defined ? media.typeId : (media.typeid is defined ? media.typeid : media.id)) %}
{% set contentId = rawContentId is iterable ? '' : rawContentId %}
{% set fileRaw = '' %}
{% if media.file is defined %}
    {% if media.file is iterable %}
        {% if media.file.pathName is defined %}
            {% set fileRaw = media.file.pathName %}
        {% elseif media.file.pathname is defined %}
            {% set fileRaw = media.file.pathname %}
        {% elseif media.file.path is defined %}
            {% set fileRaw = media.file.path %}
        {% elseif media.file.url is defined %}
            {% set fileRaw = media.file.url %}
        {% else %}
            {% for value in media.file %}
                {% if fileRaw == '' and value is not iterable and value is not same as(null) %}
                    {% set fileRaw = value %}
                {% endif %}
            {% endfor %}
        {% endif %}
    {% elseif media.file is not same as(null) %}
        {% set fileRaw = media.file %}
    {% endif %}
{% endif %}
{% if fileRaw == '' %}
    {% set rawImagePath = media.image_string is defined ? media.image_string : (media.imageString is defined ? media.imageString : (media.image is defined ? media.image : '')) %}
    {% if rawImagePath is iterable %}
        {% for value in rawImagePath %}
            {% if fileRaw == '' and value is not iterable and value is not same as(null) %}
                {% set fileRaw = value %}
            {% endif %}
        {% endfor %}
    {% elseif rawImagePath is not same as(null) %}
        {% set fileRaw = rawImagePath %}
    {% endif %}
{% endif %}
{% set filePath = fileRaw|trim %}
{% if filePath starts with('{') %}
    {% if '"pathName":"' in filePath %}
        {% set filePath = filePath|split('"pathName":"')|last|split('"')|first %}
    {% elseif '"pathname":"' in filePath %}
        {% set filePath = filePath|split('"pathname":"')|last|split('"')|first %}
    {% elseif '"path":"' in filePath %}
        {% set filePath = filePath|split('"path":"')|last|split('"')|first %}
    {% elseif '"url":"' in filePath %}
        {% set filePath = filePath|split('"url":"')|last|split('"')|first %}
    {% else %}
        {% set filePath = '' %}
    {% endif %}
{% endif %}
{% set filePath = filePath|replace({'\\/': '/'}) %}
{% set thumbnail = filePath ? integrated_image(filePath).cropResize(200, 200) : 'data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw==' %}
{% set filetypeCandidate = filePath|split('.')|last|lower %}
{% set filetype = filetypeCandidate matches '/^[a-z0-9]{1,5}$/' ? filetypeCandidate : '' %}
{% set rawMimeType = '' %}
{% if media.file is defined and media.file is iterable and media.file.metadata is defined and media.file.metadata.mimeType is defined %}
    {% set rawMimeType = media.file.metadata.mimeType %}
{% elseif media.mimeType is defined %}
    {% set rawMimeType = media.mimeType %}
{% elseif media.mime is defined %}
    {% set rawMimeType = media.mime %}
{% elseif media.mimetype_string is defined %}
    {% set rawMimeType = media.mimetype_string %}
{% endif %}
{% set mimeType = '' %}
{% if rawMimeType is iterable %}
    {% for value in rawMimeType %}
        {% if mimeType == '' and value is not iterable and value is not same as(null) %}
            {% set mimeType = value %}
        {% endif %}
    {% endfor %}
{% else %}
    {% set mimeType = rawMimeType %}
{% endif %}

<li class="media-item ui-widget-content ui-corner-tr grid {{ contentType }}{% if contentId in (selected_ids|default([])) %} selected{% endif %}"
    id="{{ contentId }}"
    data-content_type="{{ contentType }}"
    data-id="{{ contentId }}"
    data-media_id="{{ loop is defined ? loop.index : contentId }}"
    data-thumbnail="{{ thumbnail }}"
    data-file="{{ filePath }}"
    data-title="{{ title }}"
    data-mime="{{ mimeType }}"
    >
    <div class="media-preview">
        <div class="thumbnail">
            <div class="centered">
                <img src="{{ thumbnail }}" alt="{{ title }}">
            </div>
        </div>
        {% if filetype and filetype not in not_shown_filetypes %}
            <div class="filetype">
                {{ filetype|upper }}
            </div>
        {% endif %}
    </div>
    <div class="details flex">
        <div class="w-full md:w-1/2">
            <div class="detail-wrap title">
                <span class="detail-label">{% trans %}Title{% endtrans %}:</span>
                <h3>{{ title }}</h3>
            </div>
            {% if description %}
                <div class="detail-wrap description">
                    <span class="detail-label">{% trans %}Description{% endtrans %}:</span>
                    <p>{{ description }}</p>
                </div>
            {% endif %}
            {% if credits %}
                <div class="detail-wrap credits">
                    <span class="detail-label">{% trans %}Credits{% endtrans %}:</span>
                    <p>{{ credits }}</p>
                </div>
            {% endif %}
        </div>
        <div class="w-full md:w-1/2">
            {% if media.createdAt is defined %}
                <div class="detail-wrap created-at flex justify-end">
                    <span class="detail-label">{% trans %}Publish date{% endtrans %}:</span>
                    <p>{{ media.createdAt|format_date('long') }}</p>
                </div>
            {% endif %}
        </div>
    </div>

    <button class="media-edit"><i class="iconoir-edit-pencil"></i>
        <span class="screen-reader-text">{% trans %} Edit {% endtrans %}</span>
    </button>

    <button id="bulkselection_{{ contentId }}" type="button" class="bulkselectionbutton check" tabindex="-1">
        <span class="media-modal-icon">
            <i class="iconoir-check"></i>
        </span>
        <span class="screen-reader-text">{% trans %} Deselect {% endtrans %}</span>
    </button>

    <button class="media-trash single_delete">
        <i class="iconoir-trash"></i>
        <span class="screen-reader-text">{% trans %} Delete {% endtrans %}</span>
    </button>
</li>
