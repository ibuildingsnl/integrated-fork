<div class="mediagallery_selector" id="{{ relation.vars.attr['data-relation'] }}">
    <div class="previously_selected_images hidden">
        {% if form_relations[relation.vars.attr['data-relation']]|default(null) %}
            {% for media in form_relations[relation.vars.attr['data-relation']] %}
                {% set thumbnail = integrated_image(media.file).zoomCrop(200, 200) %}
                <li id="{{ media.id }}"
                    data-id="{{ media.id }}"
                    data-content_type="{{ media.contentType }}"
                    data-file="{{ media.file }}"
                    data-thumbnail="{{ thumbnail }}"
                    data-title="{{ media.title }}">
                </li>
            {% endfor %}
        {% endif %}
    </div>

    <div class="selected_images flex flex-wrap mb-4"
         data-multiple="{{ relation.vars.attr['data-multiple'] }}"
         data-types="{{ relation.vars.attr['data-types'] }}"
         data-relationtype="{{ relation.vars.attr['data-relationtype'] }}"
         data-relationid="{{ relation.vars.attr['data-relation'] }}"
         data-emptytext="{% trans %}Select{% endtrans %} {{ relation.vars.attr['data-title'] }}">
        {# This will be populated with current and new items #}
    </div>

    <div
        data-multiple="{{ relation.vars.attr['data-multiple'] }}"
        data-types="{{ relation.vars.attr['data-types'] }}"
        data-relationtype="{{ relation.vars.attr['data-relationtype'] }}"
        data-relationid="{{ relation.vars.attr['data-relation'] }}"
        class="select_multimedia_button btn btn-white">
        {% trans %}Select{% endtrans %} {{ relation.vars.attr['data-title'] }}
    </div>

    <div class="wrap iframe-wrapper close-outside">
        <iframe class="iframe media-library" src="">
        </iframe>
    </div>

    {# This element will be copied for every image for a embedded relation #}
    <li id="selected_image" class="hidden media-item">
        <div class="media-preview">
            <div class="thumbnail relative">
                <div class="centered">
                    <img src="">
                </div>
                <a class="remove_link remove"><i class="iconoir-cancel"></i></a>
            </div>
        </div>
    </li>
</div>

<script src="{{ asset('bundles/integratedintegrated/mediagallery_selection.js') }}"></script>
