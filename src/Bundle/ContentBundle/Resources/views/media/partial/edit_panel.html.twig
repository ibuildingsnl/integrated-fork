<div class="aside-edit-holder bg-white hide">
    <div class="aside-item-wrapper">
        <button class="close-media-edit-form"><i
                class="iconoir-cancel"></i></button>
        <iframe id="editpaneliframe" src=""></iframe>
    </div>
</div>

<script>
    window.document.addEventListener('editImageClick', handleEvent, false)

    const edit_image_path = '{{ path('integrated_content_media_edit_image', {'id': 'REPLACE'}) }}'

    function handleEvent(e) {
        const media_id = document.querySelector('iframe').dataset.media_id
        window.location.href = edit_image_path.replace('REPLACE', media_id)
    }
</script>
