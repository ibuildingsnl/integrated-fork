<div class="flex flex-wrap media-library">
    {% if selected_modus != 'media_gallery' %}
        {% block toolbar %}
            <div id="toolbar" class="w-full flex justify-between">
                <div class="options">
                    <div class="form-actions">
                        <button class="no-icon btn btn-green"
                                onclick="send_message_to_parent()">{% trans %}Select{% endtrans %}</button>
                    </div>
                </div>
                <div class="back">
                    <button class="icon-left btn btn-white" onclick="send_cancel_to_parent()"><i
                            class="iconoir iconoir-arrow-left"></i><span>{% trans %}Back{% endtrans %}</span></button>
                </div>
            </div>
        {% endblock toolbar %}
    {% endif %}

    <div class="modal fade" id="bulkdelete_confirm_popup" style="display: none;">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h4 class="modal-title">Delete images</h4>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to delete these files?</p>
                    <p id="used_images_message" style="display:none;">These images are currently used in other content:</p>
                    <p id="used_images"></p>
                    <p class="used_images"></p>
                </div>
                <div class="modal-footer">
                    <button type="button" data-modal-hide="popup-modal" id="cancel_delete" class="btn btn-white"
                            data-dismiss="modal">Cancel
                    </button>
                    <button type="button" data-modal-hide="popup-modal" id="confirm_delete"
                            class="btn btn-dark-green live-page">Remove images
                    </button>
                </div>
            </div>
        </div>
    </div>


    <div class="aside-filters close-outside media-sidebar">
        <aside>
            {% include '@IntegratedContent/media/partial/menu_component.html.twig' %}
        </aside>
    </div>

    <div class="aside-filters media-edit-panel hide">
        <aside>
            {% include '@IntegratedContent/media/partial/edit_panel.html.twig' %}
        </aside>
    </div>

    <div class="media-gallery index-wrapper">
        <div class="page-title">
            {% include '@IntegratedContent/media/partial/header_component.html.twig' %}
        </div>

        <section class="section-white section-radius sm:p-4">
            <div id="upload_container" class="close-outside">
                <a class="uppy-close remove"><i class="iconoir-cancel"></i></a>
                {% include '@IntegratedContent/media/upload.html.twig'
                    with {
                    'language': app.request.defaultLocale,
                    'endpoint': path('integrated_content_media_upload_file'),
                    'height': '750px',
                    'imageEditorEnabled': true,
                    'target': '#upload_container .drag-drop-area',
                } %}
            </div>

            {# When you work on bulk select, use the class "mode-select" on media container when you activate bulk select #}
            <div class="media-container">
                <div class="media-wrapper grid_view">
                    {% if paginator.items|length == 0 %}
                        <div>
                            {% trans %}No results with this selection.{% endtrans %}
                        </div>
                    {% endif %}
                    <ul class="flex flex-wrap gallery ui-helper-reset ui-helper-clearfix" id="gallery">
                        {% for media in paginator.items %}
                            {% include '@IntegratedContent/media/partial/media_thumbnail_component.html.twig' %}
                        {% endfor %}
                    </ul>
                </div>

                <div class="mt-2">
                    {{ knp_pagination_render(paginator) }}
                    <div class="flex justify-center">
                        <span>{% trans %} Total {% endtrans %}
                            {{ paginator.getTotalItemCount() }}
                            {% trans %} Items {% endtrans %}.
                            {% if paginator.getItemNumberPerPage() < paginator.getTotalItemCount() %}
                                {% trans %} Showing {% endtrans %}
                                {{ paginator.getCurrentPageNumber() * paginator.getItemNumberPerPage() - paginator.getItemNumberPerPage() + 1 }}
                                {% trans %} till {% endtrans %}
                                {{ paginator.getCurrentPageNumber() * paginator.getItemNumberPerPage() }}.
                            {% endif %}
                        </span>
                    </div>
                </div>
            </div>

        </section>
    </div>
</div>
