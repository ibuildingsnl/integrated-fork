<div class="flex flex-wrap media-library">
    {% if selected_modus != 'media_gallery' %}
        {% block toolbar %}
            <div id="toolbar" class="w-full flex justify-between">
                <div class="options">
                    <div class="form-actions">
                        <button class="no-icon btn btn-green"
                                onclick="send_message_to_parent()">{% trans %}Select{% endtrans %}</button>
                    </div>
                </div>
                <div class="back">
                    <button class="icon-left btn btn-white" onclick="send_cancel_to_parent()"><i
                            class="iconoir iconoir-arrow-left"></i><span>{% trans %}Back{% endtrans %}</span></button>
                </div>
            </div>
        {% endblock toolbar %}
    {% endif %}

    <div class="relative absolute">
        <div id="bulkdelete_confirm_popup" tabindex="-1" class="fixed top-500 left-500  z-50 hidden p-4 overflow-x-hidden overflow-y-auto md:inset-0 h-[calc(100%-1rem)] max-h-full">
            <div class="relative w-full max-w-md max-h-full">
                <div class="relative bg-white rounded-lg shadow dark:bg-gray-700">
                    <div class="p-6 text-center text-black">
                        <svg aria-hidden="true" class="mx-auto mb-4 text-gray-400 w-14 h-14 dark:text-gray-200" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                        <h3 class="mb-5 text-lg font-normal text-gray-500 dark:text-gray-400">Are you sure you want to delete these files?</h3>
                        <div class="mb-5 mt-2 text-lg font-normal" id="used_images_message">These images are currently used in other content:</div>
                        <div class="mb-5 mt-2 text-lg font-normal" id="used_images"></div>
                        <div class="mt-2 text-left font-normal used_images"></div>
                        <button data-modal-hide="popup-modal" id="confirm_delete" type="button" class="mt-2 hover:bg-red-800 focus:ring-4 focus:outline-none focus:ring-red-300 dark:focus:ring-red-800 font-medium rounded-lg text-sm inline-flex items-center px-5 py-2.5 text-center mr-2">
                            Yes
                        </button>
                        <button data-modal-hide="popup-modal" id="cancel_delete" type="button" class="mt-2 text-gray-500 bg-white hover:bg-gray-100 focus:ring-4 focus:outline-none focus:ring-gray-200 rounded-lg border border-gray-200 text-sm font-medium px-5 py-2.5 hover:text-gray-900 focus:z-10 dark:bg-gray-700 dark:text-gray-300 dark:border-gray-500 dark:hover:text-white dark:hover:bg-gray-600 dark:focus:ring-gray-600">No</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="aside-filters close-outside media-sidebar">
        <aside>
            {% include '@IntegratedContent/media/partial/menu_component.html.twig' %}
        </aside>
    </div>

    <div class="aside-filters media-edit-panel hide">
        <aside>
            {% include '@IntegratedContent/media/partial/edit_panel.html.twig' %}
        </aside>
    </div>

    <div class="media-gallery index-wrapper">
        <div class="page-title">
            {% include '@IntegratedContent/media/partial/header_component.html.twig' %}
        </div>

        <section class="section-white section-radius sm:p-4">
            <div id="upload_container" class="close-outside">
                <a class="uppy-close remove"><i class="iconoir-cancel"></i></a>
                {% include '@IntegratedContent/media/upload.html.twig'
                    with {
                    'language': app.request.defaultLocale,
                    'endpoint': path('integrated_content_media_upload_file'),
                    'height': '750px',
                    'imageEditorEnabled': true,
                    'target': '#upload_container .drag-drop-area',
                } %}
            </div>

            {# When you work on bulk select, use the class "mode-select" on media container when you activate bulk select #}
            <div class="media-container">
                <div class="media-wrapper grid_view">
                    {% if paginator.items|length == 0 %}
                        <div>
                            {% trans %}No results with this selection.{% endtrans %}
                        </div>
                    {% endif %}
                    <ul class="flex flex-wrap gallery ui-helper-reset ui-helper-clearfix" id="gallery">
                        {% for media in paginator.items %}
                            {% include '@IntegratedContent/media/partial/media_thumbnail_component.html.twig' %}
                        {% endfor %}
                    </ul>
                </div>

                <div class="mt-2">
                    {{ knp_pagination_render(paginator) }}
                    <div class="flex justify-center">
                        <span>{% trans %} Total {% endtrans %}
                            {{ paginator.getTotalItemCount() }}
                            {% trans %} Items {% endtrans %}.
                            {% if paginator.getItemNumberPerPage() < paginator.getTotalItemCount() %}
                                {% trans %} Showing {% endtrans %}
                                {{ paginator.getCurrentPageNumber() * paginator.getItemNumberPerPage() - paginator.getItemNumberPerPage() + 1 }}
                                {% trans %} till {% endtrans %}
                                {{ paginator.getCurrentPageNumber() * paginator.getItemNumberPerPage() }}.
                            {% endif %}
                        </span>
                    </div>
                </div>
            </div>

        </section>
    </div>
</div>
