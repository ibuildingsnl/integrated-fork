<div class="flex flex-wrap media-library">
    {% if selected_modus != 'media_gallery' %}
        {% block toolbar %}
            <div id="toolbar" class="w-full flex justify-between">
                <div class="options">
                    <div class="form-actions">
                        <button class="no-icon btn btn-green"
                                onclick="send_message_to_parent()">{% trans %}Select{% endtrans %}</button>
                    </div>
                </div>
                <div class="back">
                    <button class="icon-left btn btn-white" onclick="send_cancel_to_parent()"><i
                            class="iconoir iconoir-arrow-left"></i><span>{% trans %}Back{% endtrans %}</span></button>
                </div>
            </div>
        {% endblock toolbar %}
    {% endif %}

    {% set bulkDeleteModalBodyHtml %}
        <p>{% trans %}Are you sure you want to delete these files?{% endtrans %}</p>

        <p id="used_images_message" style="display:none;">{% trans %}These images are currently used in other content{% endtrans %}</p>
        <p id="used_images"></p>
        <div id="used_image" class="used_image">
        </div>
    {% endset %}
    {% set bulkDeleteModalCancelHtml %}
        <button type="button" data-modal-hide="popup-modal" id="cancel_delete" class="btn btn-white"
                data-dismiss="modal">{% trans %}Cancel{% endtrans %}
        </button>
    {% endset %}
    {% set bulkDeleteModalConfirmHtml %}
        <button type="button" data-modal-hide="popup-modal" id="confirm_delete"
                class="btn btn-dark-green live-page">{% trans %}Remove images{% endtrans %}
        </button>
    {% endset %}
    {{ component('integrated_admin:confirm_modal', {
        modalId: 'bulkdelete_confirm_popup',
        title: 'Delete images'|trans,
        bodyHtml: bulkDeleteModalBodyHtml,
        cancelHtml: bulkDeleteModalCancelHtml,
        confirmHtml: bulkDeleteModalConfirmHtml,
        modalAttributes: 'style="display: none;"',
    }) }}


    <div class="aside-filters close-outside media-sidebar">
        <aside>
            {% include '@IntegratedContent/media/partial/menu_component.html.twig' %}
        </aside>
    </div>

    <div class="aside-filters media-edit-panel hide">
        <aside>
            {% include '@IntegratedContent/media/partial/edit_panel.html.twig' %}
        </aside>
    </div>

    <div class="media-gallery index-wrapper">
        {% set mediaPageTitleHtml %}
            <div class="flex items-center">
                <h1 class="heading">{% trans %}Media Library{% endtrans %}</h1>
                <ul class="options-no-bg">
                    {% if contentTypeSelectOptions %}
                        <li class="dropdown close-outside" data-underlay="no">
                            <a data-toggle="dropdown" role="button" id="drop_1" class="btn btn-select">
                                <span>{% trans %}New{% endtrans %}</span>
                                <i class="iconoir-plus"></i>
                            </a>
                            <ul aria-labelledby="drop_1" role="menu" class="p-2 dropdown-menu" id="menu_1">
                                {% for type_key, type in contentTypeSelectOptions %}
                                    {% if type %}
                                        {% set rawTypeId = type.getId is defined ? type.getId : '' %}
                                        {% set typeId = rawTypeId is iterable ? '' : rawTypeId %}
                                        {% set rawTypeName = type.getName is defined ? type.getName : '' %}
                                        {% set typeName = '' %}
                                        {% if rawTypeName is iterable %}
                                            {% for value in rawTypeName %}
                                                {% if typeName == '' and value is not iterable and value is not same as(null) %}
                                                    {% set typeName = value %}
                                                {% endif %}
                                            {% endfor %}
                                        {% else %}
                                            {% set typeName = rawTypeName %}
                                        {% endif %}
                                        <li role="presentation">
                                            <a data-id="{{ typeId }}"
                                               class="cursor-pointer button_toggle_upload_view_with_contenttype">{{ (typeName != '' ? typeName : typeId)|trans|title }}</a>
                                        </li>
                                    {% endif %}
                                {% endfor %}
                            </ul>
                        </li>
                    {% else %}
                        <a data-toggle="dropdown" role="button" id="drop_1" class="button_toggle_upload_view btn btn-select">
                            <span>{% trans %}New{% endtrans %}</span>
                            <i class="iconoir-plus"></i>
                        </a>
                    {% endif %}
                </ul>
            </div>
        {% endset %}
        {% set mediaPageTitleActionsHtml %}
            <button class="toggle-filters toggle-data-target btn btn-orange icon-left" data-target="aside-filters">
                <i class="iconoir-filter-alt"></i>
                <span>{% trans %}Filter{% endtrans %}</span>
            </button>
        {% endset %}
        {% set mediaPageTitleContentHtml %}
            {% include '@IntegratedContent/media/partial/header_component.html.twig' %}
        {% endset %}
        {{ component('integrated_admin:page_title', {
            titleHtml: mediaPageTitleHtml,
            actionsHtml: mediaPageTitleActionsHtml,
            contentHtml: mediaPageTitleContentHtml,
        }) }}

        {% component 'integrated_admin:section_card' with {
            extraClass: 'sm:p-4',
        } %}
            {% block content %}
                <div id="upload_container" class="close-outside">
                    <a class="uppy-close remove"><i class="iconoir-xmark"></i></a>
                    {% include '@IntegratedContent/media/upload.html.twig'
                        with {
                        'language': app.request.defaultLocale,
                        'endpoint': path('integrated_content_media_upload_file'),
                        'height': '750px',
                        'imageEditorEnabled': true,
                        'target': '#upload_container .drag-drop-area',
                    } %}
                </div>

                {# When you work on bulk select, use the class "mode-select" on media container when you activate bulk select #}
                <div class="media-container">
                    <div class="media-wrapper grid_view">
                        {% if paginator.items|length == 0 %}
                            <div>
                                {% trans %}No results with this selection.{% endtrans %}
                            </div>
                        {% endif %}
                        <ul class="flex flex-wrap gallery ui-helper-reset ui-helper-clearfix" id="gallery">
                            {% set selected_ids = [] %}
                            {% set rendered_ids = [] %}
                            {% for media in selectedMedia|default([]) %}
                                {% set media_content_id = media.type_id is defined ? media.type_id : (media.typeId is defined ? media.typeId : (media.typeid is defined ? media.typeid : media.id)) %}
                                {% if media_content_id and media_content_id not in selected_ids %}
                                    {% set selected_ids = selected_ids|merge([media_content_id]) %}
                                {% endif %}
                            {% endfor %}

                            {% for media in selectedMedia|default([]) %}
                                {% set media_content_id = media.type_id is defined ? media.type_id : (media.typeId is defined ? media.typeId : (media.typeid is defined ? media.typeid : media.id)) %}
                                {% if media_content_id and media_content_id not in rendered_ids %}
                                    {% include '@IntegratedContent/media/partial/media_thumbnail_component.html.twig' %}
                                    {% set rendered_ids = rendered_ids|merge([media_content_id]) %}
                                {% endif %}
                            {% endfor %}

                            {% set per_page = paginator.getItemNumberPerPage() %}
                            {% set remaining = per_page - (selected_ids|length) %}
                            {% if remaining < 0 %}{% set remaining = 0 %}{% endif %}
                            {% set shown = 0 %}
                            {% for media in paginator.items %}
                                {% set media_content_id = media.type_id is defined ? media.type_id : (media.typeId is defined ? media.typeId : (media.typeid is defined ? media.typeid : media.id)) %}
                                {% if media_content_id and media_content_id not in rendered_ids and shown < remaining %}
                                    {% include '@IntegratedContent/media/partial/media_thumbnail_component.html.twig' %}
                                    {% set rendered_ids = rendered_ids|merge([media_content_id]) %}
                                    {% set shown = shown + 1 %}
                                {% endif %}
                            {% endfor %}
                        </ul>
                    </div>

                    <div class="mt-2">
                        {{ component('integrated_admin:pagination_footer', {
                            pagination: paginator,
                        }) }}
                        <div class="flex justify-center">
                            <span>{% trans %} Total {% endtrans %}
                                {{ paginator.getTotalItemCount() }}
                                {% trans %} Items {% endtrans %}.
                                {% if paginator.getItemNumberPerPage() < paginator.getTotalItemCount() %}
                                    {% trans %} Showing {% endtrans %}
                                    {{ paginator.getCurrentPageNumber() * paginator.getItemNumberPerPage() - paginator.getItemNumberPerPage() + 1 }}
                                    {% trans %} till {% endtrans %}
                                    {{ paginator.getCurrentPageNumber() * paginator.getItemNumberPerPage() }}.
                                {% endif %}
                            </span>
                        </div>
                    </div>
                </div>
            {% endblock %}
        {% endcomponent %}
    </div>
</div>
