{% extends '@IntegratedContent/base.html.twig' %}

{% set selected_modus = 'media_gallery' %}

{% block title %} {% trans %}Media Library{% endtrans %}{% endblock title %}
{% block content %}

    {% include '@IntegratedContent/media/partial/index_component.html.twig' with {
        selected_modus: selected_modus|default('media_gallery'),
    } %}

{% endblock %}

{% block head_javascript %}
    <script>
        const path = '{{ path('integrated_content_media_manage_relations') }}'
        const bulkdelete_path = '{{ path('integrated_content_media_bulkdelete') }}'
        const selected_modus = '{{ selected_modus|default('media_gallery') }}'
    </script>

    <script src="{{ asset('bundles/integratedintegrated/mediagallery.js') }}"></script>
{% endblock %}

{% block webpack_js %}
    <script src="{{ asset('bundles/integratedintegrated/app.js') }}"></script>
{% endblock %}
