    <style>
        .ui-droppable-hover, .bulkselected {
            background-color: lightskyblue;
        }

        .flash {
            -moz-animation: flash 1s ease-out;
            -moz-animation-iteration-count: 1;

            -webkit-animation: flash 1s ease-out;
            -webkit-animation-iteration-count: 1;

            -ms-animation: flash 1s ease-out;
            -ms-animation-iteration-count: 1;
        }

        @keyframes flash {
            0% {
                background-color: transparent;
            }
            50% {
                background-color: #fbf8b2;
            }
            100% {
                background-color: transparent;
            }
        }

        @-webkit-keyframes flash {
            0% {
                background-color: transparent;
            }
            50% {
                background-color: #fbf8b2;
            }
            100% {
                background-color: transparent;
            }
        }

        @-moz-keyframes flash {
            0% {
                background-color: transparent;
            }
            50% {
                background-color: #fbf8b2;
            }
            100% {
                background-color: transparent;
            }
        }

        @-ms-keyframes flash {
            0% {
                background-color: transparent;
            }
            50% {
                background-color: #fbf8b2;
            }
            100% {
                background-color: transparent;
            }
        }

        .media-container {
            padding: 2rem;
        }

        .media-wrapper ul {
            margin: -0.5rem;
        }

        .media-library .media-preview {
            position: relative;
            background: #f2f2f2;
            cursor: pointer;
            border-radius: 8px;
            overflow: hidden;
        }

        .media-library .media-item {
            position: relative;
            float: left;
            padding: 8px;
            margin: 0;
            width: 10%;
            color: #3c434a;
            cursor: pointer;
            list-style: none;
            text-align: center;
            -webkit-user-select: none;
            user-select: none;
            box-sizing: border-box;
        }

        .media-library .media-preview:before {
            content: "";
            display: block;
            padding-top: 100%;
        }

        .media-library .media-item .thumbnail {
            overflow: hidden;
            position: absolute;
            top: 0;
            right: 0;
            bottom: 0;
            left: 0;
            opacity: 1;
            transition: opacity .1s;
            background-size: cover;
        }

        .media-library .media-item .check {
            display: none;
            height: 24px;
            width: 24px;
            padding: 0;
            border: 0;
            position: absolute;
            z-index: 10;
            top: 0;
            right: 0;
            outline: 0;
            background-color: #00b2ee;
            border-color: #00b2ee;
            color: white;
            font-size: 18px;
            cursor: pointer;
            border-radius: 4px;
        }

        .media-library .media-item.selected .check {
            display: block;
        }

        .media-container.mode-select .media-item .thumbnail {
            opacity: .65;
        }

        .media-container.mode-select .media-item.selected .thumbnail {
            opacity: 1;
        }

        .media-container.mode-select a {
            pointer-events: none;
        }

        .screen-reader-text {
            position: absolute;
            top: -10000em;
            width: 1px;
            height: 1px;
            margin: -1px;
            padding: 0;
            overflow: hidden;
            clip: rect(0, 0, 0, 0);
            border: 0;
        }

        .media-library .media-item .thumbnail img {
            transform: translate(-50%, -50%);
            position: absolute;
            top: 0;
            left: 0;
        }

        .media-library .media-item .thumbnail .centered {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            transform: translate(50%, 50%);
        }

        .media-library .media-item .thumbnail:after {
            content: "";
            display: block;
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            box-shadow: inset 0 0 0 1px rgb(0 0 0 / 10%);
            overflow: hidden;
        }


        ul.aside-filter-menu {
            padding: 2rem;
        }

        ul.aside-filter-menu li {
            padding: .5rem 0;
        }

        ul.aside-filter-menu li span {
            margin-left: 1rem;
        }

        form.media-search-form input {
            border: 1px solid #dee3e9;
            border-radius: 8px;
            color: #000;
            font-size: 13px;
            padding: 0 1rem 0 2rem;
            width: 100%;
            height: 34px;
        }

        form.media-search-form {
            position: relative;
        }

        form.media-search-form button {
            position: absolute;
            top: 6px;
            left: 8px;
            color: #beccde;
        }


    </style>
{% endblock %}

{% block webpack_js %}
    <script src="https://code.jquery.com/jquery-3.6.1.min.js"
            integrity="sha256-o88AwQnZB+VDvE9tvIXrMQaPlFFSUTR+nldQm1LuPXQ=" crossorigin="anonymous"></script>
    <script
            src="https://code.jquery.com/ui/1.13.2/jquery-ui.min.js"
            integrity="sha256-lSjKY0/srUM9BE3dPm+c4fBo1dky2v27Gdjm2uoZaL0="
            crossorigin="anonymous"></script>

    <script>

        $("#media_category_submit").on("click", function (event) {
            console.log("SEND")
            event.preventDefault()
            handleFormSubmit(event);
        });

        function handleFormSubmit(e) {

            let formData = new FormData(document.querySelector('form'))

            let csrf = document.querySelector('#media_category_csrf').value
            let csrf_val = csrf.value
            console.log(csrf)
            console.log(csrf_val)
            console.log(e)
            console.log(formData)
        }

        //BULKSELECTION FUNCTIONALITY
        let bulkSelectionEnabled = false //this controls if we show an icon with each image
        let bulkSelection = [] //this keeps track which items are selected
        let latestBulkSelectionItemClicked = null //so we can handle a shift click with a from - to

        $("#bulkselection").on("click", function () {
            if (bulkSelectionEnabled) {
                disableBulkSelection()
            } else {
                enableBulkSelection()
            }
            bulkSelectionEnabled = !bulkSelectionEnabled
        });

        function enableBulkSelection() {
            $('.bulkselectionbutton').removeClass('bulkselected')
            $('.media-container').addClass('mode-select')

            $(".media-item").on("click", function (event) {
                handleBulkItemClick(event);
            });
        }

        function handleBulkItemClick(event) {
            let media_id = null
            if (event.shiftKey === true) {
                //SHIFT CLICK
                if (latestBulkSelectionItemClicked === null) {
                    latestBulkSelectionItemClicked = 1
                }

                let step_from = latestBulkSelectionItemClicked * 1
                step_to = event.currentTarget.getAttribute('data-media_id') * 1

                for (let step = step_from; step <= step_to; step++) {
                    let element = document.querySelector('.media-item[data-media_id="' + step + '"]')

                    //element.preventDefault();

                    media_id = element.getAttribute('data-id')

                    bulkSelection.push(media_id)
                    $('#' + element.id).addClass('selected')
                }
            } else {
                //SINGLE CLICK
                media_id = event.currentTarget.getAttribute('data-id')

                if (bulkSelection.includes(media_id)) {
                    bulkSelection = bulkSelection.filter(item => item !== media_id)
                    $('#' + event.currentTarget.id).removeClass('selected')
                } else {
                    bulkSelection.push(media_id)
                    $('#' + event.currentTarget.id).addClass('selected')
                }
            }

            latestBulkSelectionItemClicked = event.currentTarget.getAttribute('data-media_id')
        }

        function disableBulkSelection() {
            bulkSelection = []
            $('.media-container').removeClass('mode-select')
            $('.media-item').removeClass('selected')
            // $('.check .fa-folders').removeClass('fa-folders')
        }

        //DRAG AND DROP FUNCTIONALITY
        (function ($) {
            $(function () {

                let $gallery = $("#gallery")
                let $trash = $(".media_category");

                $("li", $gallery).draggable({
                    // cancel: "a.ui-icon", // clicking an icon won't initiate dragging
                    containment: "document",
                    helper: "clone",
                    cursor: "move",
                });

                // Let the trash be droppable, accepting the gallery items
                $trash.droppable({
                    accept: "#gallery > li",
                    classes: {
                        "ui-droppable-active": "ui-state-highlight"
                    },
                    drop: function (event, ui) {
                        current_id = this.id
                        moveImage(ui.draggable, event, current_id);
                    },
                    over: function (event, ui) {
                        // $('.display').html( this.id );
                    }
                });

                function onlyUnique(value, index, self) {
                    return self.indexOf(value) === index;
                }

                function moveImage($item, event, category_id = null) {
                    let media_id = $item[0].id || null

                    //So here we want to send something to the server
                    if (bulkSelection.length > 0) {
                        console.log("Were bulk moving!")
                        let duplicatesRemoved = bulkSelection.filter(onlyUnique);
                        console.log(duplicatesRemoved)
                        sendAjaxRequest(category_id, duplicatesRemoved)
                    } else {
                        console.log("We`re single moving:")
                        sendAjaxRequest(category_id, media_id)
                        console.log(media_id)
                    }
                    console.log("To: " + category_id)
                    $('.media_category').removeClass('flash')
                    $('#' + category_id).addClass("flash");
                }

                function sendAjaxRequest(category_id, media_id) {
                    let jsonContent = JSON.stringify({
                        csrf: document.querySelector('#media_category_csrf').value,
                        category_id: category_id,
                        media_id: media_id
                    })

                    postData('https://localhost.integratedfordevelopers.com/admin/media/edit', jsonContent

                    ).then((data) => {
                        console.log(data); // JSON data parsed by `data.json()` call
                    });

                    // Example POST method implementation:
                    async function postData(url = '', data = {}) {
                        // Default options are marked with *
                        const response = await fetch(url, {
                            method: 'PUT', // *GET, POST, PUT, DELETE, etc.
                            mode: 'cors', // no-cors, *cors, same-origin
                            cache: 'no-cache', // *default, no-cache, reload, force-cache, only-if-cached
                            credentials: 'same-origin', // include, *same-origin, omit
                            // headers: {
                            //     'Content-Type': 'application/json'
                            //     // 'Content-Type': 'application/x-www-form-urlencoded',
                            // },
                            redirect: 'follow', // manual, *follow, error
                            referrerPolicy: 'no-referrer', // no-referrer, *no-referrer-when-downgrade, origin, origin-when-cross-origin, same-origin, strict-origin, strict-origin-when-cross-origin, unsafe-url
                            body: data // body data type must match "Content-Type" header
                        });

                        return response; // parses JSON response into native JavaScript objects
                    }
                }
            });
        })(jQuery);
    </script>
    <script src="{{ asset('bundles/integratedintegrated/mediagallery.js') }}"></script>
{% endblock %}
