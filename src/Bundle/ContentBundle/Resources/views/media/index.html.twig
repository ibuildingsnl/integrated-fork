{% extends '@IntegratedContent/base.html.twig' %}
{% block content %}

    <div class="grid-container">
        <div class="menu">
            {#        <h3>Linker menu</h3> #}
            <div class="menu">
                <div class="menu-item">
                    <a>Alle bestanden</a>
                </div>
                <div class="menu-item">
                    <input type="search" placeholder="Voer de naam van de map in">
                </div>
                {% for menu_item in menu %}
                    <div class="menu-item">
                        {{ menu_item }}
                    </div>
                {% endfor %}
            </div>
        </div>

        <div class="header" style="padding-bottom: 20px">
            <div>



                <form action="" class="media-search-form" method="get">
                    <div class="form-group relative" style="width: 250px">
                        <input type="text" name="q" class="form-control" value="{{ app.request.query.get('q')|trim }}"
                               placeholder="{% trans %}Zoeken{% endtrans %}...">
                        <button type="submit"><i class="integrate-icon-search"></i></button>
                    </div>
                </form>
                <li class="dropdown">
                    <a href data-toggle="dropdown" role="button" id="sorting-list">{% trans %}Filter by{% endtrans %}
                        : {{ params.sort.options[params.sort.current].label|trans }} <b class="caret"></b></a>
                    <ul aria-labelledby="sorting-list" role="menu" class="dropdown-menu" id="sorting-menu">

                        {% for sort in params.sort.options %}

                            <li {% if sort.name == params.sort.current %}class="active" {% endif %}role="presentation">
                                <a href="{{ path(app.request.attributes.get('_route'), app.request.query.all|merge({'class_string': sort.name == params.sort.default ? null : sort.name })) }}" tabindex="-1" role="menuitem">{{ sort.label|trans|capitalize }}</a>
                            </li>

                        {% endfor %}

                    </ul>
                </li>
            </div>
        </div>

        <div class="main">
            <div class="flex flex-wrap">
                {% for media in items %}

                    <div class="flex-item">
                        <div class="flex-content">
                            <a href="{{ path('integrated_content_content_edit', {id: media.id}) }}">
                                {#                            <div class="image-title">{{ media.title|default('geen title') }}</div> #}
                                {% if media.contentType == 'image' %}
                                    <img src="{{ integrated_image(media.file).zoomCrop(150, 100) }}" alt="test"/>

                                {% elseif media.contentType == 'video' %}
                                    {#                TODO add stills for images #}
                                    <img width="150px" height="100"
                                         src="data:image/png;base64,"
                                         alt="test"/>

                                {% elseif media.contentType == 'file' %}
                                    {#                TODO add stills for files #}
                                    <img width="150px" height="100"
                                         src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcQS4vyXJNiQlY9mOgPqiZJ3Plom1W_vaRavbg&usqp=CAU"
                                         alt="test"/>
                                {% else %}
                                    {#                                TODO How to handle custom ContentTypes that can be anything? #}
                                    {#                                We could check pathname / identifier, but that is not so elegant# #}
                                    <img width="150px" height="100"
                                         src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcQS4vyXJNiQlY9mOgPqiZJ3Plom1W_vaRavbg&usqp=CAU"
                                         alt="test"/>
                                {% endif %}

                            </a>
                        </div>
                    </div>
                {% endfor %}
            </div>

        </div>
    </div>

    <style>

        .flex-item {
            flex: 25%;
            max-width: 25%;
            padding: 0 4px 20px;
        }

        .menu {
            background-color: #cdd;
            padding: 7px;
        }

        .menu-item {
            padding: 2px;
        }

        .grid-container {
            display: grid;
            grid-template-areas:
    'menu header header header header header'
    'menu main main main main main';
            gap: 10px;
            background-color: #eee;
            padding: 10px;
        }

        .menu {
            grid-area: menu;
        }

        .main {
            grid-area: main;
            padding-top: 20px;
        }

        .header {
            background-color: #cdd;
            padding: 10px;
            grid-area: header;
        }

        .header a {
            padding-right: 8px;
        }

        .menu {
            grid-area: menu;
            max-width: 230px;
        }
    </style>
{% endblock %}
