{% extends '@IntegratedContent/base.html.twig'  %}

{% set selected_modus = 'select_multiple' %}

{% block title %} {% trans %}Media Library{% endtrans %}{% endblock title %}

{% block sidebar_menu %}{% endblock %}

{% block header %}{% endblock %}

{% block content %}
    {% include '@IntegratedContent/media/partial/index_component.html.twig' with {
        selected_modus: selected_modus|default('select_multiple'),
    } %}
{% endblock %}

{% block head_javascript %}
    {{ parent() }}

    <script>
        const path = '{{ path('integrated_content_media_manage_relations') }}'
        const bulkdelete_path = '{{ path('integrated_content_media_bulkdelete') }}'
        const selected_modus = '{{ selected_modus|default('media_gallery') }}'
    </script>

    <script src="{{ asset('bundles/integratedintegrated/mediagallery.js') }}" defer data-turbo-track="reload"></script>
{% endblock %}

{% block webpack_js %}
    <script>
        window.resolveMediaPickerUri = window.resolveMediaPickerUri || function (media) {
            if (!media) {
                return '';
            }

            var raw = (media.dataset.file || '').trim();
            var fallback = (media.dataset.thumbnail || '').trim();

            if (!raw) {
                return fallback;
            }

            if (raw.charAt(0) === '{') {
                try {
                    var parsed = JSON.parse(raw);
                    raw = (parsed && (parsed.pathName || parsed.pathname || parsed.path || parsed.url)) || '';
                } catch (e) {
                    var match = raw.match(/"(?:pathName|pathname|path|url)"\s*:\s*"([^"]+)"/);
                    raw = match ? match[1] : '';
                }
            }

            return (raw && raw !== '{') ? raw : fallback;
        };

        document.addEventListener('keyup', function (e) {
            if (e.key !== 'Escape') {
                return;
            }

            const parentDocument = window.parent && window.parent.document ? window.parent.document : null;
            if (parentDocument) {
                parentDocument
                    .querySelectorAll('.close-outside.show')
                    .forEach((element) => element.classList.remove('show'));

                const dropdownOverlay = parentDocument.querySelector('#dropdown_overlay');
                if (dropdownOverlay) {
                    dropdownOverlay.classList.add('hide');
                }
            }

            window.popupShown = false;
        });
    </script>
{% endblock %}
