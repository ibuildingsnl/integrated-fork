{% set wrapperTag = tag in ['article', 'aside', 'div', 'section'] ? tag : 'section' %}
<{{ wrapperTag }} class="{{ this.surfaceClass }}">
    {% if title or subtitle %}
        <header class="p-4 pb-0">
            {% if title %}
                <h2 class="heading">{{ title }}</h2>
            {% endif %}
            {% if subtitle %}
                <p class="mb-0 text-light">{{ subtitle }}</p>
            {% endif %}
        </header>
    {% endif %}
    {% block content %}{% endblock %}
</{{ wrapperTag }}>
