{% extends '@IntegratedContent/base.html.twig' %}
{% block title %}{% trans %}Edit channel{% endtrans %}{% endblock title %}
{% block style %}
    {{ parent() }}

    <link rel="stylesheet" href="{{ asset('bundles/integratedintegrated/edit.css') }}">
{% endblock %}

{% block content %}
    <div class="flex flex-wrap edit-form">
        {% block form_start %}
            {{ form_start(form, { 'style': 'horizontal' }) }}
        {% endblock %}
        {% block toolbar %}
            {% include '@IntegratedContent/partials/block.toolbar.html.twig' %}
        {% endblock toolbar %}
        <div class="aside-options">
            <aside>
                <div class="aside-holder">
                    {% block sidebar %}
                        <div class="aside-header">
                            <button class="toggle-filters toggle-options-sidebar"  data-target="aside-options" type="button"><i class="iconoir-cancel"></i></button>
                            <span>{% trans %}Options{% endtrans %}</span>
                        </div>
                        {% block content_meta %}
                            {% if form.scope is defined %}
                                {{ form_row(form.scope, {'style': 'sidebar', 'icon':'precision-tool', 'state': 'show'}) }}
                            {% endif %}

                            {% if form.permissions is defined %}
                                {{ form_row(form.permissions, {'style': 'sidebar', 'icon':'key-alt-back', 'state': 'show'}) }}
                            {% endif %}
                            {% if form.ipProtected is defined %}
                                {{ form_row(form.ipProtected, {'style': 'sidebar', 'icon':'antenna-off', 'state': 'show'}) }}
                            {% endif %}
                            {% if form.color is defined %}
                                {{ form_row(form.color, {'style': 'sidebar', 'icon':'droplet', 'state': 'show'}) }}
                            {% endif %}
                            {% if form.secondary_color is defined %}
                                {{ form_row(form.secondary_color, {'style': 'sidebar', 'icon':'droplet', 'state': 'show'}) }}
                            {% endif %}
                            {% if form.logo is defined %}
                                {{ form_row(form.logo, {'style': 'sidebar', 'icon':'media-image', 'state': 'show'}) }}
                            {% endif %}
                            {% if form.options is defined %}
                                {{ form_row(form.options, {'style': 'sidebar', 'icon':'tools', 'state': 'show'}) }}
                            {% endif %}
                        {% endblock %}
                    {% endblock %}
                </div>
            </aside>
        </div>
        <div class="editor-wrapper">
            <div class="page-title">
                <h1 class="heading">{% trans %}Edit {% endtrans %} {{ channel.name }}</h1>
            </div>
            <section class="editor">
                {% block content_form %}
                    {% if form.name is defined %}
                        {{ form_row(form.name, {'style': 'inline'}) }}
                    {% endif %}

                    {% if form.domains is defined %}
                        {{ form_row(form.domains, {'style': 'editor','state': 'show'}) }}
                    {% endif %}

                    {{ form_rest(form, {'style':'editor', 'state':'show'})}}
                {% endblock %}
            </section>
        </div>


        {% block form_end %}
            {{ form_end(form) }}
        {% endblock %}
    </div>
{% endblock %}

{% block webpack_js %}
    <script src="{{ asset('bundles/integratedintegrated/edit.js') }}"></script>
{% endblock %}

{% block javascript %}
    {{ parent() }}

    <script src="{{ asset('bundles/integratedcontent/js/channel.js') }}"></script>
{% endblock javascript %}
