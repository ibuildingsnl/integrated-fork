{% extends '@IntegratedContent/base.html.twig' %}
{% block title %}{% trans %}Edit channel{% endtrans %}{% endblock title %}
{% block style %}
    {{ parent() }}

    <link rel="stylesheet" href="{{ asset('bundles/integratedintegrated/edit.css') }}">
{% endblock %}

{% block content %}
    <div class="flex flex-wrap edit-form">
        {% block form_start %}
            {{ form_start(form, { 'style': 'horizontal' }) }}
            {% dump(form) %}
        {% endblock %}
        <div id="toolbar" class="w-full flex justify-between">
            <div class="back">
                {% block form_return %}
                    {% if form.actions.back is defined %}
                        {{ form_row(form.actions.back) }}
                    {% endif %}
                    {% if form.actions.cancel is defined %}
                        {{ form_row(form.actions.cancel) }}
                    {% endif %}
                {% endblock %}
            </div>
            <div class="options">
                <div class="form-actions">
                    {% block form_actions %}
                        {% if form.actions.save is defined %}
                            {{ form_row(form.actions.save) }}
                        {% endif %}
                        {% if form.actions.reload is defined %}
                            {{ form_row(form.actions.reload) }}
                        {% endif %}
                        {% if form.actions.create is defined %}
                            {{ form_row(form.actions.create) }}
                        {% endif %}
                    {% endblock %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
{% block content %}
    <div class="row">
        <div class="w-full mb-4 md:mb-0">
            <div class="page-title">
                <h1 class="heading">{% trans %}Edit{% endtrans %} {% trans %}channel{% endtrans %}</h1>
            </div>
            <section class="section-white section-padding section-radius">
                {{ form(form, {'style': 'horizontal'}) }}
        <div class="aside-options">
            <aside>
                <div class="aside-holder section-gray section-radius">
                    {% block sidebar %}
                        {% block content_meta %}
                            {% if form.scope is defined %}
                                {{ form_row(form.scope, {'style': 'sidebar', 'icon':'fa-crosshairs', 'state': 'show'}) }}
                            {% endif %}

                            {% if form.permissions is defined %}
                                {{ form_row(form.permissions, {'style': 'sidebar', 'icon':'fa-key', 'state': 'show'}) }}
                            {% endif %}
                            {% if form.ipProtected is defined %}
                                {{ form_row(form.ipProtected, {'style': 'sidebar', 'icon':'fa-link', 'state': 'show'}) }}
                            {% endif %}
                            {% if form.color is defined %}
                                {{ form_row(form.color, {'style': 'sidebar', 'icon':'fa-droplet', 'state': 'show'}) }}
                            {% endif %}
                            {% if form.logo is defined %}
                                {{ form_row(form.logo, {'style': 'sidebar', 'icon':'fa-image', 'state': 'show'}) }}
                            {% endif %}
                            {% if form.options is defined %}
                                {{ form_row(form.options, {'style': 'sidebar', 'icon':'fa-cog', 'state': 'show'}) }}
                            {% endif %}
                        {% endblock %}


                    {% endblock %}
                </div>
            </aside>
        </div>
        <div class="editor-wrapper">
            <section class="editor">
                {% block content_form %}
                    {% if form.name is defined %}
                        {{ form_row(form.name, {'style': 'inline'}) }}
                    {% endif %}

                    {% if form.domains is defined %}
                        {{ form_row(form.domains, {'style': 'editor','state': 'show'}) }}
                    {% endif %}

                    {{ form_rest(form, {'style':'editor', 'state':'show'})}}
                {% endblock %}
            </section>
        </div>


        {% block form_end %}
            {{ form_end(form) }}
        {% endblock %}
    </div>
{% endblock %}

{% block webpack_js %}
    <script src="{{ asset('bundles/integratedintegrated/edit.js') }}"></script>
{% endblock %}

{% block javascript %}
    {{ parent() }}

    <script src="{{ asset('bundles/integratedcontent/js/channel.js') }}" />
{% endblock javascript %}
