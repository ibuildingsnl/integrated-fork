{% extends '@IntegratedContent/base.html.twig' %}
{% block title %}{% trans %}Show Channel{% endtrans %}{% endblock title %}
{% block crumbs %}
    <div class="breadcrumb-holder">
        <div class="container">
            <ol class="breadcrumb">
                <li>
                    <a href="{{ path('integrated_content_channel_index') }}">{% trans %}Channel{% endtrans %}</a>
                </li>
                <li class="active">{% trans %}Show{% endtrans %}</li>
            </ol>
        </div>
    </div>
{% endblock %}
{% block content %}
    <div class="row">
        <div class="index-wrapper-full">
            {{ component('integrated_admin:page_title', {
                title: 'Channel'|trans ~ ' ' ~ channel.name,
            }) }}
            {% component 'integrated_admin:section_card' with {
                extraClass: 'overflow',
            } %}
                {% block content %}
                <dl class="dl-horizontal">
                    <dt>
                        {% trans %}Id{% endtrans %}
                    </dt>
                    <dd>
                        {{ channel.id }}
                    </dd>
                    <dt>
                        {% trans %}Name{% endtrans %}
                    </dt>
                    <dd>
                        {{ channel.name }}
                    </dd>
                    <dt>
                        {% trans %}Domains{% endtrans %}
                    </dt>
                    <dd>
                        {{ channel.domains|join(', ') }}
                    </dd>
                    <dt>
                        {% trans %}Primary Domain{% endtrans %}
                    </dt>
                    <dd>
                        {{ channel.primaryDomain }}
                    </dd>
                </dl>
                <a class="btn btn-primary" style="margin-right:10px;" href="{{ path('integrated_content_channel_edit', {'id': channel.id}) }}">
                    {% trans %}Edit{% endtrans %}
                </a>
                <a class="btn-light-red btn" href="{{ path('integrated_content_channel_delete', {'id': channel.id}) }}">
                    {% trans %}Delete{% endtrans %}
                </a>
                {% endblock %}
            {% endcomponent %}
        </div>
    </div>
{% endblock %}
