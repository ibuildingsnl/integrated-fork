{% extends '@IntegratedContent/base.html.twig' %}
{% block title %}{% trans %}Channels{% endtrans %}{% endblock title %}
{% block content %}
    <div class="row">
        <div class="index-wrapper-full">
            {% set createActionsHtml %}
                <ul class="create">
                    <li>
                        <a class="btn btn-create-new" href="{{ path('integrated_content_channel_new') }}">
                            <span>{% trans %}New{% endtrans %} {% trans %}channel{% endtrans %}</span>
                            <i class="iconoir-plus"></i>
                        </a>
                    </li>
                </ul>
            {% endset %}
            {{ component('integrated_admin:page_title', {
                title: 'Channels'|trans,
                actionsHtml: createActionsHtml,
            }) }}
            {% component 'integrated_admin:section_card' %}
                {% block content %}
                {% set tableHeadHtml %}
                    <tr>
                        <th class="name">{% trans %}Name{% endtrans %}</th>
                        <th class="id">{% trans %}Id{% endtrans %}</th>
                        <th class="domains">{% trans %}Domains{% endtrans %}</th>
                        <th class="created">{% trans %}Created{% endtrans %}</th>
                    </tr>
                {% endset %}
                {% set tableBodyHtml %}
                    {% for document in documents %}
                        <tr class="has-options">
                            <td class="name">
                                <strong>
                                    <a href="{{ path('integrated_content_channel_edit', {'id': document.id}) }}">
                                        {{ document.name }}
                                    </a>
                                </strong>
                                <div class="row-options">
                                    <a href="{{ path('integrated_content_channel_edit', {'id': document.id}) }}" title="{% trans %}Edit{% endtrans %}">
                                        {% trans %}Edit{% endtrans %}
                                    </a> |
                                    <a class="color-red" href="{{ path('integrated_content_channel_delete', {'id': document.id}) }}" title="{% trans %}Delete{% endtrans %}">
                                        {% trans %}Delete{% endtrans %}
                                    </a>
                                </div>
                            </td>
                            <td class="id">
                                {{ document.id }}
                            </td>
                            <td class="domains">
                                {{ document.domains|join(', ') }}
                            </td>
                            <td class="created">
                                {{ document.createdAt|date }}
                            </td>
                        </tr>
                    {% endfor %}
                {% endset %}
                {{ component('integrated_admin:data_table', {
                    headHtml: tableHeadHtml,
                    bodyHtml: tableBodyHtml,
                    emptyMessage: 'No channels added'|trans,
                    colSpan: 4,
                }) }}
                {% endblock %}
            {% endcomponent %}
        </div>
    </div>
{% endblock %}
