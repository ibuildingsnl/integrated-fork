<?xml version="1.0" encoding="UTF-8" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>

        <defaults autowire="true" autoconfigure="true"/>

        <service id="integrated_content.doctrine.object_manager" alias="doctrine_mongodb.odm.document_manager"/> <!-- config option -->

        <service id="integrated_content.channel.manager.doctrine" class="Integrated\Bundle\ContentBundle\Doctrine\ChannelManager">
            <argument type="service" id="integrated_content.doctrine.object_manager"/>
            <argument>Integrated\Bundle\ContentBundle\Document\Channel\Channel</argument>
            <argument type="service" id="cache.app"/>
        </service>

        <service id="integrated_content.content_type.manager.doctrine" class="Integrated\Bundle\ContentBundle\Doctrine\ContentTypeManager">
            <argument type="service" id="integrated_content.resolver"/>
            <argument>Integrated\Bundle\ContentBundle\Document\ContentType\ContentType</argument>
        </service>

    </services>

</container>
