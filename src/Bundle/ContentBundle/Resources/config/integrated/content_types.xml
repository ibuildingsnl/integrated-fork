<?xml version="1.0" encoding="UTF-8" ?>

<content-types>

    <content-type id="image" class="Integrated\Bundle\ContentBundle\Document\Content\Image">
        <name>Image</name>
        <fields>
            <field>file</field>
            <field>slug</field>
            <field>description</field>
            <field>credits</field>
            <field>copyrightRestrictions</field>
            <field>title</field>
        </fields>
    </content-type>

    <content-type id="file" class="Integrated\Bundle\ContentBundle\Document\Content\File">
        <name>File</name>
        <fields>
            <field>file</field>
            <field>slug</field>
            <field>description</field>
            <field>credits</field>
            <field>copyrightRestrictions</field>
            <field>title</field>
        </fields>
    </content-type>

    <content-type id="video" class="Integrated\Bundle\ContentBundle\Document\Content\Video">
        <name>Video</name>
        <fields>
            <field>file</field>
            <field>slug</field>
            <field>description</field>
            <field>credits</field>
            <field>copyrightRestrictions</field>
            <field>title</field>
        </fields>
    </content-type>

    <content-type id="media_taxonomy" class="Integrated\Bundle\ContentBundle\Document\Content\Taxonomy">
        <name>Media taxonomy</name>
    </content-type>

    <content-type id="testasd" class="Integrated\Bundle\ContentBundle\Document\Content\Relation\Person">
        <name>testasd</name>
        <fields>
            <field>firstName</field>
            <field>lastName</field>
            <field>gender</field>
            <field>prefix</field>
            <field>nickname</field>
            <field>slug</field>
            <field>picture</field>
            <field>phonenumbers</field>
            <field>email</field>
            <field>intro</field>
            <field>publishTime</field>
            <field>featured</field>
            <field>disabled</field>
            <field>User</field>
            <field>description</field>
        </fields>
    </content-type>

</content-types>
