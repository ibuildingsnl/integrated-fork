<?xml version="1.0" encoding="UTF-8" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>

        <defaults autowire="true" autoconfigure="true"/>

        <service id="integrated_content.twig.json_pagination_extension" class="Integrated\Bundle\ContentBundle\Twig\JsonPaginationExtension">
            <argument type="service" id="router" />
            <tag name="twig.extension" />
        </service>

        <service id="integrated_content.twig.array_extension" class="Integrated\Bundle\ContentBundle\Twig\Extension\ArrayExtension">
            <tag name="twig.extension" />
        </service>

        <service id="integrated_content.twig.channel_extension" class="Integrated\Bundle\ContentBundle\Twig\Extension\ChannelExtension">
            <argument type="service" id="integrated_channel.repository.channel" />
            <argument type="service" id="channel.context" />
            <tag name="twig.extension" />
        </service>

        <service id="Integrated\Bundle\ContentBundle\Twig\Extension\ContentTypeExtension">
            <argument type="service" id="integrated_content.resolver" />
            <tag name="twig.extension"/>
        </service>

        <service id="Integrated\Bundle\ContentBundle\Twig\Extension\ContentPathExtension">
            <argument id="doctrine_mongodb.odm.document_manager" type="service"/>
            <tag name="twig.extension"/>
        </service>

        <service id="Integrated\Bundle\ContentBundle\Twig\Extension\DocumentExtension">
            <argument id="doctrine_mongodb.odm.document_manager" type="service"/>
            <tag name="twig.extension"/>
        </service>

        <service id="Integrated\Bundle\ContentBundle\Twig\Extension\FacetExtension">
            <argument type="tagged_iterator" tag="integrated_content.facet_setting" />
            <tag name="twig.extension"/>
        </service>

        <service id="integrated_content.twig.integrated_content_extension" class="Integrated\Bundle\ContentBundle\Twig\Extension\IntegratedContentExtension">
            <argument type="service" id="event_dispatcher" />
            <tag name="twig.extension" />
        </service>

        <service id="Integrated\Bundle\ContentBundle\Twig\Extension\IntegratedSearchExtension">
            <argument type="service" id="integrated_content.solr.query.sorting_options" />
            <tag name="twig.extension"/>
        </service>

        <service id="Integrated\Bundle\ContentBundle\Twig\Extension\RelationExtension">
            <tag name="twig.extension"/>
        </service>

        <service id="integrated_content.twig.json_ld_extension" class="Integrated\Bundle\ContentBundle\Twig\Extension\JsonLDExtension">
            <argument type="service" id="serializer" />

            <tag name="twig.extension" />
        </service>

        <service id="integrated_content.twig.search_selection_extension" class="Integrated\Bundle\ContentBundle\Twig\Extension\SearchSelectionsExtension">
            <argument type="service" id="doctrine_mongodb.odm.document_manager" />
            <argument type="service" id="security.token_storage" />

            <tag name="twig.extension" />
        </service>

        <service id="integrated_content.twig_title.channel" class="Integrated\Bundle\ContentBundle\Twig\Resolver\ChannelTitleResolver">
            <argument type="service" id="integrated_channel.repository.channel" />
        </service>

        <service id="integrated_content.twig_title.content_type" class="Integrated\Bundle\ContentBundle\Twig\Resolver\ContentTypeTitleResolver">
            <argument type="service" id="integrated_content.resolver" />
        </service>

        <service id="integrated_content.facet_setting.channel" class="Integrated\Bundle\ContentBundle\Twig\FacetSettings">
            <argument>channels</argument>
            <argument type="expression">true</argument>
            <argument type="service" id="integrated_content.twig_title.channel" />
            <tag name="integrated_content.facet_setting" />
        </service>

        <service id="integrated_content.facet_setting.content_type" class="Integrated\Bundle\ContentBundle\Twig\FacetSettings">
            <argument>contenttypes</argument>
            <argument type="expression">true</argument>
            <argument type="service" id="integrated_content.twig_title.content_type" />
            <tag name="integrated_content.facet_setting" />
        </service>

    </services>

</container>
