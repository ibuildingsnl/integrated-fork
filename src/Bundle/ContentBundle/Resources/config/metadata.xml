<?xml version="1.0" encoding="UTF-8" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>

        <defaults autowire="true" autoconfigure="true"/>

        <service id="integrated_content.metadata.driver.registry" class="Integrated\Common\Mapping\Registry\DriverRegistry" />

        <service id="integrated_content.metadata.driver.mapping" class="Doctrine\Persistence\Mapping\Driver\MappingDriver" public="false">
            <factory service="doctrine_mongodb.odm.default_configuration" method="getMetadataDriverImpl" />
        </service>

        <service id="integrated_content.metadata.driver.attribute" class="Integrated\Common\Form\Mapping\Driver\AttributeDriver">
            <argument type="service" id="integrated_content.metadata.driver.mapping"/>

            <tag name="integrated.mapping.driver" />
        </service>

        <service id="integrated_content.metadata.driver" alias="integrated_content.metadata.driver.attribute" />

        <service id="integrated_content.metadata.factory.event_dispatcher" class="Symfony\Component\EventDispatcher\EventDispatcher" public="false" />

        <service id="integrated_content.metadata.factory" class="Integrated\Common\Form\Mapping\MetadataFactory" public="true">
            <argument type="service" id="integrated_content.metadata.driver.registry" />
            <argument>Integrated\Common\Content\ContentInterface</argument>

            <call method="setEventDispatcher">
                <argument type="service" id="integrated_content.metadata.factory.event_dispatcher" />
            </call>
        </service>

        <service id="integrated_content.metadata.factory.all_types" class="Integrated\Common\Form\Mapping\MetadataFactory">
            <argument type="service" id="integrated_content.metadata.driver.registry" />
        </service>

    </services>

</container>
