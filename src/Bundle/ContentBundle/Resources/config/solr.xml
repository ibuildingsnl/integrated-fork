<?xml version="1.0" encoding="UTF-8" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>

        <defaults autowire="true" autoconfigure="true"/>

        <service id="integrated_content.solr.content.type" class="Integrated\Bundle\ContentBundle\Solr\Type\ContentType" public="false">
            <argument type="service" id="doctrine_mongodb.odm.document_manager" />
            <tag name="integrated_solr.type" />
        </service>

        <service id="integrated_content.solr.taxonomy.type" class="Integrated\Bundle\ContentBundle\Solr\Type\TaxonomyType" public="false">
            <argument type="service" id="doctrine_mongodb.odm.document_manager" />
            <tag name="integrated_solr.type" />
        </service>

        <service id="integrated_content.solr.property.type" class="Integrated\Bundle\ContentBundle\Solr\Type\PropertyType" public="false">
            <tag name="integrated_solr.type" />
        </service>

        <service id="integrated_content.solr.has_image.type" class="Integrated\Bundle\ContentBundle\Solr\Type\HasImageType" public="false">
            <tag name="integrated_solr.type" />
        </service>

        <service id="integrated_content.solr.featured.type" class="Integrated\Bundle\ContentBundle\Solr\Type\FeaturedType" public="false">
            <tag name="integrated_solr.type" />
        </service>

        <service id="integrated_content.solr.premium.type" class="Integrated\Bundle\ContentBundle\Solr\Type\PremiumType" public="false">
            <tag name="integrated_solr.type" />
        </service>

        <service id="integrated_content.solr.relation_json.type" class="Integrated\Bundle\ContentBundle\Solr\Type\RelationJsonType" public="false">
            <tag name="integrated_solr.type" />
        </service>

        <service id="integrated_content.solr.channel.extension" class="Integrated\Bundle\ContentBundle\Solr\Extension\ChannelExtension" public="false">
            <argument type="service" id="integrated_content.resolver" />
            <tag name="integrated_solr.type_extension" />
        </service>

        <service id="integrated_content.solr.content_type.extension" class="Integrated\Bundle\ContentBundle\Solr\Extension\ContentTypeExtension" public="false">
            <argument type="service" id="integrated_content.resolver" />
            <tag name="integrated_solr.type_extension" />
        </service>

        <service id="Integrated\Bundle\ContentBundle\Solr\Extension\ParentRelationExtension" public="false">
            <tag name="integrated_solr.type_extension" />
        </service>

        <service id="integrated_content.solr.pub_active.extension" class="Integrated\Bundle\ContentBundle\Solr\Extension\PubActiveExtension" public="false">
            <argument type="service" id="integrated_content.resolver" />
            <tag name="integrated_solr.type_extension" />
        </service>

        <service id="integrated_content.solr.normalizer.suggestion" class="Integrated\Bundle\ContentBundle\Solr\Serializer\SuggestionNormalizer" public="false">
            <argument type="service" id="router" />
            <argument type="string">integrated_content_content_edit</argument>
            <argument type="service" id="integrated_content.resolver" />
            <argument type="service" id="integrated_image.twig_extension" />

            <tag name="serializer.normalizer" priority="32" />
        </service>

        <service id="integrated_content.solr.shorttag_filter.extension" class="Integrated\Bundle\ContentBundle\Solr\Extension\ShorttagFilterExtension" public="false">
            <tag name="integrated_solr.type_extension" />
        </service>

        <!-- query -->

        <service id="integrated_content.solr.query.content" class="Integrated\Bundle\ContentBundle\Solr\Query\Type\Content">
            <argument type="service" id="integrated_content.solr.query.sorting_options" />
            <argument type="service" id="doctrine_mongodb.odm.document_manager" />
            <argument type="service" id="event_dispatcher" />
        </service>

        <service id="integrated_content.solr.query.integrated_content" class="Integrated\Bundle\ContentBundle\Solr\Query\Type\IntegratedContent" />

        <service id="integrated_content.solr.query.integrated_content_block" class="Integrated\Bundle\ContentBundle\Solr\Query\Type\IntegratedContentBlock">
            <argument type="service" id="doctrine_mongodb.odm.document_manager" />
            <argument type="service" id="integrated_content.solr.query.sorting_options" />
        </service>

        <service id="integrated_content.solr.query.sorting_options" class="Integrated\Bundle\ContentBundle\Solr\Query\SortOptions">
            <argument type="collection">
                <argument type="service">
                    <service class="Integrated\Bundle\ContentBundle\Solr\Query\SortOption">
                        <argument>rel</argument>
                        <argument>relevance</argument>
                        <argument>score</argument>
                        <argument>desc</argument>
                    </service>
                </argument>
                <argument type="service">
                    <service class="Integrated\Bundle\ContentBundle\Solr\Query\SortOption">
                        <argument>time</argument>
                        <argument>publication date</argument>
                        <argument>pub_time</argument>
                        <argument>desc</argument>
                    </service>
                </argument>
                <argument type="service">
                    <service class="Integrated\Bundle\ContentBundle\Solr\Query\SortOption">
                        <argument>changed</argument>
                        <argument>date modified</argument>
                        <argument>pub_edited</argument>
                        <argument>desc</argument>
                    </service>
                </argument>
                <argument type="service">
                    <service class="Integrated\Bundle\ContentBundle\Solr\Query\SortOption">
                        <argument>created</argument>
                        <argument>date created</argument>
                        <argument>pub_created</argument>
                        <argument>desc</argument>
                    </service>
                </argument>
                <argument type="service">
                    <service class="Integrated\Bundle\ContentBundle\Solr\Query\SortOption">
                        <argument>title</argument>
                        <argument>title</argument>
                        <argument>title_sort</argument>
                        <argument>asc</argument>
                    </service>
                </argument>
                <argument type="service">
                    <service class="Integrated\Bundle\ContentBundle\Solr\Query\SortOption">
                        <argument>rank</argument>
                        <argument>rank</argument>
                        <argument>rank</argument>
                        <argument>asc</argument>
                    </service>
                </argument>
                <argument type="service">
                    <service class="Integrated\Bundle\ContentBundle\Solr\Query\SortOption">
                        <argument>random</argument>
                        <argument>random</argument>
                        <argument>random_content</argument>
                        <argument>desc</argument>
                    </service>
                </argument>
            </argument>
        </service>

        <service id="Integrated\Bundle\ContentBundle\Solr\Query\Provider\IntegratedContentBlock" />

        <service id="Integrated\Bundle\ContentBundle\Solr\Query\PublishedExtension" />

    </services>

</container>
