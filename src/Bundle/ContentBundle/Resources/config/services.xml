<?xml version="1.0" encoding="UTF-8" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>

        <defaults autowire="true" autoconfigure="true"/>

        <service id="integrated_content.services.search.content.referenced" class="Integrated\Bundle\ContentBundle\Services\SearchContentReferenced" public="true">
            <argument type="service" id="doctrine_mongodb.odm.document_manager" />
        </service>
        <service id="Integrated\Bundle\ContentBundle\Services\SearchContentReferenced" alias="integrated_content.services.search.content.referenced" />

        <service id="Integrated\Bundle\ContentBundle\Services\ArticleSearchService">
            <argument type="service" id="doctrine_mongodb.odm.document_manager" />
            <argument type="service" id="integrated_solr.search.query_factory"/>
            <argument type="service" id="solarium.client"/>
            <argument>%integrated_article_link_search.document_types.whitelist%</argument>
            <argument type="service" id="security.token_storage"/>
        </service>

        <service id="Integrated\Bundle\ContentBundle\Services\ArticleSearchServiceInterface"
                 alias="Integrated\Bundle\ContentBundle\Services\ArticleSearchService"/>

        <service id="Integrated\Bundle\ContentBundle\Services\MediaGalleryUploadFile">
            <argument type="service" id="doctrine_mongodb.odm.document_manager" />
            <argument type="service" id="integrated_storage.manager" />
        </service>

        <service id="Integrated\Bundle\ContentBundle\Services\MediaGalleryEditFile">
            <argument type="service" id="doctrine_mongodb.odm.document_manager" />
            <argument type="service" id="Integrated\Bundle\ContentBundle\Services\MediaGalleryUploadFile" />
        </service>

        <service id="Integrated\Bundle\ContentBundle\Services\MediaGalleryMenu">
            <argument type="service" id="doctrine_mongodb.odm.document_manager" />
            <argument type="service" id="security.authorization_checker" />
        </service>

        <service id="Integrated\Bundle\ContentBundle\Services\TaxonomyRelationManager">
            <argument type="service" id="doctrine_mongodb.odm.document_manager" />
            <argument type="service" id="integrated_content.services.main_flusher" />
        </service>

        <service id="Integrated\Bundle\ContentBundle\Services\ContentTypeInformation">
            <argument type="service" id="doctrine_mongodb.odm.document_manager" />
        </service>

        <service id="Integrated\Bundle\ContentBundle\Services\CalendarOptions">
            <argument type="service" id="event_dispatcher"/>
        </service>

        <service id="Integrated\Bundle\ContentBundle\Services\PublicationSettingsProviderInterface"
                 class="Integrated\Bundle\ContentBundle\Services\PublicationTimeSettingsProvider">
        </service>

        <service id="Integrated\Bundle\ContentBundle\Command\ContentDraftCleanupCommand">
            <argument type="service" id="doctrine_mongodb.odm.document_manager" />
            <tag name="console.command" />
        </service>

        <service id="Integrated\Bundle\ContentBundle\Services\ContentReverseReferenceCleaner">
            <argument type="service" id="doctrine_mongodb.odm.document_manager" />
            <argument type="service" id="integrated_content.services.search.content.referenced" />
        </service>

        <service id="Integrated\Bundle\ContentBundle\Services\ChannelDeletionSelfHealer" />

        <service id="Integrated\Bundle\ContentBundle\Services\AssignedStatusCacheInvalidator" />

        <service id="Integrated\Bundle\ContentBundle\Services\ChannelDeletionProcessor">
            <argument type="service" id="doctrine_mongodb.odm.document_manager" />
            <argument type="service" id="integrated_content.services.search.content.referenced" />
            <argument type="service" id="Integrated\Bundle\ContentBundle\Services\ContentReverseReferenceCleaner" />
            <argument type="service" id="event_dispatcher" />
            <argument type="service" id="Integrated\Bundle\ContentBundle\Services\ChannelDeletionSelfHealer" />
        </service>

        <service id="Integrated\Bundle\ContentBundle\Command\ChannelDeleteCommand">
            <argument type="service" id="doctrine_mongodb.odm.document_manager" />
            <argument type="service" id="Integrated\Bundle\ContentBundle\Services\ChannelDeletionProcessor" />
            <argument type="service" id="logger" />
            <tag name="console.command" />
        </service>

        <service id="integrated_content.services.main_flusher" class="Integrated\Common\Services\MainFlusher">
            <argument type="service" id="doctrine_mongodb.odm.document_manager" />
            <argument type="service" id="integrated_solr.indexer.mongodb.subscriber" />
            <argument type="service" id="integrated_solr.indexer" />
            <argument type="service" id="integrated_solr.queue.indexer" />
        </service>

        <service id="integrated_content.services.flusher" class="Integrated\Common\Services\LockingFlusher">
            <argument type="service" id="integrated_workflow.lock.factory" />
            <argument type="service" id="integrated_content.services.main_flusher" />
        </service>
    </services>

</container>
