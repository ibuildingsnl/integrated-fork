<?xml version="1.0" encoding="UTF-8" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>

        <defaults autowire="true" autoconfigure="true"/>

        <service id="integrated_content.services.search.content.referenced" class="Integrated\Bundle\ContentBundle\Services\SearchContentReferenced" public="true">
            <argument type="service" id="doctrine_mongodb.odm.document_manager" />
        </service>

        <service id="Integrated\Bundle\ContentBundle\Services\MediaGalleryUploadFile">
            <argument type="service" id="doctrine_mongodb.odm.document_manager" />
            <argument type="service" id="integrated_storage.manager" />
        </service>

        <service id="Integrated\Bundle\ContentBundle\Services\MediaGalleryMenu">
            <argument type="service" id="doctrine_mongodb.odm.document_manager" />
            <argument type="service" id="security.authorization_checker" />
        </service>

        <service id="Integrated\Bundle\ContentBundle\Services\TaxonomyRelationManager">
            <argument type="service" id="doctrine_mongodb.odm.document_manager" />
            <argument type="service" id="integrated_solr.indexer.mongodb.subscriber" />
            <argument type="service" id="integrated_solr.indexer" />
        </service>

        <service id="Integrated\Bundle\ContentBundle\Services\ContentTypeInformation">
            <argument type="service" id="doctrine_mongodb.odm.document_manager" />
        </service>

        <service id="integrated_content.services.flusher" class="Integrated\Common\Services\CombinedFlusher">
            <argument type="service" id="integrated_content.services.doctrine_flusher" />
            <argument type="service" id="integrated_content.services.locking_flusher" />
        </service>

        <service id="integrated_content.services.doctrine_flusher" class="Integrated\Common\Services\DoctrineFlusher">
            <argument type="service" id="doctrine_mongodb.odm.document_manager" />
        </service>

        <service id="integrated_content.services.solr_flusher" class="Integrated\Common\Services\SolrIndexingFlusher">
            <argument type="service" id="integrated_solr.indexer.mongodb.subscriber" />
            <argument type="service" id="integrated_solr.indexer" />
        </service>

        <service id="integrated_content.services.locking_flusher" class="Integrated\Common\Services\LockingFlusher">
            <argument type="service" id="integrated_workflow.lock.factory" />
            <argument type="service" id="integrated_content.services.solr_flusher" />
        </service>
    </services>

</container>
