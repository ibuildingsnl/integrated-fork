<?xml version="1.0" encoding="UTF-8" ?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services
        http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>

        <service id="integrated_content.services.search.content.referenced" class="Integrated\Bundle\ContentBundle\Services\SearchContentReferenced" public="true">
            <argument type="service" id="doctrine_mongodb.odm.document_manager" />
        </service>

        <service id="Integrated\Bundle\ContentBundle\Services\MediaGalleryUploadFile">
            <argument type="service" id="doctrine_mongodb.odm.document_manager" />
            <argument type="service" id="integrated_storage.manager" />
        </service>

        <service id="Integrated\Bundle\ContentBundle\Services\MediaGalleryMenu">
            <argument type="service" id="doctrine_mongodb.odm.document_manager" />
            <argument type="service" id="security.authorization_checker" />
        </service>

        <service id="Integrated\Bundle\ContentBundle\Services\TaxonomyRelationManager">
            <argument type="service" id="doctrine_mongodb.odm.document_manager" />
            <argument type="service" id="integrated_solr.indexer.mongodb.subscriber" />
            <argument type="service" id="integrated_solr.indexer" />
        </service>

        <service id="Integrated\Bundle\ContentBundle\Services\ContentTypeInformation">
            <argument type="service" id="doctrine_mongodb.odm.document_manager" />
        </service>

        <service id="integrated_content.services.flusher" class="Integrated\Bundle\ContentBundle\Services\CombinedFlusher">
            <argument type="service" id="integrated_content.services.doctrine-flusher" />
            <argument type="service" id="integrated_content.services.locking-flusher" />
        </service>

        <service id="integrated_content.services.doctrine-flusher" class="Integrated\Bundle\ContentBundle\Services\DoctrineFlusher">
            <argument type="service" id="doctrine_mongodb.odm.document_manager" />
        </service>

        <service id="integrated_content.services.solr-flusher" class="Integrated\Bundle\ContentBundle\Services\SolrIndexingFlusher">
            <argument type="service" id="integrated_solr.indexer.mongodb.subscriber" />
            <argument type="service" id="integrated_solr.indexer" />
        </service>

        <service id="integrated_content.services.locking-flusher" class="Integrated\Bundle\ContentBundle\Services\LockingFlusher">
            <argument type="service" id="integrated_workflow.lock.factory" />
            <argument type="service" id="integrated_content.services.solr-flusher" />
        </service>

        <service id="integrated_content.content.repository" class="Integrated\Bundle\ContentBundle\Document\Content\ContentRepository">
            <factory service="doctrine_mongodb.odm.document_manager" method="getRepository" />
            <argument type="string">\Integrated\Bundle\ContentBundle\Document\Content\Content</argument>
        </service>
    </services>
</container>
