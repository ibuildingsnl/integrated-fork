<?xml version="1.0" encoding="UTF-8" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>

        <defaults autowire="true" autoconfigure="true"/>

        <service id="integrated_content.channel.context" class="Integrated\Common\Content\Channel\RequestAwareChannelContext">
            <argument type="service" id="integrated_content.channel.manager"/>
            <argument type="service" id="request_stack"/>
        </service>

        <service id="integrated_content.channel.request_channel_injection.listener" class="Integrated\Bundle\ContentBundle\EventListener\RequestChannelInjectionListener">
            <argument type="service" id="integrated_content.channel.manager"/>
            <argument type="service" id="integrated_content.channel.context"/>

        </service>

        <service id="channel.context" alias="integrated_content.channel.context" public="true"/>

        <service id="Integrated\Common\Content\Channel\ChannelContextInterface" alias="integrated_content.channel.context"/>

    </services>

</container>
