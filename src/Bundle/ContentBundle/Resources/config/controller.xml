<?xml version="1.0" encoding="UTF-8" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <parameters>
        <parameter key="integrated_article_link_search.document_types.whitelist" type="collection">
            <parameter>Integrated\Bundle\ContentBundle\Document\Content\Article</parameter>
            <parameter>Integrated\Bundle\ContentBundle\Document\Content\Event</parameter>
            <parameter>Integrated\Bundle\ContentBundle\Document\Content\JobPosting</parameter>
            <parameter>Integrated\Bundle\ContentBundle\Document\Content\News</parameter>
            <parameter>Integrated\Bundle\ContentBundle\Document\Content\Video</parameter>
            <parameter>Integrated\Bundle\ContentBundle\Document\Content\Relation\Company</parameter>
            <parameter>Integrated\Bundle\ContentBundle\Document\Content\File</parameter>
            <parameter>Integrated\Bundle\ContentBundle\Document\Content\Image</parameter>
        </parameter>
    </parameters>

    <services>

        <defaults autowire="true" autoconfigure="true"/>

        <prototype namespace="Integrated\Bundle\ContentBundle\Controller\" resource="../../Controller" />

        <service id="Integrated\Bundle\ContentBundle\Controller\ContentController">
            <argument type="service" id="integrated.form.resolver" />
            <argument type="service" id="integrated_content.content_type.manager" />
            <argument type="service" id="integrated_solr.indexer.mongodb.subscriber" />
            <argument type="service" id="integrated_solr.lock.factory" />
            <argument type="service" id="integrated_solr.indexer" />
            <argument type="service" id="integrated_content.services.search.content.referenced" />
            <argument type="service" id="integrated_locking.dbal.manager" />
            <argument type="service" id="integrated_user.user.manager" />
            <argument type="service" id="integrated_image.twig_extension" />
            <argument type="service" id="integrated_content.provider.media" />
            <argument type="service" id="integrated_taxonomy.taxonomy.indexer" />
            <argument type="service" id="integrated_solr.search.query_factory"/>
            <argument type="service" id="integrated_content.metadata.factory"/>
            <argument type="service" id="integrated_content.form.factory.event_dispatcher"/>
            <argument type="service" id="doctrine_mongodb.odm.document_manager" />
            <argument type="service" id="Integrated\Bundle\ContentBundle\Services\CalendarOptions" />
            <argument type="service" id="integrated_queue.dbal.provider" />
            <argument type="service" id="integrated_content.publication_repository" />
            <argument type="service" id="Integrated\Bundle\ContentBundle\Extension\ContentNavigatorColumnRegistry" />
            <argument type="service" id="Integrated\Bundle\ContentBundle\Extension\ContentSidebarPanelRegistry" />

            <tag name="controller.service_arguments" />
            <tag name="container.service_subscriber" />
        </service>

        <service id="Integrated\Bundle\ContentBundle\Controller\ContentTypeController">
            <argument type="service" id="integrated_content.content_type.manager" />
            <argument type="service" id="event_dispatcher" />
            <argument type="service" id="integrated_content.metadata.factory" />
            <argument type="service" id="doctrine_mongodb.odm.document_manager" />

            <tag name="controller.service_arguments" />
            <tag name="container.service_subscriber" />
        </service>

        <service id="Integrated\Bundle\ContentBundle\Controller\ChannelController" autowire="true" autoconfigure="true">
            <argument type="service" id="doctrine_mongodb.odm.document_manager" />
            <argument type="service" id="integrated_content.services.search.content.referenced" />
            <argument type="service" id="event_dispatcher" />
        </service>

        <service id="Integrated\Bundle\ContentBundle\Controller\MediaController" autowire="true" autoconfigure="true">
        </service>

        <service id="Integrated\Bundle\ContentBundle\Controller\RankController">
            <argument type="service" id="Integrated\Bundle\ContentBundle\Provider\ContentProvider" />
            <argument type="service" id="translator" />

            <tag name="controller.service_arguments" />
            <tag name="container.service_subscriber" />

            <call method="setContainer">
                <argument type="service" id="service_container" />
            </call>
        </service>

        <service id="Integrated\Bundle\ContentBundle\Controller\RelationController">
            <argument type="service" id="doctrine_mongodb.odm.document_manager" />

            <tag name="controller.service_arguments" />
            <tag name="container.service_subscriber" />
        </service>

        <service id="Integrated\Bundle\ContentBundle\Controller\SearchController">
            <argument type="service" id="integrated_solr.indexer.client" />
            <argument type="service" id="serializer" />

            <tag name="controller.service_arguments" />
            <tag name="container.service_subscriber" />
        </service>

        <service id="Integrated\Bundle\ContentBundle\Controller\SearchSelectionController">
            <argument type="service" id="request_stack" />
            <argument type="service" id="doctrine_mongodb.odm.document_manager" />
            <argument type="service" id="knp_paginator" />
            <argument type="service" id="integrated_content.services.search.content.referenced" />

            <tag name="controller.service_arguments" />
            <tag name="container.service_subscriber" />
        </service>

        <service id="Integrated\Bundle\ContentBundle\Controller\BulkController">
            <argument type="service" id="doctrine_mongodb.odm.document_manager" />
            <argument type="service" id="Integrated\Bundle\ContentBundle\Provider\ContentProvider" />
            <argument type="service" id="integrated_content.bulk.handler" />

            <tag name="controller.service_arguments" />
            <tag name="container.service_subscriber" />
        </service>

        <service id="Integrated\Bundle\ContentBundle\Controller\YoastSeoLanguageProvider">
            <argument type="service" id="file_locator" />
            <argument>@IntegratedContentBundle/YoastSeo/lang</argument>

            <tag name="controller.service_arguments" />
        </service>

        <service id="Integrated\Bundle\ContentBundle\Controller\OEmbedController">
            <argument>%env(string:default::FACEBOOK_OEMBED_APP_ID)%</argument>
            <argument>%env(string:default::FACEBOOK_OEMBED_APP_SECRET)%</argument>
            <argument>%env(string:default::TWITTER_CONSUMER_KEY)%</argument>
            <argument>%env(string:default::TWITTER_CONSUMER_SECRET)%</argument>

            <tag name="controller.service_arguments" />
        </service>

        <service id="Integrated\Bundle\ContentBundle\Controller\ArticleSearchController">
            <argument type="service" id="Integrated\Bundle\ContentBundle\Services\ArticleSearchServiceInterface" />
        </service>

    </services>

</container>
