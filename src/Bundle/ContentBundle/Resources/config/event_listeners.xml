<?xml version="1.0" encoding="UTF-8" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>

        <defaults autowire="true" autoconfigure="true"/>

        <service id="integrated_content.event_listener.configure_menu_subscriber" class="Integrated\Bundle\ContentBundle\EventListener\ConfigureMenuSubscriber">
            <argument type="service" id="security.authorization_checker" />
            <tag name="kernel.event_subscriber" />
        </service>

        <service id="integrated_content.event_listener.search_selections_menu_subscriber" class="Integrated\Bundle\ContentBundle\EventListener\SearchSelectionsMenuSubscriber">
            <argument type="service" id="security.token_storage" />
            <argument type="service" id="integrated_content.search_selection_repository" />
            <tag name="kernel.event_subscriber" />
        </service>

        <service id="integrated_content.event_listener.channel_exception" class="Integrated\Bundle\ContentBundle\EventListener\ChannelExceptionSubscriber">
            <argument type="service" id="router" />
            <argument type="service" id="channel.context" />
            <tag name="kernel.event_subscriber" />
        </service>

        <service id="integrated_content.event_listener.fragment_cache_invalidation" class="Integrated\Bundle\ContentBundle\EventListener\FragmentCacheInvalidationSubscriber">
            <tag name="kernel.event_subscriber" />
        </service>

        <service id="integrated_content.event_listener.channel_domain_lookup_cache_invalidation" class="Integrated\Bundle\ContentBundle\EventListener\ChannelDomainLookupCacheInvalidationSubscriber">
            <tag name="doctrine_mongodb.odm.event_subscriber" connection="default" />
        </service>

        <service id="integrated_content.event_listener.publication_removal" class="Integrated\Bundle\ContentBundle\EventListener\PublicationRemovalListener">
            <argument type="service" id="integrated_content.publication_repository" />
            <tag name="integrated_content.form.event_subscriber"/>
        </service>

        <service id="integrated_content.event_listener.calendar_publication" class="Integrated\Bundle\ContentBundle\EventListener\CalendarPublicationProvider">
            <argument type="service" id="integrated_asset.manager.javascript_manager" />
            <argument type="service" id="integrated_content.publication_repository" />
            <argument type="service" id="integrated_brand.brand.repository" />
            <argument type="service" id="doctrine_mongodb.odm.document_manager" />
            <argument type="service" id="integrated_image.twig_extension" />

            <tag name="kernel.event_subscriber" />
        </service>

    </services>

</container>
