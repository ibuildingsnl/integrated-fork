<?xml version="1.0" encoding="UTF-8" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>

        <defaults autowire="true" autoconfigure="true"/>

        <service id="integrated_content.event_listener.configure_menu_subscriber" class="Integrated\Bundle\ContentBundle\EventListener\ConfigureMenuSubscriber">
            <argument type="service" id="security.authorization_checker" />
        </service>

        <service id="integrated_content.event_listener.channel_exception" class="Integrated\Bundle\ContentBundle\EventListener\ChannelExceptionSubscriber">
            <argument type="service" id="router" />
            <argument type="service" id="channel.context" />
        </service>

    </services>

</container>
