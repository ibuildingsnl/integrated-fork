<?xml version="1.0" encoding="UTF-8" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>

        <defaults autowire="true" autoconfigure="true"/>

        <service id="integrated_content.content_type_repository" class="Doctrine\Persistence\ObjectRepository">
            <factory service="doctrine_mongodb.odm.document_manager" method="getRepository" />
            <argument>Integrated\Bundle\ContentBundle\Document\ContentType\ContentType</argument>
        </service>

        <service id="integrated_content.search_selection_repository" class="Integrated\Bundle\ContentBundle\Document\SearchSelection\SearchSelectionRepository">
            <factory service="doctrine_mongodb.odm.document_manager" method="getRepository" />
            <argument type="string">\Integrated\Bundle\ContentBundle\Document\SearchSelection\SearchSelection</argument>
        </service>

        <service id="Integrated\Bundle\ContentBundle\Document\Content\ContentRepository" autoconfigure="true" autowire="true">
        </service>

    </services>

</container>
