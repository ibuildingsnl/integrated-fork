<doctrine-mongo-mapping xmlns="http://doctrine-project.org/schemas/odm/doctrine-mongo-mapping"
                        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                        xsi:schemaLocation="http://doctrine-project.org/schemas/odm/doctrine-mongo-mapping
                    http://doctrine-project.org/schemas/odm/doctrine-mongo-mapping.xsd">

    <document
        name="Integrated\Bundle\ContentBundle\Document\Content\ContentEditDraft"
        collection="content_edit_draft"
        repository-class="Integrated\Bundle\ContentBundle\Document\Content\ContentEditDraftRepository">

        <id field-name="id" strategy="UUID" />
        <field field-name="contentId" type="string" />
        <field field-name="userId" type="string" />
        <field field-name="payload" type="hash" />
        <field field-name="createdAt" type="date" />
        <field field-name="updatedAt" type="date" />

        <indexes>
            <index unique="true">
                <key name="contentId" order="asc" />
                <key name="userId" order="asc" />
            </index>
            <index>
                <key name="updatedAt" order="desc" />
            </index>
        </indexes>
    </document>

</doctrine-mongo-mapping>
