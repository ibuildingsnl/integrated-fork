<?xml version="1.0" encoding="UTF-8" ?>

<routes xmlns="http://symfony.com/schema/routing"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://symfony.com/schema/routing http://symfony.com/schema/routing/routing-1.0.xsd">

    <route id="integrated_content_media_index" path="/" methods="GET, POST">
        <default key="_controller">Integrated\Bundle\ContentBundle\Controller\MediaController::index</default>
    </route>

    <route id="integrated_content_media_edit_image" path="/edit_image/{id}" methods="GET, POST">
        <default key="_controller">Integrated\Bundle\ContentBundle\Controller\MediaController::editImage</default>
    </route>

    <route id="integrated_content_media_edit_image_iframe" path="/edit_image_iframe/{id}" methods="GET, POST">
        <default key="_controller">Integrated\Bundle\ContentBundle\Controller\MediaController::editImageIframe</default>
    </route>

    <route id="integrated_content_media_select_one" path="/select_one" methods="GET, POST">
        <default key="_controller">Integrated\Bundle\ContentBundle\Controller\MediaController::selectOne</default>
    </route>

    <route id="integrated_content_media_select_multiple" path="/select_multiple" methods="GET, POST">
        <default key="_controller">Integrated\Bundle\ContentBundle\Controller\MediaController::selectMultiple</default>
    </route>

    <route id="integrated_content_media_manage_relations" path="/manage_relations" methods="GET, PUT">
        <default key="_controller">Integrated\Bundle\ContentBundle\Controller\MediaController::manageRelations</default>
    </route>

    <route id="integrated_content_media_upload_file" path="/upload_file" methods="POST">
        <default key="_controller">Integrated\Bundle\ContentBundle\Controller\MediaController::uploadFile</default>
    </route>

</routes>
