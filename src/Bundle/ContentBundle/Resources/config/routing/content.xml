<?xml version="1.0" encoding="UTF-8" ?>

<routes xmlns="http://symfony.com/schema/routing"
		xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		xsi:schemaLocation="http://symfony.com/schema/routing http://symfony.com/schema/routing/routing-1.0.xsd">

	<route id="integrated_content_content_index" path="/{_format}">
		<default key="_controller">Integrated\Bundle\ContentBundle\Controller\ContentController::index</default>
		<default key="_format">html</default>
		<requirement key="_format">html|json</requirement>
	</route>

	<route id="integrated_content_content_selection" path="/s/{searchSelection}/{_format}" methods="GET, POST">
		<default key="_controller">Integrated\Bundle\ContentBundle\Controller\ContentController::index</default>
		<default key="searchSelection">all</default>
		<default key="_format">html</default>
		<requirement key="_format">html|json</requirement>
	</route>

	<route id="integrated_content_content_new" path="/new/{_format}">
		<default key="_controller">Integrated\Bundle\ContentBundle\Controller\ContentController::new</default>
		<default key="_format">html</default>
		<requirement key="_format">html|iframe.html</requirement>
	</route>

	<route id="integrated_content_content_media_types" path="/media_types/{filter}" methods="GET">
		<default key="_controller">Integrated\Bundle\ContentBundle\Controller\ContentController::mediaTypesAction</default>
		<default key="filter">null</default>
	</route>

	<route id="integrated_content_content_edit_iframe" path="/{id}/iframe.html"  methods="GET, PUT, POST">
		<default key="_controller">Integrated\Bundle\ContentBundle\Controller\ContentController::edit</default>
        <default key="_format">iframe.html</default>
        <requirement key="_format">html|iframe.html</requirement>
	</route>

	    <route id="integrated_content_content_edit_modal_iframe" path="/{id}/modal-iframe.html"  methods="GET, PUT, POST">
	        <default key="_controller">Integrated\Bundle\ContentBundle\Controller\ContentController::edit</default>
	        <default key="_format">modal-iframe.html</default>
	        <requirement key="_format">html|modal-iframe.html</requirement>
	    </route>

	    <route id="integrated_content_content_navdropdowns" path="/navdropdowns" methods="GET">
	        <default key="_controller">Integrated\Bundle\ContentBundle\Controller\ContentController::navdropdowns</default>
	    </route>

	    <route id="integrated_content_content_queue_status" path="/queue-status" methods="GET">
	        <default key="_controller">Integrated\Bundle\ContentBundle\Controller\ContentController::queueStatus</default>
	    </route>

	    <route id="integrated_content_content_assigned_status" path="/assigned-status" methods="GET">
	        <default key="_controller">Integrated\Bundle\ContentBundle\Controller\ContentController::assignedStatus</default>
	    </route>

	    <route id="integrated_content_content_locks_status" path="/locks-status" methods="POST">
	        <default key="_controller">Integrated\Bundle\ContentBundle\Controller\ContentController::locksStatus</default>
	    </route>

	    <route id="integrated_content_content_channels_fragment" path="/channels-fragment" methods="GET">
	        <default key="_controller">Integrated\Bundle\ContentBundle\Controller\ChannelController::getChannels</default>
	    </route>

	    <route id="integrated_content_content_lock" path="/{id}/lock" methods="POST">
	        <default key="_controller">Integrated\Bundle\ContentBundle\Controller\ContentController::lock</default>
	    </route>

	    <route id="integrated_content_content_draft_get" path="/{id}/draft" methods="GET">
	        <default key="_controller">Integrated\Bundle\ContentBundle\Controller\ContentController::getDraft</default>
	    </route>

	    <route id="integrated_content_content_draft_save" path="/{id}/draft" methods="POST">
	        <default key="_controller">Integrated\Bundle\ContentBundle\Controller\ContentController::saveDraft</default>
	    </route>

	    <route id="integrated_content_content_draft_delete" path="/{id}/draft" methods="DELETE">
	        <default key="_controller">Integrated\Bundle\ContentBundle\Controller\ContentController::deleteDraft</default>
	    </route>

	    <route id="integrated_content_content_edit" path="/{id}"  methods="GET">
	        <default key="_controller">Integrated\Bundle\ContentBundle\Controller\ContentController::edit</default>
	    </route>

	<route id="integrated_content_content_edit_rest" path="/{id}" methods="PUT, POST">
		<default key="_controller">Integrated\Bundle\ContentBundle\Controller\ContentController::edit</default>
	</route>

	<route id="integrated_content_content_delete" path="/{id}/delete">
		<default key="_controller">Integrated\Bundle\ContentBundle\Controller\ContentController::delete</default>
	</route>

    <route id="integrated_content_content_used_by" path="/{id}/used-by/{_format}" methods="GET">
        <default key="_controller">Integrated\Bundle\ContentBundle\Controller\ContentController::usedBy</default>
		<default key="_format">html</default>
		<requirement key="_format">html|json</requirement>
    </route>

	<route id="integrated_content_content_show" path="/{id}/show/{_format}" methods="GET">
        <default key="_controller">Integrated\Bundle\ContentBundle\Controller\ContentController::show</default>
		<default key="_format">html</default>
		<requirement key="_format">html|json</requirement>
    </route>

	</routes>
