<?xml version="1.0" encoding="UTF-8" ?>

<container xmlns="http://symfony.com/schema/dic/services"
		   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		   xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

	<services>

        <defaults autowire="true" autoconfigure="true"/>

        <service id="integrated_content.odm.mongo.mapping.driver" class="Doctrine\Persistence\Mapping\Driver\MappingDriver" public="false">
            <factory service="doctrine_mongodb.odm.default_configuration" method="getMetadataDriverImpl" />
        </service>

        <service id="integrated_content.odm.mongo.mapping.locator" class="Integrated\Doctrine\ODM\MongoDB\Mapping\Locator\DoctrineLocator">
            <argument type="service" id="integrated_content.odm.mongo.mapping.driver" />
        </service>

        <service id="integrated_content.odm.mongo.mapping.discriminator_map.resolver_builder" class="Integrated\Doctrine\ODM\MongoDB\Mapping\ClassTreeMapResolverBuilder">
            <argument type="service" id="integrated_content.odm.mongo.mapping.locator" />

            <call method="addClass">
                <argument type="string">Integrated\Bundle\ContentBundle\Document\Content\Content</argument>
            </call>

            <call method="addClass">
                <argument type="string">Integrated\Bundle\BlockBundle\Document\Block\Block</argument>
            </call>

        </service>

        <service id="integrated_content.odm.mongo.mapping.discriminator_map.resolver" class="Integrated\Doctrine\ODM\MongoDB\Mapping\DiscriminatorMapResolverInterface">
            <factory service="integrated_content.odm.mongo.mapping.discriminator_map.resolver_builder" method="getResolver" />
        </service>

        <service id="integrated_content.odm.mongo.mapping.discriminator_map.listener" class="Integrated\Doctrine\ODM\MongoDB\Mapping\DiscriminatorMapMetadataSubscriber">
            <argument type="service" id="integrated_content.odm.mongo.mapping.discriminator_map.resolver" />
        </service>

        <service id="integrated_content.odm.mongo.clean_relations.listener" class="Integrated\Bundle\ContentBundle\Doctrine\EventListener\CleanRelationsListener">
        </service>

        <service id="integrated_content.odm.mongo.checkreferenced.listener" class="Integrated\Bundle\ContentBundle\Doctrine\EventListener\CheckReferencedListener">
        </service>

        <service id="Integrated\Bundle\ContentBundle\Doctrine\EventListener\DocumentNotFoundListener">
        </service>

        <service id="Integrated\Bundle\ContentBundle\Doctrine\EventListener\UpdateAuthorRelationListener">
        </service>

        <service id="Integrated\Bundle\ContentBundle\Doctrine\EventListener\UpdateRankListener">
        </service>

        <service id="Integrated\Bundle\ContentBundle\Doctrine\EventListener\UpdateStorageMetadataListener">
        </service>

	</services>

</container>
