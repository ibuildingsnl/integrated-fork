<?xml version="1.0" encoding="UTF-8" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>

        <defaults autowire="true" autoconfigure="true"/>

        <service id="integrated_content.provider.solarium" class="Integrated\Bundle\ContentBundle\Provider\SolariumProvider">
            <argument type="service" id="solarium.client" />
            <argument type="service" id="doctrine_mongodb.odm.document_manager" />
            <argument type="service" id="knp_paginator" />
        </service>

        <service id="integrated_content.provider.media" class="Integrated\Bundle\ContentBundle\Provider\MediaProvider" public="true">
            <argument type="service" id="integrated_content.content_type.manager" />
            <argument type="service" id="security.authorization_checker" />
        </service>

        <service id="Integrated\Bundle\ContentBundle\Provider\ContentProvider">
            <argument type="service" id="solarium.client" />
            <argument type="service" id="doctrine_mongodb.odm.document_manager" />
            <argument type="service" id="security.token_storage" />
            <argument type="service" id="security.authorization_checker" />
            <argument>false</argument>
        </service>

    </services>

</container>
