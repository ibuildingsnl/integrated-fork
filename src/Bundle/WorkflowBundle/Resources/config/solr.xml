<?xml version="1.0" encoding="UTF-8" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>

        <defaults autowire="true" autoconfigure="true" />

        <service id="integrated_workflow.solr.workflow.extension" class="Integrated\Bundle\WorkflowBundle\Solr\Extension\WorkflowExtension" public="true">
            <argument type="service" id="integrated_content.resolver" on-invalid="ignore" />
            <argument type="service" id="integrated_workflow.repository.workflow" />
            <argument type="service" id="integrated_workflow.repository.definition" />

            <tag name="integrated_solr.type_extension" />
        </service>

        <service id="integrated_workflow.solr.query.workflow_extension" class="Integrated\Bundle\WorkflowBundle\Solr\Query\WorkflowExtension" />

    </services>

</container>
