<?xml version="1.0" encoding="UTF-8" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>

        <defaults autowire="true" autoconfigure="true" />

        <service id="integrated_workflow.lock.flock" class="Symfony\Component\Lock\Store\FlockStore" />

        <service id="integrated_workflow.lock.store" alias="integrated_workflow.lock.flock" />

        <service id="integrated_workflow.lock.factory" class="Symfony\Component\Lock\LockFactory" public="true">
            <argument type="service" id="integrated_solr.lock.store" />

            <call method="setLogger">
                <argument type="service" id="logger" on-invalid="ignore" />
            </call>

            <tag name="monolog.logger" channel="lock" />
        </service>

    </services>

</container>
