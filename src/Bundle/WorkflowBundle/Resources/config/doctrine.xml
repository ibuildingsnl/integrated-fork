<?xml version="1.0" encoding="UTF-8" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>

        <defaults autowire="true" autoconfigure="true"/>

        <service id="integrated_workflow.doctrine.state_instance_injection.listener" class="Integrated\Bundle\WorkflowBundle\Doctrine\EventListener\WorkflowStateInstanceInjectionListener">
            <argument type="service" id="doctrine" on-invalid="ignore"/>
            <argument type="service" id="doctrine_mongodb" on-invalid="ignore"/>

            <tag name="doctrine.event_listener" event="postLoad" connection="default" />
        </service>

        <service id="integrated_workflow.doctrine.log_user.listener" class="Integrated\Bundle\WorkflowBundle\Doctrine\EventListener\WorkflowLogInstanceInjectionListener">
            <argument type="service" id="doctrine" on-invalid="ignore"/>

            <tag name="doctrine.event_listener" event="postLoad" connection="default" />
        </service>

        <service id="integrated_workflow.doctrine.queue.listener" class="Integrated\Bundle\WorkflowBundle\Doctrine\EventListener\ContainerAwareQueueListener">
            <argument type="service" id="service_container"/>
            <argument type="string">integrated_queue.workflow</argument> <!-- should be a config option -->

            <tag name="doctrine.event_listener" event="postPersist" connection="default" />
            <tag name="doctrine.event_listener" event="postUpdate" connection="default" />
        </service>

    </services>

</container>
