{% extends '@IntegratedWorkflow/layout.html.twig' %}
{% block title %}{% trans %}Delete Workflow{% endtrans %} {% endblock title %}

{% block content %}
    {% block form_start %}
        {{ form_start(form) }}
    {% endblock %}
    {% set workflowDeleteToolbarHtml %}
        {% block toolbar %}
            {% include '@IntegratedContent/partials/block.toolbar.html.twig' %}
        {% endblock toolbar %}
    {% endset %}
    {% set workflowDeleteTitleHtml %}
        {{ component('integrated_admin:page_title', {
            title: ('Delete'|trans) ~ ' ' ~ ('workflow'|trans),
        }) }}
    {% endset %}
    {% set workflowDeleteContentHtml %}
        <p>
            {% trans with {'%name%':  workflow.name} %}You are about to delete the workflow "%name%", click the delete button to confirm the action.{% endtrans %}
        </p>
        {{ form_rest(form, {'style':'horizontal'})}}
    {% endset %}
    {{ component('integrated_admin:edit_form_shell', {
        toolbarHtml: workflowDeleteToolbarHtml,
        pageTitleHtml: workflowDeleteTitleHtml,
        editorContentHtml: workflowDeleteContentHtml,
    }) }}
    {% block form_end %}
        {{ form_end(form) }}
    {% endblock %}
{% endblock %}
