{% extends '@IntegratedWorkflow/layout.html.twig' %}
{% block title %}{% trans %}Delete Workflow{% endtrans %} {% endblock title %}

{% block content %}
    <div class="flex flex-wrap edit-form">
        {% block form_start %}
            {{ form_start(form) }}
        {% endblock %}
        {% block toolbar %}
            {% include '@IntegratedContent/partials/block.toolbar.html.twig' %}
        {% endblock toolbar %}
        <div class="aside-options"></div>
        <div class="editor-wrapper">
            {{ component('integrated_admin:page_title', {
                title: ('Delete'|trans) ~ ' ' ~ ('workflow'|trans),
            }) }}
            <section class="editor editor-wrapped">
                <p>
                    {% trans with {'%name%':  workflow.name} %}You are about to delete the workflow "%name%", click the delete button to confirm the action.{% endtrans %}
                </p>
                {{ form_rest(form, {'style':'horizontal'})}}
            </section>
        </div>
        {% block form_end %}
            {{ form_end(form) }}
        {% endblock %}
    </div>
{% endblock %}
