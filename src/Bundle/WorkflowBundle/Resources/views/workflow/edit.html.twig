{% extends '@IntegratedWorkflow/layout.html.twig' %}
{% block title %}{% trans %}Edit workflow{% endtrans %}{% endblock title %}

{% block content %}
    <div class="flex flex-wrap edit-form">
        {% block form_start %}
            {{ form_start(form, { 'style': 'horizontal' }) }}
        {% endblock %}
        {% block toolbar %}
            {% include '@IntegratedContent/partials/block.toolbar.html.twig' %}
        {% endblock toolbar %}
        <div class="aside-options">
            <aside>
                <div class="aside-holder">
                    {% block sidebar %}
                        <div class="aside-header">
                            <button class="toggle-filters" onclick="toggleOptionsSidebar()" type="button"><i
                                    class="iconoir-cancel"></i></button>
                            <span>{% trans %}Options{% endtrans %}</span>
                        </div>
                        <div class="aside-item-wrapper show">
                            <div class="aside-item-header">
                                <h3 class="aside-item-title">
                                    <i class="iconoir-info-empty"></i>
                                    <span class="aside-item-icon">{% trans %}Status{% endtrans %}</span>
                                </h3>
                                <i class="iconoir-nav-arrow-up"></i>
                            </div>
                            <div class="aside-item-list">
                                <div class="aside-item-list-container">
                                    <div class="status-info">
                                        {% if form.publicationStartDate is defined %}
                                            {{ form_row(form.publicationStartDate) }}
                                        {% endif %}
                                    </div>
                                    <div class="status-options">
                                        {% if workflow is defined %}
                                            <div class="status published">
                                                <i class="iconoir-check-circled-outline"></i> {% trans %}Published{% endtrans %}
                                            </div>
                                            <a class="delete"
                                               href="{{ path('integrated_workflow_delete', {'id': workflow.id}) }}">
                                                <i class="iconoir-trash"></i>
                                            </a>
                                        {% else %}
                                            <div class="status draft">
                                                <i class="iconoir-design-pencil"></i> {% trans %}Draft{% endtrans %}
                                            </div>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                        </div>
                        {% if form.channels is defined %}
                            {{ form_row(form.channels, {'style': 'sidebar', 'icon':'network-alt', 'state': 'show'}) }}
                        {% endif %}
                    {% endblock %}
                </div>
            </aside>
        </div>
        <div class="editor-wrapper">
            <div class="page-title">
                <h1 class="heading">
                    {% block contentTitle %}
                        {% trans %}Edit{% endtrans %} {% trans %}workflow{% endtrans %}
                    {% endblock %}
                </h1>
            </div>
            <section class="editor editor-wrapped">
                {{ form_errors(form) }}

                {{ form_rest(form, {'style':'horizontal', 'state': 'show'}) }}
            </section>
        </div>
        {% block form_end %}
            {{ form_end(form) }}
        {% endblock %}
    </div>
{% endblock %}
{# {% block webpack_js %} #}
{# {% endblock %} #}

{% block javascript %}
{{ parent() }}

<script src="{{ asset('bundles/integratedintegrated/workflow.js') }}"></script>
{% endblock %}
