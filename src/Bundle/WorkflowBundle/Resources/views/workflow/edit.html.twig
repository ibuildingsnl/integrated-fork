{% extends '@IntegratedWorkflow/layout.html.twig' %}
{% block title %}{% trans %}Edit workflow{% endtrans %}{% endblock title %}

{% block content %}
    <div class="flex flex-wrap edit-form">
        {% block form_start %}
            {{ form_start(form) }}
        {% endblock %}
        {% block toolbar %}
            {% include '@IntegratedContent/partials/block.toolbar.html.twig' %}
        {% endblock toolbar %}
        <div class="aside-options"></div>
        <div class="editor-wrapper editor-wrapper-full">
            <div class="page-title">
                <h1 class="heading">
                    {% block contentTitle %}
                        {% trans %}Edit{% endtrans %} {% trans %}workflow{% endtrans %}
                    {% endblock %}
                </h1>
            </div>
            <section class="editor editor-wrapped">
                {{ form_errors(form) }}

                {{ form_rest(form, {'style':'horizontal', 'state': 'show'}) }}
            </section>
        </div>
        {% block form_end %}
            {{ form_end(form) }}
        {% endblock %}
    </div>
{% endblock %}

{% block javascript %}
{{ parent() }}

<script src="{{ asset('bundles/integratedintegrated/workflow.js') }}"></script>
{% endblock %}
