{% extends '@IntegratedWorkflow/layout.html.twig' %}

{% block content %}
    <div class="row">
        <div class="index-wrapper-full">
            {% set createActionsHtml %}
                <ul class="create">
                    <li>
                        <a class="btn btn-create-new" href="{{ path('integrated_workflow_new') }}">
                            <span>{% trans %}New{% endtrans %} {% trans %}workflow{% endtrans %}</span>
                            <i class="iconoir-plus"></i>
                        </a>
                    </li>
                </ul>
            {% endset %}
            {{ component('integrated_admin:page_title', {
                title: 'Workflows'|trans,
                actionsHtml: createActionsHtml,
            }) }}
            {% component 'integrated_admin:section_card' %}
                {% block content %}
                {% set workflowTableColGroupHtml %}
                    <colgroup>
                        <col/>
                    </colgroup>
                {% endset %}
                {% set workflowTableHeadHtml %}
                    <tr>
                        <th>Workflow</th>
                    </tr>
                {% endset %}
                {% set workflowTableBodyHtml %}
                    {% for workflow in pager %}
                        <tr class="has-options">
                            <td>
                                <strong>
                                    <a href="{{ path('integrated_workflow_edit', {'id': workflow.id}) }}">
                                        {{ workflow.name }}
                                    </a>
                                </strong>
                                <div class="row-options">
                                    <a href="{{ path('integrated_workflow_edit', {'id': workflow.id}) }}"
                                       title="{% trans %}Edit{% endtrans %}">{% trans %}Edit{% endtrans %}</a> |
                                    <a href="{{ path('integrated_workflow_delete', {'id': workflow.id}) }}"
                                       class="color-red" title="{% trans %}Delete{% endtrans %}">{% trans %}Delete{% endtrans %}</a>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                {% endset %}
                {{ component('integrated_admin:data_table', {
                    colGroupHtml: workflowTableColGroupHtml,
                    headHtml: workflowTableHeadHtml,
                    bodyHtml: workflowTableBodyHtml,
                    colSpan: 1,
                }) }}

                {{ knp_pagination_render(pager, '@KnpPaginator/Pagination/sliding.html.twig') }}
                {% endblock %}
            {% endcomponent %}

        </div>
    </div>

{% endblock %}
