{% block integrated_workflow_row %}
    {% set attr = attr|merge({
        'class': (attr.class|default('') ~ ' workflow')|trim,
        'data-workflow-state-change': path('integrated_workflow_change_state')
    }) %}

    <div {{ block('widget_container_attributes') }}>
        {{ block('form_rows') }}
    </div>
{% endblock %}

{% block integrated_workflow_state_row %}
    {{ block('form_rows') }}
{% endblock %}

{% block workflow_state_text_widget %}
    <p class="form-control-static">{{ value }}</p>
{% endblock %}

{% block workflow_definition_transitions_row %}
    {{ block('form_row') }}
    {{ form_row(form.override) }}
{% endblock %}

{% block workflow_definition_transitions_widget %}
    {{ form_widget(form.selection) }}
{% endblock %}

{% block workflow_definition_state_collection_widget %}
    {% apply spaceless %}
        {% if prototype is defined %}
            {% set prototype_vars = {} %}
            {% if style is defined %}
                {% set prototype_vars = prototype_vars|merge({'style': style}) %}
            {% endif %}

            {% set prototype_html = '<div class="lg:w-11/12">' ~ form_widget(prototype, prototype_vars) %}
            {% if form.vars.allow_delete %}
                {% set prototype_html = prototype_html ~ '<a href class="remove" data-removefield="collection" data-field="__id__"><i class="fa fa-xmark"></i></a>' %}
            {% endif %}
            {% set prototype_html = prototype_html ~ '</div>' %}

            {% set attr = attr|merge({'data-prototype': prototype_html }) %}
            {% set attr = attr|merge({'data-prototype-name': prototype_name }) %}
        {% endif %}
        <div {{ block('widget_container_attributes') }} class="definition-state-collection-widget">
            <ul class="integrated-collection">
                {% for field in form %}
                    <li class="workflow-state">
                        <div class="lg:w-11/12">
                            {{ form_widget(field) }}
                            {{ form_errors(field) }}
                        </div>
                        {% if form.vars.allow_delete %}
                            <a href class="remove" data-removefield="collection" data-field="{{ field.vars.id }}">
                                <i class="fa fa-xmark"></i>
                            </a>
                        {% endif %}
                    </li>
                {% endfor %}
            </ul>

            {% if form.vars.allow_add %}
                <div class="integrated-collection-button">
                    <a href class="btn btn-green icon-left state_add_button" data-addfield="collection"
                       data-collection="{{ form.vars.id }}" data-prototype-name="{{ prototype_name }}">
                        <i class="fa fa-plus"></i><span>Add Status</span></a>
                </div>
            {% endif %}

        </div>
    {% endapply %}
{% endblock workflow_definition_state_collection_widget %}
