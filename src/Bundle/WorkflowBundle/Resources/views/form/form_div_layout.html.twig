{% block integrated_workflow_row %}
    {% set attr = attr|merge({
        'class': (attr.class|default('') ~ ' workflow')|trim,
        'data-workflow-state-change': path('integrated_workflow_change_state')
    }) %}

    <div {{ block('widget_container_attributes') }}>
        {{ block('form_rows') }}
    </div>
{% endblock %}

{% block integrated_workflow_state_row %}
    {{ block('form_rows') }}
{% endblock %}

{% block workflow_state_text_widget %}
    <p class="form-control-static">{{ value }}</p>
{% endblock %}

{% block workflow_definition_transitions_row %}
    {{ block('form_row') }}
    {{ form_row(form.override) }}
{% endblock %}

{% block workflow_definition_transitions_widget %}
    {{ form_widget(form.selection) }}
{% endblock %}

{% block workflow_definition_state_collection_widget %}
    {% apply spaceless %}
        {% if prototype is defined %}
            {% set prototype_vars = {} %}
            {% if style is defined %}
                {% set prototype_vars = prototype_vars|merge({'style': style}) %}
            {% endif %}

            {% set prototype_html = '<a data-toggle="collapse"><i class="iconoir-nav-arrow-down"></i><span>' ~ field.vars.value.title|default(form.vars.default_title|default('New status')) ~ '</span></a>' %}
            {% if form.vars.allow_delete %}
                {% set prototype_html = prototype_html ~ '<a href="javascript:;" class="remove" title="' ~ 'Remove'|trans({}, translation_domain) ~ '" data-removefield="collection" data-field="__id__"><i class="iconoir-cancel"></i></a>' %}
            {% endif %}
            {% set prototype_html = '<div class="panel-heading"><h4 class="panel-title">' ~ prototype_html ~ '</h4></div>' %}
            {% set prototype_html = prototype_html ~ '<div id="__id__" class="panel-collapse collapse in"><div class="panel-body">' ~ form_widget(prototype, prototype_vars) ~ '</div></div>' %}
            {% set prototype_html = '<div class="panel panel-default in">' ~ prototype_html ~ '</div>' %}

            {% set attr = attr|merge({'data-prototype': prototype_html }) %}
            {% set attr = attr|merge({'data-prototype-name': prototype_name }) %}
        {% endif %}
        <div {{ block('widget_container_attributes') }} class="definition-state-collection-widget collection-widget">
            <ul class="bc-collection panel-group sortable-collection ui-sortable">
                {% for field in form %}
                    <li class="ui-sortable-handle">
                        <div class="panel panel-default">
                            <div class="panel-heading">
                                <h4 class="panel-title">
                                    <a data-toggle="collapse">
                                        <i class="iconoir-nav-arrow-down"></i>
                                        <div class="workflow-status" style="background-color:{{field.vars.value.color}};">
                                            <i class="iconoir-{{ field.vars.value.icon }}"></i>
                                        </div>
                                        <span>{{ field.vars.value.name|default(form.vars.default_title|default('New status')) }}</span>
                                        <span class="transition">Transitions to:
                                         {% for transition in field.vars.value.transitions %}
                                             {% if loop.first %}
                                                 {{ transition.name }}
                                             {% else %}
                                                 / {{ transition.name }}
                                             {% endif %}
                                         {% endfor %}
                                        </span>
                                    </a>
                                    {% if form.vars.allow_delete %}
                                        <a href="javascript:;" class="remove"
                                           title="{{ form.vars.delete_button_text|trans({}, translation_domain) }}"
                                           data-removefield="collection" data-field="{{ field.vars.id }}">
                                            <i class="iconoir-cancel"></i>
                                        </a>
                                    {% endif %}
                                </h4>
                            </div>
                            <div id="{{ field.vars.id }}"
                                 class="panel-collapse collapse{% if not field.vars.valid %} in{% endif %}">
                                <div class="panel-body">
                                    {{ form_widget(field) }}
                                    {{ form_errors(field) }}
                                </div>
                            </div>
                        </div>
                    </li>

                {% endfor %}
            </ul>

            {% if form.vars.allow_add %}
                <a href="javascript:;" class="btn" title="{{ form.vars.add_button_text|trans({}, translation_domain) }}"
                   data-addfield="collection" data-collection="{{ form.vars.id }}"
                   data-prototype-name="{{ prototype_name }}">
                    <span>{{ form.vars.add_button_text|trans({}, translation_domain) }}</span>
                    <i class="iconoir-plus"></i>
                </a>
            {% endif %}
        </div>

    {% endapply %}
{% endblock workflow_definition_state_collection_widget %}
