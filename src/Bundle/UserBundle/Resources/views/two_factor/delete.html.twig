{% extends '@IntegratedContent/base.html.twig' %}
{% block title %}{% trans %}Delete 2FA{% endtrans %} {% endblock title %}

{% block content %}
    {% block form_start %}
        {{ form_start(form) }}
    {% endblock %}
    {% set twoFactorDeleteToolbarHtml %}
        {% block toolbar %}
            {% include '@IntegratedContent/partials/block.toolbar.html.twig' %}
        {% endblock toolbar %}
    {% endset %}
    {% set twoFactorDeleteTitleHtml %}
        {{ component('integrated_admin:page_title', {
            title: ('Delete'|trans) ~ ' ' ~ ('2Factor Auth'|trans),
        }) }}
    {% endset %}
    {% set twoFactorDeleteContentHtml %}
        <p>
            {% trans with {'%name%':  user.username} %}You are about to delete the two factor authenticator for the user "%name%", click the delete button below to confirm the action.{% endtrans %}
        </p>
        {{ form_rest(form, {'style':'horizontal'})}}
    {% endset %}
    {{ component('integrated_admin:edit_form_shell', {
        toolbarHtml: twoFactorDeleteToolbarHtml,
        pageTitleHtml: twoFactorDeleteTitleHtml,
        editorContentHtml: twoFactorDeleteContentHtml,
    }) }}
    {% block form_end %}
        {{ form_end(form) }}
    {% endblock %}
{% endblock %}
