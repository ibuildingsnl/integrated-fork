{% extends '@IntegratedContent/base.html.twig' %}

    {% block content %}
        {% block form_start %}
            {{ form_start(form, {'attr': {'id': 'integrated_user_profile_form'}}) }}
        {% endblock %}
        {% set userProfileToolbarHtml %}
            {% block toolbar %}
                {% include '@IntegratedContent/partials/block.toolbar.html.twig' %}
            {% endblock toolbar %}
        {% endset %}
        {% set userProfileTitleHtml %}
            {{ component('integrated_admin:page_title', {
                title: ('Edit'|trans) ~ ' ' ~ ('profile'|trans),
            }) }}
        {% endset %}
        {% set userProfileEditorContentHtml %}
            {% if user.relation is defined and user.relation %}
                {% set linkedAuthorAlertHtml %}
                    <strong>{% trans %}Linked author{% endtrans %}:</strong>
                    <a href="{{ path('integrated_content_content_edit', {id: user.relation.id}) }}">
                        {{ user.relation.name|default('') }} {{ user.relation.firstname|default('') }} {{ user.relation.lastname|default('') }}
                    </a>
                {% endset %}
                {{ component('integrated_admin:alert_box', {
                    variant: 'info',
                    bodyHtml: linkedAuthorAlertHtml,
                }) }}
            {% endif %}
            {% block user_profile_extra %}{% endblock %}
            {{ form_rest(form, {'style':'horizontal', 'state': 'show'}) }}
        {% endset %}
        {% set userProfileAfterEditorHtml %}
            {% component 'integrated_admin:section_card' with {
                extraClass: 'section-padding mt-4',
            } %}
                {% block content %}
                <h3>{% trans %}Two-factor authentication{% endtrans %}</h3>
                {% if user.googleAuthenticatorEnabled %}
                    {{ component('integrated_admin:alert_box', {
                        variant: 'success',
                        bodyHtml: 'Two-factor authentication is active for your account.'|trans,
                    }) }}
                    <div class="flex items-center gap-2">
                        <form method="post" action="{{ path('integrated_user_profile_two_factor_deactivate') }}" onsubmit="return confirm('{{ 'Are you sure you want to deactivate 2FA for your account?'|trans }}');">
                            <input type="hidden" name="_token" value="{{ csrf_token('profile_2fa_deactivate') }}">
                            <button type="submit" class="btn btn-red">{% trans %}Deactivate 2FA{% endtrans %}</button>
                        </form>
                        <form method="post" action="{{ path('integrated_user_profile_two_factor_reset') }}" onsubmit="return confirm('{{ 'Are you sure you want to reset 2FA for your account?'|trans }}');">
                            <input type="hidden" name="_token" value="{{ csrf_token('profile_2fa_reset') }}">
                            <button type="submit" class="btn btn-white">{% trans %}Reset 2FA{% endtrans %}</button>
                        </form>
                    </div>
                {% else %}
                    {{ component('integrated_admin:alert_box', {
                        variant: 'warning',
                        bodyHtml: 'Two-factor authentication is not active yet. Activate it to better protect your account.'|trans,
                    }) }}
                    <a class="btn btn-orange" href="{{ path('integrated_user_two_factor_authenticator_activate') }}">
                        {% trans %}Activate 2FA{% endtrans %}
                    </a>
                {% endif %}
                {% endblock %}
            {% endcomponent %}
        {% endset %}
        {{ component('integrated_admin:edit_form_shell', {
            toolbarHtml: userProfileToolbarHtml,
            pageTitleHtml: userProfileTitleHtml,
            editorContentHtml: userProfileEditorContentHtml,
            afterEditorHtml: userProfileAfterEditorHtml,
        }) }}
        {% block form_end %}
            {{ form_end(form) }}
        {% endblock %}
    {% endblock %}

    {% block javascript %}
        {{ parent() }}
        {% include '@IntegratedUser/partial/password_toggle_script.html.twig' with {'integrated_password_toggle_form_selector': '#integrated_user_profile_form'} %}
    {% endblock javascript %}
