{% extends "@IntegratedUser/layout.html.twig" %}
{% block title %}{% trans %}Integrated - Password reset{% endtrans %} {% endblock title %}

{% block style %}
    {{ parent() }}

    {% include('@IntegratedUser/partial/modal.html.twig') %}
{% endblock style %}

{% block body %}
    <div class="modal-wrapper auth">
        <div class="logo"><img src="{{ asset('bundles/integratedintegrated/images/logo_white.svg') }}" alt=""></div>
        <div class="auth modal">
        <div class="modal-dialog">
            <div class="modal-content ">
                {{ form_start(form, {'attr': {'id': 'login_form'}, 'widget_col': 'w-full', 'label_col': 'w-full', 'style': 'inline', 'show_label': 'false'}) }}

                <div class="modal-header">
                    <h2 class="modal-title">{% trans %}Login{% endtrans %}</h2>
                    <p>{% trans %}Fill in your data to receive a reset link{% endtrans %}</p>
                </div>

                <div class="modal-body">
                        {% for label, messages in app.flashes(['alert', 'danger', 'info', 'success', 'warning', 'error']) %}
                            {% for message in messages %}
                                {% if label == 'alert' %}
                                    {% set label = 'warning' %}
                                {% elseif label == 'error' %}
                                    {% set label = 'danger' %}
                                {% endif %}
                                <div class="alert alert-{{ label }} alert-dismissible">
                                    <button type="button" class="close" data-dismiss="alert" aria-label="Close notification">&times;</button>
                                    {{ message|trans }}
                                </div>
                            {% endfor %}
                        {% endfor %}

                    {{ form_widget(form) }}
                </div>

                {{ form_end(form) }}
            </div>
        </div>
    </div>
        <span class="password-reset">
            <a href="{{ path('integrated_user_password_reset') }}">{% trans %}Password reset{% endtrans %}</a>
        </span>
    </div>

    <div class="modal-backdrop"></div>
{% endblock body %}

{% block javascript %}
    {{ parent() }}
    {% include('@IntegratedUser/partial/password_toggle_script.html.twig') %}
{% endblock javascript %}
