{% extends "@IntegratedUser/layout.html.twig" %}
{% block title %}{{ 'Authentication code'|trans }} {{ twoFactorProvider }}{% endblock %}

{% block style %}
    {{ parent() }}

    {% include('@IntegratedUser/partial/modal.html.twig') %}
{% endblock style %}

{% block flash %}
{% endblock flash %}

{% block body %}
    <div class="modal-wrapper auth">
        <div class="logo"><img src="{{ asset('bundles/integratedintegrated/images/logo_white.svg') }}" alt=""></div>
        <div class="auth modal" role="dialog">
            <div class="modal-dialog">
                <div class="modal-content">
                    <form action="{{ checkPathUrl ? checkPathUrl: path(checkPathRoute) }}" method="post" class="form-inline {% if authenticationError %}has-global-errors{% endif %}">
                        <div class="modal-header">
                            <h2 class="modal-title">{{ "2FA"|trans }}</h2>
                            <p>{% trans %}Enter your 6-digit verification code to continue{% endtrans %}</p>
                        </div>
                        <div class="modal-body">
                            {% if authenticationError %}
                                {% set twoFactorErrorHtml %}
                                    <li>{{ authenticationError|trans(authenticationErrorData, 'SchebTwoFactorBundle') }}</li>
                                {% endset %}
                                {{ component('integrated_admin:alert_box', {
                                    tag: 'ul',
                                    variant: 'danger',
                                    bodyHtml: twoFactorErrorHtml,
                                }) }}
                            {% endif %}

                            <div class="form-group w-full flex flex-wrap">
                                <div class="w-full widget">
                                    <input
                                        class="form-control"
                                        id="_auth_code"
                                        type="text"
                                        name="{{ authCodeParameterName }}"
                                        autocomplete="one-time-code"
                                        autofocus
                                        inputmode="numeric"
                                        pattern="[0-9]*"
                                        placeholder="{{ 'Authentication code'|trans }}"
                                    />
                                </div>
                            </div>

                            <div class="form-group w-full flex flex-wrap">
                                <button class="no-icon btn btn-primary" type="submit" id="login" name="login">
                                    <span>{{ 'Login'|trans }}</span>
                                </button>
                                <a class="btn btn-link" href="{{ path('integrated_user_login') }}">{{ "Cancel"|trans }}</a>
                            </div>

                            {% if isCsrfProtectionEnabled %}
                                <input type="hidden" name="{{ csrfParameterName }}" value="{{ csrf_token(csrfTokenId) }}"/>
                            {% endif %}
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
        <div class="modal-backdrop"></div>
{% endblock body %}
