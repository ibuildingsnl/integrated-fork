{% extends '@IntegratedContent/base.html.twig' %}
{% block title %}{% trans %}Groups{% endtrans %} {% endblock title %}
{% block content %}
    <div class="row">
        <div class="w-full mb-4 p-8 md:mb-0">
            <div class="page-title">
                <h1 class="heading">{% trans %}Groups{% endtrans %}</h1>
                <ul class="create">
                    <li>
                        <a class="btn btn-create-new" href="{{ path('integrated_user_group_new') }}">
                            <span>{% trans %}New{% endtrans %} {% trans %}group{% endtrans %}</span>
                            <i class="iconoir-plus"></i>
                        </a>
                    </li>
                </ul>
            </div>
            <section class="section-white section-radius">

                <table class="table table-hover">

                    <colgroup>
                        <col style="width: 3em"/>
                        <col/>
                    </colgroup>

                    <thead>
                    <tr>
                        <th>#</th>
                        <th>Name</th>
                    </tr>
                    </thead>

                    <tbody>

                    {% for group in groups %}

                        <tr class="has-options">
                            <td>{{ group.id }}</td>
                            <td>
                                <strong>
                                    <a href="{{ path('integrated_user_group_edit', {'id': group.id}) }}">
                                        {{ group.name }}
                                    </a>
                                </strong>
                                <div class="row-options">
                                    <a href="{{ path('integrated_user_group_edit', {'id': group.id}) }}"
                                       title="{% trans %}Edit{% endtrans %}">{% trans %}Edit{% endtrans %}</a> |
                                    <a href="{{ path('integrated_user_group_delete', {'id': group.id}) }}"
                                       class="color-red" title="{% trans %}Delete{% endtrans %}">{% trans %}Delete{% endtrans %}</a>
                                </div>
                            </td>
                        </tr>

                    {% endfor %}

                    </tbody>

                </table>

                {{ knp_pagination_render(groups) }}

            </section>
        </div>
    </div>
{% endblock %}
