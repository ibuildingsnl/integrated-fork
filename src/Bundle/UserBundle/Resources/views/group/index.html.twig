{% extends '@IntegratedContent/base.html.twig' %}
{% block title %}{% trans %}Groups{% endtrans %} {% endblock title %}
{% block content %}
    <div class="row">
        <div class="w-full mb-4 md:mb-0">
            <div class="page-title">
                <h1 class="heading">{% trans %}Groups{% endtrans %}</h1>
                <ul class="create">
                    <li>
                        <a class="btn btn-create-new" href="{{ path('integrated_user_group_new') }}">
                            <span>{% trans %}New{% endtrans %} {% trans %}group{% endtrans %}</span>
                            <i class="fa-regular fa-plus"></i>
                        </a>
                    </li>
                </ul>
{#                <div class="options">#}
{#                    <ul class="">#}
{#                        <li class="dropdown">#}
{#                            <a href="#" data-toggle="dropdown" class="btn btn-select space-between" role="button"#}
{#                               id="drop_1">Options <i#}
{#                                    class="fa-regular fa-angle-down"></i></a>#}
{#                            <ul aria-labelledby="drop_1" role="menu" class="dropdown-menu" id="menu_1">#}
{#                                <li role="presentation"><a href="{{ path('integrated_user_group_new') }}" tabindex="-1"#}
{#                                                           role="menuitem">New</a></li>#}
{#                            </ul>#}
{#                        </li>#}
{#                    </ul>#}
{#                </div>#}
            </div>
            <section class="section-white section-radius">

                <table class="table table-hover">

                    <colgroup>
                        <col style="width: 3em"/>
                        <col/>
                        <col style="width: 5em"/>
                    </colgroup>

                    <thead>
                    <tr>
                        <th>#</th>
                        <th>Name</th>
                        <th>Actions</th>
                    </tr>
                    </thead>

                    <tbody>

                    {% for group in groups %}

                        <tr class="has-options">
                            <td>{{ group.id }}</td>
                            <td>
                                <strong>
                                    <a href="{{ path('integrated_user_group_edit', {'id': group.id}) }}">
                                        {{ group.name }}
                                    </a>
                                </strong>
                                <div class="row-options">
                                    <a href="{{ path('integrated_user_group_edit', {'id': group.id}) }}"
                                       title="{% trans %}Edit{% endtrans %}">{% trans %}Edit{% endtrans %}</a> |
                                    <a href="{{ path('integrated_user_group_delete', {'id': group.id}) }}"
                                       class="color-red" title="{% trans %}Delete{% endtrans %}">{% trans %}Delete{% endtrans %}</a>
                                </div>
                            </td>
                            <td>

                            </td>
                        </tr>

                    {% endfor %}

                    </tbody>

                </table>

                {{ knp_pagination_render(groups) }}

            </section>
        </div>
    </div>
