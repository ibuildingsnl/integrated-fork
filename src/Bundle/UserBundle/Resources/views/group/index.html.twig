{% extends '@IntegratedContent/base.html.twig' %}
{% block title %}{% trans %}Groups{% endtrans %} {% endblock title %}
{% block content %}
    <div class="row">
        <div class="index-wrapper-full">
            {% set createActionsHtml %}
                <ul class="create">
                    <li>
                        <a class="btn btn-create-new" href="{{ path('integrated_user_group_new') }}">
                            <span>{% trans %}New{% endtrans %} {% trans %}group{% endtrans %}</span>
                            <i class="iconoir-plus"></i>
                        </a>
                    </li>
                </ul>
            {% endset %}
            {{ component('integrated_admin:page_title', {
                title: 'Groups'|trans,
                actionsHtml: createActionsHtml,
            }) }}
            {% component 'integrated_admin:section_card' %}
                {% block content %}
                {% set groupTableColGroupHtml %}
                    <colgroup>
                        <col style="width: 3em"/>
                        <col/>
                        <col/>
                    </colgroup>
                {% endset %}
                {% set groupTableHeadHtml %}
                    <tr>
                        <th>#</th>
                        <th>{% trans %}Name{% endtrans %}</th>
                        <th>{% trans %}Users{% endtrans %}</th>
                    </tr>
                {% endset %}
                {% set groupTableBodyHtml %}
                    {% for group in groups %}
                        <tr class="has-options">
                            <td>{{ group.id }}</td>
                            <td>
                                <strong>
                                    <a href="{{ path('integrated_user_group_edit', {'id': group.id}) }}">
                                        {{ group.name }}
                                    </a>
                                </strong>
                                <div class="row-options">
                                    <a href="{{ path('integrated_user_group_edit', {'id': group.id}) }}"
                                       title="{% trans %}Edit{% endtrans %}">{% trans %}Edit{% endtrans %}</a> |
                                    <a href="{{ path('integrated_user_group_delete', {'id': group.id}) }}"
                                       class="color-red" title="{% trans %}Delete{% endtrans %}">{% trans %}Delete{% endtrans %}</a>
                                </div>
                            </td>
                            <td>
                                {{ userCountsByGroupId[group.id]|default(0) }}
                            </td>
                        </tr>
                    {% endfor %}
                {% endset %}
                {{ component('integrated_admin:data_table', {
                    colGroupHtml: groupTableColGroupHtml,
                    headHtml: groupTableHeadHtml,
                    bodyHtml: groupTableBodyHtml,
                    colSpan: 3,
                }) }}

                {{ knp_pagination_render(groups, '@KnpPaginator/Pagination/sliding.html.twig') }}
                {% endblock %}
            {% endcomponent %}
        </div>
    </div>
{% endblock %}
