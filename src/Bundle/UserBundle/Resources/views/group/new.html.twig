{% extends '@IntegratedContent/base.html.twig' %}
{% block title %}{% trans %}New group{% endtrans %} {% endblock title %}
{% block content %}
    {% block form_start %}
        {{ form_start(form) }}
    {% endblock %}
    {% set groupNewToolbarHtml %}
        {% block toolbar %}
            {% include '@IntegratedContent/partials/block.toolbar.html.twig' %}
        {% endblock toolbar %}
    {% endset %}
    {% set groupNewTitleHtml %}
        {{ component('integrated_admin:page_title', {
            title: ('New'|trans) ~ ' ' ~ ('group'|trans),
        }) }}
    {% endset %}
    {% set groupNewEditorContentHtml %}
        {{ form_rest(form, {'style':'horizontal', 'state': 'show'})}}
    {% endset %}
    {{ component('integrated_admin:edit_form_shell', {
        toolbarHtml: groupNewToolbarHtml,
        pageTitleHtml: groupNewTitleHtml,
        editorContentHtml: groupNewEditorContentHtml,
    }) }}
    {% block form_end %}
        {{ form_end(form) }}
    {% endblock %}
{% endblock %}
