{% extends '@IntegratedContent/base.html.twig' %}
{% block title %}{% trans %}Delete group{% endtrans %} {% endblock title %}
{% block content %}
    <div class="flex flex-wrap edit-form">
        {% block form_start %}
            {{ form_start(form, { 'style': 'horizontal' }) }}
        {% endblock %}
        <div id="toolbar" class="w-full flex justify-between">
            <div class="back">
                {% block form_return %}
                    {% if form.actions.back is defined %}
                        {{ form_row(form.actions.back) }}
                    {% endif %}
                    {% if form.actions.cancel is defined %}
                        {{ form_row(form.actions.cancel) }}
                    {% endif %}
                {% endblock %}
            </div>
            <div class="options">
                <div class="form-actions">
                    {% block form_actions %}
                        {% if form.actions.delete is defined %}
                            {{ form_row(form.actions.delete) }}
                        {% endif %}
                    {% endblock %}
                </div>
            </div>
        </div>
        <div class="aside-options"></div>
        <div class="editor-wrapper">
            <div class="page-title">
                <h1 class="heading">{% trans %}Delete{% endtrans %} {% trans %}group{% endtrans %}</h1>
            </div>
            <section class="editor editor-wrapped">
                <p>
                    {% trans with {'%name%':  group.name} %}You are about to delete the group "%name%", click the delete button to confirm the action.{% endtrans %}
                </p>
            </section>
        </div>
        {% block form_end %}
            {{ form_end(form) }}
        {% endblock %}
    </div>
{% endblock %}
