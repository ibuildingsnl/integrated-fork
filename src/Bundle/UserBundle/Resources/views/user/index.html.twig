{% extends '@IntegratedContent/base.html.twig' %}

{% form_theme facetFilter '@IntegratedBlock/form/form_div_filter.html.twig' %}

{% block crumbs %}
    <div class="breadcrumb-holder">
        <div class="container">
            <ol class="breadcrumb">
                <li class="active">{% trans %}Users{% endtrans %}</li>
            </ol>
        </div>
    </div>
{% endblock %}

{% block content %}
    <div class="row flex flex-wrap">
        <div class="w-full md:w-4/5 mb-4 md:mb-0 pr-4">
            <div class="page-title">
                <h1 class="heading">{% trans %}Users{% endtrans %}</h1>
                <ul class="create">
                    <li>
                        <a class="btn btn-create-new" href="{{ path('integrated_user_user_new') }}">
                            <span>{% trans %}New{% endtrans %} {% trans %}User{% endtrans %}</span>
                            <i class="fa-solid fa-plus"></i>
                        </a>
                    </li>
                </ul>
            </div>

            {% include '@IntegratedUser/user/partials/user_list.html.twig' %}

        </div>

        <div class="w-full md:w-1/5 pl-4">
            <aside>
                <div class="aside-holder section-gray section-radius">
                    {{ form_start(facetFilter) }}

                    <div class="aside-item-holder">
                        <div class="input-group input-group-search">
                            {{ form_widget(facetFilter.q) }}
                            <span class="input-group-btn">
                                <button type="submit" class="">
                                    <i class="fa-solid fa-magnifying-glass"></i>
                                </button>
                            </span>
                        </div>
                    </div>

                    {% block user_filter_groups %}
                    <div class="aside-item-holder {% if facetFilter.groups|length == 0 %} hidden{% endif %}">
                        {{ form_row(facetFilter.groups, {'style':'sidebar', 'state': 'show'}) }}
                    </div>
                    {% endblock %}

                    {% block user_filter_scope %}
                    <div class="aside-item-holder {% if facetFilter.scope|length == 0 %} hidden{% endif %}">
                        {{ form_row(facetFilter.scope, {'style':'sidebar', 'state': 'show'}) }}
                    </div>
                    {% endblock %}

                    {{ form_end(facetFilter) }}
                </div>
            </aside>
        </div>
    </div>

{% endblock %}

{% block javascript %}
{{ parent() }}
<script type="text/javascript">
    $(function () {
        $('[data-toggle="popover"]').popover();

        $('form[name="integrated_user_filter"]').on('change', function () {
            $(this).trigger('submit');
        });
    });
</script>
{% endblock %}
