{% extends '@IntegratedContent/base.html.twig' %}

{% form_theme facetFilter with '@IntegratedFormType/form/form_div_layout.html.twig' %}

{% block content %}
    {% set currentSort = app.request.query.get('sort')|default('createdAt') %}
    {% set currentDirection = app.request.query.get('direction')|default('desc') %}
    {% set sortOptions = {
        'createdAt': 'Date created'|trans,
        'username': 'Username'|trans,
        'role': 'Role'|trans,
        'scope.name': 'Scope'|trans,
        'id': 'ID'
    } %}
    <div class="row flex flex-wrap">
        <div class="index-wrapper">
            <div class="page-title">
                <div class="heading flex justify-between w-full">
                    <div class="heading-switcher">
                        <h1 class="heading">{% trans %}Users{% endtrans %}</h1>
                    </div>
                    <button class="toggle-filters toggle-data-target btn btn-orange icon-left" data-target="aside-filters">
                        <i class="iconoir-filter-alt"></i>
                        <span>{% trans %}Filter{% endtrans %}</span>
                    </button>
                </div>
                <div class="options options-toolbar">
                    <ul class="content-navigator-menu">
                        <li class="dropdown close-outside" data-underlay="no">
                            <a data-toggle="dropdown" role="button" id="sorting-list" class="btn btn-select space-between">
                                <span>{% trans %}Sort by{% endtrans %}: {{ sortOptions[currentSort]|default(sortOptions['createdAt']) }}</span>
                                <i class="iconoir-nav-arrow-down"></i>
                            </a>
                            <ul aria-labelledby="sorting-list" role="menu" class="dropdown-menu" id="sorting-menu">
                                {% for field, label in sortOptions %}
                                    {% set nextDirection = (currentSort == field and currentDirection == 'asc') ? 'desc' : 'asc' %}
                                    <li {% if currentSort == field %}class="active"{% endif %} role="presentation">
                                        <a href="{{ path('integrated_user_user_index', app.request.query.all|merge({'sort': field, 'direction': nextDirection, 'page': 1})) }}" tabindex="-1" role="menuitem">{{ label }}</a>
                                    </li>
                                {% endfor %}
                            </ul>
                        </li>
                        <li>
                            <a class="btn btn-orange icon-left" href="{{ path('integrated_user_user_new') }}">
                                <i class="iconoir-plus"></i>
                                <span>{% trans %}New user{% endtrans %}</span>
                            </a>
                        </li>
                    </ul>
                </div>
            </div>

            {% include '@IntegratedUser/user/partials/user_list.html.twig' %}

        </div>

        <div class="aside-filters close-outside">
            <aside>
                <div class="aside-holder section-gray section-radius">
                    <div class="aside-header">
                        <button class="toggle-filters toggle-data-target"  data-target="aside-filters"><i class="iconoir-xmark"></i></button>
                        <span>{% trans %}Filters{% endtrans %}</span>
                        <a href="{{ path('integrated_user_user_index') }}" class="clear-filters"><span>{% trans %}Remove active filters{% endtrans %}</span>
                            <i class="iconoir-xmark"></i>
                        </a>
                    </div>
                    {{ form_start(facetFilter) }}
                    <div class="aside-item-holder">
                        <div class="input-group input-group-search">
                            {{ form_widget(facetFilter.q) }}
                            <span class="input-group-btn">
                                <button type="submit" class="">
                                    <i class="iconoir-search"></i>
                                </button>
                            </span>
                        </div>
                    </div>

                    {% block user_filter_groups %}
                    <div class="aside-item-holder {% if facetFilter.groups|length == 0 %} hidden{% endif %}">
                        {{ form_row(facetFilter.groups, {'style':'sidebar', 'icon': 'download', 'state': 'show'}) }}
                    </div>
                    {% endblock %}

                    {% block user_filter_roles %}
                    <div class="aside-item-holder {% if facetFilter.roles|length == 0 %} hidden{% endif %}">
                        {{ form_row(facetFilter.roles, {'style':'sidebar', 'icon': 'user', 'state': 'show'}) }}
                    </div>
                    {% endblock %}

                    {% block user_filter_scope %}
                    <div class="aside-item-holder {% if facetFilter.scope|length == 0 %} hidden{% endif %}">
                        {{ form_row(facetFilter.scope, {'style':'sidebar', 'icon':'network-reverse', 'state': 'show'}) }}
                    </div>
                    {% endblock %}

                    {% block user_filter_relation %}
                    <div class="aside-item-holder {% if facetFilter.has_relation|length == 0 %} hidden{% endif %}">
                        {{ form_row(facetFilter.has_relation, {'style':'sidebar', 'icon':'user', 'state': 'show'}) }}
                    </div>
                    {% endblock %}

                    <div class="aside-item-holder">
                    {{ form_rest(facetFilter, {'style':'sidebar', 'state': 'show'}) }}
                    </div>

                    {{ form_end(facetFilter) }}
                </div>
            </aside>
        </div>
    </div>

{% endblock %}

{% block javascript %}
{{ parent() }}
<script type="text/javascript">
    (function () {
        function bindUserFilterAutoSubmit() {
            var form = document.querySelector('form[name="integrated_user_filter"]');
            if (!form || form.dataset.autoSubmitBound === '1') {
                return;
            }

            form.dataset.autoSubmitBound = '1';
            form.addEventListener('change', function () {
                if (typeof form.requestSubmit === 'function') {
                    form.requestSubmit();
                    return;
                }

                form.submit();
            });
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', bindUserFilterAutoSubmit);
        } else {
            bindUserFilterAutoSubmit();
        }

        document.addEventListener('turbo:load', bindUserFilterAutoSubmit);
    })();
</script>
{% endblock %}
