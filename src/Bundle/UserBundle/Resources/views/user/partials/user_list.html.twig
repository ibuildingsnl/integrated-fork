<section class="section-white section-radius">
    <form method="post" action="{{ path('integrated_user_user_bulk') }}">
    <input type="hidden" name="_token" value="{{ csrf_token('user_bulk_action') }}">
    <div id="bulk-actions" class="p-3 flex items-center gap-2">
        <select name="bulk_action" id="bulk_action" class="form-control" style="max-width: 220px;">
            <option value="">{% trans %}Bulk action{% endtrans %}</option>
            {% for actionValue, actionLabel in bulkActions %}
                <option value="{{ actionValue }}">{{ actionLabel|trans }}</option>
            {% endfor %}
        </select>
        <select name="bulk_group" id="bulk_group" class="form-control" style="max-width: 220px;">
            <option value="">{% trans %}Select group{% endtrans %}</option>
            {% for group in allGroups %}
                <option value="{{ group.id }}">{{ group.name }}</option>
            {% endfor %}
        </select>
        <select name="bulk_scope" id="bulk_scope" class="form-control" style="max-width: 220px;">
            <option value="">{% trans %}Select scope{% endtrans %}</option>
            {% for scope in allScopes %}
                <option value="{{ scope.id }}">{{ scope.name }}</option>
            {% endfor %}
        </select>
        <button type="submit" class="btn btn-orange">{% trans %}Apply{% endtrans %}</button>
    </div>

    <table class="table table-hover">

        <colgroup>
            <col style="width: 3em"/>
            <col style="width: 3em"/>
            <col/>
            <col/>
            <col style="width: 5em"/>
        </colgroup>

        <thead>
        <tr>
            <th>
                <input type="checkbox" id="bulk_select_all">
            </th>
            <th>#</th>
            <th>{% trans %}Username{% endtrans %}</th>
            <th>{% trans %}Scope{% endtrans %}</th>
            <th>{% trans %}Date created{% endtrans %}</th>
            <th>{% trans %}Relation{% endtrans %}</th>
        </tr>
        </thead>

        <tbody>

        {% for user in users %}
            <tr class="has-options">
                <td>
                    <input type="checkbox" name="user_ids[]" value="{{ user.id }}" class="bulk-user-checkbox">
                </td>
                <td>
                    {{ user.id }}
                </td>

                {% if user.enabled == false %}
                    <td style="color: lightgrey">
                        <a href="{{ path('integrated_user_user_edit', {'id': user.id}) }}"
                           title="{% trans %}Edit{% endtrans %}">
                            <strong>{{ user.username }}</strong>
                        </a>
                {% else %}
                    <td>
                    <a href="{{ path('integrated_user_user_edit', {'id': user.id}) }}"
                       title="{% trans %}Edit{% endtrans %}">
                        <strong>{{ user.username }}</strong>
                    </a>
                {% endif %}
                <div class="row-options">
                    <a href="{{ path('integrated_user_user_edit', {'id': user.id}) }}"
                       title="{% trans %}Edit{% endtrans %}">{% trans %}Edit{% endtrans %}</a> |
                    <a href="{{ path('integrated_user_user_delete', {'id': user.id}) }}"
                       class="color-red" title="{% trans %}Deactivate{% endtrans %}">{% trans %}Deactivate{% endtrans %}</a>
                    {% if user.googleAuthenticatorEnabled %}
                         | <a href="{{ path('integrated_user_user_delete_authenticator', {'id': user.id}) }}"
                           class="color-red" title="{% trans %}Delete{% endtrans %} {% trans %}two factor authenticator{% endtrans %}">{% trans %}Delete{% endtrans %} {% trans %}two factor authenticator{% endtrans %}</a>
                    {% endif %}
                </div>
                    </td>

                <td>{{ user.scope.name|default('') }}</td>
                <td>{% if user.createdAt|date('Y') > 0 %}{{ user.createdAt|format_date("medium", "none") }}{% endif %}</td>
                <td>{% if user.relation.id|default %}
                        <a href="{{ path('integrated_content_content_edit', {id: user.relation.id}) }}">{{ user.relation.name|default }} {{ user.relation.firstname|default }} {{ user.relation.lastname|default }}</a>
                    {% endif %}
                </td>
            </tr>

        {% else %}
            <tr>
                <td colspan="6">
                    <div class="alert alert-info m-0">
                        {% trans %}No users found for the current filters.{% endtrans %}
                    </div>
                </td>
            </tr>
        {% endfor %}

        </tbody>

    </table>
    </form>

    {{ knp_pagination_render(users, '@KnpPaginator/Pagination/sliding.html.twig') }}

</section>

<script>
    (function bindBulkUserSelection() {
        var selectAll = document.getElementById('bulk_select_all');
        if (!selectAll || selectAll.dataset.boundBulkSelect === 'true') {
            return;
        }

        selectAll.addEventListener('change', function () {
            document.querySelectorAll('.bulk-user-checkbox').forEach(function (checkbox) {
                checkbox.checked = selectAll.checked;
            });
        });

        selectAll.dataset.boundBulkSelect = 'true';
    })();
</script>
