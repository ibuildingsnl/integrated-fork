{% extends '@IntegratedContent/base.html.twig' %}
{% block title %}{% trans %}Delete account{% endtrans %} {% endblock title %}

{% block content %}
    <div class="flex flex-wrap edit-form">
        {% block form_start %}
            {{ form_start(form) }}
        {% endblock %}
        {% block toolbar %}
            {% include '@IntegratedContent/partials/block.toolbar.html.twig' %}
        {% endblock toolbar %}
        <div class="aside-options"></div>
        <div class="editor-wrapper">
            <div class="page-title">
                <h1 class="heading">{% trans %}Delete account{% endtrans %}</h1>
            </div>
            <section class="editor editor-wrapped">
                <p>
                    {% trans with {'%name%':  user.username} %}You are about to permanently delete the account "%name%". This action cannot be undone.{% endtrans %}
                </p>
                {{ form_rest(form, {'style':'horizontal'})}}
            </section>
        </div>
        {% block form_end %}
            {{ form_end(form) }}
        {% endblock %}
    </div>
{% endblock %}
