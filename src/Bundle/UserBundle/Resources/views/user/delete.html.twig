{% extends '@IntegratedContent/base.html.twig' %}
{% block title %}{% trans %}Deactivate User{% endtrans %} {% endblock title %}

{% block content %}
    {% block form_start %}
        {{ form_start(form) }}
    {% endblock %}
    {% set userDeactivateToolbarHtml %}
        {% block toolbar %}
            {% include '@IntegratedContent/partials/block.toolbar.html.twig' %}
        {% endblock toolbar %}
    {% endset %}
    {% set userDeactivateTitleHtml %}
        {{ component('integrated_admin:page_title', {
            title: ('Deactivate'|trans) ~ ' ' ~ ('user'|trans),
        }) }}
    {% endset %}
    {% set userDeactivateContentHtml %}
        <p>
            {% trans with {'%name%':  user.username} %}You are about to deactivate the user "%name%", click the button below to confirm.{% endtrans %}
        </p>
        {{ form_rest(form, {'style':'horizontal'})}}
    {% endset %}
    {{ component('integrated_admin:edit_form_shell', {
        toolbarHtml: userDeactivateToolbarHtml,
        pageTitleHtml: userDeactivateTitleHtml,
        editorContentHtml: userDeactivateContentHtml,
    }) }}
    {% block form_end %}
        {{ form_end(form) }}
    {% endblock %}
{% endblock %}
