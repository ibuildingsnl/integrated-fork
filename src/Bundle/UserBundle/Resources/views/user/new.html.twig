{% extends '@IntegratedContent/base.html.twig' %}

    {% block content %}
        <div class="flex flex-wrap edit-form">
            {% block form_start %}
                {{ form_start(form) }}
            {% endblock %}
            {% block toolbar %}
                {% include '@IntegratedContent/partials/block.toolbar.html.twig' %}
            {% endblock toolbar %}
            <div class="aside-options">
                <aside>
                    <div class="aside-holder">
                        <div class="aside-header">
                            <button class="toggle-filters toggle-options-sidebar" data-target="aside-options" type="button">
                                <i class="iconoir-xmark"></i>
                            </button>
                            <span>{% trans %}User info{% endtrans %}</span>
                        </div>
                        <div class="aside-item-wrapper show">
                            <div class="aside-item-header">
                                <h3 class="aside-item-title">
                                    <i class="iconoir-info-circle"></i>
                                    <span class="aside-item-icon">{% trans %}Tip{% endtrans %}</span>
                                </h3>
                                <i class="iconoir-nav-arrow-up"></i>
                            </div>
                            <div class="aside-item-list">
                                <div class="aside-item-list-container">
                                    <p>{% trans %}You can directly link this user to an existing author via the Author field.{% endtrans %}</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </aside>
            </div>
            <div class="editor-wrapper">
                <div class="page-title">
                    <h1 class="heading">{% trans %}New{% endtrans %} {% trans %}user{% endtrans %}</h1>
                </div>
                <section class="editor editor-wrapped">
                    {{ form_rest(form, {'style':'horizontal', 'state': 'show'})}}
                </section>
            </div>
            {% block form_end %}
                {{ form_end(form) }}
            {% endblock %}
        </div>
    {% endblock %}

    {% block javascript %}
        {{ parent() }}
        {% include '@IntegratedUser/partial/password_toggle_script.html.twig' with {'integrated_password_toggle_form_selector': 'form[name="integrated_user_user_form"]'} %}
    {% endblock javascript %}
