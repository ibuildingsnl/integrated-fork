{% extends '@IntegratedContent/base.html.twig' %}
{% block title %}{% trans %}IP list{% endtrans %} {% endblock title %}
{% block content %}
    <div class="row">
        <div class="index-wrapper-full">
            <div class="page-title">
                <h1 class="heading">{% trans %}IP list{% endtrans %}</h1>
                <ul class="create">
                    <li>
                        <a class="btn btn-create-new" href="{{ path('integrated_user_iplist_new') }}">
                            <span>{% trans %}New{% endtrans %} {% trans %}IP list{% endtrans %}</span>
                            <i class="iconoir-plus"></i>
                        </a>
                    </li>
                </ul>
            </div>
            <section class="section-white section-radius">

                <table class="table table-hover">

                    <colgroup>
                        <col style="width: 3em" />
                        <col style="width: 20em" />
                        <col />
                        <col style="width: 5em" />
                    </colgroup>

                    <thead>
                        <tr>
                            <th>#</th>
                            <th>{% trans %}Ip{% endtrans %}</th>
                            <th>{% trans %}Description{% endtrans %}</th>
                        </tr>
                    </thead>

                    <tbody>

                    {% for list in lists %}

                        <tr class="has-options">
                            <td>{{ list.id }}</td>
                            <td>
                                <strong>
                                    <a href="{{ path('integrated_user_iplist_edit', {'id': list.id}) }}">
                                        {{ list.ip.protocolAppropriateAddress }}
                                    </a>
                                </strong>
                                <div class="row-options">
                                    <a href="{{ path('integrated_user_iplist_edit', {'id': list.id}) }}"
                                       title="{% trans %}Edit{% endtrans %}">
                                        {% trans %}Edit{% endtrans %}
                                    </a> |
                                    <a class="color-red"
                                       href="{{ path('integrated_user_iplist_delete', {'id': list.id}) }}"
                                       title="{% trans %}Remove{% endtrans %}">
                                        {% trans %}Remove{% endtrans %}
                                    </a>
                                </div>
                            </td>
                            <td>{{ list.description }}</td>
                        </tr>

                   {% endfor %}

                    </tbody>

                </table>

                {{ knp_pagination_render(lists, '@KnpPaginator/Pagination/sliding.html.twig') }}

            </section>
        </div>
    </div>
{% endblock %}
