{% extends '@IntegratedContent/base.html.twig' %}
{% block title %}{% trans %}New IP list{% endtrans %} {% endblock title %}
{% block content %}
    {% block form_start %}
        {{ form_start(form) }}
    {% endblock %}
    {% set ipListNewToolbarHtml %}
        {% block toolbar %}
            {% include '@IntegratedContent/partials/block.toolbar.html.twig' %}
        {% endblock toolbar %}
    {% endset %}
    {% set ipListNewTitleHtml %}
        {{ component('integrated_admin:page_title', {
            title: ('New'|trans) ~ ' ' ~ ('IP list'|trans),
        }) }}
    {% endset %}
    {% set ipListNewContentHtml %}
        {{ form_rest(form, {'style':'horizontal', 'state': 'show'})}}
    {% endset %}
    {{ component('integrated_admin:edit_form_shell', {
        toolbarHtml: ipListNewToolbarHtml,
        pageTitleHtml: ipListNewTitleHtml,
        editorContentHtml: ipListNewContentHtml,
    }) }}
    {% block form_end %}
        {{ form_end(form) }}
    {% endblock %}
{% endblock %}
