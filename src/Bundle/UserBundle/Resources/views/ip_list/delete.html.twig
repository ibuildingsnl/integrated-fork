{% extends '@IntegratedContent/base.html.twig' %}
{% block title %}{% trans %}Delete IP list{% endtrans %} {% endblock title %}

{% block content %}
    {% block form_start %}
        {{ form_start(form) }}
    {% endblock %}
    {% set ipDeleteToolbarHtml %}
        {% block toolbar %}
            {% include '@IntegratedContent/partials/block.toolbar.html.twig' %}
        {% endblock toolbar %}
    {% endset %}
    {% set ipDeleteTitleHtml %}
        {{ component('integrated_admin:page_title', {
            title: ('Delete'|trans) ~ ' ' ~ ('IP'|trans),
        }) }}
    {% endset %}
    {% set ipDeleteContentHtml %}
        <p>
            {% trans with {'%ip%':  list.ip.protocolAppropriateAddress} %}You are about to delete the ip "%ip%" from the block list, click the delete button below to confirm the action.{% endtrans %}
        </p>
        {{ form_rest(form, {'style':'horizontal'})}}
    {% endset %}
    {{ component('integrated_admin:edit_form_shell', {
        toolbarHtml: ipDeleteToolbarHtml,
        pageTitleHtml: ipDeleteTitleHtml,
        editorContentHtml: ipDeleteContentHtml,
    }) }}
    {% block form_end %}
        {{ form_end(form) }}
    {% endblock %}
{% endblock %}
