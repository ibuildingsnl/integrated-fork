{% extends '@IntegratedContent/base.html.twig' %}
{% block title %}{% trans %}Edit user scope{% endtrans %} {% endblock title %}
{% block content %}
    {% block form_start %}
        {{ form_start(form) }}
    {% endblock %}
    {% set scopeEditToolbarHtml %}
        {% block toolbar %}
            {% include '@IntegratedContent/partials/block.toolbar.html.twig' %}
        {% endblock toolbar %}
    {% endset %}
    {% set scopeEditTitleHtml %}
        {{ component('integrated_admin:page_title', {
            title: ('Edit'|trans) ~ ' ' ~ ('user scope'|trans),
        }) }}
    {% endset %}
    {% set scopeEditContentHtml %}
        {{ form_rest(form, {'style':'horizontal', 'state': 'show'})}}
    {% endset %}
    {{ component('integrated_admin:edit_form_shell', {
        toolbarHtml: scopeEditToolbarHtml,
        pageTitleHtml: scopeEditTitleHtml,
        editorContentHtml: scopeEditContentHtml,
    }) }}
    {% block form_end %}
        {{ form_end(form) }}
    {% endblock %}
{% endblock %}
