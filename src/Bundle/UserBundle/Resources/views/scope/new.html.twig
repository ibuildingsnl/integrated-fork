{% extends '@IntegratedContent/base.html.twig' %}
{% block title %}{% trans %}New user scope{% endtrans %} {% endblock title %}
{% block content %}
    {% block form_start %}
        {{ form_start(form) }}
    {% endblock %}
    {% set scopeNewToolbarHtml %}
        {% block toolbar %}
            {% include '@IntegratedContent/partials/block.toolbar.html.twig' %}
        {% endblock toolbar %}
    {% endset %}
    {% set scopeNewTitleHtml %}
        {{ component('integrated_admin:page_title', {
            title: ('New'|trans) ~ ' ' ~ ('user Scope'|trans),
        }) }}
    {% endset %}
    {% set scopeNewContentHtml %}
        {{ form_rest(form, {'style':'horizontal', 'state': 'show'})}}
    {% endset %}
    {{ component('integrated_admin:edit_form_shell', {
        toolbarHtml: scopeNewToolbarHtml,
        pageTitleHtml: scopeNewTitleHtml,
        editorContentHtml: scopeNewContentHtml,
    }) }}
    {% block form_end %}
        {{ form_end(form) }}
    {% endblock %}
{% endblock %}
