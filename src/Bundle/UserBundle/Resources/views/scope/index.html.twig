{% extends '@IntegratedContent/base.html.twig' %}
{% block title %}{% trans %}User scopes{% endtrans %} {% endblock title %}
{% block content %}
    <div class="row">
        <div class="index-wrapper-full">
            {% set createActionsHtml %}
                <ul class="create">
                    <li>
                        <a class="btn btn-create-new" href="{{ path('integrated_user_scope_new') }}">
                            <span>{% trans %}New{% endtrans %} {% trans %}user scope{% endtrans %}</span>
                            <i class="iconoir-plus"></i>
                        </a>
                    </li>
                </ul>
            {% endset %}
            {{ component('integrated_admin:page_title', {
                title: 'User scopes'|trans,
                actionsHtml: createActionsHtml,
            }) }}
            {% component 'integrated_admin:section_card' %}
                {% block content %}
                {% set scopeTableColGroupHtml %}
                    <colgroup>
                        <col style="width: 3em"/>
                        <col/>
                    </colgroup>
                {% endset %}
                {% set scopeTableHeadHtml %}
                    <tr>
                        <th>#</th>
                        <th>Name</th>
                    </tr>
                {% endset %}
                {% set scopeTableBodyHtml %}
                    {% for scope in scopes %}
                        <tr class="has-options">
                            <td>{{ scope.id }}</td>
                            <td>
                                <strong>
                                    <a href="{{ path('integrated_user_scope_edit', {'id': scope.id}) }}">
                                        {{ scope.name }}
                                    </a>
                                </strong>
                                {% set scopeRowActionsHtml %}
                                    <a href="{{ path('integrated_user_scope_edit', {'id': scope.id}) }}"
                                       title="{% trans %}Edit{% endtrans %}">{% trans %}Edit{% endtrans %}</a> |
                                    <a href="{{ path('integrated_user_scope_delete', {'id': scope.id}) }}"
                                       class="color-red" title="{% trans %}Delete{% endtrans %}">{% trans %}Delete{% endtrans %}</a>
                                {% endset %}
                                {{ component('integrated_admin:row_actions', {
                                    contentHtml: scopeRowActionsHtml,
                                }) }}
                            </td>
                        </tr>
                    {% endfor %}
                {% endset %}
                {{ component('integrated_admin:data_table', {
                    colGroupHtml: scopeTableColGroupHtml,
                    headHtml: scopeTableHeadHtml,
                    bodyHtml: scopeTableBodyHtml,
                    colSpan: 2,
                }) }}

                {{ component('integrated_admin:pagination_footer', {
                    pagination: scopes,
                }) }}
                {% endblock %}
            {% endcomponent %}
        </div>
    </div>
{% endblock %}
