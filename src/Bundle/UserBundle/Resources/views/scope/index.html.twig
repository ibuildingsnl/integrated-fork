{% extends '@IntegratedContent/base.html.twig' %}
{% block title %}{% trans %}User scopes{% endtrans %} {% endblock title %}
{% block content %}
    <div class="row">
        <div class="w-full mb-4 md:mb-0">
            <div class="page-title">
                <h1 class="heading">{% trans %}User scopes{% endtrans %}</h1>
                <ul class="create">
                    <li>
                        <a class="btn btn-create-new" href="{{ path('integrated_user_scope_new') }}">
                            <span>{% trans %}New{% endtrans %} {% trans %}user scope{% endtrans %}</span>
                            <i class="fa-regular fa-plus"></i>
                        </a>
                    </li>
                </ul>
            </div>
            {#            <ul class="list-inline"> #}
            {#                <li class="dropdown"> #}
            {#                    <a href="#" data-toggle="dropdown" role="button" id="drop_1">Options <b class="caret"></b></a> #}
            {#                    <ul aria-labelledby="drop_1" role="menu" class="dropdown-menu" id="menu_1"> #}
            {#                        <li role="presentation"><a href="{{ path('integrated_user_scope_new') }}" tabindex="-1" role="menuitem">New</a></li> #}
            {#                    </ul> #}
            {#                </li> #}
            {#            </ul> #}
            <section class="section-white section-radius">

                <table class="table table-hover">

                    <colgroup>
                        <col style="width: 3em"/>
                        <col/>
                        <col style="width: 5em"/>
                    </colgroup>

                    <thead>
                    <tr>
                        <th>#</th>
                        <th>Name</th>
                        <th>Actions</th>
                    </tr>
                    </thead>

                    <tbody>

                    {% for scope in scopes %}

                        <tr>
                            <td>{{ scope.id }}</td>
                            <td>{{ scope.name }}</td>
                            <td>
                                <a href="{{ path('integrated_user_scope_edit', {'id': scope.id}) }}"
                                   title="{% trans %}Edit{% endtrans %}"><span class="glyphicon glyphicon-edit"></span></a>
                                {% if not scope.admin %}
                                    <a href="{{ path('integrated_user_scope_delete', {'id': scope.id}) }}"
                                       title="{% trans %}Delete{% endtrans %}"><span
                                            class="glyphicon glyphicon-remove-circle"></span></a>
                                {% endif %}
                            </td>
                        </tr>

                    {% endfor %}

                    </tbody>

                </table>

                {{ knp_pagination_render(scopes) }}

            </section>
        </div>
    </div>
{% endblock %}
