<!DOCTYPE html>
<html>
<head>

    <title>{% block title %}{% trans %}Integrated{% endtrans %}{% endblock title %}</title>

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

{% block style %}
    <link rel="stylesheet" href="{{ asset('bundles/integratedintegrated/iconoir.css') }}">
    <link rel="stylesheet" href="{{ asset('bundles/integratedintegrated/app.css') }}">
{% endblock style %}

</head>
<body>
{% block form_theme %}
    {% if form is defined %}
        {% form_theme form with '@IntegratedFormType/form/form_div_layout.html.twig' %}
    {% endif %}
{% endblock %}

    <div class="container">
        {% block flash %}
            {% for label, messages in app.flashes(['alert', 'danger', 'info', 'success', 'warning', 'error']) %}
                {% for message in messages %}
                    {% if label == 'alert' %}
                        {% set label = 'warning' %}
                    {% elseif label == 'error' %}
                        {% set label = 'danger' %}
                    {% endif %}
                    {{ component('integrated_admin:alert_box', {
                        variant: label,
                        dismissible: true,
                        bodyHtml: message|trans,
                    }) }}
                {% endfor %}
            {% endfor %}
        {% endblock flash %}
        {% block body %}{% endblock body %}
    </div>

{% block javascript %}
    <script src="//code.jquery.com/jquery.js" defer data-turbo-track="reload"></script>
{% endblock javascript %}

</body>
</html>
