<?xml version="1.0" encoding="UTF-8" ?>

<routes xmlns="http://symfony.com/schema/routing"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://symfony.com/schema/routing http://symfony.com/schema/routing/routing-1.0.xsd">

    <route id="integrated_user_website_registration_register" path="/">
        <default key="_controller">Integrated\Bundle\UserBundle\Controller\Website\RegistrationController::register</default>
    </route>

    <route id="integrated_user_website_registration_activate" path="/activate/{id}/{timestamp}/{key}">
        <default key="_controller">Integrated\Bundle\UserBundle\Controller\Website\RegistrationController::activate</default>
    </route>

</routes>
