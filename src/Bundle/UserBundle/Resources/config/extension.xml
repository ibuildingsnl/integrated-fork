<?xml version="1.0" encoding="UTF-8" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>

        <defaults autowire="true" autoconfigure="true"/>

        <service id="integrated_user.extension" class="Integrated\Bundle\UserBundle\Extension\UserExtension">
            <argument type="service" id="service_container"/>
            <tag name="integrated_content.extension"/>
        </service>

        <service id="integrated_user.extension.user_relation" class="Integrated\Bundle\UserBundle\Doctrine\Subscriber\OrmRelationSubscriber">
            <argument type="service" id="doctrine_mongodb" on-invalid="ignore"/>
            <tag name="doctrine.event_listener" event="postLoad" connection="default" />
        </service>

    </services>

</container>
