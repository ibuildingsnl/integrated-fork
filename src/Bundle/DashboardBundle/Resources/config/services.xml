<?xml version="1.0" encoding="UTF-8" ?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services
        http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <service id="Integrated\Bundle\DashboardBundle\Controller\DashboardController">
            <argument key="$channelContext" type="service" id="channel.context"/>
            <argument key="$manager" type="service" id="doctrine_mongodb.odm.document_manager" />
            <argument key="$channelRepository" type="service" id="integrated_channel.repository.channel" />
            <argument key="$brandRepository" type="service" id="integrated_brand.brand.repository" />
            <argument key="$allWidgets" type="tagged_iterator" tag="integrated_dashboard.widget"/>
            <tag name="container.service_subscriber" />
            <tag name="controller.service_arguments" />
            <call method="setContainer">
                <argument type="service" id="service_container" />
            </call>
        </service>
        <service id="Integrated\Bundle\DashboardBundle\Command\WidgetDatabaseCommand">
            <argument key="$manager" type="service" id="doctrine_mongodb.odm.document_manager" />
            <argument key="$allWidgets" type="tagged_iterator" tag="integrated_dashboard.widget"/>
            <tag name="console.command" />
        </service>
        <service id="Integrated\Bundle\DashboardBundle\Widgets\LatestArticleWidget">
            <argument key="$manager" type="service" id="doctrine_mongodb.odm.document_manager" />
            <argument key="$limit" type="expression">5</argument>
            <tag name="integrated_dashboard.widget" />
        </service>
        <service id="Integrated\Bundle\DashboardBundle\Widgets\SitePerformancesWidget">
            <argument key="$manager" type="service" id="doctrine_mongodb.odm.document_manager" />
            <tag name="integrated_dashboard.widget" />
        </service>
        <service id="Integrated\Bundle\DashboardBundle\Widgets\MostReadWidget">
            <argument key="$manager" type="service" id="doctrine_mongodb.odm.document_manager" />
            <argument key="$limit" type="expression">6</argument>
            <tag name="integrated_dashboard.widget" />
        </service>
        <service id="Integrated\Bundle\DashboardBundle\Widgets\VisitorsActivityWidget">
            <argument key="$manager" type="service" id="doctrine_mongodb.odm.document_manager" />
            <tag name="integrated_dashboard.widget" />
        </service>
        <service id="Integrated\Bundle\DashboardBundle\Widgets\GeographicActivityWidget">
            <argument key="$manager" type="service" id="doctrine_mongodb.odm.document_manager" />
            <tag name="integrated_dashboard.widget" />
        </service>
        <service id="Integrated\Bundle\DashboardBundle\Widgets\DeviceTypeWidget">
            <argument key="$manager" type="service" id="doctrine_mongodb.odm.document_manager" />
            <tag name="integrated_dashboard.widget" />
        </service>
        <service id="Integrated\Bundle\DashboardBundle\Widgets\TrafficAcquisitionWidget">
            <argument key="$manager" type="service" id="doctrine_mongodb.odm.document_manager" />
        </service>
        <service id="Integrated\Bundle\DashboardBundle\Widgets\TrafficAcquisitionWidget">
            <argument key="$manager" type="service" id="doctrine_mongodb.odm.document_manager" />
            <tag name="integrated_dashboard.widget" />
        </service>
        <service id="Integrated\Bundle\DashboardBundle\Widgets\AssignedToYouWidget">
            <argument key="$manager" type="service" id="doctrine_mongodb.odm.document_manager" />
            <argument key="$solariumClient" type="service" id="solarium.client" />
            <argument key="$urlGenerator" type="service" id="router" />
            <tag name="integrated_dashboard.widget" />
        </service>
    </services>
</container>
