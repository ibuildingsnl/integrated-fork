<?xml version="1.0" encoding="UTF-8" ?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services
        http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <service id="Integrated\Bundle\DashboardBundle\Controller\DashboardController">
            <argument type="service" id="channel.context"/>
            <argument type="service" id="doctrine_mongodb.odm.document_manager" />
            <argument type="tagged_iterator" tag="integrated_dashboard.widget"/>

            <tag name="container.service_subscriber" />
            <tag name="controller.service_arguments" />

            <call method="setContainer">
                <argument type="service" id="service_container" />
            </call>
        </service>
        <service id="Integrated\Bundle\DashboardBundle\Widgets\LatestArticleWidget">
            <argument type="service" id="doctrine_mongodb.odm.document_manager" />
            <argument type="expression">15</argument>
            <tag name="integrated_dashboard.widget" />
        </service>
        <service id="Integrated\Bundle\DashboardBundle\Widgets\SitePerformancesWidget">
            <argument type="service" id="doctrine_mongodb.odm.document_manager" />
            <tag name="integrated_dashboard.widget" />
        </service>
        <service id="Integrated\Bundle\DashboardBundle\Widgets\MostReadWidget">
            <argument>%env(resolve:GOOGLE_APPLICATION_CREDENTIALS)%</argument>
            <argument type="service" id="monolog.logger"/>
            <argument type="service" id="doctrine_mongodb.odm.document_manager" />
            <argument type="service" id="integrated_brand.brand.repository" />
            <tag name="integrated_dashboard.widget" />
        </service>
        <service id="Integrated\Bundle\DashboardBundle\Widgets\VisitorsActivityWidget">
            <argument>%env(resolve:GOOGLE_APPLICATION_CREDENTIALS)%</argument>
            <argument type="service" id="monolog.logger"/>
            <argument type="service" id="doctrine_mongodb.odm.document_manager" />
            <argument type="service" id="integrated_brand.brand.repository" />
            <tag name="integrated_dashboard.widget" />
        </service>
    </services>
</container>
