{% extends '@IntegratedContent/base.html.twig' %}
{% block title %} Dashboard Analytics {% endblock title %}

{% block content %}
        <div class="dashboard-container">
            <div class="articles">
                <h1>Dashboard Analytics {{ channelName }} <br> Articles (total: {{ nbrOfArticles }})</h1>
                <nav>
                    <ul>
                        {% for article in mostRecentArticles %}
                            <li>{{ article.title }} | {{ article.publishTime.startDate | date("d/m/Y") }}</li>
                        {% endfor %}
                    </ul>
                </nav>
            </div>
            <div class="channels">

                <h2>Select Channel</h2>
                {{ form_start(channelForm, {'method': 'GET', 'action': path('integrated_dashboard_index'), 'attr': {'id': 'channelSelect'}}) }}
                {{ form_widget(channelForm) }}
                <button id="submitButton" style="display: none;" type="submit">Submit</button>
                {{ form_end(channelForm) }}
            </div>
            <div class="analytics">

            </div>
        </div>
    <script>
        var channelSelect = document.getElementById("channelSelect");
        var submitButton = document.getElementById("submitButton");
        channelSelect.addEventListener("change", function()
        {
            document.getElementById('submitButton').click()
        });

    </script>
    <style>
        .dashboard-container {
            display: flex;
            align-items: flex-start;
        }

        .articles {
            flex: 1;
            padding: 10px;
            overflow-y: visible;
        }

        .channels {
            flex: 1;
            padding: 10px;
        }

        .analytics {
            flex: 1;
            padding: 10px;
        }
    </style>
{% endblock content %}
