{% extends '@IntegratedContent/base.html.twig' %}
{% block title %} Dashboard Analytics {% endblock title %}

{% block content %}
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <div class="dashboard-container">
        <div class="page-title w-full">
            <div class="heading flex justify-between w-full">
                <div class="heading-switcher">
                    <h1 class="heading">{% block heading %}{% trans %}Dashboard{% endtrans %}{% endblock heading %}</h1>
                </div>
            </div>

            <div class="options">
                <ul class="content-navigator-menu">
                    <li>
                        <select id="integrated_brand_choice" name="integrated_brand_choice"
                                class="dashboardForm-select dashboardForm-event">
                            {% for brand in allBrands %}
                                <option value="{{ brand.id }}">{{ brand.name }}</option>
                            {% endfor %}
                        </select>
                    </li>
                    <li class="dropdown close-outside" data-underlay="no">
                        <a data-toggle="dropdown" role="button" id="sorting-list"
                           class="btn btn-select space-between"><span>{% trans %}Widgets{% endtrans %}</span>
                            <i class="iconoir-nav-arrow-down"></i>
                        </a>
                        <ul class="dropdown-menu filters_list widget_choice">
                            {% for widget in widgetAllData %}
                                <li class="checkbox">
                                    <label class="checkbox-container">
                                        <input type="checkbox" name="{{ widget.id }}" value="{{ widget.id }}"
                                               checked>
                                        <span class="checkmark"></span>
                                        <div class="facet-wrapper">
                                            <span class="facet-title">{{ widget.name }}</span>
                                        </div>
                                    </label>
                                </li>
                            {% endfor %}
                        </ul>
                    </li>
                    <li>
                        <select id="select_date_range" name="select_date_range"
                                class="dashboardForm-select">
                            <option value="weekly">{% trans %}This week{% endtrans %}</option>
                            <option value="monthly">{% trans %}This month{% endtrans %}</option>
                            <option value="quarterly">{% trans %}This quarter{% endtrans %}</option>
                            <option value="semester">{% trans %}This semester{% endtrans %}</option>
                            <option value="yearly">{% trans %}This Year{% endtrans %}</option>
                        </select>
                    <li>
                </ul>
            </div>
        </div>

        <div class="widgets-wrapper">
            {% for widget in widgetAllData %}
                {{ widget.renderedView | raw }}
            {% endfor %}
        </div>
        <style>
            .checkbox-container.disabled-widget {
                color: #999;
                cursor: not-allowed;
            }
        </style>
        <script>
            const allWidgetJS = {{ widgetAllData | json_encode | raw }};

            function disableNonExistentWidgets() {
                const checkboxes = document.querySelectorAll('.widget_choice input[type="checkbox"]');

                checkboxes.forEach(function (checkbox) {
                    const widgetId = checkbox.name;
                    const widgetContainer = document.querySelector(`.${widgetId}`);

                    if (!widgetContainer) {
                        checkbox.checked = false;
                        checkbox.disabled = true;
                        checkbox.parentNode.classList.add('disabled-widget'); // Ajoute une classe pour styliser en tant que widget désactivé
                    } else {
                        checkbox.disabled = false;
                        checkbox.parentNode.classList.remove('disabled-widget'); // Assurez-vous que la classe est retirée si le widget est dans la liste
                    }
                });
            }

            disableNonExistentWidgets();
            var selectDateRange = document.getElementById('select_date_range');
            const checkboxes = document.querySelectorAll('.widget_choice input[type="checkbox"]');
            selectElements = document.querySelectorAll('.dashboardForm-select');
            SelectEventListener = document.querySelectorAll('.dashboardForm-event');
            SelectEventListener.forEach(function (selectElement) {
                selectElement.addEventListener('change', function () {
                    submitForm();
                });
            });

            checkboxes.forEach(function (checkbox) {
                checkbox.addEventListener('change', function () {
                    const widgetId = this.name;
                    const widgetContainer = document.querySelector(`.${widgetId}`).parentNode;
                    if (this.checked) {
                        widgetContainer.style.display = '';
                    } else {
                        widgetContainer.style.display = 'none';
                    }
                });
            });

            function submitForm() {
                const form = Object.assign(document.createElement('form'), {method: 'get'});

                selectElements.forEach(function (selectElement) {
                    const selectName = selectElement.name;
                    for (const option of selectElement.selectedOptions) {
                        const input = document.createElement('input');
                        input.type = 'hidden';
                        input.name = selectName;
                        input.value = option.value;
                        form.appendChild(input);
                    }
                });

                document.body.appendChild(form);
                form.submit();
            }

            function restoreSelectValues() {
                selectElements.forEach(function (selectElement) {
                    const selectName = selectElement.name;
                    const urlParams = new URLSearchParams(window.location.search);
                    var paramValues = urlParams.getAll(selectName);
                    if (selectName == 'integrated_channel_choice' && paramValues == "") {
                        paramValues = ['{{ channelId }}'];
                    }
                    Array.from(selectElement.options).forEach(function (option) {
                        if (paramValues.includes(option.value)) {
                            option.selected = true;
                        }
                    });
                });
            }
            restoreSelectValues();
        </script>
    </div>
{% endblock content %}
