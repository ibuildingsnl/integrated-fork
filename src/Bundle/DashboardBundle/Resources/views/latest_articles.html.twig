<div class="{{ widget.id }}">
    <button class="close-button" data-widget-id="{{ widget.id }}">Close X</button>
    <h2><br> Latest Articles (total: {{ mostRecentArticles | length }})</h2>
    <nav class="article-list">
        <ul>
            {% for article in mostRecentArticles %}
                <li><b>{{ article.title }}</b> | {{ article.publishTime.startDate | date("d/m/Y") }}</li>
                ________________________________
            {% endfor %}
        </ul>
    </nav>
</div>

<style>
    .article-list {
        max-height: 300px;
        overflow-y: auto;
    }
</style>


