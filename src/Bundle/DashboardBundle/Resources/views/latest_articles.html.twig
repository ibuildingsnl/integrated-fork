{% if mostRecentArticles is not null %}
<div class="widget col-left w-full">
    <div class="widget-container {{ widget.id }}">
        <div class="widget-header">
            <h2>{% trans %}Latest Articles{% endtrans %}</h2>
        </div>
            <nav class="article-list">
                <ul>
                    {% for article in mostRecentArticles %}
                        <li>
                            <a class="flex flex-1 items-center w-full" target="_blank" href="{{ path('integrated_content_content_edit', {id: article.id}) }}">{{ article.title }}</a>
                            <span class="post-date tab">{{ article.publishTime.startDate | date("d-m-Y") }}</span>
                        </li>
                    {% endfor %}
                </ul>
            </nav>
    </div>
</div>
{% endif %}
