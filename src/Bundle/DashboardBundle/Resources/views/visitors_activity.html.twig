<div class="{{ widget.id }}">
    <button class="close-button" data-widget-id="{{ widget.id }}">Close X</button>
    {% if (userCountsByDate is not iterable) %}
        <h2><br> {{ userCountsByDate }} </h2>
    {% else %}
        <h2><br> Visitors activity
            <select id="visitors_activity_date_range" name="visitors_activity_date_range" class="dashboardForm-select">
                <option value="7daysAgo">This week</option>
                <option value="30daysAgo">This month</option>
                <option value="6monthsAgo">This semester</option>
                <option value="365daysAgo">This Year</option>
            </select>

        </h2>
    {% endif %}
    <div>
        <canvas id="line-chart" width="80" height="45"></canvas>
    </div>
</div>

<script>



    var userCountsByDateJS = [];
    {% for row in userCountsByDate %}
    var date = '{{ row.date }}';
    // Extrayez l'année, le mois et le jour de la date
    var year = date.substr(0, 4);
    var month = date.substr(4, 2);
    var day = date.substr(6, 2);
    // Formatez la date comme "DD/MM/YY"
    var formattedDate = day + '/' + month + '/' + year.substr(2, 2);

    userCountsByDateJS.push({
        date: formattedDate,
        userCount: parseInt('{{ row.userCount }}', 10)
    });
    {% endfor %}

    // Récupérez les éléments nécessaires
    var selectVisitorActivityDate = document.getElementById("visitors_activity_date_range");
    var ctx = document.getElementById("line-chart").getContext('2d');
    var chart; // Pour stocker l'objet Chart

    // Fonction pour mettre à jour le graphe en fonction de la sélection
    function updateChart(selectedValue) {
        var dates = [];
        var userCounts = [];
        var dateformat;
        //console.log(userCountsByDateJS);
        // Remplissez les données en fonction de la sélection ici
        switch (selectedValue) {
            case "7daysAgo":
                // Affiche simplement les données des 7 derniers jours
                dateformat = 'DD/MM/YYYY'
                var last7DaysData = userCountsByDateJS.slice(0, 7); // Sélectionne les 7 derniers éléments
                last7DaysData.forEach(function (data) {
                    dates.push(data.date);
                    userCounts.push(data.userCount);
                });
                break;
            case "30daysAgo":
                // Affiche simplement les données des 30 derniers jours
                dateformat = 'DD/MM/YYYY'
                var last30DaysData = userCountsByDateJS.slice(0, 30);
                last30DaysData.forEach(function (data) {
                    dates.push(data.date);
                    userCounts.push(data.userCount);
                });
                console;
                console.log(last30DaysData);
                break;
            case "6monthsAgo":
                dateformat = 'MM/YYYY'
                var monthlyAggregatedData = aggregateDataByMonth(userCountsByDateJS, 6);
                monthlyAggregatedData.forEach(function (data) {
                    dates.push(data.date);
                    userCounts.push(data.userCount);
                });
                break;
            case "365daysAgo":
                dateformat = 'MM/YYYY'
                var monthlyAggregatedData = aggregateDataByMonth(userCountsByDateJS, 12);
                monthlyAggregatedData.forEach(function (data) {
                    dates.push(data.date);
                    userCounts.push(data.userCount);
                });
                break;

            default:
                break;
        }
        if (chart) {
            chart.destroy();
        }

        chart = new Chart(ctx, {
            type: 'line',
            data: {
                labels: dates,
                datasets: [{
                    data: userCounts,
                    label: "Number of Visitors",
                    borderColor: "#c45850",
                    fill: false
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: true,
                scales: {
                    x: [{
                        type: 'time',
                        time: {
                            parser: dateformat,
                            tooltipFormat: dateformat,
                        },
                        scaleLabel: {
                            display: true,
                            labelString: 'Date'
                        }
                    }],
                    y: [{
                        ticks: {
                            beginAtZero: true
                        },
                        scaleLabel: {
                            display: true,
                            labelString: 'Number of Visitors'
                        }
                    }]
                },
                title: {
                    display: true,
                    text: 'Visitors Activity'
                }
            }
        });
    }


    // Fonction pour agréger les données par mois sur une période donnée (en nombre de mois)
    function aggregateDataByMonth(data, numMonths) {
        const aggregatedData = {};

        const parsedData = data.map(function (item) {
            const dateParts = item.date.split('/'); // Sépare la date en parties (jour, mois, année)
            return {
                date: item.date,
                userCount: parseInt(item.userCount, 10),
            };
        });

        for (let i = 0; i < parsedData.length; i++) {
            const currentDate = parsedData[i].date;
            const currentMonth = currentDate.substr(3, 7); // Extrait le mois et l'année (MM/YYYY)
            const userCount = parsedData[i].userCount;

            if (!aggregatedData[currentMonth]) {
                aggregatedData[currentMonth] = 0;
            }
            aggregatedData[currentMonth] += userCount;
        }

        result = (Object.keys(aggregatedData).map(function (month) {
            return {
                date: month,
                userCount: aggregatedData[month],
            };
        })).reverse();

        if (numMonths && numMonths < result.length) {
            result.splice(0, result.length - numMonths);
        }

        return result;
    }

    // Ajoutez un gestionnaire d'événements pour le changement de sélection
    selectVisitorActivityDate.addEventListener('change', function () {
        var selectedValue = selectVisitorActivityDate.value;
        updateChart(selectedValue);
    });

    function chartFirstLoad()
    {
        const selectName = selectVisitorActivityDate.name;
        const urlParams = new URLSearchParams(window.location.search);
        const paramValues = urlParams.get(selectName);
        var initialSelectedValue = paramValues ?? selectVisitorActivityDate.value;
        updateChart(initialSelectedValue);
    }

    chartFirstLoad()
</script>

<style>
    .table-container {
        max-width: 300px;
        overflow-x: hidden; /* Masquer le défilement horizontal si le contenu est trop large */
        overflow-y: auto; /* Activer le défilement vertical si le contenu dépasse la hauteur */
    }
</style>
