{% if userActivityByDate is not null %}
<div class="widget col-middle w-full">
    <div class="widget-container {{ widget.id }}">
        <div class="widget-header">
            {% if (userActivityByDate is not iterable) %}
                <h2>{{ userActivityByDate }}</h2>
            {% else %}
                <h2>{% trans %}Visitors activity{% endtrans %}</h2>
            {% endif %}
        </div>
        <div class="widget-content">
            <div class="flex flex-wrap -mx-2 pb-4">
                <div class="w-1/3 px-2 user-count VA-graphic-button-change toggle-active active" onclick="changeTypeOfGraph('userCount', this)">
                    <div class="content">
                        <h3>{% trans %}Visitors{% endtrans %}</h3>
                        <div id="visitor-count"></div>
                    </div>
                </div>
                <div class="w-1/3 px-2 user-count VA-graphic-button-change toggle-active" onclick="changeTypeOfGraph('bounceRate', this)">
                    <div class="content">
                        <h3>{% trans %}Bounce Ratio{% endtrans %}</h3>
                        <div id="bounceRate-count">47.39%</div>
                    </div>
                </div>
                <div class="w-1/3 px-2 user-count VA-graphic-button-change toggle-active" onclick="changeTypeOfGraph('screenPageViews', this)">
                    <div class="content">
                        <h3>{% trans %}Page views{% endtrans %}</h3>
                        <div id="pageViews-count">18439</div>
                    </div>
                </div>
            </div>
            <canvas id="Visitor_Activity-line-chart"></canvas>
        </div>
    </div>
    <script>
        var typeOfGraph ="userCount"
        var visitorActivityChart;

        const visitorCountElement = document.getElementById('visitor-count');
        const pageViewCountElement = document.getElementById('pageViews-count');
        const bouncerateCountElement = document.getElementById('bounceRate-count');
        const selectVisitorActivityDate = document.getElementById('select_date_range');

        selectVisitorActivityDate.addEventListener('change', function () {
            updateVisitorActivityChart(selectVisitorActivityDate.value);
        });

        function updateVisitorActivityChart(selectedValue) {
            const allData = [
                {% for row in userActivityByDate %}
                formatDataCountData('{{ row.date }}', '{{ row.userCount }}', '{{ row.screenPageViews }}', '{{ row.bounceRate }}'),
                {% endfor %}
            ];

            updateTotalCount(allData, selectedValue);
            const userActivityByDateJS = mapDataBasedOnGraphType(allData, typeOfGraph);

            const { dates, dataCounts, dateformat } = prepareChartData(userActivityByDateJS, selectedValue);

            if (visitorActivityChart) {
                visitorActivityChart.destroy();
            }

            visitorActivityChart = new Chart(document.getElementById('Visitor_Activity-line-chart'), configureChart(dates, dataCounts, dateformat));
        }

        function mapDataBasedOnGraphType(data, graphType) {
            const typeMap = {
                bounceRate: 'bounceRate',
                screenPageViews: 'screenPageViews',
                userCount: 'userCount'
            };
            return data.map(entry => ({
                date: entry.date,
                dataCount: entry[typeMap[graphType] || 'userCount']
            }));
        }

        function prepareChartData(data, rangeType) {
            let dateformat;
            let processedData = [];

            console.log(data);

            switch (rangeType) {
                case 'weekly':
                case 'monthly':
                    const range = rangeType === 'weekly' ? 7 : 30
                    dateformat = 'DD/MM/YYYY';
                    processedData = data.slice(0, range).reverse();
                    break;
                case 'quarterly':
                    dateformat = 'DD/MM/YYYY';
                    processedData = aggregateDataByWeek(data, 13);
                    break;
                case 'semester':
                case 'yearly':
                    dateformat = 'MM/YYYY';
                    const numMonths = rangeType === 'semester' ? 6 : 12;
                    processedData = aggregateDataByMonth(data, numMonths);
                    break;
                default:
                    return { dates: [], dataCounts: [], dateformat: 'DD/MM/YYYY' };
            }

            return {
                dates: processedData.map(item => item.date),
                dataCounts: processedData.map(item => item.dataCount),
                dateformat
            };
        }

        function configureChart(labels, data, dateFormat) {
            return {
                type: 'line',
                data: {
                    labels,
                    datasets: [datasetByGraph(data)],
                },
                options: getChartOptions(dateFormat)
            };
        }

        function getChartOptions(dateFormat) {
            return {
                plugins: {
                    customCanvasBackgroundColor: { color: 'white' },
                },
                responsive: true,
                maintainAspectRatio: true,
                scales: {
                    x: [{
                        grid: { display: false },
                        type: 'time',
                        time: { parser: dateFormat, tooltipFormat: dateFormat },
                        scaleLabel: { display: true, labelString: '{% trans %}Date{% endtrans %}' },
                    }],
                    y: [{
                        grid: { display: false },
                        ticks: { beginAtZero: false },
                        scaleLabel: { display: true, labelString: '{% trans %}Visitors{% endtrans %}' },
                    }],
                },
                title: {
                    display: true,
                    text: '{% trans %}Visitors Activity{% endtrans %}',
                },
            };
        }

        function formatDataCountData(date, userCount, screenPageViews, bounceRate) {
            var year = date.substr(0, 4);
            var month = date.substr(4, 2);
            var day = date.substr(6, 2);
            var formattedDate = day + '/' + month + '/' + year.substr(2, 2);

            return {
                date: formattedDate,
                userCount: parseInt(userCount, 10),
                screenPageViews: parseInt(screenPageViews, 10),
                bounceRate: parseInt(bounceRate, 10),
            };
        }

        function aggregateDataByWeek(data, numWeeks, typeOfGraph) {
            const aggregatedData = {};
            const daysInWeek = {};
            const parsedData = data.map(function (item) {
                return {
                    date: item.date,
                    dataCount: parseInt(item.dataCount, 10),
                };
            });
            for (let i = 0; i < parsedData.length; i += 7) {
                const pack = parsedData.slice(i, i + 7);
                const startWeekDate = pack[pack.length - 1].date;
                const cumulDataCount = pack.reduce((total, year) => total + year.dataCount, 0);
                aggregatedData[startWeekDate] = cumulDataCount ;
            }
            if (typeOfGraph === "bounceRate") {
                for (const week in aggregatedData) {
                    aggregatedData[week] = (aggregatedData[week] / daysInWeek[week]).toFixed(2);
                }
            }
            const result = Object.keys(aggregatedData).map(function (week) {
                return {
                    date: week,
                    dataCount: aggregatedData[week],
                };
            }).reverse();

            if (numWeeks && numWeeks < result.length) {
                result.splice(0, result.length - numWeeks);
            }
            return result;
        }


        function aggregateDataByMonth(data, numMonths) {
            const aggregatedData = {};
            const daysInMonth = {};
            const parsedData = data.map(function (item) {
                return {
                    date: item.date,
                    dataCount: parseInt(item.dataCount, 10),
                };
            });
            for (let i = 0; i < parsedData.length; i++) {
                const currentDate = parsedData[i].date;
                const currentMonth = currentDate.substr(3, 7);
                const dataCount = parsedData[i].dataCount;
                if (!aggregatedData[currentMonth]) {
                    aggregatedData[currentMonth] = 0;
                    daysInMonth[currentMonth] = 0;
                }
                aggregatedData[currentMonth] += dataCount;
                daysInMonth[currentMonth]++;
            }

            if (typeOfGraph == "bounceRate")
            {
                for (const month in aggregatedData)
                {
                    aggregatedData[month] = (aggregatedData[month]/daysInMonth[month]).toFixed(2);
                }
            }
            result = (Object.keys(aggregatedData).map(function (month) {
                return {
                    date: month,
                    dataCount: aggregatedData[month],
                };
            })).reverse();

            if (numMonths && numMonths < result.length) {
                result.splice(0, result.length - numMonths);
            }

            return result;
        }

        function datasetByGraph(dataCounts) {
            if (typeOfGraph == "bounceRate") {
                return {
                    data: dataCounts,
                    label: '{% trans %}Bounce Ratio{% endtrans %}',
                    borderColor: '#00ae93',
                    backgroundColor: 'rgba(0, 174, 147, 0.3)',
                    fill: true,
                    tension: 0.1,
                    rotation: 90,
                }
            } else if (typeOfGraph == "screenPageViews") {
                return {
                    data: dataCounts,
                    label: '{% trans %}Page views{% endtrans %}',
                    borderColor: '#00ae93',
                    backgroundColor: 'rgba(0, 174, 147, 0.3)',
                    fill: true,
                    tension: 0.1,
                    rotation: 90,
                }
            } else {
                return {
                    data: dataCounts,
                    label: '{% trans %}Visitors{% endtrans %}',
                    borderColor: '#00ae93',
                    backgroundColor: 'rgba(0, 174, 147, 0.3)',
                    fill: true,
                    tension: 0.1,
                    rotation: 90,
                }
            }
        }

        function visitorActivityChartFirstLoad() {
            const selectName = selectVisitorActivityDate.name;
            const urlParams = new URLSearchParams(window.location.search);
            const paramValues = urlParams.get(selectName);
            var initialSelectedValue = paramValues ?? selectVisitorActivityDate.value;
            updateVisitorActivityChart(initialSelectedValue);
        }

        function changeTypeOfGraph(changeType, element) {
            document.querySelectorAll('.toggle-active').forEach(el => el.classList.remove('active'));
            element.classList.add('active');
            typeOfGraph = changeType;
            updateVisitorActivityChart(selectVisitorActivityDate.value);
        }

        function updateTotalCount(allData, dateRange) {
            let totalUserCount = 0;
            let totalScreenPageViews = 0;
            let totalBounceRate = 0;

            const rangeLimits = {
                'weekly': 7,
                'monthly': 30,
                'quarterly': 90,
                'semester': 182,
                'yearly': 365
            };
            const limit = rangeLimits[dateRange] || allData.length;
            const actualLimit = Math.min(allData.length, limit);

            for (let i = 0; i < actualLimit; i++) {
                totalUserCount += allData[i].userCount;
                totalScreenPageViews += allData[i].screenPageViews;
                totalBounceRate += allData[i].bounceRate;
            }

            const averageBounceRate = totalBounceRate / actualLimit;
            bouncerateCountElement.textContent = `${averageBounceRate.toFixed(2)}%`;

            visitorCountElement.textContent = totalUserCount;
            pageViewCountElement.textContent = totalScreenPageViews;
        }

        visitorActivityChartFirstLoad();

    </script>
</div>
{% endif %}
