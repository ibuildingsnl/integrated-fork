<div class="widget w-full">
    <div class="widget-container {{ widget.id }}">
        <div class="widget-header">
            <h2>{% trans %}Site Activity{% endtrans %}</h2>
            <select id="site_activity_date_range" name="site_activity_date_range"
                    class="dashboardForm-select dashboardForm-event">
                <option value="30daysAgo">{% trans %}This month{% endtrans %}</option>
                <option value="90daysAgo">{% trans %}3 Last months{% endtrans %}</option>
                <option value="182daysAgo">{% trans %}This semester{% endtrans %}</option>
                <option value="365daysAgo">{% trans %}This Year{% endtrans %}</option>
            </select>
        </div>
        <div class="widget-content flex">
            <div class="w-1/3">
                <div class="visitors">
                    <h3>{% trans %}Total visits{% endtrans %}: <span class="value">{{ totalViews }}</span></h3>
                    <h3>{% trans %}Bounce Rate{% endtrans %}: <span class="value">{{ bounceRate }}%</span></h3>
                </div>
            </div>
            <div class="w-2/3">
                <h3>{% trans %}Top Locations{% endtrans %}:</h3>
                <ul class="visitor-regions">
                    {% for row in viewByCountry %}
                        <li onmouseover="updateCityList('{{ row.country }}')" onmouseout="updateCityList('')">
                            <span class="location">{{ row.country }}</span>
                            <div class="percetage-full">
                                <div class="percentage-part" style="width:{{ row.percentage }}%"></div>
                            </div>
                            <div class="user-count">{{ row.totalUser }}</div>
                        </li>
                    {% endfor %}
                </ul>
            </div>
            <div class="cities">
            </div>
        </div>
    </div>

    <script>

        const viewByCountry = {{ viewByCountry | json_encode | raw }};

        function updateCityList(country) {
            var citiesContainer = document.querySelector('.cities');

            var existingList = document.querySelector('.visitor-cities');
            if (existingList) {
                citiesContainer.removeChild(existingList);
            }

            var ul = document.createElement('ul');
            ul.classList.add('visitor-regions');
            ul.classList.add('visitor-cities');
            var selectedCountryData = viewByCountry[country];

            if (selectedCountryData) {
                for (var cityName in selectedCountryData.cities) {
                    var cityData = selectedCountryData.cities[cityName];

                    var li = document.createElement('li');

                    var spanLocation = document.createElement('span');
                    spanLocation.classList.add('location');
                    spanLocation.textContent = cityData.city;

                    var divPercentageFull = document.createElement('div');
                    divPercentageFull.classList.add('percentage-full');

                    var divPercentagePart = document.createElement('div');
                    divPercentagePart.classList.add('percentage-part');
                    divPercentagePart.style.width = cityData.percentage + '%';

                    divPercentageFull.appendChild(divPercentagePart);

                    var divUserCount = document.createElement('div');
                    divUserCount.classList.add('user-count');
                    divUserCount.textContent = cityData.totalUser;

                    li.appendChild(spanLocation);
                    li.appendChild(divPercentageFull);
                    li.appendChild(divUserCount);
                    ul.appendChild(li);
                }
            }
            citiesContainer.appendChild(ul);
        }

    </script>
</div>

