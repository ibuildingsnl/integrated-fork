{% if deviceType is not null %}
<div class="widget w-full">
    <div class="widget-container {{ widget.id }}">
        <div class="widget-header">
            <h2>{% trans %}Device type{% endtrans %}</h2>
        </div>
        <div class="widget-content flex">
            <canvas id="Device_Type-doughnut-chart" width="800" height="450"></canvas>
        </div>
    </div>

    <script>
        const deviceTypeDatas = {{ deviceType | json_encode | raw }};
        var deviceTypeChart;
        const selectDeviceTypeDate = document.getElementById('select_date_range');
        selectDeviceTypeDate.addEventListener('change', function () {
            updateDeviceTypeChart();
        });
        updateDeviceTypeChart();

        function dateRangeDeviceTypeSelection() {
            const dateRangeMapping = {
                'weekly': 'weeklyDeviceType',
                'monthly': 'monthlyDeviceType',
                'quarterly': 'quarterlyDeviceType',
                'semester': 'semesterDeviceType',
                'yearly': 'yearlyDeviceType'
            };
            return dateRangeMapping[selectDeviceTypeDate.value] || selectedDateRange;
        }

        function updateDeviceTypeChart() {
            var selectedDeviceTypeDateRange = dateRangeDeviceTypeSelection(selectDeviceTypeDate.value);

            const devices = deviceTypeDatas[selectedDeviceTypeDateRange].map(item => item.device);
            const amounts = deviceTypeDatas[selectedDeviceTypeDateRange].map(item => item.amount);
            var ctx = document.getElementById('Device_Type-doughnut-chart');

            if (deviceTypeChart) {deviceTypeChart.destroy();}
            deviceTypeChart = new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: devices,
                    datasets: [
                        {
                            label: "Traffic source",
                            backgroundColor: ["#008080", "#FF7F50", "#40E0D0", "#FFC0CB", "#808000", "#DDA0DD", "#87CEEB", "#98FF98", "#FFE5B4", "#E6E6FA"],
                            data: amounts
                        }
                    ]
                },
                options: {
                    maintainAspectRatio: false,
                    cutout: '0%',
                    title: {
                        display: true,
                        text: 'Type of Device'
                    },
                    plugins: {
                        legend: {
                            position: 'left',
                            align: 'center'
                        }
                    }
                }
            });


        }
    </script>
</div>
{% endif %}
