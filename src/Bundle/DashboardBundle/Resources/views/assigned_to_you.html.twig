{% if assignedToYou is not null %}
    <div class="widget col-left w-full">
        <div class="widget-container {{ widget.id }}">
            <div class="widget-header">
                {% if (assignedToYou is not iterable) %}
                    <h2>{{ assignedToYou }}</h2>
                {% else %}
                    <h2>{% trans %}Assigned to you{% endtrans %}</h2>
                {% endif %}
            </div>
            <nav class="article-list {{ assignedToYou|length > 7 ? 'assigned-item-scrollable-list' : '' }}" id="articleList">
                <ul>
                    {% for article in assignedToYou %}
                        {% if article.workflow_color_string is not null %}
                            {% set status_color = article.workflow_color_string|first %}
                        {% else %}
                            {% set status_color = '#f2f2f2' %}
                        {% endif %}
                        {% if article.workflow_icon_string is not null %}
                            {% set status_icon = article.workflow_icon_string|first %}
                        {% else %}
                            {% set status_icon = '' %}
                        {% endif %}
                        <li class="assigned-item">
                                <a class="flex flex-1 items-center w-full" target="_blank" href="{{ article.path }}">
                                    <div class="workflow-status" style="background-color:{{ status_color }};">
                                        <i class="iconoir-{{ status_icon }}"></i>
                                    </div>
                                    <span class="item-title">{{ article.title }}</span>
                                </a>
                            <span class="facet-count flex items-center date-tab">{{ article.workflow_deadline }}</span>
                        </li>
                    {% endfor %}
                    {% if assignedToYou|length == 0 %}
                        <li class="facet-wrappper">
                        <span class="facet-title">
                            <b>{% trans %}You have nothing assigned to you{% endtrans %}</b>
                        </span>
                        </li>
                    {% endif %}
                </ul>
            </nav>
        </div>
    </div>
    <style>
        .assigned-item-scrollable-list {
            max-height: 300px;
            overflow-y: auto;
        }
    </style>
{% endif %}
