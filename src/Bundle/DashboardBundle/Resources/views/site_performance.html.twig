{% if desktopSiteData is not null and mobileSiteData is not null%}
<div class="widget col-right w-full">
    <div class="widget-container {{ widget.id }}">
        <div class="widget-header">
            <h2>{% trans %}Site Speed{% endtrans %}</h2>
            <div class="switcher">
                <div class="btn mobile" id="mobile-button" onclick="MobileDesktopButton('mobile')">
                    <i class="iconoir-smartphone-device"></i>
                    {% trans %}Mobile{% endtrans %}
                </div>
                <div class="btn desktop active" id="desktop-button" onclick="MobileDesktopButton('desktop')">
                    <i class="iconoir-computer"></i>
                    {% trans %}Desktop{% endtrans %}
                </div>
            </div>
        </div>
        <div class="widget-content flex">
            <div class="w-1/2 flex items-center justify-center">
                <div class="progress-circle">
                    <div class="progress-center"></div>
                    <span class="progress-value">93</span>
                </div>
            </div>
            <div class="w-1/2">
                <div class="flex flex-wrap -mr-2">
                    <div class="w-1/2 p-2">
                        <div class="lighthouse-value">
                            <span id="timeToFirstByte" class="value"></span>
                            <span class="label">{% trans %}TTFB{% endtrans %}</span>
                        </div>
                    </div>
                    <div class="w-1/2 p-2">
                        <div class="lighthouse-value">
                            <span id="timeToInteractive" class="value">s</span>
                            <span class="label">{% trans %}Loading speed{% endtrans %}</span>
                        </div>
                    </div>
                    <div class="w-1/2 p-2">
                        <div class="lighthouse-value">
                            <span id="speedIndex" class="value">s</span>
                            <span class="label">{% trans %}Time to Interactive{% endtrans %}</span>
                        </div>
                    </div>
                    <div class="w-1/2 p-2">
                        <div class="lighthouse-value">
                            <span id="totalBlockingTime" class="value">ms</span>
                            <span class="label">{% trans %}Total Blocking Time{% endtrans %}</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            MobileDesktopButton("desktop")
        });

        const desktopSiteData = {{ desktopSiteData | json_encode | raw }};
        const mobileSiteData = {{ mobileSiteData | json_encode | raw }};
        function MobileDesktopButton(device)
        {
            var mobileButton = document.getElementById('mobile-button');
            var desktopMobile = document.getElementById('desktop-button');
            var timeToFirstByte = document.getElementById('timeToFirstByte');
            var timeToInteractive = document.getElementById('timeToInteractive');
            var speedIndex = document.getElementById('speedIndex');
            var totalBlockingTime = document.getElementById('totalBlockingTime');

            if (device == "desktop") {
                timeToFirstByte.innerText = desktopSiteData.desktopTimeToFirstByte + " ms";
                timeToInteractive.innerText = desktopSiteData.desktopTimeToInteractive + " s";
                speedIndex.innerText = desktopSiteData.desktopSpeedIndex + " s";
                totalBlockingTime.innerText = desktopSiteData.desktopTotalBlockingTime + " ms";
                var progressValue = desktopSiteData.desktopSiteScore;
                mobileButton.classList.remove('active')
                desktopMobile.classList.add('active')

            } else if (device == "mobile") {
                timeToFirstByte.innerText = mobileSiteData.mobileTimeToFirstByte + " ms";
                timeToInteractive.innerText = mobileSiteData.mobileTimeToInteractive+ " s";
                speedIndex.innerText = mobileSiteData.mobileSpeedIndex+ " s";
                totalBlockingTime.innerText = mobileSiteData.mobileTotalBlockingTime + " ms";
                var progressValue = mobileSiteData.mobileSiteScore
                mobileButton.classList.add('active')
                desktopMobile.classList.remove('active')
            }
            const progressCircle = document.querySelector('.progress-circle');
            const progressValueDisplay = document.querySelector('.progress-value');

            function getColorForPercentage(pct) {
                if (pct <= 20) return '#ff0000'; // red
                if (pct <= 40) return '#ff8000'; // orange-red
                if (pct <= 60) return '#ffff00'; // yellow
                if (pct <= 80) return '#80ff00'; // yellow-green
                return '#00ae93'; // green
            }

            const color = getColorForPercentage(progressValue);

            progressCircle.style.background = `conic-gradient(
                ${color} 0%,
                ${color} ${progressValue * 3.6}deg,
                #f2f2f2 ${progressValue * 3.6}deg,
                #f2f2f2 100%
             )`;

            progressValueDisplay.textContent = progressValue;
        }


    </script>
</div>
{% endif %}

