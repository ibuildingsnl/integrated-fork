<div class="widget w-full">
    <div class="widget-container {{ widget.id }}">
        <div class="widget-header">
            <h2>{% trans %}Geographic Activity{% endtrans %}</h2>
        </div>
        <div class="widget-content flex">
            <div class="w-2/3 pr-4">
                <h3>{% trans %}Top Countries{% endtrans %}:</h3>
                <ul class="visitor-regions" id="visitor_regions_list">
                </ul>
            </div>
            <div class="w-1/3">
                <div class="visitors show">
                    <h3>{% trans %}Total visits{% endtrans %}: <span class="value" id="total_views"></span></h3>
                    <h3>{% trans %}Bounce Rate{% endtrans %}: <span class="value" id="bounce_rate"></span></h3>
                </div>
                <div class="cities">
                    <h3>{% trans %}Top Cities{% endtrans %}:</h3>
                    <ul class="visitor-cities" id="visitor_cities_list">
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <script>
        const viewByCountryData = {{ viewByCountry | json_encode | raw }};
        const totalViews = {{ totalViews | json_encode | raw }};
        const bounceRate = {{ bounceRate | json_encode | raw }};
        let currentViewByCountryData = null;
        let currentTotalViews = null;
        let currentBounceRate = null;

        var selectGeographicActivityDate = document.getElementById('select_date_range');
        selectGeographicActivityDate.addEventListener('change', function () {
            updateViewByCountry();
        });

        function dateRangeGeographicActivitySelection(selectedDateRange) {
            const dateRangeMapping = {
                'weekly': 'weeklyGeographicActivity',
                'monthly': 'monthlyGeographicActivity',
                'quarterly': 'quarterlyGeographicActivity',
                'semester': 'semesterGeographicActivity',
                'yearly': 'yearlyGeographicActivity'
            };
            return dateRangeMapping[selectedDateRange] || selectedDateRange;
        }


        function updateViewByCountry() {
            const selectedGeographicActivityDateRange = dateRangeGeographicActivitySelection(selectGeographicActivityDate.value);
            currentViewByCountryData = viewByCountryData[selectedGeographicActivityDateRange];
            currentTotalViews = totalViews[selectedGeographicActivityDateRange]
            currentBounceRate = bounceRate[selectedGeographicActivityDateRange]
            renderViewByCountry();
        }

        function renderViewByCountry() {
            const visitorRegionsList = document.getElementById('visitor_regions_list');
            visitorRegionsList.innerHTML = '';

            for (const country in currentViewByCountryData) {
                const row = currentViewByCountryData[country];
                const li = document.createElement('li');
                li.onmouseover = () => updateCityList(country, true);
                li.onmouseout = () => updateCityList('', false);

                const spanLocation = document.createElement('span');
                spanLocation.classList.add('location');
                spanLocation.textContent = row.country;

                const divPercentageFull = document.createElement('div');
                divPercentageFull.classList.add('percentage-full');

                const divPercentagePart = document.createElement('div');
                divPercentagePart.classList.add('percentage-part');

                divPercentageFull.appendChild(divPercentagePart);

                const divUserCount = document.createElement('div');
                divUserCount.classList.add('user-count');
                divUserCount.textContent = row.totalUser;

                li.appendChild(spanLocation);
                li.appendChild(divPercentageFull);
                li.appendChild(divUserCount);
                visitorRegionsList.appendChild(li);
            }

            document.getElementById('total_views').textContent = currentTotalViews;
            document.getElementById('bounce_rate').textContent = currentBounceRate + ' %';

            const selectedCountry = document.querySelector('.visitor-regions li.selected');
            if (selectedCountry) {
                updateCityList(selectedCountry.textContent, true);
            }
        }

        updateViewByCountry();

        function updateCityList(country, show) {
            var citiesContainer = document.querySelector('.cities');
            var visitorsContainer = document.querySelector('.visitors');

            if (show === true) {
                citiesContainer.classList.add('show')
                visitorsContainer.classList.remove('show')
            } else {
                citiesContainer.classList.remove('show')
                visitorsContainer.classList.add('show')
            }

            var existingList = document.querySelector('.visitor-cities');
            if (existingList) {
                citiesContainer.removeChild(existingList);
            }

            var ul = document.createElement('ul');
            ul.classList.add('visitor-cities');
            var selectedCountryData = currentViewByCountryData[country];

            if (selectedCountryData) {
                for (var cityName in selectedCountryData.cities) {
                    var cityData = selectedCountryData.cities[cityName];

                    var li = document.createElement('li');

                    var spanLocation = document.createElement('span');
                    spanLocation.classList.add('location');
                    spanLocation.textContent = cityData.city;

                    var divPercentageFull = document.createElement('div');
                    divPercentageFull.classList.add('percentage-full');

                    var divPercentagePart = document.createElement('div');
                    divPercentagePart.classList.add('percentage-part');
                    divPercentagePart.style.width = cityData.percentage + '%';

                    divPercentageFull.appendChild(divPercentagePart);

                    var divUserCount = document.createElement('div');
                    divUserCount.classList.add('user-count');
                    divUserCount.textContent = cityData.totalUser;

                    li.appendChild(spanLocation);
                    li.appendChild(divPercentageFull);
                    li.appendChild(divUserCount);
                    ul.appendChild(li);
                }
            }
            citiesContainer.appendChild(ul);
        }
    </script>
</div>
