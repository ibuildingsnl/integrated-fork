<div class="widget col-left w-full">
    <div class="widget-container {{ widget.id }}">
        <div class="widget-header">
            {% if (mostReadArticles is not iterable) %}
                <h2>{{ mostReadArticles }}</h2>
            {% else %}
                <h2>{% trans %}Most read content{% endtrans %}</h2>
            {% endif %}
        </div>
        <nav class="article-list" id="articleList">
            <ul></ul>
        </nav>
    </div>
    <script>
        const mostReadArticles = {{ mostReadArticles | json_encode | raw }};
        const selectMostReadDate = document.getElementById('select_date_range');

        updateMostRead(dateRangeMostReadSelection(selectMostReadDate.value));
        selectMostReadDate.addEventListener('change', function () {
            updateMostRead(dateRangeMostReadSelection(selectMostReadDate.value));
        });

        function dateRangeMostReadSelection(selectedDateRange) {
            const dateRangeMapping = {
                'weekly': 'weeklyMostReadArticles',
                'monthly': 'monthlyMostReadArticles',
                'quarterly': 'quarterlyMostReadArticles',
                'semester': 'semesterMostReadArticles',
                'yearly': 'yearlyMostReadArticles'
            };
            return dateRangeMapping[selectedDateRange] || selectedDateRange;
        }

        function updateMostRead(dateRange) {
            var articleListContainer = document.getElementById('articleList');
            var ulElement = articleListContainer.querySelector('ul');
            ulElement.innerHTML = '';

            mostReadArticles[dateRange].forEach((article) => {
                var liElement = document.createElement('li');
                liElement.classList.add('facet-wrappper');

                var titleElement = document.createElement('span');
                titleElement.classList.add('facet-title');
                titleElement.innerHTML = `<b>${article.title}</b>`;
                liElement.appendChild(titleElement);

                var countElement = document.createElement('span');
                countElement.classList.add('facet-count');
                countElement.textContent = article.views;
                liElement.appendChild(countElement);

                ulElement.appendChild(liElement);
            });
        }
    </script>
</div>
