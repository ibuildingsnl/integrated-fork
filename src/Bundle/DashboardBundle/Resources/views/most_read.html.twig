<div class="widget col-left w-full">
    <div class="widget-container {{ widget.id }}">
        <div class="widget-header">
            {% if (mostViewedPages is not iterable) %}
                <h2>{{ mostViewedPages }}</h2>
            {% else %}
                <h2>{% trans %}Most read content{% endtrans %}</h2>
            {% endif %}
            <select id="most_read_date_range" name="most_read_date_range"
                    class="dashboardForm-select dashboardForm-event">
                <option value="30daysAgo">{% trans %}This month{% endtrans %}</option>
                <option value="90daysAgo">{% trans %}3 Last months{% endtrans %}</option>
                <option value="365daysAgo">{% trans %}This Year{% endtrans %}</option>
            </select>
        </div>
        <nav class="article-list">
            <ul>
                {% for article in mostViewedPages %}
                    <li class="facet-wrappper">
                        <span class="facet-title">
                            <b> {{ article.title }} </b>
                        </span>
                        <span class="facet-count">{{ article.views }}</span>
                    </li>
                {% endfor %}
            </ul>
        </nav>
    </div>
</div>
