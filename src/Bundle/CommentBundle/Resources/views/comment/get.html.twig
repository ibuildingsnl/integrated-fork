<div class="comment-holder">

    <div class="comment-inner arrow-up arrow-left">

        <div class="comment-body">

            <a href="#" class="cancel-comment"><i class="iconoir-cancel"></i></a>

            {% include '@IntegratedComment/comment/partial.comment.html.twig' %}

            <div class="comment-reply">
                {% for reply in comment.replies %}
                    <hr>
                    {% include '@IntegratedComment/comment/partial.comment.html.twig' with {'comment': reply, 'parent': comment} %}
                {% endfor %}
            </div>
        </div>

        <div class="comment-footer">
            {{ form_start(form) }}
            <div class="form-group">
                <div class="flex">
                    <div class="w-full comment-textarea">
                        {{ form_widget(form.text) }}
                    </div><!-- col -->

                    <div class="flex ml-2">
                        <button type="submit" class="btn btn-dark-green">{{ 'Reply'|trans }}</button>
                    </div>
                </div>
            </div>
            {{ form_end(form) }}
        </div>
    </div>
</div>
