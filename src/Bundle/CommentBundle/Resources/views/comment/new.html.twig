<div class="comment-holder hold">
    <div class="comment-inner arrow-up arrow-left">
        <div class="comment-body">
            <h3>{{ 'Add a Comment'|trans }}</h3>
            <p>
                <a href="#" class="cancel-comment"><i class="iconoir-xmark"></i></a>
            </p>
            {{ form_start(form) }}
                <div class="form-group">
                    <div class="flex">
                        <div class="w-full comment-textarea">
                            {{ form_widget(form.text) }}
                        </div>

                        <div class="flex ml-2">
                            <button type="submit" class="btn btn-dark-green">{{ 'Add'|trans }}</button>
                        </div>
                    </div>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
</div>
