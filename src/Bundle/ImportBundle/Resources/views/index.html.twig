{% extends '@IntegratedContent/base.html.twig' %}
{% block content %}
    <div class="row">
        <div class="index-wrapper-full">
            <div class="page-title">
                <h1 class="heading">{% trans %}Imports{% endtrans %}</h1>
                <ul class="options-no-bg">
                    <li class="dropdown close-outside" data-underlay="no">
                        <a href="#" data-toggle="dropdown" role="button" id="drop_1" class="btn btn-select">
                            <span>{% trans %}New import{% endtrans %}</span>
                            <i class="iconoir-plus"></i>
                        </a>
                        <ul aria-labelledby="drop_1" role="menu" class="dropdown-menu" id="menu_1">
                            {% for type in contentTypes %}
                                {% if type.type %}
                                    <li role="presentation"><a
                                            href="{{ path('integrated_import_new', {'type': type.type}) }}"
                                            tabindex="-1" role="menuitem">
                                            {{ type.name }}</a>
                                    </li>
                                {% endif %}
                            {% endfor %}
                        </ul>
                    </li>
                </ul>
            </div>

            <section class="section-white section-radius">

                <table class="table table-hover">
                    <thead>
                    <tr>
                        <th>{% trans %}Name{% endtrans %}</th>
                        <th>{% trans %}Document type{% endtrans %}</th>
                        <th>{% trans %}Created{% endtrans %}</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for document in documents %}
                        <tr class="has-options">
                            <td>
                                <strong>
                                    <a href="{{ path('integrated_import_edit', {'importDefinition': document.id}) }}">
                                        {{ document.name }}
                                    </a>
                                </strong>
                                <div class="row-options">
                                    <a href="{{ path('integrated_import_file', {'importDefinition': document.id}) }}"
                                       title="{% trans %}Start import{% endtrans %}">
                                        {% trans %}Start import{% endtrans %}
                                    </a> |
                                    <a href="{{ path('integrated_import_edit', {'importDefinition': document.id}) }}"
                                       title="{% trans %}Edit{% endtrans %}">
                                        {% trans %}Edit{% endtrans %}
                                    </a> |
                                    <a href="{{ path('integrated_import_clone', {'importDefinition': document.id}) }}"
                                       title="{% trans %}Copy{% endtrans %}">
                                        {% trans %}Copy{% endtrans %}
                                    </a>
                                </div>
                            </td>
                            <td>
                                {% for type in contentTypes %}
                                    {% if type.type == document.contentType %}
                                        {{ type.name }}
                                    {% endif %}
                                {% endfor %}
                            </td>
                            <td>
                                {{ document.createdAt|format_date("medium", "none") }}
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="4">
                                {% trans %}No import definitions have been added{% endtrans %}
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </section>
        </div>
    </div>
{% endblock %}
