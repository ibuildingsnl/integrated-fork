{% extends '@IntegratedContent/base.html.twig' %}
{% block content %}
    <div class="row">
        <form method="post" id="summaryForm">
            <input type="hidden" name="action" value="go"/>

            <div id="toolbar" class="w-full flex justify-between">
                <div class="options">
                    <div class="form-actions">
                        <a id="status-complete" class="no-icon btn btn-green text-white" style="display: none;"
                           href="{{ path('integrated_import_index') }}">{% trans %}Close import{% endtrans %}</a>
                    </div>
                </div>
                <div class="back">
                    <a class="no-icon btn btn-white icon-left"
                       href="{{ path("integrated_import_definition", {'importDefinition': importDefinition.id }) }}"><i
                            class="iconoir iconoir-arrow-left"></i><span>{% trans %}Back{% endtrans %}</span></a>
                </div>
            </div>

            <div class="index-wrapper-full" style="margin-top:50px;">
                <h1>{% trans %}Step 4 of 4: Importing...{% endtrans %}</h1>

                <div id="status-pending">
                    <p>{% trans %}Please wait while your content is being imported. Do not close this window.{% endtrans %}</p>
                </div>

                <div class="progress">
                    <div id="import-progress" class="progress-bar progress-bar-success" role="progressbar"
                         aria-valuenow="0" aria-valuemin="0" aria-valuemax="100" style="width:0%">
                        <span class="sr-only"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-12" id="status-remaining"></div>
                    <br/>
                    <br/>
                </div>

                <h2><a href="#" onclick="$('#message-list').toggle(); return false;">Importer log</a></h2>
                <div id="message-list">
                </div>

                <h2><a href="#" onclick="$('#error-list').toggle(); return false;">Errors</a> (<span
                        id="error-count">0</span>)</h2>
                <div id="error-list" style="display: none;">
                </div>

                <h2><a href="#" onclick="$('#success-list').toggle(); return false;">Success</a> (<span
                        id="success-count">0</span>)</h2>
                <div id="success-list" style="display: none;">
                </div>

            </div>
        </form>
    </div>
<style>
    div#message-list {
        height: 400px;
        overflow-y: scroll;
        max-width: 1140px;
        background-color: white;
        padding: 1rem;
        border-radius: 8px;
    }

    .progress {
        width: 1140px;
        background-color: white;
        height: 30px;
        position: relative;
        border-radius: 8px;
        border: 1px solid #04ad93;
        overflow: hidden;
    }

    div#import-progress {
        position: absolute;
        left: 0;
        height: 30px;
        background-color: #0dad93;
        display: flex;
        z-index: 1;
        content: attr(aria-valuenow);
        text-align: center;
        align-items: center;
        justify-content: center;
        color: white;
        font-weight: bold;
    }

    div#import-progress::before {
        content: attr(aria-valuenow);
    }
</style>

{% endblock %}

{% block javascript %}
{{ parent() }}

<script>
var errorCount = 0;
var messageCount = 0;
var successCount = 0;
function executeImport(startRow) {
    $.ajax({
        url: "{{ path('integrated_import_run_execute', {'importDefinition': importDefinition.id} ) }}?startTime={{ startTime }}&start="+startRow,
    }).done(function(data) {
        $.each(data.errors, function(key, value) {
            $('#error-list').append('<div class="alert-danger">'+value+'</div>');
            errorCount = errorCount + 1;
            $('#error-count').html(errorCount);
        });
        $.each(data.messages, function(key, value) {
            $('#message-list').append('<div class="message">'+value+'</div>');
        });
        $.each(data.success, function(key, value) {
            $('#success-list').append('<div class="success">'+value+'</div>');
            successCount = successCount + 1;
            $('#success-count').html(successCount);
        });
        $('#import-progress').css('width', data.percentage+'%').attr('aria-valuenow', data.percentage + '%');
        $('#status-remaining').html(data.remaining);
        if (data.done) {
            $('#import-progress').css('width', '100%').attr('aria-valuenow', '100%');
            $('#status-pending').hide();
            $('#status-complete').show();
        } else {
            executeImport(data.startRow);
        }
    }).fail(function() {
      alert('Failure');
    });
}

$(document).ready(function() {
    executeImport(0);
});
</script>
{% endblock %}
