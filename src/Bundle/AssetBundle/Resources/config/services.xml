<?xml version="1.0" encoding="UTF-8" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>

        <defaults autowire="true" autoconfigure="true"/>

        <service id="integrated_asset.manager.stylesheet_manager" class="Integrated\Bundle\AssetBundle\Manager\AssetManager" />
        <service id="integrated_asset.manager.javascript_manager" class="Integrated\Bundle\AssetBundle\Manager\AssetManager" />

        <service id="integrated_asset.twig.stylesheet_extension" class="Integrated\Bundle\AssetBundle\Twig\Extension\StylesheetExtension">
            <argument type="service" id="integrated_asset.manager.stylesheet_manager" />
            <tag name="twig.extension" />
        </service>

        <service id="integrated_asset.twig.javascript_extension" class="Integrated\Bundle\AssetBundle\Twig\Extension\JavascriptExtension">
            <argument type="service" id="integrated_asset.manager.javascript_manager" />
            <tag name="twig.extension" />
        </service>

    </services>

</container>
