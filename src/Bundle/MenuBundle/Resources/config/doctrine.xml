<?xml version="1.0" encoding="UTF-8" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>

        <defaults autowire="true" autoconfigure="true"/>

        <service id="integrated_menu.document.menu.repository" class="Doctrine\ODM\MongoDB\Repository\DocumentRepository">
            <factory service="doctrine_mongodb.odm.document_manager" method="getRepository" />
            <argument>Integrated\Bundle\MenuBundle\Document\Menu</argument>
        </service>

    </services>

</container>
