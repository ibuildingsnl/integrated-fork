<?xml version="1.0" encoding="UTF-8" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>

        <defaults autowire="true" autoconfigure="true"/>

        <service id="integrated_menu.menu.database_menu_factory" class="Integrated\Bundle\MenuBundle\Menu\DatabaseMenuFactory" public="true">
            <argument>Integrated\Bundle\MenuBundle\Document\Menu</argument>
            <argument>Integrated\Bundle\MenuBundle\Document\MenuItem</argument>
            <argument type="service" id="doctrine_mongodb.odm.document_manager" />
        </service>

        <service id="integrated.menu_factory.database" alias="integrated_menu.menu.database_menu_factory" />

    </services>

</container>
