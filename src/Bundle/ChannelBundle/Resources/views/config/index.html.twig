{% extends '@IntegratedChannel/base.html.twig' %}
{% block title %}{% trans %}Connectors{% endtrans %}{% endblock title %}

{% block content %}
    <div class="row">
        <div class="index-wrapper-full">
            {% set createActionsHtml %}
                <ul class="options-no-bg">
                    <li class="dropdown close-outside" data-underlay="no">
                        <a href="#" data-toggle="dropdown" role="button" id="drop_1" class="btn btn-select">
                            <span>{% trans %}New{% endtrans %} {% trans %}connector{% endtrans %}</span>
                            <i class="iconoir-plus"></i>
                        </a>
                        <ul aria-labelledby="drop_1" role="menu" class="dropdown-menu" id="menu_1">
                            {% for adapter in adapters %}
                                <li role="presentation"><a
                                        href="{{ path('integrated_channel_config_new', {'adapter': adapter.manifest.name}) }}"
                                        tabindex="-1" role="menuitem">New {{ adapter.manifest.label }} configuration</a>
                                </li>
                            {% endfor %}
                        </ul>
                    </li>
                </ul>
            {% endset %}
            {{ component('integrated_admin:page_title', {
                title: 'Connectors'|trans,
                actionsHtml: createActionsHtml,
            }) }}

            {% component 'integrated_admin:section_card' %}
                {% block content %}
                {% set configTableColGroupHtml %}
                    <colgroup>
                        <col style="width: 20%"/>
                        <col/>
                    </colgroup>
                {% endset %}
                {% set configTableHeadHtml %}
                    <tr>
                        <th>{% trans %}Name{% endtrans %}</th>
                        <th>{% trans %}Connector{% endtrans %}</th>
                    </tr>
                {% endset %}
                {% set configTableBodyHtml %}
                    {% for data in pager %}
                        <tr class="has-options">
                            <td>
                            <strong>
                                <a href="{{ path('integrated_channel_config_edit', {'id': data.id}) }}">
                                    {{ data.name }}
                                </a>
                            </strong>
                                {% set configRowActionsHtml %}
                                    <a href="{{ path('integrated_channel_config_edit', {'id': data.id}) }}"
                                       title="{% trans %}Edit{% endtrans %}">{% trans %}Edit{% endtrans %}</a> |
                                    <a href="{{ path('integrated_channel_config_delete', {'id': data.id}) }}"
                                       class="color-red" title="{% trans %}Delete{% endtrans %}">{% trans %}Delete{% endtrans %}</a>
                                {% endset %}
                                {{ component('integrated_admin:row_actions', {
                                    contentHtml: configRowActionsHtml,
                                }) }}
                            </td>
                            <td>{{ data.adapter }}</td>
                        </tr>
                    {% endfor %}
                {% endset %}
                {{ component('integrated_admin:data_table', {
                    colGroupHtml: configTableColGroupHtml,
                    headHtml: configTableHeadHtml,
                    bodyHtml: configTableBodyHtml,
                    colSpan: 2,
                }) }}

                {{ component('integrated_admin:pagination_footer', {
                    pagination: pager,
                }) }}
                {% endblock %}
            {% endcomponent %}
        </div>
    </div>
{% endblock %}
