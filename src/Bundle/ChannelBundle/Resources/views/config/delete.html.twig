{% extends '@IntegratedChannel/base.html.twig' %}
{% block title %}{% trans %}Delete connector{% endtrans %}{% endblock title %}
{% block crumbs %}
    <div class="breadcrumb-holder">
        <div class="container">
            <ol class="breadcrumb">
                <li>
                    <a href="{{ path('integrated_channel_config_index') }}">{% trans %}Home{% endtrans %}</a>
                </li>
                <li class="active">{% trans %}Delete{% endtrans %}</li>
            </ol>
        </div>
    </div>
{% endblock %}
{% block content %}
    <div class="row">
        <div class="w-full mb-4 md:mb-0">
            <div class="page-title">
                <h1 class="heading">{% trans %}Delete{% endtrans %} {{ adapter.manifest.label|default(data.adapter) }} {% trans %}connector{% endtrans %}</h1>
            </div>
            <section class="section-white section-padding section-radius">
                <p>
                    {% trans with {'%name%':  data.name} %}You are about to delete the configuration "%name%", click the delete button below to confirm the action.{% endtrans %}
                </p>
                {{ form(form, { 'style': 'horizontal' }) }}
            </section>
        </div>
    </div>
{% endblock %}
