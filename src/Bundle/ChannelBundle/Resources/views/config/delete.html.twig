{% extends '@IntegratedChannel/base.html.twig' %}
{% block title %}{% trans %}Delete connector{% endtrans %}{% endblock title %}

{% block content %}
    {% block form_start %}
        {{ form_start(form) }}
    {% endblock %}
    {% set configDeleteToolbarHtml %}
        {% block toolbar %}
            {% include '@IntegratedContent/partials/block.toolbar.html.twig' %}
        {% endblock toolbar %}
    {% endset %}
    {% set configDeleteTitleHtml %}
        {{ component('integrated_admin:page_title', {
            title: ('Delete'|trans) ~ ' ' ~ ('configuration'|trans),
        }) }}
    {% endset %}
    {% set configDeleteContentHtml %}
        <p>
            {% trans with {'%name%':  data.name} %}You are about to delete the configuration "%name%", click the delete button to confirm the action.{% endtrans %}
        </p>
        {{ form_rest(form, {'style':'horizontal'})}}
    {% endset %}
    {{ component('integrated_admin:edit_form_shell', {
        toolbarHtml: configDeleteToolbarHtml,
        pageTitleHtml: configDeleteTitleHtml,
        editorContentHtml: configDeleteContentHtml,
    }) }}
    {% block form_end %}
        {{ form_end(form) }}
    {% endblock %}
{% endblock %}
