{% extends '@IntegratedChannel/base.html.twig' %}
{% block title %}{% trans %}Delete connector{% endtrans %}{% endblock title %}

{% block content %}
    <div class="flex flex-wrap edit-form">
        {% block form_start %}
            {{ form_start(form, { 'style': 'horizontal' }) }}
        {% endblock %}
        {% block toolbar %}
            {% include '@IntegratedContent/partials/block.toolbar.html.twig' %}
        {% endblock toolbar %}
        <div class="aside-options"></div>
        <div class="editor-wrapper">
            <div class="page-title">
                <h1 class="heading">{% trans %}Delete{% endtrans %} {% trans %}configuration{% endtrans %}</h1>
            </div>
            <section class="editor editor-wrapped">
                <p>
                    {% trans with {'%name%':  data.name} %}You are about to delete the configuration "%name%", click the delete button to confirm the action.{% endtrans %}
                </p>
                {{ form_rest(form, {'style':'horizontal'})}}
            </section>
        </div>
        {% block form_end %}
            {{ form_end(form) }}
        {% endblock %}
    </div>
{% endblock %}
