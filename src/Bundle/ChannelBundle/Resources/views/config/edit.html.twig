{% extends '@IntegratedChannel/base.html.twig' %}
{% block title %}{% trans %}Edit connector{% endtrans %}{% endblock title %}
{% block content %}
<div class="flex flex-wrap edit-form edit-form--channel-config">
    {% block form_start %}
        {{ form_start(form, {'attr': {'data-turbo': 'false'}}) }}
    {% endblock %}
    {% block toolbar %}
        {% include '@IntegratedContent/partials/block.toolbar.html.twig' %}
    {% endblock toolbar %}
    <div class="aside-options">
        <aside>
            <div class="aside-holder">
                {% block sidebar %}
                <div class="aside-header">
                    <button class="toggle-filters toggle-options-sidebar"  data-target="aside-options" type="button">
                        <i class="iconoir-xmark"></i>
                    </button>
                    <span>{% trans %}Options{% endtrans %}</span>
                </div>
                <div class="aside-item-wrapper show">
                    <div class="aside-item-header">
                        <h3 class="aside-item-title">
                            <i class="iconoir-info-circle"></i>
                            <span class="aside-item-icon">{% trans %}Status{% endtrans %}</span>
                        </h3>
                        <i class="iconoir-nav-arrow-up"></i>
                    </div>
                    <div class="aside-item-list">
                        <div class="aside-item-list-container">
                            <div class="status-info">
                                {% if form.publicationStartDate is defined %}
                                    {{ form_row(form.publicationStartDate) }}
                                {% endif %}
                            </div>
                            <div class="status-options">
                                {% if data.publicationStartDate is defined and ('now'|date('U') > data.publicationStartDate|date('U'))%}
                                    <div class="status published">
                                        <i class="iconoir-check-circle"></i> {% trans %}Published{% endtrans %}
                                    </div>
                                    <a class="delete"
                                       href="{{ path('integrated_channel_config_delete', {'id': data.id}) }}">
                                        <i class="iconoir-trash"></i>
                                    </a>
                                {% elseif ('now'|date('U') < data.publicationStartDate|date('U')) %}
                                    <div class="status planned">
                                        <i class="iconoir-calendar"></i> {% trans %}Planned{% endtrans %}
                                    </div>
                                    <a class="delete"
                                       href="{{ path('integrated_channel_config_delete', {'id': data.id}) }}">
                                        <i class="iconoir-trash"></i>
                                    </a>
                                {% else %}
                                    <div class="status draft">
                                        <i class="iconoir-design-pencil"></i> {% trans %}Draft{% endtrans %}
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>
                    {% block content_meta %}
                        {% for child in form|filter(row => row.vars.attr.location|default == constant('Integrated\\Common\\Form\\Mapping\\Attributes\\Field::LOCATION_SIDEBAR'))  %}
                            {{ form_row(child) }}
                        {% endfor %}
                    {% endblock %}
                {% endblock %}
            </div>
        </aside>
    </div>
    <div class="editor-wrapper">
        {{ component('integrated_admin:page_title', {
            title: ('Edit'|trans) ~ ' ' ~ ('connector'|trans),
        }) }}
        <section class="editor editor-wrapped">
            {{ form_errors(form) }}

            {% block content_form %}
                {% for child in form|filter(row => row.vars.attr.location|default == constant('Integrated\\Common\\Form\\Mapping\\Attributes\\Field::LOCATION_EDITOR'))  %}
                    {{ form_row(child) }}
                {% endfor %}

                {{ form_rest(form, {'style':'horizontal'}) }}
            {% endblock %}
        </section>
    </div>
    {% block form_end %}
        {{ form_end(form) }}
    {% endblock %}
</div>
{% endblock %}

{% block webpack_js %}
    <script src="{{ asset('bundles/integratedintegrated/edit.js') }}" defer data-turbo-track="reload"></script>
{% endblock %}

{% block style %}
    {{ parent() }}

    <link rel="stylesheet" href="{{ asset('bundles/integratedintegrated/edit.css') }}">
    <style>
        .edit-form--channel-config .editor .form-item {
            display: block;
        }

        .edit-form--channel-config .editor .form-item .control-label,
        .edit-form--channel-config .editor .form-item .widget {
            width: 100% !important;
            max-width: none !important;
            flex: 0 0 100% !important;
            display: block !important;
        }

        .edit-form--channel-config .editor .form-item .widget {
            margin-top: 6px;
        }
    </style>
{% endblock %}
