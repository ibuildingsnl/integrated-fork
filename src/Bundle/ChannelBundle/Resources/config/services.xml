<?xml version="1.0" encoding="UTF-8" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>

        <defaults autowire="true" autoconfigure="true"/>

        <service id="integrated_channel.distribution_queue" class="Integrated\Bundle\ChannelBundle\Services\DistributionQueue">
            <argument type="service" id="integrated_channel.queue" />
            <argument type="service" id="integrated_channel.queue.serializer" />
        </service>

        <service id="integrated_channel.clock" class="Stratadox\Clock\DateTimeMutableClock" />

        <service id="integrated_channel.distributor" class="Integrated\Bundle\ChannelBundle\Services\ChannelDistributor">
            <argument type="service" id="integrated_channel.distribution_queue" />
            <argument type="service" id="integrated_content.publication_repository" />
            <argument type="service" id="integrated_channel.clock" />
        </service>

    </services>
</container>
