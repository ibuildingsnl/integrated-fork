<?xml version="1.0" encoding="UTF-8" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>

        <defaults autowire="true" autoconfigure="true"/>

        <service id="integrated_channel.adapter.registry_builder" class="Integrated\Common\Channel\Connector\Adapter\RegistryBuilder" />

        <service id="integrated_channel.adapter.registry" class="Integrated\Common\Channel\Connector\Adapter\Registry">
            <factory service="integrated_channel.adapter.registry_builder" method="getRegistry" />
        </service>

    </services>

</container>
