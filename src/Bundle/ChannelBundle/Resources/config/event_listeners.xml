<?xml version="1.0" encoding="UTF-8" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>

        <defaults autowire="true" autoconfigure="true"/>

        <service id="integrated_channel.event_listener.configure_menu_subscriber" class="Integrated\Bundle\ChannelBundle\EventListener\ConfigureMenuSubscriber">
            <argument type="service" id="security.authorization_checker" />
            <tag name="kernel.event_subscriber" />
        </service>

        <service id="integrated_channel.event_listener.channel_distribution" class="Integrated\Bundle\ChannelBundle\EventListener\ChannelDistributionListener">
            <argument type="service" id="integrated_channel.distributor" />
            <tag name="integrated_content.form.event_subscriber"/>
        </service>

    </services>

</container>
