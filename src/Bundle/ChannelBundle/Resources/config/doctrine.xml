<?xml version="1.0" encoding="UTF-8" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>

        <defaults autowire="true" autoconfigure="true"/>

        <service id="integrated_channel.odm.doctrine" alias="doctrine_mongodb.odm.document_manager" />
        <service id="integrated_channel.orm.doctrine" alias="doctrine.orm.entity_manager" />

        <service id="integrated_channel.odm.doctrine.distributionListener.listener" class="Integrated\Bundle\ChannelBundle\EventListener\Doctrine\ChannelDistributionListener">
            <argument type="service" id="integrated_channel.queue" />
            <argument type="service" id="integrated_channel.queue.serializer" />

            <tag name="doctrine_mongodb.odm.event_listener" event="postRemove" connection="default" />
            <tag name="doctrine_mongodb.odm.event_listener" event="postPersist" connection="default" />
            <tag name="doctrine_mongodb.odm.event_listener" event="postUpdate" connection="default" />
        </service>

    </services>

</container>
