<?xml version="1.0" encoding="UTF-8" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>

        <service id="Integrated\Bundle\NewsletterBundle\Controller\NewsletterController">
            <argument type="service" id="integrated_newsletter.content.fetcher" />
            <argument type="service" id="integrated_theme.templating.theme_manager" />
            <argument type="service" id="integrated_newsletter.newsletter.repository" />

            <tag name="controller.service_arguments" />
            <tag name="container.service_subscriber" />

            <call method="setContainer">
                <argument type="service" id="service_container" />
            </call>
        </service>

    </services>
</container>
