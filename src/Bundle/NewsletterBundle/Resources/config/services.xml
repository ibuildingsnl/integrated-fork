<?xml version="1.0" encoding="UTF-8" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>

        <service id="integrated_newsletter.content.repository" class="Integrated\Bundle\NewsletterBundle\Infrastructure\ODMContentRepository">
            <argument type="service" id="doctrine_mongodb.odm.document_manager" />
        </service>

        <service id="integrated_newsletter.content.base_combinator" class="Integrated\Bundle\NewsletterBundle\Service\ContentCombinator">
            <argument type="service" id="integrated_newsletter.content.repository" />
        </service>

        <service id="integrated_newsletter.content.combinator" class="Integrated\Bundle\NewsletterBundle\Service\DocumentTypeValidator">
            <argument type="service" id="integrated_newsletter.content.base_combinator" />
            <argument>%integrated_newsletter.document_types.whitelist%</argument>
        </service>

        <service id="integrated_newsletter.content.fetcher" class="Integrated\Bundle\NewsletterBundle\Service\ContentFetcher">
            <argument type="service" id="integrated_newsletter.content.combinator" />
            <argument type="service" id="integrated_content.resolver" />
        </service>

        <service id="integrated_newsletter.newsletter.repository" class="Doctrine\ODM\MongoDB\Repository\DocumentRepository">
            <factory service="doctrine_mongodb.odm.document_manager" method="getRepository" />
            <argument type="string">\Integrated\Bundle\NewsletterBundle\Document\Newsletter</argument>
        </service>

        <service id="integrated_newsletter.newsletter.renderer" class="Integrated\Bundle\NewsletterBundle\Infrastructure\TwigRenderer">
            <argument type="service" id="integrated_newsletter.content.fetcher" />
            <argument type="service" id="integrated_theme.templating.theme_manager" />
            <argument type="service" id="twig" />
        </service>
    </services>
</container>
