<?xml version="1.0" encoding="UTF-8" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <parameters>

        <parameter key="integrated_newsletter.event_listener.schedule_form_field_subscriber.class">Integrated\Bundle\NewsletterBundle\EventListener\ScheduleFormAssetProvidingSubscriber</parameter>

    </parameters>

    <services>

        <service id="integrated_newsletter.event_listener.schedule_form_field_subscriber" class="%integrated_newsletter.event_listener.schedule_form_field_subscriber.class%">
            <argument type="service" id="integrated_asset.manager.javascript_manager" />
            <argument type="service" id="integrated_asset.manager.stylesheet_manager" />

            <tag name="integrated_content.form.event_subscriber" />
        </service>


        <service id="integrated_newsletter.form.listener.form_field" class="Integrated\Bundle\NewsletterBundle\EventListener\ExcludeFromNewsletterListener">
            <tag name="integrated_content.form.event_subscriber"/>
        </service>
    </services>

</container>
