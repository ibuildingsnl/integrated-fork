<doctrine-mongo-mapping xmlns="http://doctrine-project.org/schemas/odm/doctrine-mongo-mapping"
                        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                        xsi:schemaLocation="http://doctrine-project.org/schemas/odm/doctrine-mongo-mapping
                    http://doctrine-project.org/schemas/odm/doctrine-mongo-mapping.xsd">

    <document name="Integrated\Bundle\NewsletterBundle\Document\Newsletter">
        <field field-name="title" type="string" />
        <field field-name="headline" type="string" />
        <field field-name="testAddresses" type="hash" />
        <embed-one field="schedule">
            <discriminator-field name="type" />
            <discriminator-map>
                <discriminator-mapping value="combined"
                                       class="Integrated\Bundle\NewsletterBundle\Document\Schedule\CombinedRecurringScheduleEntry"
                />
                <discriminator-mapping value="single"
                                       class="Integrated\Bundle\NewsletterBundle\Document\Schedule\SingleRecurringScheduleEntry"
                />
            </discriminator-map>
        </embed-one>
        <field field-name="contentSelection" type="hash" />
        <embed-many
            field="socials"
            target-document="Integrated\Bundle\ContentBundle\Document\Content\Embedded\Social"
        />
        <field field-name="hoursBefore" type="int" />
        <field field-name="recipientList" type="string" />
        <field field-name="sender" type="string" />
        <reference-one field="logo" target-document="Integrated\Bundle\ContentBundle\Document\Content\Image" />
    </document>

</doctrine-mongo-mapping>
