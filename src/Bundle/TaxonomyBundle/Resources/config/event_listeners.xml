<?xml version="1.0" encoding="UTF-8" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <parameters>

        <parameter key="integrated_taxonomy.event_listener.configure_menu_subscriber.class">Integrated\Bundle\TaxonomyBundle\EventListener\ConfigureMenuSubscriber</parameter>

    </parameters>

    <services>

        <service id="integrated_taxonomy.event_listener.configure_menu_subscriber" class="%integrated_taxonomy.event_listener.configure_menu_subscriber.class%">
            <argument type="service" id="security.authorization_checker" />
            <argument type="service" id="integrated_content.content_type.manager" />
            <tag name="kernel.event_subscriber" />
        </service>

        <service id="integrated_taxonomy.event_listener.channel_inheritance" class="\Integrated\Bundle\TaxonomyBundle\EventListener\TaxonomyChannelInheritanceListener">
            <argument type="service" id="integrated_taxonomy.taxonomy.repository" />
            <tag name="integrated_content.form.event_subscriber"/>
        </service>

        <service id="integrated_taxonomy.event_listener.parent_relation" class="\Integrated\Bundle\TaxonomyBundle\EventListener\TaxonomyParentRelationListener">
            <argument type="service" id="integrated_taxonomy.taxonomy.repository" />
            <argument id="doctrine_mongodb.odm.document_manager" type="service"/>
            <tag name="integrated_content.form.event_subscriber"/>
        </service>

        <service id="integrated_taxonomy.event_listener.parent_required" class="\Integrated\Bundle\TaxonomyBundle\EventListener\TaxonomyParentRequiredSubscriber">
            <tag name="integrated_content.form.event_subscriber"/>
        </service>

    </services>

</container>
