<?xml version="1.0" encoding="UTF-8" ?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services
        http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>

        <defaults autowire="true" autoconfigure="true"/>

        <service id="Integrated\Bundle\TaxonomyBundle\Controller\IndexController">
            <argument type="service" id="integrated_taxonomy.taxonomy.overview"/>
            <argument type="service" id="integrated.form.resolver" />
            <argument type="service" id="integrated_taxonomy.taxonomy.repository" />
            <argument type="service" id="integrated_content.services.flusher"/>
            <argument type="service" id="knp_paginator"/>
            <argument type="service" id="integrated_content.metadata.factory"/>
            <argument type="service" id="integrated_content.form.factory.event_dispatcher"/>
        </service>

    </services>
</container>
