{% extends '@IntegratedContent/base.html.twig' %}
{% block title %}{% trans %}Taxonomy index{% endtrans %}{% endblock title %}
{% block content %}
    <div class="taxonomy-index">
        <div class="flex flex-wrap">
            {% block form_start %}
                {{ form_start(form) }}
            {% endblock %}
            <div class="taxonomy-list-wrapper">
                {% if filter_options|default([])|length > 0 %}
                    <div class="page-title">
                        <div class="options">
                            <ul class="mr-2">
                                <li class="dropdown close-outside" data-underlay="no">
                                    <a data-toggle="dropdown" role="button" id="filtering-list" class="btn btn-select space-between">
                                        <span>{% trans %}Filter by parent{% endtrans %}
                                : {{ filter_options[filter]|default('Show all')|trans }}</span>
                                        <i class="iconoir-nav-arrow-down"></i>
                                    </a>
                                    <ul aria-labelledby="sorting-list" role="menu" class="dropdown-menu" id="sorting-menu">
                                        <li role="presentation">
                                            <a href="{{ path(app.request.attributes.get('_route'), app.request.query.all
                                                |merge(app.request.attributes.get('_route_params'))
                                                |merge({'filter': 'root', 'page': 1 })
                                            ) }}" role="menuitem">
                                                {{ "Show all"|trans }}
                                            </a>
                                        </li>
                                        {% for filter_id, filter_name in filter_options %}
                                            <li{% if filter_id == filter %} class="active"{% endif %} role="presentation">
                                                <a href="{{ path(app.request.attributes.get('_route'), app.request.query.all
                                                    |merge(app.request.attributes.get('_route_params'))
                                                    |merge({'filter': filter_id, 'page': 1 })
                                                ) }}" role="menuitem">
                                                    {{ filter_name|trans }}
                                                </a>
                                            </li>
                                        {% endfor %}
                                    </ul>
                                </li>
                            </ul>
                        </div>
                    </div>
                {% endif %}
                <div class="section-white section-radius taxonomy-list">
                    <table class="table table-hover">
                        <thead>
                        <tr>
                            <th>{% trans %}Name{% endtrans %}</th>
                            <th>{% trans %}Description{% endtrans %}</th>
                            <th>{% trans %}Slug{% endtrans %}</th>
                            <th>{% trans %}Count{% endtrans %}</th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for item in index %}
                            <tr class="has-options">
                                <td>
                                    <strong>
                                        <a href="{{ path('integrated_content_content_edit', { 'id': item.taxonomyId }) }}">
                                            {% if item.depth %}
                                                {% for i in range(0, item.depth-1) %}
                                                    {% if i == item.depth-1 %}
                                                        —
                                                    {% else %}
                                                        &nbsp;&nbsp;
                                                    {% endif %}
                                                {% endfor %}
                                            {% endif %}
                                            {{ item.title }}
                                        </a>
                                    </strong>
                                    <div class="row-options">
                                        <a href="{{ path('integrated_content_content_edit', {'id': item.taxonomyId}) }}"
                                           title="{% trans %}Edit{% endtrans %}">
                                            {% trans %}Edit{% endtrans %}
                                        </a> |
                                        <a class="color-red"
                                           href="{{ path('integrated_content_content_delete', {'id': item.taxonomyId}) }}"
                                           title="{% trans %}Delete{% endtrans %}">
                                            {% trans %}Delete{% endtrans %}
                                        </a>
                                    </div>
                                </td>
                                <td>
                                    {{ item.description|striptags|u.truncate(50, '...')|raw }}
                                </td>
                                <td>
                                    {{ item.slug }}
                                </td>
                                <td>
                                    {{ "(%d)"|trans|format(item.count) }}
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="4">
                                    {% trans %}No taxonomies added{% endtrans %}
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                    <div>
                        {{ knp_pagination_render(index, '@KnpPaginator/Pagination/sliding.html.twig') }}
                    </div>
                </div>
            </div>
            {% block toolbar %}
                {% include '@IntegratedContent/partials/block.toolbar.html.twig' %}
            {% endblock toolbar %}
            <div class="taxonomy-create-wrapper">
                <div class="aside-options">
                    <aside>
                        <div class="aside-holder">
                            {% block sidebar %}
                                <div class="aside-header">
                                    <button class="toggle-filters toggle-options-sidebar" data-target="aside-options"
                                            type="button">
                                        <i class="iconoir-xmark"></i></button>
                                    <span>{% trans %}Options{% endtrans %}</span>
                                </div>
                                <div class="aside-item-wrapper show">
                                    <div class="aside-item-header">
                                        <h3 class="aside-item-title">
                                            <i class="iconoir-info-circle"></i>
                                            <span class="aside-item-icon">{% trans %}Status{% endtrans %}</span>
                                        </h3>
                                        <i class="iconoir-nav-arrow-up"></i>
                                    </div>
                                    <div class="aside-item-list">
                                        <div class="aside-item-list-container">
                                            <div class="status-info">
                                                {% if form.publishTime is defined %}
                                                    {{ form_row(form.publishTime, {style: 'inline'}) }}
                                                {% endif %}
                                            </div>
                                            <div class="workflow-info">
                                                {% if form.extension_workflow is defined %}
                                                    {{ form_row(form.extension_workflow, {style: 'inline', 'show_label': 'true'}) }}
                                                {% endif %}
                                            </div>
                                            {% if content is defined and content.extensions['integrated.extension.workflow']['state'] is defined %}
                                                {% set workflow = content.extensions['integrated.extension.workflow']['state'] %}
                                            {% endif %}
                                            <div class="status-options">
                                                {% if workflow is defined and ('now'|date('U') > content.publishTime.startDate |date('U')) %}
                                                    <div class="status {{ workflow.name|lower }}"
                                                         style="background-color:{{ workflow.color|alpha(15) }};color:{{ workflow.color }};">
                                                        <i class="iconoir-{{ workflow.icon }}"></i> {{ workflow.name }}
                                                    </div>
                                                {% elseif (content is defined and ('now'|date('U') < content.publishTime.startDate |date('U'))) %}
                                                    <div class="status planned">
                                                        <i class="iconoir-calendar"></i> {% trans %}Planned{% endtrans %}
                                                    </div>
                                                {% else %}
                                                    {% if (content is defined and ((content.isPublished and content.getChannels|length > 0) or content.published == 'true')) %}
                                                        <div class="status published">
                                                            <i class="iconoir-check-circle"></i> {% trans %}Published{% endtrans %}
                                                        </div>
                                                    {% elseif (content is defined and ('now'|date('U') < content.publishTime.startDate |date('U'))) %}
                                                        <div class="status planned">
                                                            <i class="iconoir-calendar"></i> {% trans %}Planned{% endtrans %}
                                                        </div>
                                                    {% else %}
                                                        <div class="status draft">
                                                            <i class="iconoir-design-pencil"></i> {% trans %}Draft{% endtrans %}
                                                        </div>
                                                    {% endif %}
                                                {% endif %}
                                                {% if content is defined %}
                                                    {% if locking is defined and locking.lock is defined and locking.locked == false %}
                                                        <a class="delete"
                                                           href="{{ path('integrated_content_content_delete', {'id': content.id, 'lock': locking.lock.getId}) }}">
                                                            <i class="iconoir-trash"></i>
                                                        </a>
                                                    {% else %}
                                                        <a class="delete"
                                                           href="{{ path('integrated_content_content_delete', {'id': content.id}) }}">
                                                            <i class="iconoir-trash"></i>
                                                        </a>
                                                    {% endif %}
                                                {% endif %}
                                            </div>
                                            <div class="mt-2">
                                                {% if form.disabled is defined %}
                                                    {{ form_row(form.disabled) }}
                                                {% endif %}
                                                {% if form.orderable is defined %}
                                                    {{ form_row(form.orderable) }}
                                                {% endif %}
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                {% block content_options %}
                                    {% set options = false %}
                                    {% for child in form|filter(row => row.vars.attr.location|default == constant('Integrated\\Common\\Form\\Mapping\\Attributes\\Field::LOCATION_OPTIONS')) %}
                                        {% set options = true %}
                                    {% endfor %}
                                    {% if form.children.customFields is defined %}
                                        {% for field in form.children.customFields|filter(f => f.vars.attr.location|default == constant('Integrated\\Common\\Form\\Mapping\\Attributes\\Field::LOCATION_OPTIONS')) %}
                                            {% set options = true %}
                                        {% endfor %}
                                    {% endif %}
                                    {% if options == true %}
                                        <div class="aside-item-wrapper">
                                            <div class="aside-item-header">
                                                <h3 class="aside-item-title">
                                                    <i class="iconoir-settings"></i>
                                                    <span
                                                        class="aside-item-icon">{% trans %}Content Options{% endtrans %}</span>
                                                </h3>
                                                <i class="iconoir-nav-arrow-up"></i>
                                            </div>
                                            <div class="aside-item-list">
                                                <div class="aside-item-list-container">
                                                    {% for child in form|filter(row => row.vars.attr.location|default == constant('Integrated\\Common\\Form\\Mapping\\Attributes\\Field::LOCATION_OPTIONS')) %}
                                                        {{ form_row(child) }}
                                                    {% endfor %}
                                                    {% block custom_sidebar_fields %}
                                                        {% if form.children.customFields is defined %}
                                                            {% for field in form.children.customFields|filter(f => f.vars.attr.location|default == constant('Integrated\\Common\\Form\\Mapping\\Attributes\\Field::LOCATION_OPTIONS')) %}
                                                                {{ form_row(field) }}
                                                            {% endfor %}
                                                        {% endif %}
                                                    {% endblock %}
                                                </div>
                                            </div>
                                        </div>
                                    {% endif %}
                                {% endblock %}

                                {% block content_meta %}
                                    {% for child in form|filter(row => row.vars.attr.location|default == constant('Integrated\\Common\\Form\\Mapping\\Attributes\\Field::LOCATION_SIDEBAR')) %}
                                        {{ form_row(child) }}
                                    {% endfor %}
                                {% endblock %}
                            {% endblock %}
                        </div>
                    </aside>
                </div>
                <div class="editor-wrapper">
                    <div class="page-title">
                        <h1 class="heading">{% trans %}Create {% endtrans %} {{ content_type.name }}</h1>
                    </div>
                    <section class="editor">
                        {% block content_form %}
                            {% for child in form|filter(row => row.vars.attr.location|default == constant('Integrated\\Common\\Form\\Mapping\\Attributes\\Field::LOCATION_EDITOR')) %}
                                {{ form_row(child) }}
                            {% endfor %}

                            {% if form.children.customFields is defined %}
                                {% for field in form.children.customFields %}
                                    {% if not field.rendered %}
                                        {{ form_row(field, {'style':'editor', 'state':'show'}) }}
                                    {% endif %}
                                {% endfor %}
                            {% endif %}

                            {{ form_rest(form, {'style':'editor', 'state':'show'}) }}
                        {% endblock %}
                    </section>
                </div>
            </div>
            {% block form_end %}
                {{ form_end(form) }}
            {% endblock %}
        </div>
    </div>
{% endblock content %}

{% block webpack_js %}
    <script src="{{ asset('bundles/integratedintegrated/edit.js') }}"></script>
{% endblock %}
