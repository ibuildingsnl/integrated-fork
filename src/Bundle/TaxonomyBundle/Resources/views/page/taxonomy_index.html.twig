{% extends '@IntegratedContent/base.html.twig' %}
{% block title %}{% trans %}Taxonomy index{% endtrans %}{% endblock title %}
{% block style %}
    {{ parent() }}

    <style>
        .taxonomy-index ul {
            font-size: larger;
            line-height: 3em;
        }
        .taxonomy-index ul a {
            color: #1b3149;
        }
        .taxonomy-index ul a:hover {
            color: #1c6ca1;
        }
        .taxonomy-index .form-vertical {
            display: block;
        }
        @media only screen and (min-width: 1000px)  {
            .taxonomy-index {
                display: flex;
            }
            .taxonomy-index .form-vertical {
                width: 45%;
                margin-right: 5%;
            }
        }
    </style>
{% endblock %}
{% block content %}
    <div class="taxonomy-index">
        {{ form_start(form, { 'style': 'vertical' }) }}
            {{ form_rest(form) }}
        {{ form_end(form) }}

        <ul>
        {% for item in index %}
            <li>
                {% if item.depth %}
                    {% for i in range(0, item.depth-1) %}
                        {% if i == item.depth-1 %}
                            &dash;
                        {% else %}
                            &nbsp;&nbsp;
                        {% endif %}
                    {% endfor %}
                {% endif %}
                <a href="{{ path('integrated_content_content_edit', { 'id': item.taxonomyId }) }}">{{ item.title }}</a>
                {% if item.count %}
                    <a href="{{ path('integrated_content_content_index', { 'Keywords': [item.title] }) }}">
                        {{ "(used %d times)"|trans|format(item.count) }}
                    </a>
                {% else %}
                    {{ "(unused)"|trans }}
                {% endif %}
            </li>
        {% endfor %}
        </ul>
    </div>
{% endblock content %}
