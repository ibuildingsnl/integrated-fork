{% extends '@IntegratedContent/base.html.twig' %}
{% block title %}{% trans %}Taxonomy index{% endtrans %}{% endblock title %}
{% block content %}
    <div>
{{ form_start(form) }}
    {{ form_rest(form) }}
{{ form_end(form) }}
    </div>
    <div>
        <ul>
        {% for item in index %}
            <li>{{ item.depth }} / {{ item.title }} ({{ item.count }})</li>
        {% endfor %}
        </ul>
    </div>
{% endblock content %}
