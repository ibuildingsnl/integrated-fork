{
    "name": "integrated/taxonomy-bundle",
    "type": "symfony-bundle",
    "description": "Integrated Taxonomy Management Bundle",
    "keywords": [
        "integrated",
        "storage"
    ],
    "homepage": "https://www.integratedfordevelopers.com",
    "license": "MIT",
    "authors": [
        {
            "name": "Twin Digital",
            "homepage": "https://www.twindigital.nl"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.1",
        "doctrine/collections": "~1.3",
        "integrated/library": "~0.8",
        "integrated/content-bundle": "~0.8"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^2.8",
        "phpunit/phpunit": "^5.7"
    },
    "autoload": {
        "psr-4": {
            "Integrated\\Bundle\\TaxonomyBundle\\": ""
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "0.8-dev"
        }
    }
}
