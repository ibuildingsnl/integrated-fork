<?xml version="1.0" encoding="UTF-8" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>

        <defaults autowire="true" autoconfigure="true"/>

        <service id="integrated_brand.type.facebook" class="Integrated\Bundle\ContentBundle\Infrastructure\ChannelTypeFactory">
            <argument>facebook</argument>
            <argument>Facebook</argument>
            <argument type="expression">false</argument>
            <argument type="expression">true</argument>
            <argument>facebook</argument>
            <argument>\Integrated\Bundle\FacebookBundle\Form\FacebookPublicationType</argument>

            <tag name="integrated_channel.type" />
        </service>

        <service id="Integrated\Bundle\FacebookBundle\Connector\FacebookClient">
            <argument type="service" id="guzzle"/>
            <argument>%env(resolve:FACEBOOK_APP_ID)%</argument>
            <argument>%env(resolve:FACEBOOK_APP_SECRET)%</argument>
            <argument>https://www.facebook.com/v18.0</argument>
            <argument>https://graph.facebook.com/v18.0</argument>
            <argument>https://localhost.e-active.nl/admin/connector/config/external/return</argument>
            <argument type="service" id="cache.app"/>
        </service>

        <service id="Integrated\Bundle\FacebookBundle\Connector\FacebookConnector">
            <argument type="service" id="Integrated\Bundle\FacebookBundle\Connector\FacebookClient"/>
        </service>

        <service id="Integrated\Bundle\FacebookBundle\Connector\FacebookConfiguration">
            <argument type="service" id="Integrated\Bundle\FacebookBundle\Connector\FacebookClient"/>
        </service>

        <service id="Integrated\Bundle\FacebookBundle\Connector\FacebookConfigType">
            <argument type="service" id="Integrated\Bundle\FacebookBundle\Connector\FacebookClient"/>
        </service>

        <service id="Integrated\Bundle\FacebookBundle\Form\PopulateFacebookPageFieldListener" >
            <argument type="service" id="Integrated\Bundle\FacebookBundle\Connector\FacebookClient" />
        </service>

        <service id="td_connector.facebook" class="Integrated\Bundle\ChannelBundle\Adaptor\ConnectorAdapter">
            <argument type="service" id="Integrated\Bundle\FacebookBundle\Connector\FacebookConnector" />
            <argument type="service" id="Integrated\Bundle\FacebookBundle\Connector\FacebookConfiguration" />
            <argument type="service" id="logger" />

            <tag name="integrated_channel.connector" />
        </service>

        <service id="td_connector.listener.facebook" class="Integrated\Bundle\ChannelBundle\Adaptor\ConnectorConfigSubscriber">
            <argument type="service" id="Integrated\Bundle\FacebookBundle\Connector\FacebookConfiguration" />
            <argument key="$em" type="service" id="doctrine.orm.entity_manager" />

            <tag name="kernel.event_subscriber" />
        </service>
    </services>
</container>
