<doctrine-mongo-mapping xmlns="http://doctrine-project.org/schemas/odm/doctrine-mongo-mapping"
                        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                        xsi:schemaLocation="http://doctrine-project.org/schemas/odm/doctrine-mongo-mapping
                    http://doctrine-project.org/schemas/odm/doctrine-mongo-mapping.xsd">

    <document name="Integrated\Bundle\AnalyticsBundle\Document\AnalyticsData">
        <id field-name="id" strategy="auto" />
        <field field-name="channelID" type="string" />
        <field field-name="dataType" type="string" />
        <field field-name="datas" type="hash" />
        <field field-name="dateTime" type="date_immutable" />
    </document>

</doctrine-mongo-mapping>
