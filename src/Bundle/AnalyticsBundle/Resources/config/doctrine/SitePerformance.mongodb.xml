<doctrine-mongo-mapping xmlns="http://doctrine-project.org/schemas/odm/doctrine-mongo-mapping"
                        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                        xsi:schemaLocation="http://doctrine-project.org/schemas/odm/doctrine-mongo-mapping
                    http://doctrine-project.org/schemas/odm/doctrine-mongo-mapping.xsd">

    <document name="Integrated\Bundle\AnalyticsBundle\Document\SitePerformance">
        <id field-name="id" strategy="auto" />
        <field field-name="channelID" type="string" />
        <field field-name="desktopSpeedIndex" type="float" />
        <field field-name="desktopSiteScore" type="float" />
        <field field-name="desktopTimeToInteractive" type="float" />
        <field field-name="desktopServerResponseTime" type="float" />
        <field field-name="desktopTotalBlockingTime" type="float" />
        <field field-name="mobileSpeedIndex" type="float" />
        <field field-name="mobileSiteScore" type="float" />
        <field field-name="mobileTimeToInteractive" type="float" />
        <field field-name="mobileServerResponseTime" type="float" />
        <field field-name="mobileTotalBlockingTime" type="float" />
        <field field-name="dateTime" type="date_immutable" />
    </document>

</doctrine-mongo-mapping>
