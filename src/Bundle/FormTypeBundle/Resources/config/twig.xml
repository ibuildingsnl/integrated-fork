<?xml version="1.0" encoding="UTF-8" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>

        <defaults autowire="true" autoconfigure="true"/>

        <service id="Integrated\Bundle\FormTypeBundle\Twig\TailwindIconExtension">
            <argument>iconoir</argument>
            <argument>i</argument>

            <tag name="twig.extension" />
        </service>

        <service id="Integrated\Bundle\FormTypeBundle\Twig\TailwindButtonExtension">
            <argument type="service" id="Integrated\Bundle\FormTypeBundle\Twig\TailwindIconExtension" />

            <tag name="twig.extension" />
        </service>

        <service id="Integrated\Bundle\FormTypeBundle\Twig\TailwindLabelExtension">
            <tag name="twig.extension" />
        </service>

        <service id="Integrated\Bundle\FormTypeBundle\Twig\TailwindBadgeExtension">
            <tag name="twig.extension" />
        </service>

        <service id="Integrated\Bundle\FormTypeBundle\Twig\TailwindFormExtension">
            <tag name="twig.extension" />
        </service>

        <service id="Integrated\Bundle\FormTypeBundle\Twig\TwigColorTools">
            <tag name="twig.extension" />
        </service>
    </services>

</container>
