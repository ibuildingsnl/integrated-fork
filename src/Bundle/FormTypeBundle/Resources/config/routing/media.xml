<?xml version="1.0" encoding="UTF-8" ?>

<routes xmlns="http://symfony.com/schema/routing"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://symfony.com/schema/routing http://symfony.com/schema/routing/routing-1.0.xsd">

    <route id="integrated_formtype_media_image" path="/image" methods="GET">
        <default key="_controller">Integrated\Bundle\FormTypeBundle\Controller\MediaController::image</default>
    </route>

    <route id="integrated_formtype_media_gallery" path="/gallery" methods="GET">
        <default key="_controller">Integrated\Bundle\FormTypeBundle\Controller\MediaController::gallery</default>
    </route>

    <route id="integrated_formtype_media_video" path="/video" methods="GET">
        <default key="_controller">Integrated\Bundle\FormTypeBundle\Controller\MediaController::video</default>
    </route>

</routes>
