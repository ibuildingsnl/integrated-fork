{% extends '@IntegratedContent/media/select_one.html.twig' %}

{% block javascript %}
    {{ parent() }}

    <script>
        jQuery(function($) {
            window.send_cancel_to_parent = function() {
                window.parent.postMessage({mceAction: 'close'}, {{ app.request.schemeAndHttpHost|json_encode|raw }});
            }

            $(document).keyup(function(e) {
                if (e.key === "Escape") {
                    window.parent.postMessage({mceAction: 'close'}, {{ app.request.schemeAndHttpHost|json_encode|raw }});
                }
            });

            window.send_message_to_parent = function(e) {
                var media = $('#gallery li.media-item.selected');

                if (!media.length) {
                    return;
                }

                window.parent.postMessage({
                    mceAction: 'insertImage',
                    image: {
                        id: media.data('id'),
                        uri: media.data('file'),
                        title: media.data('title'),
                        description: media.data('description'),
                        credits: media.data('credits'),
                    }
                }, {{ app.request.schemeAndHttpHost|json_encode|raw }});
            };
        })
    </script>
{% endblock %}
