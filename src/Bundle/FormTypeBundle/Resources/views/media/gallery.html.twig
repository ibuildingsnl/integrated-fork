{% extends '@IntegratedContent/media/select_multiple.html.twig' %}

{% block javascript %}
    {{ parent() }}

<script>
        (function () {
            var targetOrigin = {{ app.request.schemeAndHttpHost|json_encode|raw }};
            var resolveMediaUri = window.resolveMediaPickerUri || function () { return ''; };

            var closeDialog = function () {
                window.parent.postMessage({mceAction: 'close'}, targetOrigin);
            };

            window.send_cancel_to_parent = closeDialog;

            document.addEventListener('keyup', function (e) {
                if (e.key === 'Escape') {
                    closeDialog();
                }
            });

            window.send_message_to_parent = function () {
                var mediaItems = document.querySelectorAll('#gallery li.media-item.selected');
                if (!mediaItems.length) {
                    return;
                }

                var images = Array.prototype.map.call(mediaItems, function (media) {
                    return {
                        id: media.dataset.id,
                        uri: resolveMediaUri(media),
                        thumbnail: media.dataset.thumbnail,
                        title: media.dataset.title
                    };
                });

                window.parent.postMessage({
                    mceAction: 'insertGallery',
                    images: images
                }, targetOrigin);
            };
        })();
    </script>
{% endblock %}
