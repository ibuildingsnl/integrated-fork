{% extends '@IntegratedContent/media/select_one.html.twig' %}

{% block javascript %}
{{ parent() }}

<script>
    (function () {
        var targetOrigin = {{ app.request.schemeAndHttpHost|json_encode|raw }};
        var resolveMediaUri = window.resolveMediaPickerUri || function () { return ''; };

        var closeDialog = function () {
            window.parent.postMessage({mceAction: 'close'}, targetOrigin);
        };

        window.send_cancel_to_parent = closeDialog;

        document.addEventListener('keyup', function (e) {
            if (e.key === 'Escape') {
                closeDialog();
            }
        });

        window.send_message_to_parent = function () {
            var media = document.querySelector('#gallery li.media-item.selected');
            if (!media) {
                return;
            }

            window.parent.postMessage({
                mceAction: 'insertVideo',
                video: {
                    id: media.dataset.id,
                    poster: media.dataset.thumbnail,
                    uri: resolveMediaUri(media),
                    mine: media.dataset.mime
                }
            }, targetOrigin);
        };
    })();
</script>
{% endblock %}
