{% use "@IntegratedFormType/form/tailwind.html.twig" %}

{% block integrated_ace_widget %}
    <style type="text/css" media="screen">
        #editor {
            width: 100%;
            height: 214px;
        }
    </style>

    <pre id="editor"></pre>
    <textarea id="{{ id }}" name="{{ full_name }}" hidden>{% if value is not empty %}{{ value }}{% endif %}</textarea>

    <script src="//ajax.googleapis.com/ajax/libs/jquery/3.1.1/jquery.min.js"></script>
    <script src="//cdn.jsdelivr.net/ace/1.2.6/min/ace.js"></script>
    <script>
        var editor = ace.edit('editor');
        editor.setTheme('ace/theme/xcode');
        editor.getSession().setMode('ace/mode/html');

        var content = $("#{{ id }}");

        editor.getSession().setValue(content.val());
        editor.getSession().on('change', function() {
            content.val(editor.getSession().getValue());
        });
    </script>
{% endblock %}

{% block integrated_datetime_widget %}
    {% apply spaceless %}
        <div class="input-group date form_datetime" data-locale="{{ app.request.locale }}" data-date-format="d-m-Y H:i">
            <input {{ block('widget_attributes') }} class="form-control" size="16"
                                                    type="text" {% if value is not empty %}value="{{ value }}" {% endif %}
                                                    autocomplete="off">
            <span class="input-group-append remove"><i class="fa fa-xmark"></i></span>
        </div>
    {% endapply %}
{% endblock %}

{% block integrated_color_row %}
    {% apply spaceless %}
        {{ block("form_row") }}
    {% endapply %}
{% endblock %}

{% block integrated_color_widget %}
    {% apply spaceless %}
        <div class="input-group coloris">
            <input {{ block('widget_attributes') }} class="form-control" type="text" value="{{ value }}" data-coloris>
            <span class="input-group-addon"><i></i></span>
        </div>
    {% endapply %}
{% endblock %}

{% block integrated_wysihtml5x_widget %}
    <textarea {{ block('widget_attributes') }} class="form-control integrated_wysihtml5x">{% if value is not empty %}{{ value }}{% endif %}</textarea>
{% endblock %}

{% block integrated_tinymce_row %}
    {{ block("integrated_editor_row") }}
{% endblock %}

{% block integrated_editor_row %}
    {% apply spaceless %}
        {% set state = state|default(tailwind_get_state()) %}
        <div class="form-group w-full flex flex-wrap {% if state is not empty %}{{ state }}{% endif %} widget">
            <div class="w-full">
                <div id="{{ id }}_container">
                <textarea id="{{ id }}" name="{{ full_name }}" class="form-control integrated_tinymce"
                          data-content_css="{{ content_styles.content_css|merge([asset('/bundles/integratedformtype/css/tinymce.content.css')])|join(',') }}"
                          data-format_styles="{{ content_styles.style_formats|json_encode(true) }}"
                          data-integrated_browser_media_types_url="{{ path('integrated_content_content_media_types', {'filter': '__type__'}) }}"
                          data-integrated_browser_search_url="{{ path('integrated_content_content_index', {'_format': 'json'}) }}"
                          data-integrated_browser_file_url="{{ path('integrated_storage_file', {'id': '__id__', 'ext': '__ext__'}) }}"
                          data-integrated_browser_file_resize_url="{{ path('integrated_storage_file_resize', {'id': '__id__', 'ext': '__ext__', 'width': '150', 'height': '150'}) }}"
                          placeholder="{% if attr.placeholder is defined %}{{ attr.placeholder }}{% endif %}"
                          data-mce-placeholder="{% if attr.placeholder is defined %}{{ attr.placeholder }}{% endif %}">
                    {% if value is not empty %}
                        {{ value }}
                    {% endif %}
                </textarea>
                    <!-- TODO: After TINYMCE6 implementation, make use of the dynamic placeholder -->
                </div>

                {{ block('form_errors') }}
            </div>
        </div>
    {% endapply %}
{% endblock %}

{% block checkbox_row %}
    {% apply spaceless %}
        {% set style = style|default(tailwind_get_style()) %}
        {% set state = state|default(tailwind_get_state()) %}
        {% if style == 'horizontal' and (align_widget is defined or attr.align_widget is defined) %}
            {% set align_with_widget = true %}
        {% endif %}
        {{ parent() }}
    {% endapply %}
{% endblock %}

{% block radio_row %}
    {% apply spaceless %}
        {% set style = style|default(tailwind_get_style()) %}
        {% if style == 'horizontal' and (align_widget is defined or attr.align_widget is defined) %}
            {% set align_with_widget = true %}
        {% endif %}

        {{ parent() }}
    {% endapply %}
{% endblock %}

{% block integrated_sortable_collection_widget %}
    {% apply spaceless %}
        {% if prototype is defined %}
            {% set prototype_vars = {} %}
            {% if style is defined %}
                {% set prototype_vars = prototype_vars|merge({'style': style}) %}
            {% endif %}

            {% set prototype_html = '<a data-toggle="collapse" href="#__id__"><i class="fa-regular fa-grip-dots-vertical"></i><span>' ~ field.vars.value.title|default(form.vars.default_title|default('Item')) ~ '</span></a>' %}
            {% if form.vars.allow_delete %}
                {% set prototype_html = prototype_html ~ '<a href="javascript:;" class="remove" title="' ~ 'Remove'|trans({}, translation_domain) ~ '" data-removefield="collection" data-field="__id__"><i class="fa fa-xmark"></i></a>' %}
            {% endif %}
            {% set prototype_html = '<div class="panel-heading"><h4 class="panel-title">' ~ prototype_html ~ '</h4></div>' %}
            {% set prototype_html = prototype_html ~ '<div id="__id__" class="panel-collapse collapse in"><div class="panel-body">' ~ form_widget(prototype, prototype_vars) ~ '</div></div>' %}
            {% set prototype_html = '<div class="panel panel-default">' ~ prototype_html ~ '</div>' %}

            {% set attr = attr|merge({'data-prototype': prototype_html }) %}
            {% set attr = attr|merge({'data-prototype-name': prototype_name }) %}
        {% endif %}
        <div {{ block('widget_container_attributes') }} class="sortable-collection-widget">
            <ul class="bc-collection panel-group sortable-collection ui-sortable">
                {% for field in form %}

                    <li class="ui-sortable-handle">
                        <div class="panel panel-default">
                            <div class="panel-heading">
                                <h4 class="panel-title">
                                    <a data-toggle="collapse" href="#{{ field.vars.id }}">
                                        <i class="fa-regular fa-grip-dots-vertical"></i><span>{{ field.vars.value.title|default(form.vars.default_title|default('Item')) }}</span>
                                    </a>
                                    {% if form.vars.allow_delete %}
                                        <a href="javascript:;" class="remove"
                                           title="{{ form.vars.delete_button_text|trans({}, translation_domain) }}"
                                           data-removefield="collection" data-field="{{ field.vars.id }}">
                                            <i class="fa fa-xmark"></i>
                                        </a>
                                    {% endif %}
                                </h4>
                            </div>
                            <div id="{{ field.vars.id }}"
                                 class="panel-collapse collapse{% if not field.vars.valid %} in{% endif %}">
                                <div class="panel-body">
                                    {{ form_widget(field) }}
                                    {{ form_errors(field) }}
                                </div>
                            </div>
                        </div>
                    </li>

                {% endfor %}
            </ul>

            {% if form.vars.allow_add %}
                <a href="javascript:;" class="btn" title="{{ form.vars.add_button_text|trans({}, translation_domain) }}"
                   data-addfield="collection" data-collection="{{ form.vars.id }}"
                   data-prototype-name="{{ prototype_name }}">
                    <span>{{ form.vars.add_button_text|trans({}, translation_domain) }}</span>
                    <i class="fa fa-plus"></i>
                </a>
            {% endif %}
        </div>

        {% integrated_javascripts mode='append'
            'bundles/integratedintegrated/content_sortable.js' %}
        {% endintegrated_javascripts %}
    {% endapply %}
{% endblock %}

{% block integrated_collection_widget %}
    {% apply spaceless %}
        {% if prototype is defined %}
            {% set prototype_vars = {} %}
            {% if style is defined %}
                {% set prototype_vars = prototype_vars|merge({'style': style}) %}
            {% endif %}
            {% set prototype_html = '<div class="w-full ' ~ form.vars.sub_widget_col ~ '">' ~ form_widget(prototype, prototype_vars) %}
            {% if form.vars.allow_delete %}
                {% set prototype_html = prototype_html ~ '<a href="#" class="remove" data-removefield="collection" data-field="__id__" title="Remove"><i class="fa fa-xmark"></i></a>' %}
            {% endif %}
            {% set prototype_html = '<div class="row">' ~ prototype_html ~ '</div></div>' %}

            {% set attr = attr|merge({'data-prototype': prototype_html }) %}
            {% set attr = attr|merge({'data-prototype-name': prototype_name }) %}
        {% endif %}
        <div {{ block('widget_container_attributes') }} class="collection-widget">
            <ul class="integrated-collection list-unstyled">
                {% for field in form %}
                    <li>
                        <div class="row">
                            <div class="{{ form.vars.sub_widget_col }}">
                                {{ form_widget(field) }}
                                {{ form_errors(field) }}
                            </div>
                            {% if form.vars.allow_delete %}
                                <div class="{{ form.vars.button_col }}">
                                    <a href="#" class="remove" data-removefield="collection"
                                       data-field="{{ field.vars.id }}" title="Remove">
                                        <i class="fa fa-xmark"></i>
                                    </a>
                                </div>
                            {% endif %}
                        </div>
                    </li>
                {% endfor %}
            </ul>
            {% if form.vars.allow_add %}
                <a href="#" class="btn btn-green" data-addfield="collection" data-collection="{{ form.vars.id }}"
                   data-prototype-name="{{ prototype_name }}">{{ form.vars.add_button_text|trans({}, translation_domain)|parse_icons|raw }}</a>
            {% endif %}
        </div>
    {% endapply %}
{% endblock %}

{% block integrated_content_choice_widget %}
    {% integrated_javascripts mode='prepend'
        'bundles/integratedformtype/js/content_choice.js' %}
    {% endintegrated_javascripts %}
    {% set attr = attr|merge({
        'data-ajax-url' : path(route, params),
        'data-allow-clear' : (allow_clear ? 'true' : 'false'),
        'class' : (attr.class|default('') ~ ' form-control integrated_content_choice')|trim
    }) %}
    {% apply spaceless %}
        <select {{ block('widget_attributes') }}>
            {% if multiple %}
                {{ block('integrated_content_choice_multiple') }}
            {% else %}
                {{ block('integrated_content_choice_single') }}
            {% endif %}
        </select>
    {% endapply %}
{% endblock %}

{% block integrated_content_rank_widget %}
    {% integrated_javascripts mode='prepend'
        'bundles/integratedformtype/js/content_choice.js' %}
    {% endintegrated_javascripts %}

    {% set attr = attr|merge({
        'data-ajax-url' : path(route, params|merge({'current': data})),
        'data-allow-clear' : (allow_clear ? 'true' : 'false'),
        'class' : (attr.class|default('') ~ ' form-control integrated_content_choice')|trim
    }) %}
    {% apply spaceless %}
        <select {{ block('widget_attributes') }}>
            {% if data %}
                <option value="{{ data }}" selected="selected">{% trans %}Keep current position{% endtrans %}</option>
            {% endif %}
        </select>
    {% endapply %}
{% endblock %}

{% block integrated_content_choice_single %}
    {% if data %}
        {# todo publishable title INTEGRATED-364 #}
        <option value="{{ data.id }}" selected="selected">{{ data }}</option>
    {% endif %}
{% endblock %}

{% block integrated_content_choice_multiple %}
    {% for document in data %}
        {# todo publishable title INTEGRATED-364 #}
        <option value="{{ document.id }}" selected="selected">{{ document }}</option>
    {% endfor %}
{% endblock %}

{% block integrated_relations_choice_row %}
    {{ form_widget(form) }}
    {{ form_errors(form) }}
{% endblock %}

{% block integrated_relation_references_row %}
    {{ form_row(form.children['references']) }}
    {{ form_errors(form) }}
{% endblock %}

{% block integrated_save_cancel_row %}
    {% apply spaceless %}
        <section class="section-white prefooter-holder">
            <div class="container text-center">
                {{ form_widget(form) }}
                &nbsp;
                <a class="btn btn-gray-thin integrated-cancel-button"
                   href="{{ path(cancel_route, cancel_route_parameters) }}">{% trans %}Cancel{% endtrans %}</a>
            </div><!-- container -->
        </section>
    {% endapply %}
{% endblock %}

{% block form_row %}
    {% apply spaceless %}
        {% set label_col = label_col|default(tailwind_get_label_col()) %}
        {% set widget_col = widget_col|default(tailwind_get_widget_col()) %}
        {% set show_label = show_label|default(tailwind_get_show_label()) %}
        {% set style = style|default(tailwind_get_style()) %}
        {% set icon = icon|default(tailwind_get_icon()) %}
        {% set state = state|default(tailwind_get_icon()) %}

        {% if attr.label_col is defined and attr.label_col is not empty %}
            {% set label_col = attr.label_col %}
        {% endif %}
        {% if attr.widget_col is defined and attr.widget_col is not empty %}
            {% set widget_col = attr.widget_col %}
            {% if label is same as (false) and label_col is defined %}
                {% set widget_col = widget_col + label_col %}
            {% endif %}
        {% endif %}
        {% if attr.style is defined and attr.style is not empty %}
            {% set style = attr.style %}
        {% endif %}
        {% if attr.state is defined and attr.state is not empty %}
            {% set state = attr.state %}
        {% endif %}
        {% if style == 'horizontal' %}
            <div
                class="form-item w-full flex flex-wrap {{ original_type ~ form.vars.label|lower }}{% if form.vars.errors|length > 0 %} has-error{% endif %} {% if state is not empty %}{{ state }}{% endif %}">
                {% if show_label != false %}
                    {{ form_label(form) }}
                {% endif %}
                <div class="w-full {{ widget_col }} widget">
                    {{ block('form_input_group') }}
                    {{ block('form_help') }}
                    {{ form_errors(form) }}
                </div>
            </div>
        {% elseif style == 'sidebar' %}
            <div
                class="aside-item-wrapper{% if form.vars.errors|length > 0 %} has-error show{% endif %} {% if state is not empty %}{{ state }}{% endif %}">
                <div class="aside-item-header">
                    <h3 class="aside-item-title">
                        <i class="fa-regular {% if icon is not empty %}{{ icon }}{% else %}fa-folder-closed{% endif %}"></i>
                        <span class="aside-item-icon">
                            {{ form_label(form) }}
                        </span>
                    </h3>
                    <i class="fa-regular fa-chevron-up"></i>
                </div>
                <div class="aside-item-list">
                    <div class="aside-item-list-container">
                        {{ block('form_input_group') }}
                        {{ block('form_help') }}
                        {{ form_errors(form) }}
                    </div>
                </div>
            </div>
        {% elseif style == 'editor' %}
            <div
                class="editor-item-wrapper{% if form.vars.errors|length > 0 %} has-error show{% endif %} {% if state is not empty %}{{ state }}{% endif %}">
                <div class="editor-item-header">
                    <h3 class="editor-item-title">
                        <span class="editor-item-icon">
                            {{ form_label(form) }}
                        </span>
                    </h3>
                    <i class="fa-regular fa-chevron-up"></i>
                </div>
                <div class="editor-item-list">
                    <div class="editor-item-list-container">
                        {{ block('form_input_group') }}
                        {{ block('form_help') }}
                        {{ form_errors(form) }}
                    </div>
                </div>
            </div>
        {% else %}
            <div class="form-item{% if form.vars.errors|length > 0 %} has-error{% endif %}">
                {% if show_label != false %}
                    {{ form_label(form) }}
                {% endif %}
                {{ block('form_input_group') }}
                {{ block('form_help') }}
                {{ form_errors(form) }}
            </div>
        {% endif %}
    {% endapply %}
{% endblock form_row %}
