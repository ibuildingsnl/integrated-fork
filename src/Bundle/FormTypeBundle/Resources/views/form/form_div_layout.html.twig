{% use "@IntegratedFormType/form/tailwind.html.twig" %}

{% block integrated_ace_widget %}
    <style type="text/css" media="screen">
        #editor {
            width: 100%;
            height: 214px;
        }
    </style>

    <pre id="editor"></pre>
    <textarea id="{{ id }}" name="{{ full_name }}" hidden>{% if value is not empty %}{{ value }}{% endif %}</textarea>

    <script src="//ajax.googleapis.com/ajax/libs/jquery/3.1.1/jquery.min.js"></script>
    <script src="//cdn.jsdelivr.net/ace/1.2.6/min/ace.js"></script>
    <script>
        var editor = ace.edit('editor');
        editor.setTheme('ace/theme/xcode');
        editor.getSession().setMode('ace/mode/html');

        var content = $("#{{ id }}");

        editor.getSession().setValue(content.val());
        editor.getSession().on('change', function() {
            content.val(editor.getSession().getValue());
        });
    </script>
{% endblock %}

{% block integrated_datetime_widget %}
    {% apply spaceless %}
        <div class="input-group date form_datetime" data-locale="{{ app.request.locale }}" data-date-format="d-m-Y H:i">
            <input {{ block('widget_attributes') }} class="form-control" size="16"
                                                    type="text" {% if value is not empty %}value="{{ value }}" {% endif %}
                                                    autocomplete="off">
            <span class="input-group-append remove"><i class="iconoir-cancel"></i></span>
        </div>
    {% endapply %}
{% endblock %}

{% block integrated_color_row %}
    {% apply spaceless %}
        {{ block("form_row") }}
    {% endapply %}
{% endblock %}

{% block integrated_color_widget %}
    {% apply spaceless %}
        <div class="input-group coloris">
            <input {{ block('widget_attributes') }} class="form-control" type="text" value="{{ value }}" data-coloris>
            <span class="input-group-addon"><i></i></span>
        </div>
    {% endapply %}
{% endblock %}

{% block integrated_wysihtml5x_widget %}
    <textarea {{ block('widget_attributes') }} class="form-control integrated_wysihtml5x">{% if value is not empty %}{{ value }}{% endif %}</textarea>
{% endblock %}

{% block integrated_tinymce_row %}
    {{ block("integrated_editor_row") }}
{% endblock %}

{% block integrated_editor_row %}
    {% apply spaceless %}
        {% set state = state|default(tailwind_get_state()) %}
        {% set label_col = label_col|default(tailwind_get_label_col()) %}
        {% set widget_col = widget_col|default(tailwind_get_widget_col()) %}
        {% set style = style|default(tailwind_get_style()) %}
        {% if attr.state is defined and attr.state is not empty %}
            {% set state = attr.state %}
        {% endif %}
        {% if attr.style is defined and attr.style is not empty %}
            {% set style = attr.style %}
        {% endif %}

        {% if state != 'fancy_tinymce' %}
            {% set styles = '/bundles/integratedformtype/css/tinymce.content.css' %}
        {% else %}
            {% set styles = '/bundles/integratedformtype/css/tinymce-fancy.content.css' %}
        {% endif %}

        {% if style == 'editor' %}
            <div class="editor-item-wrapper{% if form.vars.errors|length > 0 %} has-error show{% endif %} {% if state is not empty %}{{ state }}{% endif %}">
            <div class="editor-item-header">
                <h3 class="editor-item-title">
                            <span class="editor-item-icon">
                                {{ form_label(form) }}
                            </span>
                </h3>
                <i class="iconoir-nav-arrow-up"></i>
            </div>
            <div class="editor-item-list">
            <div class="editor-item-list-container">
        {% else %}
            <div class="form-group w-full flex flex-wrap {% if state is not empty %}{{ state }}{% endif %} widget">
            {% if state != 'fancy_tinymce' %}
                {% if label is empty and label is not same as (false) %}
                    {% set label = name|humanize %}
                {% endif %}
                {% set class = 'tinymce-inline w-full ' ~ widget_col ~ ' widget' %}
                <label class="control-label {{ label_col }}">{{ label }}</label>
            {% else %}
                {% set class = 'w-full' %}
            {% endif %}
            <div class="{{ class }}">
        {% endif %}
        <div id="{{ id }}_container">
                <textarea id="{{ id }}" name="{{ full_name }}" class="form-control integrated_tinymce"
                          data-content_css="{{ content_styles.content_css|merge([asset(styles)])|join(',') }}"
                          data-format_styles="{{ content_styles.style_formats|json_encode(true) }}"
                          data-integrated_browser_image_dialog_url="{{ path('integrated_formtype_media_image') }}"
                          data-integrated_browser_gallery_dialog_url="{{ path('integrated_formtype_media_gallery') }}"
                          data-integrated_browser_video_dialog_url="{{ path('integrated_formtype_media_video') }}"
                          placeholder="{% if attr.placeholder is defined %}{{ attr.placeholder }}{% endif %}"
                          data-mce-placeholder="{% if attr.placeholder is defined %}{{ attr.placeholder }}{% endif %}">
                    {% if value is not empty %}
                        {{ value }}
                    {% endif %}
                </textarea>
        </div>
        {{ block('form_errors') }}
        {% if style == 'editor' %}
            </div>
            </div>
            </div>
        {% else %}
            </div>
            </div>
        {% endif %}
    {% endapply %}
{% endblock %}

{% block checkbox_row %}
    {% apply spaceless %}
        {% set style = style|default(tailwind_get_style()) %}
        {% set state = state|default(tailwind_get_state()) %}
        {% if style == 'horizontal' and (align_widget is defined or attr.align_widget is defined) %}
            {% set align_with_widget = true %}
        {% endif %}
        {{ parent() }}
    {% endapply %}
{% endblock %}

{% block radio_row %}
    {% apply spaceless %}
        {% set style = style|default(tailwind_get_style()) %}
        {% if style == 'horizontal' and (align_widget is defined or attr.align_widget is defined) %}
            {% set align_with_widget = true %}
        {% endif %}

        {{ parent() }}
    {% endapply %}
{% endblock %}

{% block integrated_sortable_collection_widget %}
    {% apply spaceless %}
        {% if prototype is defined %}
            {% set prototype_vars = {} %}
            {% if style is defined %}
                {% set prototype_vars = prototype_vars|merge({'style': style}) %}
            {% endif %}

            {% if (form.vars.attr.show_headings is not defined or form.vars.attr.show_headings == 'true') %}
                {% set panel_heading = 'true' %}
            {% endif %}

            {% if (panel_heading is defined and panel_heading == 'true') %}
                {% set prototype_html = '<a data-toggle="collapse"><i class="iconoir-line-space"></i><span>' ~ form.vars.default_title|default('Item') ~ '</span></a>' %}
                {% if form.vars.allow_delete %}
                    {% set prototype_html = prototype_html ~ '<a href="javascript:;" class="remove" title="' ~ 'Remove'|trans({}, translation_domain) ~ '" data-removefield="collection" data-field="__id__"><i class="iconoir-cancel"></i></a>' %}
                {% endif %}
                {% set prototype_html = '<div class="panel-heading"><h4 class="panel-title">' ~ prototype_html ~ '</h4></div>' %}
                {% set prototype_html = prototype_html ~ '<div id="__id__" class="panel-collapse collapse in"><div class="panel-body">' ~ form_widget(prototype, prototype_vars) ~ '</div></div>' %}
                {% set prototype_html = '<div class="panel panel-default in">' ~ prototype_html ~ '</div>' %}
            {% else %}
                {% set prototype_html = '<div id="__id__" class="panel-collapse collapse in"><div class="panel-body"><i class="iconoir-line-space"></i>' ~ form_widget(prototype, prototype_vars) %}
                {% if form.vars.allow_delete %}
                    {% set prototype_html = prototype_html ~ '<a href="javascript:;" class="remove" title="' ~ 'Remove'|trans({}, translation_domain) ~ '" data-removefield="collection" data-field="__id__"><i class="iconoir-cancel"></i></a>' %}
                {% endif %}
                {% set prototype_html = prototype_html ~ '</div></div>' %}
                {% set prototype_html = '<div class="panel panel-default in">' ~ prototype_html ~ '</div>' %}
            {% endif %}

            {% set attr = attr|merge({'data-prototype': prototype_html }) %}
            {% set attr = attr|merge({'data-prototype-name': prototype_name }) %}
            {% set attr = attr|merge({ 'class': ('sortable-collection-widget '~attr.class|default(''))|trim }) %}
        {% endif %}
        <div {{ block('widget_container_attributes') }} class="">
            <ul class="bc-collection panel-group sortable-collection ui-sortable {% if (panel_heading is not defined) %}no-heading{% endif %}">
                {% for field in form %}

                    <li class="ui-sortable-handle">
                        <div class="panel panel-default">
                            {% if (panel_heading is defined and panel_heading == 'true') %}
                                <div class="panel-heading">
                                    <h4 class="panel-title">
                                        <a data-toggle="collapse">
                                            <i class="iconoir-line-space"></i>
                                            <span>
                                            {{ field.vars.value.title|
                                            default(field.vars.value.name|
                                                default(field.vars.value.label|
                                                    default(field.vars.value.block|
                                                        default(field.vars.value.text|
                                                            default(form.vars.default_title|
                                                                default('Item'))))))|raw }}
                                        </span>
                                        </a>
                                        {% if form.vars.allow_delete %}
                                            <a href="javascript:;" class="remove"
                                               title="{{ form.vars.delete_button_text|trans({}, translation_domain) }}"
                                               data-removefield="collection" data-field="{{ field.vars.id }}">
                                                <i class="iconoir-cancel"></i>
                                            </a>
                                        {% endif %}
                                    </h4>
                                </div>
                            {% endif %}
                            <div id="{{ field.vars.id }}"
                                 class="panel-collapse collapse{% if not field.vars.valid %} in{% endif %}">
                                <div class="panel-body">
                                    {% if (panel_heading is not defined) %}
                                        <i class="iconoir-line-space"></i>
                                    {% endif %}
                                    {{ form_widget(field) }}
                                    {{ form_errors(field) }}
                                    {% if (panel_heading is not defined) %}
                                        {% if form.vars.allow_delete %}
                                            <a href="javascript:;" class="remove"
                                               title="{{ form.vars.delete_button_text|trans({}, translation_domain) }}"
                                               data-removefield="collection" data-field="{{ field.vars.id }}">
                                                <i class="iconoir-cancel"></i>
                                            </a>
                                        {% endif %}
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    </li>

                {% endfor %}
            </ul>

            {% if form.vars.allow_add %}
                <a href="javascript:;" class="btn btn-blue"
                   title="{{ form.vars.add_button_text|trans({}, translation_domain) }}"
                   data-addfield="collection" data-collection="{{ form.vars.id }}"
                   data-prototype-name="{{ prototype_name }}">
                    <span>{{ form.vars.add_button_text|trans({}, translation_domain) }}</span>
                    <i class="iconoir-plus"></i>
                </a>
            {% endif %}
        </div>

        {% integrated_javascripts mode='append'
            'bundles/integratedintegrated/content_sortable.js' %}
        {% endintegrated_javascripts %}
    {% endapply %}
{% endblock %}

{% block integrated_collection_widget %}
    {% apply spaceless %}
        {% set delete_button_text = form.vars.delete_button_text %}
        {% set add_button_text = form.vars.add_button_text %}
        {% if translation_domain is not same as (false) %}
            {% set delete_button_text = delete_button_text|trans({}, translation_domain) %}
            {% set add_button_text = add_button_text|trans({}, translation_domain) %}
        {% endif %}
        {% if prototype is defined %}
            {% set prototype_vars = {} %}
            {% if style is defined %}
                {% set prototype_vars = prototype_vars|merge({'style': style}) %}
            {% endif %}
            {% if (form.vars.attr.show_headings is not defined or form.vars.attr.show_headings == 'true') %}
                {% set panel_heading = 'true' %}
            {% endif %}

            {% if (panel_heading is defined and panel_heading == 'true') %}
                {% set prototype_html = '<a data-toggle="collapse"><i class="iconoir-nav-arrow-down"></i><span>' ~ form.vars.default_title|default('Item') ~ '</span></a>' %}
                {% if form.vars.allow_delete %}
                    {% set prototype_html = prototype_html ~ '<a href="javascript:;" class="remove" title="' ~ 'Remove'|trans({}, translation_domain) ~ '" data-removefield="collection" data-field="__id__"><i class="iconoir-cancel"></i></a>' %}
                {% endif %}
                {% set prototype_html = '<div class="panel-heading"><h4 class="panel-title">' ~ prototype_html ~ '</h4></div>' %}
                {% set prototype_html = prototype_html ~ '<div id="__id__" class="panel-collapse collapse in"><div class="panel-body">' ~ form_widget(prototype, prototype_vars) ~ '</div></div>' %}
            {% else %}
                {% set prototype_html = '<div id="__id__" class="panel-collapse collapse in"><div class="panel-body">' ~ form_widget(prototype, prototype_vars) %}
                {% if form.vars.allow_delete %}
                    {% set prototype_html = prototype_html ~ '<a href="javascript:;" class="remove" title="' ~ 'Remove'|trans({}, translation_domain) ~ '" data-removefield="collection" data-field="__id__"><i class="iconoir-cancel"></i></a>' %}
                {% endif %}
                {% set prototype_html = prototype_html ~ '</div></div>' %}
            {% endif %}
            {% set prototype_html = '<div class="panel panel-default in">' ~ prototype_html ~ '</div>' %}

            {% set attr = attr|merge({'data-prototype': prototype_html }) %}
            {% set attr = attr|merge({'data-prototype-name': prototype_name }) %}
            {% set attr = attr|merge({ 'class': ('collection-widget '~attr.class|default(''))|trim }) %}

        {% endif %}
        <div {{ block('widget_container_attributes') }}>
            <ul class="bc-collection list-table {% if (panel_heading is not defined) %}no-heading{% endif %}">
                {% for field in form %}
                    <li>
                        <div class="panel panel-default">
                            {% if (panel_heading is defined and panel_heading == 'true') %}
                                <div class="panel-heading">
                                    <h4 class="panel-title">
                                        <a data-toggle="collapse">
                                            <i class="iconoir-nav-arrow-down"></i>
                                            <span class="capitalize">
                                                {{ field.vars.value.title|
                                                default(field.vars.value.name|
                                                    default(field.vars.value.label|
                                                        default(field.vars.value.block|
                                                            default(field.vars.value.text|
                                                                default(field.vars.value.frequency|
                                                                    default(form.vars.default_title|
                                                                        default('Item')))))))|raw }}
                                            </span>
                                        </a>
                                        {% if form.vars.allow_delete %}
                                            <a href="javascript:;" class="remove"
                                               title="{{ form.vars.delete_button_text|trans({}, translation_domain) }}"
                                               data-removefield="collection" data-field="{{ field.vars.id }}">
                                                <i class="iconoir-cancel"></i>
                                            </a>
                                        {% endif %}
                                    </h4>
                                </div>
                            {% endif %}
                            <div id="{{ field.vars.id }}"
                                 class="panel-collapse collapse{% if not field.vars.valid %} in{% endif %}">
                                <div class="panel-body">
                                    {{ form_widget(field) }}
                                    {{ form_errors(field) }}
                                    {% if (panel_heading is not defined) %}
                                        {% if form.vars.allow_delete %}
                                            <a href="javascript:;" class="remove"
                                               title="{{ form.vars.delete_button_text|trans({}, translation_domain) }}"
                                               data-removefield="collection" data-field="{{ field.vars.id }}">
                                                <i class="iconoir-cancel"></i>
                                            </a>
                                        {% endif %}
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    </li>
                {% endfor %}
            </ul>
            {% if form.vars.allow_add %}
                <a href="#" class="{{ form.vars.add_button_class }}" data-addfield="collection"
                   data-collection="{{ form.vars.id }}"
                   data-prototype-name="{{ prototype_name }}">
                    <span>{{ add_button_text|trans({}, translation_domain) }}</span>
                    <i class="iconoir-plus"></i>
                </a>
            {% endif %}
        </div>
    {% endapply %}
{% endblock %}

{% block integrated_content_choice_widget %}
    {% integrated_javascripts mode='prepend'
        'bundles/integratedformtype/js/content_choice.js' %}
    {% endintegrated_javascripts %}
    {% set attr = attr|merge({
        'data-ajax-url' : path(route, params),
        'data-allow-clear' : (allow_clear ? 'true' : 'false'),
        'class' : (attr.class|default('') ~ ' form-control integrated_content_choice')|trim
    }) %}
    {% apply spaceless %}
        <select {{ block('widget_attributes') }}>
            {% if multiple %}
                {{ block('integrated_content_choice_multiple') }}
            {% else %}
                {{ block('integrated_content_choice_single') }}
            {% endif %}
        </select>
    {% endapply %}
{% endblock %}

{% block integrated_content_rank_widget %}
    {% integrated_javascripts mode='prepend'
        'bundles/integratedformtype/js/content_choice.js' %}
    {% endintegrated_javascripts %}

    {% set attr = attr|merge({
        'data-ajax-url' : path(route, params|merge({'current': data})),
        'data-allow-clear' : (allow_clear ? 'true' : 'false'),
        'class' : (attr.class|default('') ~ ' form-control integrated_content_choice')|trim
    }) %}
    {% apply spaceless %}
        <select {{ block('widget_attributes') }}>
            {% if data %}
                <option value="{{ data }}"
                        selected="selected">{% trans %}Keep current position{% endtrans %}</option>
            {% endif %}
        </select>
    {% endapply %}
{% endblock %}

{% block integrated_content_parent_id_widget %}
    {% integrated_javascripts mode='prepend'
        'bundles/integratedformtype/js/parent_choice.js' %}
    {% endintegrated_javascripts %}

    {% set attr = attr|merge({
        'data-ajax-url' : path(route, params|merge({'current': data})|merge({'contentType': form.vars.form.parent.vars.value.contentType})),
        'data-allow-clear' : (allow_clear ? 'true' : 'false'),
        'class' : (attr.class|default('') ~ ' form-control integrated_content_choice')|trim,
    }) %}
    {% set currentData = integrated_document(data) %}
    {% set parentPath = integrated_content_path(currentData)|join(' > ') %}

    {% apply spaceless %}
        <select {{ block('widget_attributes') }}>
            {% if data %}
                <option value="{{ data }}" selected="selected">
                    {% if parentPath is defined and parentPath != "" %}
                        {{ parentPath }} >
                    {% endif %}
                    {{ currentData.title }}
                </option>
            {% endif %}
        </select>
    {% endapply %}
{% endblock %}

{% block integrated_content_choice_single %}
    {% if data %}
        {# todo publishable title INTEGRATED-364 #}
        <option value="{{ data.id }}" selected="selected">{{ data }}</option>
    {% endif %}
{% endblock %}

{% block integrated_content_choice_multiple %}
    {% for document in data %}
        {# todo publishable title INTEGRATED-364 #}
        <option value="{{ document.id }}" selected="selected">{{ document }}</option>
    {% endfor %}
{% endblock %}

{% block integrated_relations_choice_row %}
    {{ form_widget(form) }}
    {{ form_errors(form) }}
{% endblock %}

{% block integrated_relation_references_row %}
    {{ form_row(form.children['references']) }}
    {{ form_errors(form) }}
{% endblock %}

{% block integrated_save_cancel_row %}
    {% apply spaceless %}
        <section class="section-white prefooter-holder">
            <div class="container text-center">
                {{ form_widget(form) }}
                &nbsp;
                <a class="btn btn-gray-thin integrated-cancel-button"
                   href="{{ path(cancel_route, cancel_route_parameters) }}">{% trans %}Cancel{% endtrans %}</a>
            </div><!-- container -->
        </section>
    {% endapply %}
{% endblock %}

{% block form_row %}
    {% apply spaceless %}
        {% set label_col = label_col|default(tailwind_get_label_col()) %}
        {% set widget_col = widget_col|default(tailwind_get_widget_col()) %}
        {% set show_label = show_label|default(tailwind_get_show_label()) %}
        {% set style = style|default(tailwind_get_style()) %}
        {% set icon = icon|default(tailwind_get_icon()) %}
        {% set state = state|default(tailwind_get_icon()) %}

        {% if attr.label_col is defined and attr.label_col is not empty %}
            {% set label_col = attr.label_col %}
        {% endif %}
        {% if attr.icon is defined and attr.icon is not empty %}
            {% set icon = attr.icon %}
        {% endif %}
        {% if attr.widget_col is defined and attr.widget_col is not empty %}
            {% set widget_col = attr.widget_col %}
            {% if label is same as (false) and label_col is defined %}
                {% set widget_col = widget_col + label_col %}
            {% endif %}
        {% endif %}
        {% if attr.style is defined and attr.style is not empty %}
            {% if style is empty %}
                {% set style = attr.style %}
            {% endif %}
        {% endif %}
        {% if attr.state is defined and attr.state is not empty %}
            {% if state is empty %}
                {% set state = attr.state %}
            {% endif %}
        {% endif %}
        {% if style == 'sidebar' %}
            <div
                class="aside-item-wrapper {{ form.vars.name }}{% if form.vars.errors|length > 0 %} has-error show{% endif %} {% if state is not empty %}{{ state }}{% endif %}">
                <div class="aside-item-header">
                    <h3 class="aside-item-title">
                        <i class="iconoir-{% if icon is not empty %}{{ icon }}{% else %}folder{% endif %}"></i>
                        <span class="aside-item-icon">
                            {{ form_label(form) }}
                        </span>
                    </h3>
                    <i class="iconoir-nav-arrow-up"></i>
                </div>
                <div class="aside-item-list">
                    <div class="aside-item-list-container">
                        {{ block('form_input_group') }}
                        {{ block('form_help') }}
                        {{ form_errors(form) }}
                    </div>
                </div>
            </div>
        {% elseif style == 'editor' %}
            <div
                class="editor-item-wrapper {{ form.vars.name }}{% if form.vars.errors|length > 0 %} has-error show{% endif %} {% if state is not empty %}{{ state }}{% endif %}">
                <div class="editor-item-header">
                    <h3 class="editor-item-title">
                        <span class="editor-item-icon">
                            {{ form_label(form) }}
                        </span>
                    </h3>
                    <i class="iconoir-nav-arrow-up"></i>
                </div>
                <div class="editor-item-list">
                    <div class="editor-item-list-container">
                        {{ block('form_input_group') }}
                        {{ block('form_help') }}
                        {{ form_errors(form) }}
                    </div>
                </div>
            </div>
        {% elseif style == 'none' %}
            {{ block('form_input_group') }}
            {{ block('form_help') }}
            {{ form_errors(form) }}
        {% else %}
            <div
                class="form-item w-full flex flex-wrap {{ form.vars.name }} {{ original_type ~ form.vars.label|lower }}{% if form.vars.errors|length > 0 %} has-error{% endif %} {% if state is not empty %}{{ state }}{% endif %}">
                {% if show_label is not same as ('false') %}
                    {{ form_label(form) }}
                {% endif %}
                <div class="w-full {% if style != 'inline' %}{{ widget_col }}{% endif %} widget">
                    {{ block('form_input_group') }}
                    {{ block('form_help') }}
                    {{ form_errors(form) }}
                </div>
            </div>
        {% endif %}
    {% endapply %}
{% endblock form_row %}


{% block integrated_media_gallery_image_widget %}
    {% apply spaceless %}
        <div class="mediagallery_selector" id="{{ form.vars.id }}">
            <ul class="previously_selected_images hidden">
                {% if form.vars.value is defined and form.vars.value is not empty %}
                    {% set imageArray = form.vars.value|split(',') %}
                    {% if imageArray|length > 0 %}
                        {% for media in imageArray %}
                            {% if integrated_document(media).file is defined %}
                                {% set image = integrated_document(media).file %}
                                {% set thumbnail = integrated_image(image).resize(200, 200) %}
                                <li id="{{ media }}"
                                    data-id="{{ media }}"
                                    data-file="{{ image }}"
                                    data-thumbnail="{{ thumbnail }}">
                                </li>
                            {% endif %}
                        {% endfor %}
                    {% endif %}
                {% endif %}
            </ul>

            <div class="selected_images flex flex-wrap mb-4"
                 data-multiple="{{ form.vars.attr['data-multiple'] }}"
                 data-types="{{ form.vars.attr['data-types'] }}"
                 data-relationtype="embedded"
                 data-relationid="{{ form.vars.id }}"
                 data-emptytext="{{ form.vars.attr['data-emptytext'] ?: 'Select ' ~ (form.vars.name) }}"
                 data-fieldName="{{ form.vars.full_name }}">
            </div>

            <div
                data-multiple="{{ form.vars.attr['data-multiple'] }}"
                data-types="{{ form.vars.attr['data-types'] }}"
                data-relationtype="embedded"
                data-relationid="{{ form.vars.id }}"
                class="select_multimedia_button btn btn-white">
                {% trans %}Select{% endtrans %} {{ label ?: (form.vars.name) }}
            </div>

            <div class="wrap iframe-wrapper close-outside">
                <iframe class="iframe media-library" src="">
                </iframe>
            </div>

            <ul class="selected_images hidden">
                <li id="selected_image" class="hidden media-item">
                    <div class="media-preview">
                        <div class="thumbnail relative">
                            <div class="centered">
                                <img src="">
                            </div>
                            <a class="remove_link remove"><i class="iconoir-cancel"></i></a>
                        </div>
                    </div>
                </li>
            </ul>
            <script src="{{ asset('bundles/integratedintegrated/mediagallery_selection.js') }}"></script>
            {{ form_errors(form) }}
            <input hidden type="text" class="w-full" name="{{ form.vars.full_name }}">
        </div>
    {% endapply %}

{% endblock %}
