<?xml version="1.0" encoding="UTF-8" ?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services
        http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>

        <defaults autowire="true" autoconfigure="true"/>

        <prototype namespace="Integrated\Bundle\BrandBundle\Controller\" resource="../../Controller/*" />

        <service id="integrated_brand.brand.odm.repository" class="Doctrine\ODM\MongoDB\Repository\DocumentRepository">
            <factory service="doctrine_mongodb.odm.document_manager" method="getRepository" />
            <argument type="string">\Integrated\Bundle\BrandBundle\Document\Brand</argument>
        </service>

        <service id="integrated_brand.brand.repository" class="Integrated\Bundle\BrandBundle\Infrastructure\ODMBrandRepository">
            <argument type="service" id="doctrine_mongodb.odm.document_manager" />
            <argument type="service" id="integrated_brand.brand.odm.repository" />
        </service>

        <service id="Integrated\Bundle\BrandBundle\Controller\BrandController">
            <argument type="service" id="integrated_brand.brand.repository" />
            <argument type="service" id="integrated_channel.channel_type.registry" />
            <argument type="service" id="integrated_content.form.factory.event_dispatcher"/>
            <argument type="service" id="integrated_content.services.flusher"/>
        </service>

        <service id="Integrated\Bundle\BrandBundle\Controller\ChannelLinkController">
            <argument type="service" id="integrated_channel.channel_type.registry" />
            <argument type="service" id="event_dispatcher" />
            <argument type="service" id="integrated_content.services.flusher"/>
            <argument type="service" id="doctrine_mongodb.odm.document_manager" />
        </service>

        <service id="Integrated\Bundle\BrandBundle\Controller\ConnectorController">
            <argument type="service" id="integrated_channel.config.manager" />
            <argument type="service" id="integrated_channel.adapter.registry" />
            <argument type="service" id="event_dispatcher" />
        </service>

        <service id="Integrated\Bundle\BrandBundle\Form\Type\BrandChoiceType">
            <argument type="service" id="integrated_brand.brand.repository" />

            <tag name="form.type" />
        </service>

        <service id="integrated_brand.form.channel.link.type" class="Integrated\Bundle\BrandBundle\Form\Type\ChannelLinkType">
            <argument type="service" id="translator"/>
            <argument type="service" id="integrated_channel.channel_type.registry" />

            <tag name="form.type" />
        </service>

        <service id="integrated_brand.event_listener.configure_menu_subscriber" class="Integrated\Bundle\BrandBundle\EventListener\ConfigureMenuSubscriber">
            <argument type="service" id="security.authorization_checker" />
            <tag name="kernel.event_subscriber" />
        </service>

        <service id="integrated_brand.event_listener.content.brand" class="Integrated\Bundle\BrandBundle\EventListener\ContentBrandIntegrationListener">
            <argument type="service" id="security.authorization_checker" />
            <argument type="service" id="integrated_brand.brand.repository" />
            <argument type="service" id="integrated_channel.repository.channel" />
            <argument type="service" id="integrated_asset.manager.javascript_manager" />
            <argument type="service" id="integrated_asset.manager.stylesheet_manager" />
            <tag name="integrated_content.form.event_subscriber"/>
        </service>

        <service id="integrated_brand.event_listener.connector.deletion" class="Integrated\Bundle\BrandBundle\EventListener\ConnectorDeletionRedirectListener">
            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="integrated_brand.event_listener.connector.external.return" class="Integrated\Bundle\BrandBundle\EventListener\ExternalReturnRedirectListener">
            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="integrated_brand.event_listener.solr.brand_facet" class="Integrated\Bundle\BrandBundle\Solr\EventListener\BrandFacetListener">

            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="integrated_brand.solr.brand.extension" class="Integrated\Bundle\BrandBundle\Solr\Extension\BrandExtension">
            <argument type="service" id="integrated_brand.brand.repository" />

            <tag name="integrated_solr.type_extension" />
        </service>

        <service id="integrated_brand.twig_title.brand" class="Integrated\Bundle\BrandBundle\Twig\Resolver\BrandTitleResolver">
            <argument type="service" id="integrated_brand.brand.repository" />
        </service>

        <service id="Integrated\Bundle\BrandBundle\Twig\Extension\BrandExtension">
            <argument type="service" id="integrated_brand.brand.repository" />

            <tag name="twig.extension"/>
        </service>

        <service id="integrated_brand.facet_setting.brand" class="Integrated\Bundle\ContentBundle\Twig\FacetSettings">
            <argument>brands</argument>
            <argument type="expression">true</argument>
            <argument type="service" id="integrated_brand.twig_title.brand" />
            <tag name="integrated_content.facet_setting" />
        </service>

        <service id="integrated_content.facet_setting.channel" class="Integrated\Bundle\ContentBundle\Twig\FacetSettings">
            <argument>channels</argument>
            <argument type="expression">false</argument>
            <argument type="service" id="integrated_content.twig_title.channel" />
            <tag name="integrated_content.facet_setting" />
        </service>

        <service id="Integrated\Bundle\BrandBundle\Services\LinkTypeSettingsProvider"
                 decorates="Integrated\Bundle\ContentBundle\Services\PublicationSettingsProviderInterface">
            <argument type="service" id="integrated_brand.brand.repository" />
            <argument type="service" id=".inner"/>
        </service>

    </services>
</container>
