<doctrine-mongo-mapping xmlns="http://doctrine-project.org/schemas/odm/doctrine-mongo-mapping"
                        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                        xsi:schemaLocation="http://doctrine-project.org/schemas/odm/doctrine-mongo-mapping
                    http://doctrine-project.org/schemas/odm/doctrine-mongo-mapping.xsd">

    <document name="Integrated\Bundle\BrandBundle\Document\LinkType">

        <id field-name="id" strategy="NONE" />
        <field field-name="name" type="string" />
        <field field-name="canBePrimary" type="boolean" />
        <field field-name="connector" type="string" nullable="true" />
        <field field-name="publicationSettingsForm" type="string" nullable="true" />

    </document>
</doctrine-mongo-mapping>
