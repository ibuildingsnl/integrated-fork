<doctrine-mongo-mapping xmlns="http://doctrine-project.org/schemas/odm/doctrine-mongo-mapping"
                        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                        xsi:schemaLocation="http://doctrine-project.org/schemas/odm/doctrine-mongo-mapping
                    http://doctrine-project.org/schemas/odm/doctrine-mongo-mapping.xsd">

    <document name="Integrated\Bundle\BrandBundle\Document\BrandProfile" collection="brand_profile">

        <id field-name="id" strategy="NONE" />
        <field field-name="name" type="string" />
        <field field-name="color" type="string" />
        <field field-name="secondaryColor" type="string" />
        <field field-name="vat" type="string" />
        <field field-name="companyId" type="string" />
        <field field-name="analytics" type="string" />
        <field field-name="analyticsPropertyId" type="string" />
        <reference-one field="logo" target-document="Integrated\Bundle\ContentBundle\Document\Content\Image" />
        <reference-one field="favicon" target-document="Integrated\Bundle\ContentBundle\Document\Content\Image" />
        <embed-many field="contacts" target-document="Integrated\Bundle\ContentBundle\Document\Content\Embedded\Contact" />
        <embed-many field="socials" target-document="Integrated\Bundle\ContentBundle\Document\Content\Embedded\Social" />

    </document>
</doctrine-mongo-mapping>
