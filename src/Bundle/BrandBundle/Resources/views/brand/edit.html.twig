{% extends '@IntegratedContent/base.html.twig' %}
{% block title %}
    {% if brand|default %}
        {% trans %}Edit {% endtrans %} {{ brand.name }}
    {% else %}
        {% trans %}New brand{% endtrans %}
    {% endif %}
{% endblock title %}
{% block style %}
    {{ parent() }}

    <link rel="stylesheet" href="{{ asset('bundles/integratedintegrated/edit.css') }}">
{% endblock %}

{% block content %}
    <div class="flex flex-wrap edit-form">
        {% block form_start %}
            {{ form_start(form) }}
        {% endblock %}
        {% block toolbar %}
            {% include '@IntegratedContent/partials/block.toolbar.html.twig' %}
        {% endblock toolbar %}
        <div class="aside-options">
            <aside>
                <div class="aside-holder">
                    {% block sidebar %}
                        <div class="aside-header">
                            <button class="toggle-filters toggle-options-sidebar"  data-target="aside-options" type="button">
                                <i class="iconoir-cancel"></i></button>
                            <span>{% trans %}Options{% endtrans %}</span>
                        </div>
                        {% block content_meta %}
                            {% for child in form|filter(row => row.vars.attr.location|default == constant('Integrated\\Common\\Form\\Mapping\\Attributes\\Field::LOCATION_SIDEBAR')) %}
                                {{ form_row(child) }}
                            {% endfor %}
                            {% for child in form.profile|filter(row => row.vars.attr.location|default == constant('Integrated\\Common\\Form\\Mapping\\Attributes\\Field::LOCATION_SIDEBAR')) %}
                                {{ form_row(child) }}
                            {% endfor %}
                        {% endblock %}
                    {% endblock %}
                </div>
            </aside>
        </div>
        <div class="editor-wrapper">
            <div class="page-title">
                <h1 class="heading">
                    {% if brand|default %}
                        {% trans %}Edit {% endtrans %} {{ brand.name }}
                    {% else %}
                        {% trans %}New{% endtrans %} {% trans %}Brand{% endtrans %}
                    {% endif %}
                </h1>
            </div>
            <section class="editor">
                {{ form_errors(form) }}

                    {% if form.profile %}
                        {{ form_row(form.profile) }}
                    {% endif %}

            </section>

            {% if brand|default %}
            <div class="page-title">
                <h1 class="heading">{% trans %}Channels{% endtrans %}</h1>
                <ul class="create">
                    {% for linkType in linkTypes %}
                        {% if linkType.name not in brand.channelTypeNames %}
                        <li>
                            <a
                                class="btn btn-create-new"
                                href="{{ path('integrated_content_brand_add_channel', {'id': brand.id, 'type': linkType.id}) }}"
                                title="{% trans with {'%brand%': brand.name, '%type%': linkType.name } %}Add %type% channel to %brand%{% endtrans %}"
                            >
                                <span>{% trans %}Add{% endtrans %} {{ linkType.name }}</span>
                                <i class="iconoir-plus"></i>
                            </a>
                        </li>
                        {% endif %}
                    {% endfor %}
                </ul>
            </div>
            <section class="section-white section-radius">
                <table class="table table-hover">
                    <thead>
                    <tr>
                        <th class="name">{% trans %}Type{% endtrans %}</th>
                        <th class="default">{% trans %}Default{% endtrans %}</th>
                        <th class="channel">{% trans %}Channel{% endtrans %}</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for link in brand.channelLinks|default([]) %}
                        <tr class="has-options">
                            <td class="name">
                                <strong>
                                    <a href="{{ path('integrated_content_brand_edit_channel', {'id': brand.id, 'link': link.id}) }}">
                                        {{ link.name }}
                                    </a>
                                </strong>
                                <div class="row-options">
                                    <a
                                        href="{{ path('integrated_content_brand_edit_channel', {'id': brand.id, 'link': link.id}) }}"
                                        title="{% trans with {'%brand%': brand.name, '%type%': link.name } %}Edit %brand%'s %type% Channel{% endtrans %}"
                                    >
                                        {% trans %}Edit{% endtrans %}
                                    </a> |
                                    {% if link.type.connector %}
                                        <a
                                            href="{{ path('integrated_content_brand_manage_connector', {'id': brand.id, 'link': link.id}) }}"
                                            title="{% trans with {'%brand%': brand.name, '%type%': link.name} %}Manage %brand%'s %type% Connector{% endtrans %}"
                                        >
                                            {% trans %}Connector{% endtrans %}
                                        </a> |
                                    {% endif %}
                                    <a
                                        class="color-red"
                                        href="{{ path('integrated_content_brand_remove_channel', {'id': brand.id, 'link': link.id}) }}"
                                        title="{% trans with {'%brand%': brand.name, '%type%': link.name } %}Remove %type% from %brand%{% endtrans %}"
                                    >
                                        {% trans %}Remove{% endtrans %}
                                    </a>
                                </div>
                            </td>
                            <td class="default">
                                {% if link.default %}
                                    {% trans %}Yes{% endtrans %}
                                {% else %}
                                    {% trans %}No{% endtrans %}
                                {% endif %}
                            </td>
                            <td class="channel">
                                {{ link.channel.name }}
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="3">
                                {% trans %}No channels added{% endtrans %}
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>

            </section>
            {% endif %}
            <section class="editor">

                {% for child in form|filter(row => row.vars.attr.location|default == constant('Integrated\\Common\\Form\\Mapping\\Attributes\\Field::LOCATION_EDITOR')) %}
                    {{ form_row(child) }}
                {% endfor %}
                {{ form_rest(form, {'style':'editor', 'state':'show'})}}
            </section>
        </div>


        {% block form_end %}
            {{ form_end(form) }}
        {% endblock %}
    </div>
{% endblock %}

{% block webpack_js %}
    <script src="{{ asset('bundles/integratedintegrated/edit.js') }}"></script>
{% endblock %}
