{% extends '@IntegratedContent/base.html.twig' %}

{% block title %}{% trans %}New{% endtrans %} {{ linkType.name }} {% trans %}channel{% endtrans %}{% endblock title %}

{% block style %}
    {{ parent() }}

    <link rel="stylesheet" href="{{ asset('bundles/integratedintegrated/edit.css') }}">
    <style>
        .edit-form--channel-config .editor .form-item {
            display: block;
        }

        .edit-form--channel-config .editor .form-item .control-label,
        .edit-form--channel-config .editor .form-item .widget {
            width: 100% !important;
            max-width: none !important;
            flex: 0 0 100% !important;
            display: block !important;
        }

        .edit-form--channel-config .editor .form-item .widget {
            margin-top: 6px;
        }
    </style>
{% endblock %}

{% block content %}
    <div class="flex flex-wrap edit-form edit-form--channel-config">
        {% block form_start %}
            {{ form_start(form) }}
        {% endblock %}
        {% block toolbar %}
            {% include '@IntegratedContent/partials/block.toolbar.html.twig' %}
        {% endblock toolbar %}
        <div class="aside-options" >
            <aside>
                <div class="aside-holder">
                    {% block sidebar %}
                    <div class="aside-header">
                        <button class="toggle-filters toggle-options-sidebar" data-target="aside-options" type="button">
                            <i class="iconoir-xmark"></i></button>
                        <span>{% trans %}Options{% endtrans %}</span>
                    </div>
                        {% block content_meta %}
                            {% for child in form|filter(row => row.vars.attr.location|default == constant('Integrated\\Common\\Form\\Mapping\\Attributes\\Field::LOCATION_SIDEBAR')) %}
                                {{ form_row(child) }}
                            {% endfor %}
                    <div data-channel-new style="display: none">
                            {% for child in form.channel|filter(row => row.vars.attr.location|default == constant('Integrated\\Common\\Form\\Mapping\\Attributes\\Field::LOCATION_SIDEBAR')) %}
                                {{ form_row(child) }}
                            {% endfor %}
                    </div>
                        {% endblock %}
                    {% endblock %}
                </div>
            </aside>
        </div>
        <div class="editor-wrapper" >
            <div class="page-title">
                <h1 class="heading">{% trans %}New{% endtrans %} {{ linkType.name }} {% trans %}channel{% endtrans %}</h1>
            </div>
            <section class="editor">
                {{ form_errors(form) }}

                {% block content_form %}
                    <div class="hidden">
                        {{ form_row(form.type) }}
                    </div>

                    <div>
                        {{ form_row(form.default) }}
                    </div>

                    {{ form_row(form.choose_channel) }}

                    <div data-channel-choose style="display: none">
                        {{ form_row(form.channel_choice) }}
                    </div>

                    <div data-channel-new style="display: none">
                    {% for child in form|filter(row => row.vars.attr.location|default == constant('Integrated\\Common\\Form\\Mapping\\Attributes\\Field::LOCATION_EDITOR')) %}
                        {{ form_row(child) }}
                    {% endfor %}
                    {{ form_label(form.channel) }}
                    {% for child in form.channel|filter(row => row.vars.attr.location|default == constant('Integrated\\Common\\Form\\Mapping\\Attributes\\Field::LOCATION_EDITOR')) %}
                        {{ form_row(child) }}
                    {% endfor %}
                        <div class="hidden">{{ form_rest(form.channel) }}</div>
                    </div>
                    {{ form_rest(form, {'style':'editor', 'state':'show'}) }}

                {% endblock %}
            </section>
        </div>

        {% block form_end %}
            {{ form_end(form) }}
        {% endblock %}
    </div>
{% endblock %}

{% block webpack_js %}
    <script src="{{ asset('bundles/integratedintegrated/edit.js') }}" defer data-turbo-track="reload"></script>
{% endblock %}

{% block javascript %}
{{ parent() }}

<script src="{{ asset('bundles/integratedbrand/js/channel_add.js') }}" defer data-turbo-track="reload"></script>
<script src="{{ asset('bundles/integratedcontent/js/channel.js') }}" defer data-turbo-track="reload"></script>
{% endblock javascript %}
