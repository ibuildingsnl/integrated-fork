{% extends '@IntegratedContent/base.html.twig' %}
{% block title %}{% trans %}Brands{% endtrans %}{% endblock title %}
{% block content %}
    <div class="row">
        <div class="index-wrapper-full">
            <div class="page-title">
                <h1 class="heading">{% trans %}Brands{% endtrans %}</h1>
                <ul class="create">
                    <li>
                        <a class="btn btn-create-new" href="{{ path('integrated_content_brand_new') }}">
                            <span>{% trans %}New{% endtrans %} {% trans %}brand{% endtrans %}</span>
                            <i class="iconoir-plus"></i>
                        </a>
                    </li>
                </ul>
            </div>

            <section class="section-white section-radius">

                <table class="table table-hover">
                    <thead>
                    <tr>
                        <th class="name">{% trans %}Name{% endtrans %}</th>
                        <th class="id">{% trans %}Id{% endtrans %}</th>
                        <th class="channels">{% trans %}Channels{% endtrans %}</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for document in documents %}
                        <tr class="has-options">
                            <td class="name">
                                <strong>
                                    <a href="{{ path('integrated_content_brand_edit', {'id': document.id}) }}">
                                        {{ document.name }}
                                    </a>
                                </strong>
                                <div class="row-options">
                                    <a href="{{ path('integrated_content_brand_edit', {'id': document.id}) }}" title="{% trans %}Edit{% endtrans %}">
                                        {% trans %}Edit{% endtrans %}
                                    </a> |
                                    <a class="color-red" href="{{ path('integrated_content_brand_delete', {'id': document.id}) }}" title="{% trans %}Delete{% endtrans %}">
                                        {% trans %}Delete{% endtrans %}
                                    </a>
                                </div>
                            </td>
                            <td class="id">
                                {{ document.id }}
                            </td>
                            <td class="channels">
                                {{ document.channelTypeNames|join(', ') }}
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="4">
                                {% trans %}No brands added{% endtrans %}
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </section>
        </div>
    </div>
{% endblock %}
