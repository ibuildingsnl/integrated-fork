{% extends '@IntegratedContent/base.html.twig' %}
{% block title %}{% trans %}Brands{% endtrans %}{% endblock title %}
{% block content %}
    <div class="row">
        <div class="index-wrapper-full">
            {% set createActionsHtml %}
                <ul class="create">
                    <li>
                        <a class="btn btn-create-new" href="{{ path('integrated_content_brand_new') }}">
                            <span>{% trans %}New brand{% endtrans %}</span>
                            <i class="iconoir-plus"></i>
                        </a>
                    </li>
                    <li><a class="btn btn-create-new" href="{{ path('integrated_content_channel_index') }}">{% trans %}All channels{% endtrans %}</a></li>
                    <li><a class="btn btn-create-new" href="{{ path('integrated_channel_config_index') }}">{% trans %}All connectors{% endtrans %}</a></li>
                </ul>
            {% endset %}
            {{ component('integrated_admin:page_title', {
                title: 'Brands'|trans,
                actionsHtml: createActionsHtml,
            }) }}

            {% component 'integrated_admin:section_card' %}
                {% block content %}
                {% set brandTableHeadHtml %}
                    <tr>
                        <th class="name">{% trans %}Name{% endtrans %}</th>
                        <th class="id">{% trans %}Id{% endtrans %}</th>
                        <th class="channels">{% trans %}Channels{% endtrans %}</th>
                    </tr>
                {% endset %}
                {% set brandTableBodyHtml %}
                    {% for document in documents %}
                        <tr class="has-options">
                            <td class="name">
                                <strong>
                                    <a href="{{ path('integrated_content_brand_edit', {'id': document.id}) }}">
                                        {{ document.name }}
                                    </a>
                                </strong>
                                {% set brandRowActionsHtml %}
                                    <a href="{{ path('integrated_content_brand_edit', {'id': document.id}) }}" title="{% trans %}Edit{% endtrans %}">
                                        {% trans %}Edit{% endtrans %}
                                    </a> |
                                    <a class="color-red" href="{{ path('integrated_content_brand_delete', {'id': document.id}) }}" title="{% trans %}Delete{% endtrans %}">
                                        {% trans %}Delete{% endtrans %}
                                    </a>
                                {% endset %}
                                {{ component('integrated_admin:row_actions', {
                                    contentHtml: brandRowActionsHtml,
                                }) }}
                            </td>
                            <td class="id">
                                {{ document.id }}
                            </td>
                            <td class="channels">
                                {{ document.channelTypeNames|join(', ') }}
                            </td>
                        </tr>
                    {% endfor %}
                {% endset %}
                {{ component('integrated_admin:data_table', {
                    headHtml: brandTableHeadHtml,
                    bodyHtml: brandTableBodyHtml,
                    emptyMessage: 'No brands added'|trans,
                    colSpan: 3,
                }) }}
                {% endblock %}
            {% endcomponent %}
        </div>
    </div>
{% endblock %}
