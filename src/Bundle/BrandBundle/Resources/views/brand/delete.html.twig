{% extends '@IntegratedContent/base.html.twig' %}

{% block title %}{% trans %}Delete brand{% endtrans %}{% endblock title %}

{% block content %}
    {% block form_start %}
        {{ form_start(form) }}
    {% endblock %}
    {% set brandDeleteToolbarHtml %}
        {% block toolbar %}
            {% include '@IntegratedContent/partials/block.toolbar.html.twig' %}
        {% endblock toolbar %}
    {% endset %}
    {% set brandDeleteTitleHtml %}
        {{ component('integrated_admin:page_title', {
            title: ('Delete'|trans) ~ ' ' ~ ('brand'|trans),
        }) }}
    {% endset %}
    {% set brandDeleteContentHtml %}
        <p>
            {% trans with {'%name%':  brand.name} %}You are about to delete the brand "%name%", click the delete button to confirm the action.{% endtrans %}
        </p>
        {{ form_rest(form, {'style':'horizontal'})}}
    {% endset %}
    {{ component('integrated_admin:edit_form_shell', {
        toolbarHtml: brandDeleteToolbarHtml,
        pageTitleHtml: brandDeleteTitleHtml,
        editorContentHtml: brandDeleteContentHtml,
    }) }}
    {% block form_end %}
        {{ form_end(form) }}
    {% endblock %}
{% endblock %}
