{% extends '@IntegratedContent/base.html.twig' %}
{% block title %}{% trans %}Delete brand{% endtrans %}{% endblock title %}

{% block content %}
    <div class="flex flex-wrap edit-form">
        {% block form_start %}
            {{ form_start(form) }}
        {% endblock %}
        {% block toolbar %}
            {% include '@IntegratedContent/partials/block.toolbar.html.twig' %}
        {% endblock toolbar %}
        <div class="aside-options"></div>
        <div class="editor-wrapper" style="margin-top: 50px">
            <div class="page-title">
                <h1 class="heading">
                    {% trans %}Remove{% endtrans %} {{ link.type.name }} {% trans %}from{% endtrans %} {{ brand.name }}
                </h1>
            </div>
            <section class="editor editor-wrapped">
                <p>
                    {% trans with {'%type%': link.type.name, '%name%':  brand.name} %}You are about to remove the %type% from the "%name%" brand. Click the delete button to confirm the action.{% endtrans %}
                </p>
                {{ form_rest(form, {'style':'horizontal'}) }}
            </section>
        </div>
        {% block form_end %}
            {{ form_end(form) }}
        {% endblock %}
    </div>
{% endblock %}
