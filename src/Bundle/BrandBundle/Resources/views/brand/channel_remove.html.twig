{% extends '@IntegratedContent/base.html.twig' %}

{% block title %}
    {% trans %}Remove{% endtrans %} {{ link.name }} {% trans %}from{% endtrans %} {{ brand.name }}
{% endblock title %}

{% block content %}
    {% block form_start %}
        {{ form_start(form) }}
    {% endblock %}
    {% set brandChannelRemoveToolbarHtml %}
        {% block toolbar %}
            {% include '@IntegratedContent/partials/block.toolbar.html.twig' %}
        {% endblock toolbar %}
    {% endset %}
    {% set brandChannelRemoveTitleHtml %}
        {{ component('integrated_admin:page_title', {
            title: ('Remove'|trans) ~ ' ' ~ link.name ~ ' ' ~ ('from'|trans) ~ ' ' ~ brand.name,
        }) }}
    {% endset %}
    {% set brandChannelRemoveEditorContentHtml %}
        <p>
            {% trans with {'%link%': link.name, '%name%':  brand.name} %}You are about to remove the %link% from the "%name%" brand. Click the delete button to confirm the action.{% endtrans %}
        </p>
        <p>
            {% trans with {'%brand%': brand.name} %}Note: this action does not delete the channel itself, just its connection to %brand%.{% endtrans %}
        </p>
        {{ form_rest(form, {'style':'horizontal'}) }}
    {% endset %}
    {{ component('integrated_admin:edit_form_shell', {
        toolbarHtml: brandChannelRemoveToolbarHtml,
        pageTitleHtml: brandChannelRemoveTitleHtml,
        editorContentHtml: brandChannelRemoveEditorContentHtml,
        editorWrapperAttributes: 'style="margin-top: 50px"',
    }) }}
    {% block form_end %}
        {{ form_end(form) }}
    {% endblock %}
{% endblock %}
