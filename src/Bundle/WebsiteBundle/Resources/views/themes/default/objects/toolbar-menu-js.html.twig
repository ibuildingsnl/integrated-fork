<script>
    !function(JSON) {
        var builderPanel = null;
        var builderPanelContainerClass = 'integrated-menu-builder-open';
        var workspaceCurrentMenu = null;
        var workspaceActiveList = null;
        var workspaceOriginalParent = null;
        var workspaceOriginalNextSibling = null;
        var workspaceVisualMirrorList = null;
        var sortableActiveClass = 'integrated-sortable-active';
        var notifyEditorContentChange = function(source) {
            document.dispatchEvent(new CustomEvent('integrated-editor-content-change', {
                detail: {
                    source: source || 'menu',
                }
            }));
        };
        var setSortableActive = function(isActive) {
            document.body.classList.toggle(sortableActiveClass, !!isActive);
        };
        var markEditorReady = function(moduleName) {
            if (
                window.IntegratedEditorLoader &&
                typeof window.IntegratedEditorLoader.markReady === 'function'
            ) {
                window.IntegratedEditorLoader.markReady(moduleName);
            }
        };

        var parseMenuDatasetJson = function(value) {
            if (!value) {
                return null;
            }

            try {
                return JSON.parse(value);
            } catch (e) {
                if (value.indexOf('\\u') === 0) {
                    var decoded = value.replace(/\\u([0-9a-fA-F]{4})/g, function(_, code) {
                        return String.fromCharCode(parseInt(code, 16));
                    });

                    return JSON.parse(decoded);
                }

                throw e;
            }
        };

        var escapeHtml = function(value) {
            if (value === null || typeof value === 'undefined') {
                return '';
            }

            return String(value)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#039;');
        };

        var getItemTypeLabel = function(data) {
            if (String(data.typeLink) === '1') {
                return '{% trans %}Search selection{% endtrans %}';
            }
            if (String(data.typeLink) === '2') {
                return '{% trans %}Heading{% endtrans %}';
            }

            return '{% trans %}URL{% endtrans %}';
        };

        var getItemTypeClass = function(data) {
            if (String(data.typeLink) === '1') {
                return 'integrated-menu-node-type-search';
            }
            if (String(data.typeLink) === '2') {
                return 'integrated-menu-node-type-heading';
            }

            return 'integrated-menu-node-type-url';
        };

        var getItemMeta = function(data) {
            if (String(data.typeLink) === '1') {
                if (!data.searchSelection) {
                    return '{% trans %}No search selection selected{% endtrans %}';
                }

                if (data.maxItems) {
                    return '#' + data.searchSelection + ' · ' + data.maxItems + ' {% trans %}items{% endtrans %}';
                }

                return '#' + data.searchSelection;
            }

            if (String(data.typeLink) === '2') {
                return '{% trans %}Heading item{% endtrans %}';
            }

            return data.uri || '{% trans %}No URL configured{% endtrans %}';
        };

        var searchSelections = [
            {id: '', title: '{% trans %}Choose a search selection{% endtrans %}', channels: []},
            {% set searchSelections = getSearchSelections() %}
            {% for searchSelection in searchSelections %}
            {id: '{{ searchSelection.id }}', title: '{{ searchSelection.title|e('js') }}', channels: {{ ((searchSelection.filters.pub_channels|default([]))|merge(searchSelection.filters.channels|default([])))|json_encode|raw }}}{{ loop.last ? '' : ',' }}
            {% endfor %}
        ];

        var normalizeToArray = function(value) {
            if (Array.isArray(value)) {
                return value;
            }

            if (value === null || typeof value === 'undefined') {
                return [];
            }

            return [value];
        };

        var normalizeWebsiteKey = function(value) {
            var normalized = String(value || '').trim().toLowerCase();
            normalized = normalized.replace(/^https?:\/\//, '').replace(/^www\./, '').replace(/\/+$/, '');

            return normalized;
        };

        var extractSelectionChannels = function(selection) {
            var channels = normalizeToArray(selection && selection.channels);
            var mapped = channels.map(function(channel) {
                return normalizeWebsiteKey(channel);
            }).filter(function(channel) {
                return channel !== '';
            });

            return Array.from(new Set(mapped));
        };

        var classifySelection = function(selection, activeWebsiteKey) {
            var channels = extractSelectionChannels(selection);

            if (!channels.length) {
                return 'shared';
            }

            if (!activeWebsiteKey) {
                return 'other';
            }

            return channels.indexOf(activeWebsiteKey) !== -1 ? 'current' : 'other';
        };

        var collectWebsiteKeys = function() {
            var keys = [];

            searchSelections.forEach(function(selection) {
                extractSelectionChannels(selection).forEach(function(channel) {
                    keys.push(channel);
                });
            });

            return Array.from(new Set(keys)).sort();
        };

        var detectCurrentWebsiteKey = function(availableKeys) {
            var host = normalizeWebsiteKey(window.location && window.location.hostname ? window.location.hostname : '');
            if (host && availableKeys.indexOf(host) !== -1) {
                return host;
            }

            return '';
        };

        var renderSearchSelectionWebsiteOptions = function(selectedMode) {
            var mode = String(selectedMode || 'current');
            var allWebsiteKeys = collectWebsiteKeys();
            var options = [
                {value: 'current', label: '{% trans %}Current website{% endtrans %}'},
                {value: 'all', label: '{% trans %}All websites{% endtrans %}'}
            ];

            allWebsiteKeys.forEach(function(key) {
                options.push({value: key, label: key});
            });

            return options.map(function(option) {
                var selected = String(option.value) === mode ? ' selected="selected"' : '';
                return '<option value="' + escapeHtml(option.value) + '"' + selected + '>' + escapeHtml(option.label) + '</option>';
            }).join('');
        };

        var renderSearchSelectionOptions = function(selectedId, websiteMode) {
            var mode = String(websiteMode || 'current');
            var allWebsiteKeys = collectWebsiteKeys();
            var currentWebsiteKey = detectCurrentWebsiteKey(allWebsiteKeys);
            var activeWebsiteKey = mode === 'current' ? currentWebsiteKey : (mode === 'all' ? '' : normalizeWebsiteKey(mode));

            var groups = {
                current: [],
                shared: [],
                other: []
            };

            searchSelections.slice(1).forEach(function(option) {
                var group = classifySelection(option, activeWebsiteKey);
                groups[group].push(option);
            });

            var hasGroupedContext = activeWebsiteKey !== '';
            var html = '';
            var selectedExists = false;
            var selectedIdValue = String(selectedId || '');

            var renderOption = function(option) {
                var selected = String(option.id) === selectedIdValue ? ' selected="selected"' : '';
                if (selected) {
                    selectedExists = true;
                }

                return '<option value="' + escapeHtml(option.id) + '"' + selected + '>' + escapeHtml(option.title) + '</option>';
            };

            html += renderOption(searchSelections[0]);

            if (hasGroupedContext) {
                if (groups.current.length) {
                    html += '<optgroup label="{% trans %}For this website{% endtrans %}">';
                    groups.current.sort(function(a, b) { return a.title.localeCompare(b.title); }).forEach(function(option) { html += renderOption(option); });
                    html += '</optgroup>';
                }

                if (groups.shared.length) {
                    html += '<optgroup label="{% trans %}Shared{% endtrans %}">';
                    groups.shared.sort(function(a, b) { return a.title.localeCompare(b.title); }).forEach(function(option) { html += renderOption(option); });
                    html += '</optgroup>';
                }

                if (groups.other.length) {
                    html += '<optgroup label="{% trans %}Other websites{% endtrans %}">';
                    groups.other.sort(function(a, b) { return a.title.localeCompare(b.title); }).forEach(function(option) { html += renderOption(option); });
                    html += '</optgroup>';
                }
            } else {
                searchSelections.slice(1)
                    .slice()
                    .sort(function(a, b) { return a.title.localeCompare(b.title); })
                    .forEach(function(option) {
                        html += renderOption(option);
                    });
            }

            if (selectedIdValue && !selectedExists) {
                html += '<option value="' + escapeHtml(selectedIdValue) + '" selected="selected">(' + escapeHtml('{% trans %}Currently selected{% endtrans %}') + ' #' + escapeHtml(selectedIdValue) + ')</option>';
            }

            return html;
        };

        var hideAddPlaceholders = function(root) {
            if (!root) {
                return;
            }

            root.querySelectorAll('[data-action="integrated-website-menu-item-add"]').forEach(function(node) {
                node.remove();
            });
        };

        var normalizeHasChildrenClasses = function(root) {
            if (!root) {
                return;
            }

            root.querySelectorAll('.integrated-website-menu-item[data-action="integrated-website-menu-item-edit"]').forEach(function(node) {
                var childList = node.querySelector(':scope > .integrated-website-menu-list');
                var hasRealChildren = !!(childList && childList.querySelector(':scope > .integrated-website-menu-item[data-action="integrated-website-menu-item-edit"]'));

                if (hasRealChildren) {
                    node.classList.add('menu-item-has-children');
                } else {
                    node.classList.remove('menu-item-has-children');
                }
            });
        };

        var toNodeArray = function(value) {
            return Array.from(value || []);
        };

        var getEditableChildren = function(element) {
            if (!element || typeof element.closestChildren !== 'function') {
                return [];
            }

            return toNodeArray(element.closestChildren('.integrated-website-menu-item'));
        };

        var normalizeWorkspaceListClass = function(list) {
            if (!list) {
                return;
            }

            if (typeof list.dataset.integratedOriginalClass === 'undefined') {
                list.dataset.integratedOriginalClass = list.getAttribute('class') || '';
            }

            list.className = 'integrated-website-menu-list integrated-menu-tree-list';
        };

        var removeDraftNodes = function(listRoot) {
            if (!listRoot) {
                return;
            }

            listRoot
                .querySelectorAll(':scope > .integrated-website-menu-item[data-action="integrated-website-menu-item-edit"][data-integrated-draft="1"]')
                .forEach(function(node) {
                    node.remove();
                });
        };

        var createElementFromHTML = function(html) {
            var wrapper = document.createElement('div');
            wrapper.innerHTML = html.trim();
            return wrapper.firstChild;
        };

        var createFragmentFromHTML = function(html) {
            var template = document.createElement('template');
            template.innerHTML = html.trim();
            return template.content;
        };

        var ensureNodeData = function(node) {
            if (!node || node.data) {
                return;
            }

            if (node.dataset && node.dataset.json) {
                node.data = parseMenuDatasetJson(node.dataset.json);
                node.removeAttribute('data-json');
            }
        };

        var getMenuRootFromElement = function(element) {
            var root = element.closest('.integrated-website-menu');
            if (root) {
                return root;
            }

            var workspace = element.closest('.integrated-menu-workspace');
            if (workspace) {
                var rootId = workspace.dataset.menuRootId;
                if (rootId) {
                    return document.getElementById(rootId);
                }
            }

            var topLevelList = getTopLevelListFromElement(element);
            if (topLevelList && topLevelList.parentElement) {
                return topLevelList.parentElement;
            }

            return null;
        };

        var getTopLevelListFromElement = function(element) {
            var list = element.closest('.integrated-website-menu-list');
            if (!list) {
                return null;
            }

            var current = list;
            while (current.parentElement) {
                var parentItem = current.parentElement.closest('.integrated-website-menu-item');
                if (!parentItem) {
                    break;
                }

                var parentList = parentItem.closest('.integrated-website-menu-list');
                if (!parentList || parentList === current) {
                    break;
                }

                current = parentList;
            }

            return current;
        };

        var Menu = function(element) {
            this.element = element;
        };

        Menu.prototype.load = function(data, success) {
            var element = this.element;
            var payload = data;

            if (typeof payload !== 'string') {
                payload = JSON.stringify(payload || {});
            }

            return fetch('{{ path('integrated_website_menu_render') }}', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: payload
            })
                .then(function(response) { return response.json(); })
                .then(function(result) {
                    if (typeof result === 'string') {
                        try {
                            result = JSON.parse(result);
                        } catch (e) {
                            result = {};
                        }
                    }

                    if (!result || typeof result !== 'object') {
                        result = {};
                    }

                    element.dataOptions = result.options || {};
                    element.innerHTML = (typeof result.html === 'undefined' || result.html === null) ? '' : result.html;

                    element.querySelectorAll('.integrated-website-menu-list, .integrated-website-menu-item').forEach(function(item) {
                        if (item.dataset.json) {
                            item.data = parseMenuDatasetJson(item.dataset.json);
                            item.removeAttribute('data-json');
                        }
                    });

                    ensureMenuRootId(element);
                    ensureRootListForMenu(element);
                    hideAddPlaceholders(element);
                    normalizeHasChildrenClasses(element);
                    initializeSortable(element);
                    syncWorkspaceTreeIfNeeded(element);
                    ensureEmptyMenuAction(element);

                    if (success) {
                        success();
                    }
                });
        };

        Menu.prototype.refresh = function(id) {
            this.load(JSON.stringify({
                data: this.getData(id),
                options: this.getOptions()
            }));
        };

        Menu.prototype.getData = function(id) {
            var list = getActiveListForMenu(this.element);
            var data = list && list.data ? list.data : (this.element.data || {});

            data.children = [];

            if (!list) {
                return data;
            }

            getEditableChildren(list).forEach(function(node) {
                var item = new Item(node);
                var result = item.getData(id);

                if (result) {
                    data.children.push(result);
                }
            });

            return data;
        };

        Menu.prototype.getOptions = function() {
            return this.element.dataOptions;
        };

        var buildMenuDataFromList = function(menuRoot, list) {
            var base = {};

            if (menuRoot && menuRoot.data && typeof menuRoot.data === 'object') {
                base = Object.assign({}, menuRoot.data);
            }
            if (list && list.data && typeof list.data === 'object') {
                base = Object.assign(base, list.data);
            }

            base.children = [];

            if (!list) {
                return base;
            }

            getEditableChildren(list).forEach(function(node) {
                var item = new Item(node);
                var result = item.getData();

                if (result) {
                    base.children.push(result);
                }
            });

            return base;
        };

        var Item = function(element) {
            this.element = element;
            this.menu = new Menu(getMenuRootFromElement(this.element));
        };

        Item.prototype.getMenu = function() {
            return this.menu;
        };

        Item.prototype.getData = function(id, item) {
            item = item || this.element;

            var data = item.data;

            if (!data || item.dataset.integratedDraft === '1') {
                return null;
            }

            if ((id && data.id == id) || item.dataset.action === 'integrated-website-menu-item-edit') {
                var items = getEditableChildren(item);
                var children = [];

                if (items.length) {
                    for (var i = 0; i < items.length; i++) {
                        var result = this.getData(id, items[i]);

                        if (result) {
                            children.push(result);
                        }
                    }

                    data.children = children;
                }

                var name = (data.name || '').trim();
                var uri = (data.uri || '').trim();
                var searchSelection = (data.searchSelection || '').trim();
                var isPlaceholderLike = name === '' || name === '+';
                var hasLinkData = uri !== '' || searchSelection !== '';
                var hasChildren = Array.isArray(data.children) && data.children.length > 0;

                // Never persist transient placeholder/edit shells.
                if (isPlaceholderLike && !hasLinkData && !hasChildren) {
                    return null;
                }

                return data;
            }
        };

        Item.prototype.update = function(json) {
            var data = this.element.data;

            for (var key in json) {
                if (Object.prototype.hasOwnProperty.call(json, key)) {
                    data[key] = json[key];
                }
            }

            this.element.data = data;
            this.element.dataset.action = 'integrated-website-menu-item-edit';
            this.element.classList.remove('integrated-menu-node-settings-open');
            decorateWorkspaceNode(this.element);
            this.element.classList.add('integrated-menu-node-settings-open');
        };

        Item.prototype.remove = function() {
            this.element.remove();
            ensureEmptyMenuAction(this.menu.element);
        };

        var initializeSortable = function(root) {
            var dragPointerX = null;
            var sortableLists = [];

            var getListDepth = function(list) {
                var depth = 0;
                var currentList = list;

                while (currentList && currentList.parentElement) {
                    var parent = currentList.parentElement;
                    if (!parent.classList || !parent.classList.contains('integrated-website-menu-item')) {
                        break;
                    }

                    depth++;
                    currentList = parent.closest('.integrated-website-menu-list');
                }

                return depth;
            };

            var collectSortableLists = function(scope) {
                var lists = [];
                if (scope && scope.classList && scope.classList.contains('integrated-website-menu-list')) {
                    lists.push(scope);
                }

                if (scope && typeof scope.querySelectorAll === 'function') {
                    scope.querySelectorAll('.integrated-website-menu-list').forEach(function(list) {
                        lists.push(list);
                    });
                }

                return lists;
            };

            var ensureChildList = function(node) {
                var childList = node.querySelector(':scope > .integrated-website-menu-list');
                if (!childList) {
                    childList = document.createElement('ul');
                    childList.className = 'integrated-website-menu-list integrated-menu-tree-list';
                    childList.dataset.integratedOriginalClass = 'integrated-website-menu-list';
                    node.appendChild(childList);
                }

                if (childList.dataset.integratedSortable !== '1') {
                    initializeSortable(childList);
                }

                return childList;
            };

            var applyWordpressLikeDepth = function(evt) {
                var item = evt.item;
                var toList = evt.to;
                if (!item || !toList || !toList.classList || !toList.classList.contains('integrated-website-menu-list')) {
                    return;
                }

                var currentDepth = getListDepth(toList);
                var parentItem = toList.closest('.integrated-website-menu-item');
                var parentList = parentItem ? parentItem.closest('.integrated-website-menu-list') : null;
                var shell = item.querySelector(':scope > .integrated-menu-node-shell');
                var shellLeft = shell ? shell.getBoundingClientRect().left : 0;

                // Indent: dropped to the right of own shell, make child of previous sibling.
                if (typeof dragPointerX === 'number' && dragPointerX > shellLeft + 40 && currentDepth < 2) {
                    var prev = item.previousElementSibling;
                    while (prev && (!prev.dataset || prev.dataset.action !== 'integrated-website-menu-item-edit')) {
                        prev = prev.previousElementSibling;
                    }

                    if (prev && !prev.contains(item) && !item.contains(prev)) {
                        var childList = ensureChildList(prev);
                        try {
                            childList.appendChild(item);
                        } catch (err) {
                            // Keep item in current list when DOM hierarchy would become invalid.
                        }
                        return;
                    }
                }

                // Outdent: dropped far left, promote one level up.
                if (typeof dragPointerX === 'number' && dragPointerX < shellLeft - 30 && currentDepth > 0 && parentItem && parentList) {
                    if (parentItem.nextSibling) {
                        parentList.insertBefore(item, parentItem.nextSibling);
                    } else {
                        parentList.appendChild(item);
                    }
                }
            };

            var clearDropTargets = function(scope) {
                scope.querySelectorAll('.integrated-menu-drop-target').forEach(function(list) {
                    list.classList.remove('integrated-menu-drop-target');
                });

                scope.querySelectorAll('.integrated-menu-drop-before, .integrated-menu-drop-after').forEach(function(node) {
                    node.classList.remove('integrated-menu-drop-before');
                    node.classList.remove('integrated-menu-drop-after');
                });
            };

            sortableLists = collectSortableLists(root);

            sortableLists.forEach(function(item) {
                if (item.dataset.integratedSortable === '1') {
                    return;
                }

                new Sortable(item, {
                    scroll: true,
                    group: 'integrated-menu',
                    sort: true,
                    emptyInsertThreshold: 30,
                    draggable: '[data-action="integrated-website-menu-item-edit"]',
                    handle: '.integrated-menu-drag-handle',
                    filter: '.integrated-menu-node-action',
                    ghostClass: 'integrated-website-item-ghost',
                    dragClass: 'integrated-website-item-dragging',
                    onStart: function() {
                        setSortableActive(true);
                        root.classList.add('integrated-menu-dragging');
                    },
                    onMove: function(evt) {
                        if (evt.originalEvent && typeof evt.originalEvent.clientX === 'number') {
                            dragPointerX = evt.originalEvent.clientX;
                        }

                        clearDropTargets(root);

                        var targetList = evt.to;
                        if (!targetList || !targetList.classList || !targetList.classList.contains('integrated-website-menu-list')) {
                            return false;
                        }

                        var targetDepth = getListDepth(targetList);
                        targetList.classList.add('integrated-menu-drop-target');

                        // Max nesting: root + 2 submenu levels.
                        if (targetDepth > 2) {
                            return false;
                        }

                        // Prevent placing an item that already has children into level 2,
                        // because that would create a forbidden third submenu level.
                        var dragged = evt.dragged;
                        if (dragged && targetDepth === 2) {
                            var draggedHasChildren = !!dragged.querySelector(':scope > .integrated-website-menu-list > .integrated-website-menu-item[data-action="integrated-website-menu-item-edit"]');
                            if (draggedHasChildren) {
                                return false;
                            }
                        }

                        var related = evt.related;
                        if (related && related.classList && related.dataset.action === 'integrated-website-menu-item-edit') {
                            related.classList.add(evt.willInsertAfter ? 'integrated-menu-drop-after' : 'integrated-menu-drop-before');
                        }

                        return true;
                    },
                    onEnd: function(evt) {
                        if (evt) {
                            applyWordpressLikeDepth(evt);
                        }
                        clearDropTargets(root);
                        dragPointerX = null;
                        normalizeHasChildrenClasses(root);
                        root.classList.remove('integrated-menu-dragging');
                        setSortableActive(false);
                        notifyEditorContentChange('menu');
                    }
                });

                item.dataset.integratedSortable = '1';
            });
        };

        var getDirectMenuList = function(menuRoot) {
            if (!menuRoot) {
                return null;
            }

            for (var i = 0; i < menuRoot.children.length; i++) {
                var child = menuRoot.children[i];
                if (child.classList && child.classList.contains('integrated-website-menu-list')) {
                    return child;
                }
            }

            return null;
        };

        var getActiveListForMenu = function(menuRoot) {
            if (!menuRoot) {
                return null;
            }

            if (builderPanel && workspaceCurrentMenu === menuRoot) {
                var workspaceList = builderPanel.querySelector('.integrated-menu-workspace-tree > .integrated-website-menu-list');
                if (workspaceList) {
                    return workspaceList;
                }
            }

            var list = getDirectMenuList(menuRoot);
            if (list) {
                return list;
            }

            return null;
        };

        var ensureRootListForMenu = function(menuRoot) {
            if (!menuRoot) {
                return null;
            }

            var list = getDirectMenuList(menuRoot);
            if (!list) {
                list = document.createElement('ul');
                list.className = 'integrated-website-menu-list';
                menuRoot.appendChild(list);
            }

            return list;
        };

        var ensureEmptyMenuAction = function(menuRoot) {
            var list = getActiveListForMenu(menuRoot);
            if (!list && !(builderPanel && workspaceCurrentMenu === menuRoot)) {
                list = ensureRootListForMenu(menuRoot);
            }
            if (!list) {
                return;
            }

            list.querySelectorAll(':scope > .integrated-menu-empty-action').forEach(function(item) {
                item.remove();
            });

            var hasItems = !!list.querySelector(':scope > .integrated-website-menu-item[data-action="integrated-website-menu-item-edit"]');
            if (hasItems) {
                return;
            }

            var emptyAction = createElementFromHTML(
                '<li class="integrated-menu-empty-action">' +
                    '<button type="button" class="btn btn-green" data-action="integrated-website-menu-empty-open">' +
                        '<i class="iconoir-plus"></i><span>{% trans %}Add first menu item{% endtrans %}</span>' +
                    '</button>' +
                '</li>'
            );

            list.appendChild(emptyAction);
        };

        var closeAllNodeSettings = function(menuRoot) {
            var list = getActiveListForMenu(menuRoot);
            if (!list) {
                return;
            }

            list.querySelectorAll('.integrated-menu-node-settings-open').forEach(function(node) {
                node.classList.remove('integrated-menu-node-settings-open');
            });
        };

        var openNodeSettings = function(menuRoot, node) {
            closeAllNodeSettings(menuRoot);
            if (node) {
                node.classList.add('integrated-menu-node-settings-open');
            }
        };

        var buildEditNodeShell = function(node) {
            var data = node.data || {};
            var name = data.name || '{% trans %}Untitled{% endtrans %}';
            var typeLabel = getItemTypeLabel(data);
            var metaLabel = getItemMeta(data);
            var childList = node.querySelector(':scope > .integrated-website-menu-list');
            var hasChildren = !!(childList && childList.querySelector(':scope > [data-action="integrated-website-menu-item-edit"]'));
            var typeLink = '0';
            if (String(data.typeLink) === '1') {
                typeLink = '1';
            } else if (String(data.typeLink) === '2') {
                typeLink = '2';
            }
            var searchFieldClass = typeLink === '1' ? '' : ' style="display:none"';
            var uriFieldClass = typeLink === '0' ? '' : ' style="display:none"';
            var targetBlankFieldClass = typeLink === '2' ? ' style="display:none"' : '';
            var websiteMode = node.dataset.integratedSearchWebsiteMode || 'current';

            var html = '' +
                '<div class="integrated-menu-node-shell">' +
                    '<button type="button" class="integrated-menu-drag-handle" aria-label="{% trans %}Drag menu item{% endtrans %}"><i class="iconoir-menu-scale"></i></button>' +
                    (hasChildren
                        ? '<button type="button" class="integrated-menu-node-expand" data-action="integrated-website-menu-item-toggle" aria-label="{% trans %}Toggle submenu{% endtrans %}"><i class="iconoir-nav-arrow-down"></i></button>'
                        : '') +
                    '<div class="integrated-menu-node-content">' +
                        '<div class="integrated-menu-node-title-row">' +
                            '<span class="integrated-menu-node-title">' + escapeHtml(name) + '</span>' +
                            '<span class="integrated-menu-node-type ' + getItemTypeClass(data) + '">' + escapeHtml(typeLabel) + '</span>' +
                        '</div>' +
                        '<div class="integrated-menu-node-meta">' + escapeHtml(metaLabel) + '</div>' +
                    '</div>' +
                    '<button type="button" class="integrated-menu-node-settings-toggle" data-action="integrated-website-menu-item-settings-toggle" aria-label="{% trans %}Toggle settings{% endtrans %}"><i class="iconoir-settings"></i></button>' +
                '</div>' +
                '<div class="integrated-menu-node-settings">' +
                    '<div class="integrated-menu-node-settings-grid">' +
                        '<label>{% trans %}Name{% endtrans %}<input type="text" class="integrated-menu-setting-name integrated-form-control" value="' + escapeHtml(data.name || '') + '" /></label>' +
                        '<label>{% trans %}Link type{% endtrans %}<select class="integrated-menu-setting-type integrated-form-control"><option value="0"' + (typeLink === '0' ? ' selected="selected"' : '') + '>{% trans %}URL{% endtrans %}</option><option value="1"' + (typeLink === '1' ? ' selected="selected"' : '') + '>{% trans %}Search selection{% endtrans %}</option><option value="2"' + (typeLink === '2' ? ' selected="selected"' : '') + '>{% trans %}Heading{% endtrans %}</option></select></label>' +
                        '<label class="integrated-menu-setting-uri-wrap"' + uriFieldClass + '>{% trans %}URL{% endtrans %}<input type="text" class="integrated-menu-setting-uri integrated-form-control" value="' + escapeHtml(data.uri || '') + '" /></label>' +
                        '<label id="integrated-search-selection-website-label" class="integrated-menu-setting-search-website-wrap"' + searchFieldClass + '>{% trans %}Website{% endtrans %}<select id="integrated-search-selection-website-control" class="integrated-menu-setting-search-website integrated-form-control">' + renderSearchSelectionWebsiteOptions(websiteMode) + '</select></label>' +
                        '<label class="integrated-menu-setting-search-wrap"' + searchFieldClass + '>{% trans %}Search selection{% endtrans %}<select class="integrated-menu-setting-search integrated-form-control">' + renderSearchSelectionOptions(data.searchSelection || '', websiteMode) + '</select></label>' +
                        '<label class="integrated-menu-setting-maxitems-wrap"' + searchFieldClass + '>{% trans %}Number of items{% endtrans %}<input type="number" min="1" class="integrated-menu-setting-maxitems integrated-form-control" value="' + escapeHtml((typeof data.maxItems === 'undefined' || data.maxItems === null) ? '' : data.maxItems) + '" /></label>' +
                        '<label class="integrated-menu-setting-targetblank"' + targetBlankFieldClass + '><input type="checkbox" class="integrated-menu-setting-targetblank-input"' + (data.targetBlank ? ' checked="checked"' : '') + ' /> {% trans %}Open in new tab{% endtrans %}</label>' +
                    '</div>' +
                    '<div class="integrated-menu-node-settings-actions">' +
                        '<button type="button" class="btn btn-green" data-action="integrated-website-menu-item-inline-save">{% trans %}Save{% endtrans %}</button>' +
                        '<button type="button" class="btn btn-red" data-action="integrated-website-menu-item-inline-remove">{% trans %}Remove{% endtrans %}</button>' +
                    '</div>' +
                '</div>';

            return createFragmentFromHTML(html);
        };

        var ensureMenuRootId = function(menuRoot) {
            if (!menuRoot.id) {
                menuRoot.id = 'integrated-menu-root-' + Date.now() + '-' + Math.floor(Math.random() * 1000);
            }

            return menuRoot.id;
        };

        var decorateWorkspaceNode = function(node) {
            if (node.dataset.action === 'integrated-website-menu-item-add') {
                node.remove();
                return;
            }

            node.classList.remove('integrated-menu-add-node');
            node.style.display = '';
            var existingShell = node.querySelector(':scope > .integrated-menu-node-shell');
            if (existingShell) {
                existingShell.remove();
            }
            var existingSettings = node.querySelector(':scope > .integrated-menu-node-settings');
            if (existingSettings) {
                existingSettings.remove();
            }

            var shellFragment = buildEditNodeShell(node);
            node.insertBefore(shellFragment, node.firstChild);

            var directAnchor = node.querySelector(':scope > a');
            if (directAnchor) {
                directAnchor.style.display = 'none';
            }

            // Always ensure a direct child list exists so items can be dragged under this node.
            var childList = node.querySelector(':scope > .integrated-website-menu-list');
            if (!childList) {
                childList = document.createElement('ul');
                childList.className = 'integrated-website-menu-list integrated-menu-tree-list';
                childList.dataset.integratedOriginalClass = 'integrated-website-menu-list';
                childList.dataset.integratedSyntheticList = '1';
                node.appendChild(childList);
            }
        };

        var decorateWorkspaceTree = function(root) {
            root.querySelectorAll('.integrated-website-menu-item').forEach(function(node) {
                decorateWorkspaceNode(node);
            });

            root.querySelectorAll('.integrated-website-menu-list').forEach(function(list) {
                normalizeWorkspaceListClass(list);
            });
        };

        var undecorateWorkspaceTree = function(root) {
            root.querySelectorAll('.integrated-menu-node-shell, .integrated-menu-node-settings').forEach(function(node) {
                node.remove();
            });

            root.querySelectorAll('.integrated-website-menu-item').forEach(function(node) {
                node.classList.remove('integrated-menu-add-node', 'integrated-menu-node-collapsed');
                node.style.display = '';
                var anchor = node.querySelector(':scope > a');
                if (anchor) {
                    anchor.style.display = '';
                    anchor.removeAttribute('style');
                    anchor.removeAttribute('draggable');
                }
                node.removeAttribute('draggable');
            });

            var lists = [];
            if (root.classList && root.classList.contains('integrated-website-menu-list')) {
                lists.push(root);
            }
            root.querySelectorAll('.integrated-website-menu-list').forEach(function(list) {
                lists.push(list);
            });

            lists.forEach(function(list) {
                var hasItems = !!list.querySelector(':scope > .integrated-website-menu-item[data-action="integrated-website-menu-item-edit"]');
                if (list.dataset.integratedSyntheticList === '1' && !hasItems) {
                    list.remove();
                    return;
                }

                if (typeof list.dataset.integratedOriginalClass !== 'undefined') {
                    var originalClass = list.dataset.integratedOriginalClass;
                    if (originalClass) {
                        list.setAttribute('class', originalClass);
                    } else {
                        list.removeAttribute('class');
                    }
                    delete list.dataset.integratedOriginalClass;
                } else {
                    list.classList.remove('integrated-menu-tree-list');
                }

                if (list.dataset.integratedSyntheticList === '1') {
                    delete list.dataset.integratedSyntheticList;
                }
                list.style.display = '';
                list.removeAttribute('draggable');
            });
        };

        var syncWorkspaceTreeIfNeeded = function(menuRoot) {
            if (!workspaceCurrentMenu || workspaceCurrentMenu !== menuRoot || !builderPanel) {
                return;
            }

            var target = builderPanel.querySelector('.integrated-menu-workspace-tree');
            if (!target) {
                return;
            }

            var list = getDirectMenuList(menuRoot);
            if (!list) {
                list = ensureRootListForMenu(menuRoot);
            }

            workspaceActiveList = list;
            if (list.parentElement && !list.parentElement.classList.contains('integrated-menu-workspace-tree')) {
                workspaceOriginalParent = list.parentElement;
                workspaceOriginalNextSibling = list.nextSibling;

                // Keep a visual copy in the page so the menu remains visible while editing in the panel.
                if (!workspaceVisualMirrorList) {
                    workspaceVisualMirrorList = list.cloneNode(true);
                    workspaceVisualMirrorList.dataset.integratedMenuWorkspaceMirror = '1';
                    hideAddPlaceholders(workspaceVisualMirrorList);
                    normalizeHasChildrenClasses(workspaceVisualMirrorList);
                    workspaceOriginalParent.insertBefore(workspaceVisualMirrorList, list);
                }
            }

            target.innerHTML = '';
            target.appendChild(list);
            decorateWorkspaceTree(target);
            initializeSortable(target);
            ensureEmptyMenuAction(menuRoot);
        };

        var getBuilderPanel = function() {
            if (builderPanel) {
                return builderPanel;
            }

            var html = '' +
                '<div class="integrated-menu-builder-overlay" data-action="integrated-menu-builder-close"></div>' +
                '<aside class="integrated-menu-builder-panel" aria-live="polite">' +
                    '<div class="integrated-menu-builder-header">' +
                        '<div>' +
                            '<div class="integrated-menu-builder-eyebrow">{% trans %}Menu builder{% endtrans %}</div>' +
                            '<h3 class="integrated-menu-builder-title">{% trans %}Menu items{% endtrans %}</h3>' +
                            '<p class="integrated-menu-builder-context"></p>' +
                        '</div>' +
                        '<button type="button" class="integrated-menu-builder-close" data-action="integrated-menu-builder-close" aria-label="{% trans %}Close{% endtrans %}"><i class="iconoir-xmark"></i></button>' +
                    '</div>' +
                    '<div class="integrated-menu-workspace-actions">' +
                        '<button type="button" class="btn btn-green" data-action="integrated-website-menu-item-add-root"><i class="iconoir-plus"></i><span>{% trans %}Add menu item{% endtrans %}</span></button>' +
                    '</div>' +
                    '<div class="integrated-menu-workspace-tree"></div>' +
                '</aside>';

            builderPanel = createElementFromHTML('<div class="integrated-menu-builder integrated-menu-workspace">' + html + '</div>');
            document.body.appendChild(builderPanel);

            builderPanel.addEventListener('click', function(event) {
                var actionEl = event.target.closest('[data-action]');

                if (!actionEl) {
                    return;
                }

                var action = actionEl.dataset.action;

                if (action === 'integrated-menu-builder-close') {
                    closeMenuBuilderPanel();
                    return;
                }

                if (action === 'integrated-website-menu-item-add-root') {
                    if (workspaceCurrentMenu) {
                        openCreateRootItem(workspaceCurrentMenu);
                    }
                    return;
                }
            });

            return builderPanel;
        };

        var getOrCreateRootAddPlaceholder = function(menuRoot) {
            var list = getActiveListForMenu(menuRoot);
            if (!list) {
                return null;
            }

            var placeholder = list.querySelector(':scope > .integrated-website-menu-item[data-action="integrated-website-menu-item-add"]');
            if (!placeholder) {
                placeholder = document.createElement('li');
                placeholder.className = 'integrated-website-menu-item';
                placeholder.dataset.action = 'integrated-website-menu-item-add';
                placeholder.data = {
                    id: 'tmp-' + Date.now() + '-' + Math.floor(Math.random() * 1000),
                    name: '',
                    typeLink: 0,
                    uri: '',
                    searchSelection: '',
                    maxItems: '',
                    children: []
                };
                list.appendChild(placeholder);
            }

            ensureNodeData(placeholder);

            return placeholder;
        };

        var openCreateRootItem = function(menuRoot) {
            var placeholder = getOrCreateRootAddPlaceholder(menuRoot);
            if (!placeholder) {
                return;
            }

            if (!placeholder.data) {
                placeholder.data = {};
            }

            placeholder.dataset.action = 'integrated-website-menu-item-edit';
            placeholder.dataset.integratedDraft = '1';
            if (!placeholder.data.name || placeholder.data.name === '+') {
                placeholder.data.name = '{% trans %}New menu item{% endtrans %}';
            }
            placeholder.data.typeLink = typeof placeholder.data.typeLink === 'undefined' ? 0 : placeholder.data.typeLink;
            if (!placeholder.data.uri || placeholder.data.uri === '#') {
                placeholder.data.uri = '/';
            }
            placeholder.data.targetBlank = !!placeholder.data.targetBlank;

            decorateWorkspaceNode(placeholder);
            openNodeSettings(menuRoot, placeholder);
            ensureEmptyMenuAction(menuRoot);
        };

        var openWorkspace = function(menuRoot) {
            var panel = getBuilderPanel();

            workspaceCurrentMenu = menuRoot;
            workspaceActiveList = null;
            workspaceOriginalParent = null;
            workspaceOriginalNextSibling = null;
            workspaceVisualMirrorList = null;
            panel.dataset.menuRootId = ensureMenuRootId(menuRoot);
            panel.querySelector('.integrated-menu-builder-context').textContent = '{% trans %}Drag to reorder, drag between levels for subitems{% endtrans %}';

            document.body.classList.add(builderPanelContainerClass);
            syncWorkspaceTreeIfNeeded(menuRoot);
        };

        var getNodeInputPayload = function(node) {
            if (!node) {
                return null;
            }

            var nameInput = node.querySelector('.integrated-menu-setting-name');
            var typeInput = node.querySelector('.integrated-menu-setting-type');
            var uriInput = node.querySelector('.integrated-menu-setting-uri');
            var searchInput = node.querySelector('.integrated-menu-setting-search');
            var maxItemsInput = node.querySelector('.integrated-menu-setting-maxitems');
            var targetBlankInput = node.querySelector('.integrated-menu-setting-targetblank-input');

            if (!nameInput || !typeInput || !uriInput || !searchInput || !maxItemsInput || !targetBlankInput) {
                return null;
            }

            var selectedType = String(typeInput.value);

            return {
                typeLink: selectedType,
                name: (nameInput.value || '').trim(),
                uri: selectedType === '0' ? (uriInput.value || '').trim() : '',
                searchSelection: selectedType === '1' ? (searchInput.value || '') : '',
                maxItems: selectedType === '1' ? (maxItemsInput.value || '') : '',
                targetBlank: selectedType === '2' ? false : !!targetBlankInput.checked
            };
        };

        var isValidNodePayload = function(payload) {
            if (!payload || payload.name === '') {
                return false;
            }

            if (String(payload.typeLink) === '1' && payload.searchSelection === '') {
                return false;
            }

            if (String(payload.typeLink) === '0' && payload.uri === '') {
                return false;
            }

            return true;
        };

        var commitPendingNodeEdits = function(listRoot) {
            if (!listRoot) {
                return;
            }

            listRoot.querySelectorAll('.integrated-website-menu-item[data-action="integrated-website-menu-item-edit"]').forEach(function(node) {
                var payload = getNodeInputPayload(node);
                if (!isValidNodePayload(payload)) {
                    return;
                }

                new Item(node).update(payload);
                delete node.dataset.integratedDraft;
            });
        };

        var pruneInvalidMenuItems = function(listRoot) {
            if (!listRoot) {
                return;
            }

            listRoot.querySelectorAll('.integrated-website-menu-item[data-action="integrated-website-menu-item-edit"]').forEach(function(node) {
                ensureNodeData(node);

                var childList = node.querySelector(':scope > .integrated-website-menu-list');
                var hasChildren = !!(childList && childList.querySelector(':scope > .integrated-website-menu-item[data-action="integrated-website-menu-item-edit"]'));
                var data = node.data || {};
                var name = (data.name || '').trim();
                var anchor = node.querySelector(':scope > a');
                var anchorLabel = anchor ? anchor.textContent.trim() : '';
                var isPlaceholderLike = !name || name === '+' || anchorLabel === '+';

                if (isPlaceholderLike && !hasChildren) {
                    node.remove();
                }
            });
        };

        var closeMenuBuilderPanel = function() {
            if (!workspaceCurrentMenu && builderPanel && builderPanel.dataset.menuRootId) {
                workspaceCurrentMenu = document.getElementById(builderPanel.dataset.menuRootId);
            }

            if (!workspaceActiveList && builderPanel) {
                workspaceActiveList = builderPanel.querySelector('.integrated-menu-workspace-tree > .integrated-website-menu-list');
            }

            if (workspaceCurrentMenu) {
                closeAllNodeSettings(workspaceCurrentMenu);
            }

            commitPendingNodeEdits(workspaceActiveList);
            removeDraftNodes(workspaceActiveList);

            if (workspaceActiveList) {
                undecorateWorkspaceTree(workspaceActiveList);
                pruneInvalidMenuItems(workspaceActiveList);
            }

            if (workspaceActiveList && workspaceCurrentMenu) {
                var existingRootList = getDirectMenuList(workspaceCurrentMenu);
                if (existingRootList && existingRootList !== workspaceActiveList) {
                    existingRootList.remove();
                }
                workspaceCurrentMenu.appendChild(workspaceActiveList);
            } else if (workspaceActiveList && workspaceOriginalParent) {
                if (workspaceOriginalNextSibling && workspaceOriginalNextSibling.parentNode === workspaceOriginalParent) {
                    workspaceOriginalParent.insertBefore(workspaceActiveList, workspaceOriginalNextSibling);
                } else {
                    workspaceOriginalParent.appendChild(workspaceActiveList);
                }
            }

            if (workspaceVisualMirrorList && workspaceVisualMirrorList.parentNode) {
                workspaceVisualMirrorList.parentNode.removeChild(workspaceVisualMirrorList);
            }

            hideAddPlaceholders(workspaceCurrentMenu);
            ensureEmptyMenuAction(workspaceCurrentMenu);

            // Rebuild canonical markup from backend renderer using an explicit workspace snapshot.
            if (workspaceCurrentMenu) {
                var menu = new Menu(workspaceCurrentMenu);
                var payload = {
                    data: buildMenuDataFromList(workspaceCurrentMenu, workspaceActiveList || getDirectMenuList(workspaceCurrentMenu)),
                    options: menu.getOptions()
                };

                menu.load(payload);
            }

            document.body.classList.remove(builderPanelContainerClass);
            workspaceCurrentMenu = null;
            workspaceActiveList = null;
            workspaceOriginalParent = null;
            workspaceOriginalNextSibling = null;
            workspaceVisualMirrorList = null;
        };

        var init = function() {
            var loadPromises = [];

            document.querySelectorAll('.integrated-website-menu').forEach(function(item) {
                var menu = new Menu(item);
                var script = item.querySelector('script[type="text/json"]');

                if (!script) {
                    ensureMenuRootId(item);
                    ensureRootListForMenu(item);
                    initializeSortable(item);
                    ensureEmptyMenuAction(item);
                    return;
                }

                loadPromises.push(menu.load(script.innerHTML));
                script.parentNode.removeChild(script);
            });

            if (!loadPromises.length) {
                markEditorReady('menu');
                return;
            }

            Promise.all(loadPromises)
                .then(function() {
                    markEditorReady('menu');
                })
                .catch(function() {
                    markEditorReady('menu');
                });
        };

        if (document.readyState !== 'loading') {
            init();
        } else {
            document.addEventListener('DOMContentLoaded', init);
        }

        var stopEvent = function(e) {
            e.preventDefault();
            e.stopPropagation();
        };

        var validatePayloadOrAlert = function(payload) {
            if (!payload || !payload.name) {
                alert('{% trans %}Name is required{% endtrans %}');
                return false;
            }

            if (String(payload.typeLink) === '1' && !payload.searchSelection) {
                alert('{% trans %}Search selection is required{% endtrans %}');
                return false;
            }

            if (String(payload.typeLink) === '0' && !payload.uri) {
                alert('{% trans %}URL is required{% endtrans %}');
                return false;
            }

            return true;
        };

        var handleOutsideBuilderClick = function(e) {
            if (
                document.body.classList.contains(builderPanelContainerClass) &&
                !e.target.closest('.integrated-menu-builder-panel') &&
                !e.target.closest('.integrated-website-menu [data-action="integrated-website-menu-item-edit"]')
            ) {
                closeMenuBuilderPanel();
                return true;
            }
            return false;
        };

        var handleEmptyOpenClick = function(e) {
            var emptyOpen = e.target.closest('[data-action="integrated-website-menu-empty-open"]');
            if (emptyOpen) {
                stopEvent(e);

                var emptyRoot = getMenuRootFromElement(emptyOpen);
                if (emptyRoot) {
                    openWorkspace(emptyRoot);
                    openCreateRootItem(emptyRoot);
                }

                return true;
            }
            return false;
        };

        var handlePageMenuNodeClick = function(e) {
            var pageMenuNode = e.target.closest('[data-action="integrated-website-menu-item-edit"]');
            if (pageMenuNode && e.target.closest('.integrated-menu-builder')) {
                pageMenuNode = null;
            }
            if (pageMenuNode) {
                stopEvent(e);

                var menuRoot = getMenuRootFromElement(pageMenuNode);
                if (menuRoot) {
                    openWorkspace(menuRoot);
                }

                return true;
            }
            return false;
        };

        var handleToggleClick = function(e) {
            var toggleTrigger = e.target.closest('[data-action="integrated-website-menu-item-toggle"]');
            if (toggleTrigger) {
                stopEvent(e);

                var toggleNode = toggleTrigger.closest('.integrated-website-menu-item[data-action="integrated-website-menu-item-edit"]');
                if (toggleNode) {
                    toggleNode.classList.toggle('integrated-menu-node-collapsed');
                }

                return true;
            }
            return false;
        };

        var handleSettingsToggleClick = function(e) {
            var settingsToggle = e.target.closest('[data-action="integrated-website-menu-item-settings-toggle"]');
            if (settingsToggle) {
                stopEvent(e);

                var settingsNode = settingsToggle.closest('.integrated-website-menu-item[data-action="integrated-website-menu-item-edit"]');
                if (settingsNode) {
                    var settingsRoot = getMenuRootFromElement(settingsNode);
                    if (settingsNode.classList.contains('integrated-menu-node-settings-open')) {
                        settingsNode.classList.remove('integrated-menu-node-settings-open');
                    } else {
                        openNodeSettings(settingsRoot, settingsNode);
                    }
                }
                return true;
            }
            return false;
        };

        var handleInlineSaveClick = function(e) {
            var inlineSave = e.target.closest('[data-action="integrated-website-menu-item-inline-save"]');
            if (inlineSave) {
                stopEvent(e);

                var saveNode = inlineSave.closest('.integrated-website-menu-item[data-action="integrated-website-menu-item-edit"]');
                if (!saveNode) {
                    return true;
                }

                ensureNodeData(saveNode);
                var payload = getNodeInputPayload(saveNode);
                if (!validatePayloadOrAlert(payload)) {
                    return true;
                }

                new Item(saveNode).update(payload);
                delete saveNode.dataset.integratedDraft;
                notifyEditorContentChange('menu');
                return true;
            }
            return false;
        };

        var handleInlineRemoveClick = function(e) {
            var inlineRemove = e.target.closest('[data-action="integrated-website-menu-item-inline-remove"]');
            if (inlineRemove) {
                stopEvent(e);

                var removeNode = inlineRemove.closest('.integrated-website-menu-item[data-action="integrated-website-menu-item-edit"]');
                if (!removeNode) {
                    return true;
                }

                if (!confirm('{% trans %}Are you sure you want to remove this menu item?{% endtrans %}')) {
                    return true;
                }

                new Item(removeNode).remove();
                notifyEditorContentChange('menu');
                return true;
            }
            return false;
        };

        var handleRowSettingsToggleClick = function(e) {
            var rowNode = e.target.closest('[data-action="integrated-website-menu-item-edit"]');
            if (!rowNode || e.target.closest('.integrated-menu-node-settings') || e.target.closest('.integrated-menu-add-button') || e.target.closest('.integrated-menu-drag-handle')) {
                return false;
            }

            stopEvent(e);
            var rowRoot = getMenuRootFromElement(rowNode);
            if (rowNode.classList.contains('integrated-menu-node-settings-open')) {
                rowNode.classList.remove('integrated-menu-node-settings-open');
            } else {
                openNodeSettings(rowRoot, rowNode);
            }

            return true;
        };

        var handleBodyClick = function(e) {
            if (handleOutsideBuilderClick(e)) { return; }
            if (handleEmptyOpenClick(e)) { return; }
            if (handlePageMenuNodeClick(e)) { return; }
            if (handleToggleClick(e)) { return; }
            if (handleSettingsToggleClick(e)) { return; }
            if (handleInlineSaveClick(e)) { return; }
            if (handleInlineRemoveClick(e)) { return; }
            handleRowSettingsToggleClick(e);
        };

        var updateSearchSelectionOptions = function(typeNode) {
            if (!typeNode) {
                return;
            }

            var websiteSelect = typeNode.querySelector('.integrated-menu-setting-search-website');
            var searchSelect = typeNode.querySelector('.integrated-menu-setting-search');
            if (!websiteSelect || !searchSelect) {
                return;
            }

            var selectedSearch = String(searchSelect.value || '');
            var websiteMode = String(websiteSelect.value || 'current');
            searchSelect.innerHTML = renderSearchSelectionOptions(selectedSearch, websiteMode);
            if (selectedSearch) {
                searchSelect.value = selectedSearch;
            }

            typeNode.dataset.integratedSearchWebsiteMode = websiteMode;
        };

        var handleTypeChange = function(e) {
            var websiteChange = e.target.closest('.integrated-menu-setting-search-website');
            if (websiteChange) {
                var websiteNode = websiteChange.closest('.integrated-website-menu-item[data-action="integrated-website-menu-item-edit"]');
                updateSearchSelectionOptions(websiteNode);
                return;
            }

            var typeChange = e.target.closest('.integrated-menu-setting-type');
            if (!typeChange) {
                return;
            }

            var typeNode = typeChange.closest('.integrated-website-menu-item[data-action="integrated-website-menu-item-edit"]');
            if (!typeNode) {
                return;
            }

            var selectedType = String(typeChange.value);
            var showSearch = selectedType === '1';
            var showUri = selectedType === '0';
            var showTargetBlank = selectedType !== '2';
            var websiteWrap = typeNode.querySelector('.integrated-menu-setting-search-website-wrap');
            var searchWrap = typeNode.querySelector('.integrated-menu-setting-search-wrap');
            var maxWrap = typeNode.querySelector('.integrated-menu-setting-maxitems-wrap');
            var uriWrap = typeNode.querySelector('.integrated-menu-setting-uri-wrap');
            var targetBlankWrap = typeNode.querySelector('.integrated-menu-setting-targetblank');
            var targetBlankInput = typeNode.querySelector('.integrated-menu-setting-targetblank-input');
            if (websiteWrap) { websiteWrap.style.display = showSearch ? '' : 'none'; }
            if (searchWrap) { searchWrap.style.display = showSearch ? '' : 'none'; }
            if (maxWrap) { maxWrap.style.display = showSearch ? '' : 'none'; }
            if (uriWrap) { uriWrap.style.display = showUri ? '' : 'none'; }
            if (targetBlankWrap) { targetBlankWrap.style.display = showTargetBlank ? '' : 'none'; }
            if (targetBlankInput && !showTargetBlank) { targetBlankInput.checked = false; }

            if (showSearch) {
                updateSearchSelectionOptions(typeNode);
            }
        };

        var handleKeyDown = function(e) {
            if (e.key === 'Escape' && document.body.classList.contains(builderPanelContainerClass)) {
                closeMenuBuilderPanel();
            }
        };

        document.body.addEventListener('click', function(e) {
            handleBodyClick(e);
        });

        document.body.addEventListener('change', function(e) {
            handleTypeChange(e);
        });

        document.addEventListener('keydown', function(e) {
            handleKeyDown(e);
        });

        Element.prototype.closestChildren = function(selector) {
            var children = this.querySelectorAll(':scope > ' + selector);

            if (children.length) {
                return children;
            }

            children = this.children;

            if (children.length) {
                for (var i = 0; i < children.length; i++) {
                    var child = children[i];
                    if (child.querySelectorAll(selector).length) {
                        return child.closestChildren(selector);
                    }
                }
            }

            return [];
        };

        Integrated = Object.assign({}, Integrated || {}, {
            Menu: {
                create: function(element) {
                    return new Menu(element);
                },
                updateLinkType: function() {
                    var typeUrl = document.getElementById('typeLinkUri');
                    var typeSearch = document.getElementById('typeLinkSearchSelection');
                    var uriLabel = document.getElementById('integrated-uri-label');
                    var uriControl = document.getElementById('integrated-uri-control');
                    var selectionLabel = document.getElementById('integrated-search-selection-label');
                    var selectionControl = document.getElementById('integrated-search-selection-control');
                    var maxItemsLabel = document.getElementById('integrated-maxitems-label');
                    var maxItemsControl = document.getElementById('integrated-maxitems-control');

                    if (!typeUrl || !typeSearch || !uriLabel || !uriControl || !selectionLabel || !selectionControl || !maxItemsLabel || !maxItemsControl) {
                        return;
                    }

                    if (typeUrl.checked) {
                        uriLabel.style.display = 'block';
                        uriControl.style.display = 'block';
                        selectionLabel.style.display = 'none';
                        selectionControl.style.display = 'none';
                        maxItemsLabel.style.display = 'none';
                        maxItemsControl.style.display = 'none';
                    }

                    if (typeSearch.checked) {
                        uriLabel.style.display = 'none';
                        uriControl.style.display = 'none';
                        selectionLabel.style.display = 'block';
                        selectionControl.style.display = 'block';
                        maxItemsLabel.style.display = 'block';
                        maxItemsControl.style.display = 'block';
                    }
                }
            }
        });
    }(JSON);

    var Integrated = Integrated || {};
</script>
