                d="M10.063 26l1.8-6h8.274l1.8 6h3.551l-6-20h-6.976l-6 20h3.551zM14.863 10h2.274l1.8 6h-5.874l1.8-6z"></path>
        </symbol>
    </defs>
</svg>
<script>
    !function(Routing) {
        /**
         * @type object|null
         */
        var $blockTarget = null;
        var $lastBlockAddTrigger = null;
        var blockSelectorPanel = null;
        var blockSelectorOpenClass = 'integrated-block-selector-open';
        var $columnLayoutTarget = null;
        var $columnLayoutInsertBefore = null;
        var COLUMN_GRID_UNITS = 12;
        var historyPast = [];
        var historyFuture = [];
        var historyLimit = 40;
        var rememberStateTimer = null;
        var rememberStateDelay = 60;
        var sortableActiveClass = 'integrated-sortable-active';
        var sectionPresetCache = [];
        var sectionPresetInsertContext = null;
        var notifyEditorContentChange = function(source) {
            document.dispatchEvent(new CustomEvent('integrated-editor-content-change', {
                detail: {
                    source: source || 'grid',
                }
            }));
        };
        var setSortableActive = function(isActive) {
            document.body.classList.toggle(sortableActiveClass, !!isActive);
        };
        var markEditorReady = function(moduleName) {
            if (
                window.IntegratedEditorLoader &&
                typeof window.IntegratedEditorLoader.markReady === 'function'
            ) {
                window.IntegratedEditorLoader.markReady(moduleName);
            }
        };
        var resolveGridContext = function($context) {
            if ($context && typeof $context.closest === 'function') {
                var $grid = $context.closest('.integrated-website-grid');
                if ($grid) {
                    return $grid;
                }
            }

            if ($context && $context.classList && $context.classList.contains('integrated-website-grid')) {
                return $context;
            }

            return document.querySelector('.integrated-website-grid');
        };
        var hasClassPrefix = function($node, prefix) {
            if (!$node || !$node.classList || !prefix) {
                return false;
            }

            for (var i = 0; i < $node.classList.length; i++) {
                if ($node.classList[i].indexOf(prefix) === 0) {
                    return true;
                }
            }

            return false;
        };
        var isTailwindLayout = function($context) {
            if (typeof framework !== 'undefined') {
                return framework === 'tailwind';
            }

            var $grid = resolveGridContext($context);
            if ($grid && $grid.dataset && typeof $grid.dataset.gridFramework === 'string' && $grid.dataset.gridFramework.trim() !== '') {
                return $grid.dataset.gridFramework === 'tailwind';
            }

            var sampleNodes = [];
            if ($grid && typeof $grid.querySelectorAll === 'function') {
                sampleNodes = Array.from($grid.querySelectorAll('[data-block-type="row"], [data-block-type="column"]')).slice(0, 24);
            }

            for (var i = 0; i < sampleNodes.length; i++) {
                var $node = sampleNodes[i];
                if ($node.classList && ($node.classList.contains('flex-wrap') || hasClassPrefix($node, 'md:w-'))) {
                    return true;
                }

                if (hasClassPrefix($node, 'col-sm-')) {
                    return false;
                }
            }

            return false;
        };

        /**
         * @param Element $element
         */
        var initGrid = function($element) {
            $element.querySelectorAll('[data-block-type="row"]').forEach(item =>
                item.insertBefore(createRowButtons(), item.firstChild),
            );

            $element.querySelectorAll('[data-block-type="column"]').forEach(item =>
                item.appendChild(createColumnButtons()),
            );

            $element.appendChild(createColumnButtons());

            $element.querySelectorAll('[data-block-type="block"]').forEach(item =>
                refreshBlock(item, true, false)
            );
        };

        /**
         * @param {string} blockId
         * @param element  $before
         */
        var addBlock = function(blockId, $before) {
            if (!$before || !$before.parentNode) {
                return null;
            }

            var element = document.createElement('div');

            element.dataset.id = blockId;
            element.dataset.blockType = 'block';
            element.classList.add('integrated-website-sortable');

            $before.insertAdjacentElement('beforebegin', element);

            refreshBlock(element);

            return element;
        };

        var ensureRootColumnButtons = function($grid) {
            if (!$grid) {
                return null;
            }

            var $buttons = null;
            for (var i = 0; i < $grid.children.length; i++) {
                var child = $grid.children[i];
                if (child.classList && child.classList.contains('integrated-column-buttons')) {
                    $buttons = child;
                    break;
                }
            }
            if ($buttons) {
                return $buttons;
            }

            $buttons = createColumnButtons();
            $grid.appendChild($buttons);

            return $buttons;
        };

        var resolveBlockInsertTarget = function($trigger) {
            if (!$trigger) {
                return null;
            }

            var $blockButtons = $trigger.closest('.integrated-block-buttons');
            if ($blockButtons) {
                return $blockButtons.parentNode;
            }

            var $column = $trigger.closest('[data-block-type="column"]');
            if ($column) {
                var $columnButtons = null;
                for (var i = 0; i < $column.children.length; i++) {
                    var child = $column.children[i];
                    if (child.classList && child.classList.contains('integrated-column-buttons')) {
                        $columnButtons = child;
                        break;
                    }
                }
                if ($columnButtons) {
                    return $columnButtons;
                }

                $columnButtons = createColumnButtons();
                $column.appendChild($columnButtons);

                return $columnButtons;
            }

            var $grid = $trigger.closest('.integrated-website-grid');
            if ($grid) {
                return ensureRootColumnButtons($grid);
            }

            if ($trigger.parentNode) {
                return $trigger.parentNode;
            }

            return null;
        };

        var createElementFromHTML = function(html) {
            var wrapper = document.createElement('div');
            wrapper.innerHTML = html.trim();
            return wrapper.firstChild;
        };

        var escapeHtml = function(value) {
            if (value === null || typeof value === 'undefined') {
                return '';
            }

            return String(value)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#039;');
        };

        var fetchSectionPresets = function() {
            return fetch('{{ path('integrated_website_pagebuilder_section_presets_list') }}', {
                method: 'GET',
                credentials: 'same-origin',
                headers: {
                    'Accept': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                }
            })
                .then(function(response) {
                    return response.text().then(function(rawBody) {
                        var result = null;
                        try {
                            result = rawBody ? JSON.parse(rawBody) : {};
                        } catch (e) {
                            return [];
                        }

                        if (!response.ok || !result || result.success !== true || !Array.isArray(result.presets)) {
                            return [];
                        }

                        return result.presets;
                    });
                })
                .catch(function() {
                    return [];
                });
        };

        var saveSectionPreset = function(name, html, id) {
            return fetch('{{ path('integrated_website_pagebuilder_section_presets_save') }}', {
                method: 'POST',
                credentials: 'same-origin',
                headers: {
                    'Content-Type': 'application/json',
                    'Accept': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: JSON.stringify({
                    id: id || '',
                    name: name || '',
                    html: html || ''
                })
            })
                .then(function(response) {
                    return response.text().then(function(rawBody) {
                        var result = null;
                        try {
                            result = rawBody ? JSON.parse(rawBody) : {};
                        } catch (e) {
                            throw new Error('Unable to save section preset (HTTP ' + response.status + ')');
                        }

                        if (!response.ok || !result || result.success !== true || !result.preset) {
                            throw new Error((result && result.error) ? result.error : 'Unable to save section preset');
                        }

                        return result.preset;
                    });
                });
        };

        var deleteSectionPreset = function(id) {
            return fetch('{{ path('integrated_website_pagebuilder_section_presets_delete', {'id': 'preset-id'}) }}'.replace('preset-id', encodeURIComponent(id)), {
                method: 'DELETE',
                credentials: 'same-origin',
                headers: {
                    'Accept': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                }
            })
                .then(function(response) {
                    return response.text().then(function(rawBody) {
                        var result = null;
                        try {
                            result = rawBody ? JSON.parse(rawBody) : {};
                        } catch (e) {
                            throw new Error('Unable to delete section preset (HTTP ' + response.status + ')');
                        }

                        if (!response.ok || !result || result.success !== true) {
                            throw new Error((result && result.error) ? result.error : 'Unable to delete section preset');
                        }

                        return true;
                    });
                });
        };

        var getPresetErrorMessage = function(error, fallback) {
            if (!error) {
                return fallback;
            }

            if (typeof error === 'string' && error !== '') {
                return error;
            }

            if (typeof error.message === 'string' && error.message !== '') {
                return error.message;
            }

            return fallback;
        };

        var renderSectionPresetPanel = function() {
            var listItems = sectionPresetCache.map(function(preset) {
                return '<li class="integrated-section-preset-item">' +
                    '<button type="button" class="integrated-section-preset-use" data-action="integrated-website-section-preset-use" data-id="' + escapeHtml(preset.id) + '">' +
                    '<span class="integrated-section-preset-name">' + escapeHtml(preset.name || '') + '</span>' +
                    '</button>' +
                    '<button type="button" class="integrated-section-preset-delete" data-action="integrated-website-section-preset-delete" data-id="' + escapeHtml(preset.id) + '" aria-label="{% trans %}Delete section preset{% endtrans %}">' +
                    '<i class="iconoir-trash"></i>' +
                    '</button>' +
                    '</li>';
            }).join('');

            if (listItems === '') {
                listItems = '<li class="integrated-menu-empty-action">{% trans %}No section presets yet{% endtrans %}</li>';
            }

            return '<div class="integrated-section-presets">' +
                '<div class="integrated-block-workspace-actions">' +
                '<p class="integrated-menu-builder-context">{% trans %}Insert a shared section preset for this website{% endtrans %}</p>' +
                '</div>' +
                '<ul class="integrated-section-preset-list">' + listItems + '</ul>' +
                '</div>';
        };

        var resolveSectionPresetInsertPosition = function() {
            if (sectionPresetInsertContext) {
                var $row = sectionPresetInsertContext.closest('[data-block-type="row"]');
                if ($row && $row.parentNode) {
                    if ($row.nextSibling) {
                        return {
                            parent: $row.parentNode,
                            before: $row.nextSibling
                        };
                    }

                    return {
                        parent: $row.parentNode,
                        before: null
                    };
                }

                var $grid = sectionPresetInsertContext.closest('.integrated-website-grid');
                if ($grid) {
                    var $rootButtons = null;
                    for (var i = 0; i < $grid.children.length; i++) {
                        var child = $grid.children[i];
                        if (child.classList && child.classList.contains('integrated-column-buttons')) {
                            $rootButtons = child;
                            break;
                        }
                    }

                    return {
                        parent: $grid,
                        before: $rootButtons
                    };
                }
            }

            var $defaultGrid = document.querySelector('.integrated-website-grid');
            if (!$defaultGrid) {
                return null;
            }

            return {
                parent: $defaultGrid,
                before: ensureRootColumnButtons($defaultGrid)
            };
        };

        var ensureInsertedRowControls = function($row) {
            if (!$row.querySelector(':scope > .integrated-row-buttons')) {
                $row.insertBefore(createRowButtons(), $row.firstChild);
            }

            $row.querySelectorAll(':scope > [data-block-type="column"]').forEach(function($column) {
                if (!$column.querySelector(':scope > .integrated-column-buttons')) {
                    $column.appendChild(createColumnButtons());
                }

                $column.querySelectorAll(':scope > [data-block-type="block"]').forEach(function($block) {
                    if (!$block.querySelector(':scope > .integrated-block-buttons')) {
                        $block.prepend(createBlockButtons(), $block.firstChild);
                    }
                });
            });
        };

        var insertSectionPresetById = function(id) {
            var preset = sectionPresetCache.find(function(item) {
                return item.id === id;
            });

            if (!preset || !preset.html) {
                return;
            }

            var $row = createElementFromHTML(preset.html);
            if (!$row || !$row.dataset || $row.dataset.blockType !== 'row') {
                return;
            }

            $row.classList.remove('integrated-grid-drop-target', 'integrated-grid-drop-before', 'integrated-grid-drop-after');
            var position = resolveSectionPresetInsertPosition();
            if (!position || !position.parent) {
                return;
            }

            if (position.before) {
                position.parent.insertBefore($row, position.before);
            } else {
                position.parent.appendChild($row);
            }

            ensureInsertedRowControls($row);
            $row.querySelectorAll('[data-block-type="column"]').forEach(item => initSortable(item));
            closeBlockSelectorPanel();
            rememberState();
        };

        var openSectionPresetPanel = function($trigger) {
            sectionPresetInsertContext = $trigger || null;
            sectionPresetCache = [];

            openBlockSelectorPanel(
                '<div class="integrated-block-results-loading"><span class="integrated-inline-spinner"></span><span>{% trans %}Loading section presets...{% endtrans %}</span></div>',
                {
                    eyebrow: '{% trans %}Section library{% endtrans %}',
                    title: '{% trans %}Insert section preset{% endtrans %}',
                    context: '',
                }
            );

            fetchSectionPresets().then(function(presets) {
                sectionPresetCache = presets;
                updateBlockSelectorPanelContent(renderSectionPresetPanel());
            });
        };


        /**
         * @param element $block
         */
        var refreshBlock = function($block, buttons = true, trackState = true) {
            fetch(
                '{{ path('integrated_block_block_show', {'id': 'block-id'}) }}'.replace('block-id', encodeURIComponent($block.dataset.id))).
                then(response => {
                    if (!response.ok) {
                        throw new Error('Unable to load block preview');
                    }

                    return response.json();
                }).
                then(data => {
                    var existingWrapper = $block.querySelector(':scope > .integrated-block');
                    var wrapperClasses = existingWrapper ? existingWrapper.className : 'integrated-block';
                    var parsedWrapperClasses = wrapperClasses
                        .split(/\s+/)
                        .map(className => className.trim())
                        .filter(className => className !== '');

                    if (!parsedWrapperClasses.includes('integrated-block')) {
                        parsedWrapperClasses.unshift('integrated-block');
                    }

                    if (isTailwindLayout($block) && !parsedWrapperClasses.includes('w-full')) {
                        parsedWrapperClasses.push('w-full');
                    }

                    if (data.cssClass) {
                        data.cssClass
                            .split(/\s+/)
                            .map(className => className.trim())
                            .filter(className => className !== '')
                            .forEach(className => {
                                if (!parsedWrapperClasses.includes(className)) {
                                    parsedWrapperClasses.push(className);
                                }
                            });
                    }

                    $block.innerHTML = '<div class="' + parsedWrapperClasses.join(' ') + '">' + data.html + '</div>';

                    $block.className = '';
                    $block.classList.add('integrated-website-sortable');

                    if (buttons) {
                        $block.prepend(createBlockButtons(), $block.firstChild);
                    }

                    if (trackState) {
                        rememberState();
                    }
                }).
                catch(function() {
                    $block.innerHTML = '<div class="integrated-menu-empty-action" style="padding:8px 12px">{% trans %}Unable to load block preview{% endtrans %}</div>';
                });

        };

        /**
         * @return element
         */
        var createRow = function($context) {
            var element = document.createElement('div');

            element.dataset.blockType = 'row';
            element.classList.add('row');
            element.classList.add('integrated-website-sortable');
            if (isTailwindLayout($context)) {
                element.classList.add('flex');
                element.classList.add('flex-wrap');
            }

            return element;
        };

        /**
         * @param size
         */
        var createColumn = function(size, $context) {
            var element = document.createElement('div');
            var normalizedSize = parseInt(size, 10);
            if (!Number.isInteger(normalizedSize) || normalizedSize < 1) {
                normalizedSize = COLUMN_GRID_UNITS;
            }
            var useTailwindLayout = isTailwindLayout($context);

            element.dataset.blockType = 'column';
            element.dataset.size = normalizedSize;
            element.classList.add('integrated-website-col');
            element.classList.add('integrated-website-droppable');

            if (useTailwindLayout) {
                element.classList.add('w-full');
                if (normalizedSize !== COLUMN_GRID_UNITS) {
                    element.classList.add('md:w-' + normalizedSize + '/12');
                }
            } else {
                element.classList.add('col-sm-' + normalizedSize);
            }

            element.appendChild(createColumnButtons());

            initSortable(element);

            return element;
        };

        var normalizeColumnSizes = function(sizes) {
            var normalized = sizes
                .map(size => parseInt(size, 10))
                .filter(size => Number.isInteger(size) && size > 0);

            if (!normalized.length) {
                return [COLUMN_GRID_UNITS];
            }

            var sum = normalized.reduce((total, size) => total + size, 0);

            if (sum !== COLUMN_GRID_UNITS) {
                return null;
            }

            return normalized;
        };

        var getRowColumnSizes = function($row) {
            return Array.from($row.querySelectorAll(':scope > [data-block-type="column"]'))
                .map(column => parseInt(column.dataset.size, 10))
                .filter(size => Number.isInteger(size) && size > 0);
        };

        var buildEvenSizes = function(count) {
            var parsedCount = parseInt(count, 10);
            if (!Number.isInteger(parsedCount) || parsedCount < 1 || parsedCount > COLUMN_GRID_UNITS) {
                return [COLUMN_GRID_UNITS];
            }

            var base = Math.floor(COLUMN_GRID_UNITS / parsedCount);
            var remainder = COLUMN_GRID_UNITS % parsedCount;
            var sizes = [];

            for (var i = 0; i < parsedCount; i++) {
                sizes.push(base + (i < remainder ? 1 : 0));
            }

            return sizes;
        };

        var renderColumnInputs = function(sizes) {
            return sizes.map((size, index) => '' +
                '<label class="integrated-column-layout-field">' +
                '  <span>{% trans %}Column{% endtrans %} ' + (index + 1) + '</span>' +
                '  <input type="number" min="1" max="' + COLUMN_GRID_UNITS + '" value="' + size + '" data-role="column-size" class="integrated-form-control">' +
                '</label>').join('');
        };

        var renderPresetVisual = function(layout) {
            var widths = layout.split('-').map(part => parseInt(part, 10)).filter(width => Number.isInteger(width) && width > 0);

            return widths.map(width => '' +
                '<span class="integrated-column-layout-preset-segment" style="width:' + ((width / COLUMN_GRID_UNITS) * 100) + '%"></span>'
            ).join('');
        };

        var renderPresetButton = function(layout, label, selectedLayout) {
            return '' +
                '<button type="button" class="integrated-column-layout-preset' + (layout === selectedLayout ? ' is-selected' : '') + '" data-role="layout-preset" data-layout="' + layout + '">' +
                '  <span class="integrated-column-layout-preset-visual">' + renderPresetVisual(layout) + '</span>' +
                '  <span class="integrated-column-layout-preset-label">' + label + '</span>' +
                '</button>';
        };

        var renderColumnLayoutModal = function(mode, sizes) {
            var normalizedSizes = sizes && sizes.length ? sizes : [COLUMN_GRID_UNITS];
            var selectedLayout = normalizedSizes.join('-');
            var title = mode === 'add' ? '{% trans %}Add columns{% endtrans %}' : '{% trans %}Configure columns{% endtrans %}';

            return '' +
                '<div class="integrated-column-layout-modal">' +
                '  <h3 class="integrated-column-layout-title">{% trans %}Select your structure{% endtrans %}</h3>' +
                '  <p class="integrated-column-layout-help">{% trans %}Choose a layout preset. You can fine-tune widths manually below. Total must be 12.{% endtrans %}</p>' +
                '  <div class="integrated-column-layout-presets">' +
                renderPresetButton('12', '1/1', selectedLayout) +
                renderPresetButton('6-6', '1/2 + 1/2', selectedLayout) +
                renderPresetButton('4-4-4', '1/3 + 1/3 + 1/3', selectedLayout) +
