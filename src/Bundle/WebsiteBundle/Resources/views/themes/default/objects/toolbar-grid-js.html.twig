        });

        document.body.addEventListener('click', function(e) {
            element = e.target.closest('[data-action="integrated-website-section-preset-save"]');
            if (!element) {
                return;
            }

            e.preventDefault();

            var $row = element.closest('[data-block-type="row"]');
            if (!$row) {
                return;
            }

            var name = window.prompt('{% trans %}Preset name{% endtrans %}', '{% trans %}New section preset{% endtrans %}');
            if (!name) {
                return;
            }

            saveSectionPreset(name, $row.outerHTML).then(function(savedPreset) {
                sectionPresetCache = sectionPresetCache.filter(function(item) {
                    return item.id !== savedPreset.id;
                });
                sectionPresetCache.unshift(savedPreset);
            }).catch(function(error) {
                alert(getPresetErrorMessage(error, '{% trans %}Unable to save section preset{% endtrans %}'));
            });
        });

        document.body.addEventListener('click', function(e) {
            element = e.target.closest('[data-action="integrated-website-section-preset-use"]');
            if (!element) {
                return;
            }

            e.preventDefault();
            insertSectionPresetById(element.dataset.id || '');
        });

        document.body.addEventListener('click', function(e) {
            element = e.target.closest('[data-action="integrated-website-section-preset-delete"]');
            if (!element) {
                return;
            }

            e.preventDefault();
            if (!window.confirm('{% trans %}Delete this section preset?{% endtrans %}')) {
                return;
            }

            var presetId = element.dataset.id || '';
            if (!presetId) {
                return;
            }

            deleteSectionPreset(presetId).then(function() {
                sectionPresetCache = sectionPresetCache.filter(function(item) {
                    return item.id !== presetId;
                });
                updateBlockSelectorPanelContent(renderSectionPresetPanel());
            }).catch(function(error) {
                alert(getPresetErrorMessage(error, '{% trans %}Unable to delete section preset{% endtrans %}'));
            });
        });

        document.body.addEventListener('click', function(e) {
            element = e.target.closest('[data-action="integrated-website-cols-add"]');
            if (!element) {
                return;
            }

            e.preventDefault();
            openColumnLayoutModal('add', [COLUMN_GRID_UNITS], null, element.parentNode);
        });

        /**
         * Update row and columns
         */
        document.body.addEventListener('click', function(e) {
            element = e.target.closest('[data-action="integrated-website-cols-config"]');
            if (!element) {
                return;
            }

            e.preventDefault();

            var $row = element.parentNode.parentNode;
            var sizes = getRowColumnSizes($row);
            openColumnLayoutModal('config', sizes, $row, null);
        });

        document.body.addEventListener('click', function(e) {
            element = e.target.closest('[data-role="layout-preset"]');
            if (!element) {
                return;
            }

            e.preventDefault();

            var $form = document.querySelector('#integrated-column-layout-form');
            if (!$form) {
                return;
            }

            var sizes = element.dataset.layout.split('-').map(size => parseInt(size, 10));
            $form.querySelector('[data-role="column-count"]').value = sizes.length;
            $form.querySelector('#integrated-column-layout-fields').innerHTML = renderColumnInputs(sizes);
            syncColumnLayoutTotal($form);

            $form.closest('.integrated-column-layout-modal')
                .querySelectorAll('[data-role="layout-preset"]')
                .forEach(function($preset) {
                    $preset.classList.toggle('is-selected', $preset === element);
                });
        });

        document.body.addEventListener('change', function(e) {
            var $count = e.target.closest('[data-role="column-count"]');
            if (!$count) {
                return;
            }

            var $form = $count.closest('#integrated-column-layout-form');
            if (!$form) {
                return;
            }

            var sizes = buildEvenSizes($count.value);
            $form.querySelector('#integrated-column-layout-fields').innerHTML = renderColumnInputs(sizes);
            syncColumnLayoutTotal($form);

            $form.closest('.integrated-column-layout-modal')
                .querySelectorAll('[data-role="layout-preset"]')
                .forEach(function($preset) {
                    $preset.classList.remove('is-selected');
                });
        });

        document.body.addEventListener('input', function(e) {
            var $size = e.target.closest('[data-role="column-size"]');
            if (!$size) {
                return;
            }

            var $form = $size.closest('#integrated-column-layout-form');
            if ($form) {
                syncColumnLayoutTotal($form);
            }
        });

        document.body.addEventListener('click', function(e) {
            element = e.target.closest('[data-action="integrated-column-layout-cancel"]');
            if (!element) {
                return;
            }

            e.preventDefault();
            closeBlockSelectorPanel();
            $columnLayoutTarget = null;
            $columnLayoutInsertBefore = null;
        });

        document.body.addEventListener('submit', function(e) {
            if (e.target.id !== 'integrated-column-layout-form') {
                return;
            }

            e.preventDefault();

            var $form = e.target;
            var mode = $form.dataset.mode;
            var sizes = normalizeColumnSizes(readColumnSizesFromForm($form));

            if (!sizes) {
                alert('{% trans %}Column sizes must add up to 12{% endtrans %}');
                return;
            }

            if (mode === 'add') {
                if (!$columnLayoutInsertBefore) {
                    closeBlockSelectorPanel();
                    return;
                }

                var $row = createRow($columnLayoutInsertBefore);
                sizes.forEach(size => $row.append(createColumn(size, $row)));
                $row.append(createRowButtons());
                $columnLayoutInsertBefore.insertAdjacentElement('beforebegin', $row);
            }

            if (mode === 'config' && $columnLayoutTarget) {
                var $oldColumns = $columnLayoutTarget.querySelectorAll(':scope > [data-block-type="column"]');
                var useTailwindLayout = isTailwindLayout($columnLayoutTarget);

                for (var i = 0; i < sizes.length; i++) {
                    var size = sizes[i];
                    var colClass = '';

                    if (useTailwindLayout) {
                        colClass = ' w-full';
                        if (size !== COLUMN_GRID_UNITS) {
                            colClass += ' md:w-' + size + '/12';
                        }
                    } else {
                        colClass = ' col-sm-' + size;
                    }

                    if ($oldColumns[i]) {
                        $oldColumns[i].setAttribute('class', 'integrated-website-col integrated-website-droppable' + colClass);
                        $oldColumns[i].dataset.size = size;
                    } else {
                        $columnLayoutTarget.appendChild(createColumn(size, $columnLayoutTarget));
                    }
                }

                while (typeof $oldColumns[i] !== 'undefined') {
                    $oldColumns[i].parentNode.removeChild($oldColumns[i]);
                    i++;
                }
            }

            closeBlockSelectorPanel();
            $columnLayoutTarget = null;
            $columnLayoutInsertBefore = null;
            rememberState();
        });

        document.body.addEventListener('click', function(e) {
            element = e.target.closest('[data-action="integrated-website-history-undo"]');
            if (!element) {
                return;
            }

            e.preventDefault();
            undoState();
        });

        document.body.addEventListener('click', function(e) {
            element = e.target.closest('[data-action="integrated-website-history-redo"]');
            if (!element) {
                return;
            }

            e.preventDefault();
            redoState();
        });

        /**
         * Handle new channel block button
         */
        document.body.addEventListener('click', function(e) {
            element = e.target.closest('[data-action="integrated-website-block-new-channel-block"]');
            if (!element) {
                return;
            }

            e.preventDefault();

            button = element;
            id = element.dataset.id;
            name = element.dataset.name;
            className = element.dataset.class;
            csrfToken = element.dataset.csrfToken;

            $blockTarget = document.getElementById('#create-channel-block-' + id);

            showLoader();

            let formData = new FormData();
            formData.append('id', id);
            formData.append('class', className);
            formData.append('name', name);
            formData.append('csrf_token', csrfToken);

            fetch('{{ path('integrated_block_channel_block_new') }}', {
                method: 'POST',
                body: formData,
            }).then(response => response.json()).then(data => {
                hideLoader();

                var url = '{{ path('integrated_block_block_edit', {'id': 'block-id', '_format':'iframe.html'}) }}'.replace(
                    'block-id', id);
                createBlockEditor(url, '{% trans %}Edit block{% endtrans %}');
            });

        });

        /**
         * Handle new textblock button
         */
        document.body.addEventListener('click', function(e) {
            element = e.target.closest('[data-action="integrated-website-textblock-add"]');
            if (!element) {
                return;
            }

            e.preventDefault();

            $blockTarget = element.parentNode;
            if (element.classList.contains('integrated-website-block-column-add')) {
                $blockTarget = $blockTarget.parentNode;
            }

            var pageId = document.querySelector('[data-action="integrated-website-page-save"]').dataset.id;

            createBlockEditor(
                '{{ path('integrated_block_inline_text_block_new', {'id': 'page-id', '_format':'iframe.html'}) }}'.replace('page-id', pageId),
                '{% trans %}New block{% endtrans %}');
        });

        /**
         * @param {string} url
         * @param {string} title
         */
        var createBlockEditor = function(url, title) {
            var frameUrl = url.replace('/turbo.html', '/iframe.html');

            openBlockSelectorPanel(
                '<div class="integrated-block-results-loading"><span class="integrated-inline-spinner"></span><span>{% trans %}Loading blocks...{% endtrans %}</span></div>',
                {
                eyebrow: '{% trans %}Block builder{% endtrans %}',
                title: title,
                context: '',
                panelClass: 'integrated-block-selector-panel-iframe',
            });

            var frame = document.createElement('iframe');
            frame.className = 'integrated-iframe';
            frame.setAttribute('src', frameUrl);
            frame.setAttribute('frameborder', '0');
            updateBlockSelectorPanelContent(frame.outerHTML);
        };

        /**
         * @param $element
         */
        var initSortable = function($element) {
            if ($element.__integratedSortableInstance) {
                return;
            }

            var clearDropTargets = function() {
                var $grid = resolveGridContext($element);
                if (!$grid || typeof $grid.querySelectorAll !== 'function') {
                    return;
                }

                $grid.querySelectorAll('.integrated-grid-drop-target, .integrated-grid-drop-before, .integrated-grid-drop-after').forEach(function(node) {
                    node.classList.remove('integrated-grid-drop-target');
                    node.classList.remove('integrated-grid-drop-before');
                    node.classList.remove('integrated-grid-drop-after');
                });
            };

            var applyDropTarget = function(evt) {
                clearDropTargets();

                if (!evt) {
                    return;
                }

                var target = evt.to;
                if (target && target.classList) {
                    target.classList.add('integrated-grid-drop-target');
                }

                var related = evt.related;
                if (related && related.classList && related.classList.contains('integrated-website-sortable')) {
                    related.classList.add(evt.willInsertAfter ? 'integrated-grid-drop-after' : 'integrated-grid-drop-before');
                }
            };

            $element.__integratedSortableInstance = new Sortable($element, {
                group: 'integrated-grid',
                sort: true,
                forceFallback: true,
                fallbackOnBody: true,
                delayOnTouchOnly: true,
                delay: 120,
                scrollSpeed: 80,
                animation: 120,
                draggable: '.integrated-website-sortable',
                handle: '.integrated-drag-handle',
                ghostClass: 'integrated-website-item-ghost',
                filter: '.integrated-block-button:not(.integrated-drag-handle)',
                dragClass: 'integrated-website-item-dragging',
                onStart: function() {
                    setSortableActive(true);
                    clearDropTargets();
                },
                onMove: function(evt) {
                    applyDropTarget(evt);
                    return true;
                },
                onEnd: function() {
                    clearDropTargets();
                    setSortableActive(false);
                    rememberState();
                },
            });
        };

        /**
         * Handle block add/edit save callbacks.
         */
        document.addEventListener('block-added', function(e) {
            closeBlockSelectorPanel();

            var insertedBlock = null;
            if ($blockTarget) {
                //new block inserted
                insertedBlock = addBlock(e.detail, $blockTarget);
            }

            $blockTarget = null;
            $lastBlockAddTrigger = null;

            if (!insertedBlock) {
                //update block

                document.querySelectorAll('[data-id="' + e.detail + '"]').forEach(item => {
                    refreshBlock(item, true, false);
                });
            }
        }, false);

        document.addEventListener('block-canceled', function() {
            closeBlockSelectorPanel();
            $blockTarget = null;
            $lastBlockAddTrigger = null;
        }, false);

        document.addEventListener('block-deleted', function(e) {
            closeBlockSelectorPanel();

            document.querySelectorAll('[data-id="' + e.detail + '"]').forEach(function(item) {
                if (item.parentNode) {
                    item.parentNode.removeChild(item);
                }
            });

            $blockTarget = null;
            $lastBlockAddTrigger = null;
            rememberState();
        }, false);

        /**
         * Modal eventlisteners
         */

        /**
         * Handle block edit in iframe
         */
        document.addEventListener('change', function(e) {
            if (!e.target.classList.contains('integrated-block-filter')) {
                return;
            }
            refreshBlockData(document.querySelector('#add_block_filters_form'));
            return false;
        });

        document.addEventListener('submit', function(e) {
            if (e.target.id != 'add_block_filters_form') {
                return;
            }

            e.preventDefault();
            refreshBlockData(e.target);
        });

        document.body.addEventListener('click', function(e) {
            element = e.target.closest('#add_block_pagination li');
            if (!element) {
                return;
            }

            e.preventDefault();

            let form = document.querySelector('#add_block_filters_form');
            form.setAttribute('action', element.dataset.href);
            refreshBlockData(form);

            return false;
        });

        function refreshBlockData(form) {
            document.querySelector('#add_block_results').innerHTML = '{% trans %}Loading blocks...{% endtrans %}';

            fetch(form.action, {
                method: 'post',
                body: new URLSearchParams(new FormData(form)),
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                },
            }).then(response => response.json()).then(data => {
                data.type = document.querySelector('[name="integrated_block_filter[type][]"] option:checked').value;
                data.q = document.querySelector('[name="integrated_block_filter[q]"]').value;
                data.channel = document.querySelector(
                    '[name="integrated_block_filter[channels][]"] option:checked').value;

                document.querySelector('#add_block_results').parentElement.outerHTML = addBlockModalTemplateHTML(data);
            });
        }

        var blockFilterDebounce;
        document.addEventListener('input', function(e) {
            if (e.target.id !== 'integrated_block_filter_q') {
                return;
            }

            window.clearTimeout(blockFilterDebounce);
            blockFilterDebounce = window.setTimeout(function() {
                var form = document.querySelector('#add_block_filters_form');
                if (form) {
                    refreshBlockData(form);
                }
            }, 220);
        });

        window.Integrated = Object.assign({}, window.Integrated || {}, {
            Grid: {
                serializeState: function() {
                    return serializeGridState();
                },
                restoreState: function(serializedState) {
                    if (typeof serializedState !== 'string') {
                        return;
                    }

                    restoreGridState(serializedState);
                    rememberStateNow();
                }
            }
        });
    }(window.Routing);

    var Integrated = Integrated || {};
</script>
