            <path
                d="M507.331 411.33c-0.002-0.002-0.004-0.004-0.006-0.005l-155.322-155.325 155.322-155.325c0.002-0.002 0.004-0.003 0.006-0.005 1.672-1.673 2.881-3.627 3.656-5.708 2.123-5.688 0.912-12.341-3.662-16.915l-73.373-73.373c-4.574-4.573-11.225-5.783-16.914-3.66-2.080 0.775-4.035 1.984-5.709 3.655 0 0.002-0.002 0.003-0.004 0.005l-155.324 155.326-155.324-155.325c-0.002-0.002-0.003-0.003-0.005-0.005-1.673-1.671-3.627-2.88-5.707-3.655-5.69-2.124-12.341-0.913-16.915 3.66l-73.374 73.374c-4.574 4.574-5.784 11.226-3.661 16.914 0.776 2.080 1.985 4.036 3.656 5.708 0.002 0.001 0.003 0.003 0.005 0.005l155.325 155.324-155.325 155.326c-0.001 0.002-0.003 0.003-0.004 0.005-1.671 1.673-2.88 3.627-3.657 5.707-2.124 5.688-0.913 12.341 3.661 16.915l73.374 73.373c4.575 4.574 11.226 5.784 16.915 3.661 2.080-0.776 4.035-1.985 5.708-3.656 0.001-0.002 0.003-0.003 0.005-0.005l155.324-155.325 155.324 155.325c0.002 0.001 0.004 0.003 0.006 0.004 1.674 1.672 3.627 2.881 5.707 3.657 5.689 2.123 12.342 0.913 16.914-3.661l73.373-73.374c4.574-4.574 5.785-11.227 3.662-16.915-0.776-2.080-1.985-4.034-3.657-5.707z"></path>
        </symbol>
        <symbol id="integrated-icon-column2" viewBox="0 0 416 448">
            <path
                d="M40 384h152v-288h-160v280c0 4.25 3.75 8 8 8zM384 376v-280h-160v288h152c4.25 0 8-3.75 8-8zM416 72v304c0 22-18 40-40 40h-336c-22 0-40-18-40-40v-304c0-22 18-40 40-40h336c22 0 40 18 40 40z"></path>
        </symbol>
        <symbol id="integrated-icon-column" viewBox="0 0 768 768">
            <path
                d="M511.5 160.5h160.5v415.5h-160.5v-415.5zM127.5 576v-415.5h160.5v415.5h-160.5zM319.5 576v-415.5h160.5v415.5h-160.5z"></path>
        </symbol>
        <symbol id="integrated-icon-text" viewBox="0 0 32 32">
            <path
                d="M10.063 26l1.8-6h8.274l1.8 6h3.551l-6-20h-6.976l-6 20h3.551zM14.863 10h2.274l1.8 6h-5.874l1.8-6z"></path>
        </symbol>
    </defs>
</svg>
<script>
    !function(Routing) {
        /**
         * @type object|null
         */
        var $blockTarget = null;
        var $columnLayoutTarget = null;
        var $columnLayoutInsertBefore = null;
        var COLUMN_GRID_UNITS = 12;
        var historyPast = [];
        var historyFuture = [];
        var historyLimit = 40;

        /**
         * @param Element $element
         */
        var initGrid = function($element) {
            $element.querySelectorAll('[data-block-type="row"]').forEach(item =>
                item.insertBefore(createRowButtons(), item.firstChild),
            );

            $element.querySelectorAll('[data-block-type="column"]').forEach(item =>
                item.appendChild(createColumnButtons()),
            );

            $element.appendChild(createColumnButtons());

            $element.querySelectorAll('[data-block-type="block"]').forEach(item => {
                item.prepend(createBlockButtons());
            });
        };

        /**
         * @param {string} blockId
         * @param element  $before
         */
        var addBlock = function(blockId, $before) {
            var element = document.createElement('div');

            element.dataset.id = blockId;
            element.dataset.blockType = 'block';
            element.classList.add('integrated-website-sortable');

            $before.insertAdjacentElement('beforebegin', element);

            refreshBlock(element);
        };

        /**
         * @param element $block
         */
        var refreshBlock = function($block, buttons = true) {
            fetch(
                '{{ path('integrated_block_block_show', {'id': 'block-id'}) }}'.replace('block-id', $block.dataset.id)).
                then(response => response.json()).
                then(data => {
                    $block.innerHTML = data.html;

                    $block.className = '';

                    if (data.cssClass) {
                        $block.classList.add('integrated-website-sortable', ...data.cssClass.split(" "));
                    } else {
                        $block.classList.add('integrated-website-sortable');
                    }

                    if (buttons) {
                        $block.prepend(createBlockButtons(), $block.firstChild);
                    }

                    rememberState();
                });

        };

        /**
         * @return element
         */
        var createRow = function() {
            var element = document.createElement('div');

            element.dataset.blockType = 'row';
            element.classList.add('row');
            element.classList.add('integrated-website-sortable');
            if (typeof framework !== 'undefined' && framework === 'tailwind') {
                element.classList.add('flex');
                element.classList.add('flex-wrap');
            }

            return element;
        };

        /**
         * @param size
         */
        var createColumn = function(size) {
            var element = document.createElement('div');
            var colClass = 'w-full';

            element.dataset.blockType = 'column';
            element.dataset.size = size;
            element.classList.add('integrated-website-col');
            element.classList.add('integrated-website-droppable');

            if (typeof framework !== 'undefined' && (size !== 12 && framework === 'tailwind')) {
                var colClass = ['w-full', 'md:w-' + size + '/12'];
                element.classList.add(...colClass);
            } else {
                var colClass = 'col-sm-' + size;
                element.classList.add(colClass);
            }

            element.appendChild(createColumnButtons());

            initSortable(element);

            return element;
        };

        var normalizeColumnSizes = function(sizes) {
            var normalized = sizes
                .map(size => parseInt(size, 10))
                .filter(size => Number.isInteger(size) && size > 0);

            if (!normalized.length) {
                return [COLUMN_GRID_UNITS];
            }

            var sum = normalized.reduce((total, size) => total + size, 0);

            if (sum !== COLUMN_GRID_UNITS) {
                return null;
            }

            return normalized;
        };

        var getRowColumnSizes = function($row) {
            return Array.from($row.querySelectorAll(':scope > [data-block-type="column"]'))
                .map(column => parseInt(column.dataset.size, 10))
                .filter(size => Number.isInteger(size) && size > 0);
        };

        var buildEvenSizes = function(count) {
            var parsedCount = parseInt(count, 10);
            if (!Number.isInteger(parsedCount) || parsedCount < 1 || parsedCount > COLUMN_GRID_UNITS) {
                return [COLUMN_GRID_UNITS];
            }

            var base = Math.floor(COLUMN_GRID_UNITS / parsedCount);
            var remainder = COLUMN_GRID_UNITS % parsedCount;
            var sizes = [];

            for (var i = 0; i < parsedCount; i++) {
                sizes.push(base + (i < remainder ? 1 : 0));
            }

            return sizes;
        };

        var renderColumnInputs = function(sizes) {
            return sizes.map((size, index) => '' +
                '<label class="integrated-column-layout-field">' +
                '  <span>{% trans %}Column{% endtrans %} ' + (index + 1) + '</span>' +
                '  <input type="number" min="1" max="' + COLUMN_GRID_UNITS + '" value="' + size + '" data-role="column-size" class="integrated-form-control">' +
                '</label>').join('');
        };

        var renderColumnLayoutModal = function(mode, sizes) {
            var normalizedSizes = sizes && sizes.length ? sizes : [COLUMN_GRID_UNITS];
            var title = mode === 'add' ? '{% trans %}Add columns{% endtrans %}' : '{% trans %}Configure columns{% endtrans %}';

            return '' +
                '<div class="integrated-column-layout-modal">' +
                '  <p class="integrated-column-layout-help">{% trans %}Choose a layout preset or set column widths manually. Total must be 12.{% endtrans %}</p>' +
                '  <div class="integrated-column-layout-presets">' +
                '    <button type="button" class="btn btn-white" data-role="layout-preset" data-layout="12">1/1</button>' +
                '    <button type="button" class="btn btn-white" data-role="layout-preset" data-layout="6-6">1/2 + 1/2</button>' +
                '    <button type="button" class="btn btn-white" data-role="layout-preset" data-layout="4-4-4">1/3 + 1/3 + 1/3</button>' +
                '    <button type="button" class="btn btn-white" data-role="layout-preset" data-layout="3-3-3-3">1/4 + 1/4 + 1/4 + 1/4</button>' +
                '    <button type="button" class="btn btn-white" data-role="layout-preset" data-layout="8-4">2/3 + 1/3</button>' +
                '    <button type="button" class="btn btn-white" data-role="layout-preset" data-layout="4-8">1/3 + 2/3</button>' +
                '    <button type="button" class="btn btn-white" data-role="layout-preset" data-layout="3-6-3">1/4 + 1/2 + 1/4</button>' +
                '  </div>' +
                '  <form id="integrated-column-layout-form" class="integrated-column-layout-form" data-mode="' + mode + '">' +
                '    <label class="integrated-column-layout-count">' +
                '      <span>{% trans %}Number of columns{% endtrans %}</span>' +
                '      <input type="number" min="1" max="' + COLUMN_GRID_UNITS + '" value="' + normalizedSizes.length + '" data-role="column-count" class="integrated-form-control">' +
                '    </label>' +
                '    <div id="integrated-column-layout-fields" class="integrated-column-layout-fields">' + renderColumnInputs(normalizedSizes) + '</div>' +
                '    <p class="integrated-column-layout-total">{% trans %}Total{% endtrans %}: <strong data-role="column-total">' + normalizedSizes.reduce((sum, value) => sum + value, 0) + '</strong>/12</p>' +
                '    <div class="integrated-column-layout-actions">' +
                '      <button type="submit" class="btn btn-green"><span>' + title + '</span></button>' +
                '      <button type="button" class="btn btn-white" data-action="integrated-column-layout-cancel"><span>{% trans %}Cancel{% endtrans %}</span></button>' +
                '    </div>' +
                '  </form>' +
                '</div>';
        };

        var readColumnSizesFromForm = function($form) {
            return Array.from($form.querySelectorAll('[data-role="column-size"]'))
                .map(input => parseInt(input.value, 10))
                .filter(size => Number.isInteger(size) && size > 0);
        };

        var syncColumnLayoutTotal = function($form) {
            var total = readColumnSizesFromForm($form).reduce((sum, size) => sum + size, 0);
            var $total = $form.querySelector('[data-role="column-total"]');
            if ($total) {
                $total.textContent = total;
            }
        };

        var openColumnLayoutModal = function(mode, sizes, $targetRow, $insertBefore) {
            $columnLayoutTarget = $targetRow || null;
            $columnLayoutInsertBefore = $insertBefore || null;
            Integrated.showModal(
                mode === 'add' ? '{% trans %}Add columns{% endtrans %}' : '{% trans %}Configure columns{% endtrans %}',
                renderColumnLayoutModal(mode, sizes),
            );
        };

        /**
         * @return Element
         */
        var createRowButtons = function() {
            var element = document.createElement('div');
            element.classList.add('integrated-row-buttons');
            element.innerHTML = '' +
                '<span class="integrated-block-button integrated-drag-handle" title="{% trans %}Drag row{% endtrans %}">' +
                '  <i class="iconoir-drag-hand-gesture"></i>' +
                '</span>' +
                '<a href="javascript:;" class="integrated-block-button integrated-website-block-column-add" data-action="integrated-website-block-add" title="{% trans %}Add block{% endtrans %}">' +
                '  <i class="iconoir-plus"></i>' +
                '</a>' +
                '<a href="javascript:;" class="integrated-block-button" data-action="integrated-website-cols-config" title="{% trans %}Configure columns{% endtrans %}">' +
                '  <i class="iconoir-settings"></i>' +
                '</a>' +
                '<a href="javascript:;" class="integrated-block-button integrated-website-column-remove" data-action="integrated-website-column-remove" title="{% trans %}Remove{% endtrans %}">' +
                '  <i class="iconoir-xmark"></i>' +
                '</a>';

            return element;
        };

        /**
         * @return Element
         */
        var createColumnButtons = function() {
            var element = document.createElement('div');
            element.classList.add('integrated-column-buttons');
            element.innerHTML = '' +
                '<a href="javascript:;" class="integrated-block-button block" data-action="integrated-website-block-add" title="{% trans %}Add block{% endtrans %}">' +
                '  <i class="iconoir-plus"></i>' +
                '</a>' +
                '<a href="javascript:;" class="integrated-block-button text" data-action="integrated-website-textblock-add" title="{% trans %}Add text block{% endtrans %}">' +
                '   <i class="iconoir-text"></i>' +
                '</a>' +
                '<a href="javascript:;" class="integrated-block-button columns" data-action="integrated-website-cols-add" title="{% trans %}Add columns{% endtrans %}">' +
                '   <i class="iconoir-view-columns-3"></i>' +
                '</a>';

            return element;
        };

        /**
         * @return Element
         */
        var createBlockButtons = function() {
            var element = document.createElement('div');
            element.classList.add('integrated-block-buttons');
            element.innerHTML =
                '<span class="integrated-block-button integrated-drag-handle" title="{% trans %}Drag block{% endtrans %}">' +
                '  <i class="iconoir-drag-hand-gesture"></i>' +
                '</span>' +
                '<a href="javascript:;" class="integrated-block-button" data-action="integrated-website-block-add" title="{% trans %}Add{% endtrans %}">' +
                '  <i class="iconoir-plus"></i>' +
                '</a>' +

                '<a href="javascript:;" class="integrated-block-button integrated-website-block-edit" data-action="integrated-website-block-edit" title="{% trans %}Edit{% endtrans %}">' +
                '  <i class="iconoir-edit-pencil"></i>' +
                '</a>' +

                '<a href="javascript:;" class="integrated-block-button integrated-website-block-remove" data-action="integrated-website-block-remove" title="{% trans %}Remove{% endtrans %}">' +
                '  <i class="iconoir-xmark"></i>' +
                '</a>';

            return element;
        };

        var getGridRoots = function() {
            return Array.from(document.querySelectorAll('.integrated-website-grid'));
        };

        var serializeGridState = function() {
            return JSON.stringify(getGridRoots().map(item => item.innerHTML));
        };

        var restoreGridState = function(serializedState) {
            var state = JSON.parse(serializedState);
            var roots = getGridRoots();

            roots.forEach((root, index) => {
                root.innerHTML = state[index] || '';
            });

            document.querySelectorAll('.integrated-website-droppable').forEach(item => {
                initSortable(item);
            });
        };

        var rememberState = function() {
            var state = serializeGridState();
            if (historyPast.length && historyPast[historyPast.length - 1] === state) {
                return;
            }

            historyPast.push(state);
            if (historyPast.length > historyLimit) {
                historyPast.shift();
            }

            historyFuture = [];
        };

        var undoState = function() {
            if (historyPast.length < 2) {
                return;
            }

            var current = historyPast.pop();
            historyFuture.push(current);
            restoreGridState(historyPast[historyPast.length - 1]);
        };

        var redoState = function() {
            if (!historyFuture.length) {
                return;
            }

            var state = historyFuture.pop();
            historyPast.push(state);
            restoreGridState(state);
        };

        var showLoader = function() {
            let element = document.createElement('div');

            element.innerHTML = '<div id="integrated-loader"><div id="integrated-loader-spinner"></div></div>';
            document.querySelector('body').insertAdjacentElement('afterend', element);
        };

        var hideLoader = function() {
            let element = document.querySelector('#integrated-loader');

            element.parentNode.removeChild(element);
        };

        var addBlockModalTemplateHTML = function(data) {
            var output = `<div class="integrated-block-filters">
                   <div id="add_block_filters" class="integrated-control-row">
                       <form id="add_block_filters_form" action="{{ path('integrated_block_block_index', { '_format': 'json', 'limit': 10}) }}">
                        <div class="options">
                           <ul class="">
                               <li class="dropdown">
                                   <a class="integrated-button integrated-button-dropdown btn btn-select" data-integrated-dropdown="integrated-createblock-dropdown" role="button"><span>{% trans %}Create block{% endtrans %}</span>
                                       <i class="iconoir-plus"></i>\n
                                   </a>\n
                                   <ul class="integrated-website-toolbar-dropdown integrated-block-filter" id="integrated-createblock-dropdown">\n
                                            {% for metadata in integrated_find_block_types() %}
                                                {% if 'InlineTextBlock' not in metadata.class %}
                                                               <li role="presentation">\n
                                                                       <a href="{{ path('integrated_block_block_new', { '_format': 'iframe.html', 'class': metadata.class} ) }}" data-action="integrated-website-block-new">{{ metadata.type|default(metadata.class) }}</a>
                                                                   </li>\n
                                                {% endif %}
                                            {% endfor %}
                                        </ul>\n
                               </li>\n
                               <li class="">\n
                                   <select class="integrated-form-control integrated-block-filter btn btn-select" name="integrated_block_filter[type][]" id="integrated_block_filter_type">\n
                                       <option value="">{% trans %}Filter type{% endtrans %}</option>\n
                                        ${data.filters.type.map(
                type => `<option value="${type.value}" ${type.value == data.type ?
                    'selected' :
                    ''}>${type.label}</option>`).join('')}
                                        </select>\n
                               </li>\n
                                     <li class="">\n
                                        <div class="input-group">\n
                                            <input type="text" value="${data.q}" class="integrated-form-control" name="integrated_block_filter[q]" id="integrated_block_filter_q" placeholder="{% trans %}Search{% endtrans %}...">\n
                                        </div>\n
                                    </li>\n
                                    <li class="">\n
                                        <select class="integrated-form-control integrated-block-filter btn btn-select" name="integrated_block_filter[channels][]" id="integrated_block_filter_channels">\n
                                            <option value="">{% trans %}Filter channel{% endtrans %}</option>\n
                                            ${data.filters.channels.map(
                channel => `<option value="${channel.value}" ${channel.value == data.channel ?
                    'selected' :
                    ''}>${channel.label}</option>`).join('')}
                                        </select>\n
                                    </li>\n
                               </li>\n
                           </ul>\n
                        </div>\n
                        </form>\n
                        </div>\n
                        <div id="add_block_results">\n
                           ${data.blocks.map(
                block => `<div class="integrated-card integrated-block-result-card" data-action="integrated-website-block-choose" data-id="${block.id}">
                                    <p class="integrated-block-result-title"><b>${block.title}</b></p>
                                    <p class="integrated-block-result-meta">
                                        <span class="integrated-block-result-type">${block.type}</span>
                                        <span class="integrated-block-result-id">#${block.id.slice(0, 8)}</span>
                                    </p>
                                </div>`).join('')}
                        </div>\n
                        <div>`;

            if (data.blocks.length == 0) {
                output = output + '{% trans %}No blocks found with this search query{% endtrans %}\n';
            }

            if (data.pagination.pageCount > 0) {
                output = output + '<ul class="integrated-pagination" id="add_block_pagination">\n';

                if (data.pagination.previous) {
                    output = output +
                        `<li class="integrated-pagination-link" data-href="${data.pagination.previous.href}">&laquo;</li>`;
                } else {
                    output = output + `<li class="integrated-pagination-disabled"><span>&laquo;</span></li>`;
                }

                for (var key in data.pagination.pages) {
                    page = data.pagination.pages[key];
                    if (data.pagination.page == key) {
                        output = output +
                            `<li class="integrated-pagination-active integrated-pagination-disabled" data-href="${page.href}">${key}</li>`;
                    } else {
                        output = output + `<li class="integrated-pagination-link" data-href="${page.href}">${key}</li>`;
                    }
                }
                ;

                if (data.pagination.next) {
                    output = output +
                        `<li class="integrated-pagination-link" data-href="${data.pagination.next.href}">&raquo;</li>`;
                } else {
                    output = output + `<li class="integrated-pagination-disabled"><span>&raquo;</span></li>`;
                }

                output = output + '</ul>\n';
            }

            output = output + '</div>\n' +
                '    </div>\n';

            return output;
        };

        /**
         * Init grid buttons on page load
         */
        function init() {
            document.querySelectorAll('.integrated-website-grid').forEach(item =>
                initGrid(item),
            );

            /**
             * Make grid sortable
             */
            //
            document.querySelectorAll('.integrated-website-droppable').forEach(item =>
                initSortable(item),
            );

            rememberState();
        }

        if (document.readyState != 'loading') {
            init();
        } else {
            document.addEventListener('DOMContentLoaded', init);
        }

        /**
         * Handle mouseover
         */
        document.body.addEventListener('mouseenter', function(e) {
            element = e.target.closest(
                '[data-action="integrated-website-block-edit"], .integrated-website-block-remove');
            if (!element) {
                return;
            }
            element.parentNode.parentNode.classList.add('integrated-block-hover');
        }, true);

        document.body.addEventListener('mouseenter', function(e) {
            element = e.target.closest('.integrated-website-column-remove');
            if (!element) {
                return;
            }
            element.parentNode.parentNode.classList.add('integrated-block-hover');
        }, true);

        document.body.addEventListener('mouseleave', function(e) {
            element = e.target.closest(
                '[data-action="integrated-website-block-edit"], .integrated-website-block-remove');
            if (!element) {
                return;
            }
            element.parentNode.parentNode.classList.remove('integrated-block-hover');
        }, true);

        document.body.addEventListener('mouseleave', function(e) {
            element = e.target.closest('.integrated-website-column-remove');
            if (!element) {
                return;
            }
            element.parentNode.parentNode.classList.remove('integrated-block-hover');
        }, true);

        document.body.addEventListener('mouseenter', function(e) {
            element = e.target.closest('[data-action="integrated-website-cols-config"]');
            if (!element) {
                return;
            }
            Array.from(element.parentNode.parentNode.children).forEach(item => {
                if (item.classList.contains('integrated-website-col')) {
                    item.classList.add('integrated-block-hover');
                }
            });
        }, true);

        document.body.addEventListener('mouseleave', function(e) {
            element = e.target.closest('[data-action="integrated-website-cols-config"]');
            if (!element) {
                return;
            }

            Array.from(element.parentNode.parentNode.children).forEach(item => {
                if (item.classList.contains('integrated-website-col')) {
                    item.classList.remove('integrated-block-hover');
                }
            });
        }, true);

        /**
         * Handle add block button
         */
        document.body.addEventListener('click', function(e) {
            element = e.target.closest('[data-action="integrated-website-block-add"]');
            if (!element) {
                return;
            }

            e.preventDefault();

            showLoader();

            $blockTarget = element.parentNode;
            if (element.classList.contains('integrated-website-block-column-add')) {
                $blockTarget = $blockTarget.parentNode;
            }

            fetch('{{ path('integrated_block_block_index', { '_format': 'json', 'limit': 10}) }}').
                then(response => response.json()).
                then(data => {
                    // success
                    data.type = '';
                    data.q = '';
                    data.channel = '';

                    Integrated.showModal('{% trans %}Add block{% endtrans %}', addBlockModalTemplateHTML(data));

                    hideLoader();
                });
        });

        /**
         * Handle edit
         */
        document.body.addEventListener('click', function(e) {
            element = e.target.closest('[data-action="integrated-website-block-edit"]');
            if (!element) {
                return;
            }

            e.preventDefault();

            $blockTarget = null;

            editElement = element.parentNode.parentNode;

            var blockId = editElement.dataset.id;
            var url = '{{ path('integrated_block_block_edit', {'id': 'block-id', '_format':'iframe.html'}) }}'.replace(
                'block-id', blockId);
            createIframe(url, 'Edit block');
        });

        /**
         * Handle remove
         */
        document.body.addEventListener('click', function(e) {
            element = e.target.closest('.integrated-website-block-remove');
            if (!element) {
                return;
            }

            e.preventDefault();

            if (confirm('Are you sure?')) {
                removeElement = element.parentNode.parentNode;
                removeElement.parentNode.removeChild(removeElement);
                rememberState();
            }
        });

        /**
         * Handle column remove
         */
        document.body.addEventListener('click', function(e) {
            element = e.target.closest('.integrated-website-column-remove');
            if (!element) {
                return;
            }

            e.preventDefault();

            if (confirm('Are you sure?')) {
                removeElement = element.parentNode.parentNode;
                removeElement.parentNode.removeChild(removeElement);
                rememberState();
            }
        });

        /**
         * Handle choose block button
         */
        document.body.addEventListener('click', function(e) {
            element = e.target.closest('[data-action="integrated-website-block-choose"]');
            if (!element) {
                return;
            }

            addBlock(element.dataset.id, $blockTarget);

            Integrated.hideModal();
        });

        /**
         * Handle new block button
         */
        document.body.addEventListener('click', function(e) {
            element = e.target.closest('[data-action="integrated-website-block-new"]');
            if (!element) {
                return;
            }

            e.preventDefault();

            Integrated.hideModal();
            createIframe(e.target.getAttribute('href'), 'Add block');
        });

        /**
         * Add columns
         */
        document.body.addEventListener('click', function(e) {
            element = e.target.closest('[data-action="integrated-website-cols-add"]');
            if (!element) {
                return;
            }

            e.preventDefault();
            openColumnLayoutModal('add', [COLUMN_GRID_UNITS], null, element.parentNode);
        });

        /**
         * Update row and columns
         */
        document.body.addEventListener('click', function(e) {
            element = e.target.closest('[data-action="integrated-website-cols-config"]');
            if (!element) {
                return;
            }

            e.preventDefault();

            var $row = element.parentNode.parentNode;
            var sizes = getRowColumnSizes($row);
            openColumnLayoutModal('config', sizes, $row, null);
        });

        document.body.addEventListener('click', function(e) {
            element = e.target.closest('[data-role="layout-preset"]');
            if (!element) {
                return;
            }

            e.preventDefault();

            var $form = document.querySelector('#integrated-column-layout-form');
            if (!$form) {
                return;
            }

            var sizes = element.dataset.layout.split('-').map(size => parseInt(size, 10));
            $form.querySelector('[data-role="column-count"]').value = sizes.length;
            $form.querySelector('#integrated-column-layout-fields').innerHTML = renderColumnInputs(sizes);
            syncColumnLayoutTotal($form);
        });

        document.body.addEventListener('change', function(e) {
            var $count = e.target.closest('[data-role="column-count"]');
            if (!$count) {
                return;
            }

            var $form = $count.closest('#integrated-column-layout-form');
            if (!$form) {
                return;
            }

            var sizes = buildEvenSizes($count.value);
            $form.querySelector('#integrated-column-layout-fields').innerHTML = renderColumnInputs(sizes);
            syncColumnLayoutTotal($form);
        });

        document.body.addEventListener('input', function(e) {
            var $size = e.target.closest('[data-role="column-size"]');
            if (!$size) {
                return;
            }

            var $form = $size.closest('#integrated-column-layout-form');
            if ($form) {
                syncColumnLayoutTotal($form);
            }
        });

        document.body.addEventListener('click', function(e) {
            element = e.target.closest('[data-action="integrated-column-layout-cancel"]');
            if (!element) {
                return;
            }

            e.preventDefault();
            Integrated.hideModal();
            $columnLayoutTarget = null;
            $columnLayoutInsertBefore = null;
        });

        document.body.addEventListener('submit', function(e) {
            if (e.target.id !== 'integrated-column-layout-form') {
                return;
            }

            e.preventDefault();

            var $form = e.target;
            var mode = $form.dataset.mode;
            var sizes = normalizeColumnSizes(readColumnSizesFromForm($form));

            if (!sizes) {
                alert('{% trans %}Column sizes must add up to 12{% endtrans %}');
                return;
            }

            if (mode === 'add') {
                if (!$columnLayoutInsertBefore) {
                    Integrated.hideModal();
                    return;
                }

                var $row = createRow();
                sizes.forEach(size => $row.append(createColumn(size)));
                $row.append(createRowButtons());
                $columnLayoutInsertBefore.insertAdjacentElement('beforebegin', $row);
            }

            if (mode === 'config' && $columnLayoutTarget) {
                var $oldColumns = $columnLayoutTarget.querySelectorAll(':scope > [data-block-type="column"]');

                for (var i = 0; i < sizes.length; i++) {
                    var size = sizes[i];
                    var colClass = ' w-full';

                    if (typeof framework !== 'undefined' && (size !== 12 && framework === 'tailwind')) {
                        colClass = ' w-full md:w-' + size + '/12';
                    } else {
                        colClass = ' col-sm-' + size;
                    }

                    if ($oldColumns[i]) {
                        $oldColumns[i].setAttribute('class', 'integrated-website-col integrated-website-droppable' + colClass);
                        $oldColumns[i].dataset.size = size;
                    } else {
                        $columnLayoutTarget.appendChild(createColumn(size));
                    }
                }

                while (typeof $oldColumns[i] !== 'undefined') {
                    $oldColumns[i].parentNode.removeChild($oldColumns[i]);
                    i++;
                }
            }

            Integrated.hideModal();
            $columnLayoutTarget = null;
            $columnLayoutInsertBefore = null;
            rememberState();
        });

        document.body.addEventListener('click', function(e) {
            element = e.target.closest('[data-action="integrated-website-history-undo"]');
            if (!element) {
                return;
            }

            e.preventDefault();
            undoState();
        });

        document.body.addEventListener('click', function(e) {
            element = e.target.closest('[data-action="integrated-website-history-redo"]');
            if (!element) {
                return;
            }

            e.preventDefault();
            redoState();
        });

        document.addEventListener('keydown', function(e) {
            if ((e.ctrlKey || e.metaKey) && !e.shiftKey && e.key.toLowerCase() === 'z') {
                e.preventDefault();
                undoState();
                return;
            }

            if (((e.ctrlKey || e.metaKey) && e.shiftKey && e.key.toLowerCase() === 'z') || ((e.ctrlKey || e.metaKey) &&
                e.key.toLowerCase() === 'y')) {
                e.preventDefault();
                redoState();
            }
        });

        /**
         * Handle new channel block button
         */
        document.body.addEventListener('click', function(e) {
            element = e.target.closest('[data-action="integrated-website-block-new-channel-block"]');
            if (!element) {
                return;
            }

            e.preventDefault();

            button = element;
            id = element.dataset.id;
            name = element.dataset.name;
            className = element.dataset.class;
            csrfToken = element.dataset.csrfToken;

            $blockTarget = document.getElementById('#create-channel-block-' + id);

            showLoader();

            let formData = new FormData();
            formData.append('id', id);
            formData.append('class', className);
            formData.append('name', name);
            formData.append('csrf_token', csrfToken);

            fetch('{{ path('integrated_block_channel_block_new') }}', {
                method: 'POST',
                body: formData,
            }).then(response => response.json()).then(data => {
                hideLoader();

                var url = '{{ path('integrated_block_block_edit', {'id': 'block-id', '_format':'iframe.html'}) }}'.replace(
                    'block-id', id);
                createIframe(url, 'Edit block');
            });

        });

        /**
         * Handle new textblock button
         */
        document.body.addEventListener('click', function(e) {
            element = e.target.closest('[data-action="integrated-website-textblock-add"]');
            if (!element) {
                return;
            }

            e.preventDefault();

            showLoader();

            $blockTarget = element.parentNode;
            if (element.classList.contains('integrated-website-block-column-add')) {
                $blockTarget = $blockTarget.parentNode;
            }

            var pageId = document.querySelector('[data-action="integrated-website-page-save"]').dataset.id;

            createIframe(
                '{{ path('integrated_block_inline_text_block_new', {'id': 'page-id'}) }}'.replace('page-id', pageId),
                '{% trans %}New block{% endtrans %}');

            hideLoader();
        });

        /**
         * @param url
         * @param title
         */
        var createIframe = function(url, title) {
            showLoader();

            let element = document.createElement('iframe');
            element.classList.add('integrated-iframe');
            element.setAttribute('src', url);
            element.style.height = (window.innerHeight - 160) + 'px';

            Integrated.showModal(title, element.outerHTML);

            //handle cancel button in iframe
            iframe = document.querySelector('.integrated-iframe');

            iframe.onload = function() {
                cancelButton = iframe.contentWindow.document.querySelector('#block_edit_actions_cancel');
                if (!cancelButton) {
                    return;
                }

                cancelButton.addEventListener('click', function(e) {
                    e.preventDefault();
                    Integrated.hideModal();
                });
            };

            hideLoader();
        };

        /**
         * @param $element
         */
        var initSortable = function($element) {
            new Sortable($element, {
                group: 'integrated-grid',
                sort: true,
                forceFallback: true,
                scrollSpeed: 80,
                draggable: '.integrated-website-sortable',
                handle: '.integrated-drag-handle',
                ghostClass: 'integrated-website-item-ghost',
                filter: '.integrated-block-button:not(.integrated-drag-handle)',
                dragClass: 'integrated-website-item-dragging',
                onEnd: function() {
                    rememberState();
                },
            });
        };

        /**
         * Handle block edit in iframe
         */
        document.addEventListener('block-added', function(e) {
            Integrated.hideModal();

            if ($blockTarget) {
                //new block inserted
                addBlock(e.detail, $blockTarget);
            } else {
                //update block

                document.querySelectorAll('[data-id="' + e.detail + '"]').forEach(item => {
                    refreshBlock(item, true);
                });
            }
        }, false);

        /**
         * Modal eventlisteners
         */

        /**
         * Handle block edit in iframe
         */
        document.addEventListener('change', function(e) {
            if (!e.target.classList.contains('integrated-block-filter')) {
                return;
            }
            refreshBlockData(document.querySelector('#add_block_filters_form'));
            return false;
        });

        document.addEventListener('submit', function(e) {
            if (e.target.id != 'add_block_filters_form') {
                return;
            }

            e.preventDefault();
            refreshBlockData(e.target);
        });

        document.body.addEventListener('click', function(e) {
            element = e.target.closest('#add_block_pagination li');
            if (!element) {
                return;
            }

            e.preventDefault();

            let form = document.querySelector('#add_block_filters_form');
            form.setAttribute('action', element.dataset.href);
            refreshBlockData(form);

            return false;
        });

        function refreshBlockData(form) {
            document.querySelector('#add_block_results').innerHTML = 'Loading blocks...';

            fetch(form.action, {
                method: 'post',
                body: new URLSearchParams(new FormData(form)),
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                },
            }).then(response => response.json()).then(data => {
                data.type = document.querySelector('[name="integrated_block_filter[type][]"] option:checked').value;
                data.q = document.querySelector('[name="integrated_block_filter[q]"]').value;
                data.channel = document.querySelector(
                    '[name="integrated_block_filter[channels][]"] option:checked').value;

                document.querySelector('#add_block_results').parentElement.outerHTML = addBlockModalTemplateHTML(data);
            });
        }

        var blockFilterDebounce;
        document.addEventListener('input', function(e) {
            if (e.target.id !== 'integrated_block_filter_q') {
                return;
            }

            window.clearTimeout(blockFilterDebounce);
            blockFilterDebounce = window.setTimeout(function() {
                var form = document.querySelector('#add_block_filters_form');
                if (form) {
                    refreshBlockData(form);
                }
            }, 220);
        });
    }(window.Routing);

    var Integrated = Integrated || {};
</script>
