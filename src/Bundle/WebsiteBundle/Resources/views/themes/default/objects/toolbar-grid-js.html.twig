        var getGridRoots = function() {
            return Array.from(document.querySelectorAll('.integrated-website-grid'));
        };

        var serializeGridState = function() {
            return JSON.stringify(getGridRoots().map(item => item.innerHTML));
        };

        var restoreGridState = function(serializedState) {
            var state = JSON.parse(serializedState);
            var roots = getGridRoots();

            roots.forEach((root, index) => {
                root.innerHTML = state[index] || '';
            });

            document.querySelectorAll('.integrated-website-droppable').forEach(item => {
                initSortable(item);
            });
        };

        var rememberStateNow = function() {
            var state = serializeGridState();
            if (historyPast.length && historyPast[historyPast.length - 1] === state) {
                updateHistoryActionState();
                return;
            }

            historyPast.push(state);
            if (historyPast.length > historyLimit) {
                historyPast.shift();
            }

            historyFuture = [];
            notifyEditorContentChange('grid');
            updateHistoryActionState();
        };

        var rememberState = function() {
            if (rememberStateTimer !== null) {
                return;
            }

            rememberStateTimer = window.setTimeout(function() {
                rememberStateTimer = null;
                rememberStateNow();
            }, rememberStateDelay);
        };

        var flushRememberState = function() {
            if (rememberStateTimer === null) {
                return;
            }

            window.clearTimeout(rememberStateTimer);
            rememberStateTimer = null;
            rememberStateNow();
        };

        var setHistoryActionEnabled = function(action, isEnabled) {
            document.querySelectorAll('[data-action="' + action + '"]').forEach(function(button) {
                button.classList.toggle('is-disabled', !isEnabled);
                button.setAttribute('aria-disabled', isEnabled ? 'false' : 'true');
                button.setAttribute('tabindex', isEnabled ? '0' : '-1');
            });
        };

        var updateHistoryActionState = function() {
            setHistoryActionEnabled('integrated-website-history-undo', historyPast.length > 1);
            setHistoryActionEnabled('integrated-website-history-redo', historyFuture.length > 0);
        };

        var undoState = function() {
            flushRememberState();
            if (historyPast.length < 2) {
                updateHistoryActionState();
                return;
            }

            var current = historyPast.pop();
            historyFuture.push(current);
            restoreGridState(historyPast[historyPast.length - 1]);
            notifyEditorContentChange('grid');
            updateHistoryActionState();
        };

        var redoState = function() {
            flushRememberState();
            if (!historyFuture.length) {
                updateHistoryActionState();
                return;
            }

            var state = historyFuture.pop();
            historyPast.push(state);
            restoreGridState(state);
            notifyEditorContentChange('grid');
            updateHistoryActionState();
        };

