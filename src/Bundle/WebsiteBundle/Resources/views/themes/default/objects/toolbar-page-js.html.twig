<script>
    !function() {

        var success = 0;
        var target = null;
        var draftStatusElementId = 'integrated-website-draft-status';
        var draftSaveUrlTemplate = '{{ path('integrated_website_page_draft_save', {'id': '__PAGE_ID__'}) }}';
        var draftPublishUrlTemplate = '{{ path('integrated_website_page_draft_publish', {'id': '__PAGE_ID__'}) }}';
        var draftPreviewLinkUrlTemplate = '{{ path('integrated_website_page_draft_preview_link', {'id': '__PAGE_ID__'}) }}';
        var markEditorReady = function(moduleName) {
            if (
                window.IntegratedEditorLoader &&
                typeof window.IntegratedEditorLoader.markReady === 'function'
            ) {
                window.IntegratedEditorLoader.markReady(moduleName);
            }
        };

        /**
         * Init after page load
         */
        function init() {
            document.querySelectorAll('[data-action="integrated-website-page-save-draft"]').forEach(item =>
                item.addEventListener('click', function (e) {
                    e.preventDefault();
                    setDraftStatus('Saving draft...');
                    saveDraft(this.dataset.id);
                })
            );

            document.querySelectorAll('[data-action="integrated-website-page-publish"]').forEach(item =>
                item.addEventListener('click', function (e) {
                    e.preventDefault();
                    setDraftStatus('Publishing changes...');
                    publishDraft(this.dataset.id, this.dataset.target || null);
                })
            );

            document.querySelectorAll('[data-action="integrated-website-page-preview-draft"]').forEach(item =>
                item.addEventListener('click', function (e) {
                    e.preventDefault();

                    var pageId = this.dataset.id || '';
                    if (!pageId) {
                        return;
                    }

                    setDraftStatus('Generating preview link...');
                    fetch(resolveDraftUrl(draftPreviewLinkUrlTemplate, pageId), {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        }
                    })
                        .then(response => response.json())
                        .then(function (payload) {
                            if (payload && payload.url) {
                                window.open(payload.url, '_blank', 'noopener,noreferrer');
                                setDraftStatus('Preview link generated.');
                                return;
                            }

                            setDraftStatus('Preview link unavailable.');
                        })
                        .catch(function () {
                            setDraftStatus('Preview link unavailable.');
                        });
                })
            );

            markEditorReady('page');
        }

        if (document.readyState != 'loading'){
            init();
        } else {
            document.addEventListener('DOMContentLoaded', init);
        }

        var resolveDraftUrl = function (template, pageId) {
            return template.replace('__PAGE_ID__', encodeURIComponent(String(pageId || '')));
        };

        var setDraftStatus = function (message) {
            var statusElement = document.getElementById(draftStatusElementId);
            if (!statusElement) {
                return;
            }

            statusElement.textContent = message;
        };

        var collectMenus = function () {
            var menus = [];

            document.querySelectorAll('.integrated-website-menu').forEach(item =>
                menus.push(Integrated.Menu.create(item).getData())
            );

            return menus;
        };

        var savePage = function (pageId, redirectTarget) {
            success = 0;
            target = redirectTarget;

            saveMenus();
            saveGrids(pageId);
        };

        var saveDraft = function (pageId) {
            if (!pageId) {
                return;
            }

            fetch(resolveDraftUrl(draftSaveUrlTemplate, pageId), {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    gridPayload: collectGrids(),
                    menuPayload: collectMenus(),
                })
            })
                .then(response => response.json())
                .then(function (payload) {
                    if (payload && payload.saved) {
                        setDraftStatus('Draft saved.');
                        return;
                    }

                    setDraftStatus('Saving failed. Falling back to direct save...');
                    savePage(pageId, null);
                })
                .catch(function () {
                    setDraftStatus('Saving failed. Falling back to direct save...');
                    savePage(pageId, null);
                });
        };

        var publishDraft = function (pageId, redirectTarget) {
            if (!pageId) {
                return;
            }

            fetch(resolveDraftUrl(draftPublishUrlTemplate, pageId), {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                }
            })
                .then(response => response.json())
                .then(function (payload) {
                    if (payload && payload.published) {
                        setDraftStatus('Published.');
                        if (redirectTarget) {
                            window.location.replace(redirectTarget);
                        }

                        return;
                    }

                    setDraftStatus('Publish failed. Falling back to direct save...');
                    savePage(pageId, redirectTarget);
                })
                .catch(function () {
                    setDraftStatus('Publish failed. Falling back to direct save...');
                    savePage(pageId, redirectTarget);
                });
        };

        var saveMenus = function () {
            var menus = collectMenus();

            fetch('{{ path('integrated_website_menu_save') }}', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    'menu': menus
                })
            })
                .then(response => response.json())
                .then(handleSuccess)
                .catch(handleError);
        };

        var getGridItems = function ($element) {
            let items = [];

            $element.forEach(child => {
                if ('block' === child.dataset.blockType) {
                    items.push({
                        'block': child.dataset.id
                    });
                } else if ('row' === child.dataset.blockType) {
                    items.push({
                        'row': {
                            'columns': getGridItems(child.querySelectorAll(':scope > .integrated-website-col'))
                        }
                    });
                } else if ('column' === child.dataset.blockType) {
                    items.push({
                        'size': child.dataset.size,
                        'items': getGridItems(child.querySelectorAll(':scope > .integrated-website-sortable'))
                    });
                }
            });

            return items;
        };

        var collectGrids = function () {
            var grids = [];

            document.querySelectorAll('.integrated-website-grid').forEach(item => {
                grids.push({
                    'id': item.dataset.id,
                    'items': getGridItems(item.querySelectorAll(':scope > .integrated-website-sortable'))
                });
            });

            return grids;
        };

        var saveGrids = function (pageId) {
            var grids = collectGrids();

            fetch('{{ path('integrated_website_grid_save') }}', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    'grids': grids,
                    'page': pageId
                })
            })
                .then(response => response.json())
                .then(handleSuccess)
                .catch(handleError);
        };

        var handleSuccess = function () {
            if (2 === ++success && target) {
                window.location.replace(target);
                return;
            }

            setDraftStatus('Draft saved.');
        };

        var handleError = function (result) {
            setDraftStatus('Saving failed.');
        }

    }();

    var Integrated = Integrated || {};

</script>
