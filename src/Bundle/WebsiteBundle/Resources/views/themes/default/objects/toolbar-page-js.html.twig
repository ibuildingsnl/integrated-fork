<script>
    !function() {

        var success = 0;
        var target = null;
        var pendingSaveRequests = 0;
        var hasSaveError = false;
        var saveStatusElement = null;
        var saveButtonElement = null;
        var markEditorReady = function(moduleName) {
            if (
                window.IntegratedEditorLoader &&
                typeof window.IntegratedEditorLoader.markReady === 'function'
            ) {
                window.IntegratedEditorLoader.markReady(moduleName);
            }
        };

        /**
         * Init after page load
         */
        function init() {
            saveStatusElement = document.querySelector('[data-role="integrated-website-save-status"]');

            document.querySelectorAll('[data-action="integrated-website-page-save"]').forEach(item =>
                item.addEventListener('click', function (e) {
                    e.preventDefault();

                    if (pendingSaveRequests > 0) {
                        return;
                    }

                    success = 0;
                    target = this.dataset.target;
                    saveButtonElement = this;
                    pendingSaveRequests = 2;
                    hasSaveError = false;

                    setSaveButtonBusy(true);
                    setSaveStatus('saving', '{% trans %}Saving changes...{% endtrans %}');

                    saveMenus();
                    savePageBuilder(this.dataset.id);
                })
            );

            markEditorReady('page');
        }

        if (document.readyState != 'loading'){
            init();
        } else {
            document.addEventListener('DOMContentLoaded', init);
        }

        var saveMenus = function () {
            var menus = [];

            document.querySelectorAll('.integrated-website-menu').forEach(item =>
                menus.push(Integrated.Menu.create(item).getData())
            );

            fetch('{{ path('integrated_website_menu_save') }}', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    'menu': menus
                })
            })
                .then(function(response) {
                    return response.json().then(function(data) {
                        return {
                            'status': response.status,
                            'data': data
                        };
                    });
                })
                .then(handleMenuResponse)
                .catch(handleError);
        };

        var handleMenuResponse = function(result) {
            if (!result || result.status >= 400 || (result.data && result.data.success === false)) {
                handleError(result);
                return;
            }

            handleSuccess();
        };

        var getComponentChildren = function ($element) {
            let items = [];

            $element.forEach(child => {
                if ('block' === child.dataset.blockType) {
                    items.push({
                        'type': 'block_ref',
                        'props': {
                            'blockId': child.dataset.id
                        },
                        'children': []
                    });
                } else if ('row' === child.dataset.blockType) {
                    items.push({
                        'type': 'container',
                        'props': {
                            'role': 'row'
                        },
                        'children': getComponentChildren(child.querySelectorAll(':scope > .integrated-website-col'))
                    });
                } else if ('column' === child.dataset.blockType) {
                    items.push({
                        'type': 'container',
                        'props': {
                            'role': 'column',
                            'size': parseInt(child.dataset.size || '12', 10)
                        },
                        'children': getComponentChildren(child.querySelectorAll(':scope > .integrated-website-sortable'))
                    });
                }
            });

            return items;
        };

        var buildV2Payload = function () {
            var grids = [];

            document.querySelectorAll('.integrated-website-grid').forEach(item => {
                grids.push({
                    'type': 'container',
                    'props': {
                        'id': item.dataset.id || '',
                        'role': 'grid'
                    },
                    'children': getComponentChildren(item.querySelectorAll(':scope > .integrated-website-sortable'))
                });
            });

            return {
                'root': {
                    'type': 'container',
                    'children': grids
                }
            };
        };

        var savePageBuilder = function (pageId) {
            fetch('{{ path('integrated_website_pagebuilder_save') }}', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    'page': pageId,
                    'layoutVersion': 2,
                    'payload': buildV2Payload(),
                    'meta': {
                        'source': 'website-editor'
                    }
                })
            })
                .then(function(response) {
                    return response.json().then(function(data) {
                        return {
                            'status': response.status,
                            'data': data
                        };
                    });
                })
                .then(handlePageBuilderResponse)
                .catch(handleError);
        };

        var handlePageBuilderResponse = function (result) {
            if (!result || result.status >= 400 || (result.data && result.data.success === false)) {
                var errors = [];
                if (result && result.data && Array.isArray(result.data.errors)) {
                    errors = result.data.errors;
                }

                if (errors.length > 0) {
                    showValidationErrors(errors);
                } else {
                    handleError(result);
                }

                return;
            }

            handleSuccess();
        };

        var showValidationErrors = function (errors) {
            setSaveButtonBusy(false);
            pendingSaveRequests = 0;
            hasSaveError = true;
            setSaveStatus('error', '{% trans %}Fix validation errors to continue{% endtrans %}');

            var html = '<ul style="margin:0;padding-left:20px">';
            errors.forEach(function(error) {
                html += '<li><strong>' + (error.path || '/') + '</strong>: ' + (error.message || 'Validation error') + '</li>';
            });
            html += '</ul>';

            if (typeof Integrated !== 'undefined' && typeof Integrated.showModal === 'function') {
                Integrated.showModal('{% trans %}Unable to save page{% endtrans %}', html);
                return;
            }

            alert('{% trans %}Unable to save page due to validation errors{% endtrans %}');
        };

        var handleSuccess = function () {
            if (hasSaveError) {
                return;
            }

            success++;
            pendingSaveRequests = Math.max(0, pendingSaveRequests - 1);

            if (pendingSaveRequests > 0) {
                return;
            }

            setSaveStatus('saved', '{% trans %}All changes saved{% endtrans %}');
            setSaveButtonBusy(false);

            if (2 === success && target) {
                window.setTimeout(function() {
                    window.location.replace(target);
                }, 120);
            }
        };

        var handleError = function (result) {
            if (hasSaveError) {
                return;
            }

            hasSaveError = true;
            pendingSaveRequests = 0;
            setSaveButtonBusy(false);
            setSaveStatus('error', '{% trans %}Save failed{% endtrans %}');

            // @todo error handling (INTEGRATED-420)
            alert('An error has occurred saving the page!');
        };

        var setSaveStatus = function(state, label) {
            if (!saveStatusElement) {
                return;
            }

            if (state && state !== 'idle') {
                saveStatusElement.dataset.state = state;
            } else {
                delete saveStatusElement.dataset.state;
            }

            saveStatusElement.textContent = label || '';
        };

        var setSaveButtonBusy = function(isBusy) {
            if (!saveButtonElement) {
                return;
            }

            saveButtonElement.classList.toggle('is-saving', !!isBusy);
            saveButtonElement.setAttribute('aria-busy', isBusy ? 'true' : 'false');
        };

    }();

    var Integrated = Integrated || {};

</script>
