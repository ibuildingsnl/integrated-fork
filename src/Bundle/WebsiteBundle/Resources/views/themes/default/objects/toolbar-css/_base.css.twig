    .integrated-modal-body iframe {
        border: none;
    }

    .integrated-modal-body {
        background: #ffffff;
        position: relative;
        max-height: calc(100vh - 150px);
        overflow: auto;
    }

    .integrated-modal-close {
        float: right;
        font-size: 25px;
        font-weight: bold;
        line-height: 1;
        color: #000000;
        cursor: pointer;
        margin-top: -1px;
        margin-right: 4px;
    }

    .integrated-modal-close:hover {
        text-decoration: none;
    }

    .integrated-modal-content {
        position: relative;
        background-color: #ffffff;
        border-radius: 8px;
        overflow: hidden;
    }

    .integrated-modal-dialog {
        position: relative;
        width: 1440px;
        margin: auto;
    }

    .integrated-modal-header {
        padding: 15px;
        border-bottom: 1px solid #e5e5e5;
        min-height: 17px;
    }

    .integrated-modal-header-title {
        font-family: "Poppins", sans-serif;
        font-size: 15px;
        font-weight: 500;
        color: #000000;
    }

    .integrated-column-layout-modal {
        padding: 18px 18px 20px;
        border: 0;
        border-radius: 0;
        background: #f8fafc;
    }

    .integrated-column-layout-title {
        margin: 0 0 6px;
        text-align: left;
        font-size: 24px;
        font-weight: 600;
        line-height: 1.2;
        color: #1f3348;
    }

    .integrated-column-layout-help {
        margin: 0 0 14px;
        color: #60768d;
        font-size: 13px;
        text-align: left;
    }

    .integrated-column-layout-presets {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        justify-content: flex-start;
        margin: 0 0 14px;
        max-width: none;
    }

    .integrated-column-layout-preset {
        border: 1px solid #d8e0ea;
        border-radius: 10px;
        background: #fff;
        padding: 8px;
        display: flex;
        flex-direction: column;
        gap: 6px;
        align-items: center;
        justify-content: center;
        width: 132px;
        transition: border-color .15s ease, box-shadow .15s ease, transform .15s ease;
    }

    .integrated-column-layout-preset-visual {
        width: 100%;
        height: 56px;
        background: #c8d2de;
        border-radius: 6px;
        display: flex;
        overflow: hidden;
    }

    .integrated-column-layout-preset-segment {
        height: 100%;
        border-right: 2px solid #e7edf3;
        box-sizing: border-box;
    }

    .integrated-column-layout-preset-segment:last-child {
        border-right: 0;
    }

    .integrated-column-layout-preset-label {
        font-size: 13px;
        color: #52687f;
        font-weight: 500;
    }

    .integrated-column-layout-preset:hover .integrated-column-layout-preset-visual,
    .integrated-column-layout-preset:focus .integrated-column-layout-preset-visual {
        background: #b9c6d3;
    }

    .integrated-column-layout-preset:hover,
    .integrated-column-layout-preset:focus {
        border-color: #9ab3ca;
        transform: translateY(-1px);
    }

    .integrated-column-layout-preset.is-selected {
        border-color: #00ae93;
        background: #fff;
        box-shadow: 0 0 0 2px rgba(0, 174, 147, 0.18);
    }

    .integrated-column-layout-preset.is-selected .integrated-column-layout-preset-visual {
        background: #9eb3c7;
    }

    .integrated-column-layout-form {
        display: flex;
        flex-direction: column;
        gap: 10px;
        max-width: none;
        margin: 0;
    }

    .integrated-column-layout-manual {
        background: #fff;
        border: 1px solid #d8e0ea;
        border-radius: 10px;
        padding: 12px;
    }

    .integrated-column-layout-count,
    .integrated-column-layout-field {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .integrated-column-layout-fields {
        display: grid;
        gap: 10px;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        background: #fff;
        border: 1px solid #d8e0ea;
        border-radius: 10px;
        padding: 12px;
    }

    .integrated-column-layout-total {
        margin: 0;
        font-size: 15px;
        color: #4f667d;
    }

    .integrated-column-layout-actions {
        display: flex;
        gap: 8px;
        justify-content: flex-end;
    }

    .integrated-menu-workspace-actions .btn,
    .integrated-block-workspace-actions .btn,
    .integrated-column-layout-actions .btn {
        align-items: center;
        appearance: none;
        border: 1px solid;
        border-radius: 8px;
        cursor: pointer;
        display: inline-flex;
        font-size: 14px;
        font-weight: 300;
        height: 32px;
        line-height: 40px;
        padding: 0 0.8rem;
        text-decoration: none;
        outline: none;
        gap: 6px;
    }

    .integrated-menu-workspace-actions .btn.btn-green,
    .integrated-block-workspace-actions .btn.btn-green,
    .integrated-column-layout-actions .btn.btn-green {
        background-color: #00ae93;
        border-color: #00ae93;
        color: #fff;
    }

    .integrated-column-layout-actions .btn.btn-white {
        background-color: #fff;
        border-color: #cfd9e4;
        color: #304d69;
    }

    .integrated-column-layout-actions .btn.btn-white:hover,
    .integrated-column-layout-actions .btn.btn-white:focus {
        background-color: #f5f7fa;
        border-color: #b9c8d8;
    }

    .integrated-pagination .integrated-pagination-disabled {
        background-color: #DEE3E9;
