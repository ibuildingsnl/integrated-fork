    }

    .integrated-pagination .integrated-pagination-disabled:hover {
        background-color: #DEE3E9;
        color: #000;
    }

    .integrated-pagination li a {
        display: flex;
        height: 100%;
        width: 100%;
    }

    .integrated-pagination li {
        background-color: #dfe3e9;
        border-radius: 4px;
        display: inline-flex;
        height: 30px;
        padding: 0;
        color: black;
        width: 30px;
        margin: 0 2px;
        cursor: pointer;
    }

    .integrated-pagination li, .integrated-pagination li a {
        align-items: center;
        justify-content: center
    }

    .integrated-pagination li:hover a {
        color: #fff
    }

    .integrated-pagination .integrated-pagination-active {
        background-color: #2fa3f9;
        color:white;
    }

    .integrated-pagination li:hover {
        background-color: #2fa3f9;
        color:white;
    }

    .integrated-pagination {
        padding: 1rem;
        text-align: center;
        width: 100%
    }

    .integrated-row-buttons .integrated-block-button:first-child {
