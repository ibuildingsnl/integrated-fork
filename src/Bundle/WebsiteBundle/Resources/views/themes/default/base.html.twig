<!DOCTYPE html>
<html>
<head>
    <title>{% block title page.title|default('Untitled') %}</title>

    {% block meta %}
        <meta charset="UTF-8" />

        {% if page.description|default %}
            <meta name="description" content="{{ page.description }}">
        {% endif %}
    {% endblock %}

    <link rel="stylesheet" href="//code.jquery.com/ui/1.12.1/themes/smoothness/jquery-ui.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600&display=swap" rel="stylesheet">

    {% block stylesheets %}
        {{ integrated_stylesheets() }}
    {% endblock %}
</head>
<body class="integrated-block-page-builder">

<div class="container">
    {% for label, messages in app.flashes(['alert', 'danger', 'info', 'success', 'warning', 'error']) %}
        {% for message in messages %}
            {% if label == 'alert' %}
                {% set label = 'warning' %}
            {% elseif label == 'error' %}
                {% set label = 'danger' %}
            {% endif %}
            <div class="alert alert-{{ label }} alert-dismissible">
                <button type="button" class="close" data-dismiss="alert">&times;</button>
                {{ message|trans }}
            </div>
        {% endfor %}
    {% endfor %}

    <br />
    {{ integrated_menu('main', { 'depth': 2 }) }}
    {% block content %}
        {{ integrated_grid('main') }}
    {% endblock %}
</div>

<script type="text/javascript" src="//ajax.googleapis.com/ajax/libs/jquery/1.12.4/jquery.min.js"></script>
<script type="text/javascript" src="//ajax.googleapis.com/ajax/libs/jqueryui/1.12.1/jquery-ui.min.js"></script>
<script type="text/javascript" src="{{ asset('bundles/integratedcontent/components/handlebars/handlebars.min.js') }}"></script>

{% if app.request.attributes.get('integrated_menu_edit') %}
    {{ include('@IntegratedWebsite/handlebars/menu.html.twig') }}
{% endif %}

{% block javascripts %}
    {{ integrated_javascripts() }}
{% endblock %}

</body>
</html>
