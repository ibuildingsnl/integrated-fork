{% extends integrated_active_theme('base.html.twig') %}

{% block title %}Page not found{% endblock %}

{% block content %}
    <div class="container">
        <h1>{% trans %}Page not found{% endtrans %}</h1>

        <p>{% trans %}The page could not be found.{% endtrans %}</p>


        <div id="panel-create-page" class="mt-5">
        </div>
        <script>
            fetch('{{ path('integrated_page_website_create_page', {'path': app.request.pathinfo }) }}')
                .then(function(response) {
                    return response.text();
                })
                .then(function(body) {
                    document.querySelector('#panel-create-page').innerHTML = body;
                });
        </script>
    </div>
{% endblock %}
