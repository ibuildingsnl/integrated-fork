{% extends integrated_active_theme('base.html.twig') %}

{% block title %}Log in!{% endblock %}

{% block content %}
    <form method="post" id="login-form" action="{{ path('integrated_website_login') }}">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}" />
        <input type="hidden" id="login-action" name="action" value="{% if lastUsername != null %}login{% endif %}" />

        {% if error %}
            <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
        {% endif %}

        {% if not loginEnabled %}
            <div class="mb-3">
                Login is currently not allowed
            </div>
        {% elseif app.user %}
            <div class="mb-3">
                You are logged in as {{ app.user.username }}, <a href="{{ path('integrated_website_logout') }}">Logout</a>
            </div>
        {% else %}
            <div class="alert alert-danger" id="login-error" style="display: none;"></div>

            <h1 class="h3 mb-3 font-weight-normal">Please sign in</h1>
            <label for="username">E-mail address</label>
            <input type="text" value="{{ lastUsername }}" name="username" id="username" class="form-control" required{% if lastUsername == null %} autofocus{% endif %} />

            <div id="panel-password"{% if lastUsername == null %} style="display: none;"{% endif %}>
                <label for="password" id="password-label">Password</label>
                <input type="password" name="password" id="password" class="form-control" required{% if lastUsername != null %} autofocus{% endif %} />
            </div>

            <div id="panel-password-verify" style="display: none;">
                <label for="password-verify" id="password-verify-label">Repeat password</label>
                <input type="password" name="password-verify" id="password-verify" class="form-control" />
            </div>

            <button class="btn btn-lg btn-primary" id="login-submit" type="submit">Next</button>
    {% endif %}
    </form>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
<script>
    $('#username').on('change', function() {
        $('#username').prop('disabled', true);
        $('#login-error').hide();
        $('#login-action').val('');
        $('#panel-password').hide();
        $('#panel-password-verify').hide();

        $.post(Routing.generate('integrated_website_login_verify'), { 'username': $('#username').val() }, function( data ) {
            if (data.status == 'INVALID') {
                $('#login-error').html(data.errorMessage);
                $('#login-error').show();

                return;
            }

            $('#username').prop('disabled', false);
            $('#panel-password').show();
            $('#password').focus();
            $('#login-action').val('login');

            {% if registrationEnabled %}
            if (data.status == 'NEW') {
                $('#password-label').html('Please choose a password');
                $('#panel-password-verify').show();
                $('#login-action').val('register');
            }

            if (data.status == 'EXISTS') {
                $('#password-label').html('Please enter your password');
            }
            {% endif %}
        }, "json");
    });

    $('#login-form').on('submit', function() {
        if ($('#login-action').val() == 'login') {
            return true;
        }

        {% if registrationEnabled %}
        if ($('#login-action').val() == 'register') {

            $.ajax({
                type: 'POST',
                url: Routing.generate('integrated_website_register'),
                data: {
                    'username': $('#username').val(),
                    'password': $('#password').val(),
                    'password-verify': $('#password-verify').val()
                },
                success: function( data ) {
                    if (data.status == 'ERROR') {
                        $('#login-error').html(data.errorMessage);
                        $('#login-error').show();

                        return;
                    }

                    $('#login-action').val('login');
                    $('#login-form').submit();
                },
                dataType: 'json',
                'async': false
            });

            return false;
        }
        {% endif %}

        return false;
    });
</script>
{% endblock %}
