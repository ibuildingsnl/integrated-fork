{% set isEditorMode = app.request.query.get('integrated_website_edit') and layoutEditable %}
{% include integrated_active_theme('objects/toolbar-css.html.twig') %}
{% if isEditorMode %}
    <div id="integrated-editor-loader" aria-live="polite" aria-busy="true">
        <div class="integrated-editor-loader-inner">
            <span class="integrated-inline-spinner"></span>
            <span class="integrated-editor-loader-label">{% trans %}Loading editor...{% endtrans %}</span>
        </div>
    </div>

    <script>
        !function() {
            var requiredModules = ['tools', 'grid', 'menu', 'page'];
            var readyModules = {};
            var completed = false;
            var timeoutId = null;

            var hideLoader = function() {
                var loader = document.getElementById('integrated-editor-loader');
                if (!loader) {
                    return;
                }

                loader.classList.add('is-hidden');
                window.setTimeout(function() {
                    if (loader.parentNode) {
                        loader.parentNode.removeChild(loader);
                    }
                }, 250);
            };

            var complete = function() {
                if (completed) {
                    return;
                }

                completed = true;
                if (timeoutId !== null) {
                    window.clearTimeout(timeoutId);
                }

                hideLoader();
            };

            var checkCompleted = function() {
                for (var i = 0; i < requiredModules.length; i++) {
                    if (!readyModules[requiredModules[i]]) {
                        return;
                    }
                }

                complete();
            };

            window.IntegratedEditorLoader = window.IntegratedEditorLoader || {};
            window.IntegratedEditorLoader.markReady = function(moduleName) {
                if (!moduleName) {
                    return;
                }

                readyModules[moduleName] = true;
                checkCompleted();
            };

            timeoutId = window.setTimeout(complete, 10000);
        }();
    </script>
{% endif %}
{% include integrated_active_theme('objects/toolbar-sortable-js.html.twig') %}
{% include integrated_active_theme('objects/toolbar-tools-js.html.twig') %}
{% include integrated_active_theme('objects/toolbar-grid-js.html.twig') %}
{% include integrated_active_theme('objects/toolbar-menu-js.html.twig') %}
{% include integrated_active_theme('objects/toolbar-page-js.html.twig') %}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/iconoir-icons/iconoir@7.11.0/css/iconoir.css">

<div class="integrated-website-toolbar {% if isEditorMode %}integrated-website-toolbar-editor{% else %}integrated-website-toolbar-view{% endif %}">
    <div class="toolbar-wrapper">
        <a class="integrated-logo" href="{{ path('integrated_content_content_index') }}">
        </a>

        <div class="integrated-website-toolbar-tools">
            <div class="integrated-website-toolbar-left integrated-toolbar-workspace">
                {% block website_navigation_buttons %}
                    {{ render(controller('Integrated\\Bundle\\ContentBundle\\Controller\\ChannelController::getChannels')) }}
                {% endblock website_navigation_buttons %}
                <div class="new-contenttype close-outside dropdown top-bar">
                    <a href="#" class="btn btn-green icon-right"
                       data-toggle="dropdown"><span>{% trans %}Create new {% endtrans %}</span><i class="iconoir-plus"></i></a>
                    {{ knp_menu_render('content_type', {'template': '@IntegratedContent/menu/content_type.html.twig'}) }}
                </div>
            </div>
            {% set params = app.request.attributes.get('_route_params')|merge(app.request.query.all) %}

            {% if app.request.query.get('integrated_website_edit') and layoutEditable %}
                {% set editorExitTarget = path(app.request.attributes.get('_route'), params|merge({'integrated_website_edit': 0})) %}
                <div class="integrated-editor-commandbar" data-role="integrated-editor-commandbar">
                    <div class="integrated-editor-commandbar-group integrated-editor-commandbar-group-history">
                        <a href="javascript:;" class="integrated-website-toolbar-button btn btn-white icon-left"
                           data-action="integrated-website-history-undo">
                            <i class="iconoir-undo"></i>
                            <span>{% trans %}Undo{% endtrans %}</span>
                        </a>

                        <a href="javascript:;" class="integrated-website-toolbar-button btn btn-white icon-left"
                           data-action="integrated-website-history-redo">
                            <i class="iconoir-redo"></i>
                            <span>{% trans %}Redo{% endtrans %}</span>
                        </a>
                    </div>

                    <div class="integrated-editor-commandbar-group integrated-editor-commandbar-group-save">
                        <a href="javascript:;" class="integrated-website-toolbar-button integrated-editor-save-primary btn btn-green"
                           data-action="integrated-website-page-save"
                           {% if page.id|default %}data-id="{{ page.id }}" {% endif %}
                           data-close-editor-on-success="0"
                           data-target="{{ editorExitTarget }}">
                            {% trans %}Save page{% endtrans %}
                        </a>

                        <a href="javascript:;" class="integrated-website-toolbar-button integrated-editor-save-secondary btn btn-white"
                           data-action="integrated-website-page-save"
                           {% if page.id|default %}data-id="{{ page.id }}" {% endif %}
                           data-close-editor-on-success="1"
                           data-target="{{ editorExitTarget }}">
                            {% trans %}Save and close{% endtrans %}
                        </a>

                        <a href="{{ editorExitTarget }}"
                           class="integrated-website-toolbar-button integrated-editor-close btn btn-white">
                            {% trans %}Close{% endtrans %}
                        </a>
                    </div>

                    <span class="integrated-website-save-status" data-role="integrated-website-save-status" aria-live="polite"></span>
                </div>
            {% endif %}

            <div class="integrated-website-toolbar-right">
                {% if not (app.request.query.get('integrated_website_edit') and layoutEditable) %}
                    <div class="integrated-view-commandbar">
                        {% if content is defined and content is not null %}
                            <a href="{{ path('integrated_content_content_edit', {'id': content.id}) }}"
                               class="integrated-website-toolbar-button integrated-view-commandbar-primary btn btn-green">
                                {% trans %}Edit{% endtrans %}
                            </a>
                        {% endif %}

                        {% if layoutEditable %}
                            <div class="integrated-website-toolbar-button-group integrated-view-commandbar-group">
                                <a href="{{ path(app.request.attributes.get('_route'), params|merge({'integrated_website_edit': 1})) }}"
                                   class="integrated-website-toolbar-button btn btn-green">
                                    {% trans %}Edit page{% endtrans %}
                                </a>
                                {% if page %}
                                    {% if page.type == 'content_type_page' %}
                                        <a href="{{ path('integrated_page_content_type_page_edit', {'id': page.id}) }}"
                                           class="btn btn-green">{% trans %}Edit page properties{% endtrans %}</a>
                                    {% else %}
                                        <a href="{{ path('integrated_page_page_edit', {'id': page.id}) }}"
                                           class="btn btn-green">{% trans %}Edit page properties{% endtrans %}</a>
                                    {% endif %}
                                    <a href="{{ path('integrated_page_page_index') }}"
                                       class="btn btn-white">{% trans %}Go to page overview{% endtrans %}</a>
                                {% endif %}
                            </div>
                        {% endif %}
                    </div>
                {% endif %}
                <div class="integrated-toolbar-account-shell">
                    <div class="integrated-toolbar-account">
                    {{ render(controller('Integrated\\Bundle\\ContentBundle\\Controller\\ContentController::navdropdowns')) }}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% if (message != '') %}
    <div class="integrated-website-toolbar-message">
        {{ message|trans }}
    </div>
{% endif %}

<script>
    const body = document.body;
    const targetClassesClosing = '.close-outside.show';
    const openClasses = [
        '.close-outside', //dropdown select
        '.button_toggle_upload_view', //media gallery button
        '.mobile-menu-toggle', //menu when in mobile mode
        '.toggle-filters', //filters when in mobile mode
    ];
    let popupShown = false;
    
    function collapseToolbarDropdowns() {
        document.querySelectorAll('.dropdown.show').forEach(function(node) {
            node.classList.remove('show');
        });
        document.querySelectorAll('.dropdown > a[data-toggle="dropdown"]').forEach(function(node) {
            node.setAttribute('aria-expanded', 'false');
        });
    }

    $(document).mouseup(function (e) {
        const closeOutside = $('.close-outside.show');
        const toggleButton = $('.toggle-button');
        const isTargetCloseOutside = closeOutside.is(e.target) || closeOutside.has(e.target).length > 0;
        const isTargetToggleButton = toggleButton.is(e.target) || toggleButton.has(e.target).length > 0;
        const isTargetInput = $(e.target).hasClass('tt-input') || $(e.target).hasClass('dropdown-menu');
        const clickedOutside = !isTargetCloseOutside && !isTargetToggleButton && !isTargetInput;

        if (clickedOutside) {
            collapseToolbarDropdowns();
            hideDropDownBackGround();
            popupShown = false;
        }
    });

    $(document).keyup(function (e) {
        if (e.key === 'Escape') {
            const closeOutside = $('.close-outside.show');
            if (closeOutside.is('#upload_container')) {
                closeOutside.removeClass('close-outside');
            }
            collapseToolbarDropdowns();
            hideDropDownBackGround();
            popupShown = false;
        }
    });

    function addPopupEventListeners() {
        $(document).on('mouseup', openClasses.join(','), function (event) {
            event.stopPropagation();
            openPopup();
        });
    }

    addPopupEventListeners();

    function openPopup() {
        if (!popupShown) {
            enableClosingOfPopup();
            popupShown = true;
        }
    }

    function enableClosingOfPopup() {
        $(document).on('mouseup', handlePopupClose);
        $(document).on('keyup', handleKeyPress);
    }

    function handlePopupClose(event) {
        const closeOutside = $(targetClassesClosing);
        const clickedOutside = !closeOutside.is(event.target) && closeOutside.has(event.target).length === 0;

        if (clickedOutside) {
            event.stopPropagation();
            collapseToolbarDropdowns();
            disableEventListeners();
            hideDropDownBackGround();
            sendCancelEvent();
            popupShown = false;
        }
    }

    function disableEventListeners() {
        $(document).off('mouseup', handlePopupClose);
        $(document).off('keyup', handleKeyPress);
    }

    function handleKeyPress(event) {
        if (event.key === 'Escape') {
            handlePopupClose(event);
        }
    }

    function sendCancelEvent() {
        document.dispatchEvent(new CustomEvent("cancelPopupEvent"));
    }

    function hideDropDownBackGround() {
        const bg = document.getElementById('dropDownBackground');
        if (bg) {
            bg.classList.remove('show');
        }
    }

    document.querySelectorAll('a[data-toggle="dropdown"]').forEach(function(el) {
        el.setAttribute('aria-expanded', 'false');
        el.setAttribute('role', 'button');
        el.addEventListener('click', toggleDropdown, false);
    });

    document.addEventListener('keydown', function(e) {
        const toggle = e.target.closest('a[data-toggle="dropdown"]');
        if (!toggle) {
            return;
        }

        if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            toggleDropdown(e);
        }
    });

    function toggleDropdown(el) {
        if (el && typeof el.preventDefault === 'function') {
            el.preventDefault();
        }

        const toggle = el.target.closest('a[data-toggle="dropdown"]');
        if (!toggle) {
            return;
        }

        const dropdown = toggle.closest('.dropdown');
        if (!dropdown) {
            return;
        }

        const toggles = document.querySelectorAll('.dropdown > a[data-toggle="dropdown"]');

        if (!dropdown.classList.contains('show')) {
            const dropdowns = document.querySelectorAll('.dropdown');
            dropdowns.forEach(dropdown => {
                dropdown.classList.remove('show');
            });
            toggles.forEach(function(node) {
                node.setAttribute('aria-expanded', 'false');
            });
            dropdown.classList.add('show');
            toggle.setAttribute('aria-expanded', 'true');
            if (dropdown.getAttribute('data-underlay') !== 'no') {
                showDropDownBackGround();
            }
        } else {
            dropdown.classList.remove('show');
            toggle.setAttribute('aria-expanded', 'false');
            if (dropdown.getAttribute('data-underlay') !== 'no') {
                hideDropDownBackGround();
            }
        }
    }

    function hideDropDownBackGround() {
        const menuItemDropDownUnderlay = document.querySelector('#dropdown_overlay');
        if (!menuItemDropDownUnderlay.classList.contains('hide')) {
            menuItemDropDownUnderlay.classList.add('hide');
        }
    }

    function showDropDownBackGround() {
        const menuItemDropDownUnderlay = document.querySelector('#dropdown_overlay');
        if (menuItemDropDownUnderlay.classList.contains('hide')) {
            menuItemDropDownUnderlay.classList.remove('hide');
        }
    }

</script>

<div id="dropdown_overlay" class="hide"></div>

<div class="integrated-website-body-margin-top"></div>
