<?xml version="1.0" encoding="UTF-8" ?>

<routes xmlns="http://symfony.com/schema/routing"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://symfony.com/schema/routing http://symfony.com/schema/routing/routing-1.0.xsd">

    <route id="integrated_website_page_draft_get" path="/{id}" methods="GET">
        <default key="_controller">Integrated\Bundle\WebsiteBundle\Controller\PageDraftController::getDraft</default>
        <default key="_format">json</default>
    </route>

    <route id="integrated_website_page_draft_save" path="/{id}" methods="POST">
        <default key="_controller">Integrated\Bundle\WebsiteBundle\Controller\PageDraftController::saveDraft</default>
        <default key="_format">json</default>
    </route>

    <route id="integrated_website_page_draft_delete" path="/{id}" methods="DELETE">
        <default key="_controller">Integrated\Bundle\WebsiteBundle\Controller\PageDraftController::deleteDraft</default>
        <default key="_format">json</default>
    </route>

    <route id="integrated_website_page_draft_publish" path="/{id}/publish" methods="POST">
        <default key="_controller">Integrated\Bundle\WebsiteBundle\Controller\PageDraftController::publishDraft</default>
        <default key="_format">json</default>
    </route>

    <route id="integrated_website_page_draft_preview_link" path="/{id}/preview-link" methods="POST">
        <default key="_controller">Integrated\Bundle\WebsiteBundle\Controller\PageDraftController::createPreviewLink</default>
        <default key="_format">json</default>
    </route>

</routes>
