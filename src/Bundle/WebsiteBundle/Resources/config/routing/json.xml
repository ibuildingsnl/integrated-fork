<?xml version="1.0" encoding="UTF-8" ?>

<routes xmlns="http://symfony.com/schema/routing"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://symfony.com/schema/routing http://symfony.com/schema/routing/routing-1.0.xsd">

    <route id="integrated_website_search_selection_json" path="/content/json/{id}" methods="GET">
        <default key="_controller">Integrated\Bundle\WebsiteBundle\Controller\JSONController::searchSelectionJson</default>
        <default key="_format">json</default>
    </route>

    <route id="integrated_website_related_content_block_json" path="/related_content_block/json" methods="GET">
        <default key="_controller">Integrated\Bundle\WebsiteBundle\Controller\JSONController::relatedContentBlock</default>
        <default key="_format">json</default>
    </route>
</routes>
