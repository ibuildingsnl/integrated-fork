<?xml version="1.0" encoding="UTF-8" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>

        <defaults autowire="true" autoconfigure="true" />

        <service id="Integrated\Bundle\WebsiteBundle\Controller\ErrorController">
            <argument type="service" id="integrated_theme.templating.theme_manager" />

            <tag name="controller.service_arguments" />
            <tag name="container.service_subscriber" />
        </service>

        <service id="Integrated\Bundle\WebsiteBundle\Controller\PageController">
            <argument type="service" id="integrated_theme.templating.theme_manager" />
            <argument type="service" id="integrated_website.website_toolbar" />
            <argument type="service" id="uri_signer" />
            <argument type="service" id="Integrated\Bundle\WebsiteBundle\Service\FacetQueryCanonicalizer" />

            <tag name="controller.service_arguments" />
            <tag name="container.service_subscriber" />
        </service>

        <service id="Integrated\Bundle\WebsiteBundle\Controller\GridController">
            <argument type="service" id="doctrine_mongodb.odm.document_manager" />
            <argument type="service" id="integrated_page.grid.factory" />

            <tag name="controller.service_arguments" />
            <tag name="container.service_subscriber" />
        </service>

        <service id="Integrated\Bundle\WebsiteBundle\Controller\MenuController">
            <argument type="service" id="doctrine_mongodb.odm.document_manager" />
            <argument type="service" id="integrated_menu.provider.integrated_menu_provider" />
            <argument type="service" id="integrated.menu_factory.database" />
            <argument type="service" id="channel.context" />

            <tag name="controller.service_arguments" />
            <tag name="container.service_subscriber" />
        </service>

        <service id="Integrated\Bundle\WebsiteBundle\Controller\RSSSearchSelectionController">
            <argument type="service" id="integrated_content.provider.solarium" />
            <argument type="service" id="integrated_theme.templating.theme_manager" />

            <tag name="controller.service_arguments" />
            <tag name="container.service_subscriber" />

            <call method="setContainer">
                <argument type="service" id="service_container" />
            </call>
        </service>

        <service id="Integrated\Bundle\WebsiteBundle\Controller\JSONController">
            <argument type="service" id="integrated_content.provider.solarium" />
            <argument type="service" id="knp_paginator" />
            <argument type="service" id="request_stack" />
            <argument type="service" id="doctrine_mongodb.odm.document_manager" />
            <argument type="service" id="integrated_theme.templating.theme_manager" />

            <tag name="controller.service_arguments" />
            <tag name="container.service_subscriber" />
        </service>

        <service id="Integrated\Bundle\WebsiteBundle\Controller\SessionController">
            <tag name="controller.service_arguments" />
            <tag name="container.service_subscriber" />
        </service>

        <!-- content controllers -->

        <service id="integrated_website.controller.content.article" class="Integrated\Bundle\WebsiteBundle\Controller\Content\ArticleController">
            <argument type="service" id="integrated_website.service.content_service" />
            <argument type="service" id="integrated_theme.templating.theme_manager" />
            <argument type="service" id="Integrated\Bundle\WebsiteBundle\Service\ContentDocumentResolver" />

            <tag name="integrated_page.contenttype_controller" class="Integrated\Bundle\ContentBundle\Document\Content\Article" />
            <tag name="controller.service_arguments" />
            <tag name="container.service_subscriber" />
        </service>

        <service id="integrated_website.controller.content.news" class="Integrated\Bundle\WebsiteBundle\Controller\Content\NewsController">
            <argument type="service" id="integrated_website.service.content_service" />
            <argument type="service" id="integrated_theme.templating.theme_manager" />
            <argument type="service" id="Integrated\Bundle\WebsiteBundle\Service\ContentDocumentResolver" />

            <tag name="integrated_page.contenttype_controller" class="Integrated\Bundle\ContentBundle\Document\Content\News" />
            <tag name="controller.service_arguments" />
            <tag name="container.service_subscriber" />
        </service>

        <service id="integrated_website.controller.content.company" class="Integrated\Bundle\WebsiteBundle\Controller\Content\CompanyController">
            <argument type="service" id="integrated_website.service.content_service" />
            <argument type="service" id="integrated_theme.templating.theme_manager" />
            <argument type="service" id="Integrated\Bundle\WebsiteBundle\Service\ContentDocumentResolver" />

            <tag name="integrated_page.contenttype_controller" class="Integrated\Bundle\ContentBundle\Document\Content\Relation\Company" />
            <tag name="controller.service_arguments" />
            <tag name="container.service_subscriber" />
        </service>

        <service id="integrated_website.controller.content.event" class="Integrated\Bundle\WebsiteBundle\Controller\Content\EventController">
            <argument type="service" id="integrated_website.service.content_service" />
            <argument type="service" id="integrated_theme.templating.theme_manager" />
            <argument type="service" id="Integrated\Bundle\WebsiteBundle\Service\ContentDocumentResolver" />

            <tag name="integrated_page.contenttype_controller" class="Integrated\Bundle\ContentBundle\Document\Content\Event" />
            <tag name="controller.service_arguments" />
            <tag name="container.service_subscriber" />
        </service>

        <service id="integrated_website.controller.content.job_posting" class="Integrated\Bundle\WebsiteBundle\Controller\Content\JobPostingController">
            <argument type="service" id="integrated_website.service.content_service" />
            <argument type="service" id="integrated_theme.templating.theme_manager" />
            <argument type="service" id="Integrated\Bundle\WebsiteBundle\Service\ContentDocumentResolver" />

            <tag name="integrated_page.contenttype_controller" class="Integrated\Bundle\ContentBundle\Document\Content\JobPosting" />
            <tag name="controller.service_arguments" />
            <tag name="container.service_subscriber" />
        </service>

        <service id="integrated_website.controller.content.person" class="Integrated\Bundle\WebsiteBundle\Controller\Content\PersonController">
            <argument type="service" id="integrated_website.service.content_service" />
            <argument type="service" id="integrated_theme.templating.theme_manager" />
            <argument type="service" id="Integrated\Bundle\WebsiteBundle\Service\ContentDocumentResolver" />

            <tag name="integrated_page.contenttype_controller" class="Integrated\Bundle\ContentBundle\Document\Content\Relation\Person" />
            <tag name="controller.service_arguments" />
            <tag name="container.service_subscriber" />
        </service>

        <service id="integrated_website.controller.content.taxonomy" class="Integrated\Bundle\WebsiteBundle\Controller\Content\TaxonomyController">
            <argument type="service" id="integrated_website.service.content_service" />
            <argument type="service" id="integrated_theme.templating.theme_manager" />
            <argument type="service" id="Integrated\Bundle\WebsiteBundle\Service\ContentDocumentResolver" />

            <tag name="integrated_page.contenttype_controller" class="Integrated\Bundle\ContentBundle\Document\Content\Taxonomy" />
            <tag name="controller.service_arguments" />
            <tag name="container.service_subscriber" />
        </service>

    </services>

</container>
