<?xml version="1.0" encoding="UTF-8" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>

        <defaults autowire="true" autoconfigure="true" />

        <service id="integrated_website.routing.page_loader" class="Integrated\Bundle\WebsiteBundle\Routing\PageLoader">
            <argument type="service" id="doctrine_mongodb.odm.document_manager" />
            <tag name="routing.loader" />
        </service>

        <service id="integrated_website.routing.content_type_page_loader" class="Integrated\Bundle\WebsiteBundle\Routing\ContentTypePageLoader">
            <argument type="service" id="doctrine_mongodb.odm.document_manager" />
            <argument type="service" id="integrated_page.services.url_resolver" />
            <tag name="routing.loader" />
        </service>

        <service id="integrated_website.service.editable_checker" class="Integrated\Bundle\WebsiteBundle\Service\EditableChecker">
            <argument type="service" id="security.authorization_checker" />
            <argument type="service" id="security.token_storage" />
            <argument type="service" id="request_stack" />
            <argument type="service" id="router" />
            <argument type="service" id="doctrine_mongodb.odm.document_manager" />
        </service>

        <service id="integrated_website.service.content_service" class="Integrated\Bundle\WebsiteBundle\Service\ContentService">
            <argument id="integrated_content.channel.context" type="service"/>
            <argument id="security.authorization_checker" type="service"/>
            <argument id="integrated_block.templating.block_manager" type="service"/>
            <argument id="integrated_website.website_toolbar" type="service"/>
        </service>

        <service id="Integrated\Bundle\WebsiteBundle\Service\ContentDocumentResolver">
            <argument type="service" id="Integrated\Bundle\ContentBundle\Document\Content\ContentRepository" />
        </service>

        <service id="Integrated\Bundle\WebsiteBundle\Service\PageSeoMetadataResolver">
            <argument type="service" id="request_stack" />
            <argument>%integrated_page.default_paginated_noindex%</argument>
            <argument type="service" id="Integrated\Bundle\WebsiteBundle\Service\SeoPlaceholderResolver" />
        </service>

        <service id="Integrated\Bundle\WebsiteBundle\Service\SeoPlaceholderResolver">
        </service>

        <service id="Integrated\Bundle\WebsiteBundle\Service\FacetQueryCanonicalizer">
            <argument type="service" id="Integrated\Bundle\BlockBundle\Document\Block\BlockRepository" />
        </service>

        <service id="Integrated\Bundle\WebsiteBundle\Twig\Extension\PageSeoExtension">
            <argument type="service" id="Integrated\Bundle\WebsiteBundle\Service\PageSeoMetadataResolver" />
            <argument type="service" id="Integrated\Bundle\WebsiteBundle\Service\SeoPlaceholderResolver" />
            <tag name="twig.extension" />
        </service>

        <service id="integrated_website.event_listener.content_youtube_listener" class="Integrated\Bundle\WebsiteBundle\EventListener\Objects\ContentYoutubeListener">
            <argument type="service" id="integrated_theme.templating.theme_manager" />
            <argument type="service" id="twig" />
            <argument>%kernel.environment%</argument>
            <tag name="kernel.event_listener" event="content.event" method="process" />
        </service>


        <service id="integrated_website.event_subscriber.locale_subscriber" class="Integrated\Bundle\WebsiteBundle\EventListener\LocaleSubscriber">
            <argument type="service" id="integrated_content.channel.context"/>

            <tag name="kernel.event_subscriber"/>
        </service>



    </services>

</container>
