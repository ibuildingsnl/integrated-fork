<?xml version="1.0" encoding="UTF-8" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>

        <defaults autowire="true" autoconfigure="true" />

        <service id="integrated_website.redirect_content" class="Integrated\Bundle\WebsiteBundle\EventListener\RedirectContentSubscriber">
            <argument type="service" id="integrated_content.channel.context" />
            <argument type="service" id="doctrine_mongodb.odm.document_manager" />
            <argument type="service" id="integrated_page.services.url_resolver" />
            <argument type="service" id="router" />
        </service>

        <service id="integrated_website.website_editable" class="Integrated\Bundle\WebsiteBundle\EventListener\WebsiteEditableListener">
            <argument type="service" id="integrated_website.service.editable_checker" />
            <argument type="service" id="integrated_asset.manager.javascript_manager" />
        </service>

        <service id="integrated_website.website_toolbar" class="Integrated\Bundle\WebsiteBundle\EventListener\WebsiteToolbarListener">
            <argument type="service" id="twig" />
            <argument type="service" id="integrated_website.service.editable_checker" />
        </service>

        <service id="integrated_website.website_configuration" class="Integrated\Bundle\WebsiteBundle\EventListener\WebsiteConfigurationListener">
            <argument type="service" id="integrated_content.channel.context" />
            <argument type="service" id="integrated_theme.templating.theme_manager" />
            <argument type="service" id="integrated_page.theme_resolver" />
        </service>

    </services>

</container>
