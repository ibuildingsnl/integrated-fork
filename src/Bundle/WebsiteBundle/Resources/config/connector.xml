<?xml version="1.0" encoding="UTF-8" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>

        <defaults autowire="true" autoconfigure="true" />

        <service id="integrated_website.connector.website_manifest" class="Integrated\Bundle\WebsiteBundle\Connector\WebsiteManifest" />

        <service id="integrated_website.connector.website_configuration" class="Integrated\Bundle\WebsiteBundle\Connector\WebsiteConfiguration" />

        <service id="integrated_website.connector.website_adapter" class="Integrated\Bundle\WebsiteBundle\Connector\WebsiteAdapter">
            <argument type="service" id="integrated_website.connector.website_manifest" />
            <argument type="service" id="integrated_website.connector.website_configuration" />
            <tag name="integrated_channel.connector" />
        </service>

    </services>

</container>
