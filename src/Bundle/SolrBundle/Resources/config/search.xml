<?xml version="1.0" encoding="UTF-8" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>

        <defaults autowire="true" autoconfigure="true"/>

        <service id="integrated_solr.search.query_factory" class="Integrated\Common\Solr\Search\QueryFactory">
            <argument type="service" id="integrated_solr.search.type.registry" />
            <argument type="service" id="event_dispatcher" />
        </service>

        <service id="integrated_solr.search.type.registry" class="Integrated\Common\Solr\Search\Type\Registry">
            <argument type="collection">
                <argument type="service" id="integrated_solr.search.type.dependency_injection_provider" />
            </argument>
            <argument type="service" id="integrated_solr.search.type.resolved_type_factory" />
        </service>

        <service id="integrated_solr.search.type.dependency_injection_provider" class="Integrated\Common\Solr\Search\Type\Provider\DependencyInjectionProvider">
            <argument />
            <argument />
        </service>

        <service id="integrated_solr.search.type.resolved_type_factory" class="Integrated\Common\Solr\Search\Type\ResolvedTypeFactory" />

        <service id="Integrated\Common\Solr\Search\QueryFactoryInterface" alias="integrated_solr.search.query_factory" public="true" />

    </services>

</container>
