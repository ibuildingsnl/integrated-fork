{
    "name": "integrated/integrated",
    "type": "library",
    "description": "Integrated PHP framework",
    "keywords": [
        "integrated",
        "content store",
        "publishing"
    ],
    "homepage": "https://www.integratedfordevelopers.com",
    "license": "MIT",
    "authors": [
        {
            "name": "e-Active",
            "homepage": "https://www.e-active.nl"
        },
        {
            "name": "Twin Digital",
            "homepage": "https://www.twindigital.nl"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-gd": "*",
        "ext-intl": "*",
        "ext-json": "*",
        "darsyn/ip": "^5.0",
        "darsyn/ip-doctrine": "^6.0",
        "devture/mongodb-migrations": "^4.0",
        "doctrine/cache": "^2.2",
        "doctrine/data-fixtures": "^2.0",
        "doctrine/dbal": "^4.0",
        "doctrine/doctrine-bundle": "^2.9",
        "doctrine/migrations": "~3.6",
        "doctrine/mongodb-odm-bundle": "^5.1",
        "doctrine/orm": "^3.3",
        "embed/embed": "^4.4",
        "endroid/qr-code-bundle": "*",
        "excelwebzone/recaptcha-bundle": "*",
        "fakerphp/faker": "^1.22",
        "gregwar/cache": "^1.0.13",
        "gregwar/image": "~2.1",
        "guzzlehttp/guzzle": "^7.5",
        "knplabs/knp-gaufrette-bundle": "~0.8",
        "knplabs/knp-menu-bundle": "^3.2",
        "knplabs/knp-paginator-bundle": "~6.2",
        "monolog/monolog": "~3.3",
        "php-http/guzzle7-adapter": "^1.0",
        "psr/simple-cache": "^3.0",
        "ramsey/uuid": "^4.7",
        "scheb/2fa-bundle": "*",
        "scheb/2fa-google-authenticator": "*",
        "solarium/solarium": "^6.4.1",
        "symfony/asset": "^7.1",
        "symfony/cache": "^7.1",
        "symfony/console": "^7.1",
        "symfony/css-selector": "^7.1",
        "symfony/debug-bundle": "^7.1",
        "symfony/dom-crawler": "^7.1",
        "symfony/event-dispatcher": "^7.1",
        "symfony/expression-language": "^7.1",
        "symfony/form": "*",
        "symfony/framework-bundle": "^7.1",
        "symfony/http-foundation": "^7.1",
        "symfony/http-kernel": "^7.1",
        "symfony/intl": "^7.1",
        "symfony/lock": "^7.1",
        "symfony/mailer": "^7.1",
        "symfony/monolog-bundle": "~3.8",
        "symfony/polyfill-iconv": "~1.27",
        "symfony/process": "^7.1",
        "symfony/property-access": "^7.1",
        "symfony/property-info": "^7.1",
        "symfony/routing": "^7.1",
        "symfony/security-acl": "~3.3",
        "symfony/security-bundle": "^7.1",
        "symfony/serializer": "^7.1",
        "symfony/translation": "^7.1",
        "symfony/twig-bundle": "^7.1",
        "symfony/ux-live-component": "^2.32",
        "symfony/ux-twig-component": "^2.32",
        "symfony/validator": "^7.1",
        "symfony/var-exporter": "^7.1",
        "twig/extra-bundle": "^3.9",
        "twig/intl-extra": "^3.9",
        "twig/string-extra": "^3.9",
        "twig/twig": "^3.18",
        "twindigital/clock": "^1.0.0"
    },
    "replace": {
        "integrated/asset-bundle": "self.version",
        "integrated/block-bundle": "self.version",
        "integrated/channel-bundle": "self.version",
        "integrated/comment-bundle": "self.version",
        "integrated/content-bundle": "self.version",
        "integrated/content-history-bundle": "self.version",
        "integrated/formtype-bundle": "self.version",
        "integrated/image-bundle": "self.version",
        "integrated/library": "self.version",
        "integrated/locking-bundle": "self.version",
        "integrated/menu-bundle": "self.version",
        "integrated/page-bundle": "self.version",
        "integrated/slug-bundle": "self.version",
        "integrated/social-bundle": "self.version",
        "integrated/solr-bundle": "self.version",
        "integrated/storage-bundle": "self.version",
        "integrated/theme-bundle": "self.version",
        "integrated/user-bundle": "self.version",
        "integrated/website-bundle": "self.version",
        "integrated/workflow-bundle": "self.version"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "3.88.0",
        "phpstan/extension-installer": "^1.3.1",
        "phpstan/phpstan": "2.1.33",
        "phpstan/phpstan-doctrine": "2.0.12",
        "phpstan/phpstan-symfony": "2.0.9",
        "phpunit/phpunit": "^10.5, >=10.5.40",
        "rector/rector": "^2.0"
    },
    "conflict": {
        "doctrine/collections": "<2.0",
        "spomky-labs/otphp": "<11.0.2"
    },
    "autoload": {
        "psr-4": {
            "Integrated\\Bundle\\": "src/Bundle",
            "Integrated\\MongoDB\\": "src/MongoDB",
            "Integrated\\Doctrine\\": "src/Doctrine",
            "Integrated\\Common\\": "src/Common"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "endroid/installer": true,
            "composer/package-versions-deprecated": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "symfony": {
            "require": "7.4.*"
        },
        "branch-alias": {
            "dev-release/0.30": "0.30.x-dev",
            "dev-release/0.80": "0.80.x-dev",
            "dev-release/0.90": "0.90.x-dev"
        }
    }
}
