set -e

curl -sS https://getcomposer.org/installer | php8.3

rm -Rf vendor
php8.4 composer.phar update -n --ansi
php8.4 vendor/bin/php-cs-fixer fix --verbose --show-progress=none --dry-run
php8.4 vendor/bin/phpunit
php8.4 vendor/bin/phpstan analyse --no-progress

rm -Rf vendor
php8.4 composer.phar update -n --ansi --prefer-lowest
php8.4 vendor/bin/phpunit
php8.4 vendor/bin/phpstan analyse --no-progress --configuration=phpstan.lowest.neon
