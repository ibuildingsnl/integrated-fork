set -e

curl -sS https://getcomposer.org/installer | php8.3

rm -Rf vendor
php8.3 composer.phar update -n --ansi
php8.3 vendor/bin/php-cs-fixer fix --verbose --show-progress=none --dry-run
php8.3 vendor/bin/phpunit
php8.3 vendor/bin/phpstan analyse --no-progress

rm -Rf vendor
php8.3 composer.phar update -n --ansi --prefer-lowest
php8.3 vendor/bin/phpunit
php8.3 vendor/bin/phpstan analyse --no-progress --configuration=phpstan.lowest.neon

if [ -n "${PLAYWRIGHT_BASE_URL:-}" ] && command -v npx >/dev/null 2>&1; then
  TOOLBAR_E2E_BASE_URL="$PLAYWRIGHT_BASE_URL" npx --yes @playwright/test@1.52.0 test tests/e2e/toolbar.spec.ts --config=playwright.config.ts
fi
